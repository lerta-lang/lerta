# An expression tree: a union of structs, evaluated and printed by branching on the node type.
struct Num
  value: Int
struct Add
  left: Expr
  right: Expr
struct Mul
  left: Expr
  right: Expr
type Expr = Num | Add | Mul

const eval = (e: Expr): Int ->
  case e
    when Num then e.value
    when Add then eval(e.left) + eval(e.right)
    when Mul then eval(e.left) * eval(e.right)

const show = (e: Expr): String ->
  case e
    when Num then e.value.to_string()
    when Add then "(#{show(e.left)} + #{show(e.right)})"
    when Mul then "#{show(e.left)} * #{show(e.right)}"

const tree = Add(left: Num(value: 2), right: Mul(left: Num(value: 3), right: Num(value: 4)))
print "#{show(tree)} = #{eval(tree)}"
