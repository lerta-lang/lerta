# The syntax tree.

# An error in the source text, which ends the run with its message.
export struct CalcError: Error

export struct Number
  value: Int

export struct Variable
  name: String

export struct Operation
  operator: String
  left: Expr
  right: Expr

export type Expr = Number | Variable | Operation

export struct Let
  name: String
  value: Expr

export struct Print
  value: Expr

export type Statement = Let | Print
