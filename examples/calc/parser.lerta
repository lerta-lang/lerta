# Parses tokens into statements, with the usual precedence of operators.
import { Token } from './lexer'
import { Expr, Let, Number, Operation, Print, Statement, Variable } from './syntax'

export class Parser
  tokens: Array<Token>
  position = 0

  peek = (): Token -> @tokens[@position]

  next = (): Token ->
    const token = @tokens[@position]
    @position += 1
    token

  expect = (kind: String): Token ->
    const token = @next()
    throw "expected #{kind}, found '#{token.text}'" if token.kind != kind
    token

  statements = (): Array<Statement> ->
    const result: Array<Statement> = []
    while @peek().kind != 'end'
      result.push(@statement())
      @expect(';') if @peek().kind != 'end'
    result

  statement = (): Statement ->
    const token = @next()
    case token.kind
      when 'let' then @let_statement()
      when 'print' then Print(value: @expression())
      else throw "unexpected '#{token.text}'"

  let_statement = (): Statement ->
    const name = @expect('name').text
    @expect('=')
    Let(name, value: @expression())

  expression = (): Expr ->
    var left = @term()
    while @peek().kind == '+' or @peek().kind == '-'
      const operator = @next().kind
      left = Operation(operator, left, right: @term())
    left

  term = (): Expr ->
    var left = @factor()
    while @peek().kind == '*' or @peek().kind == '/'
      const operator = @next().kind
      left = Operation(operator, left, right: @factor())
    left

  factor = (): Expr ->
    const token = @next()
    case token.kind
      when 'number' then Number(value: token.text.parse_int()!)
      when 'name' then Variable(name: token.text)
      when '('
        const inner = @expression()
        @expect(')')
        inner
      else throw "unexpected '#{token.text}'"
