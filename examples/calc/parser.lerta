# Parses tokens into statements, with the usual precedence of operators.
import Token from './lexer'
import CalcError, Expr, Let, Number, Operation, Print, Statement, Variable from './syntax'

export class Parser
  tokens: Token[]
  position = 0

  peek = -> @tokens[@position]

  next = ->
    const token = @tokens[@position]
    @position += 1
    token

  expect = (kind: String) ->
    const token = @next()
    throw CalcError(message: "expected #{kind}, found '#{token.text}'") if token.kind != kind
    token

  statements = ->
    const result: Statement[]
    while @peek().kind != 'end'
      result.push @statement()
      @expect ';' if @peek().kind != 'end'
    result

  statement = (): Statement ->
    const token = @next()
    case token.kind
      when 'let' then @let_statement()
      when 'print' then Print(value: @expression())
      else throw CalcError(message: "unexpected '#{token.text}'")

  let_statement = ->
    const name = @expect('name').text
    @expect '='
    Let name, value: @expression()

  expression = ->
    var left = @term()
    while @peek().kind == '+' or @peek().kind == '-'
      const operator = @next().kind
      left = Operation(operator, left, right: @term())
    left

  term = ->
    var left = @factor()
    while @peek().kind == '*' or @peek().kind == '/'
      const operator = @next().kind
      left = Operation(operator, left, right: @factor())
    left

  factor = (): Expr ->
    const token = @next()
    case token.kind
      when 'number' then Number(value: token.text.parse_int()!)
      when 'name' then Variable(name: token.text)
      when '('
        const inner = @expression()
        @expect ')'
        inner
      else throw CalcError(message: "unexpected '#{token.text}'")
