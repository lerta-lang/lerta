# Parses tokens into statements, with the usual precedence of operators.
import Token from './lexer'
import CalcError, Expr, Let, Number, Operation, Print, Statement, Variable from './syntax'

export class Parser
  args
    tokens: Token[]
  private
    var position = 0

    peek := -> @tokens[@position]

  next := ->
    token := @tokens[@position]
    @position += 1
    token

  private expect := (kind: String) ->
    token := @next()
    throw CalcError("expected #{kind}, found '#{token.text}'") if token.kind != kind
    token

  statements := ->
    result: Statement[]
    while @peek().kind != 'end'
      result.push @statement()
      @expect ';' if @peek().kind != 'end'
    result

  private
    statement := (): Statement ->
      token := @next()
      case token.kind
        when 'let' then @let_statement()
        when 'print' then Print(@expression())
        else throw CalcError("unexpected '#{token.text}'")

    let_statement := ->
      name := @expect('name').text
      @expect '='
      Let(name, value: @expression())

    expression := ->
      var left = @term()
      while @peek().kind in ['+', '-']
        operator := @next().kind
        left = Operation(operator, left, right: @term())
      left

    term := ->
      var left = @factor()
      while @peek().kind in ['*', '/']
        operator := @next().kind
        left = Operation(operator, left, right: @factor())
      left

    factor := (): Expr ->
      token := @next()
      case token.kind
        when 'number' then Number(token.text.parse_int()!)
        when 'name' then Variable(token.text)
        when '('
          inner := @expression()
          @expect ')'
          inner
        else throw CalcError("unexpected '#{token.text}'")
