# Splits a source text into tokens.
import CalcError from './syntax'

export struct Token
  kind: String
  text: String

const is_name_byte = (c: Byte) -> c.is_letter() or c == '_'

const SYMBOLS =
  '+': true, '-': true, '*': true, '/': true, '(': true, ')': true, '=': true, ';': true

export const tokenize = (source: String) ->
  const tokens: Token[] = []
  const bytes = source.binary
  var i = 0
  while i < bytes.length
    const c = bytes[i]
    if c == ' '
      i += 1
      continue
    var end = i + 1
    if c.is_digit()
      end += 1 while end < bytes.length and bytes[end].is_digit()
      tokens.push Token(kind: 'number', text: bytes.text(i, end)!)
    else if is_name_byte(c)
      end += 1 while end < bytes.length and is_name_byte(bytes[end])
      const word = bytes.text(i, end)!
      const kind = word == 'let' or word == 'print' then word else 'name'
      tokens.push Token(kind, text: word)
    else
      const symbol = bytes.text(i, end)!
      throw CalcError(message: "unexpected character '#{symbol}'") if not SYMBOLS.has(symbol)
      tokens.push Token(kind: symbol, text: symbol)
    i = end
  tokens.push Token(kind: 'end', text: '')
  tokens
