# Splits a source text into tokens.
import scan from 'std:scanner'
import CalcError from './syntax'

export struct Token(kind: String, text: String)

is_name_character := (c: Char) -> c.is_letter() or c == '_'

SYMBOLS := Set(['+', '-', '*', '/', '(', ')', '=', ';'])

export tokenize := (source: String) ->
  tokens: Token[]
  scanner := scan(source)
  while c := scanner.peek()
    if c == ' '
      scanner.next()
    else if c.is_digit()
      tokens.push Token(kind: 'number', text: scanner.take_while((d) -> d.is_digit()))
    else if is_name_character(c)
      word := scanner.take_while(is_name_character)
      kind := word == 'let' or word == 'print' then word else 'name'
      tokens.push Token(kind, text: word)
    else
      taken := scanner.mark()
      scanner.next()
      symbol := taken()
      throw CalcError(message: "unexpected character '#{symbol}'") if not SYMBOLS.has(symbol)
      tokens.push Token(kind: symbol, text: symbol)
  tokens.push Token(kind: 'end', text: '')
  tokens
