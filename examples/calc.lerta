# A tiny language: `let` binds a name, `print` prints a value.
import { tokenize } from './calc/lexer'
import { Parser } from './calc/parser'
import { Expr, Let, Number, Operation, Print, Statement, Variable } from './calc/syntax'

const variables: Map<String, Int> = Map()

const evaluate = (e: Expr): Int ->
  case e
    when Number then e.value
    when Variable then variables[e.name] ? throw "undefined name '#{e.name}'"
    when Operation then apply(e.operator, evaluate(e.left), evaluate(e.right))

const apply = (operator: String, a: Int, b: Int): Int ->
  case operator
    when '+' then a + b
    when '-' then a - b
    when '*' then a * b
    when '/' then a / b
    else throw "unknown operator '#{operator}'"

const run = (s: Statement) ->
  case s
    when Let
      variables[s.name] = evaluate(s.value)
    when Print then print(evaluate(s.value))

const source = 'let x = 2 + 3 * 4; print x; let y = (x - 4) / 2; print x * y - 1'
run(statement) for statement in Parser(tokens: tokenize(source)).statements()
