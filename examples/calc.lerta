# A tiny language: `let` binds a name, `print` prints a value.
import tokenize from './calc/lexer'
import Parser from './calc/parser'
import CalcError, Expr, Let, Number, Operation, Print, Statement, Variable from './calc/syntax'

variables: Map<String, Int>

evaluate := (e: Expr): Int ->
  case e
    when Number then e.value
    when Variable then variables[e.name] ? throw CalcError(message: "undefined name '#{e.name}'")
    when Operation then apply(e.operator, evaluate(e.left), evaluate(e.right))

apply := (operator: String, a: Int, b: Int) ->
  case operator
    when '+' then a + b
    when '-' then a - b
    when '*' then a * b
    when '/' then a / b
    else throw CalcError(message: "unknown operator '#{operator}'")

run := (s: Statement) ->
  case s
    when Let then variables[s.name] = evaluate(s.value)
    when Print then print(evaluate(s.value))

SOURCE := 'let x = 2 + 3 * 4; print x; let y = (x - 4) / 2; print x * y - 1'
run statement for statement in Parser(tokens: tokenize(SOURCE)).statements()
try
  tokenize 'let é = 1'
catch e: CalcError
  print e.message
