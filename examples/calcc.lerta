# Compiles the calculator language to LLVM IR, which clang turns into a program.
import tokenize from './calc/lexer'
import Parser from './calc/parser'
import CalcError, Expr, Let, Number, Operation, Print, Statement, Variable from './calc/syntax'

class Emitter
  lines: String[] = []
  var next_register = 0
  slots: Map<String, String> = Map()

  fresh := ->
    @next_register += 1
    "%r#{@next_register}"

  emit := (line: String) -> @lines.push("  #{line}")

  expression := (e: Expr): String ->
    case e
      when Number then e.value.to_string()
      when Variable
        slot := @slots[e.name] ? throw CalcError("undefined name '#{e.name}'")
        register := @fresh()
        @emit "#{register} = load i64, ptr #{slot}"
        register
      when Operation
        left := @expression(e.left)
        right := @expression(e.right)
        register := @fresh()
        @emit "#{register} = #{instruction(e.operator)} i64 #{left}, #{right}"
        register

  statement := (s: Statement) ->
    case s
      when Let
        value := @expression(s.value)
        slot := "%#{s.name}"
        unless s.name in @slots
          @slots[s.name] = slot
          @emit "#{slot} = alloca i64"
        @emit "store i64 #{value}, ptr #{slot}"
      when Print
        value := @expression(s.value)
        @emit "call i32 (ptr, ...) @printf(ptr @format, i64 #{value})"

instruction := (operator: String) ->
  case operator
    when '+' then 'add'
    when '-' then 'sub'
    when '*' then 'mul'
    when '/' then 'sdiv'
    else throw CalcError("unknown operator '#{operator}'")

compile := (source: String) ->
  emitter := Emitter()
  emitter.statement statement for statement in Parser(tokenize(source)).statements()
  return
    '@format = private constant [5 x i8] c"%ld\0A\00"'
    'declare i32 @printf(ptr, ...)'
    'define i32 @main() {'
    emitter.lines.join("\n")
    '  ret i32 0'
    '}'
    ''
  .join("\n")

print compile('let x = 2 + 3 * 4; print x; let y = (x - 4) / 2; let x = x + 1; print x * y - 1')
