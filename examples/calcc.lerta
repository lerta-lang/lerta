# Compiles the calculator language to LLVM IR, which clang turns into a program.
import { tokenize } from './calc/lexer'
import { Parser } from './calc/parser'
import { Expr, Let, Number, Operation, Print, Statement, Variable } from './calc/syntax'

class Emitter
  lines: Array<String> = []
  next_register = 0
  slots: Map<String, String> = Map()

  fresh = (): String ->
    @next_register += 1
    "%r#{@next_register}"

  emit = (line: String) -> @lines.push("  #{line}")

  expression = (e: Expr): String ->
    case e
      when Number then e.value.to_string()
      when Variable
        const slot = @slots[e.name] ? throw "undefined name '#{e.name}'"
        const register = @fresh()
        @emit("#{register} = load i64, ptr #{slot}")
        register
      when Operation
        const left = @expression(e.left)
        const right = @expression(e.right)
        const register = @fresh()
        @emit("#{register} = #{instruction(e.operator)} i64 #{left}, #{right}")
        register

  statement = (s: Statement) ->
    case s
      when Let
        const value = @expression(s.value)
        const slot = "%#{s.name}"
        if not @slots.has(s.name)
          @slots[s.name] = slot
          @emit("#{slot} = alloca i64")
        @emit("store i64 #{value}, ptr #{slot}")
      when Print
        const value = @expression(s.value)
        @emit("call i32 (ptr, ...) @printf(ptr @format, i64 #{value})")

const instruction = (operator: String): String ->
  case operator
    when '+' then 'add'
    when '-' then 'sub'
    when '*' then 'mul'
    when '/' then 'sdiv'
    else throw "unknown operator '#{operator}'"

const compile = (source: String): String ->
  const emitter = Emitter()
  emitter.statement(statement) for statement in Parser(tokens: tokenize(source)).statements()
  [
    '@format = private constant [5 x i8] c"%ld\0A\00"'
    'declare i32 @printf(ptr, ...)'
    'define i32 @main() {'
    emitter.lines.join("\n")
    '  ret i32 0'
    '}'
    ''
  ].join("\n")

print compile('let x = 2 + 3 * 4; print x; let y = (x - 4) / 2; let x = x + 1; print x * y - 1')
