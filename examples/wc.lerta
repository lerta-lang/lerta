# Counts the lines, words and bytes of the files named on the command line, or of standard input
# without them, like wc.
import read_file, stdin from 'std:io'
import argv from 'std:process'

const count = (bytes: Binary, name: String) ->
  var lines = 0
  var words = 0
  var in_word = false
  for c in bytes
    lines += 1 if c == "\n"
    const is_space = c.is_space()
    words += 1 if not is_space and not in_word
    in_word = not is_space
  print "#{lines} #{words} #{bytes.length}#{name}"

count await stdin.read_all(), '' if argv.length == 0
count await read_file(path), " #{path}" for path in argv
