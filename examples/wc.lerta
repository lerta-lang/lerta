# Counts the lines, words and bytes of the files named on the command line, like wc.
import { read_file } from 'std:io'
import { argv } from 'std:process'

const count = (path: String) ->
  const bytes = read_file(path)
  var lines = 0
  var words = 0
  var in_word = false
  for i in 0...bytes.length
    const c = bytes[i]
    lines += 1 if c == "\n"
    const is_space = c == ' ' or c == "\n" or c == "\t"
    words += 1 if not is_space and not in_word
    in_word = not is_space
  print "#{lines} #{words} #{bytes.length} #{path}"

print 'usage: wc FILE...' if argv.length == 0
count(path) for path in argv
