# Counts the words of a text and prints them by count, then in order of first appearance.
TEXT := 'the quick fox and the lazy dog and the end'

counts: Map<String, Int>
for word in TEXT.split(' ')
  counts[word, default: 0] += 1

# sorted_by keeps the order of words of the same count, which is that of the entries.
print "#{word}: #{count}" for (word, count) in counts.to_array().sorted_by(((_, count)) -> -count)
