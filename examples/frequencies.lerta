# Counts the words of a text and prints them by count, then in order of first appearance.
const TEXT = 'the quick fox and the lazy dog and the end'

const counts: Map<String, Int>
counts[word] = (counts[word] ? 0) + 1 for word in TEXT.split(' ')

var n = counts.values().max() ? 0
while n > 0
  for (word, count) in counts.entries()
    print "#{word}: #{n}" if count == n
  n -= 1
