# Counts the words of a text and prints them by count, then in order of first appearance.
const text = 'the quick fox and the lazy dog and the end'

const words = (s: String): Array<String> ->
  const result: Array<String> = []
  var start = 0
  const bytes = s.binary
  for i in 0...bytes.length + 1
    if i == bytes.length or bytes[i] == ' '
      result.push(bytes.slice(start, i).decode_utf8()!) if i > start
      start = i + 1
  result

const counts: Map<String, Int> = Map()
counts[word] = (counts[word] ? 0) + 1 for word in words(text)

var most = 0
for word in counts.keys()
  most = counts[word]! if counts[word]! > most
var n = most
while n > 0
  print "#{word}: #{n}" for word in counts.keys() when counts[word]! == n
  n -= 1
