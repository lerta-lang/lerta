# Sorts numbers in place with insertion sort, then joins them into one line.
const sort = (xs: Array<Int>) ->
  for i in 1...xs.length
    var j = i
    while j > 0 and xs[j - 1] > xs[j]
      const previous = xs[j - 1]
      xs[j - 1] = xs[j]
      xs[j] = previous
      j -= 1

const numbers = [5, 3, 9, 1, 4, 1]
sort(numbers)
print [n.to_string() for n in numbers].join(', ')
