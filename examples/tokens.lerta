# A class that splits a line into tokens, as the first step of a compiler does.
struct Token
  kind: String
  text: String
  describe = -> "#{@kind}(#{@text})"

class Lexer
  source: Binary
  position = 0

  next_token = (): Token? ->
    @skip_spaces()
    return nil if @position >= @source.length
    const start = @position
    const kind = is_digit(@source[start]) then 'number' else 'word'
    @position += 1 while @position < @source.length and @source[@position] != ' '
    Token(kind: kind, text: @source.slice(start, @position).decode_utf8()!)

  skip_spaces = ->
    @position += 1 while @position < @source.length and @source[@position] == ' '

const is_digit = (c: Byte) -> c >= '0' and c <= '9'

const lexer = Lexer(source: 'let x  42 plus 7'.binary)
while const token = lexer.next_token()
  print token.describe()
