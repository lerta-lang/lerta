# The first step of a Lerta compiler written in Lerta: it splits a source into tokens, with the
# indentation as indent and dedent tokens, and prints them. It covers a subset of Lerta: names,
# keywords, integers, '...' strings and some punctuation, but not "..." strings or tabs.
import scan, Scanner from 'std:scanner'

# An error in the source, with its line.
struct LexError: Error

struct Token
  kind: String
  text: String
  line: Int

KEYWORDS := Set(['var', 'if', 'else', 'for', 'in'])
# Longer punctuations come first, so that `->` is not read as `-` and `>`.
PUNCTUATIONS :=
  '...', '->', '==', '+=', ':=', '(', ')', ':', ',', '=', '+', '-', '*', '%', '<', '>'

is_name_start := (c: Char) -> c.is_letter() or c == '_'
is_name_character := (c: Char) -> is_name_start(c) or c.is_digit()

class Lexer
  source: Scanner
  tokens: Token[] = []
  indents = [0]
  line = 1

  add = (kind: String, text: String) -> @tokens.push({ kind, text, line: @line })
  peek = -> @source.peek() ? "\n"
  top_indent = -> @indents.last()!
  fail = (problem: String) -> throw LexError("#{@line}: #{problem}")

  run = ->
    @scan_line() while not @source.done()
    @add 'dedent', '' for _ in 0...(@indents.length - 1)
    @tokens

  # A line that is blank or holds only a comment gives no tokens, so it does not change the
  # indentation.
  scan_line = ->
    var width = 0
    width += 1 while @source.take(' ')
    if @peek() != "\n" and @peek() != '#'
      @indent width
      @scan_token() while @peek() != "\n" and @peek() != '#'
      @add 'newline', ''
    @source.skip_while (c) -> c != "\n"
    @source.next()
    @line += 1

  indent = (width: Int) ->
    if width > @top_indent()
      @indents.push width
      @add 'indent', ''
    while width < @top_indent()
      @indents.pop()
      @add 'dedent', ''
    @fail 'the indentation matches no outer block' if width != @top_indent()

  scan_token = ->
    c := @peek()
    case
      when c == ' ' then @source.skip_while((c) -> c == ' ')
      when c.is_digit() then @add('integer', @source.take_while((d) -> d.is_digit()))
      when is_name_start(c)
        word := @source.take_while(is_name_character)
        @add word in KEYWORDS then word else 'name', word
      when @source.take("'")
        text := @source.take_while((c) -> c != "'" and c != "\n")
        @fail 'the string is not closed' if not @source.take("'")
        @add 'string', text
      else @scan_punctuation()

  scan_punctuation = ->
    for punctuation in PUNCTUATIONS
      return @add(punctuation, punctuation) if @source.take(punctuation)
    @fail 'unexpected character'

source :=
  '# sums the squares of the even numbers'
  'square := (x: Int): Int -> x * x'
  'var total = 0'
  'for i in 0...10'
  '  # odd numbers are skipped'
  ''
  '  if i % 2 == 0'
  '    total += square(i)'
  "print 'done'"
  'for j in 0...2'
  '  if j == 1'
  "    print 'last'"
  # so that the last line ends with a line end too
  ''
.join("\n")

for token in Lexer(scan(source)).run()
  shown := token.text.is_empty() then '' else " #{token.text}"
  print "#{token.line} #{token.kind}#{shown}"
