# The first step of a Lerta compiler written in Lerta: it splits a source into tokens, with the
# indentation as indent and dedent tokens, and prints them. It covers a subset of Lerta: names,
# keywords, integers, '...' strings and some punctuation, but not "..." strings or tabs.

# An error in the source, with its line.
struct LexError: Error

struct Token
  kind: String
  text: String
  line: Int

const KEYWORDS = { 'const': true, 'var': true, 'if': true, 'else': true, 'for': true, 'in': true }
# Longer punctuations come first, so that `->` is not read as `-` and `>`.
const PUNCTUATIONS =
  '...', '->', '==', '+=', '(', ')', ':', ',', '=', '+', '-', '*', '%', '<', '>'

const is_name_byte = (c: Byte) -> c.is_letter() or c == '_'

class Lexer
  source: Binary
  tokens: Array<Token> = []
  indents: Array<Int> = [0]
  position = 0
  line = 1

  add = (kind: String, text: String) -> @tokens.push(Token(kind, text, line: @line))
  peek = (): Byte -> @position < @source.length then @source[@position] else "\n"
  text = (start: Int, end: Int) -> @source.text(start, end)!
  top_indent = -> @indents.last()!
  fail = (problem: String): never -> throw LexError(message: "#{@line}: #{problem}")

  run = ->
    @scan_line() while @position < @source.length
    @add 'dedent', '' for _ in 0...(@indents.length - 1)
    @tokens

  # A line that is blank or holds only a comment gives no tokens, so it does not change the
  # indentation.
  scan_line = ->
    const start = @position
    @position += 1 while @peek() == ' '
    if @peek() != "\n" and @peek() != '#'
      @indent @position - start
      @scan_token() while @peek() != "\n" and @peek() != '#'
      @add 'newline', ''
    @position += 1 while @peek() != "\n"
    @position += 1
    @line += 1

  indent = (width: Int) ->
    if width > @top_indent()
      @indents.push width
      @add 'indent', ''
    while width < @top_indent()
      @indents.pop()
      @add 'dedent', ''
    @fail 'the indentation matches no outer block' if width != @top_indent()

  scan_token = ->
    const start = @position
    const c = @peek()
    case
      when c == ' ' then @position += 1
      when c.is_digit()
        @position += 1 while @peek().is_digit()
        @add 'integer', @text(start, @position)
      when is_name_byte(c)
        @position += 1 while is_name_byte(@peek()) or @peek().is_digit()
        const word = @text(start, @position)
        @add KEYWORDS.has(word) then word else 'name', word
      when c == "'"
        @position += 1
        @position += 1 while @peek() != "'" and @peek() != "\n"
        @fail 'the string is not closed' if @peek() != "'"
        @position += 1
        @add 'string', @text(start + 1, @position - 1)
      else @scan_punctuation()

  scan_punctuation = ->
    const punctuation = PUNCTUATIONS.find((p) -> @at(p)) ? @fail('unexpected character')
    @position += punctuation.binary.length
    @add punctuation, punctuation

  # Compares bytes, since the next ones may not be a whole character.
  at = (punctuation: String) -> @source.occurs_at(@position, punctuation.binary)

const source =
  '# sums the squares of the even numbers'
  'const square = (x: Int): Int -> x * x'
  'var total = 0'
  'for i in 0...10'
  '  # odd numbers are skipped'
  ''
  '  if i % 2 == 0'
  '    total += square(i)'
  "print 'done'"
  'for j in 0...2'
  '  if j == 1'
  "    print 'last'"
  # so that the last line ends with a line end too
  ''
.join("\n")

for token in Lexer(source: source.binary).run()
  const shown = token.text == '' then '' else " #{token.text}"
  print "#{token.line} #{token.kind}#{shown}"
