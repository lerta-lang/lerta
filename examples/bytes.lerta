# Scans the bytes of a line: counts its words and adds up its digits.
const is_letter = (c: Byte) -> (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
const is_digit = (c: Byte) -> c >= '0' and c <= '9'

const text = 'Lerta 0.1 has 2 examples and 3 tests'.binary
var words = 0
var digit_sum = 0
var in_word = false
for i in 0...text.length
  const c = text[i]
  if is_letter(c)
    words += 1 if not in_word
    in_word = true
  else
    in_word = false
  digit_sum += (c - '0').to_int() if is_digit(c)
print "#{words} words, digits add up to #{digit_sum}"
