# Adds up the numbers among the words of a line.
const words = (line: String): Array<String> ->
  const bytes = line.binary
  const result: Array<String> = []
  var start = 0
  for i in 0...bytes.length + 1
    if i == bytes.length or bytes[i] == ' '
      result.push(bytes.slice(start, i).decode_utf8()!) if i > start
      start = i + 1
  result

var total = 0
for word in words('3 apples and 14 pears or -2 plums')
  if const n = word.parse_int()
    total += n
  else
    print "skipped #{word}"
print "total #{total}"
