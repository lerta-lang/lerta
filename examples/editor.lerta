# A tiny editor run by a script of commands, which can undo its changes.
import scan from 'std:scanner'

struct Insert
  text: String
struct Delete
  count: Int
struct Undo
  steps: Int
type Command = Insert | Delete | Undo

parse := (line: String): Command? ->
  (word, argument) := line.split_once(' ') ? (line, '')
  case word
    when 'insert'
      return nil if argument.is_empty()
      Insert(argument)
    when 'delete'
      count := argument.parse_int() ? return nil
      Delete(count)
    when 'undo'
      return Undo(1) if argument.is_empty()
      steps := argument.parse_int() ? return nil
      Undo(steps)
    else nil

class Editor
  args
    on_change: (String) -> void
  private
    var text = ''
    history: String[] = []

  init := -> print('opened')
  deinit := -> print("closed, undo history: #{@history.length}")

  run := (command: Command) ->
    case command
      when Insert then @change(@text + command.text)
      when Delete
        scanner := scan(@text)
        kept := scanner.mark()
        scanner.next() for _ in 0..max(@text.iter().to_array().length - command.count, 0)
        @change kept()
      when Undo
        for _ in 0..command.steps
          @text = @history.pop() unless @history.is_empty()
        @on_change @text

  private change := (text: String) ->
    @history.push @text
    @text = text
    @on_change text

type Printer = (String) -> void

# Gives a function that numbers the lines it prints, counting in a variable it keeps.
numbered_printer := (): Printer ->
  var count = 0
  (text) ->
    count += 1
    print "#{count}: #{text}"

edit := (script: String[]) ->
  editor := Editor(numbered_printer())
  for line in script
    command := parse(line) ? continue
    editor.run command

edit [
  'insert Hello'
  'insert , world'
  'delete 7'
  'insert , Lerta!'
  'bogus'
  'insert'
  'delete'
  'undo x'
  'undo 2'
  'undo'
  'insert  é😀'
  'delete 1'
  'delete 99'
]
