# Functions: recursion, loops in bodies and early returns.
const gcd = (a: Int, b: Int): Int ->
  return a if b == 0
  gcd(b, a % b)

const fib = (n: Int) ->
  var a = 0
  var b = 1
  for _ in 0...n
    const next = a + b
    a = b
    b = next
  a

const show = (label: String, value: Int) ->
  print label
  print value

show 'gcd(48, 18)', gcd(48, 18)
print fib(i) for i in 0...10
