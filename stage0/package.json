{
  "name": "lerta-stage0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc && prettier --check src test && cspell --no-progress --root .. -c ../cspell.json \"**\"",
    "format": "prettier --write src test",
    "test": "nice sh -c 'node test/run.ts; a=$?; node test/cli.ts; b=$?; node test/bootstrap.ts; c=$?; node test/runtime.ts && exit $((a || b || c))'",
    "test:compare": "nice node test/compiler.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "cspell": "^10.3.6",
    "prettier": "^3.9.9",
    "typescript": "^5.9"
  },
  "engines": {
    "node": ">=22.18"
  }
}
