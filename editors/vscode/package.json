{
  "name": "lerta",
  "displayName": "Lerta",
  "description": "Syntax highlighting, diagnostics and formatting for Lerta, by lerta lsp, and syntax highlighting for llit",
  "version": "0.0.1",
  "publisher": "lerta",
  "private": true,
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:lerta"],
  "capabilities": { "untrustedWorkspaces": { "supported": "limited", "restrictedConfigurations": ["lerta.path"] } },
  "contributes": {
    "languages": [
      {
        "id": "lerta",
        "aliases": ["Lerta"],
        "extensions": [".lerta"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "llit",
        "aliases": ["llit"],
        "extensions": [".llit"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lerta",
        "scopeName": "source.lerta",
        "path": "./syntaxes/lerta.tmLanguage.json"
      },
      {
        "language": "llit",
        "scopeName": "source.llit",
        "path": "./syntaxes/llit.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Lerta",
      "properties": {
        "lerta.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "The lerta command whose language server (lerta lsp) checks and formats .lerta files. Empty means the workspace's bin/lerta if it exists, otherwise lerta on PATH."
        }
      }
    }
  }
}
