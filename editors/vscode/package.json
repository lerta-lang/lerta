{
  "name": "lerta",
  "displayName": "Lerta",
  "description": "Syntax highlighting for Lerta",
  "version": "0.0.1",
  "publisher": "lerta",
  "private": true,
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "lerta",
        "aliases": ["Lerta"],
        "extensions": [".lerta"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lerta",
        "scopeName": "source.lerta",
        "path": "./syntaxes/lerta.tmLanguage.json"
      }
    ]
  }
}
