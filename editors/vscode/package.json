{
  "name": "lerta",
  "displayName": "Lerta",
  "description": "Syntax highlighting and compiler diagnostics for Lerta",
  "version": "0.0.1",
  "publisher": "lerta",
  "private": true,
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:lerta"],
  "capabilities": { "untrustedWorkspaces": { "supported": "limited", "restrictedConfigurations": ["lerta.path"] } },
  "contributes": {
    "languages": [
      {
        "id": "lerta",
        "aliases": ["Lerta"],
        "extensions": [".lerta"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lerta",
        "scopeName": "source.lerta",
        "path": "./syntaxes/lerta.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Lerta",
      "properties": {
        "lerta.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "The lerta command that checks a .lerta file when it is opened or saved. Empty means the workspace's bin/lerta if it exists, otherwise lerta on PATH."
        }
      }
    }
  }
}
