{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lerta",
  "scopeName": "source.lerta",
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#raw_string"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#declaration"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#type"
        },
        {
          "include": "#call"
        },
        {
          "include": "#operator"
        }
      ]
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.lerta"
    },
    "raw_string": {
      "match": "'[^']*'",
      "name": "string.quoted.single.lerta"
    },
    "string": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.lerta",
      "patterns": [
        {
          "match": "\\\\(?:[ntr0\\\\\"#]|u\\{[0-9A-Fa-f]+\\})",
          "name": "constant.character.escape.lerta"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.lerta"
        },
        {
          "begin": "#\\{",
          "end": "\\}",
          "name": "meta.interpolation.lerta",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.lerta"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.lerta"
            }
          },
          "contentName": "source.lerta",
          "patterns": [
            {
              "include": "#braces"
            },
            {
              "include": "#code"
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "\\b(?:0x[0-9A-Fa-f]+|0|[1-9](?:_?[0-9])*)\\b",
          "name": "constant.numeric.integer.lerta"
        },
        {
          "match": "\\b[0-9][A-Za-z0-9_]*\\b",
          "name": "invalid.illegal.numeric.lerta"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(?:true|false|nil)\\b",
          "name": "constant.language.lerta"
        },
        {
          "match": "\\b(?:and|or|not|is)\\b",
          "name": "keyword.operator.word.lerta"
        },
        {
          "match": "\\b(?:if|else|then|while|for|in|break|continue|return|case|when|throw|import|export)\\b",
          "name": "keyword.control.lerta"
        },
        {
          "match": "\\b(?:const|var|class|struct|extern|extend)\\b",
          "name": "storage.type.lerta"
        }
      ]
    },
    "declaration": {
      "match": "\\b(class|struct|extend)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.lerta"
        },
        "2": {
          "name": "entity.name.type.lerta"
        }
      }
    },
    "type": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.lerta"
    },
    "call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.lerta"
        }
      }
    },
    "operator": {
      "match": "\\.\\.\\.|->|[=!<>+\\-*/%]=|[+\\-*/%<>=?!@|]",
      "name": "keyword.operator.lerta"
    },
    "constant": {
      "match": "\\b[A-Z][A-Z0-9_]+\\b",
      "name": "variable.other.constant.lerta"
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "#code"
        }
      ]
    }
  }
}
