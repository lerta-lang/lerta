# Serves the requests of load.lerta at a free port of 127.0.0.1, which it prints first.
import Request, Response, serve from 'std:http'
import encode_json from 'std:json'

handle := (request: Request) ->
  { url } := request
  case
    when url.ends_with('/hello') then Response(body: 'Hello, world!')
    when url.ends_with('/json')
      Response(body: encode_json({ id: 1, name: 'lerta', tags: ['fast', 'small'] }))
    when url.ends_with('/echo') then Response(body: await request.binary())
    else Response(status: 404)

server := serve(handle)
print server.port
