# Adds up, over a number of rounds, the items of lazy pipelines of filters and maps over a generator
# of pseudo-random numbers, with functions that capture the round, and prints the total.
ROUNDS := 20
COUNT := 1000000

# MINSTD from the seed, whose products fit in the integers of every language compared.
randoms := (seed: Int, count: Int) ->
  var state = seed
  for _ in 0..count
    state = state * 48271 % 2147483647
    yield state

var total = 0
for k in 1..=ROUNDS
  total += randoms(k, COUNT).filter((x) -> x % k != 0).map((x) -> x % 1000 + k).sum()

  # A lazy comprehension, which goes through the Iters of filter and map as the methods do.
  # On one line, as its for first would make it a function that yields, which this does not measure.
  multiples := (x % 1000 * 7 for x in randoms(k, COUNT) when x % 2 == 0)  # fmt: skip
  total += multiples.fold(0, (a, b) -> a + b)
print total
