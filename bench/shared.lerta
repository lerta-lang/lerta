# What bench/run.lerta and bench/http/run.lerta share: commands to run, and the table they print.
import Buffer from 'std:io'
import run from 'std:process'

export struct Command
  program: String
  args: String[]

export is_found := (command: String) ->
  (await run('sh', '-c', "command -v #{command} >/dev/null")).code == 0

# Runs the command, its standard output captured if `capture`. Gives why it failed, or nil if it
# succeeded, and what it printed, empty if not captured.
export run_failure := (label: String, command: Command, capture = false) ->
  output := Buffer()
  exit := await run(command.program, command.args..., stdout: capture then output)
  failure := exit.code != 0 then "#{label} failed with exit code #{exit.code}"
  (failure, output.binary)

# Where the programs are built.
export OUT := 'build/bench'
NAME_COLUMN := 12

# A row of the table: its name, then the cells, each right-aligned in `column` characters; the cell
# at `bold` is in bold.
export print_row := (name: String, cells: String[], column: Int, bold: Int? = nil) ->
  padded := [
    for cell at i in cells
      in_bold(cell.pad_start(column), i == bold)
  ]
  print [name.pad_end(NAME_COLUMN), padded...].join(' ')

in_bold := (text: String, bold: Bool) -> bold then "\x1B[1m#{text}\x1B[0m" else text

# A line across the rows of `count` cells, each `column` characters wide.
export print_rule := (count: Int, column: Int) ->
  print '-'.repeat(NAME_COLUMN + (column + 1) * count)
