# Builds complete binary trees of growing depths many times, counting the nodes of each before
# dropping it, while one long-lived tree is kept, and prints the count of all the nodes.
class Node
  left: Node?
  right: Node?

const make = (depth: Int): Node ->
  return Node(left: nil, right: nil) if depth == 0
  Node(left: make(depth - 1), right: make(depth - 1))

const check = (node: Node): Int ->
  const left = node.left
  const right = node.right
  return 1 if left == nil or right == nil
  1 + check(left) + check(right)

const MAX_DEPTH = 16
const long_lived = make(MAX_DEPTH)
var total = 0
var depth = 4
while depth <= MAX_DEPTH
  # 16 << (MAX_DEPTH - depth), as there is no shift operator yet.
  var iterations = 16
  iterations *= 2 for _ in 0...MAX_DEPTH - depth
  total += check(make(depth)) for _ in 0...iterations
  depth += 2
print total + check(long_lived)
