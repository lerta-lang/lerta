# Counts the points of a size × size grid that stay in the Mandelbrot set for 100 iterations.
mandelbrot := (size: Int) ->
  var inside = 0
  for y in 0..size
    for x in 0..size
      cr := 2.0 * x.to_float() / size.to_float() - 1.5
      ci := 2.0 * y.to_float() / size.to_float() - 1.0
      var zr = 0.0
      var zi = 0.0
      var i = 0
      while i < 100 and zr * zr + zi * zi <= 4.0
        t := zr * zr - zi * zi + cr
        zi = 2.0 * zr * zi + ci
        zr = t
        i += 1
      inside += 1 if i == 100
  inside

print mandelbrot(2000)
