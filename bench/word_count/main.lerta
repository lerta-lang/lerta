# Makes lines of 8 words picked by a pseudo-random generator, splits each line back into its words
# and counts them, then prints the 5 most frequent words, by count and then by word, and how many
# words there are.
const LINES = 1000000
const WORDS_PER_LINE = 8
const VOCABULARY = 5000

# MINSTD, whose products fit in the integers of every language compared.
var seed = 1
const next_word = ->
  seed = seed * 48271 % 2147483647
  "w#{seed % VOCABULARY}"

const counts = Map<String, Int>()
for _ in 0...LINES
  const line = [next_word() for _ in 0...WORDS_PER_LINE].join(' ')
  counts[word] = (counts[word] ? 0) + 1 for word in line.split(' ')

const by_frequency = (a: (String, Int), b: (String, Int)) ->
  const (word_a, count_a) = a
  const (word_b, count_b) = b
  count_a == count_b then word_a.compare(word_b) else count_b - count_a

const ranked = counts.entries().to_array().sorted(by_frequency)
print "#{word} #{count}" for (word, count) in ranked.take(5)
print counts.length
