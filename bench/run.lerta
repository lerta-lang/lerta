# Builds each benchmark in Lerta, C, Swift, Go and JavaScript (Node.js), runs each 3 times, checks
# that every run of every language prints the same, and prints the best wall-clock time of each in
# seconds, and last the geometric mean of those of each language. C is built with clang, or else
# cc; Swift only where swiftc is, Go only where go is; Node.js, 22 or later, must be there.
# Run it from the repository's root, as `make bench` does after building bin/lerta; the programs go
# to build/bench/.
import is_dir, list_dir, make_dir from 'std:io'
import pow from 'std:math'
import exit from 'std:process'
import time from 'std:time'
import Command, is_found, OUT, print_row, run_failure from './shared'

# The directories of bench/, one for each benchmark, in order; http/ has a runner of its own.
BENCHMARKS := [name for name in list_dir('bench') when is_dir("bench/#{name}") and name != 'http']
# The languages, in the order of the columns, and the extensions of their sources.
EXTENSIONS := { 'lerta': 'lerta', 'c': 'c', 'swift': 'swift', 'go': 'go', 'node': 'js' }
RUNS := 3
COLUMN := 8

fail := (message: String) ->
  print_error message
  exit 1

find_c_compiler := ->
  return 'clang' if await is_found('clang')
  return 'cc' if await is_found('cc')
  fail 'no C compiler: neither clang nor cc is found'

c_compiler := await find_c_compiler()
has_swift := await is_found('swiftc')
has_go := await is_found('go')

# Runs the command, which must succeed (see run_failure).
run_checked := (label: String, command: Command, output: Byte[]? = nil) ->
  fail failure if failure := await run_failure(label, command, output)

# The command that runs the benchmark in the language, built first if it is compiled; nil where the
# language's compiler is missing.
build := (name: String, language: String) ->
  source := "bench/#{name}/main.#{EXTENSIONS[language]!}"
  executable := "#{OUT}/#{name}-#{language}"
  output := ['-o', executable]
  return Command(program: 'node', args: [source]) if language == 'node'
  return nil if language == 'swift' and not has_swift
  return nil if language == 'go' and not has_go
  compile :=
    case language
      when 'lerta' then Command(program: 'bin/lerta', args: ['build', source, '-O', output...])
      when 'c' then Command(program: c_compiler, args: ['-O2', source, '-lm', output...])
      when 'go' then Command(program: 'go', args: ['build', output..., source])
      else Command(program: 'swiftc', args: ['-O', source, '-lm', output...])
  await run_checked("building #{name} in #{language}", compile)
  Command program: executable, args: []

# The best time of the runs, in seconds, and what each printed, which must be the same.
measure := (label: String, command: Command) ->
  times: Float[]
  var printed = ''
  for i in 0...RUNS
    bytes: Byte[]
    start := time()
    await run_checked(label, command, bytes)
    times.push time() - start
    output := bytes.to_binary().text() ? fail("#{label} printed what is not UTF-8")
    fail "#{label} printed differently in two runs" if i > 0 and output != printed
    printed = output
  (times.min()!, printed)

make_dir OUT
no_swift := has_swift then '' else '; no swiftc, so no Swift'
no_go := has_go then '' else '; no go, so no Go'
print "C: #{c_compiler}#{no_swift}#{no_go}"
print_row 'benchmark', EXTENSIONS.keys().to_array(), COLUMN
# The times of each language, one for each benchmark; none for a language whose compiler is missing.
times: Map<String, Float[]>
for name in BENCHMARKS
  # What the first language that ran printed, which every other must print.
  var expected: { language: String, output: String }?
  cells: String[]
  for language in EXTENSIONS.keys()
    command := await build(name, language)
    if command == nil
      cells.push '-'
      continue
    label := "#{name} in #{language}"
    (seconds, output) := await measure(label, command)
    if first := expected
      if output != first.output
        fail "#{label} printed:\n#{output}#{first.language} printed:\n#{first.output}"
    else
      expected = { language, output }
    times[language, default: []].push(seconds)
    cells.push seconds.to_fixed(2)
  print_row name, cells, COLUMN

geometric_mean := (xs: Float[]) ->
  product := xs.fold(1.0, (product, x) -> product * x)
  pow product, 1.0 / xs.length.to_float()

mean_cell := (language: String) ->
  xs := times[language]
  xs == nil then '-' else geometric_mean(xs).to_fixed(2)

print_row 'geomean', [mean_cell(language) for language in EXTENSIONS.keys()], COLUMN
