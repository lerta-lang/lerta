# Time: waiting, in the event loop, and the clock (see runtime/time.c).

import ceil, floor from 'std:math'

extern lerta_sleep_milliseconds: (Int) -> Promise
extern lerta_utc_offset: (Int) -> Int
export extern lerta_unix_time as time: () -> Float
export extern lerta_monotonic_time as monotonic: () -> Float

# Rounded up, and one more, so as not to end early: libuv's time is in whole milliseconds, so a
# timer may fire up to one before its time. A sleep of 0 only lets others go first. A time past
# what an Int holds is the longest there is.
export sleep := (seconds: Float) ->
  throw ValueError('sleep for a negative time') if seconds < 0
  milliseconds := ceil(seconds * 1000.0)
  waited := milliseconds == 0.0 then 0.0 else milliseconds + 1.0
  lerta_sleep_milliseconds(waited.to_int() ? INT_MAX)

# The whole second that holds the time, as a second of local time starts on one of UTC's: a time
# before the epoch goes down, not toward zero.
export utc_offset := (at: Float = time()) ->
  out_of_range := ValueError("no UTC offset for the time #{at}")
  seconds := floor(at).to_int() ? throw out_of_range
  offset := lerta_utc_offset(seconds)
  throw out_of_range if offset == INT_MIN
  offset
