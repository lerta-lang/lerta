# The general categories of Unicode, apart from the tables, which tools/unicode.lerta writes from
# it, so that it can write them though none is there.
# In the order of their numbers in the table of categories.
export CATEGORIES :=
  'Lu', 'Ll', 'Lt', 'Lm', 'Lo', 'Mn', 'Mc', 'Me', 'Nd', 'Nl', 'No', 'Pc', 'Pd', 'Ps', 'Pe', 'Pi',
  'Pf', 'Po', 'Sm', 'Sc', 'Sk', 'So', 'Zs', 'Zl', 'Zp', 'Cc', 'Cf', 'Cs', 'Co'
