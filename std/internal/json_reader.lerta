# What std:json's generated code reads through, as a Decoder (see std/codable.lerta).
import from_base64 from './base64'
import KIND_BOOL, KIND_NUMBER, KIND_OTHER, KIND_RECORD, KIND_TEXT from '../codable'
import FieldKeys, is_finite, Level, path_of, quoted from './json_text'
import JsonError, JsonKeys from '../json'

export class JsonReader
  args
    bytes: Binary
    keys: JsonKeys
  private
    var at = 0

    # Each array or object being read, the innermost last.
    levels: Level[] = []

    # The keys that each object being read has given, the innermost last.
    seen_keys: Set<String>[] = []

    field_keys := FieldKeys(@keys)

  read_bool := ->
    return true if @read_literal('true')
    return false if @read_literal('false')
    @fail_expected('a Bool')

  read_nil := -> @read_literal('null')

  # A Char is written as a string of it alone.
  read_char := ->
    text := @read_string()
    chars := [c for c in text]
    @fail "expected a Char, found #{quoted(text)}" if chars.length != 1
    chars[0]

  # An enum's member is written as a string of its name.
  read_member := (enum_name: String) -> @read_string()

  # A tuple is written as an array of its items.
  begin_tuple := (count: Int) -> @begin_array()

  # A set is written as an array of its items.
  begin_set := -> @begin_array()

  # A map of other keys than Strings is written as an array of its entries, each an array of its
  # key and its value.
  begin_entries := -> @begin_array()
  next_entry := ->
    return false unless @next_item()
    @begin_tuple 2
    @next_tuple_item 2
    true
  entry_value := -> @next_tuple_item(2)
  end_entry := -> @end_tuple(2)
  fail_duplicate := -> @fail('the same as one before')

  # A map and a record are written as objects, of a key for each entry or field.
  begin_map := -> @begin_object()
  read_key := -> @next_key()
  begin_record := -> @begin_object()
  read_field := -> @next_key()

  # Whether the key read is that of the field, as write_field writes it.
  is_field := (key: String, name: String) -> key == @field_keys.key(name)

  fail_missing_field := (name: String) -> @fail("missing the key #{quoted(@field_keys.key(name))}")

  # A number that `parse` reads as what `expected` names, as `an Int8`, or gives nil for.
  private read_number := <T>(expected: String, parse: (String) -> T?): T ->
    number := @number() else @fail_expected(expected)
    value := parse(number) else @fail("expected #{expected}, found #{number}")
    @at += number.binary.length
    value

  # An integer of the type that `expected` names, from `least` to `most`.
  read_integer := (expected: String, least: Int, most: Int): Int ->
    @read_number(expected, (number) ->
      value := number.parse_int()
      value != nil and value in least..=most then value
    )

  # Its digits are read on their own, as a UInt64 may be above the largest Int.
  read_uint64 := ->
    number := @number() else @fail_expected('a UInt64')
    out_of_range := -> @fail("expected a UInt64, found #{number}")
    var value: UInt64 = 0
    for byte in number.binary
      out_of_range() unless byte.is_digit()
      digit := (byte - b'0').to_uint64()
      out_of_range() if value > (MAX_UINT64 - digit) / 10
      value = value * 10 + digit
    @at += number.binary.length
    value

  # A number that is not finite as a Float32 is no Float32.
  read_float32 := -> @read_number('a Float32', finite_float32)

  read_binary := ->
    @skip_space()
    @fail_expected 'a Binary' if @peek() != b'"'
    at := @at
    text := @read_string()
    return bytes if bytes := from_base64(text.binary)
    @at = at
    @fail('expected a Binary, found a string that is not base64')

  # A number that is not finite as a Float is no Float.
  read_float := -> @read_number('a Float', String.parse_float)

  read_string := ->
    @skip_space()
    @fail_expected 'a String' if @peek() != b'"'
    @at += 1

    # The bytes from `start` up to an escape or the end need no change, and are taken whole.
    var text = ''
    var start = @at
    while @peek() else @fail('a string that does not end') != b'"'
      byte := @bytes[@at]
      @fail "a control character in a string, #{byte_text(byte)}" if byte < 0x20
      if byte == b'\'
        text += @bytes.text(start, @at)!
        @at += 1
        text += @read_escape()
        start = @at
      else
        @at += 1
    text += @bytes.text(start, @at)!
    @at += 1
    text

  # Reads `[` of an array, whose items next_item then starts.
  begin_array := -> @begin(b'[', 'an array')

  # Whether another item of the innermost array follows, which it then starts reading.
  next_item := ->
    level := @levels.last()!
    count := level.count
    return false unless @has_next(b']')
    level.step = "[#{count}]"
    true

  # Reads `{` of an object, whose keys next_key then gives.
  private
    begin_object := ->
      @begin b'{', 'an object'
      @seen_keys.push Set<String>()

    # The next key of the innermost object, whose value it then starts reading, or nil at its end.
    next_key := ->
      unless @has_next(b'}')
        @seen_keys.pop()
        return nil

      # An error before the key is read is the object's.
      @levels.last()!.step = ''
      @skip_space()
      @fail_expected 'a key' if @peek() != b'"'

      key := @read_string()
      @levels.last()!.step = ".#{key}"
      @skip_space()
      @fail_expected "':'" if @peek() != b':'
      @at += 1
      @fail "the key #{quoted(key)} twice" unless @seen_keys.last()!.add(key)
      key

  # The value where the reader is, of whatever kind, as that of a key that is no field.
  skip_value := (): void ->
    @skip_space()
    byte := @peek()
    if byte == b'"'
      @read_string()
    else if byte == b'['
      @begin_array()
      @skip_value() while @next_item()
    else if byte == b'{'
      @begin_object()
      @skip_value() while @next_key() != nil
    else if not @read_literal('null') and not @read_literal('true') and not @read_literal('false')
      number := @number() else @fail_expected('a value')
      @at += number.binary.length

  # The kind of the value where the reader is, by the first byte that it can be told by, as one of
  # std:codable's KIND_ ones, which tells the member of a union that it is: null and an array are
  # KIND_OTHER, as no member of a union is either.
  peek_kind := ->
    @skip_space()
    byte := @peek() else return KIND_OTHER
    case
      when byte in [b't', b'f'] then KIND_BOOL
      when byte == b'-' or byte.is_digit() then KIND_NUMBER
      when byte == b'"' then KIND_TEXT
      when byte == b'{' then KIND_RECORD
      else KIND_OTHER

  # Starts reading the next of the `count` items of a tuple, which must be there.
  next_tuple_item := (count: Int): void ->
    @fail "expected an array of #{count} items, found fewer" unless @next_item()

  # Reads the end of a tuple of `count` items, which must have no more.
  end_tuple := (count: Int): void ->
    @fail "expected an array of #{count} items, found more" if @next_item()

  # The string just read names no member of the enum.
  fail_member := (enum_name: String, text: String) ->
    @fail "expected a member of #{enum_name}, found #{quoted(text)}"

  private begin := (open: Byte, expected: String) ->
    @skip_space()
    @fail_expected expected if @peek() != open
    @fail "nesting deeper than #{MAX_DEPTH}" if @levels.length == MAX_DEPTH
    @at += 1
    @levels.push Level()

  # Whether another item or key of the innermost array or object follows, after the `,` that it
  # reads; at the end, it reads `close`.
  has_next := (close: Byte) ->
    @skip_space()
    level := @levels.last()!
    if @peek() == close
      @at += 1
      @levels.pop()
      return false
    if level.count > 0
      @fail_expected "',' or '#{byte_text(close)}'" if @peek() != b','
      @at += 1
    level.count += 1
    true

  # Nothing but whitespace follows the value.
  end := (): void ->
    @skip_space()
    @fail_expected 'the end of the text' if @at < @bytes.length

  private
    read_literal := (literal: String) ->
      @skip_space()
      return false unless @bytes.occurs_at(@at, literal.binary)
      @at += literal.binary.length
      true

    # Reads the escape after a backslash in a string, as the Char it gives.
    read_escape := ->
      byte := @peek() else @fail('a string that does not end')
      @at += 1
      return @read_escaped_char() if byte == b'u'
      escaped := unescaped(byte) else @fail("an escape that is not JSON, \\#{byte_text(byte)}")
      escaped.to_char()

    # A surrogate pair is one Char, written as two escapes.
    read_escaped_char := ->
      code := @read_hex_unit()
      return code.to_char()! unless code in 0xD800..=0xDFFF
      lone := -> @fail("a lone surrogate in a string, \\u#{code.to_hex(4)}")
      lone() if code > 0xDBFF or not @bytes.occurs_at(@at, b'\u')
      @at += 2
      low := @read_hex_unit()
      lone() unless low in 0xDC00..=0xDFFF
      (0x10000 + (code - 0xD800) << 10 + (low - 0xDC00)).to_char()!

    read_hex_unit := ->
      var code = 0
      for _ in 0..4
        digit := (@peek() else 0).hex_value() else @fail('an escape \u without four hex digits')
        code = code * 16 + digit
        @at += 1
      code

    # The number's text where the reader is, as JSON writes numbers, or nil if none is there.
    number := ->
      @skip_space()
      bytes := @bytes
      var end = @at
      digits := ->
        start := end
        end += 1 while bytes.get(end)?.is_digit() == true
        end > start
      end += 1 if bytes.get(end) == b'-'
      if bytes.get(end) == b'0'
        end += 1
      else if not digits()
        return nil
      if bytes.get(end) == b'.'
        end += 1
        return nil unless digits()
      if bytes.get(end) == b'e' or bytes.get(end) == b'E'
        end += 1
        end += 1 if bytes.get(end) == b'+' or bytes.get(end) == b'-'
        return nil unless digits()
      bytes.text(@at, end)!

    skip_space := -> @at += 1 while is_json_space(@peek())

    peek := -> @bytes.get(@at)

  fail_expected := (expected: String) -> @fail("expected #{expected}, found #{@found()}")

  fail := (message: String) -> throw JsonError("#{path_of(@levels)}: #{message}")

  # What is where the reader is, as an error says it.
  private found := ->
    @skip_space()
    byte := @peek() else return 'the end of the text'
    return number if number := @number()
    for literal in ['null', 'true', 'false']
      return literal if @bytes.occurs_at(@at, literal.binary)
    case byte
      when b'"' then 'a string'
      when b'[' then 'an array'
      when b'{' then 'an object'
      else
        if byte == b'-' or byte.is_digit()
          'a number that is not JSON'
        else
          "'#{byte_text(byte)}'"

# The deepest that arrays and objects may nest, as each is read by a call of its own, so that text
# nested deeper throws rather than overflowing the stack.
MAX_DEPTH := 128

# The byte that an escape of one letter stands for.
unescaped := (byte: Byte): Byte? ->
  case byte
    when b'"', b'\', b'/' then byte
    when b'b' then 0x08
    when b'f' then 0x0C
    when b'n' then b"\n"
    when b'r' then b"\r"
    when b't' then b"\t"
    else nil

# The byte as it is written in an error: as itself if it is ASCII and visible.
byte_text := (byte: Byte) ->
  byte > 0x20 and byte < 0x7F then byte.to_char().to_string() else "byte #{byte}"

ZERO: UInt64 = 0
ONE: UInt64 = 1
MAX_UINT64 := ZERO.wrapping_sub(ONE)

# The Float32 nearest to the number, or nil where it is beyond the finite ones, as JSON holds no
# infinity.
finite_float32 := (number: String) ->
  value := number.parse_float()?.to_float32() else return nil
  is_finite(value.to_float()) then value

# The whitespace of JSON, which Byte.is_space takes more than.
is_json_space := (byte: Byte?) -> byte != nil and byte in [b' ', b"\t", b"\n", b"\r"]
