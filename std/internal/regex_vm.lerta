# Runs a program of std/internal/regex_compile.lerta over a text as a Pike VM: every thread of the
# program steps over each code point at once, so that a search takes time linear in the text. The
# order of the threads is their priority, as backtracking would try them, so that the match found
# is the one Perl's and RE2's would be, the leftmost first.
import ASSERT, CHAR, CLASS, JUMP, MATCH, Program, SAVE, SPLIT from './regex_compile'
import
  LINE_END, LINE_START, NOT_WORD_BOUNDARY, TEXT_END, TEXT_START, WORD_BOUNDARY
from './regex_syntax'
import char_at, sequence_length from './utf8'

# The first `count` threads in their order, each the place of its instruction and its slots, which
# lie one thread after another in `slots`, and the generation in which each place was added, so
# that a place is added once each step without clearing them all. So there are as many threads as
# places at most, which the arrays hold from the start: a search allocates nothing, and pops and
# truncates nothing, which take an item at a time.
class Threads
  args
    length: Int
    slot_count: Int
  places := Array(@length, 0)
  slots := Array(@length * @slot_count, 0)
  added := Array(@length, -1)
  var count = 0
  var generation = 0

  clear := ->
    @count = 0
    @generation += 1

  push := (place: Int, from: Int[]) ->
    @places[@count] = place
    first := @count * @slot_count
    for k in 0..@slot_count
      @slots[first + k] = from[k]
    @count += 1

# Searches texts for the program's matches, one `find` after another, which share the threads and
# keep no text.
export class Searcher
  args
    program: Program
  private
    length := @program.code.length / 4

    # The program's words, read out of its Binary once, as reading one there is a call each time.
    words: Int[] = [@program.code.uint32_at(place).to_int() for place in 0..@length]
    slot_count := 2 * (@program.group_count + 1)

    # The bytes that a match may start with, or nil for a program that matches with none, as `a*`:
    # where no thread is alive, the search passes over the others without stepping.
    first_bytes := first_bytes_of(@words)
    var current = Threads(length: @length, slot_count: @slot_count)
    var next = Threads(length: @length, slot_count: @slot_count)

    # The slots of the thread being added, which a SAVE writes, and what `add` has yet to follow,
    # the first `depth` of them: places, and slots to give back their values, as `-1 - slot`, once a
    # SAVE's threads are added. An add visits each place once, which pushes two at most.
    work := Array(@slot_count, -1)
    pending_places := Array(2 * @length + 1, 0)
    pending_values := Array(2 * @length + 1, 0)
    var depth = 0

  word := (place: Int) -> @words[place]

  # The slots of the first match at `from` or after it in the text's bytes, two for each group from
  # the whole match, its start and its end, -1 for a group that took no part; or nil.
  find := (text: Binary, from: Int) ->
    var current = @current
    var next = @next
    current.clear()
    var matched: Int[]?
    var at = from
    while true
      if matched == nil
        if current.count == 0
          at = next_start(text, at, @first_bytes) else break
        @work[k] = -1 for k in 0..@slot_count
        @add text, current, 0, at
      break if matched != nil and current.count == 0
      ended := at == text.length
      code := ended then -1 else char_at(text, at).to_int()
      width := ended then 0 else sequence_length(text[at])
      next.clear()
      for i in 0..current.count
        place := current.places[i]
        first := i * @slot_count
        case @word(place)
          when MATCH
            matched = current.slots[first..(first + @slot_count)]
            break
          when CHAR
            if code == @word(place + 1)
              @step_from text, current, first, next, place + 2, at + width
          when CLASS
            count := @word(place + 1)
            if @in_class(place, code)
              @step_from text, current, first, next, place + 2 + 2 * count, at + width
          else pass
      break if ended
      stepped := next
      next = current
      current = stepped
      at += width
    matched

  # The thread whose slots start at `first` in `from`, on at `place`.
  step_from := (text: Binary, from: Threads, first: Int, to: Threads, place: Int, at: Int) ->
    for k in 0..@slot_count
      @work[k] = from.slots[first + k]
    @add text, to, place, at

  # Whether the code point is in the ranges of the CLASS at `place`, found by a binary search.
  in_class := (place: Int, code: Int) ->
    var low = 0
    var high = @word(place + 1)
    while low < high
      middle := (low + high) / 2
      range := place + 2 + 2 * middle
      if code < @word(range)
        high = middle
      else if code > @word(range + 1)
        low = middle + 1
      else
        return true
    false

  # The thread at `place`, of the slots in `work`, with the threads that it leads to without
  # reading, in their order: those of a SPLIT's first place before its second's. A place already
  # added this step is passed over, as the thread there first has the priority, which also ends
  # loops that read nothing. A SAVE writes `work` for the threads after it, and gives the slot its
  # value back after them.
  add := (text: Binary, threads: Threads, place: Int, at: Int) ->
    @push_pending place, 0
    until @depth == 0
      @depth -= 1
      current := @pending_places[@depth]
      value := @pending_values[@depth]
      if current < 0
        @work[-1 - current] = value
        continue
      continue if threads.added[current] == threads.generation
      threads.added[current] = threads.generation
      case @word(current)
        when JUMP then @push_pending(@word(current + 1), 0)
        when SPLIT
          @push_pending @word(current + 2), 0
          @push_pending @word(current + 1), 0
        when SAVE
          slot := @word(current + 1)
          @push_pending -1 - slot, @work[slot]
          @work[slot] = at
          @push_pending current + 2, 0
        when ASSERT
          if holds(text, @word(current + 1), at)
            @push_pending current + 2, 0
        else threads.push(current, @work)

  push_pending := (place: Int, value: Int) ->
    @pending_places[@depth] = place
    @pending_values[@depth] = value
    @depth += 1

# The first place from `at` on whose byte a match may start, or nil if there is none; `at`
# itself where every place may start one.
next_start := (text: Binary, at: Int, first_bytes: Bool[]?) ->
  bytes := first_bytes else return at
  var start = at
  start += 1 while start < text.length and not bytes[text[start].to_int()]
  start < text.length then start

# The bytes of the code points that the instructions read first, as the threads from place 0 reach
# them without reading: of a CHAR, the first byte of its UTF-8; of a CLASS, its ASCII ones and, if
# it holds any beyond ASCII, every lead byte. An assertion is passed through, as it may hold; nil if
# a MATCH is reached, as a match then reads nothing.
first_bytes_of := (words: Int[]) ->
  bytes := Array(256, false)
  seen := Array(words.length, false)
  pending := [0]
  until pending.is_empty()
    place := pending.pop()
    continue if seen[place]
    seen[place] = true
    case words[place]
      when JUMP then pending.push(words[place + 1])
      when SPLIT then pending.append([words[place + 1], words[place + 2]])
      when SAVE, ASSERT then pending.push(place + 2)
      when MATCH then return nil
      when CHAR then add_first_bytes(bytes, words[place + 1], words[place + 1])
      when CLASS
        for range in 0..words[place + 1]
          first := place + 2 + 2 * range
          add_first_bytes bytes, words[first], words[first + 1]
      else pass
  bytes

# The first bytes of the UTF-8 of the code points from `low` to `high`: those themselves below
# 0x80, and every lead byte, from 0xC2 to 0xF4, for any above.
add_first_bytes := (bytes: Bool[], low: Int, high: Int) ->
  bytes[code] = true for code in low..=min(high, 0x7F)
  if high >= 0x80
    bytes[lead] = true for lead in 0xC2..=0xF4

# Whether the assertion of the kind holds at the place in the text.
holds := (text: Binary, kind: Int, at: Int) ->
  case kind
    when TEXT_START then at == 0
    when TEXT_END then at == text.length
    when LINE_START then at == 0 or text[at - 1] == b"\n"
    when LINE_END then at == text.length or text[at] == b"\n"
    when WORD_BOUNDARY then is_word_before(text, at) != is_word_after(text, at)
    when NOT_WORD_BOUNDARY then is_word_before(text, at) == is_word_after(text, at)
    else false

# Whether the byte before or at the place is of `\w`, ASCII: the bytes of a code point beyond it
# are none.
is_word_before := (text: Binary, at: Int) -> at > 0 and is_word(text[at - 1])
is_word_after := (text: Binary, at: Int) -> at < text.length and is_word(text[at])

is_word := (byte: Byte) -> byte.is_alphanumeric() or byte == b'_'
