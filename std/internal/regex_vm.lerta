# Runs a program of std/internal/regex_compile.lerta over a text as a Pike VM: every thread of the
# program steps over each code point at once, so that a search takes time linear in the text. The
# order of the threads is their priority, as backtracking would try them, so that the match found
# is the one Perl's and RE2's would be, the leftmost first.
import ASSERT, CHAR, CLASS, JUMP, MATCH, Program, SAVE, SPLIT from './regex_compile'
import
  LINE_END, LINE_START, NOT_WORD_BOUNDARY, TEXT_END, TEXT_START, WORD_BOUNDARY
from './regex_syntax'
import char_at, sequence_length from './utf8'

# The first `count` threads in their order, each the place of its instruction and its slots, which
# lie one thread after another in `slots`, and the generation in which each place was added, so
# that a place is added once each step without clearing them all. So there are as many threads as
# places at most, which the arrays hold from the start: a search allocates nothing, and pops and
# truncates nothing, which take an item at a time.
class Threads
  args
    length: Int
    slot_count: Int
  places := Array(@length, 0)
  slots := Array(@length * @slot_count, 0)
  added := Array(@length, -1)
  var count = 0
  var generation = 0

  clear := ->
    @count = 0
    @generation += 1

  push := (place: Int, from: Int[]) ->
    @places[@count] = place
    first := @count * @slot_count
    for k in 0..@slot_count
      @slots[first + k] = from[k]
    @count += 1

# Searches texts for the program's matches, one `find` after another, which share the threads and
# keep no text.
export class Searcher
  args
    program: Program
  private
    length := @program.code.length / 4

    # The program's words, read out of its Binary once, as reading one there is a call each time.
    words: Int[] = [@program.code.uint32_at(place).to_int() for place in 0..@length]
    slot_count := 2 * (@program.group_count + 1)

    # The bytes that a match may start with, or nil for a program that matches with none, as `a*`:
    # where no thread is alive, the search passes over the others without stepping.
    first_bytes := first_bytes_of(@words)

    # The ASCII code points of each CLASS, as bits in the two words from twice its place, so that an
    # ASCII byte is tested without decoding it or searching the ranges.
    ascii_classes := ascii_classes_of(@words)

    # For each place, its row in the bits of the search by backtracking, or -1 for none. Rows are
    # for the joins: the start, and where a JUMP or a SPLIT goes. Any other place is reached only by
    # falling through from the one before it, and jobs resume only at a SPLIT's second place, so
    # that marking the joins alone still follows each pair of places once.
    rows := rows_of(@words)
    row_count := [row for row in @rows when row >= 0].length
    var current = Threads(length: @length, slot_count: @slot_count)
    var next = Threads(length: @length, slot_count: @slot_count)

    # The slots of the thread being added, which a SAVE writes, and what `add` has yet to follow,
    # the first `depth` of them: places, and slots to give back their values, as `-1 - slot`, once a
    # SAVE's threads are added. An add visits each place once, which pushes two at most.
    work := Array(@slot_count, -1)
    pending_places := Array(2 * @length + 1, 0)
    pending_values := Array(2 * @length + 1, 0)
    var depth = 0

    # Of the search by backtracking: a bit for each pair of a place in the program and one in the
    # text, set once it is visited, 64 to a word; the first `touched_count` places of the words it
    # set bits in, which the next search clears, so that clearing costs as much as visiting did,
    # rather than as the text left; and what it has yet to follow, the first `job_depth` of them,
    # places with the place in the text, or slots to give back their values, as `-1 - slot`. They
    # grow to what the longest text so searched needs, the bits to 32 KiB.
    visited: UInt64[] = []
    touched: Int[] = []
    var touched_count = 0
    job_places: Int[] = []
    job_values: Int[] = []
    var job_depth = 0

  word := (place: Int) -> @words[place]

  # The slots of the first match at `from` or after it in the text's bytes, two for each group from
  # the whole match, its start and its end, -1 for a group that took no part; or nil. A short text,
  # as a line is, is searched by backtracking, which follows one thread at a time where the Pike VM
  # steps all of them at each code point; each pair of places it visits once, so that it takes time
  # linear in the text too, which it needs memory for in proportion to the pairs.
  find := (text: Binary, from: Int) ->
    pairs := @row_count * (text.length - from + 1)
    if pairs <= MAX_BACKTRACKED_PAIRS
      @backtrack(text, from)
    else
      @step(text, from)

  # The search by backtracking, as RE2's BitState: from each place where a match may start, in
  # order, the threads in their order of priority, depth first, the first to match winning, as the
  # Pike VM's does. A pair visited once is not followed again, by a later start too: from there,
  # it failed.
  backtrack := (text: Binary, from: Int) ->
    columns := text.length - from + 1
    words := (@row_count * columns + 63) / 64
    @visited.push 0 while @visited.length < words
    for i in 0..@touched_count
      @visited[@touched[i]] = 0
    @touched_count = 0
    var start = from
    while true
      start = next_start(text, start, @first_bytes) else return nil
      @work[k] = -1 for k in 0..@slot_count
      return found if found := @backtrack_from(text, from, columns, start)
      break if start == text.length
      start += sequence_length(text[start])
    nil

  # The match of the threads from `start`, or nil. Each job is a place to go on at, with the place
  # in the text, or a slot to give back its value, which a SAVE pushes before it goes on.
  backtrack_from := (text: Binary, from: Int, columns: Int, start: Int) ->
    @job_depth = 0
    @push_job 0, start
    until @job_depth == 0
      @job_depth -= 1
      var place = @job_places[@job_depth]
      var at = @job_values[@job_depth]
      if place < 0
        @work[-1 - place] = at
        continue
      while true
        row := @rows[place]
        if row >= 0
          visit := row * columns + at - from
          word := visit / 64
          bit: UInt64 = 1 << (visit % 64).to_uint64()!
          break if @visited[word] & bit != 0
          @touch word if @visited[word] == 0
          @visited[word] |= bit
        case @word(place)
          when MATCH then return @work[0..]
          # An ASCII byte is read and passed over here, rather than by code_at, class_has and
          # sequence_length, which took 6% more instructions of bench/regex.
          when CHAR
            break if at == text.length
            byte := text[at]
            if byte < 0x80
              break if byte.to_int() != @word(place + 1)
              at += 1
            else
              break if char_at(text, at).to_int() != @word(place + 1)
              at += sequence_length(byte)
            place += 2
          when CLASS
            break if at == text.length
            byte := text[at]
            if byte < 0x80
              break unless @in_ascii_class(place, byte.to_int())
              at += 1
            else
              break unless @in_class(place, char_at(text, at).to_int())
              at += sequence_length(byte)
            place += 2 + 2 * @word(place + 1)
          when JUMP then place = @word(place + 1)
          when SPLIT
            @push_job @word(place + 2), at
            place = @word(place + 1)
          when SAVE
            slot := @word(place + 1)
            @push_job -1 - slot, @work[slot]
            @work[slot] = at
            place += 2
          when ASSERT
            break unless holds(text, @word(place + 1), at)
            place += 2
          else break
    nil

  touch := (word: Int) ->
    if @touched_count == @touched.length
      @touched.push word
    else
      @touched[@touched_count] = word
    @touched_count += 1

  push_job := (place: Int, value: Int) ->
    if @job_depth == @job_places.length
      @job_places.push place
      @job_values.push value
    else
      @job_places[@job_depth] = place
      @job_values[@job_depth] = value
    @job_depth += 1

  # The search by the Pike VM, which steps every thread over each code point at once.
  step := (text: Binary, from: Int) ->
    var current = @current
    var next = @next
    current.clear()
    var matched: Int[]?
    var at = from
    while true
      if matched == nil
        if current.count == 0
          at = next_start(text, at, @first_bytes) else break
        @work[k] = -1 for k in 0..@slot_count
        @add text, current, 0, at
      break if matched != nil and current.count == 0
      ended := at == text.length
      code := ended then -1 else code_at(text, at)
      width := ended then 0 else sequence_length(text[at])
      next.clear()
      for i in 0..current.count
        place := current.places[i]
        first := i * @slot_count
        case @word(place)
          when MATCH
            matched = current.slots[first..(first + @slot_count)]
            break
          when CHAR
            if code == @word(place + 1)
              @step_from text, current, first, next, place + 2, at + width
          when CLASS
            count := @word(place + 1)
            if @class_has(place, code)
              @step_from text, current, first, next, place + 2 + 2 * count, at + width
          else pass
      break if ended
      stepped := next
      next = current
      current = stepped
      at += width
    matched

  # The thread whose slots start at `first` in `from`, on at `place`.
  step_from := (text: Binary, from: Threads, first: Int, to: Threads, place: Int, at: Int) ->
    for k in 0..@slot_count
      @work[k] = from.slots[first + k]
    @add text, to, place, at

  # Whether the code point, or -1 for none, is in the CLASS at `place`.
  class_has := (place: Int, code: Int) ->
    if code in 0..0x80
      @in_ascii_class(place, code)
    else
      @in_class(place, code)

  # Whether the code point, of ASCII, is in the CLASS at `place`.
  in_ascii_class := (place: Int, code: Int) ->
    bit: UInt64 = 1 << (code % 64).to_uint64()!
    @ascii_classes[2 * place + code / 64] & bit != 0

  # Whether the code point, beyond ASCII, is in the ranges of the CLASS at `place`, found by a
  # binary search.
  in_class := (place: Int, code: Int) ->
    var low = 0
    var high = @word(place + 1)
    while low < high
      middle := (low + high) / 2
      range := place + 2 + 2 * middle
      if code < @word(range)
        high = middle
      else if code > @word(range + 1)
        low = middle + 1
      else
        return true
    false

  # The thread at `place`, of the slots in `work`, with the threads that it leads to without
  # reading, in their order: those of a SPLIT's first place before its second's. A place already
  # added this step is passed over, as the thread there first has the priority, which also ends
  # loops that read nothing. A SAVE writes `work` for the threads after it, and gives the slot its
  # value back after them.
  add := (text: Binary, threads: Threads, place: Int, at: Int) ->
    @push_pending place, 0
    until @depth == 0
      @depth -= 1
      current := @pending_places[@depth]
      value := @pending_values[@depth]
      if current < 0
        @work[-1 - current] = value
        continue
      continue if threads.added[current] == threads.generation
      threads.added[current] = threads.generation
      case @word(current)
        when JUMP then @push_pending(@word(current + 1), 0)
        when SPLIT
          @push_pending @word(current + 2), 0
          @push_pending @word(current + 1), 0
        when SAVE
          slot := @word(current + 1)
          @push_pending -1 - slot, @work[slot]
          @work[slot] = at
          @push_pending current + 2, 0
        when ASSERT
          if holds(text, @word(current + 1), at)
            @push_pending current + 2, 0
        else threads.push(current, @work)

  push_pending := (place: Int, value: Int) ->
    @pending_places[@depth] = place
    @pending_values[@depth] = value
    @depth += 1

# The most pairs of a join of the program and a place in the text that a search follows by
# backtracking, which keeps a bit for each: 32 KiB.
MAX_BACKTRACKED_PAIRS := 1 << 18

# The first place from `at` on whose byte a match may start, or nil if there is none; `at`
# itself where every place may start one.
next_start := (text: Binary, at: Int, first_bytes: Bool[]?) ->
  bytes := first_bytes else return at
  var start = at
  start += 1 while start < text.length and not bytes[text[start].to_int()]
  start < text.length then start

# The bytes of the code points that the instructions read first, as the threads from place 0 reach
# them without reading: of a CHAR, the first byte of its UTF-8; of a CLASS, its ASCII ones and, if
# it holds any beyond ASCII, every lead byte. An assertion is passed through, as it may hold; nil if
# a MATCH is reached, as a match then reads nothing.
first_bytes_of := (words: Int[]) ->
  bytes := Array(256, false)
  seen := Array(words.length, false)
  pending := [0]
  until pending.is_empty()
    place := pending.pop()
    continue if seen[place]
    seen[place] = true
    case words[place]
      when JUMP then pending.push(words[place + 1])
      when SPLIT then pending.append([words[place + 1], words[place + 2]])
      when SAVE, ASSERT then pending.push(place + 2)
      when MATCH then return nil
      when CHAR then add_first_bytes(bytes, words[place + 1], words[place + 1])
      when CLASS
        for range in 0..words[place + 1]
          first := place + 2 + 2 * range
          add_first_bytes bytes, words[first], words[first + 1]
      else pass
  bytes

# The code point whose UTF-8 starts at the place: an ASCII byte read as it is, rather than by a call
# of char_at.
code_at := (text: Binary, at: Int) ->
  byte := text[at]
  byte < 0x80 then byte.to_int() else char_at(text, at).to_int()

# The bits of ascii_classes in Searcher.
ascii_classes_of := (words: Int[]) ->
  bits: UInt64[] = Array(2 * words.length, 0)
  for place in places_of(words)
    continue if words[place] != CLASS
    for range in 0..words[place + 1]
      first := place + 2 + 2 * range
      for code in words[first]..=min(words[first + 1], 0x7F)
        bit: UInt64 = 1 << (code % 64).to_uint64()!
        bits[2 * place + code / 64] |= bit
  bits

# The rows of Searcher, numbered in the order of their places.
rows_of := (words: Int[]) ->
  rows := Array(words.length, -1)
  rows[0] = 0
  for place in places_of(words)
    case words[place]
      when JUMP then rows[words[place + 1]] = 0
      when SPLIT
        rows[words[place + 1]] = 0
        rows[words[place + 2]] = 0
      else pass
  var count = 0
  for place in 0..rows.length
    continue if rows[place] < 0
    rows[place] = count
    count += 1
  rows

# The places where the program's instructions start, in order.
places_of := (words: Int[]) ->
  var place = 0
  while place < words.length
    yield place
    place +=
      case words[place]
        when CLASS then 2 + 2 * words[place + 1]
        when MATCH then 1
        when SPLIT then 3
        else 2

# The first bytes of the UTF-8 of the code points from `low` to `high`: those themselves below
# 0x80, and every lead byte, from 0xC2 to 0xF4, for any above.
add_first_bytes := (bytes: Bool[], low: Int, high: Int) ->
  bytes[code] = true for code in low..=min(high, 0x7F)
  if high >= 0x80
    bytes[lead] = true for lead in 0xC2..=0xF4

# Whether the assertion of the kind holds at the place in the text.
holds := (text: Binary, kind: Int, at: Int) ->
  case kind
    when TEXT_START then at == 0
    when TEXT_END then at == text.length
    when LINE_START then at == 0 or text[at - 1] == b"\n"
    when LINE_END then at == text.length or text[at] == b"\n"
    when WORD_BOUNDARY then is_word_before(text, at) != is_word_after(text, at)
    when NOT_WORD_BOUNDARY then is_word_before(text, at) == is_word_after(text, at)
    else false

# Whether the byte before or at the place is of `\w`, ASCII: the bytes of a code point beyond it
# are none.
is_word_before := (text: Binary, at: Int) -> at > 0 and is_word(text[at - 1])
is_word_after := (text: Binary, at: Int) -> at < text.length and is_word(text[at])

is_word := (byte: Byte) -> byte.is_alphanumeric() or byte == b'_'
