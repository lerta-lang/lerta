# A connection of std:http: its socket, and the deadlines of its reads and of its writes, apart, as
# one may go on while the other is under way: the server's body sent as it comes may read the
# request's body, and the client reads the response as it sends a body.

import TimeoutError from 'std:async'
import Socket from 'std:net'
import Deadline from './deadline'
import CHUNK_SIZE from './http_chunks'
import bytes_of from './utf8'

# Its peer must take each part of a write within `write_seconds`, or is taken to have gone, so that
# one that keeps taking a large body keeps the connection.
export class Connection
  args
    socket: Socket

    # Which the client sets for each request.
    var write_seconds: Float
  reads := Deadline()
  private writes := Deadline()

  # Whether a write has timed out, which the client fails the request for, rather than send it again
  # or take the server to have stopped reading.
  var write_timed_out = false

  # Closes the socket, and stops the watches of the deadlines, which would otherwise go on to the
  # last wake that a wait set.
  close := ->
    @socket.close()
    @reads.stop()
    @writes.stop()

  # Data longer than PART_SIZE goes in parts of CHUNK_SIZE: a chunk of a body that is sent in
  # chunks, its size line with it, goes in one.
  write := (data: String | Binary) ->
    bytes := bytes_of(data)
    return await @write_part(bytes) if bytes.length <= PART_SIZE
    for start in 0..bytes.length by CHUNK_SIZE
      await @write_part(bytes[start..min(start + CHUNK_SIZE, bytes.length)])

  private write_part := (bytes: Binary) ->
    try
      await @writes.within(@socket.write(bytes), @write_seconds)
    catch _: TimeoutError
      @write_timed_out = true
      throw IOError('a write timed out')

PART_SIZE := 2 * CHUNK_SIZE
