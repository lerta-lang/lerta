# What std:json's generated code writes through, as an Encoder (see std/codable.lerta).
import base64 from './base64'
import FieldKeys, is_finite, Level, path_of, quoted from './json_text'
import JsonError, JsonKeys from '../json'

export class JsonWriter
  keys: JsonKeys
  var written = ''
  # Each array or object being written, the innermost last.
  levels: Level[] = []
  # Each object being written that may hold itself, by its address, the innermost last, and the
  # count of levels when it was entered: the steps of those levels give its path.
  entered: Int[] = []
  depths: Map<Int, Int> = Map()
  field_keys := FieldKeys(@keys)
  # The keys of each record being written in camel case, the innermost last: two fields that it
  # writes as one key, as `ab_c` and `abC`, would give the object two values of it.
  record_keys: Set<String>[] = []

  write_nil := (): void -> @written += 'null'
  write_bool := (value: Bool): void -> @written += value.to_string()
  write_int := (value: Int): void -> @written += value.to_string()
  write_float := (value: Float): void ->
    @check_finite value
    @written += value.to_string()
  write_string := (value: String): void -> @written += quoted(value)
  write_uint64 := (value: UInt64): void -> @written += value.to_string()
  write_float32 := (value: Float32): void ->
    @check_finite value.to_float()
    @written += value.to_string()
  # As base64 (RFC 4648), whose letters need no escape.
  write_binary := (value: Binary): void -> @written += "\"#{base64(value)}\""

  begin_array := (): void -> @begin('[')

  # Starts an item of the innermost array.
  next_item := (): void -> @next("[#{@levels.last()!.count}]")

  end_array := (): void -> @end(']')

  # A Char is written as a string of it alone.
  write_char := (value: Char): void -> @write_string(value.to_string())

  # An enum's member is written as a string of its name.
  write_member := (enum_name: String, member: String): void -> @write_string(member)

  # A tuple is written as an array of its items.
  begin_tuple := (count: Int): void -> @begin_array()
  end_tuple := (): void -> @end_array()

  # A set is written as an array of its items.
  begin_set := (): void -> @begin_array()
  end_set := (): void -> @end_array()

  # A map of other keys than Strings is written as an array of its entries, each an array of its
  # key and its value.
  begin_entries := (): void -> @begin_array()
  next_entry := (): void ->
    @next_item()
    @begin_array()
    @next_item()
  entry_value := (): void -> @next_item()
  end_entry := (): void -> @end_array()
  end_entries := (): void -> @end_array()

  # A map and a record are written as objects, of a key for each entry or field.
  begin_map := (): void -> @begin_object()
  write_key := (key: String): void -> @next_key(key)
  end_map := (): void -> @end_object()
  begin_record := (): void ->
    @record_keys.push Set<String>() if @keys == JsonKeys.CAMEL_CASE
    @begin_object()

  write_field := (name: String): void ->
    key := @field_keys.key(name)
    if keys := @record_keys.last()
      @fail_twice key unless keys.add(key)
    @next_key key

  end_record := (): void ->
    @record_keys.pop() if @keys == JsonKeys.CAMEL_CASE
    @end_object()

  begin_object := (): void -> @begin('{')

  # Starts the value of the key in the innermost object.
  next_key := (key: String): void ->
    @next ".#{key}"
    @written += quoted(key)
    @written += ':'

  end_object := (): void -> @end('}')

  # Starts writing an object that may hold itself, by its address, which must not be written
  # already: JSON cannot hold a cycle.
  enter := (address: Int): void ->
    if depth := @depths[address]
      throw JsonError(message: "#{@path_text()}: a cycle back to #{path_of(@levels[..depth])}")
    @depths[address] = @levels.length
    @entered.push address

  # JSON holds no infinity.
  check_finite := (value: Float): void ->
    return if is_finite(value)
    throw JsonError(message: "#{@path_text()}: #{value}, which JSON cannot hold")

  leave := (): void -> @depths.remove(@entered.pop())

  # The record has two fields of the key, an error of the record, which the levels around its own
  # give the path of, rather than of its last value.
  fail_twice := (key: String): never ->
    record := path_of(@levels[..(@levels.length - 1)])
    throw JsonError(message: "#{record}: two fields of the key #{quoted(key)}")

  begin := (open: String) ->
    @written += open
    @levels.push Level()

  next := (step: String) ->
    level := @levels.last()!
    @written += ',' if level.count > 0
    level.count += 1
    level.step = step

  end := (close: String) ->
    @levels.pop()
    @written += close

  path_text := -> path_of(@levels)

  text := -> @written
