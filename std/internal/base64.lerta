# Base64 (RFC 4648), with its padding, of std:json's Binarys.

const BASE64_LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'.binary

# Each 3 bytes as 4 letters of 6 bits, the last group padded with `=`.
export const base64 = (bytes: Binary) ->
  const letters: Byte[] = []
  var i = 0
  while i < bytes.length
    const count = min(3, bytes.length - i)
    var group = 0
    group = group << 8 | (k < count then bytes[i + k].to_int() else 0) for k in 0...3
    for k in 0...4
      letters.push k <= count then BASE64_LETTERS[group >> (18 - 6 * k) & 0x3F] else '='
    i += 3
  letters.to_binary().text()!

# The bytes of base64 with its padding, or nil for text that is not that.
export const from_base64 = (text: Binary) ->
  return nil if text.length % 4 != 0
  const bytes: Byte[] = []
  var i = 0
  while i < text.length
    const padding = text[i + 3] != '=' then 0 else text[i + 2] != '=' then 1 else 2
    return nil if padding > 0 and i + 4 < text.length
    var group = 0
    for k in 0...(4 - padding)
      const value = base64_value(text[i + k]) ? return nil
      group = group << 6 | value
    # The bits that the padding leaves over must be zero, so that each Binary has one text.
    return nil if group & (1 << (2 * padding) - 1) != 0
    group = group << (6 * padding)
    bytes.push (group >> (16 - 8 * k) & 0xFF).to_byte()! for k in 0...(3 - padding)
    i += 4
  bytes.to_binary()

const base64_value = (letter: Byte) ->
  case
    when letter >= 'A' and letter <= 'Z' then (letter - 'A').to_int()
    when letter >= 'a' and letter <= 'z' then (letter - 'a').to_int() + 26
    when letter.is_digit() then (letter - '0').to_int() + 52
    when letter == '+' then 62
    when letter == '/' then 63
    else nil
