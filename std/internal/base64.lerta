# Base64 (RFC 4648), with its padding, of std:json's Binarys.

BASE64_LETTERS := b'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

# Each 3 bytes as 4 letters of 6 bits, the last group padded with `=`.
export base64 := (bytes: Binary) ->
  var letters = ''
  var i = 0
  while i < bytes.length
    count := min(3, bytes.length - i)
    var group = 0
    group = group << 8 | (k < count then bytes[i + k].to_int() else 0) for k in 0...3
    for k in 0...4
      letter := BASE64_LETTERS[group >> (18 - 6 * k) & 0x3F].to_char()
      letters += k <= count then letter.to_string() else '='
    i += 3
  letters

# The bytes of base64 with its padding, or nil for text that is not that.
export from_base64 := (text: Binary) ->
  return nil if text.length % 4 != 0
  bytes: Byte[]
  var i = 0
  while i < text.length
    padding := text[i + 3] != b'=' then 0 else text[i + 2] != b'=' then 1 else 2
    return nil if padding > 0 and i + 4 < text.length
    var group = 0
    for k in 0...(4 - padding)
      value := base64_value(text[i + k]) ? return nil
      group = group << 6 | value
    # The bits that the padding leaves over must be zero, so that each Binary has one text.
    return nil if group & (1 << (2 * padding) - 1) != 0
    group = group << (6 * padding)
    bytes.push (group >> (16 - 8 * k) & 0xFF).to_byte()! for k in 0...(3 - padding)
    i += 4
  bytes.to_binary()

base64_value := (letter: Byte) ->
  case
    when letter in b'A'..=b'Z' then (letter - b'A').to_int()
    when letter in b'a'..=b'z' then (letter - b'a').to_int() + 26
    when letter.is_digit() then (letter - b'0').to_int() + 52
    when letter == b'+' then 62
    when letter == b'/' then 63
    else nil
