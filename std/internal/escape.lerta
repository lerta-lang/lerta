# Text in double quotes, as JSON and Lerta's literals write it, each with escapes of its own.

# The text in double quotes, each Char that `escape_of` gives an escape for written as that escape.
export double_quoted := (text: String, escape_of: (Char) -> String?) ->
  var quoted = '"'
  for c in text
    if escape := escape_of(c)
      quoted += escape
    else
      quoted += c
  quoted + '"'
