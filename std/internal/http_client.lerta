# An HTTP/1.1 client: fetch sends a request and gives a Response whose body is read as it comes,
# over connections kept alive from one request to the next.

import Signal, spawn, timeout, TimeoutError from 'std:async'
import Reader from 'std:io'
import connect_tcp from 'std:net'
import scan from 'std:scanner'
import monotonic from 'std:time'
import is_control from './chars'
import
  CHUNK_SIZE, chunk_bytes, ChunkedBody, ended_early, JoinedReads, LAST_CHUNK, MAX_LINE, SizedBody,
  well_formed
from './http_chunks'
import Connection from './http_connection'
import
  ascii_lower, Body, check_field, Headers, is_token, keeps_alive, Response, without_ows
from './http_message'
import bytes_of from './utf8'

## What a request sends besides its URL, whether a redirect is followed, and the seconds that each
## wait of the request may take: for its connection, for each part of what it writes, for the head
## of a response, and for each chunk of the body. A body that is a Reader is sent in chunks as it
## comes, and closed once the final response has come.
export struct FetchOptions
  method := 'GET'
  headers := Headers()
  body: Body = ''
  follow_redirects := true
  timeout := 30.0

## Keeps each connection whose response has been read to its end, for the next request to the same
## host and port, for `idle_timeout` seconds and at most `max_idle` of them to each.
export class Client
  args
    idle_timeout := 4.0
    max_idle := 8

  # The connections kept by host and port, the latest last, with the deadlines of their waits, whose
  # watches go on from one request to the next.
  var idle = Map<String, IdleConnection[]>()

  ## The response once its head has come; its body is read as it comes.
  fetch := (url: String, options: FetchOptions) ->
    { body } := options
    try
      await @fetch_body(url, options, body is Reader then body else bytes_of(body))
    finally
      body.close() if body is Reader

  private fetch_body := (url: String, options: FetchOptions, body: Binary | Reader) ->
    { method } := options
    throw ValueError("not a method: #{method}") unless is_token(method)
    throw ValueError("a negative timeout: #{options.timeout}") if options.timeout < 0.0
    check_field name, value for (name, value) in options.headers.fields
    target := parse_url(url)
    var request = Outgoing(method, body, target, headers: options.headers, seconds: options.timeout)
    var response = await @exchange(request)
    var redirects = 0
    next_request := -> options.follow_redirects then redirected(request, response)
    while next := next_request()
      throw IOError("too many redirects: #{url}") if redirects == MAX_REDIRECTS
      redirects += 1
      await drain(response.body)
      request = next
      response = await @exchange(request)
    response

  ## Closes the connections kept; the client keeps those it uses after.
  close := ->
    for kept in @idle.values()
      idle.connection.close() for idle in kept
    @idle = Map()

  # Sends the request on a connection kept, or on a new one. A kept connection may have been closed
  # by the server in the meantime, so a request that gets no answer on one is sent again on a new
  # one, when its method is one that may be sent twice. A body that is a Reader cannot be sent
  # twice, so it goes on a new connection, which the server has not had the time to close.
  private exchange := (request: Outgoing) ->
    { target, body } := request
    if connection := body is Reader then nil else @take_idle(target.authority)
      try
        return await @send(connection, request)
      catch error: NoAnswer
        throw IOError(error.message) unless request.method in RESENDABLE
    socket := await connected(target, request.seconds)
    try
      await @send(Connection(socket, write_seconds: request.seconds), request)
    catch error: NoAnswer
      throw IOError(error.message)

  # Closes the connection on a failure, after which what it holds is not known. A body that is a
  # Reader is sent while the response is read, as a server may answer before it has read it all, and
  # a failure to read it fails the request.
  send := (connection: Connection, request: Outgoing) ->
    { body } := request
    { socket } := connection
    connection.write_seconds = request.seconds
    sent := body is Reader then SentBody(connection, request, body)
    sending := sent?.send()
    try
      head := await read_head(connection, request, sent)
      throw failure if failure := sent?.failure
      # What is still being sent when the response has come is not wanted any more.
      sending?.cancel()
      { left, chunked } := framing(head, request.method)

      # A body that ends with the connection leaves nothing to keep, and so does a request that has
      # not been sent whole.
      keeps := left != nil and keeps_alive(head.version, head.headers) and sent?.whole else true

      # The connection is given back once the body has been read to its end, or closed.
      finish := ->
        if keeps
          @give_back request.target.authority, connection
        else
          connection.close()

      { reader } := socket
      chunks: ChunkedBody | SizedBody =
        if chunked
          ChunkedBody reader, name: 'response', room: INT_MAX
        else
          SizedBody reader, left, name: 'response'
      body := BodyChunks(connection, finish, chunks, seconds: request.seconds)

      # A body that is empty by its framing does not hold the connection until it is read.
      body.end() if left == 0 and not chunked

      read_body := Reader(read_chunk: -> await body.next(), on_close: -> body.abandon())
      Response(body: read_body, status: head.status, headers: head.headers)
    catch error
      sending?.cancel()
      connection.close()
      throw sent?.failure else error

  # The latest connection kept for the host and port, after closing those kept too long, which the
  # server may be closing. A request on one the server has closed is sent again.
  private
    take_idle := (authority: String) ->
      kept := @idle[authority] else return nil
      now := monotonic()
      fresh := [
        for idle in kept when now - idle.since < @idle_timeout
          idle
      ]
      for idle in kept
        idle.connection.close() if now - idle.since >= @idle_timeout
      @idle[authority] = fresh
      fresh.is_empty() then nil else fresh.pop().connection

    give_back := (authority: String, connection: Connection) ->
      kept := @idle[authority] else []
      if kept.length >= @max_idle
        connection.close()
        return
      kept.push { connection, since: monotonic() }
      @idle[authority] = kept

# A request that a connection failed before any of its response came, which may then be sent again.
struct NoAnswer: Error

connected := (target: Target, seconds: Float) ->
  try
    await timeout(connect_tcp(target.host, target.port), seconds)
  catch _: TimeoutError
    throw IOError('a connection timed out')

# What the promise gives of the response, which must come within the seconds of the request.
response_within := <T>(connection: Connection, promise: Promise<T>, seconds: Float): Promise<T> ->
  try
    await connection.reads.within(promise, seconds)
  catch _: TimeoutError
    throw IOError('a response timed out')

struct IdleConnection
  connection: Connection
  since: Float

MAX_REDIRECTS := 20

# The most of a redirect's body that is read past to keep its connection; a longer one has it
# closed instead, as reading it would take longer than a new connection.
MAX_DRAINED := 1024 * 1024

# Reads a redirect's body to its end, dropping it, so that its connection is kept, or closes it.
drain := (body: Body) ->
  return unless body is Reader
  var drained = 0
  while chunk := await body.read(CHUNK_SIZE)
    drained += chunk.length
    if drained > MAX_DRAINED
      body.close()
      return

# The methods that a request does the same with when sent twice.
RESENDABLE := ['GET', 'HEAD', 'PUT', 'DELETE', 'OPTIONS', 'TRACE']

default_client := Client()

## Fetches with a client that the program shares.
export fetch := (url: String, options: FetchOptions) -> await default_client.fetch(url, options)

struct Outgoing
  target: Target
  method: String
  headers: Headers
  body: Binary | Reader

  # The seconds that each wait may take.
  seconds: Float

# A request whose body is a Reader, sent in chunks. A read of the body that fails ends the sending
# side of the connection, so that the server does not wait for the rest; a write that fails ends the
# sending too, as the server has stopped reading, and its response may have come.
class SentBody
  args
    connection: Connection
    request: Outgoing

    # The request's body, which is a Reader.
    body: Reader

  # Whether the last chunk has been written.
  private
    var whole = false
    var failure: Error?

  # Resolved once the sending has ended, whether or not the whole body has gone.
  ended := Signal()

  send := ->
    reads := JoinedReads(@body)
    try
      return unless await @written(request_bytes(@request))
      while bytes := await reads.next()
        return unless await @written(chunk_bytes(bytes, reads.ended))
      @whole = reads.ended or await @written(LAST_CHUNK.binary)
    catch error: CancelledError
      throw error
    catch error
      @failure = error
      await @connection.socket.end()
    finally
      reads.cancel()
      @ended.resolve()

  # A write that times out fails the request; one that fails otherwise tells that the server has
  # stopped reading, as it may once it has answered.
  private written := (bytes: Binary) ->
    try
      await @connection.write(bytes)
      true
    catch error: IOError
      @failure = error if @connection.write_timed_out
      false

# The parts of an http URL that a request is sent by.
struct Target
  # The host and the port as the URL writes them, as the Host field does.
  authority: String
  host: String
  port: Int

  # The path and the query, as the request line names them.
  path: String

# Throws an IOError for an https URL, which needs TLS, and a ValueError for one that is not http, or
# that holds a user, which the client does not send.
parse_url := (url: String) ->
  not_url := -> ValueError("not an http URL: #{url}")
  (scheme, rest) := url.split_once('://') else throw not_url()
  lower_scheme := ascii_lower(scheme)
  throw IOError("https is not supported so far: #{url}") if lower_scheme == 'https'
  throw not_url() if lower_scheme != 'http'
  scanner := scan(rest)
  authority := scanner.take_while((c) -> c not in '/?#')
  (path, _fragment) := split_or_whole(scanner.rest(), '#')
  throw not_url() if '@' in authority or not authority.all(is_host_char)
  (host, port) := host_and_port(authority) else throw not_url()
  absolute := path.starts_with('/') then path else "/#{path}"
  Target(authority, host, port, path: percent_encoded(absolute))

# The host is written as it is in the Host field, so it takes printable ASCII alone; a name that is
# not ASCII would need IDNA.
is_host_char := (c: Char) -> c.to_int() > 0x20 and c.to_int() < 0x7F

# The path and the query with the characters that a request line cannot hold as they are written
# as %XX of each byte of their UTF-8, as the WHATWG URL Standard does for http URLs. A `%` is kept,
# as it may start an escape already written.
percent_encoded := (target: String) ->
  (path, query) := target.split_once('?') else return encode_chars(target, PATH_ESCAPED)
  "#{encode_chars(path, PATH_ESCAPED)}?#{encode_chars(query, QUERY_ESCAPED)}"

# Those of the WHATWG URL Standard but `#`, which starts the fragment that is left out, and the `?`
# of the path, which starts the query.
QUERY_ESCAPED := " \"<>'"
PATH_ESCAPED := ' "<>^`{}'

encode_chars := (text: String, escaped: String) ->
  needs_escape := (c: Char) -> c.to_int() >= 0x7F or is_control(c) or c in escaped
  return text unless text.any(needs_escape)
  var encoded = ''
  for c in text
    if needs_escape(c)
      encoded += "%#{byte.to_hex(2).to_upper()}" for byte in c.to_string().binary
    else
      encoded += c
  encoded

# The text before the first separator and the text after it, or the whole text and '' without one.
split_or_whole := (text: String, separator: String) -> text.split_once(separator) else (text, '')

# The host, without the brackets of an IPv6 address, and the port, 80 if none is written.
host_and_port := (authority: String) ->
  (host, port_text) := split_authority(authority) else return nil
  return nil if host.is_empty()
  return (host, 80) if port_text.is_empty()
  return nil unless port_text.is_digits()
  port := port_text.parse_int() else return nil
  port <= 65535 then (host, port)

split_authority := (authority: String) ->
  inside := authority.without_prefix('[') else return split_or_whole(authority, ':')
  (address, after) := inside.split_once(']') else return nil
  return (address, '') if after.is_empty()
  port_text := after.without_prefix(':') else return nil
  (address, port_text)

# The bytes of the request, but for a body that is a Reader, which follows them in chunks.
request_bytes := (request: Outgoing) ->
  { target, method, body } := request
  var head = "#{method} #{target.path} HTTP/1.1\r\nhost: #{target.authority}\r\n"
  for (name, value) in request.headers.fields
    head += "#{name}: #{value}\r\n" unless FRAMING_FIELDS.contains(ascii_lower(name))
  return (head + "transfer-encoding: chunked\r\n\r\n").binary if body is Reader
  head += "content-length: #{body.length}\r\n" if not body.is_empty() or method in SENDING_BODY
  (head + "\r\n").binary + body

# The fields that the client writes itself, as they tell where the request goes and ends.
FRAMING_FIELDS := ['host', 'content-length', 'transfer-encoding', 'connection']

# The methods whose request tells the length of its body even when it is empty.
SENDING_BODY := ['POST', 'PUT', 'PATCH']

struct Head
  version: String
  status: Int
  headers: Headers

# Sends the request, which is written first unless `sent` sends it, and gives the head of the final
# response, past those of 1xx, which tell of progress alone; each head comes within the request's
# seconds. A failure before the first line of a response comes is a NoAnswer.
read_head := (connection: Connection, request: Outgoing, sent: SentBody?) ->
  { reader } := connection.socket
  { seconds } := request
  unless sent
    try
      await connection.write(request_bytes(request))
    catch error: IOError
      # A write that times out on a kept connection, which the server has not closed, is not sent
      # again.
      throw error if connection.write_timed_out
      throw NoAnswer(error.message)
  var head = await head_within(connection, sent, first_head(reader), seconds)
  while head.status < 200
    # What follows a 101 is another protocol, which the client does not speak.
    throw IOError('switching protocols not supported') if head.status == 101
    head = await head_within(connection, sent, next_head(reader), seconds)
  head

# The head, within the seconds. A body sent as it comes may take longer than them in all, so they
# bound the head once the body has been sent, if the head has not come before; a write of it that
# has timed out leaves the server waiting for the rest, rather than answering.
head_within := (connection: Connection, sent: SentBody?, head: Promise<Head>, seconds: Float) ->
  if sent
    await settled_either(sent.ended.promise(), head)
    if connection.write_timed_out
      head.cancel()
      throw sent.failure!
  await response_within(connection, head, seconds)

# Waits until either promise is settled, and cancels neither, as `race` of std:async would cancel
# the other.
settled_either := <T>(one: Promise, other: Promise<T>) ->
  either := Signal()
  settle := (promise: Promise) ->
    try
      await promise
    catch _
      # Its error goes to what awaits it.
      return
    finally
      either.resolve()
  spawn settle(one)
  spawn settle(without_value(other))
  await either.promise()

without_value := <T>(promise: Promise<T>): Promise -> await promise

first_head := (reader: Reader) ->
  read := ->
    try
      await reader.read_line(MAX_LINE)
    catch error: IOError
      throw NoAnswer(error.message)
  line := await well_formed(read(), 'response')
  await read_any_head(reader, line else throw NoAnswer('the connection closed before a response'))

next_head := (reader: Reader) ->
  await read_any_head(reader, await read_line(reader) else throw ended_early('response'))

read_any_head := (reader: Reader, line: String) ->
  (version, rest) := line.split_once(' ') else throw malformed()
  throw malformed() unless version in ['HTTP/1.1', 'HTTP/1.0']
  (code, _reason) := split_or_whole(rest, ' ')
  throw malformed() if code.binary.length != 3 or not code.is_digits()
  status := code.parse_int()!
  throw malformed() if status < 100
  Head(version, status, headers: await read_fields(reader))

read_fields := (reader: Reader) ->
  headers := Headers()
  var lines = 0
  while line := await read_line(reader)
    return headers if line.is_empty()
    throw malformed() if lines == MAX_FIELDS
    lines += 1

    # A line that starts with whitespace goes on with the field before it, as RFC 9112 has a user
    # agent take it, joined by a space.
    is_folded := line.starts_with(' ') or line.starts_with("\t")
    throw malformed() if is_folded and headers.fields.is_empty()
    field := is_folded then folded(headers.fields.pop(), line) else line.split_once(':')
    (name, value) := field else throw malformed()

    # A value joined of lines may be as long as a line, so that each join copies a bounded value.
    throw malformed() if value.binary.length > MAX_LINE

    try
      headers.append name, without_ows(value)
    catch _: ValueError
      throw malformed()
  throw ended_early('response')

folded := (field: (String, String), line: String) ->
  (name, value) := field
  (name, "#{value} #{without_ows(line)}")

read_line := (reader: Reader) -> await well_formed(reader.read_line(MAX_LINE), 'response')

MAX_FIELDS := 256

malformed := -> IOError('a malformed response')

# How the body of a response is told to end: `left`, the bytes of a body of a Content-Length, or nil
# for one that ends with the connection; or `chunked`.
struct Framing
  left: Int?
  chunked := false

# A response to HEAD, and one of 204 or 304, has no body, whatever its fields tell.
framing := (head: Head, method: String): Framing ->
  { status, headers } := head
  return { left: 0 } if method == 'HEAD' or status in [204, 304]
  if coding := headers.get('transfer-encoding')
    throw IOError("a transfer coding not supported: #{coding}") if ascii_lower(coding) != 'chunked'
    return { left: 0, chunked: true }
  text := headers.get('content-length') else return { left: nil }
  throw malformed() unless text.is_digits()
  { left: text.parse_int() else throw malformed() }

# The chunks of a body as they come, after which the connection is finished with.
class BodyChunks
  args
    connection: Connection
    finish: () -> void
    chunks: ChunkedBody | SizedBody

    # The seconds that each chunk may take to come.
    seconds: Float
  private var ended = false

  next := ->
    return nil if @ended
    chunk :=
      try
        await response_within(@connection, @chunks.next(), @seconds)
      # A cancelled read leaves the reader where it was, for the next read to go on from.
      catch error: IOError
        @connection.close()
        throw error
    @end() if chunk == nil
    chunk

  end := ->
    @ended = true
    @finish()

  # Closes the connection of a body left before its end, which cannot be kept with the rest unread.
  private abandon := ->
    return if @ended
    @ended = true
    @connection.close()

# The request that a redirect asks for, or nil for a response that is none. A 303, and a 301 or a
# 302 to POST, as browsers do, ask for a GET without the body. A request to another host or port
# leaves out the credentials, which were meant for the first.
redirected := (request: Outgoing, response: Response): Outgoing? ->
  { status } := response
  return nil unless status in REDIRECTS
  location := response.headers.get('location') else return nil
  target :=
    try
      parse_url resolve(request.target, location)
    catch _: ValueError
      throw IOError("a malformed redirect: #{location}")
  headers := Headers()
  headers.fields = [request.headers.fields...]
  if target.authority != request.target.authority
    headers.remove name for name in CREDENTIALS
  see_other := status == 303 and request.method != 'HEAD'
  moved_post := status in [301, 302] and request.method == 'POST'
  as_get := see_other or moved_post
  unless as_get
    # A body that is a Reader has been read as it was sent.
    return request.body is Reader then nil else { request..., target, headers }
  headers.remove 'content-type'
  { target, headers, method: 'GET', body: b'', seconds: request.seconds }

# Whether a URL starts with its scheme, which is absolute then; a `:` after a `/`, a `?` or a `#`,
# as of `/login?next=http://a/`, is in a relative one.
has_scheme := (location: String) ->
  (scheme, _rest) := location.split_once(':') else return false
  not scheme.is_empty() and scheme.all(is_scheme_char)

is_scheme_char := (c: Char) -> (c.is_ascii() and c.is_alphanumeric()) or c in '+-.'

REDIRECTS := [301, 302, 303, 307, 308]

CREDENTIALS := ['authorization', 'cookie', 'proxy-authorization']

# The URL of a Location, which may be relative to the URL of the request.
resolve := (base: Target, location: String) ->
  return location if has_scheme(location)
  return "http:#{location}" if location.starts_with('//')
  origin := "http://#{base.authority}"

  # The same document, whose fragment the request leaves out.
  return origin + base.path if location.is_empty() or location.starts_with('#')

  return origin + location if location.starts_with('/')
  (path, _query) := split_or_whole(base.path, '?')
  return origin + path + location if location.starts_with('?')
  segments := path.split('/')
  "#{origin}#{segments.all_but_last().join('/')}/#{location}"
