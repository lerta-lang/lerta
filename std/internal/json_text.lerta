# The text of JSON that both the writer and the reader of std:json write: strings in quotes, the
# keys of fields, hex digits, and the numbers it holds, which no infinity is.
import JsonKeys from '../json'
import INFINITY from '../math'

export is_finite := (value: Float) -> value != INFINITY and value != -INFINITY

# The key of a field: its name as written, or in camel case, which the compiler gives.
export field_key := (keys: JsonKeys, name: String, camel_case: String) ->
  keys == JsonKeys.AS_WRITTEN then name else camel_case

# The string in quotes, with the characters that JSON escapes escaped.
export quoted := (value: String) ->
  var text = '"'
  for c in value
    if escape := escape_of(c)
      text += escape
    else
      text += c
  text + '"'

escape_of := (c: Char): String? ->
  case c
    when '"' then '\"'
    when '\' then '\\'
    when "\n" then '\n'
    when "\r" then '\r'
    when "\t" then '\t'
    else c.to_int() < 0x20 then "\\u#{c.to_int().to_hex(4)}"
