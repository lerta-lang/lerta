# The text of JSON that both the writer and the reader of std:json write: strings in quotes, the
# keys of fields, hex digits, and the numbers it holds, which no infinity is.
import JsonKeys from '../json'
import double_quoted from './escape'
import INFINITY from '../math'
import scan from '../scanner'

export is_finite := (value: Float) -> value != INFINITY and value != -INFINITY

# An array or object being read or written: how many items or keys it has, and the step to the
# value in it, as `[0]` or `.name`, which errors give in its path.
export class Level
  var count = 0
  var step = ''

# The path from the root through the levels, the innermost last, as errors give it.
export path_of := (levels: Level[]) -> "$#{[level.step for level in levels].join()}"

# The keys of fields by their names, as JsonKeys writes them: in camel case, each made once.
export class FieldKeys
  args
    keys: JsonKeys
  private made := Map<String, String>()

  key := (name: String) ->
    return name if @keys == AS_WRITTEN
    return made if made := @made[name]
    key := camel_case(name)
    @made[name] = key
    key

# The name in camel case: each `_` between another character and a lowercase ASCII letter is left
# out, and the letter written in uppercase; a leading `_`, and one after another, stay.
camel_case := (name: String) ->
  scanner := scan(name)
  var written = ''
  var follows_other = false
  while c := scanner.next()
    after := scanner.peek()
    if c == '_' and follows_other and after and after.is_ascii() and after.is_lower()
      written += after.to_upper()
      scanner.next()
    else
      written += c
      follows_other = c != '_'
  written

# The string in quotes, with the characters that JSON escapes escaped.
export quoted := (value: String) -> double_quoted(value, escape_of)

escape_of := (c: Char) ->
  case c
    when '"' then '\"'
    when '\' then '\\'
    when "\n" then '\n'
    when "\r" then '\r'
    when "\t" then '\t'
    else
      c.to_int() < 0x20 then "\\u#{c.to_int().to_hex(4)}"
