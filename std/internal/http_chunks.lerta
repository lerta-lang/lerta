# The body of a message sent in chunks, by `Transfer-Encoding: chunked`.

import spawn from 'std:async'
import LineTooLongError, Reader from 'std:io'

# The bytes of a body of `left` bytes as they come from `reader`, or of all that it gives where
# `left` is nil, or nil at its end. `name` names the message in its error, `a <name> ended early`.
export class SizedBody
  reader: Reader
  name: String
  var left: Int?

  next := ->
    left := @left ? return await @reader.read(CHUNK_SIZE)
    return nil if left == 0
    chunk := await @reader.read(min(left, CHUNK_SIZE)) ? throw ended_early(@name)
    @left = left - chunk.length
    chunk

# The bytes of a chunked body as they come from `reader`, without the extensions of its chunks and
# its trailer fields, or nil at its end. `name` names the message in its errors, as `a malformed
# <name>`, `a <name> ended early` and `a <name> too large`, once more than `room` bytes of data have
# come, or more than MAX_LINE besides of lines, those of the sizes, the line end after each chunk
# and those of the trailer, each counted with CR LF, which a body of chunks of a sensible size does
# not come to before its data does.
export class ChunkedBody
  reader: Reader
  name: String
  room: Int
  private var data_taken = 0
  private var lines_taken = 0
  # The bytes left of the chunk being read.
  private var left = 0
  # Where the body stands, kept before each read, so that a read that is cancelled leaves the next
  # to go on from there: after the data of a chunk, before its line end, and in the trailer.
  private var ending_chunk = false
  private var in_trailer = false
  private var ended = false

  next := ->
    return nil if @ended
    if @left == 0
      if @ending_chunk
        await @end_chunk()
        @ending_chunk = false
      unless @in_trailer
        @left = await @size()
        @in_trailer = @left == 0
      if @in_trailer
        await @skip_trailer()
        @ended = true
        return nil
    chunk := await @reader.read(min(@left, CHUNK_SIZE)) ? throw ended_early(@name)
    @left -= chunk.length
    @ending_chunk = @left == 0
    @data_taken += chunk.length
    throw @too_large() if @data_taken > @room
    chunk

  # The size of the next chunk, in hexadecimal before its extensions.
  size := ->
    line := await @line() ? throw ended_early(@name)
    var size_text = line
    if (before, _extensions) := line.split_once(';')
      # Whitespace may go before the extensions, as RFC 9112 has it, and nowhere else.
      size_text = before
      while true
        trimmed := size_text.without_suffix(' ') ? size_text.without_suffix("\t") ? break
        size_text = trimmed
    hex := size_text.binary
    throw @malformed() if hex.is_empty()
    var zeros = 0
    zeros += 1 while hex.get(zeros) == b'0'
    # More digits than zeros could overflow.
    throw @malformed() if hex.length - zeros > 15
    var size = 0
    size = size * 16 + (byte.hex_value() ? throw @malformed()) for byte in hex
    size

  private end_chunk := ->
    line := await @line() ? throw ended_early(@name)
    throw @malformed() unless line.is_empty()

  private skip_trailer := ->
    while line := await @line()
      return if line.is_empty()
    throw ended_early(@name)

  # A line, its line end counted as CR LF.
  private line := ->
    line := await well_formed(@reader.read_line(MAX_LINE), @name) ? return nil
    @lines_taken += line.binary.length + 2
    # Compared so, as `room` may be INT_MAX.
    throw @too_large() if @lines_taken - MAX_LINE > @room
    line

  private too_large := -> IOError("a #{@name} too large")

  private malformed := -> IOError("a malformed #{@name}")

export ended_early := (name: String) -> IOError("a #{name} ended early")

# The bytes of a body to send as they come from `reader`, those that it gives at once joined, up to
# CHUNK_SIZE, so that a reader of small pieces takes few writes; or nil at its end. A read that does
# not give at once, or that fails, is left for the next, so that what has come is not held back.
# `ended` tells that the bytes given last were found to end the body.
export class JoinedReads
  reader: Reader
  var ended = false
  private var waiting: Promise<Binary?>? = nil

  next := ->
    return nil if @ended
    first := await @taken_waiting() ? return nil
    pieces := [first]
    var size = first.length
    while size < CHUNK_SIZE
      read := @reader.read(CHUNK_SIZE - size)
      @waiting = read
      break unless read.is_settled()
      try
        await read
      catch _
        break
      @waiting = nil
      if piece := await read
        pieces.push piece
        size += piece.length
      else
        @ended = true
        break
    pieces.join(b'')

  # Cancels the read left for the next, of a body whose sending has stopped, and drops its result,
  # as an error that it has been rejected with would otherwise end the program.
  cancel := ->
    waiting := @waiting ? return
    waiting.cancel()
    spawn dropped(waiting)

  private taken_waiting := ->
    read := @waiting ? @reader.read(CHUNK_SIZE)
    @waiting = nil
    await read

dropped := (read: Promise<Binary?>) ->
  try
    await read
  catch _
    nil

# The bytes of a chunk of a body that is sent in chunks; LAST_CHUNK ends them, after it if `ends`.
export chunk_bytes := (data: Binary, ends = false) ->
  chunk := b"#{data.length.to_hex()}\r\n" + data + b"\r\n"
  ends then chunk + LAST_CHUNK.binary else chunk

export LAST_CHUNK := "0\r\n\r\n"

# A line of a message, which is malformed if it is longer than MAX_LINE or not UTF-8.
export well_formed := (line: Promise<String?>, name: String) ->
  try
    await line
  catch _: LineTooLongError | ValueError
    throw IOError("a malformed #{name}")

export MAX_LINE := 65536
export CHUNK_SIZE := 65536
