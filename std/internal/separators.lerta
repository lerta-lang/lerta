# The separators between the names of a path: `/`, and on Windows `\` too.

import platform from './platform'

export is_separator := (byte: Byte) -> byte == b'/' or (platform == 'windows' and byte == b'\')

# The length of the path's bytes without the separators that end it.
export end_before_separators := (bytes: Binary) ->
  var end = bytes.length
  end -= 1 while end > 0 and is_separator(bytes[end - 1])
  end

# The path to the names below the path, after a single separator, or the path for none: the
# separators that end the path, as `/` does, are left out, as on Windows two that start a path make
# a network share of the two names after them.
export below := (path: String, names: String[]) ->
  return path if names.is_empty()
  bytes := path.binary
  "#{bytes.text(0, end_before_separators(bytes))!}/#{names.join('/')}"
