# The value of a conversion that the seed types as the type and the compiler as its optional type,
# until std is built by a seed that types it so (see docs/internals.md#bootstrap): `fitted` where
# it must fit, and `scalar` where a Char may not, as `Char.add` reports.
export const fitted = <T>(value: T?): T ->
  value ? throw ArithmeticError(message: 'integer overflow')

export const scalar = <T>(value: T?): T ->
  value ? throw ValueError(message: 'not a Unicode scalar value')
