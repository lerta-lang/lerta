# The code points of valid UTF-8, which a String always is, so its sequences need no checks.
export extern lerta_utf8_sequence_length as sequence_length: (Byte) -> Int

# The bits of a lead byte that hold a code point, by the length of its sequence.
const LEAD_BITS: Byte[] = [0x7F, 0x1F, 0x0F, 0x07]

# The code point whose sequence starts at `i`: the bits of the lead byte that its length leaves,
# then 6 of each byte that continues it.
export const code_point_at = (bytes: Binary, i: Int) ->
  const length = sequence_length(bytes[i])
  var code = (bytes[i] & LEAD_BITS[length - 1]).to_uint32()
  code = code << 6 | (bytes[i + k] & 0x3F).to_uint32() for k in 1...length
  code
