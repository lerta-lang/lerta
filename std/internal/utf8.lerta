# The Chars of valid UTF-8, which a String always is, so its sequences need no checks, and the
# UTF-8 of a String.

# The same object as a String, for bytes that are valid UTF-8.
export extern lerta_binary_as_string: (Binary) -> String

# The text from the byte `start` up to the byte `end`, each the start of a Char or the end; else
# it throws an IndexError.
export extern lerta_string_slice: (String, Int, Int) -> String

# The length of the sequence that the lead byte starts, or 0 for a byte that leads none.
export sequence_length := (lead: Byte) ->
  case
    when lead < 0x80 then 1
    when lead >= 0xC2 and lead <= 0xDF then 2
    when lead >= 0xE0 and lead <= 0xEF then 3
    when lead >= 0xF0 and lead <= 0xF4 then 4
    else 0

export is_continuation := (byte: Byte) -> byte >= 0x80 and byte <= 0xBF

# Whether the bytes are UTF-8. Overlong forms, surrogates and code points above U+10FFFF are not,
# as the standard requires: the leads 0xE0, 0xED, 0xF0 and 0xF4 limit the byte after them.
export is_utf8 := (bytes: Binary) ->
  var i = 0
  while i < bytes.length
    lead := bytes[i]
    length := sequence_length(lead)
    return false if length == 0 or i + length > bytes.length
    for k in 1...length
      return false if not is_continuation(bytes[i + k])
    return false if length > 1 and not may_follow(lead, bytes[i + 1])
    i += length
  true

may_follow := (lead: Byte, second: Byte) ->
  case lead
    when 0xE0 then second >= 0xA0
    when 0xED then second <= 0x9F
    when 0xF0 then second >= 0x90
    when 0xF4 then second <= 0x8F
    else true

# The bits of a lead byte that hold a code point, by the length of its sequence.
LEAD_BITS: Byte[] = [0x7F, 0x1F, 0x0F, 0x07]

# The Char whose sequence starts at `i`: the bits of the lead byte that its length leaves, then 6
# of each byte that continues it.
export char_at := (bytes: Binary, i: Int) ->
  length := sequence_length(bytes[i])
  var code = (bytes[i] & LEAD_BITS[length - 1]).to_int()
  code = code << 6 | (bytes[i + k] & 0x3F).to_int() for k in 1...length
  code.to_char()!

# The UTF-8 of a String, or the bytes as they are.
export bytes_of := (data: String | Binary) -> data is String then data.binary else data
