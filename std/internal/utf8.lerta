# The Chars of valid UTF-8, which a String always is, so its sequences need no checks, and the
# UTF-8 of a String.

# The same object as a String if the bytes are valid UTF-8, or nil.
export extern lerta_binary_text: (Binary) -> String?

# The text from the byte `start` up to the byte `end`, each the start of a Char or the end; else
# it throws an IndexError.
export extern lerta_string_slice: (String, Int, Int) -> String

# The length of the sequence that the lead byte starts, or 0 for a byte that leads none.
export sequence_length := (lead: Byte) ->
  case
    when lead < 0x80 then 1
    when lead in 0xC2..=0xDF then 2
    when lead in 0xE0..=0xEF then 3
    when lead in 0xF0..=0xF4 then 4
    else 0

export is_continuation := (byte: Byte) -> byte in 0x80..=0xBF

# The bits of a lead byte that hold a code point, by the length of its sequence.
LEAD_BITS: Byte[] = [0x7F, 0x1F, 0x0F, 0x07]

# The Char whose sequence starts at `i`: the bits of the lead byte that its length leaves, then 6
# of each byte that continues it.
export char_at := (bytes: Binary, i: Int) ->
  length := sequence_length(bytes[i])
  var code = (bytes[i] & LEAD_BITS[length - 1]).to_int()
  code = code << 6 | (bytes[i + k] & 0x3F).to_int() for k in 1..length
  code.to_char()!

# The UTF-8 of a String, or the bytes as they are.
export bytes_of := (data: String | Binary) -> data is String then data.binary else data
