# The date of a moment as HTTP writes it, the IMF-fixdate of RFC 9110: `Sun, 06 Nov 1994 08:49:37 GMT`.

import floor from 'std:math'
import time from 'std:time'

DAYS := ['Thu', 'Fri', 'Sat', 'Sun', 'Mon', 'Tue', 'Wed']
MONTHS := ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
SECONDS_PER_DAY := 86400

# The date of the second that the last response was given in, which the next ones of that second
# give again: a server writes it in every response, and making it is a fair part of a small one.
var last_second = -1
var last_date = ''

# The date of now.
export date_now := ->
  second := floor(time()).to_int()!
  if second != last_second
    last_second = second
    last_date = date_of(second)
  last_date

# The date of the Unix time, in whole seconds, from 1970 on, whose day 0 was a Thursday.
date_of := (seconds: Int) ->
  day := seconds / SECONDS_PER_DAY
  of_day := seconds % SECONDS_PER_DAY
  { year, month, month_day } := civil_date(day)
  clock := [two_digits(n) for n in [of_day / 3600, of_day / 60 % 60, of_day % 60]].join(':')
  date := "#{two_digits(month_day)} #{MONTHS[month - 1]} #{year}"
  "#{DAYS[day % 7]}, #{date} #{clock} GMT"

two_digits := (n: Int) -> n < 10 then "0#{n}" else "#{n}"

# The year, month (1 to 12) and day of the month of the days since 1970-01-01, in the Gregorian
# calendar (Howard Hinnant's civil_from_days): counted in eras of 400 years from a year that starts
# in March, so that the leap day ends it.
civil_date := (days: Int) ->
  shifted := days + 719468
  era := shifted / 146097
  day_of_era := shifted - era * 146097
  year_of_era := (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365
  day_of_year := day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100)
  shifted_month := (5 * day_of_year + 2) / 153
  month_day := day_of_year - (153 * shifted_month + 2) / 5 + 1
  month := shifted_month < 10 then shifted_month + 3 else shifted_month - 9
  year := year_of_era + era * 400 + (month <= 2 then 1 else 0)
  { year, month, month_day }
