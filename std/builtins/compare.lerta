# How values compare (see docs/reference/builtins.md#equatable-comparable-and-hashable).

# How a value compares with another, which compare gives (see Comparable).
export enum Ordering
  LESS
  EQUAL
  GREATER

# The types that have `equals`: every type that `==` compares, by its own equals or compare, or as
# `==` does.
export interface Equatable
  equals: (Self) -> Bool

# The types that have `compare`, which gives their `<` and the like: the numbers, String, and the
# classes and structs that have their own, which gives their `==` too.
export interface Comparable
  compare: (Self) -> Ordering

# The types that can be map keys and set items: equal values have the same hash.
export interface Hashable
  equals: (Self) -> Bool
  hash: () -> Int

# The least of the values, the first of those that are equal, by their compare (see Comparable).
export const min = <T: Comparable>(first: T, rest: T...): T ->
  var least = first
  for value in rest
    least = value if value < least
  least

# The greatest of the values, the first of those that are equal.
export const max = <T: Comparable>(first: T, rest: T...): T ->
  var greatest = first
  for value in rest
    greatest = value if value > greatest
  greatest
