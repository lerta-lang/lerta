# Text: what makes it, prints it and reads it, and the methods of Char, String and Binary (see
# docs/reference/builtins.md).
import is_control from '../internal/chars'
import double_quoted from '../internal/escape'
import
  char_at, is_continuation, lerta_binary_text, lerta_string_slice, sequence_length
from '../internal/utf8'
import Match, occurrences, Regex, replace_by_regex, replace_matches, split_by_regex from './regex'
import INFINITY from './numbers'
import normalized from '../internal/normal_forms'
import '../internal/unicode' as unicode

# Writes at once, unlike std:io's Writer (see runtime/io.c).
extern lerta_print_stdout: (String) -> void
extern lerta_print_stderr: (String) -> void

# The bits of the double that a decimal text rounds to, or -1 if it is too large to be finite.
extern lerta_float_literal_bits: (String) -> Int

extern lerta_float_from_bits: (Int) -> Float

## The types that have `to_string()`, which print and interpolation require.
export interface Stringable
  to_string: () -> String

## The types that have `to_literal()`, the text of the literal that gives the value, as an array's
## text writes its items: `'a'` for a String, where `to_string()` gives `a`.
export interface Literal
  to_literal: () -> String

## The normal forms of Unicode, which String.normalize gives: canonical decomposition, NFD, then
## composition, NFC, and those of compatibility, NFKD and NFKC.
export enum NormalForm
  NFC
  NFD
  NFKC
  NFKD

## Writes the value's `to_string()` and a line end to stdout.
export print := <T: Stringable>(x: T) -> print_stdout_line(x.to_string())

## Writes the value's `to_string()` and a line end to stderr.
export print_error := <T: Stringable>(x: T) -> print_stderr_line(x.to_string())

# Not generic, so that they are checked even if print and print_error are never called.
print_stdout_line := (text: String) -> lerta_print_stdout(text + "\n")
print_stderr_line := (text: String) -> lerta_print_stderr(text + "\n")

# The String of the Char, made anew.
text_of := (c: Char) -> '' + c

# The String of each ASCII character, by its code.
ASCII_TEXTS := [text_of(code.to_char()!) for code in 0..0x80]

extend Char
  # An ASCII character's String is made once, as text is often built one character at a time.
  to_string := ->
    code := @to_int()
    ASCII_TEXTS.get(code) else text_of(@)

  ## Quoted as a String of the one Char is.
  to_literal := -> @to_string().to_literal()

  ## Whether it is `0` to `9` alone, so that `c.to_int() - '0'.to_int()` is its value.
  is_digit := -> @ in '0'..='9'

  # Unicode's classes and simple case mappings (see std/internal/unicode.lerta).
  is_letter := -> unicode.is_letter(@)
  is_numeric := -> unicode.is_numeric(@)
  is_alphanumeric := -> @is_letter() or @is_numeric()
  is_lower := -> unicode.is_lower(@)
  is_upper := -> unicode.is_upper(@)
  is_space := -> unicode.is_space(@)
  is_ascii := -> @to_int() < 0x80
  to_upper := -> unicode.upper(@)
  to_lower := -> unicode.lower(@)

  ## That of the Byte of the same number (see Byte.hex_value), or nil above the Bytes.
  hex_value := -> @to_int().to_byte()?.hex_value()

  ## The Char that many places on, which throws where no Char is.
  add := (count: Int) -> (@to_int() + count).to_char() else throw not_a_char()

  ## The Char that many places back, which throws where no Char is.
  sub := (count: Int) -> (@to_int() - count).to_char() else throw not_a_char()

# The escape of a Char in a "..." literal (see docs/reference/syntax.md), or nil if it needs none.
escape_in_double_quotes := (c: Char) ->
  case c
    when '\' then '\\'
    when '"' then '\"'
    when '#' then '\#'
    when "\n" then '\n'
    when "\t" then '\t'
    when "\r" then '\r'
    when "\0" then '\0'
    else
      is_control(c) then "\\u{#{c.to_int().to_hex().to_upper()}}"

not_a_char := -> ValueError('not a Unicode scalar value')

extend String
  to_string := -> @
  is_empty := -> @binary.is_empty()

  ## By code points, so a combining mark moves away from its base.
  reversed := -> [char for char in @].reversed().join()

  ## In single quotes, or, for a String that holds a single quote or a control character, in
  ## double quotes, with what they would take otherwise escaped.
  to_literal := ->
    return "'#{@}'" unless @any((c) -> c == "'" or is_control(c))
    double_quoted(@, escape_in_double_quotes)

  ## The Chars.
  iter := (): Iter<Char> -> Chars(@binary)

  ## The Int that the text writes in decimal, with an optional `-`, or nil.
  # The digits are accumulated as a negative number, which can hold the minimum Int.
  parse_int := ->
    bytes := @binary
    negative := bytes.first() == b'-'
    start := negative then 1 else 0
    return nil if start == bytes.length
    var value = 0
    for i in start..bytes.length
      byte := bytes[i]
      return nil unless byte.is_digit()
      digit := (byte - b'0').to_int()
      return nil if value < (INT_MIN + digit) / 10
      value = value * 10 - digit
    return nil if not negative and value == INT_MIN
    negative then value else -value

  ## The Float that the text writes, as to_string writes it: an infinity as `inf` or `-inf`.
  parse_float := ->
    return INFINITY if @ == 'inf'
    return -INFINITY if @ == '-inf'
    return nil unless is_decimal_number(@binary)
    bits := lerta_float_literal_bits(@)
    bits != -1 then lerta_float_from_bits(bits)

  ## The pieces between the occurrences of the separator, or between the matches of a Regex.
  # A valid separator starts and ends at code points, so the pieces are cut at them.
  split := (separator: String | Regex) ->
    return split_by_regex(@, separator) if separator is Regex
    throw ValueError('split by an empty separator') if separator.is_empty()
    bytes := @binary
    separator_bytes := separator.binary

    # Taken as a Byte once, so that each index_of below goes straight to the search of a byte.
    part: Binary | Byte = separator_bytes.length == 1 then separator_bytes[0] else separator_bytes

    pieces: String[]
    var start = 0
    while found := bytes.index_of(part, start)
      pieces.push lerta_string_slice(@, start, found)
      start = found + separator_bytes.length
    pieces.push lerta_string_slice(@, start, bytes.length)
    pieces

  ## The lines without their `\n` or `\r\n`, and no empty line after a last `\n`.
  ## Only a piece that a `\n` ends loses its `\r`.
  lines := ->
    pieces := @split("\n")
    rest := pieces.pop()
    ended := [
      for piece in pieces
        piece.without_suffix("\r") else piece
    ]
    ended.push rest unless rest.is_empty()
    ended

  ## The pieces between runs of spaces (see Char.is_space), none empty.
  split_whitespace := ->
    bytes := @binary
    words: String[]
    var start = 0
    while start < bytes.length
      space := space_length(bytes, start)
      if space > 0
        start += space
        continue
      var end = start + sequence_length(bytes[start])
      while end < bytes.length and space_length(bytes, end) == 0
        end += sequence_length(bytes[end])
      words.push lerta_string_slice(@, start, end)
      start = end
    words

  starts_with := (prefix: String) -> @binary.starts_with(prefix.binary)
  ends_with := (suffix: String) -> @binary.ends_with(suffix.binary)
  without_prefix := (prefix: String) ->
    @starts_with(prefix) then @binary.text(prefix.binary.length)!
  without_suffix := (suffix: String) ->
    @ends_with(suffix) then @binary.text(0, @binary.length - suffix.binary.length)!

  ## By the first byte that differs, or else by length, so that a prefix goes first.
  compare := (other: String) ->
    (bytes, other_bytes) := (@binary, other.binary)
    for i in 0..min(bytes.length, other_bytes.length)
      if bytes[i] != other_bytes[i]
        return bytes[i].compare(other_bytes[i])
    bytes.length.compare(other_bytes.length)

  ## Whether the part occurs in the String; the empty String occurs in every one.
  # As index_of finds an empty part at the start.
  contains := (part: String) -> @binary.index_of(part.binary) != nil

  ## Whether the String is one or more ASCII digits (see Char.is_digit).
  is_digits := -> not @is_empty() and @all(Char.is_digit)

  ## Whether every byte is ASCII, which no byte of a multi-byte character is.
  is_ascii := -> @binary.all((b) -> b < 0x80)

  ## Without the spaces at both ends (see Char.is_space).
  trim := ->
    start := text_start(@binary)
    lerta_string_slice(@, start, text_end(@binary, start))

  ## Without the spaces at the start (see Char.is_space).
  trim_start := -> lerta_string_slice(@, text_start(@binary), @binary.length)

  ## Without the spaces at the end (see Char.is_space).
  trim_end := -> lerta_string_slice(@, 0, text_end(@binary, 0))

  ## Each occurrence of the part, from the start and without overlapping, or each match of a Regex,
  ## replaced by `by`, as it is, or by what `by` gives for its Match.
  # By a String, the common case, no Match is made.
  replace := (part: String | Regex, by: String | ((Match) -> String)) ->
    throw ValueError('replace of an empty part') if part is String and part.is_empty()
    if by is String
      if part is Regex
        return replace_by_regex(@, part, by)
      return @split(part).join(by)
    matches :=
      if part is Regex
        part.find_all @
      else
        occurrences @, part
    replace_matches(@, matches, by)

  ## The full case mapping, which may give more than one character, as `ß` gives `SS`.
  to_upper := -> unicode.upper_text(@)

  ## The full case mapping, which may give more than one character.
  to_lower := -> unicode.lower_text(@)

  normalize := (form: NormalForm) ->
    compatibility := form in [NFKC, NFKD]
    composed := form in [NFC, NFKC]
    normalized(@, compatibility, composed)

  ## The String after as many of `fill`, one code point, as make it `width` code points long, or the
  ## String itself if it is no shorter; another fill throws a ValueError.
  pad_start := (width: Int, fill = ' ') -> padding(@, width, fill) + @

  ## As pad_start, with the code points of `fill` after the String; another fill throws a
  ## ValueError.
  pad_end := (width: Int, fill = ' ') -> @ + padding(@, width, fill)

  repeat := (count: Int) ->
    throw ValueError('repeat a negative number of times') if count < 0
    var repeated = ''
    repeated += @ for _ in 0..count
    repeated

  ## What comes before the first occurrence of the part, or nil if there is none.
  before := (part: String) ->
    found := @binary.index_of(part.binary) else return nil
    lerta_string_slice(@, 0, found)

  ## What comes after the first occurrence of the part, or nil if there is none.
  after := (part: String) ->
    found := @binary.index_of(part.binary) else return nil
    lerta_string_slice(@, found + part.binary.length, @binary.length)

  ## The String after its first n code points, as `take(n)` gives them, so empty if it has no more.
  skip := (n: Int) ->
    bytes := @binary
    var at = 0
    for _ in 0..n
      break if at == bytes.length
      at += sequence_length(bytes[at])
    lerta_string_slice(@, at, bytes.length)

  ## The String after the code points for which `skipped` holds, from the start.
  skip_while := (skipped: (Char) -> Bool) ->
    bytes := @binary
    var at = 0
    while at < bytes.length and skipped(char_at(bytes, at))
      at += sequence_length(bytes[at])
    lerta_string_slice(@, at, bytes.length)

  ## The number of its bytes, its UTF-8's, rather than of its code points, which `count()` gives.
  byte_count := -> @binary.length

  ## What comes before the first occurrence of the separator and what comes after it, or nil if
  ## there is none.
  split_once := (separator: String) ->
    throw ValueError('split by an empty separator') if separator.is_empty()
    bytes := @binary
    found := bytes.index_of(separator.binary) else return nil
    before := lerta_string_slice(@, 0, found)
    after := found + separator.binary.length
    (before, lerta_string_slice(@, after, bytes.length))

extend Binary
  is_empty := -> @length == 0
  get := (index: Int) -> index in 0..@length then @[index]
  first := -> @get(0)
  last := -> @get(@length - 1)
  starts_with := (prefix: Binary) -> @occurs_at(0, prefix)
  ends_with := (suffix: Binary) -> @occurs_at(@length - suffix.length, suffix)

  ## The place of the first occurrence of `part`, bytes or a byte, at `from` or after it, or nil,
  ## always so past the end; an empty part occurs at `from` if it is at most the length.
  index_of := (part: Binary | Byte, from = 0) ->
    throw IndexError('index_of from a negative place') if from < 0
    if part is Byte
      return byte_index(@, part, from)

    # A part of one byte is found as the byte, one comparison at each place. The search is a
    # function of its own rather than a call of index_of, which LLVM would not inline.
    if part.length == 1
      return byte_index(@, part[0], from)
    for i in from..max(from, @length - part.length + 1)
      return i if @occurs_at(i, part)
    nil

  ## The bytes, read as the Iter is.
  iter := (): Iter<Byte> -> (b for b in @)

  occurs_at := (index: Int, part: Binary) ->
    return false if index < 0 or index > @length - part.length
    for byte at k in part
      return false if @[index + k] != byte
    true
  text := (start = 0, end: Int = @length) ->
    bytes :=
      if start == 0 and end == @length
        @
      else
        @[start..end]
    lerta_binary_text(bytes)

  ## The UInt32 at `index`, counted in UInt32s, of the bytes read as little-endian ones.
  # The last byte is checked against the length, rather than `index` against `@length / 4`, from
  # which LLVM does not see the bytes in range and keeps a check for each; an `index` so huge that
  # its bytes' place overflows throws an ArithmeticError, rather than an IndexError after a test of
  # `index` against the length: in a loop LLVM keeps that test and the overflow's, but drops the
  # test of the last byte. The reads are at constant steps from `start`, which LLVM merges into one
  # load (see emit_binary_get).
  uint32_at := (index: Int) ->
    index_out_of_range() if index < 0 or index * 4 + 3 >= @length
    start := index * 4
    @[start].to_uint32() |
      @[start + 1].to_uint32() << 8 |
      @[start + 2].to_uint32() << 16 |
      @[start + 3].to_uint32() << 24

# Throws an IndexError, out of the methods that check an index, so that they stay short enough for
# LLVM to inline them.
index_out_of_range := -> throw IndexError('index out of range')

# The Chars of a String's bytes, for its iter: one object, where `has_next` and `next` as closures
# sharing `at` would allocate both closures and the variable.
class Chars
  args
    bytes: Binary
  var at = 0
  has_next := -> @at < @bytes.length
  next := ->
    lead := @bytes[@at]

    # An ASCII byte is its Char, which needs neither the decoding nor the length of a sequence.
    if lead < 0x80
      @at += 1
      return lead.to_char()

    c := char_at(@bytes, @at)
    @at += sequence_length(lead)
    c

# The place of the first `byte` in `bytes` at `from` or after it, or nil.
byte_index := (bytes: Binary, byte: Byte, from: Int) ->
  for i in from..bytes.length
    return i if bytes[i] == byte
  nil

# The number of bytes of the space whose sequence starts at `i`, or 0 if its character is none: an
# ASCII byte is tested alone, so that ASCII text decodes no character.
space_length := (bytes: Binary, i: Int) ->
  lead := bytes[i]
  return lead.is_space() then 1 else 0 if lead < 0x80
  char := char_at(bytes, i)
  char.is_space() then sequence_length(lead) else 0

# The start of the UTF-8 without the spaces at it.
text_start := (bytes: Binary) ->
  var start = 0
  while start < bytes.length
    space := space_length(bytes, start)
    break if space == 0
    start += space
  start

# The end of the UTF-8 without the spaces at it, which is no earlier than `start`, a character's
# start: each character back is found from its last byte, past those that continue it.
text_end := (bytes: Binary, start: Int) ->
  var end = bytes.length
  while end > start
    var lead = end - 1
    lead -= 1 while is_continuation(bytes[lead])
    break if space_length(bytes, lead) == 0
    end = lead
  end

# The copies of `fill` that make `text` `width` code points long (see pad_start).
padding := (text: String, width: Int, fill: String) ->
  throw ValueError('a fill that is not one code point') if fill.count() != 1
  fill.repeat(max(0, width - text.count()))

# The Strings or the Chars one after another, as a String, with the separator, if any, between each
# two: of an array or an Iter, not of an Iterable (see docs/reference/builtins.md#iter).
extend String[]
  ## The parts as one String, with the separator between each two.
  join := (separator = '') -> joined_strings(@, separator)

extend Iter<String>
  ## The parts as one String, with the separator between each two.
  join := (separator = '') -> joined_strings(@, separator)

extend Char[]
  ## The parts as one String, with the separator between each two.
  join := (separator = '') -> joined_chars(@, separator)

extend Iter<Char>
  ## The parts as one String, with the separator between each two.
  join := (separator = '') -> joined_chars(@, separator)

joined_strings := <I: Iterable<String>>(parts: I, separator: String) ->
  var text = ''
  for part at i in parts
    text += separator if i > 0
    text += part
  text

# As joined_strings, appending each Char, which needs no String of its own.
joined_chars := <I: Iterable<Char>>(chars: I, separator: String) ->
  var text = ''
  for char at i in chars
    text += separator if i > 0
    text += char
  text

extend Binary[]
  ## The Binarys one after another, with the separator, if any, between each two.
  join := (separator: Binary = b'') ->
    var joined = b''
    for part at i in @
      joined += separator if i > 0
      joined += part
    joined

extend Byte[]
  to_binary := ->  ## The same bytes, copied into a Binary.
    var bytes = b''
    bytes += byte for byte in @
    bytes

# Digits, an optional fraction and an optional exponent, after an optional `-` (see parse_float).
is_decimal_number := (bytes: Binary) ->
  var i = bytes.get(0) == b'-' then 1 else 0
  digits_from := (start: Int) ->
    var end = start
    end += 1 while bytes.get(end)?.is_digit() == true
    end
  whole_end := digits_from(i)
  return false if whole_end == i
  i = whole_end
  if bytes.get(i) == b'.'
    fraction_end := digits_from(i + 1)
    return false if fraction_end == i + 1
    i = fraction_end
  if bytes.get(i) == b'e' or bytes.get(i) == b'E'
    i += 1
    i += 1 if bytes.get(i) == b'+' or bytes.get(i) == b'-'
    exponent_end := digits_from(i)
    return false if exponent_end == i
    i = exponent_end
  i == bytes.length
