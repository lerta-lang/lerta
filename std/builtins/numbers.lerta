# The methods of the numbers and Bool (see docs/reference/builtins.md#methods-of-the-builtin-types).
import is_continuation from '../internal/utf8'
extern lerta_float_to_string: (Float) -> String
extern lerta_float_fits_int: (Float) -> Bool
extern lerta_float_to_int: (Float) -> Int
extern lerta_float32_to_string: (Float32) -> String
extern pow as libm_pow: (Float, Float) -> Float
extern floor as libm_floor: (Float) -> Float

# The least and the greatest Int.
export INT_MIN := -9223372036854775808
export INT_MAX := 9223372036854775807

# The positive infinity, which std:builtins' own modules use and std:math exports.
export INFINITY := 1.0 / 0.0

extend Float
  to_string := -> lerta_float_to_string(@)

  # As C's pow gives it, which is NaN for a finite negative base and an exponent that is no integer.
  pow := (exponent: Float) ->
    if @ < 0.0 and @ != -INFINITY and libm_floor(exponent) != exponent
      throw ArithmeticError('a negative number to a fractional power')
    libm_pow(@, exponent)

  # An infinity is written as the value that names it.
  to_literal := ->
    return 'INFINITY' if @ == INFINITY
    return '-INFINITY' if @ == -INFINITY
    @to_string()

  # The Int of the value truncated toward zero, or nil where it is beyond an Int.
  to_int := -> lerta_float_fits_int(@) then lerta_float_to_int(@)

  # The text with `digits` digits after the point: the whole part exactly, and the fraction times
  # 10 to the `digits` rounded half away from zero, carried into the whole part if it rounds up to
  # it. The product may round, so a fraction just below a half may round up; the rest after
  # truncating it is exact, so that rounding adds no error of its own, as adding 0.5 would.
  to_fixed := (digits: Int) ->
    throw ValueError("to_fixed of #{digits} digits, not 0 to 18") unless digits in 0..=18
    scale := 10 ** digits
    size := @ < 0.0 then -@ else @
    throw ValueError('to_fixed of an infinity') if size == INFINITY
    (whole, units) := whole_and_units(size, scale)
    sign :=
      if @ < 0.0 and (whole != '0' or units != 0)
        '-'
      else
        ''
    return "#{sign}#{whole}" if digits == 0
    "#{sign}#{whole}.#{units.to_string().pad_start(digits, '0')}"

extend Float32
  to_string := -> lerta_float32_to_string(@)

  # Exact, as a Float holds every Float32.
  to_fixed := (digits: Int) -> @to_float().to_fixed(digits)

  # An infinity is written as the value that names it, made a Float32.
  to_literal := ->
    value := @to_float()
    return "#{value.to_literal()}.to_float32()" if value == INFINITY or value == -INFINITY
    @to_string()

extend Bool
  to_string := -> @ then 'true' else 'false'
  to_literal := -> @to_string()

extend Int
  # The magnitude, which throws for the least Int, whose magnitude no Int holds.
  abs := -> @ < 0 then -@ else @

  # By squaring, which leaves out the square after the last factor, so that it throws only where the
  # power itself does not fit.
  pow := (n: Int) ->
    throw ArithmeticError('negative exponent') if n < 0
    var result = 1
    var base = @
    var rest = n
    while rest > 0
      result *= base if rest & 1 == 1
      rest >>= 1
      base *= base if rest > 0
    result

  # The magnitude of a negative value is that of `@ + 1` plus one, as `@ + 1`, unlike the minimum
  # Int, can be negated.
  to_string := ->
    return digits_text(@to_uint64()!, 10) if @ >= 0
    digits_text((-(@ + 1)).to_uint64()! + 1, 10, true)

  to_literal := -> @to_string()

  # As a UInt64's; a negative number has no one such text, so it throws.
  to_hex := (width = 0) ->
    throw ValueError("to_hex of #{@}, a negative number") if @ < 0
    @to_uint64()!.to_hex(width)

  # The same bits as a UInt64: the value itself if not negative, else 2 to the 64 more. Each half
  # fits in a non-negative Int, which to_uint64 converts.
  to_bits := (): UInt64 ->
    high := (@ >> 32 & 0xFFFFFFFF).to_uint64()!
    low := (@ & 0xFFFFFFFF).to_uint64()!
    high << 32 | low

extend Int8
  to_string := -> @to_int().to_string()
  to_literal := -> @to_string()

extend Int16
  to_string := -> @to_int().to_string()
  to_literal := -> @to_string()

extend Int32
  to_string := -> @to_int().to_string()
  to_literal := -> @to_string()

extend UInt16
  to_string := -> @to_int().to_string()
  to_literal := -> @to_string()

extend UInt32
  to_string := -> @to_int().to_string()
  to_literal := -> @to_string()

extend UInt64
  to_string := -> digits_text(@, 10)
  to_literal := -> @to_string()

  # The digits in lower-case hexadecimal, with zeros before them to make `width` digits.
  to_hex := (width = 0) -> digits_text(@, 16).pad_start(width, '0')

# A byte's classes are those of ASCII, which are those of the Char of the same number below 0x80:
# a byte above is part of a UTF-8 sequence, in no class.
extend Byte
  to_string := -> @to_int().to_string()
  to_literal := -> @to_string()

  # As that of an Int (see UInt64.to_hex).
  to_hex := (width = 0) -> @to_int().to_hex(width)

  is_digit := -> @ in b'0'..=b'9'
  is_letter := -> @is_lower() or @is_upper()
  is_alphanumeric := -> @is_letter() or @is_digit()
  is_space := -> @ == b' ' or @ in b"\t"..=b"\r"
  is_lower := -> @ in b'a'..=b'z'
  is_upper := -> @ in b'A'..=b'Z'
  is_utf8_continuation := -> is_continuation(@)

  # The value of a hexadecimal digit, of either case, or nil if the byte is none.
  hex_value := ->
    case
      when @ in b'0'..=b'9' then (@ - b'0').to_int()
      when @ in b'a'..=b'f' then (@ - b'a').to_int() + 10
      when @ in b'A'..=b'F' then (@ - b'A').to_int() + 10
      else nil

# The digits of `n` in `base`, after a '-' if `negative`. They are appended from the first, which
# the greatest power of the base not above `n` picks, so that the String grows in place.
digits_text := (n: UInt64, base: UInt64, negative = false) ->
  limit := n / base
  var scale: UInt64 = 1
  scale *= base while scale <= limit
  var text = negative then '-' else ''
  var rest = n
  while scale != 0
    digit := (rest / scale).to_byte()!
    rest -= digit.to_uint64() * scale
    text += (digit + (digit < 10 then b'0' else b'a' - 10)).to_char()
    scale /= base
  text

# The digits of the whole part of a finite Float of no sign, and its fraction in units of 1 /
# `scale`. Below 2 to the 53rd, the whole part fits an Int and the fraction times `scale` does too;
# from it on, a Float is whole.
whole_and_units := (value: Float, scale: Int) ->
  return (whole_digits(value), 0) if value >= TWO_TO_53
  whole := value.to_int()!
  product := (value - whole.to_float()) * scale.to_float()
  truncated := product.to_int()!
  units := product - truncated.to_float() >= 0.5 then truncated + 1 else truncated
  if units == scale
    ((whole + 1).to_string(), 0)
  else
    (whole.to_string(), units)

# The digits of a whole Float of 2 to the 53rd or more: a 53-bit whole number times a power of 2,
# which halving finds exactly, made decimal by doubling it in limbs of 9 digits, the lowest first.
whole_digits := (value: Float) ->
  var mantissa = value
  var doublings = 0
  while mantissa >= TWO_TO_53
    mantissa = mantissa / 2.0
    doublings += 1
  whole := mantissa.to_int()!
  limbs := [whole % LIMB, whole / LIMB]
  for _ in 0..doublings
    var carry = 0
    for i in 0..limbs.length
      doubled := limbs[i] * 2 + carry
      limbs[i] = doubled % LIMB
      carry = doubled / LIMB
    limbs.push carry if carry > 0
  highest_first := limbs.reversed()
  rest := [
    for limb in highest_first[1..]
      limb.to_string().pad_start(9, '0')
  ]
  "#{highest_first[0]}#{rest.join()}"

TWO_TO_53 := 9007199254740992.0
LIMB := 1000000000
