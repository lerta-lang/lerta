# Arrays, Iters, Iterables, maps and sets (see docs/reference/builtins.md#iterable).

# The types that `for` and comprehensions go through, by the Iter of `iter()`.
export interface Iterable<T>
  iter: () -> Iter<T>

# The types that `x in xs` tests, by `xs.contains(x)`: arrays, sets and maps, by their keys, and
# Strings, by their parts.
export interface Contains<T>
  contains: (T) -> Bool

# `[1, 2]`, with each item as the literal that gives it, `['a']`.
extend<T: Literal> T[]
  to_string := (): String -> "[#{[item.to_literal() for item in @].join(', ')}]"
  to_literal := (): String -> @to_string()

extend<T> T[]
  # The items, read as the Iter is.
  iter := (): Iter<T> -> (x for x in @)
  is_empty := -> @length == 0
  first := (): T? -> @get(0)
  last := (): T? -> @get(@length - 1)
  get := (index: Int): T? -> index in 0..@length then @[index]
  # The items in the order that `compare` gives (LESS when its first argument goes first), equal
  # items keeping their order.
  # A default rather than a `sorted` of an extend of Comparable items, as two extends cannot give
  # a method of one name for different bounds.
  sorted := (compare: (T, T) -> Ordering = (a, b) -> a.compare(b)): T[] ->
    copy := [item for item in @]
    copy.sort compare
    copy
  # Orders the items in place, as `sorted` orders a copy.
  # A merge sort: runs of `width` items, sorted, are merged in pairs, doubling it, from one array
  # into the other, so that the copy is the only array it makes.
  sort := (compare: (T, T) -> Ordering = (a, b) -> a.compare(b)) ->
    count := @length
    return if count < 2
    var runs = @
    var merged = [item for item in @]
    var width = 1
    var in_copy = false
    # The copy back is in a finally, so that a compare that throws while a merge writes into the
    # array leaves it the items of the pass before, rather than some of them twice.
    try
      while width < count
        var start = 0
        while start < count
          middle := min(start + width, count)
          end := min(middle + width, count)
          merge runs, start, middle, end, compare, merged
          start = end
        done := merged
        merged = runs
        runs = done
        in_copy = not in_copy
        width *= 2
    finally
      if in_copy
        @[i] = runs[i] for i in 0..count
  # Pushes the items of another array, one by one; those of the array itself, if it is that, once.
  append := (items: T[]) ->
    count := items.length
    @push items[i] for i in 0..count
  reversed := (): T[] -> [@[@length - 1 - i] for i in 0..@length]
  # Removes the items after the first `length`, if it has more.
  truncate := (length: Int) ->
    throw ValueError(message: 'truncate to a negative length') if length < 0
    @pop() while @length > length
  # Removes the items from `at` on, and gives them, in order; `at` must be in `0..=length`, as the
  # start of a slice.
  split_off := (at: Int): T[] ->
    taken := @[at..]
    @truncate at
    taken
  # The items but the last; none for an empty array, for which a slice to one before the end throws.
  all_but_last := (): T[] -> @is_empty() then [] else @[..(@length - 1)]
  # The items in the order of their keys, as `sorted` orders them.
  sorted_by := <K: Comparable>(key: (T) -> K): T[] -> @sorted((a, b) -> key(a).compare(key(b)))
  # Orders the items in place by their keys, as `sorted_by` orders a copy.
  sort_by := <K: Comparable>(key: (T) -> K) -> @sort((a, b) -> key(a).compare(key(b)))

# The methods that find items by their `==`.
extend<T: Equatable> T[]
  # A loop rather than `@any`, whose result LLVM computes after the loop, at an extra move per item.
  contains := (item: T): Bool ->
    for each in @
      return true if each == item
    false
  # The index of the first item equal to `item`.
  index_of := (item: T): Int? ->
    for each at i in @
      return i if each == item
    nil
  # Removes the first item equal to `item`, if there is one, moving those after it down, and tells
  # whether it did.
  remove := (item: T): Bool ->
    index := @index_of(item) ? return false
    @[i] = @[i + 1] for i in index..(@length - 1)
    @pop()
    true

extend<T> Iter<T>
  # Itself, so that an Iter is Iterable.
  iter := (): Iter<T> -> @

# The methods of whatever `for` goes through: they read its items as it does, through `iter()`.
extend<T> Iterable<T>
  map := <U>(f: (T) -> U): Iter<U> -> (f(x) for x in @)
  filter := (keep: (T) -> Bool): Iter<T> -> (x for x in @ when keep(x))
  to_array := (): T[] -> [x for x in @]
  any := (test: (T) -> Bool): Bool ->
    for x in @
      return true if test(x)
    false
  # A loop rather than `not @any`, whose function would capture `test`, which is then called as a
  # closure rather than generated in place (see docs/internals/iteration.md#inlined-methods).
  all := (test: (T) -> Bool): Bool ->
    for x in @
      return false unless test(x)
    true
  find := (test: (T) -> Bool): T? ->
    for x in @
      return x if test(x)
    nil
  find_index := (test: (T) -> Bool): Int? ->
    for x at i in @
      return i if test(x)
    nil
  # The first result of `f` that is not nil.
  find_map := <U>(f: (T) -> U?): U? ->
    for x in @
      return found if found := f(x)
    nil
  # The number of items, as `for` goes through them: the Chars of a String.
  count := (): Int ->
    var count = 0
    count += 1 for _ in @
    count
  # `combine` applied to `initial` and the first item, then to that and the next, and so on.
  fold := <A>(initial: A, combine: (A, T) -> A): A ->
    var result = initial
    result = combine(result, x) for x in @
    result
  # The item whose key is the least, the first of those with equal keys, or nil if there is none.
  min_by := <K: Comparable>(key: (T) -> K): T? -> extreme_by(@iter(), key, LESS)
  # The item whose key is the greatest, the first of those with equal keys, or nil if there is none.
  max_by := <K: Comparable>(key: (T) -> K): T? -> extreme_by(@iter(), key, GREATER)
  # It stops reading its source after them, which a comprehension could not.
  take := (n: Int): Iter<T> ->
    source := @iter()
    var left = n
    has_next := -> left > 0 and source.has_next()
    next := (): T ->
      left -= 1
      source.next()
    { has_next, next }
  # The items before the first for which `keep` is false, which it reads but does not give.
  take_while := (keep: (T) -> Bool): Iter<T> ->
    for x in @
      return unless keep(x)
      yield x
  zip := <U>(other: Iterable<U>): Iter<(T, U)> ->
    left := @iter()
    right := other.iter()
    has_next := ->
      more := left.has_next()
      throw ValueError(message: 'zip of Iterables of different lengths') if right.has_next() != more
      more
    next := (): (T, U) -> (left.next(), right.next())
    { has_next, next }

# `{ 'a': 1 }`, with each key and value as the literal that gives it; `{}` when empty, as a map
# literal cannot write an empty map.
extend<K: Literal, V: Literal> Map<K, V>
  to_string := (): String ->
    entries := ["#{key.to_literal()}: #{value.to_literal()}" for (key, value) in @entries()]
    @is_empty() then '{}' else "{ #{entries.join(', ')} }"
  to_literal := (): String -> @to_string()

# `Set([1, 2])`, with each item as the literal that gives it.
extend<T: Literal> Set<T>
  to_string := (): String ->
    @is_empty() then 'Set()' else "Set([#{[item.to_literal() for item in @].join(', ')}])"
  to_literal := (): String -> @to_string()

extend<K, V> Map<K, V>
  contains := (key: K): Bool -> @[key] != nil
  is_empty := -> @length == 0
  # The values of the entries, as `entries()` gives them.
  values := (): Iter<V> -> (value for (_, value) in @entries())
  # The value of the key, which `make` makes and the map holds first where it has none, as a cache
  # does; `m[k] ? d` reads without adding.
  get_or_add := (key: K, make: () -> V): V ->
    return found if found := @[key]
    made := make()
    @[key] = made
    made

# The operations of sets, by the operators: `a | b`, `a & b`, `a - b` and `a ^ b` give new sets, of
# the items in the order of `a`, then of `b`.
extend<T> Set<T>
  is_empty := -> @length == 0
  # The items of either.
  bit_or := (other: Set<T>): Set<T> ->
    union := Set<T>([item for item in @])
    union.add item for item in other
    union
  # The items of this set that the other has too.
  bit_and := (other: Set<T>): Set<T> -> Set<T>([item for item in @ when other.contains(item)])
  # The items of this set that the other has not.
  sub := (other: Set<T>): Set<T> -> Set<T>([item for item in @ when not other.contains(item)])
  # The items of one set that the other has not.
  bit_xor := (other: Set<T>): Set<T> -> @ - other | (other - @)
  # Whether the other has every item of this set.
  is_subset := (other: Set<T>): Bool -> @iter().all(other.contains)

# Writes the items of runs[start..middle] and runs[middle..end], each sorted by `compare`, to
# merged[start..end] in order, the left item first when equal, keeping the order of equal items.
merge := <T>(
  runs: T[], start: Int, middle: Int, end: Int, compare: (T, T) -> Ordering, merged: T[]
) ->
  var left = start
  var right = middle
  for at in start..end
    if right == end or (left < middle and compare(runs[left], runs[right]) != GREATER)
      merged[at] = runs[left]
      left += 1
    else
      merged[at] = runs[right]
      right += 1

# The item whose key compares with every other key as `order` or equal, the first of such ones, or
# nil if there is none (see min_by).
extreme_by := <T, K: Comparable>(items: Iter<T>, key: (T) -> K, order: Ordering): T? ->
  var found: T?
  var found_key: K?
  for x in items
    k := key(x)
    if found_key == nil or k.compare(found_key) == order
      found = x
      found_key = k
  found

extend<T: Comparable> Iterable<T>
  # The least item, the first of equal ones, or nil if there is none.
  min := (): T? -> @min_by((x) -> x)
  # The greatest item, the first of equal ones, or nil if there is none.
  max := (): T? -> @max_by((x) -> x)

extend<T: Add<T, T>> Iterable<T>
  # The items added to `zero` one after another, from the first: 0 for numbers, and for other
  # types their own, as `''` for Strings.
  sum := (zero: T = 0): T ->
    var total = zero
    total += x for x in @
    total
