# The methods that the operators call (see docs/reference/builtins.md#operators).

# The types that the arithmetic and bitwise operators apply to: `a + b` calls `a.add(b)` on a type
# that `+` does not apply to otherwise, and so on, and `-a` calls `a.neg()`. The numbers have them,
# as `+` gives them, and String has add.
export interface Add<Rhs, Out>
  add: (Rhs) -> Out

export interface Sub<Rhs, Out>
  sub: (Rhs) -> Out

export interface Mul<Rhs, Out>
  mul: (Rhs) -> Out

export interface Div<Rhs, Out>
  div: (Rhs) -> Out

export interface Rem<Rhs, Out>
  rem: (Rhs) -> Out

export interface BitAnd<Rhs, Out>
  bit_and: (Rhs) -> Out

export interface BitOr<Rhs, Out>
  bit_or: (Rhs) -> Out

export interface BitXor<Rhs, Out>
  bit_xor: (Rhs) -> Out

export interface Shl<Rhs, Out>
  shl: (Rhs) -> Out

export interface Shr<Rhs, Out>
  shr: (Rhs) -> Out

export interface Neg<Out>
  neg: () -> Out
