# The methods that the operators call (see docs/reference/builtins.md#operators).

# The types that the arithmetic and bitwise operators apply to: `a + b` calls `a.add(b)` on a type
# that `+` does not apply to otherwise, and so on, and `-a` calls `a.neg()`. The numbers have them,
# as `+` gives them, and String has add. `a ** b` always calls `a.pow(b)`, which Int and Float have.
export interface Add<Rhs, Out>  ## `a + b` calls `a.add(b)`.
  add: (Rhs) -> Out

export interface Sub<Rhs, Out>  ## `a - b` calls `a.sub(b)`.
  sub: (Rhs) -> Out

export interface Mul<Rhs, Out>  ## `a * b` calls `a.mul(b)`.
  mul: (Rhs) -> Out

export interface Div<Rhs, Out>  ## `a / b` calls `a.div(b)`.
  div: (Rhs) -> Out

export interface Rem<Rhs, Out>  ## `a % b` calls `a.rem(b)`.
  rem: (Rhs) -> Out

export interface BitAnd<Rhs, Out>  ## `a & b` calls `a.bit_and(b)`.
  bit_and: (Rhs) -> Out

export interface BitOr<Rhs, Out>  ## `a | b` calls `a.bit_or(b)`.
  bit_or: (Rhs) -> Out

export interface BitXor<Rhs, Out>  ## `a ^ b` calls `a.bit_xor(b)`.
  bit_xor: (Rhs) -> Out

export interface Shl<Rhs, Out>  ## `a << b` calls `a.shl(b)`.
  shl: (Rhs) -> Out

export interface Shr<Rhs, Out>  ## `a >> b` calls `a.shr(b)`.
  shr: (Rhs) -> Out

export interface Pow<Rhs, Out>  ## `a ** b` calls `a.pow(b)`.
  pow: (Rhs) -> Out

export interface Neg<Out>  ## `-a` calls `a.neg()`.
  neg: () -> Out

export interface BitNot<Out>  ## `~a` calls `a.bit_not()`.
  bit_not: () -> Out
