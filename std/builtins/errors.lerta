# The errors that `throw` takes, and those of the runtime (see docs/reference/errors.md).

# Stops the program at once, for a bug that no caller could handle (see docs/reference/errors.md).
export extern lerta_panic_string as panic: (String) -> never

# What `throw` takes, and `catch` takes back: a program declares its own types of errors.
export interface Error
  message: String

# The errors of the runtime, which docs/reference/errors.md lists with what throws each: every
# struct here that declares Error is one (see plan_runtime_errors), so that they stay in Error's
# module, and the order they are declared in is that of LertaErrorKind in runtime/lerta.h.
export struct IndexError: Error
export struct ArithmeticError: Error
export struct NilError: Error
export struct CastError: Error
export struct IterError: Error
export struct WeakError: Error
export struct IOError: Error
export struct ValueError: Error
export struct InitError: Error
export struct CancelledError: Error
# What a failed `assert` throws.
export struct AssertionError: Error
