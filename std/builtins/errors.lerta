# The errors that `throw` takes, and those of the runtime (see docs/reference/errors.md).

## Stops the program at once, for a bug that no caller could handle (see docs/reference/errors.md).
export extern lerta_panic_string as panic: (String) -> never

## Throws an AssertionError unless the condition holds (see docs/reference/errors.md#assert).
export intrinsic assert

## Writes where the call is, its code and the value's literal to stderr, and gives the value (see
## docs/reference/builtins.md#dbg).
export intrinsic dbg

## Writes the error's message, and its trace if the runtime keeps it, to stderr (see
## docs/reference/builtins.md#print_trace).
export intrinsic print_trace

## What `throw` takes, and `catch` takes back: a program declares its own types of errors.
export interface Error
  message: String

# The errors of the runtime, which docs/reference/errors.md lists with what throws each: every
# struct here that declares Error is one (see plan_runtime_errors), so that they stay in Error's
# module, and the order they are declared in is that of LertaErrorKind in runtime/lerta.h.
export struct IndexError: Error  ## A place in a sequence out of range, as an index.
export struct ArithmeticError: Error  ## Overflow, division by zero, or a Float that would be NaN.
export struct NilError: Error  ## `x!` of nil.
export struct CastError: Error  ## `x as T!` of a value of another type.
export struct IterError: Error  ## A second traversal of an Iter, or `next` past its end.
export struct WeakError: Error  ## A `weak` field of type `T!` whose object is gone.
export struct IOError: Error  ## A failed operation of the system: a file, a socket, a program.
export struct ValueError: Error  ## An argument of a value that a function does not take.
export struct InitError: Error  ## A top-level value used before it is initialized.
export struct CancelledError: Error  ## The `await` of a promise that is cancelled.

## What a failed `assert` throws.
export struct AssertionError: Error
