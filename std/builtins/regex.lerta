# Regular expressions of RE2's syntax, matched in time linear in the text (see
# docs/reference/types.md#regex).
import compile_pattern, Program from '../internal/regex_compile'
import flags_error, PatternError from '../internal/regex_syntax'
import Searcher from '../internal/regex_vm'
import lerta_string_slice, sequence_length from '../internal/utf8'

## A regular expression of RE2's syntax, matched in time linear in the text; throws a ValueError
## for an invalid pattern or flags.
export class Regex
  args
    pattern: String  ## The pattern as given.
    flags := ''  ## Letters of `i`, `m` and `s`, each once, as if `(?flags)` began the pattern.

    # The pattern compiled, which a literal's construction gives as the compiler compiled it (see
    # regex_of_literal).
    private program: Program = compiled(@pattern, @flags)

  # The searches share it, which reuses its threads from one to the next: each is done before
  # another can start, as none awaits or yields while it searches; `find_all` yields only between
  # its searches.
  private searcher := Searcher(@program)

  ## Whether it matches anywhere.
  test := (text: String) -> @searcher.find(text.binary, 0) != nil

  ## The leftmost match, or nil.
  find := (text: String) ->
    slots := @searcher.find(text.binary, 0) else return nil
    @match_of(text, slots)

  ## The matches that do not overlap, from the start.
  find_all := (text: String): Iter<Match> ->
    yield @match_of(text, slots) for slots in @all_slots(text)

  private
    # The slots of each match that does not overlap, from the start, which split and replace read
    # without making a Match. After an empty one, the next is looked for a code point on, as
    # JavaScript does; after another, at its end, where an empty one may follow.
    all_slots := (text: String): Iter<Int[]> ->
      bytes := text.binary
      var from = 0
      while from <= bytes.length
        slots := @searcher.find(bytes, from) else return
        yield slots
        (start, end) := (slots[0], slots[1])
        from = end
        if start == end
          from += end < bytes.length then sequence_length(bytes[end]) else 1

    match_of := (text: String, slots: Int[]) -> Match(slots, source: text, names: @program.names)

## A match of a Regex in a text.
# A match keeps its places, and its texts are sliced as they are read, so that one that is only
# counted slices nothing.
export class Match
  args
    private
      source: String
      slots: Int[]
      names: String?[]

  ## The text of the whole match.
  text := -> @group(0)!

  ## The text of each group, from the whole match, nil for a group that took no part.
  groups := -> [@group(i) for i in 0..@names.length]

  ## The text of the group at the index, from 0, the whole match, or nil if it took no part; an
  ## index the pattern has no group at throws an IndexError.
  group := (index: Int) ->
    start := @slots[2 * index]
    return nil if start < 0
    lerta_string_slice(@source, start, @slots[2 * index + 1])

  # The places of the match's bytes, from its start up to its end.
  private span := (@slots[0], @slots[1])

  ## The text before the match.
  before := -> lerta_string_slice(@source, 0, @slots[0])

  ## The text after the match.
  after := -> lerta_string_slice(@source, @slots[1], @source.binary.length)

  ## The text of the group of the name, or nil if it took no part; a name the pattern does not give
  ## throws a ValueError.
  named := (name: String) ->
    index := @names.find_index((n) -> n == name) else throw ValueError("no group named #{name}")
    @group(index)

# The Regex of a literal, of the program that the compiler compiled, which the code generated for it
# calls (see compiler/codegen/regex.lerta). `names` holds the name of each group, `''` for none, as
# the names are not empty, joined by `,`, which no name holds.
export regex_of_literal := (pattern: String, flags: String, code: Binary, names: String) ->
  group_names: String?[] = [
    for name in names.split(',')
      name.is_empty() then nil else name
  ]
  program := Program(code, group_count: group_names.length - 1, names: group_names)
  Regex(pattern, flags, program)

# The program of the pattern under the flags, or a ValueError that says why they are invalid and
# where.
compiled := (pattern: String, flags: String) ->
  if error := flags_error(flags)
    throw ValueError("invalid regular expression flags: #{error.message}")
  program := compile_pattern(pattern, flags)
  if program is PatternError
    at := "at column #{program.column}"
    throw ValueError("invalid regular expression #{at}: #{program.message}: #{pattern}")
  program

# The pieces of the text between the matches, for String's split. As in JavaScript, an empty match
# at the end of the text, or where the piece would start, at its start or right after a match,
# splits nothing off, so that a pattern that matches anywhere splits the code points apart.
export split_by_regex := (text: String, re: Regex) ->
  length := text.binary.length
  pieces: String[]
  var piece_start = 0
  for slots in re.all_slots(text)
    (start, end) := (slots[0], slots[1])
    continue if start == end and (start == piece_start or start == length)
    pieces.push lerta_string_slice(text, piece_start, start)
    piece_start = end
  pieces.push lerta_string_slice(text, piece_start, length)
  pieces

# The text with each match of the Regex replaced by `by`, for String's replace: no Match is made.
export replace_by_regex := (text: String, re: Regex, by: String) ->
  pieces: String[]
  var piece_start = 0
  for slots in re.all_slots(text)
    pieces.push lerta_string_slice(text, piece_start, slots[0])
    piece_start = slots[1]
  pieces.push lerta_string_slice(text, piece_start, text.binary.length)
  pieces.join(by)

# The text with each match replaced by what `by` gives for it, for String's replace: the matches of
# a Regex, or the occurrences of a String.
export replace_matches := (text: String, matches: Iter<Match>, by: (Match) -> String) ->
  pieces: String[]
  var piece_start = 0
  for found in matches
    (start, end) := found.span
    pieces.push lerta_string_slice(text, piece_start, start)
    pieces.push by(found)
    piece_start = end
  pieces.push lerta_string_slice(text, piece_start, text.binary.length)
  pieces.join()

# The occurrences of a part that is not empty in the text, from the start and without overlapping,
# each a Match of it alone.
export occurrences := (text: String, part: String): Iter<Match> ->
  var start = 0
  while found := text.binary.index_of(part.binary, start)
    start = found + part.binary.length
    yield Match(slots: [found, start], source: text, names: [nil])
