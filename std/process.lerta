# The running program: its arguments, how it ends, and the programs it runs (see runtime/process.c).

export extern lerta_exit as exit: (Int) -> never
extern lerta_run: (String, String[], Byte[]?) -> Promise<Int>
extern lerta_argv: () -> Binary[]
extern lerta_env: (String) -> Binary?
extern lerta_platform: () -> String
extern lerta_cpu_count: () -> Int

export const argv = [
  argument.text() ? throw ValueError(message: 'a command-line argument is not valid UTF-8')
  for argument in lerta_argv()
]

export const run = (command: String, args: String[], stdout: Byte[]? = nil) ->
  await lerta_run(command, args, stdout)

export const env = (name: String) ->
  const value = lerta_env(name)
  return nil if not value
  value.text() ? throw ValueError(message: "the environment variable #{name} is not valid UTF-8")

export const platform = lerta_platform()

export const cpu_count = lerta_cpu_count()

extern lerta_process_id: () -> Int
export const process_id = lerta_process_id()

export extern lerta_is_running as is_running: (Int) -> Bool
