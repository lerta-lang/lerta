# The running program: its arguments, and how it ends (see runtime/process.c).

export extern lerta_exit as exit: (Int) -> never
extern lerta_argv: () -> Array<Binary>

# The command-line arguments, without the program name.
export const argv = [
  argument.decode_utf8() ? throw 'a command-line argument is not valid UTF-8'
  for argument in lerta_argv()
]
