# The running program: its arguments, how it ends, and the programs it runs (see runtime/process.c).

import Pipe, Reader, Writer from 'std:io'
import ceil from 'std:math'
import close_handle, Handle, pointer_of, reader_of, write_handle from './internal/handle'
import platform from './internal/platform'

extern lerta_exit: (Int) -> never
extern lerta_pipe_new: (String) -> Int

# The command and its arguments, and the milliseconds that a stop waits before it kills; 0 if the
# program cannot start.
extern lerta_program_run: (String[], String?, Binary[]?, Int[], Int) -> Int

extern lerta_program_wait: (Int) -> Promise<Int>
extern lerta_program_stop: (Int) -> void
extern lerta_program_free: (Int) -> void
extern lerta_argv: () -> Binary[]
extern lerta_program_path: () -> Binary
extern lerta_executable: () -> Binary?

# Windows compares the names of variables without case.
extern lerta_same_env_name as same_env_name: (Binary, Binary) -> Bool

extern lerta_environ: (Binary[]) -> void
extern lerta_env: (String) -> Binary?
extern lerta_cpu_count: () -> Int
extern lerta_current_dir: () -> Binary?

NOT_UTF8 := 'a command-line argument is not valid UTF-8'

## The program's command-line arguments, its own name first.
export argv := [
  for argument in lerta_argv()
    argument.text() else throw ValueError(NOT_UTF8)
]

## Where a program's output or errors go, besides a Writer or a Pipe: dropped, or, for its errors
## alone, where its output goes, as `2>&1` does.
export enum Output
  DISCARD
  STDOUT

## How `run` runs a program: what it reads as its standard input, where its standard output and
## error go, a Writer that they are copied to as they come or an Output, its directory, the
## environment variables set and removed, and how long a cancel waits for it to end before it is
## killed.
export struct RunOptions
  stdin: Binary | Reader | Pipe?
  stdout: Output | Writer | Pipe?
  stderr: Output | Writer | Pipe?
  cwd: String?
  env := Map<String, String>()
  unset_env: String[] = []
  kill_after := 5.0

## How a program ended: its exit code, which a signal makes 128 plus its number, as shells do, and
## that signal.
export struct Exit
  code: Int
  signal: Int?

# The system reads a text only up to a NUL byte, so none that it is given may hold one.
holds_nul := (text: String) -> "\0" in text

## Ends the program with the code, which must be in 0 to 255; another throws a ValueError.
# POSIX systems keep only 8 bits of an exit code, so a code outside 0 to 255 would be misread.
export exit := (code: Int) ->
  throw ValueError('exit code out of range (0 to 255)') unless code in 0..=255
  lerta_exit code

## Runs the program of the command with the arguments, as the options say, and gives how it ended.
export run := (command: String, args: String..., options: RunOptions) ->
  check_options options
  { cwd, env, unset_env, kill_after } := options

  # A program cannot start with a text that holds a NUL byte, as it cannot without its command; a
  # name that holds one is no name, which check_options refuses.
  texts := [command, args..., cwd else '', env.values()...]
  throw IOError("cannot run: #{command}") if texts.any(holds_nul)

  changes_env := not env.is_empty() or not unset_env.is_empty()
  program_env := changes_env then env_with(env, unset_env)
  input := input_of(options.stdin, command)
  output := output_of(options.stdout, 'standard output', command)
  errors := output_of(options.stderr, 'standard error', command)
  streams :=
    stream_of(input.pipe, input.file)
    stream_of(output.pipe, output.file, options.stdout)
    stream_of(errors.pipe, errors.file, options.stderr)

  # Rounded up, so as not to kill early.
  kill_milliseconds := ceil(kill_after * 1000.0).to_int() else INT_MAX

  pointer := lerta_program_run([command, args...], cwd, program_env, streams, kill_milliseconds)
  throw IOError("cannot run: #{command}") if pointer == 0
  program := Program(pointer)
  give options.stdin, true
  give options.stdout, false
  give options.stderr, false
  copies := Copies(command)
  feeding := input.pipe then feed(input.pipe, input.source!, program, copies)
  outputting := output.pipe then copy_output(output.pipe, output.sink!, program, copies)
  erroring := errors.pipe then copy_output(errors.pipe, errors.sink!, program, copies)
  status :=
    try
      await lerta_program_wait(program.pointer)
    catch error: CancelledError
      await give_up(copies, feeding, outputting, erroring)
      await end_writers(output.sink, errors.sink, copies)
      throw error

  # What the program did not read is not wanted any more.
  await give_up(copies, feeding, nil, nil)

  # A stopped program's output is not wanted, and a program that it started may hold its pipes
  # open, so it is not waited for; an output read once the program has ended may still fail, and
  # stop it, which gives up the other output then, settled or not.
  if copies.stopped
    await give_up(copies, nil, outputting, erroring)
  await outputting if outputting and not copies.stopped
  await erroring if erroring and not copies.stopped
  if copies.stopped
    await give_up(copies, nil, outputting, erroring)

  await end_writers(output.sink, errors.sink, copies)
  throw error if error := copies.error
  return Exit(status) if status >= 0
  Exit(code: 128 - status, signal: -status)

# A program that runs, which runs on, if it has not ended, once nothing holds it.
class Program
  args
    private pointer: Int
  deinit := -> lerta_program_free(@pointer)

# How the copies of a program's streams went: the error that fails the run, of an output that could
# not be read, or of a Reader or a Writer that a copy read or wrote.
class Copies
  args
    # The program's command, which errors name.
    command: String
  private
    var error: Error?

    # Whether a copy that failed stopped the program.
    var stopped = false

    # Whether run has cancelled the copy of the input, and those of the outputs, which a
    # CancelledError of a Reader or a Writer is not.
    var input_given_up = false
    var outputs_given_up = false

  # The first error tells why the run fails; the later ones follow from it as often as not.
  fail := (error: Error) -> @error = @error else error

pipe_of := (stream: String, command: String) ->
  Handle(lerta_pipe_new("the #{stream} of #{command}"))

# The file of the end of a Pipe that the program takes, if the Pipe is a system pipe or becomes
# one; a Pipe that this program uses is read or written as its Reader or Writer instead.
file_of := (stream: Binary | Reader | Output | Writer | Pipe?, reading: Bool) ->
  stream is Pipe then stream.writer.file_for(reading)

# The program holds the end it has taken, which this program then closes.
give := (stream: Binary | Reader | Output | Writer | Pipe?, reading: Bool) ->
  stream.writer.give reading if stream is Pipe

# How the program takes its input: the `file` of a system pipe's end, or else a `pipe` that this
# program writes its `source` to, or neither, for this program's own input, which it shares.
input_of := (stdin: Binary | Reader | Pipe?, command: String) ->
  file := file_of(stdin, true)
  source :=
    if not file
      stdin is Pipe then stdin.reader else stdin
    else
      nil
  pipe := source != nil then pipe_of('standard input', command)
  { file, source, pipe }

# As input_of, for an output: the `file` of a system pipe's end, or else a `pipe` that this program
# reads into its `sink`, or neither, for this program's own output, which it shares.
output_of := (output: Output | Writer | Pipe?, stream: String, command: String) ->
  file := file_of(output, false)

  # Of the type written, so that a Pipe's writer counts as a Writer.
  sink: Writer? =
    case output
      when Pipe
        not file then output.writer
      when Output then nil
      else output
  pipe := sink != nil then pipe_of(stream, command)
  { file, sink, pipe }

# As lerta_program_run takes them: a file as -1 minus it, a pipe by its handle, DISCARDED or
# AS_STDOUT for those Outputs, the values of DISCARDED_STREAM and AS_STDOUT_STREAM in
# runtime/process.c, or 0 for the program's own stream, which the program shares. A handle is the
# address of an object, never 1 or 2.
stream_of := (pipe: Handle?, file: Int?, output: Output | Writer | Pipe? = nil) ->
  return -1 - file if file
  return DISCARDED if is_output(output, DISCARD)
  return AS_STDOUT if is_output(output, STDOUT)
  pipe then pointer_of(pipe) else 0

DISCARDED := 1
AS_STDOUT := 2

is_output := (stream: Output | Writer | Pipe?, output: Output) ->
  stream is Output and stream == output

# The bytes of each read that a Reader gives the program at most.
FEED_SIZE := 65536

# The input goes to the program as it reads it, and the pipe is closed after it, however it ends,
# which the program reads as the end: a pipe has no writing side to end apart, as a socket has. A
# program may end without reading all of it, which fails the write, and is no failure of the run.
# A Reader is closed then too, as nothing reads it any more.
feed := (pipe: Handle, input: Binary | Reader, program: Program, copies: Copies) ->
  try
    if input is Binary
      await written(pipe, input)
    else
      while chunk := await input.read(FEED_SIZE)
        break unless await written(pipe, chunk)
  catch error: CancelledError
    throw error if copies.input_given_up
    failed_copy copies, error, program
  catch error
    failed_copy copies, error, program
  finally
    close_handle pipe
    input.close() if input is Reader

written := (pipe: Handle, bytes: Binary) ->
  try
    await write_handle(pipe, bytes)
    true
  catch _: IOError
    false

# What the program writes to the stream goes to the Writer as it comes, which run ends (see
# end_writers).
copy_output := (pipe: Handle, writer: Writer, program: Program, copies: Copies) ->
  reader := reader_of(pipe)
  try
    await writer.write(chunk) while chunk := await next_chunk(reader, program, copies)
  catch error: CancelledError
    throw error if copies.outputs_given_up
    failed_copy copies, error, program
  catch error
    failed_copy copies, error, program

# A copy that fails stops the program, which would otherwise go on with an input that seems whole
# though it is cut short, or wait for ever once the pipe of an output that is read no more is full.
failed_copy := (copies: Copies, error: Error, program: Program) ->
  copies.fail error
  copies.stopped = true
  lerta_program_stop program.pointer

# The Writers are ended once both copies have ended, as one Writer may take both outputs, as `2>&1`
# does; it is then ended twice, which a Writer takes as once. A cancelled run waits for the ends
# too, so that the output is all written when it settles.
end_writers := (stdout: Writer?, stderr: Writer?, copies: Copies) ->
  await end_writer(stdout, copies) if stdout
  await end_writer(stderr, copies) if stderr

end_writer := (writer: Writer, copies: Copies) ->
  try
    await writer.end()
  catch error
    copies.fail error

# A read that fails is the end of the stream, and fails the run.
next_chunk := (reader: Reader, program: Program, copies: Copies) ->
  try
    await reader.read_chunk()
  catch _: IOError
    failed_copy copies, IOError("cannot read the output of: #{copies.command}"), program
    nil

# The copies that are not wanted any more are cancelled, and awaited, so that a Writer is ended
# before run settles: a cancelled copy stops reading, and ends at once with nothing to tell.
give_up := (copies: Copies, feeding: Promise?, outputting: Promise?, erroring: Promise?) ->
  copies.input_given_up = copies.input_given_up or feeding != nil
  copies.outputs_given_up = copies.outputs_given_up or outputting != nil or erroring != nil
  feeding?.cancel()
  outputting?.cancel()
  erroring?.cancel()
  await ended(feeding) if feeding
  await ended(outputting) if outputting
  await ended(erroring) if erroring

ended := <T>(copy: Promise<T>) ->
  try
    await copy
    return
  catch _: CancelledError
    return

# This program's variables, as NAME=VALUE, but those that `set` names, which it gives, or that
# `unset` names.
env_with := (set: Map<String, String>, unset: String[]) ->
  entries: Binary[]
  lerta_environ entries
  changed := [name.binary for name in [set.keys()..., unset...]]
  is_changed := (name: Binary) -> changed.any((each) -> same_env_name(each, name))
  env := [
    for entry in entries when not is_changed(env_name(entry))
      entry
  ]
  env.push b"#{name}=#{value}" for (name, value) in set
  env

# The name of a variable's NAME=VALUE, up to its first `=`. Windows names some of its own variables
# with a leading `=`, which no name given to run holds, so they are kept, as they should be.
env_name := (entry: Binary) ->
  end := entry.index_of(b'=') else entry.length
  entry[..end]

check_options := (options: RunOptions) ->
  throw ValueError('stdout cannot be Output.STDOUT') if is_output(options.stdout, STDOUT)
  throw ValueError('kill a program after a negative time') if options.kill_after < 0
  set_names := options.env.keys().to_array()
  for name in set_names + options.unset_env
    if name.is_empty() or '=' in name or holds_nul(name)
      throw ValueError("not a name of an environment variable: '#{name}'")
  for name at i in set_names
    if set_names.find_index((each) -> same_env_name(each.binary, name.binary))! < i
      throw ValueError("the environment variable #{name} is set twice")
  for name in options.unset_env
    if set_names.any((each) -> same_env_name(each.binary, name.binary))
      throw ValueError("the environment variable #{name} is both set and removed")

## The value of the environment variable of the name, or nil.
# No variable's name holds `=`, which the system would take as the end of the name, nor a NUL byte.
export env := (name: String) ->
  return nil if '=' in name or holds_nul(name)
  value := lerta_env(name) else return nil
  value.text() else throw ValueError("the environment variable #{name} is not valid UTF-8")

export Platform, platform from './internal/platform'

## Whether the program is built optimized, as by -O, which the compiler gives.
export intrinsic optimized: Bool

## The last name of the path that the program was started by, as a usage message names it: without
## `.exe` on Windows, where `\` separates names too.
export program := program_name(lerta_program_path().text() else throw ValueError(NOT_UTF8))

## The absolute path of the program's executable file, as the system tells it, through which the
## program may run itself again.
export executable := ->
  lerta_executable()?.text() else throw IOError('cannot read the path of the program')

program_name := (path: String) ->
  return path.split('/').last()! unless platform == 'windows'
  name := path.replace('\', '/').split('/').last()!

  # Windows takes the extension in any case, as `TOOL.EXE`.
  return name unless name.to_lower().ends_with('.exe')
  bytes := name.binary
  bytes.text(0, bytes.length - b'.exe'.length)!

## The number of the system's CPUs.
export cpu_count := lerta_cpu_count()

extern lerta_process_id: () -> Int

## The program's own process ID.
export process_id := lerta_process_id()

extern lerta_is_running: (Int) -> Bool

## Whether a process of the ID is running.
# The ID is checked first, since the system takes 0 and the negative IDs for groups of processes.
export is_running := (id: Int) -> id > 0 and id <= MAX_PROCESS_ID and lerta_is_running(id)

MAX_PROCESS_ID := 2147483647

## The absolute path of the current directory, which the paths of the program start from.
export cwd := ->
  failure := 'cannot read the current directory'
  path := lerta_current_dir() else throw IOError(failure)
  path.text() else throw IOError("#{failure}, as its path is not valid UTF-8")
