# An HTTP/1.1 server and client over std:net, whose handler takes a Request and gives a Response, as
# fetch does.

import Signal, spawn from 'std:async'
import Reader from 'std:io'
import Listener, listen_tcp, Socket from 'std:net'
import address_text from './internal/handle'
import Deadline from './internal/deadline'
import CHUNK_SIZE from './internal/http_chunks'
import Request, Response from './internal/http_message'
import
  Incoming, read_rest_of_request, read_request_line, RequestError, ServerOptions
from './internal/http_request'
import has_body, response_bytes, write_body from './internal/http_response'

export Body, Headers, Request, Response from './internal/http_message'
export ServerOptions from './internal/http_request'
export Client, fetch, FetchOptions from './internal/http_client'

## A server that `serve` started, listening at `port`.
export class Server
  args
    listener: Listener
    handler: (Request) -> Promise<Response>
    options: ServerOptions

    # Where it listens, as the host of the URL of a request that names none.
    address: String
  port := @listener.port
  private
    var closed = false

    # The connections that wait for their next request, before the whole of its request line has
    # come.
    waiting := Set<Socket>()

    # The connections that read and drop what the client still sends, before they close.
    lingering := Set<Socket>()

    # The connections that have not ended.
    var connections = 0

    # Resolved once the server is closed and no connection is left, which close waits for.
    ended := Signal()

  ## Stops listening, and closes the connections that wait for their next request or linger after
  ## their last, even if what a lingering one leaves unread resets it. Those being served go on to
  ## their response, and end then, lingering as ever. Resolves once every connection has ended.
  close := ->
    @closed = true
    @listener.close()
    socket.close() for socket in @waiting
    socket.close() for socket in @lingering
    @end_if_done()
    await @ended.promise()

  private end_if_done := -> @ended.resolve() if @closed and @connections == 0

## Listens at once, and serves each connection until the server is closed.
export serve := (handler: (Request) -> Promise<Response>, options: ServerOptions) ->
  check_options options
  { host } := options
  listener := listen_tcp(host, options.port)
  address := address_text(host, listener.port)
  server := Server(listener, handler, options, address)
  spawn accept_all(server)
  server

check_options := (options: ServerOptions) ->
  limits :=
    ('max_line', options.max_line)
    ('max_fields', options.max_fields)
    ('max_body', options.max_body)
  for (name, limit) in limits
    throw ValueError("a negative #{name}: #{limit}") if limit < 0
  timeouts :=
    ('idle_timeout', options.idle_timeout)
    ('head_timeout', options.head_timeout)
    ('body_timeout', options.body_timeout)
  for (name, seconds) in timeouts
    throw ValueError("a negative #{name}: #{seconds}") if seconds < 0.0

accept_all := (server: Server) ->
  while true
    socket :=
      try
        await server.listener.accept()
      catch error: IOError
        return if server.closed
        throw error

    # Taken as the server was closed: close may have found no connection left and resolved already,
    # so it is closed rather than served, which would count it only after that.
    if server.closed
      socket.close()
      return
    spawn serve_connection(socket, server)

serve_connection := (socket: Socket, server: Server) ->
  server.connections += 1
  deadline := Deadline()
  spawn deadline.watch()
  try
    var going_on = true
    while going_on
      going_on = await serve_request(socket, server, deadline)
  catch _
    # The peer has gone, or sent less than it said, or a read that the handler left going on has
    # left the connection in no state to go on: it ends, and the server serves the others.
    nil
  finally
    # close_lingering throws nothing, and the sleep of the deadline would otherwise keep the
    # program going.
    await close_lingering(socket, server, deadline)
    deadline.stop()
    server.connections -= 1
    server.end_if_done()

# Closes the connection once the client has read the response: what the client still sends, as a
# body that the server did not read, is read and dropped first, for a time and a size, as a socket
# closed with input unread may be reset, which can lose the response before the client reads it.
# A server that is closed while it lingers closes it at once.
close_lingering := (socket: Socket, server: Server, deadline: Deadline) ->
  server.lingering.add socket
  try
    await socket.end()
    await deadline.within(drain(socket.reader), LINGER_SECONDS)
  catch _
    # A peer that has gone, or keeps sending: it is closed anyway.
    nil
  finally
    server.lingering.remove socket
    socket.close()

drain := (reader: Reader) ->
  var left = LINGER_BYTES
  while left > 0
    chunk := await reader.read(min(left, CHUNK_SIZE)) else return
    left -= chunk.length

LINGER_SECONDS := 2.0
LINGER_BYTES := 65536

# Serves the next request on the connection, and tells whether the connection goes on.
serve_request := (socket: Socket, server: Server, deadline: Deadline) ->
  incoming :=
    try
      await read_request(socket, server, deadline) else return false
    catch error: RequestError
      await socket.write(own_response(error.status, { method: 'GET', chunked: true }))
      return false
    catch _: ValueError
      # A line that is not UTF-8, or a header that Headers does not take.
      await socket.write(own_response(400, { method: 'GET', chunked: true }))
      return false
  await respond(socket, server, incoming)

# Writes the handler's response to the request, and tells whether the connection goes on. A body
# that is a Reader is closed once sent, or once it is not to be.
respond := (socket: Socket, server: Server, incoming: Incoming) ->
  { request, chunked } := incoming
  { method } := request
  failed := -> await socket.write(own_response(500, { method, chunked }))
  response :=
    try
      await server.handler(request)
    catch _
      await failed()
      return false
  { body } := response
  sends_reader := body is Reader and has_body(response.status, method)

  # A body sent as it comes may read the request's body once the head has gone, too late for 100
  # Continue, which goes before the head then.
  await incoming.body.send_continue() if sends_reader

  # A body whose read has failed cannot be read past to the next request, nor can one that the
  # client holds back until 100 Continue, which it was not sent; and one sent as it comes to
  # HTTP/1.0 ends with the connection.
  # A closed server ends the connection, rather than wait for the next request.
  goes_on := incoming.keep_alive and not server.closed
  body_left := incoming.body.failure == nil and incoming.body.continue_on == nil
  keep_alive := goes_on and body_left and (chunked or not sends_reader)

  try
    bytes :=
      try
        response_bytes response, { keep_alive, method, chunked }
      catch _
        await failed()
        return false
    await socket.write(bytes)
    if body is Reader and sends_reader
      await write_body(socket, body, chunked)
  finally
    body.close() if body is Reader
  return false unless keep_alive
  await incoming.body.skip()
  true

# The bytes of a response that the server gives itself, after which the connection ends. Its body is
# empty, which is right for HEAD too.
own_response := (status: Int, framing: { method: String, chunked: Bool }) ->
  { method, chunked } := framing
  response_bytes({ status }, { method, chunked, keep_alive: false })

# The next request, or nil if the connection ends, or stays idle, before it starts. A server that
# is closed meanwhile closes the connection, which the read throws for.
read_request := (socket: Socket, server: Server, deadline: Deadline) ->
  { reader } := socket
  options := server.options
  server.waiting.add socket

  # A connection that the server took before it was closed.
  socket.close() if server.closed

  line :=
    try
      await read_request_line(reader, options, deadline) else return nil
    finally
      server.waiting.remove socket
  await read_rest_of_request(line, socket, options, server.address, deadline)
