# Files, and the standard output and error streams (see runtime/file.c and runtime/io.c).

export extern lerta_read_file as read_file: (String) -> Binary
export extern lerta_write_file as write_file: (String, Binary) -> void

# A String and a Binary are written alike: both are bytes.
extern lerta_writer_write as write_text: (Int, String) -> void
extern lerta_writer_write as write_bytes: (Int, Binary) -> void
extern lerta_writer_flush as flush_writer: (Int) -> void

# A stream, by its file descriptor. stdout is buffered, and flushed at exit; stderr is not
# buffered, and writing to it flushes stdout first, so that the two keep their order.
export struct Writer
  fd: Int
  write = (s: String) -> write_text(@fd, s)
  write_binary = (b: Binary) -> write_bytes(@fd, b)
  flush = -> flush_writer(@fd)

export const stdout = Writer(fd: 1)
export const stderr = Writer(fd: 2)
