# Files, and the standard output and error streams (see runtime/file.c, io.c, output.c and stdin.c).

import Deferred from 'std:async'
import bytes_of from './internal/utf8'

extern lerta_read_file_async: (String) -> Promise<Binary>
extern lerta_write_file_async: (String, Binary) -> Promise
extern lerta_is_file: (String) -> Bool
extern lerta_is_dir: (String) -> Bool
extern lerta_real_path: (String) -> Binary
export extern lerta_make_temp_dir as make_temp_dir: () -> Binary
extern lerta_remove_tree_async: (String) -> Promise
extern lerta_make_dir: (String) -> void
extern lerta_rename: (String, String) -> void
extern lerta_make_link: (String, String) -> void
extern lerta_copy_file_async: (String, String) -> Promise
extern lerta_stat_fields: (String, Int[]) -> Bool
extern lerta_open_for_writing: (String) -> Int
extern lerta_open_file_check: (Int) -> void
extern lerta_open_file_write: (Int, Binary) -> Promise
extern lerta_open_file_end: (Int, Binary) -> void
extern lerta_open_file_free: (Int, Binary) -> void

# A path that holds a NUL byte names nothing, as the system reads a path only up to its first; the
# runtime takes none.
names_nothing := (path: String) -> path.contains("\0")

# Fails as the operation `failure` does on a path that names nothing, if one of `paths` does,
# reported by the first.
require_names := (failure: String, paths: String...) ->
  throw IOError(message: "#{failure}#{paths[0]}") if paths.any(names_nothing)

export read_file := (path: String) ->
  require_names 'cannot read file: ', path
  await lerta_read_file_async(path)

# The contents of a file as text, or nil if they are not valid UTF-8.
export read_text := (path: String) -> (await read_file(path)).text()

export write_file := (path: String, data: Binary) ->
  require_names 'cannot write file: ', path
  await lerta_write_file_async(path, data)

# How open opens a file: so far only for writing, emptied or made.
export enum OpenMode
  WRITE

# A file that open has opened (see docs/reference/std.md#stdio), closed once nothing holds it.
export struct File
  writer: FileWriter

# Opening is one system call, so it does not await (see docs/roadmap/runtime.md#concurrency).
export open := (path: String, mode: OpenMode) ->
  require_names 'cannot open file: ', path
  case mode
    when WRITE then File(writer: FileWriter(pointer: lerta_open_for_writing(path)))

# As much as stdout's buffer holds before a write waits (see runtime/output.c).
FILE_BUFFER_SIZE := 65536

# A file's Writer, which gathers what is written and writes it out on the event loop once it holds
# FILE_BUFFER_SIZE bytes, or when flushed. Its end writes out the rest on the event loop and closes
# the file after; what is left when it is freed, it writes out at once. A write out that fails fails
# every later write and flush (see lerta_open_file_check).
class FileWriter
  pointer: Int
  var buffer = ''.binary
  ended = false
  # The write out on the event loop, one at a time, which a flush waits for before its own.
  writing: Promise? = nil

  write = (data: String | Binary) ->
    @check_open()
    @buffer += bytes_of(data)
    await @flush() if @buffer.length >= FILE_BUFFER_SIZE

  end = ->
    return if @ended
    @ended = true
    lerta_open_file_end @pointer, @buffer
    @buffer = ''.binary

  # Resolves once all that was written before it is in the file.
  flush = ->
    @check_open()
    while true
      if writing := @writing
        await writing
        continue
      lerta_open_file_check @pointer
      return if @buffer.is_empty()
      bytes := @buffer
      @buffer = ''.binary
      @writing = lerta_open_file_write(@pointer, bytes)
      try
        await @writing!
      finally
        @writing = nil

  check_open = ->
    throw IOError(message: 'cannot write to a file that has ended') if @ended
    lerta_open_file_check @pointer

  deinit = -> lerta_open_file_free(@pointer, @buffer)

export is_file := (path: String) -> not names_nothing(path) and lerta_is_file(path)

export is_dir := (path: String) -> not names_nothing(path) and lerta_is_dir(path)

export real_path := (path: String) ->
  require_names 'cannot resolve path: ', path
  lerta_real_path path

export remove_tree := (path: String) ->
  require_names 'cannot remove: ', path
  await lerta_remove_tree_async(path)

# An empty path names no directory.
export make_dir := (path: String) ->
  require_names 'cannot make directory: ', path
  throw IOError(message: 'cannot make directory: ') if path.is_empty()
  lerta_make_dir path

export rename := (from: String, to: String) ->
  require_names 'cannot rename: ', from, to
  lerta_rename from, to

export make_link := (target: String, path: String) ->
  require_names 'cannot make link: ', path, target
  lerta_make_link target, path

export copy_file := (from: String, to: String) ->
  require_names 'cannot copy file: ', from, to
  await lerta_copy_file_async(from, to)

export enum FileKind
  FILE
  DIR
  OTHER

# What a path names: its kind, its size in bytes, and when it was last modified, in seconds since
# the Unix epoch, as `time` of std:time tells them.
export struct FileStatus
  kind: FileKind
  size: Int
  modified_time: Float

# The status of what the path names, through symbolic links, or nil if nothing is there.
export stat := (path: String) ->
  fields: Int[]
  return nil if names_nothing(path) or not lerta_stat_fields(path, fields)
  # In the order of the kinds that the runtime gives.
  kinds := [FileKind.FILE, DIR, OTHER]
  modified_time := fields[2].to_float() / 1000000000.0
  FileStatus modified_time, kind: kinds[fields[0]], size: fields[1]

extern lerta_stream_write: (Int, Binary) -> Promise
extern lerta_stream_flush: (Int) -> Promise

# What data is written to, as a stream: `end` closes it, which its reader reads as its end.
export interface Writer
  write: (String | Binary) -> Promise
  end: () -> void

# stdout or stderr, by its file descriptor (for buffering, see docs/reference/std.md#stdio).
# An end leaves the descriptor open, as one that a later file opened would take its number.
class StandardOutput
  fd: Int
  name: String
  ended = false

  write = (data: String | Binary) ->
    throw IOError(message: "cannot write to #{@name}") if @ended
    await lerta_stream_write(@fd, bytes_of(data))

  end = -> @ended = true

  flush = -> await lerta_stream_flush(@fd)

export stdout := StandardOutput(fd: 1, name: 'stdout')
export stderr := StandardOutput(fd: 2, name: 'stderr')

# A Reader that reads what its Writer writes: a write is resolved once the reader has taken its
# chunk, and the reader reads nil once the writer has ended and all has been taken, or throws the
# error that the writer has failed with. Once the reader is closed, the writes fail, as those to a
# system pipe whose reader has gone do. A Pipe that run of std:process is given before anything has
# used it becomes a system pipe that its programs share (see SystemPipe).
export class Pipe
  writer = PipeWriter()
  reader = reader_of_pipe(@writer)

reader_of_pipe := (writer: PipeWriter) ->
  Reader read_chunk: -> await writer.take(), on_close: -> writer.unread()

class PipeWriter
  # Once set, the Pipe is a system pipe, and the rest is not used.
  system: SystemPipe? = nil
  used = false
  queued: PipeChunk[] = []
  ended = false
  # What the reader throws in place of its end.
  failure: Error? = nil
  read_no_more = false
  # The takes that wait while nothing is queued, each on its own, so that a cancel of one leaves
  # the others waiting.
  arrivals: Deferred<Bool>[] = []

  # An empty chunk is not queued, as the reader would take it for the end.
  write = (data: String | Binary) ->
    bytes := bytes_of(data)
    return await system.write(bytes) if system := @system
    @used = true
    throw ended_pipe() if @ended
    throw closed_pipe() if @read_no_more
    return if bytes.is_empty()
    chunk := PipeChunk(bytes)
    @queued.push chunk
    @wake()
    try
      await chunk.taken.promise()
      return
    catch error: CancelledError
      # A write that is cancelled writes nothing, if it has not been taken.
      @queued = [each for each in @queued when each != chunk]
      throw error

  end = ->
    @ended = true
    return system.end() if system := @system
    @used = true
    @wake()

  fail = (error: Error) ->
    return if @ended or not @writes_here()
    @failure = error
    @end()

  # On a system pipe, an end that a program has taken is ended as far as this program goes.
  writes_here = -> @system?.holds(WRITING) ? true

  # The chunks left are not read, and their writes fail.
  unread = ->
    return system.close(READING) if system := @system
    @used = true
    @read_no_more = true
    chunks := @queued
    @queued = []
    chunk.taken.reject closed_pipe() for chunk in chunks
    @wake()

  take = ->
    if system := @system
      chunk := await system.read()
      failure := @failure
      throw failure if chunk == nil and failure != nil
      return chunk
    @used = true
    while @queued.is_empty()
      return nil if @read_no_more
      if @ended
        throw failure if failure := @failure
        return nil
      arrival := Deferred<Bool>()
      @arrivals.push arrival
      try
        await arrival.promise()
      catch error: CancelledError
        @arrivals = [each for each in @arrivals when each != arrival]
        throw error
    first := @queued[0]
    @queued = @queued.slice(1)
    first.taken.resolve true
    first.bytes

  # Every take that waits looks again, as it may find the queue empty again once another has taken.
  wake = ->
    arrivals := @arrivals
    @arrivals = []
    arrival.resolve true for arrival in arrivals

  # The file of an end for a program to take, which makes the Pipe a system pipe if nothing has
  # used it yet; nil once this program uses the Pipe, or that end, or has given it.
  file_for = (reading: Bool) ->
    @system = SystemPipe() if not @used and not @system
    @system?.file_for(side_of(reading))

  # Closes the end that a program has started with, which the program holds now.
  give = (reading: Bool) -> @system?.give(side_of(reading))

ended_pipe := -> IOError(message: 'cannot write to a pipe that has ended')

closed_pipe := -> IOError(message: 'cannot write to a pipe whose reader has closed')

READING := 0
WRITING := 1

side_of := (reading: Bool) -> reading then READING else WRITING

extern lerta_system_pipe: (Int[]) -> void
extern lerta_file_close: (Int) -> void
extern lerta_pipe_of_file: (String, Int) -> Int
extern lerta_handle_read as read_pipe: (Int) -> Promise<Binary?>
extern lerta_handle_write as write_pipe: (Int, Binary) -> Promise
extern lerta_handle_free as free_pipe: (Int) -> void

# A pipe of the system, whose data does not go through this program: each end, READING or WRITING,
# is a file until a program takes it, which closes it here, so that the program that reads reads
# the end once the program that writes has ended, and the program that writes fails once the one
# that reads has; or until this program reads or writes it, through a handle of its own (see
# runtime/handle.c), which a program then does not take: the handle makes the file non-blocking on
# POSIX systems, which a program that inherited it would not expect.
class SystemPipe
  files = system_pipe_files()
  # The handles that this program reads or writes the ends through: 0 before the first use, and -1
  # once closed.
  handles = [0, 0]
  # The writes that the system has not taken yet, which an end lets finish before it closes the end
  # that writes, as a Writer's end follows the writes before it.
  writes = 0
  ending = false
  # The read under way, as the handle takes one at a time, and the reads that wait for it.
  reading = false
  turns: Deferred<Bool>[] = []

  deinit = ->
    for file in @files
      lerta_file_close file if file >= 0
    for handle in @handles
      free_pipe handle if handle > 0

  file_for = (side: Int) -> @files[side] >= 0 then @files[side]

  holds = (side: Int) -> @files[side] >= 0 or @handles[side] > 0

  give = (side: Int) ->
    return if @files[side] < 0
    lerta_file_close @files[side]
    @files[side] = -1

  write = (bytes: Binary) ->
    throw ended_pipe() if @ending
    handle := @handle(WRITING) ? throw ended_pipe()
    @writes += 1
    try
      await write_pipe(handle, bytes)
    finally
      @writes -= 1
      @close WRITING if @ending and @writes == 0

  read = ->
    while @reading
      turn := Deferred<Bool>()
      @turns.push turn
      try
        await turn.promise()
      catch error: CancelledError
        @turns = [each for each in @turns when each != turn]
        throw error
    handle := @handle(READING) ? return nil
    @reading = true
    try
      await read_pipe(handle)
    catch error: IOError
      # The close of this program's end fails the read under way, which reads nil then, as those
      # that wait do.
      return nil if @handles[READING] < 0
      throw error
    finally
      @reading = false
      turns := @turns
      @turns = []
      turn.resolve true for turn in turns

  # The end that writes is closed once the writes under way have finished.
  end = ->
    @ending = true
    @close WRITING if @writes == 0

  # An end that this program closes is gone, as one that a program has taken is.
  close = (side: Int) ->
    @give side
    return if @handles[side] <= 0
    free_pipe @handles[side]
    @handles[side] = -1

  # The handle of an end, opened at its first use, or nil once it is gone.
  handle = (side: Int) ->
    if @handles[side] == 0 and @files[side] >= 0
      @handles[side] = lerta_pipe_of_file('a pipe', @files[side])
      @files[side] = -1
    @handles[side] > 0 then @handles[side]

system_pipe_files := ->
  files: Int[]
  lerta_system_pipe files
  files

class PipeChunk
  bytes: Binary
  taken = Deferred<Bool>()

extern lerta_list_dir_names: (String) -> Binary[]

# An empty path is refused, as Windows would read `\*` in it as the root of the drive.
export list_dir := (path: String) ->
  require_names 'cannot list directory: ', path
  throw IOError(message: 'cannot list directory: ') if path.is_empty()
  names := [
    name.text() ? throw ValueError(message: "a name is not valid UTF-8 in the directory: #{path}")
    for name in lerta_list_dir_names(path)
  ]
  names.sorted (a, b) -> a.compare(b)

extern lerta_stdin_read: () -> Promise<Binary?>

# A line with more bytes before its "\n" than a read of it takes.
export struct LineTooLongError: Error

# A stream read in chunks through a buffer: `read_chunk` gives the next chunk, or nil at the end. A
# read must end before the next one starts: one that starts while another is pending throws.
# `on_close` tells the source that nothing reads it any more, as a pipe's writer is told.
export class Reader
  read_chunk: () -> Promise<Binary?>
  on_close: (() -> void)?
  chunk = ''.binary
  start = 0
  reading = false
  # What the read under way has sliced out of the chunks it went past, kept here rather than in
  # it, so that a read that throws or is cancelled leaves it for the next.
  taken = ''.binary

  # The next line, without its "\n" and a "\r" before it, or nil at the end. A LineTooLongError
  # if more than `max` bytes, a "\r" among them, come before its "\n", which leaves them unread.
  read_line = (max: Int = INT_MAX) ->
    throw ValueError(message: "read a line of a negative count of bytes: #{max}") if max < 0
    await @exclusive(-> await @line(max))

  # The bytes there are to read, at most `max`, waiting for some only if there are none; nil at the
  # end.
  read = (max: Int) ->
    throw ValueError(message: "read a count of bytes below 1: #{max}") if max < 1
    await @exclusive(-> await @some(max))

  # `count` bytes, or nil at the end. An IOError if the end comes after some of them.
  read_exactly = (count: Int) ->
    throw ValueError(message: "read a count of bytes below 1: #{count}") if count < 1
    await @exclusive(->
      bytes := await @part(count) ? return nil
      # Chunks that were empty, before the end.
      return nil if bytes.is_empty()
      if bytes.length < count
        # Left for the next read, as a read that throws leaves what it has taken.
        @taken = bytes
        throw IOError(message: "the end came after #{bytes.length} of #{count} bytes")
      bytes
    )

  # All that is left.
  read_all = -> await @exclusive(-> await @rest())

  close = -> on_close() if on_close := @on_close

  exclusive = <T>(read: () -> Promise<T>): Promise<T> ->
    throw ValueError(message: 'a Reader is read by another read that has not ended') if @reading
    @reading = true
    @put_back_taken()
    try
      await read()
    finally
      @reading = false

  # Whether a chunk is there to read, read in place of the one read up if needed.
  fill = ->
    return true if @start < @chunk.length
    next := await @read_chunk() ? return false
    @chunk = next
    @start = 0
    true

  # What a cancelled read took goes back before the rest of the chunk.
  put_back_taken = ->
    return if @taken.is_empty()
    @taken += @chunk[@start...@chunk.length]
    @chunk = @taken_out()
    @start = 0

  taken_out = ->
    bytes := @taken
    @taken = ''.binary
    bytes

  line = (max: Int) ->
    while await @fill()
      end := @chunk.index_of("\n".binary, @start) ? @chunk.length
      @taken += @chunk[@start...end]
      @start = end
      throw LineTooLongError(message: "a line is longer than #{max} bytes") if @taken.length > max
      if end < @chunk.length
        @start = end + 1
        return ended_line_text(@taken_out())
    return nil if @taken.is_empty()
    utf8_line @taken_out()

  some = (max: Int) ->
    while await @fill()
      bytes := @take(max)
      # A chunk may be empty.
      return bytes if not bytes.is_empty()
    nil

  part = (count: Int) ->
    return nil if not await @fill()
    @taken += @take(count)
    @taken += @take(count - @taken.length) while @taken.length < count and await @fill()
    @taken_out()

  # Up to `count` bytes of the chunk, from where it is read.
  take = (count: Int) ->
    end := @start + min(count, @chunk.length - @start)
    bytes := @chunk[@start...end]
    @start = end
    bytes

  # All that is left: a part of INT_MAX bytes, as many as a read can ask for, reads to the end.
  rest = -> await @part(INT_MAX) ? ''.binary

# A line that ended with "\n", without a "\r" before it.
ended_line_text := (bytes: Binary) ->
  ends_with_return := not bytes.is_empty() and bytes[bytes.length - 1] == "\r"
  utf8_line ends_with_return then bytes[0...(bytes.length - 1)] else bytes

utf8_line := (bytes: Binary) ->
  bytes.text() ? throw ValueError(message: 'a line is not valid UTF-8')

export stdin := Reader(read_chunk: -> lerta_stdin_read())
