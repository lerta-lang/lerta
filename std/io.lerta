# Files, and the standard output and error streams (see runtime/file.c, io.c and output.c).

export extern lerta_read_file_async as read_file: (String) -> Promise<Binary>
export extern lerta_write_file_async as write_file: (String, Binary) -> Promise
export extern lerta_is_file as is_file: (String) -> Bool
export extern lerta_is_dir as is_dir: (String) -> Bool
export extern lerta_real_path as real_path: (String) -> Binary
export extern lerta_make_temp_dir as make_temp_dir: () -> Binary
export extern lerta_remove_tree_async as remove_tree: (String) -> Promise
export extern lerta_make_dir as make_dir: (String) -> void
export extern lerta_rename as rename: (String, String) -> void

extern lerta_stream_write: (Int, Binary) -> Promise
extern lerta_stream_flush: (Int) -> Promise

# A stream, by its file descriptor (for buffering, see docs/reference/modules.md#stdio).
export struct Writer
  fd: Int
  write = (s: String) -> @write_binary(s.binary)
  write_binary = (b: Binary) -> lerta_stream_write(@fd, b)
  flush = -> lerta_stream_flush(@fd)

export const stdout = Writer(fd: 1)
export const stderr = Writer(fd: 2)

extern lerta_list_dir_names: (String) -> Binary[]

export const list_dir = (path: String) ->
  const names = [
    name.text() ? throw ValueError(message: "a name is not valid UTF-8 in the directory: #{path}")
    for name in lerta_list_dir_names(path)
  ]
  names.sorted (a, b) -> a.compare(b)

extern lerta_stdin_read: () -> Promise<Binary?>

# As many bytes as a read can ask for, which reads all that is left.
const MAX_INT = 9223372036854775807

# A stream read in chunks through a buffer: `read_chunk` gives the next chunk, or nil at the end. A
# read must end before the next one starts: one that starts while another is pending throws.
export class Reader
  read_chunk: () -> Promise<Binary?>
  chunk = ''.binary
  start = 0
  reading = false

  # The next line, without its "\n" and a "\r" before it, or nil at the end.
  read_line = -> await @exclusive(-> await @line())

  # `count` bytes, or as many as are left if the end comes first, or nil at the end.
  read = (count: Int) ->
    throw ValueError(message: "read a count of bytes below 1: #{count}") if count < 1
    await @exclusive(-> await @part(count))

  # All that is left.
  read_all = -> await @exclusive(-> await @rest())

  exclusive = <T>(read: () -> Promise<T>): Promise<T> ->
    throw ValueError(message: 'a Reader is read by another read that has not ended') if @reading
    @reading = true
    try
      await read()
    finally
      @reading = false

  # Whether a chunk is there to read, read in place of the one read up if needed.
  fill = ->
    return true if @start < @chunk.length
    const next = await @read_chunk() ? return false
    @chunk = next
    @start = 0
    true

  # A line within one chunk is sliced out of it; one that crosses chunks is gathered byte by byte,
  # as a Binary cannot be joined to another.
  line = ->
    const crossed: Byte[] = []
    while await @fill()
      var end = @start
      end += 1 while end < @chunk.length and @chunk[end] != "\n"
      if end < @chunk.length
        const piece = @chunk.slice(@start, end)
        @start = end + 1
        return ended_line_text(piece) if crossed.length == 0
        crossed.push byte for byte in piece
        return ended_line_text(crossed.to_binary())
      crossed.push @chunk[i] for i in @start...@chunk.length
      @start = @chunk.length
    return nil if crossed.length == 0
    utf8_line crossed.to_binary()

  # Bytes within one chunk are sliced out of it; those that cross chunks are gathered byte by byte,
  # as a Binary cannot be joined to another.
  part = (count: Int) ->
    return nil if not await @fill()
    const first = @take(count)
    return first if first.length == count
    const bytes = [byte for byte in first]
    while bytes.length < count and await @fill()
      bytes.push byte for byte in @take(count - bytes.length)
    bytes.to_binary()

  # Up to `count` bytes of the chunk, from where it is read.
  take = (count: Int) ->
    const end = @start + min(count, @chunk.length - @start)
    const bytes = @chunk.slice(@start, end)
    @start = end
    bytes

  rest = -> await @part(MAX_INT) ? ''.binary

# A line that ended with "\n", without a "\r" before it.
const ended_line_text = (bytes: Binary) ->
  const ends_with_return = bytes.length > 0 and bytes[bytes.length - 1] == "\r"
  utf8_line ends_with_return then bytes.slice(0, bytes.length - 1) else bytes

const utf8_line = (bytes: Binary) ->
  bytes.text() ? throw ValueError(message: 'a line is not valid UTF-8')

export const stdin = Reader(read_chunk: -> lerta_stdin_read())
