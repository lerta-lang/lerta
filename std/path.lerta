# File paths, as Strings, worked out as text, as those of Node's `path` module are, written with `/`
# as the separator (see docs/reference/std.md#stdpath). On Windows, `\` separates them too, and an
# absolute path starts at a drive or a network share. A path relative to the current directory of a
# drive, `C:a`, is not supported. Names compare as written, also on Windows, where the system takes
# them without case: real paths, which `relative` takes in the compiler, write a name alike.

import cwd, platform from './process'

is_windows := platform == 'windows'

# A path as the root it starts at, and the names below it, without empty ones. The root is `` for
# a relative path, `/`, or on Windows a drive, `C:/`, in upper case as drives are named in either,
# or a network share, `//server/share/`, as written, which a real path writes alike. Two
# separators before a single name start no share, so that `/` is their root.
struct SplitPath
  root: String
  names: String[]

split_path := (path: String): SplitPath ->
  slashed :=
    if is_windows
      path.replace '\', '/'
    else
      path
  bytes := slashed.binary
  names := [name for name in slashed.split('/') when not name.is_empty()]
  starts_at_separator := bytes.first() == b'/'
  is_share := starts_at_separator and bytes.get(1) == b'/'
  case
    when is_windows and is_drive(bytes) then { root: "#{names[0].to_upper()}/", names: names[1..] }
    when is_windows and is_share and names.length >= 2
      { root: "//#{names[0]}/#{names[1]}/", names: names[2..] }
    when starts_at_separator then { names, root: '/' }
    else { names, root: '' }

# Whether the path starts with a drive and a separator, as `C:\`: `C:` alone names the current
# directory of that drive, which is relative.
is_drive := (bytes: Binary) ->
  bytes.length >= 3 and bytes[0].is_letter() and bytes[1] == b':' and bytes[2] == b'/'

joined := (root: String, names: String[]) ->
  root.is_empty() and names.is_empty() then '.' else "#{root}#{names.join('/')}"

# The directory of the path: `.` for a name alone, and the root for the root.
export dir_name := (path: String) ->
  split := split_path(path)
  joined(split.root, split.names.all_but_last())

# The last name of the path: `c` for `a/b/c`, and `` for a root.
export base_name := (path: String) -> split_path(path).names.last() else ''

# The last name's part after its last `.`, or nil if it has none: `gz` for `a.tar.gz`. The `.`s
# that start a name, as those of `.profile` or `..`, start none, as they name no kind of file.
export extension := (path: String) ->
  bytes := base_name(path).binary
  var first = 0
  first += 1 while first < bytes.length and bytes[first] == b'.'
  var dot = bytes.length - 1
  dot -= 1 while dot >= first and bytes[dot] != b'.'
  if dot >= first
    bytes.text(dot + 1)!
  else
    nil

# The last name without its extension and the `.` before it: `a.tar` for `a.tar.gz`.
export stem := (path: String) ->
  name := base_name(path)
  ending := extension(path) else return name
  name.without_suffix(".#{ending}")!

# The paths one after another, normalized: `join('a', '../b', 'c')` is `b/c`. An empty one adds
# nothing, rather than a separator that would make a root of an empty first one.
export join := (first: String, rest: String...) ->
  normalize([path for path in [first, rest...] when not path.is_empty()].join('/'))

# The path without `.` and empty names, and with each `..` removing the name before it, as text: a
# `..` after a name that is a symbolic link names another directory than the system resolves it to.
export normalize := (path: String) ->
  split := split_path(path)
  is_absolute := not split.root.is_empty()
  names: String[]
  for name in split.names
    case name
      when '.' then continue
      when '..'
        can_cancel := not names.is_empty() and names.last() != '..'
        if can_cancel
          names.pop()
        else if not is_absolute
          names.push name
      else names.push(name)
  joined(split.root, names)

# Whether the path starts at a root (see split_path). On Windows a path that starts at `/` alone
# names the file from the root of the current drive, so it names one file for each drive.
export is_absolute := (path: String) -> not split_path(path).root.is_empty()

# The path as it is if it is absolute, and otherwise from `base`, normalized.
export absolute := (path: String, base: String = cwd()) ->
  joined :=
    if is_absolute(path)
      path
    else
      join base, path
  normalize(joined)

# The path from the directory `from` to `to`, both from `base` unless absolute. Paths under
# different roots have none, so `to` is given absolute.
export relative := (from: String, to: String, base: String = cwd()) ->
  # A `..` that a relative base would leave at the start names no name in common.
  absolute_base := absolute(base)
  from_path := split_path(absolute(from, absolute_base))
  to_path := split_path(absolute(to, absolute_base))
  return joined(to_path.root, to_path.names) if from_path.root != to_path.root
  from_names := from_path.names
  to_names := to_path.names
  var common = 0
  while common < from_names.length and common < to_names.length
    break if from_names[common] != to_names[common]
    common += 1
  dots := Array(from_names.length - common, '..')
  joined('', [dots..., to_names[common..]...])
