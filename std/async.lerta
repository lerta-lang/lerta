# Promises that the program settles, and promises made of others (see runtime/async.c).

import sleep from 'std:time'

extern lerta_promise_pending: () -> Promise
extern lerta_promise_fire: (Promise) -> void

# What a Deferred is settled with: a function that gives the value, rather than an array of it,
# since an array cannot hold an optional Int, Byte, Float or Bool; or an error.
class Outcome<T>
  var value: (() -> T)? = nil
  var error: Error? = nil
  is_settled := -> @value != nil or @error != nil

# A promise and what settles it, apart: `promise()` waits until `resolve` or `reject` is called. The
# first of them settles it, and later ones change nothing. The promise is made once it is asked
# for, so that a Deferred that is never settled leaves nothing waiting.
export class Deferred<T>
  fired := lerta_promise_pending()
  outcome := Outcome<T>()
  var waiting: Promise<T>? = nil

  promise := ->
    return waiting if waiting := @waiting
    started := settled_by(@fired, @outcome)
    @waiting = started
    started

  resolve := (value: T) ->
    return if @outcome.is_settled()
    @outcome.value = -> value
    lerta_promise_fire @fired

  reject := (error: Error) ->
    return if @outcome.is_settled()
    @outcome.error = error
    lerta_promise_fire @fired

# As a Deferred, of a promise that gives no value: `resolve()` takes none. A type argument cannot be
# void, so a Deferred<void> cannot stand for it.
export class Signal
  # Only whether it is settled, and its error, matter; the Bool is never read.
  deferred := Deferred<Bool>()
  var waiting: Promise? = nil

  promise := ->
    return waiting if waiting := @waiting
    started := ended(@deferred.promise())
    @waiting = started
    started

  resolve := -> @deferred.resolve(true)
  reject := (error: Error) -> @deferred.reject(error)

ended := (promise: Promise<Bool>): Promise -> await promise

settled_by := <T>(fired: Promise, outcome: Outcome<T>): Promise<T> ->
  await fired
  throw error if error := outcome.error
  value := outcome.value!
  value()

# Lets the work of the promise go on without awaiting it, as the event loop keeps it running: an
# error that it ends with, which nothing awaits, ends the program, as that of any promise dropped.
export spawn := <T>(task: Promise<T>) -> return

# The value of each promise, in their order, once all are resolved, or nothing for promises without
# a value; the error of the first that is rejected, at once.
export all := <P>(promises: P[]) -> await promises.gathered()

# The value or the error of the first of the promises to be settled, or nothing for promises
# without a value. The others are cancelled then.
export race := <P>(promises: P[]) -> await promises.first_settled()

# The value or the error of the promise, or nothing for one without a value, if it is settled within
# the seconds; a TimeoutError otherwise, which cancels it.
export timeout := <P>(promise: P, seconds: Float) -> await [promise].settled_within(seconds)

export struct TimeoutError: Error

# A promise that a TimeoutError, or the error of the sleep, rejects once the seconds have passed.
expired := <T>(seconds: Float): Promise<T> ->
  await sleep(seconds)
  throw TimeoutError(message: "timed out after #{seconds} seconds")

# The promises that have a value are awaited through the extend of Promise<T>[], and those without
# one, by the extend of Promise[], which gives them its methods before the generic one does, as
# promises of true that all_valued makes of them.
extend<T> Promise<T>[]
  gathered := (): Promise<T[]> ->
    all_values := Deferred<T[]>()
    boxes: T[][] = [[] for _ in @]
    var left = @length
    all_values.resolve [] if left == 0
    settle := (index: Int, promise: Promise<T>) ->
      try
        boxes[index].push(await promise)
        left -= 1
        all_values.resolve [box[0] for box in boxes] if left == 0
      catch error
        all_values.reject error
    spawn settle(i, promise) for promise, i in @
    try
      await all_values.promise()
    # Only a cancel of all cancels them: the error of one leaves the others, whose work may still
    # be wanted, going on.
    catch error: CancelledError
      promise.cancel() for promise in @
      throw error

  first_settled := (): Promise<T> ->
    first := Deferred<T>()
    settle := (promise: Promise<T>) ->
      try
        first.resolve await promise
      catch error
        first.reject error
    settling := [settle(promise) for promise in @]
    try
      await first.promise()
    finally
      promise.cancel() for promise in @
      # The cancelled promises unwind first, so that what follows does not overlap their cleanup,
      # as a read that still holds its Reader would.
      await done for done in settling

  settled_within := (seconds: Float) -> await [@[0], expired<T>(seconds)].first_settled()

extend Promise[]
  gathered := (): Promise -> await all_valued(@).gathered()

  first_settled := (): Promise -> await all_valued(@).first_settled()

  settled_within := (seconds: Float): Promise -> await all_valued(@).settled_within(seconds)

valued := (promise: Promise) ->
  await promise
  true

# A cancel of one of these reaches the promise it awaits.
all_valued := (promises: Promise[]) -> [valued(promise) for promise in promises]
