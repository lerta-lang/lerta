# Promises that the program settles, and promises made of others (see runtime/async.c).

extern lerta_promise_pending: () -> Promise
extern lerta_promise_fire: (Promise) -> void

# What a Deferred is settled with: a function that gives the value, rather than an array of it,
# since an array cannot hold an optional Int, Byte, Float or Bool; or an error.
class Outcome<T>
  value: (() -> T)? = nil
  error: Error? = nil
  is_settled = -> @value != nil or @error != nil

# A promise and what settles it, apart: `promise()` waits until `resolve` or `reject` is called. The
# first of them settles it, and later ones change nothing. The promise is made once it is asked
# for, so that a Deferred that is never settled leaves nothing waiting.
export class Deferred<T>
  signal = lerta_promise_pending()
  outcome = Outcome<T>()
  waiting: Promise<T>? = nil

  promise = ->
    return waiting if const waiting = @waiting
    const started = settled_by(@signal, @outcome)
    @waiting = started
    started

  resolve = (value: T) ->
    return if @outcome.is_settled()
    @outcome.value = -> value
    lerta_promise_fire @signal

  reject = (error: Error) ->
    return if @outcome.is_settled()
    @outcome.error = error
    lerta_promise_fire @signal

const settled_by = <T>(signal: Promise, outcome: Outcome<T>): Promise<T> ->
  await signal
  throw error if const error = outcome.error
  const value = outcome.value!
  value()

# The value of each promise, in their order, once all are resolved, or nothing for promises without
# a value; the error of the first that is rejected, at once.
export const all = <P>(promises: P[]) -> await promises.gathered()

# The value or the error of the first of the promises to be settled, or nothing for promises
# without a value.
export const race = <P>(promises: P[]) -> await promises.first_settled()

# The promises that have a value and those without one are awaited apart, as there is no value of
# the latter to gather: the extend of Promise[] gives it its methods before the generic one does.
extend<T> Promise<T>[]
  gathered = (): Promise<T[]> ->
    const all_values = Deferred<T[]>()
    const boxes: T[][] = [[] for _ in @]
    var left = @length
    all_values.resolve [] if left == 0
    const settle = (index: Int, promise: Promise<T>) ->
      try
        boxes[index].push(await promise)
        left -= 1
        all_values.resolve [box[0] for box in boxes] if left == 0
      catch error
        all_values.reject error
    const _settling = [settle(i, promise) for promise, i in @]
    await all_values.promise()

  first_settled = (): Promise<T> ->
    const first = Deferred<T>()
    const settle = (promise: Promise<T>) ->
      try
        first.resolve await promise
      catch error
        first.reject error
    const _settling = [settle(promise) for promise in @]
    await first.promise()

extend Promise[]
  gathered = ->
    const all_done = Deferred<Bool>()
    var left = @length
    all_done.resolve true if left == 0
    const settle = (promise: Promise) ->
      try
        await promise
        left -= 1
        all_done.resolve true if left == 0
      catch error
        all_done.reject error
    const _settling = [settle(promise) for promise in @]
    const _done = await all_done.promise()

  first_settled = ->
    const first = Deferred<Bool>()
    const settle = (promise: Promise) ->
      try
        await promise
        first.resolve true
      catch error
        first.reject error
    const _settling = [settle(promise) for promise in @]
    const _done = await first.promise()
