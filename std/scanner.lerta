# Reading a String by code points (see docs/reference/std.md#stdscanner). The position is a
# byte offset that only a TextScanner holds, which is seen only as a Scanner, so that it only ever
# stands at the start of a code point, and every part taken is valid UTF-8 without a check.
import char_at, sequence_length, text_between from './internal/utf8'

export interface Scanner
  done: () -> Bool
  peek: () -> Char?
  next: () -> Char?
  take: (String) -> Bool
  skip_while: ((Char) -> Bool) -> void
  take_while: ((Char) -> Bool) -> String
  mark: () -> () -> String
  rest: () -> String

class TextScanner: Scanner
  bytes: Binary
  var at = 0
  done = -> @at == @bytes.length
  peek = -> not @done() then char_at(@bytes, @at)
  next = ->
    code := @peek() ? return nil
    @at += sequence_length(@bytes[@at])
    code
  take = (prefix: String) ->
    return false if not @bytes.occurs_at(@at, prefix.binary)
    @at += prefix.binary.length
    true
  skip_while = (test: (Char) -> Bool) ->
    while code := @peek()
      return if not test(code)
      @next()
  mark = ->
    start := @at
    -> @since(start)
  take_while = (test: (Char) -> Bool) ->
    start := @at
    @skip_while test
    @since start
  rest = ->
    start := @at
    @at = @bytes.length
    @since start
  # The text passed over since the position `start`.
  since = (start: Int) -> text_between(@bytes, start, @at)

export scan := (text: String): Scanner -> TextScanner(bytes: text.binary)
