# Reading a String by code points (see docs/reference/std.md#stdscanner). The position is a
# byte offset that only a TextScanner holds, which is seen only as a Scanner, so that it only ever
# stands at the start of a code point, and no part taken is cut within one.
import char_at, lerta_string_slice, sequence_length from './internal/utf8'

## Reads a String by code points, from its start, as `scan` gives one.
export interface Scanner
  done: () -> Bool
  peek: () -> Char?
  next: () -> Char?
  take: (String) -> Bool
  skip_while: ((Char) -> Bool) -> void
  take_while: ((Char) -> Bool) -> String
  mark: () -> () -> String
  rest: () -> String

class TextScanner: Scanner
  args
    text: String

    # The text's bytes, kept as a field, which a read borrows, where `@text.binary` would retain
    # them.
    bytes: Binary
  private var at = 0
  done := -> @at == @bytes.length
  peek := -> not @done() then char_at(@bytes, @at)
  next := ->
    code := @peek() else return nil
    @at += sequence_length(@bytes[@at])
    code
  take := (prefix: String) ->
    return false unless @bytes.occurs_at(@at, prefix.binary)
    @at += prefix.binary.length
    true
  skip_while := (test: (Char) -> Bool) ->
    while code := @peek()
      return unless test(code)
      @next()
  mark := ->
    start := @at
    -> @since(start)
  take_while := (test: (Char) -> Bool) ->
    start := @at
    @skip_while test
    @since(start)
  rest := ->
    start := @at
    @at = @bytes.length
    @since(start)

  # The text passed over since the position `start`.
  private since := (start: Int) -> lerta_string_slice(@text, start, @at)

## A Scanner of the text, from its start.
export scan := (text: String): Scanner -> TextScanner(text, bytes: text.binary)
