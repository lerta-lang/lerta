# Functions of Floats (see docs/reference/modules.md#stdmath), of libm, checked in Lerta where libm
# would take what no Float holds, and of the runtime for pow, whose result C checks (runtime/math.c).

export extern fabs as abs: (Float) -> Float
export extern floor: (Float) -> Float
export extern ceil: (Float) -> Float
# Half way between two integers, away from zero.
export extern round: (Float) -> Float
export extern lerta_math_pow as pow: (Float, Float) -> Float
extern sqrt as libm_sqrt: (Float) -> Float
extern fmod: (Float, Float) -> Float

export const sqrt = (x: Float) ->
  throw ArithmeticError(message: 'square root of a negative number') if x < 0.0
  libm_sqrt x

# The remainder of x divided by y, of the sign of x, as C's fmod gives it.
export const remainder = (x: Float, y: Float) ->
  throw ArithmeticError(message: 'division by zero') if y == 0.0
  fmod x, y
