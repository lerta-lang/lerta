# Functions of Floats (see docs/reference/std.md#stdmath), of libm, checked in Lerta where libm
# would give a NaN, which no Float holds, and constants.

import INFINITY from './builtins/numbers'

# The positive infinity, which a Float that grows too large becomes; -INFINITY is the negative one.
export INFINITY from './builtins/numbers'

# The nearest Floats to π and e.
export PI := 3.141592653589793
export E := 2.718281828459045

export extern fabs as abs: (Float) -> Float
export extern floor: (Float) -> Float
export extern ceil: (Float) -> Float

# Half way between two integers, away from zero.
export extern round: (Float) -> Float

extern sqrt as libm_sqrt: (Float) -> Float
extern fmod: (Float, Float) -> Float
extern sin as libm_sin: (Float) -> Float
extern cos as libm_cos: (Float) -> Float
extern tan as libm_tan: (Float) -> Float
extern asin as libm_asin: (Float) -> Float
extern acos as libm_acos: (Float) -> Float
export extern atan: (Float) -> Float
export extern atan2: (Float, Float) -> Float
export extern exp: (Float) -> Float
extern log as libm_log: (Float) -> Float
extern log2 as libm_log2: (Float) -> Float
extern log10 as libm_log10: (Float) -> Float

# The length of the hypotenuse, without the overflow of `sqrt(x * x + y * y)`.
export extern hypot: (Float, Float) -> Float

export sqrt := (x: Float) ->
  throw ArithmeticError('square root of a negative number') if x < 0.0
  libm_sqrt(x)

# The remainder of x divided by y, of the sign of x, as C's fmod gives it, which is NaN for a y of
# 0 or an infinite x.
export remainder := (x: Float, y: Float) ->
  throw ArithmeticError('division by zero') if y == 0.0
  throw ArithmeticError('not a number') if x == INFINITY or x == -INFINITY
  fmod(x, y)

# Of an angle in radians, which is NaN for an infinite one.
export sin := (x: Float) -> libm_sin(checked_angle(x))
export cos := (x: Float) -> libm_cos(checked_angle(x))
export tan := (x: Float) -> libm_tan(checked_angle(x))

checked_angle := (x: Float) ->
  throw ArithmeticError('not a number') if x == INFINITY or x == -INFINITY
  x

# The angle whose sine or cosine x is, which is NaN for an x out of -1.0..=1.0.
export asin := (x: Float) -> libm_asin(checked_sine_or_cosine(x))
export acos := (x: Float) -> libm_acos(checked_sine_or_cosine(x))

checked_sine_or_cosine := (x: Float) ->
  throw ArithmeticError('a sine or cosine out of -1.0..=1.0') unless x in -1.0..=1.0
  x

# The logarithms, which are NaN for a negative x; of 0, -INFINITY.
export log := (x: Float) -> libm_log(checked_logarithm_argument(x))
export log2 := (x: Float) -> libm_log2(checked_logarithm_argument(x))
export log10 := (x: Float) -> libm_log10(checked_logarithm_argument(x))

checked_logarithm_argument := (x: Float) ->
  throw ArithmeticError('logarithm of a negative number') if x < 0.0
  x
