# The members of enums, by their texts and in their order (see docs/reference/std.md#stdenums).

# The interface of the enums, which bounds type parameters, as `<E: Enum>`: the compiler
# tells the types that satisfy it, which are the enums.
export interface Enum
  to_string: () -> String
  equals: (Self) -> Bool

# `parse<E>(text)`, the member of E whose text is the String, or nil, and `members<E>()`, the
# members of E as declared.
export intrinsic parse
export intrinsic members
