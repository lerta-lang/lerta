# JSON (see docs/reference/std.md#stdjson). The compiler generates the code that writes and
# reads each type (compiler/codegen/json_write.lerta and json_read.lerta), which `write_json` and
# `read_json` call: it goes through the methods of a JsonWriter and a JsonReader (std/internal/),
# which write their result types, since that code calls them with those types.
import JsonReader from './internal/json_reader'
import JsonWriter from './internal/json_writer'

# The types that encode_json and decode_json convert, which the compiler tells by their parts.
export interface Jsonable

# The text is not JSON, or not of the type it is decoded as.
export struct JsonError: Error

# How the keys of the fields of objects are written: as the fields' names, or in camel case, as
# `textDocument` for `text_document`.
export enum JsonKeys
  AS_WRITTEN
  CAMEL_CASE

export encode_json := <T: Jsonable>(value: T, keys: JsonKeys = JsonKeys.AS_WRITTEN) ->
  writer := new_writer(keys)
  write_json writer, value
  writer.text()

export decode_json := <T: Jsonable>(text: String, keys: JsonKeys = JsonKeys.AS_WRITTEN): T ->
  reader := new_reader(text, keys)
  value := read_json<T>(reader)
  reader.end()
  value

# Not generic, so that the checker checks JsonWriter and JsonReader, of std/internal/, when std:json
# is built on its own, which checks no instance of encode_json or decode_json.
new_writer := (keys: JsonKeys) -> JsonWriter(keys)
new_reader := (text: String, keys: JsonKeys) -> JsonReader(bytes: text.binary, keys: keys)
