# JSON (see docs/reference/std.md#stdjson), a format of std:codable: the code that the compiler
# generates for each type writes and reads it through the methods of a JsonWriter and a JsonReader
# (std/internal/), its Encoder and Decoder.
import Codable, decode, encode from './codable'
import JsonReader from './internal/json_reader'
import JsonWriter from './internal/json_writer'

# The text is not JSON, or not of the type it is decoded as.
export struct JsonError: Error

# How the keys of the fields of objects are written: as the fields' names, or in camel case, as
# `textDocument` for `text_document`.
export enum JsonKeys
  AS_WRITTEN
  CAMEL_CASE

export encode_json := <T: Codable>(value: T, keys: JsonKeys = JsonKeys.AS_WRITTEN) ->
  writer := new_writer(keys)
  encode writer, value
  writer.text()

export decode_json := <T: Codable>(text: String, keys: JsonKeys = JsonKeys.AS_WRITTEN): T ->
  reader := new_reader(text, keys)
  value := decode<T>(reader)
  reader.end()
  value

# Not generic, so that the checker checks JsonWriter and JsonReader, of std/internal/, when std:json
# is built on its own, which checks no instance of encode_json or decode_json.
new_writer := (keys: JsonKeys) -> JsonWriter(keys)
new_reader := (text: String, keys: JsonKeys) -> JsonReader(bytes: text.binary, keys: keys)
