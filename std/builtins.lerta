# The builtin functions and the methods of the builtin types, which every module has: the compiler
# imports this module into every other but std:io, which it imports. The compiler gives the builtin
# types the methods that need their representation, and C functions of the runtime build Strings
# and Binary values (see docs/internals.md#builtins).
import { stdout } from 'std:io'

extern lerta_int_to_string: (Int) -> String
extern lerta_byte_to_int: (Byte) -> Int
extern lerta_int_to_byte: (Int) -> Byte
extern lerta_binary_slice: (Binary, Int, Int) -> Binary
extern lerta_binary_from_bytes: (Array<Byte>) -> Binary
# The same object as a String, for bytes that are valid UTF-8.
extern lerta_binary_as_string: (Binary) -> String
extern lerta_string_join: (Array<String>, String) -> String

const MIN_INT = -9223372036854775808

# The types that have `to_string()`, which print and interpolation require.
export interface Stringable
  to_string: () -> String

# What `throw` takes, and `catch` takes back: a program declares its own types of errors.
export interface Error
  message: String

# The types that `for` and comprehensions go through, by the Iter of `iter()`.
export interface Iterable<T>
  iter: () -> Iter<T>

# Writes the text of x and a newline to stdout.
export const print = <T: Stringable>(x: T) -> write_line(x.to_string())

# Not generic, so that it is checked, and its use of stdout counted, even if print is never called.
const write_line = (text: String) -> stdout.write(text + "\n")

extend Int
  to_string = () -> lerta_int_to_string(@)
  to_byte = () ->
    throw 'integer overflow' if @ < 0 or @ > 255
    lerta_int_to_byte(@)

extend Bool
  to_string = () -> @ then 'true' else 'false'

extend Byte
  to_int = () -> lerta_byte_to_int(@)
  to_string = () -> @to_int().to_string()
  # ASCII only, as the bytes of other characters are not characters on their own.
  is_digit = () -> @ >= '0' and @ <= '9'
  is_letter = () -> (@ >= 'a' and @ <= 'z') or (@ >= 'A' and @ <= 'Z')
  is_space = () -> @ == ' ' or @ == "\t" or @ == "\n" or @ == "\r"

extend String
  to_string = () -> @
  # The code points, as Ints. A String is always valid UTF-8, so its sequences need no checks.
  iter = (): Iter<Int> ->
    const bytes = @binary
    var i = 0
    const has_next = () -> i < bytes.length
    const next = () ->
      const length = utf8_sequence_length(bytes[i])
      var code = bytes[i].to_int() - UTF8_LEAD_OFFSETS[length - 1]
      code = code * 64 + bytes[i + k].to_int() - 0x80 for k in 1...length
      i += length
      code
    { has_next, next }
  # nil unless the String is an integer in decimal, with an optional leading `-`, that fits in an
  # Int. The digits are accumulated as a negative number, which can hold the minimum Int.
  parse_int = () ->
    const bytes = @binary
    const negative = bytes.length > 0 and bytes[0] == '-'
    const start = negative then 1 else 0
    return nil if start == bytes.length
    var value = 0
    for i in start...bytes.length
      const byte = bytes[i]
      return nil if byte < '0' or byte > '9'
      const digit = (byte - '0').to_int()
      return nil if value < (MIN_INT + digit) / 10
      value = value * 10 - digit
    return nil if not negative and value == MIN_INT
    negative then value else -value
  # The pieces between the occurrences of a non-empty separator, empty ones too: 'a,,b'.split(',')
  # is ['a', '', 'b']. Cutting valid UTF-8 around a valid separator leaves valid UTF-8.
  split = (separator: String) ->
    throw 'split by an empty separator' if separator == ''
    const bytes = @binary
    const separator_bytes = separator.binary
    const pieces: Array<String> = []
    var start = 0
    var i = 0
    while i + separator_bytes.length <= bytes.length
      if bytes.occurs_at(i, separator_bytes)
        pieces.push(lerta_binary_as_string(bytes.slice(start, i)))
        i += separator_bytes.length
        start = i
      else
        i += 1
    pieces.push(lerta_binary_as_string(bytes.slice(start, bytes.length)))
    pieces
  starts_with = (prefix: String) -> @binary.occurs_at(0, prefix.binary)

extend Binary
  # The bytes, read as the Iter is.
  iter = (): Iter<Byte> -> (b for b in @)
  # The bytes from `start` up to `end`, which is exclusive. Throws if they are out of range.
  slice = (start: Int, end: Int) -> lerta_binary_slice(@, start, end)
  # Whether `part` occurs at `index`; false if it does not fit there.
  occurs_at = (index: Int, part: Binary) ->
    return false if index < 0 or index > @length - part.length
    for k in 0...part.length
      return false if @[index + k] != part[k]
    true
  # The same bytes as a String if they are valid UTF-8, otherwise nil.
  decode_utf8 = () -> is_utf8(@) then lerta_binary_as_string(@) else nil
  # The bytes from `start` up to `end` as a String. Throws if they are out of range or not UTF-8.
  text = (start: Int, end: Int) -> @slice(start, end).decode_utf8() ? throw 'invalid UTF-8'

# Whether the bytes are UTF-8. Overlong forms, surrogates and code points above U+10FFFF are not,
# as the standard requires: the leads 0xE0, 0xED, 0xF0 and 0xF4 limit the byte after them.
const is_utf8 = (bytes: Binary) ->
  var i = 0
  while i < bytes.length
    const lead = bytes[i]
    const length = utf8_sequence_length(lead)
    return false if length == 0 or i + length > bytes.length
    for k in 1...length
      return false if not is_continuation(bytes[i + k])
    const second: Byte = length > 1 then bytes[i + 1] else 0
    return false if lead == 0xE0 and second < 0xA0
    return false if lead == 0xED and second > 0x9F
    return false if lead == 0xF0 and second < 0x90
    return false if lead == 0xF4 and second > 0x8F
    i += length
  true

# The number of bytes of the UTF-8 sequence that `lead` starts, or 0 if it cannot start one.
const utf8_sequence_length = (lead: Byte) ->
  case
    when lead < 0x80 then 1
    when lead >= 0xC2 and lead <= 0xDF then 2
    when lead >= 0xE0 and lead <= 0xEF then 3
    when lead >= 0xF0 and lead <= 0xF4 then 4
    else 0

const is_continuation = (byte: Byte) -> byte >= 0x80 and byte <= 0xBF

# What a lead byte of a sequence of 1 to 4 bytes adds to the bits of the code point it holds.
const UTF8_LEAD_OFFSETS = [0, 0xC0, 0xE0, 0xF0]

extend Array<String>
  # The Strings one after another, with the separator between each two.
  join = (separator: String) -> lerta_string_join(@, separator)

extend Array<Byte>
  # The same bytes, copied into a Binary.
  to_binary = () -> lerta_binary_from_bytes(@)

extend<T> Array<T>
  # The items, read as the Iter is.
  iter = (): Iter<T> -> (x for x in @)
  contains = (item: T): Bool -> @any((each) -> each == item)
  # The place of the first item for which `test` is true, or nil if there is none.
  find_index = (test: (T) -> Bool): Int? ->
    for i in 0...@length
      return i if test(@[i])
    nil
  last = (): T ->
    throw 'last of an empty array' if @length == 0
    @[@length - 1]
  # Pushes the items of another array, one by one; those of the array itself, if it is that, once.
  append = (items: Array<T>) ->
    const count = items.length
    @push items[i] for i in 0...count

extend<T> Iter<T>
  # Itself, so that an Iter is Iterable.
  iter = (): Iter<T> -> @

# The methods of whatever `for` goes through: they read its items as it does, through `iter()`.
extend<T> Iterable<T>
  map = <U>(f: (T) -> U): Iter<U> -> (f(x) for x in @)
  filter = (keep: (T) -> Bool): Iter<T> -> (x for x in @ when keep(x))
  to_array = (): Array<T> -> [x for x in @]
  any = (test: (T) -> Bool): Bool ->
    for x in @
      return true if test(x)
    false
  all = (test: (T) -> Bool): Bool -> not @any((x) -> not test(x))
  find = (test: (T) -> Bool): T? ->
    for x in @
      return x if test(x)
    nil
  # The first `n` items, or all of them if there are fewer; it stops reading its source after them,
  # which a comprehension could not.
  take = (n: Int): Iter<T> ->
    const source = @iter()
    var left = n
    const has_next = () -> left > 0 and source.has_next()
    const next = (): T ->
      left -= 1
      source.next()
    { has_next, next }

extend<K, V> Map<K, V>
  has = (key: K): Bool -> @[key] != nil
  # The value of `key`, which is first set to `make()` if the key is not there.
  get_or_put = (key: K, make: () -> V): V ->
    return found if const found = @[key]
    const made = make()
    @[key] = made
    made

# A Map<K, Bool> serves as a set of its keys.
extend<K> Map<K, Bool>
  add = (key: K) -> @[key] = true
