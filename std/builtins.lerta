# See docs/reference/builtins.md and docs/internals.md#builtins.
import
  char_at, is_continuation, is_utf8, lerta_binary_as_string, sequence_length, utf8_of
from './internal/utf8'
# Writes at once, unlike std:io's Writer (see runtime/io.c).
extern lerta_print_stdout: (String) -> void
extern lerta_print_stderr: (String) -> void
extern lerta_float_to_string: (Float) -> String
extern lerta_float_fits_int: (Float) -> Bool
extern lerta_float_to_int: (Float) -> Int
extern lerta_float_fits_float32: (Float) -> Bool
extern lerta_float_to_float32: (Float) -> Float32
extern lerta_float32_to_string: (Float32) -> String
extern lerta_float32_to_float: (Float32) -> Float
# The bits of the double that a decimal text rounds to, or -1 if it is too large to be finite.
extern lerta_float_literal_bits: (String) -> Int
extern lerta_float_from_bits: (Int) -> Float

const MIN_INT = -9223372036854775808

# The types that have `to_string()`, which print and interpolation require.
export interface Stringable
  to_string: () -> String

# The types that have `to_literal()`, the text of the literal that gives the value, as an array's
# text writes its items: `'a'` for a String, where `to_string()` gives `a`.
export interface Literal
  to_literal: () -> String

# Stops the program at once, for a bug that no caller could handle (see docs/reference/errors.md).
export extern lerta_panic_string as panic: (String) -> never

# What `throw` takes, and `catch` takes back: a program declares its own types of errors.
export interface Error
  message: String

# The errors of the runtime, which docs/reference/errors.md lists with what throws each: every
# struct here that declares Error is one, and the order they are declared in is that of
# LertaErrorKind in runtime/lerta.h.
export struct IndexError: Error
export struct ArithmeticError: Error
export struct NilError: Error
export struct CastError: Error
export struct IterError: Error
export struct WeakError: Error
export struct IOError: Error
export struct ValueError: Error
export struct InitError: Error
export struct CancelledError: Error

# The types that `for` and comprehensions go through, by the Iter of `iter()`.
export interface Iterable<T>
  iter: () -> Iter<T>

export const print = <T: Stringable>(x: T) -> print_stdout_line(x.to_string())
export const print_error = <T: Stringable>(x: T) -> print_stderr_line(x.to_string())

# Not generic, so that they are checked even if print and print_error are never called.
const print_stdout_line = (text: String) -> lerta_print_stdout(text + "\n")
const print_stderr_line = (text: String) -> lerta_print_stderr(text + "\n")

extend Float
  to_string = -> lerta_float_to_string(@)
  to_literal = -> @to_string()
  # The Int of the value truncated toward zero, or nil where it is beyond an Int.
  to_int = (): Int? -> lerta_float_fits_int(@) then lerta_float_to_int(@)
  # The nearest Float32, or nil where that is an infinity.
  to_float32 = (): Float32? -> lerta_float_fits_float32(@) then lerta_float_to_float32(@)
  # The text with `digits` digits after the point, of the value times 10 to the `digits` rounded
  # half away from zero to an Int, which it must fit in. The product may round, so a value just
  # below a half may round up; the rest after truncating it is exact, so that rounding adds no
  # error of its own, as adding 0.5 would.
  to_fixed = (digits: Int) ->
    if digits < 0 or digits > 18
      throw ValueError(message: "to_fixed of #{digits} digits, not 0 to 18")
    var scale = 1
    scale *= 10 for _ in 0...digits
    const size = @ < 0.0 then -@ else @
    const product = size * scale.to_float()
    const truncated = product.to_int() ? throw ArithmeticError(message: 'integer overflow')
    const units = product - truncated.to_float() >= 0.5 then truncated + 1 else truncated
    const sign = @ < 0.0 and units != 0 then '-' else ''
    const whole = "#{sign}#{units / scale}"
    return whole if digits == 0
    "#{whole}.#{(units % scale).to_string().pad_start(digits, '0')}"

extend Float32
  to_string = -> lerta_float32_to_string(@)
  to_literal = -> @to_string()
  to_float = -> lerta_float32_to_float(@)

extend Bool
  to_string = -> @ then 'true' else 'false'
  to_literal = -> @to_string()

extend Int
  # The digits are taken from the value made negative, which can hold the minimum Int.
  to_string = ->
    var rest = @ < 0 then @ else -@
    var digits = ''
    while true
      digits = digit_text(-(rest % 10)) + digits
      rest /= 10
      break if rest == 0
    @ < 0 then '-' + digits else digits
  to_literal = -> @to_string()

extend Int8
  to_string = -> @to_int().to_string()
  to_literal = -> @to_string()

extend Int16
  to_string = -> @to_int().to_string()
  to_literal = -> @to_string()

extend Int32
  to_string = -> @to_int().to_string()
  to_literal = -> @to_string()

extend UInt16
  to_string = -> @to_int().to_string()
  to_literal = -> @to_string()

extend UInt32
  to_string = -> @to_int().to_string()
  to_literal = -> @to_string()

extend UInt64
  to_string = ->
    var rest = @
    var digits = ''
    while true
      digits = digit_text((rest % 10).to_int()!) + digits
      rest /= 10
      break if rest == 0
    digits
  to_literal = -> @to_string()

# A byte's classes are those of the Char of the same number.
extend Byte
  to_string = -> @to_int().to_string()
  to_literal = -> @to_string()
  is_digit = -> @to_char().is_digit()
  is_letter = -> @to_char().is_letter()
  is_space = -> @to_char().is_space()
  is_utf8_continuation = -> is_continuation(@)

extend Char
  to_string = -> lerta_binary_as_string(utf8_of(@))
  # Quoted as a String of the one Char is.
  to_literal = -> @to_string().to_literal()
  # True only for ASCII characters: a digit, letter or space beyond them, as `０`, `é` or U+3000,
  # is in no class.
  is_digit = -> @ >= '0' and @ <= '9'
  is_letter = -> (@ >= 'a' and @ <= 'z') or (@ >= 'A' and @ <= 'Z')
  is_space = -> @ == ' ' or @ == "\t" or @ == "\n" or @ == "\r"
  # The Char that many places on, or back, which throws where no Char is.
  add = (count: Int) -> (@to_int() + count).to_char() ? throw not_a_char()
  sub = (count: Int) -> (@to_int() - count).to_char() ? throw not_a_char()

const is_control = (c: Char) -> c.to_int() < 0x20 or c.to_int() == 0x7F

# The escape of a Char in a "..." literal (see docs/reference/syntax.md), or nil if it needs none.
const escape_in_double_quotes = (c: Char): String? ->
  case c
    when '\' then '\\'
    when '"' then '\"'
    when '#' then '\#'
    when "\n" then '\n'
    when "\t" then '\t'
    when "\r" then '\r'
    when "\0" then '\0'
    else is_control(c) then "\\u{#{upper_hex(c.to_int())}}"

const UPPER_HEX_DIGITS = '0123456789ABCDEF'.binary

# The digits of a number below 256 in upper-case hex, without leading zeros.
const upper_hex = (n: Int) ->
  var hex = ''
  hex += UPPER_HEX_DIGITS[n >> 4].to_char() if n >= 16
  hex + UPPER_HEX_DIGITS[n & 0xF].to_char()

const ZERO: Char = '0'

# The decimal digit of a number from 0 to 9.
const digit_text = (digit: Int) -> (ZERO + digit).to_string()

# The place of the first occurrence of `part`, which is not empty, at `from` or after it, or -1.
const index_of = (bytes: Binary, part: Binary, from: Int) ->
  for i in from...max(from, bytes.length - part.length + 1)
    return i if bytes.occurs_at(i, part)
  -1

const not_a_char = -> ValueError(message: 'not a Unicode scalar value')

extend String
  to_string = -> @
  # In single quotes, or, for a String that holds a single quote or a control character, in
  # double quotes, with what they would take otherwise escaped.
  to_literal = ->
    return "'#{@}'" if not @any((c) -> c == "'" or is_control(c))
    var literal = '"'
    for c in @
      if const escape = escape_in_double_quotes(c)
        literal += escape
      else
        literal += c
    literal + '"'
  # The Chars.
  iter = (): Iter<Char> ->
    const bytes = @binary
    var i = 0
    const has_next = -> i < bytes.length
    const next = ->
      const c = char_at(bytes, i)
      i += sequence_length(bytes[i])
      c
    { has_next, next }
  # The digits are accumulated as a negative number, which can hold the minimum Int.
  parse_int = ->
    const bytes = @binary
    const negative = bytes.length > 0 and bytes[0] == '-'
    const start = negative then 1 else 0
    return nil if start == bytes.length
    var value = 0
    for i in start...bytes.length
      const byte = bytes[i]
      return nil if byte < '0' or byte > '9'
      const digit = (byte - '0').to_int()
      return nil if value < (MIN_INT + digit) / 10
      value = value * 10 - digit
    return nil if not negative and value == MIN_INT
    negative then value else -value
  parse_float = (): Float? ->
    return nil if not is_decimal_number(@binary)
    const bits = lerta_float_literal_bits(@)
    bits != -1 then lerta_float_from_bits(bits)
  # Cutting valid UTF-8 around a valid separator leaves valid UTF-8.
  split = (separator: String) ->
    throw ValueError(message: 'split by an empty separator') if separator == ''
    const bytes = @binary
    const separator_bytes = separator.binary
    const pieces: String[] = []
    var start = 0
    var found = index_of(bytes, separator_bytes, 0)
    while found >= 0
      pieces.push lerta_binary_as_string(bytes.slice(start, found))
      start = found + separator_bytes.length
      found = index_of(bytes, separator_bytes, start)
    pieces.push lerta_binary_as_string(bytes.slice(start, bytes.length))
    pieces
  starts_with = (prefix: String) -> @binary.occurs_at(0, prefix.binary)
  ends_with = (suffix: String) ->
    @binary.occurs_at @binary.length - suffix.binary.length, suffix.binary
  without_prefix = (prefix: String): String? ->
    @starts_with(prefix) then @binary.text(prefix.binary.length)!
  without_suffix = (suffix: String): String? ->
    @ends_with(suffix) then @binary.text(0, @binary.length - suffix.binary.length)!
  # By the first byte that differs, or else by length, so that a prefix goes first.
  compare = (other: String) ->
    const (bytes, other_bytes) = (@binary, other.binary)
    for i in 0...min(bytes.length, other_bytes.length)
      return bytes[i].compare(other_bytes[i]) if bytes[i] != other_bytes[i]
    bytes.length.compare other_bytes.length
  # The empty String occurs in every one; index_of takes no empty part.
  contains = (part: String) -> part == '' or index_of(@binary, part.binary, 0) >= 0
  # Without the whitespace at both ends: the ASCII spaces of Byte.is_space, which no byte of a
  # multi-byte character is, so that what is left is valid UTF-8.
  trim = ->
    const bytes = @binary
    var start = 0
    start += 1 while start < bytes.length and bytes[start].is_space()
    var end = bytes.length
    end -= 1 while end > start and bytes[end - 1].is_space()
    lerta_binary_as_string bytes.slice(start, end)
  # Likewise, at the start only.
  trim_start = ->
    const bytes = @binary
    var start = 0
    start += 1 while start < bytes.length and bytes[start].is_space()
    lerta_binary_as_string bytes.slice(start, bytes.length)
  # Likewise, at the end only.
  trim_end = ->
    const bytes = @binary
    var end = bytes.length
    end -= 1 while end > 0 and bytes[end - 1].is_space()
    lerta_binary_as_string bytes.slice(0, end)
  # Each occurrence of the part, from the start and without overlapping, replaced.
  replace = (part: String, by: String) ->
    throw ValueError(message: 'replace of an empty part') if part == ''
    @split(part).join(by)
  # Only the ASCII letters change: each is a byte that no multi-byte character holds, so that what
  # is left is valid UTF-8.
  to_upper = ->
    const bytes = [b >= 'a' and b <= 'z' then b - 'a' + 'A' else b for b in @binary]
    lerta_binary_as_string bytes.to_binary()
  to_lower = ->
    const bytes = [b >= 'A' and b <= 'Z' then b - 'A' + 'a' else b for b in @binary]
    lerta_binary_as_string bytes.to_binary()
  # The String after as many of `fill`, one code point, as make it `width` code points long, or the
  # String itself if it is no shorter.
  pad_start = (width: Int, fill = ' ') -> padding(@, width, fill) + @
  # Likewise, with the code points of `fill` after the String.
  pad_end = (width: Int, fill = ' ') -> @ + padding(@, width, fill)
  repeat = (count: Int) ->
    throw ValueError(message: 'repeat a negative number of times') if count < 0
    var repeated = ''
    repeated += @ for _ in 0...count
    repeated
  # What comes before the first occurrence of the separator and what comes after it, or nil if
  # there is none.
  split_once = (separator: String): (String, String)? ->
    throw ValueError(message: 'split by an empty separator') if separator == ''
    const bytes = @binary
    const found = index_of(bytes, separator.binary, 0)
    return nil if found < 0
    const before = lerta_binary_as_string(bytes.slice(0, found))
    const after = found + separator.binary.length
    (before, lerta_binary_as_string(bytes.slice(after, bytes.length)))

extend Binary
  # The bytes, read as the Iter is.
  iter = (): Iter<Byte> -> (b for b in @)
  # The bytes from `start` up to `end`, which it does not hold.
  slice = (start: Int, end: Int) ->
    throw IndexError(message: 'slice out of range') if start < 0 or start > end or end > @length
    var part = ''.binary
    part += @[i] for i in start...end
    part
  occurs_at = (index: Int, part: Binary) ->
    return false if index < 0 or index > @length - part.length
    for byte, k in part
      return false if @[index + k] != byte
    true
  text = (start = 0, end: Int = @length): String? ->
    const bytes = start == 0 and end == @length then @ else @slice(start, end)
    is_utf8(bytes) then lerta_binary_as_string(bytes)

# The copies of `fill` that make `text` `width` code points long (see pad_start).
const padding = (text: String, width: Int, fill: String) ->
  throw ValueError(message: 'a fill that is not one code point') if code_point_count(fill) != 1
  fill.repeat max(0, width - code_point_count(text))

const code_point_count = (text: String) ->
  var count = 0
  count += 1 for _ in text
  count

extend String[]
  # The Strings one after another, with the separator between each two.
  join = (separator: String) ->
    var joined = ''
    for part, i in @
      joined += separator if i > 0
      joined += part
    joined

extend Binary[]
  # The Binarys one after another, with the separator between each two.
  join = (separator: Binary) ->
    var joined = ''.binary
    for part, i in @
      joined += separator if i > 0
      joined += part
    joined

extend Byte[]
  # The same bytes, copied into a Binary.
  to_binary = ->
    var bytes = ''.binary
    bytes += byte for byte in @
    bytes

# `[1, 2]`, with each item as the literal that gives it, `['a']`.
extend<T: Literal> T[]
  to_string = -> "[#{[item.to_literal() for item in @].join(', ')}]"
  to_literal = -> @to_string()

extend<T> T[]
  # The items, read as the Iter is.
  iter = (): Iter<T> -> (x for x in @)
  # A loop rather than `@any`, which would allocate a closure, and an Iter of the array, per call.
  contains = (item: T): Bool ->
    for each in @
      return true if each == item
    false
  find_index = (test: (T) -> Bool): Int? ->
    for item, i in @
      return i if test(item)
    nil
  first = (): T? -> @length > 0 then @[0]
  last = (): T? -> @length > 0 then @[@length - 1]
  # The items in the order that `compare` gives (LESS when its first argument goes first), equal
  # items keeping their order.
  # A merge sort: runs of `width` items, sorted, are merged in pairs, doubling it.
  sorted = (compare: (T, T) -> Ordering): T[] ->
    var runs = [item for item in @]
    var width = 1
    while width < runs.length
      const merged: T[] = []
      var start = 0
      while start < runs.length
        const middle = start + width < runs.length then start + width else runs.length
        const end = middle + width < runs.length then middle + width else runs.length
        var left = start
        var right = middle
        while left < middle or right < end
          # The left item goes first when equal, keeping the order of equal items.
          if right == end or (left < middle and compare(runs[left], runs[right]) != GREATER)
            merged.push runs[left]
            left += 1
          else
            merged.push runs[right]
            right += 1
        start = end
      runs = merged
      width *= 2
    runs
  # Pushes the items of another array, one by one; those of the array itself, if it is that, once.
  append = (items: T[]) ->
    const count = items.length
    @push items[i] for i in 0...count

extend<T> Iter<T>
  # Itself, so that an Iter is Iterable.
  iter = (): Iter<T> -> @

# The methods of whatever `for` goes through: they read its items as it does, through `iter()`.
extend<T> Iterable<T>
  map = <U>(f: (T) -> U): Iter<U> -> (f(x) for x in @)
  filter = (keep: (T) -> Bool): Iter<T> -> (x for x in @ when keep(x))
  to_array = (): T[] -> [x for x in @]
  any = (test: (T) -> Bool): Bool ->
    for x in @
      return true if test(x)
    false
  # A loop rather than `not @any`, which would allocate a closure per call.
  all = (test: (T) -> Bool): Bool ->
    for x in @
      return false if not test(x)
    true
  find = (test: (T) -> Bool): T? ->
    for x in @
      return x if test(x)
    nil
  # The item whose key is the least, the first of those with equal keys, or nil if there is none.
  min_by = <K: Comparable>(key: (T) -> K): T? -> extreme_by(@iter(), key, LESS)
  # The item whose key is the greatest, the first of those with equal keys, or nil if there is none.
  max_by = <K: Comparable>(key: (T) -> K): T? -> extreme_by(@iter(), key, GREATER)
  # It stops reading its source after them, which a comprehension could not.
  take = (n: Int): Iter<T> ->
    const source = @iter()
    var left = n
    const has_next = -> left > 0 and source.has_next()
    const next = (): T ->
      left -= 1
      source.next()
    { has_next, next }
  zip = <U>(other: Iterable<U>): Iter<(T, U)> ->
    const left = @iter()
    const right = other.iter()
    const has_next = ->
      const more = left.has_next()
      throw ValueError(message: 'zip of Iterables of different lengths') if right.has_next() != more
      more
    const next = (): (T, U) -> (left.next(), right.next())
    { has_next, next }

extend<K, V> Map<K, V>
  has = (key: K): Bool -> @[key] != nil
  # The values of the entries, as `entries()` gives them.
  values = (): Iter<V> -> (value for (_, value) in @entries())
  get_or_put = (key: K, make: () -> V): V ->
    return found if const found = @[key]
    const made = make()
    @[key] = made
    made

# The operations of sets, by the operators: `a | b`, `a & b`, `a - b` and `a ^ b` give new sets, of
# the items in the order of `a`, then of `b`.
extend<T> Set<T>
  # The items of either.
  bit_or = (other: Set<T>): Set<T> ->
    const union = Set<T>([item for item in @])
    union.add item for item in other
    union
  # The items of this set that the other has too.
  bit_and = (other: Set<T>): Set<T> -> Set<T>([item for item in @ when other.has(item)])
  # The items of this set that the other has not.
  sub = (other: Set<T>): Set<T> -> Set<T>([item for item in @ when not other.has(item)])
  # The items of one set that the other has not.
  bit_xor = (other: Set<T>): Set<T> -> @ - other | (other - @)
  # Whether the other has every item of this set.
  is_subset = (other: Set<T>): Bool -> @iter().all((item) -> other.has(item))

# The item whose key compares with every other key as `order` or equal, the first of such ones, or
# nil if there is none (see min_by).
const extreme_by = <T, K: Comparable>(items: Iter<T>, key: (T) -> K, order: Ordering): T? ->
  var found: T?
  var found_key: K?
  for x in items
    const k = key(x)
    if found_key == nil or k.compare(found_key) == order
      found = x
      found_key = k
  found

extend<T: Comparable> Iterable<T>
  # The least item, the first of equal ones, or nil if there is none.
  min = (): T? -> @min_by((x) -> x)
  # The greatest item, the first of equal ones, or nil if there is none.
  max = (): T? -> @max_by((x) -> x)

extend<T: Add<T, T>> Iterable<T>
  # The items added to `zero` one after another, from the first: 0 for numbers, and for other
  # types their own, as `''` for Strings.
  sum = (zero: T = 0): T ->
    var total = zero
    total += x for x in @
    total

# Digits, an optional fraction and an optional exponent, after an optional `-` (see parse_float).
const is_decimal_number = (bytes: Binary) ->
  var i = bytes.length > 0 and bytes[0] == '-' then 1 else 0
  const digits_from = (start: Int) ->
    var end = start
    end += 1 while end < bytes.length and bytes[end].is_digit()
    end
  const whole_end = digits_from(i)
  return false if whole_end == i
  i = whole_end
  if i < bytes.length and bytes[i] == '.'
    const fraction_end = digits_from(i + 1)
    return false if fraction_end == i + 1
    i = fraction_end
  if i < bytes.length and (bytes[i] == 'e' or bytes[i] == 'E')
    i += 1
    i += 1 if i < bytes.length and (bytes[i] == '+' or bytes[i] == '-')
    const exponent_end = digits_from(i)
    return false if exponent_end == i
    i = exponent_end
  i == bytes.length

# How a value compares with another, which compare gives (see Comparable).
export enum Ordering
  LESS
  EQUAL
  GREATER

# The types that have `equals`: every type that `==` compares, by its own equals or compare, or as
# `==` does.
export interface Equatable
  equals: (Self) -> Bool

# The types that have `compare`, which gives their `<` and the like: the numbers, String, and the
# classes and structs that have their own, which gives their `==` too.
export interface Comparable
  compare: (Self) -> Ordering

# The types that can be map keys and set items: equal values have the same hash.
export interface Hashable
  equals: (Self) -> Bool
  hash: () -> Int

# The least of the values, the first of those that are equal, by their compare (see Comparable).
export const min = <T: Comparable>(first: T, rest: T...): T ->
  var least = first
  for value in rest
    least = value if value < least
  least

# The greatest of the values, the first of those that are equal.
export const max = <T: Comparable>(first: T, rest: T...): T ->
  var greatest = first
  for value in rest
    greatest = value if value > greatest
  greatest

# The types that the arithmetic and bitwise operators apply to: `a + b` calls `a.add(b)` on a type
# that `+` does not apply to otherwise, and so on, and `-a` calls `a.neg()`. The numbers have them,
# as `+` gives them, and String has add.
export interface Add<Rhs, Out>
  add: (Rhs) -> Out

export interface Sub<Rhs, Out>
  sub: (Rhs) -> Out

export interface Mul<Rhs, Out>
  mul: (Rhs) -> Out

export interface Div<Rhs, Out>
  div: (Rhs) -> Out

export interface Rem<Rhs, Out>
  rem: (Rhs) -> Out

export interface BitAnd<Rhs, Out>
  bit_and: (Rhs) -> Out

export interface BitOr<Rhs, Out>
  bit_or: (Rhs) -> Out

export interface BitXor<Rhs, Out>
  bit_xor: (Rhs) -> Out

export interface Shl<Rhs, Out>
  shl: (Rhs) -> Out

export interface Shr<Rhs, Out>
  shr: (Rhs) -> Out

export interface Neg<Out>
  neg: () -> Out
