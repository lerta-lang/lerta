@lerta.string.541 = private unnamed_addr constant { i64, ptr, i64, [16357 x i8] } { i64 -9223372036854775808, ptr null, i64 16357, [16357 x i8] c"#ifdef _WIN32\0A\0A#include <limits.h>\0A#include <stdio.h>\0A#include <stdlib.h>\0A#include <string.h>\0A#include <windows.h>\0A\0A#include \22lerta.h\22\0A\0A// Windows takes paths and the command line as UTF-16, in its wide-character functions, and Lerta\0A// keeps them as UTF-8. Both return NULL on failure; the caller frees the result.\0Astatic wchar_t *to_utf16(const char *utf8) {\0A  int length = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, utf8, -1, NULL, 0);\0A  if (length == 0) return NULL;\0A  wchar_t *utf16 = malloc((size_t)length * sizeof(wchar_t));\0A  if (utf16 == NULL) lerta_panic(\22out of memory\22);\0A  MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, utf8, -1, utf16, length);\0A  return utf16;\0A}\0A\0Astatic char *to_utf8(const wchar_t *utf16) {\0A  int length = WideCharToMultiByte(CP_UTF8, 0, utf16, -1, NULL, 0, NULL, NULL);\0A  if (length == 0) return NULL;\0A  char *utf8 = malloc((size_t)length);\0A  if (utf8 == NULL) lerta_panic(\22out of memory\22);\0A  WideCharToMultiByte(CP_UTF8, 0, utf16, -1, utf8, length, NULL, NULL);\0A  return utf8;\0A}\0A\0A// A stack overflow raises EXCEPTION_STACK_OVERFLOW in the overflowing thread, on what is left of\0A// its stack; the guarantee keeps enough of it for the handler to report the panic.\0Astatic LONG CALLBACK on_exception(EXCEPTION_POINTERS *exception) {\0A  if (exception->ExceptionRecord->ExceptionCode == EXCEPTION_STACK_OVERFLOW) {\0A    lerta_panic(\22stack overflow\22);\0A  }\0A  return EXCEPTION_CONTINUE_SEARCH;\0A}\0A\0A// A failure of either call is ignored, as on POSIX: the program still runs, and only the report\0A// of an overflow is lost.\0Avoid lerta_stack_init(void) {\0A  ULONG guarantee = 1 << 16;\0A  SetThreadStackGuarantee(&guarantee);\0A  AddVectoredExceptionHandler(1, on_exception);\0A}\0A\0A// The C runtime's argv is in the ANSI code page, which may not hold every character, so the\0A// arguments are read again from the UTF-16 command line. They are kept for the life of the\0A// process, so they are never freed.\0Avoid lerta_os_arguments(int *argc, char ***argv) {\0A  wchar_t **wide_arguments = CommandLineToArgvW(GetCommandLineW(), argc);\0A  if (wide_arguments == NULL) lerta_panic(\22cannot read the arguments\22);\0A  char **arguments = calloc((size_t)*argc + 1, sizeof(char *));\0A  if (arguments == NULL) lerta_panic(\22out of memory\22);\0A  for (int i = 0; i < *argc; i++) {\0A    arguments[i] = to_utf8(wide_arguments[i]);\0A    if (arguments[i] == NULL) lerta_panic(\22cannot read the arguments\22);\0A  }\0A  LocalFree(wide_arguments);\0A  *argv = arguments;\0A}\0A\0A// WriteFile takes the bytes as they are: no newline becomes CRLF, as it would through the C\0A// runtime's text mode.\0Astatic bool write_all(HANDLE handle, const uint8_t *bytes, int64_t length) {\0A  while (length > 0) {\0A    DWORD chunk = length > (1 << 30) ? (1 << 30) : (DWORD)length;\0A    DWORD written;\0A    if (!WriteFile(handle, bytes, chunk, &written, NULL) || written == 0) return false;\0A    bytes += written;\0A    length -= written;\0A  }\0A  return true;\0A}\0A\0Astatic HANDLE standard_handle(int fd) {\0A  return GetStdHandle(fd == 1 ? STD_OUTPUT_HANDLE : STD_ERROR_HANDLE);\0A}\0A\0Astatic bool is_console(HANDLE handle) {\0A  DWORD mode;\0A  return GetConsoleMode(handle, &mode);\0A}\0A\0A// How many bytes at the end begin a UTF-8 character that the next bytes would complete.\0Astatic int incomplete_tail(const uint8_t *bytes, int64_t length) {\0A  for (int back = 1; back <= 3 && back <= length; back++) {\0A    uint8_t byte = bytes[length - back];\0A    bool is_continuation = (byte & 0xC0) == 0x80;\0A    if (!is_continuation) {\0A      int needed = byte >= 0xF0 ? 4 : byte >= 0xE0 ? 3 : byte >= 0xC0 ? 2 : 1;\0A      return needed > back ? back : 0;\0A    }\0A  }\0A  return 0;\0A}\0A\0A// For each of stdout (1) and stderr (2), the start of a character that its last write to a\0A// console ended in, which the next write completes.\0Astatic uint8_t console_tails[3][3];\0Astatic int console_tail_lengths[3];\0A\0A// A console shows bytes in its code page, which is rarely UTF-8, but shows UTF-16 as it is. Bytes\0A// that are not UTF-8 show as U+FFFD.\0Astatic bool write_console(int fd, HANDLE console, const uint8_t *bytes, int64_t length) {\0A  int tail_length = console_tail_lengths[fd];\0A  if (length > INT_MAX - tail_length) return false;\0A  int total = tail_length + (int)length;\0A  char *text = malloc((size_t)total + 1);\0A  if (text == NULL) lerta_panic(\22out of memory\22);\0A  memcpy(text, console_tails[fd], (size_t)tail_length);\0A  memcpy(text + tail_length, bytes, (size_t)length);\0A  int complete = total - incomplete_tail((const uint8_t *)text, total);\0A  console_tail_lengths[fd] = total - complete;\0A  memcpy(console_tails[fd], text + complete, (size_t)(total - complete));\0A  int wide_length = MultiByteToWideChar(CP_UTF8, 0, text, complete, NULL, 0);\0A  wchar_t *wide = malloc(((size_t)wide_length + 1) * sizeof(wchar_t));\0A  if (wide == NULL) lerta_panic(\22out of memory\22);\0A  MultiByteToWideChar(CP_UTF8, 0, text, complete, wide, wide_length);\0A  free(text);\0A  const wchar_t *rest = wide;\0A  bool written = true;\0A  while (written && wide_length > 0) {\0A    DWORD count;\0A    written = WriteConsoleW(console, rest, (DWORD)wide_length, &count, NULL) && count > 0;\0A    rest += count;\0A    wide_length -= (int)count;\0A  }\0A  free(wide);\0A  return written;\0A}\0A\0Abool lerta_os_write(int fd, const uint8_t *bytes, int64_t length) {\0A  HANDLE handle = standard_handle(fd);\0A  return is_console(handle) ? write_console(fd, handle, bytes, length)\0A                            : write_all(handle, bytes, length);\0A}\0A\0Abool lerta_os_is_terminal(int fd) {\0A  return is_console(standard_handle(fd));\0A}\0A\0Avoid lerta_os_exit(int code) {\0A  ExitProcess((UINT)cod