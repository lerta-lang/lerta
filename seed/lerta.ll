 GetFileType(file) == FILE_TYPE_DISK &&\0A                 GetFileInformationByHandle(file, &information) &&\0A                 !(information.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY);\0A  CloseHandle(file);\0A  return is_file;\0A}\0A\0A// The final path is in the form \5C\5C?\5CC:\5Cdir\5Cfile, or \5C\5C?\5CUNC\5Cserver\5Cshare\5Cfile for a network\0A// share, which is given as the usual C:\5Cdir\5Cfile or \5C\5Cserver\5Cshare\5Cfile.\0Astatic const wchar_t *usual_form(wchar_t *final_path) {\0A  static const wchar_t prefix[] = L\22\5C\5C\5C\5C?\5C\5C\22;\0A  static const wchar_t unc_prefix[] = L\22\5C\5C\5C\5C?\5C\5CUNC\5C\5C\22;\0A  size_t unc_length = wcslen(unc_prefix);\0A  if (wcsncmp(final_path, unc_prefix, unc_length) == 0) {\0A    final_path[unc_length - 2] = L'\5C\5C';\0A    return final_path + unc_length - 2;\0A  }\0A  size_t length = wcslen(prefix);\0A  return wcsncmp(final_path, prefix, length) == 0 ? final_path + length : final_path;\0A}\0A\0Achar *lerta_os_real_path(const char *path) {\0A  HANDLE file = open_file(path, 0, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS);\0A  if (file == INVALID_HANDLE_VALUE) return NULL;\0A  DWORD length = GetFinalPathNameByHandleW(file, NULL, 0, FILE_NAME_NORMALIZED);\0A  wchar_t *final_path = length == 0 ? NULL : malloc(length * sizeof(wchar_t));\0A  bool resolved =\0A      final_path != NULL &&\0A      GetFinalPathNameByHandleW(file, final_path, length, FILE_NAME_NORMALIZED) < length;\0A  CloseHandle(file);\0A  char *result = resolved ? to_utf8(usual_form(final_path)) : NULL;\0A  free(final_path);\0A  return result;\0A}\0A\0A// The path of `name` in the directory `dir`, which the caller frees.\0Astatic wchar_t *join_path(const wchar_t *dir, const wchar_t *name) {\0A  size_t dir_length = wcslen(dir);\0A  size_t name_length = wcslen(name);\0A  wchar_t *path = malloc((dir_length + name_length + 2) * sizeof(wchar_t));\0A  if (path == NULL) lerta_panic(\22out of memory\22);\0A  memcpy(path, dir, dir_length * sizeof(wchar_t)