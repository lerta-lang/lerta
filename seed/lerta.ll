lerta_remove_tree(const LertaString *path);\0A// Reads a file to its end through `read`, which returns how many bytes it put in `buffer`, 0 at\0A// the end, or -1 on failure; returns NULL on failure.\0ALertaString *lerta_read_chunks(int64_t (*read)(void *file, uint8_t *buffer, int64_t size),\0A                               void *file);\0A\0A// What differs between systems: platform_posix.c and platform_windows.c, each of which compiles to\0A// nothing on the other. Paths and arguments are NUL-terminated UTF-8, and a false or NULL result\0A// is a failure.\0A// Stack overflow: reported as a panic. Called first thing in main.\0Avoid lerta_stack_init(void);\0A// Gives main's arguments as the system's bytes, which are UTF-8 on Windows: POSIX leaves them as\0A// they are, and Windows replaces them with ones read from its UTF-16 command line.\0Avoid lerta_os_arguments(int *argc, char ***argv);\0A// Writes all the bytes to stdout (1) or stderr (2); on POSIX, to any file descriptor.\0Abool lerta_os_write(int fd, const uint8_t *bytes, int64_t length);\0Abool lerta_os_is_terminal(int fd);\0A// Ends the program at once, without flushing stdout.\0A_Noreturn void lerta_os_exit(int code);\0A// Ends the program as a failure that is not an exit code, as C's abort does.\0A_Noreturn void lerta_os_abort(void);\0ALertaString *lerta_os_read_file(const char *path);\0Abool lerta_os_write_file(const char *path, const uint8_t *bytes, int64_t length);\0Abool lerta_os_is_file(const char *path);\0A// The absolute path with no links, which the caller frees.\0Achar *lerta_os_real_path(const char *path);\0A// A new, empty directory in the system's directory for temporary files, whose path the caller\0A// frees.\0Achar *lerta_os_make_temp_dir(void);\0A// Removes a file, or a directory with everything in it; a symbolic link is removed, not followed.\0Abool lerta_os_remove_tree(const char *path);\0A// Runs the command `args[0]`, found as the system finds commands, with `args`, which end with\0A// N