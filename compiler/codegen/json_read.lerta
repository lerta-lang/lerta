# The functions that read values of a type through a JsonReader (see codegen/json), which give the
# value owned, and release what they have read of it when a method throws.
import json_kind from '../checker/json'
import FieldInfo, info_of, is_argument from '../checker/object_types'
import ProgramWide from '../checker/shared'
import emit_array_new, emit_push from './array'
import emit_parse from './enum'
import emit_check_with, emit_return_thrown from './exceptions'
import emit_box from './boxes'
import emit_values from './heap_object'
import emit_branch, emit_when, emit_while, IrBuilder, IrModule from './ir_builder'
import call_method, call_void_method, Coder, field_name_args, is_inline, SCALARS from './json'
import
  constructor_symbol, emit_release, emit_release_value, ir_type, shared_string_constant
from './lerta_ir'
import emit_map_new, emit_map_set from './map'
import emit_is_present, emit_unwrap, emit_wrap, nil_constant from './optional'
import narrowed_from_word, scalar_of from './scalar'
import
  ArrayType, bool_type, EnumType, format_type, kind_of, MapType, ObjectType, OptionalType, int_type,
  integer_range, is_boxed, RecordType, string_type, TupleType, Type, type_key, UnionType
from '../types'

# The value read, owned; the caller checks for an exception after it.
export const emit_read_json = (
  ir: IrBuilder, program: ProgramWide, reader_type: ObjectType, reader: String, type: Type
) -> emit_read_call(ir, Coder(program, type: reader_type, operand: reader), type)

const emit_read_call = (ir: IrBuilder, reader: Coder, type: Type) ->
  const symbol = read_function(ir.module, reader, type)
  ir.assign "call #{ir_type(type)} #{symbol}(ptr #{reader.operand})"

const read_function = (module: IrModule, reader: Coder, type: Type) ->
  const define = (name: String, defined: IrModule) ->
    const ir = IrBuilder(module: defined)
    const own = Coder(program: reader.program, type: reader.type, operand: '%reader')
    ir.emit "ret #{ir_type(type)} #{emit_read_parts(ir, own, type)}"
    ir.finish "private #{ir_type(type)} #{name}(ptr %reader)"
  module.named "json read #{type_key(type)}", '@lerta.json.read', define

# The body of the function of a type: its parts, or the value itself for a type that others read
# inline, which read_json may read too.
const emit_read_parts = (ir: IrBuilder, reader: Coder, type: Type) ->
  case type
    when ArrayType then emit_read_array(ir, reader, type)
    when MapType then emit_read_map(ir, reader, type)
    when TupleType then emit_read_tuple(ir, reader, type)
    when RecordType then emit_read_record(ir, reader, type)
    when ObjectType then emit_read_object(ir, reader, type)
    when UnionType then emit_read_union(ir, reader, type)
    else emit_read(ir, reader, type, -> emit_return_thrown(ir, type))

# The value read, owned. `unwind` releases what the function holds and returns.
const emit_read = (ir: IrBuilder, reader: Coder, type: Type, unwind: () -> void): String ->
  if not is_inline(type)
    const value = emit_read_call(ir, reader, type)
    emit_check_with ir, unwind
    return value
  case type
    when OptionalType
      const is_null = call_method(ir, reader, 'read_null', bool_type, [], unwind)
      const present = ir.assign("xor i1 #{is_null}, true")
      const read_inner = -> emit_wrap(ir, emit_read(ir, reader, type.inner, unwind), type.inner)
      emit_branch ir, ir_type(type), present, read_inner, nil_constant(type)
    when EnumType then emit_read_member(ir, reader, type, unwind)
    else
      if const scalar = SCALARS[kind_of(type)]
        return call_method(ir, reader, scalar.read, scalar.type, [], unwind)
      emit_read_integer ir, reader, type, unwind

# An integer of a type that SCALARS has not, read as an Int in the type's range.
const emit_read_integer = (ir: IrBuilder, reader: Coder, type: Type, unwind: () -> void) ->
  const { least, most } = integer_range(type)
  const name = format_type(type)
  const article = name.starts_with('I') then 'an' else 'a'
  const expected = shared_string_constant(ir, "#{article} #{name}")
  const args = ["ptr #{expected}", "i64 #{least}", "i64 #{most}"]
  const word = call_method(ir, reader, 'read_integer', int_type, args, unwind)
  narrowed_from_word ir, word, scalar_of(type)!

# The member that the string read names.
const emit_read_member = (ir: IrBuilder, reader: Coder, type: EnumType, unwind: () -> void) ->
  const text = call_method(ir, reader, 'read_string', string_type, [], unwind)
  const member = emit_parse(ir, text, type)
  const release_text = ->
    emit_release ir, text
    unwind()
  const fail = ->
    const enum_name = shared_string_constant(ir, format_type(type))
    const args = ["ptr #{enum_name}", "ptr #{text}"]
    call_void_method ir, reader, 'fail_member', args, release_text
  emit_when ir, ir.assign("xor i1 #{emit_is_present(ir, member, optional_of(type))}, true"), fail
  emit_release ir, text
  emit_unwrap ir, member, optional_of(type)

const optional_of = (type: Type) -> OptionalType(inner: type)

# The array, which the function holds while it reads the items.
const emit_read_array = (ir: IrBuilder, reader: Coder, type: ArrayType) ->
  const element = type.element
  const array = emit_array_new(ir, element)
  const unwind = -> release_and_return(ir, array, type)
  call_void_method ir, reader, 'begin_array', [], unwind
  const more = -> call_method(ir, reader, 'next_item', bool_type, [], unwind)
  const read_item = ->
    const item = emit_read(ir, reader, element, unwind)
    # The array retains the item, which this function owned.
    emit_push ir, array, item, element
    emit_release_value ir, item, element
  emit_while ir, more, read_item
  array

# The map, which the function holds while it reads the entries.
const emit_read_map = (ir: IrBuilder, reader: Coder, type: MapType) ->
  const map = emit_map_new(ir, reader.program, type)
  const unwind = -> release_and_return(ir, map, type)
  call_void_method ir, reader, 'begin_object', [], unwind
  var key = ''
  const more = ->
    key = call_method(ir, reader, 'next_key', optional_of(string_type), [], unwind)
    ir.assign "icmp ne ptr #{key}, null"
  const read_entry = ->
    const release_key = ->
      emit_release ir, key
      unwind()
    const value = emit_read(ir, reader, type.value, release_key)
    # The map retains the key and the value, which this function owned.
    emit_map_set ir, map, key, value, type
    emit_release ir, key
    emit_release_value ir, value, type.value
  emit_while ir, more, read_entry
  map

# The items in their order, which the function holds until it makes the tuple of them.
const emit_read_tuple = (ir: IrBuilder, reader: Coder, type: TupleType) ->
  const count = "i64 #{type.items.length}"
  const items: String[] = []
  const unwind = ->
    emit_release_value ir, item, type.items[i] for item, i in items
    emit_return_thrown ir, type
  call_void_method ir, reader, 'begin_array', [], unwind
  for item_type in type.items
    call_void_method ir, reader, 'next_tuple_item', [count], unwind
    items.push emit_read(ir, reader, item_type, unwind)
  call_void_method ir, reader, 'end_tuple', [count], unwind
  emit_values ir, type, items

# A field read from an object's key: a field with a default, or of an optional type, may be left
# out.
struct FieldToRead(name: String, type: Type, has_default: Bool)

const is_required = (field: FieldToRead) -> not field.has_default and field.type is not OptionalType

const emit_read_record = (ir: IrBuilder, reader: Coder, type: RecordType) ->
  const fields =
    [FieldToRead(name: field.name, type: field.type, has_default: false) for field in type.fields]
  const make = (values: FieldValues) -> emit_values(ir, type, values.values())
  emit_read_fields ir, reader, type, fields, make

# The object is constructed as a call of its constructor does it: of the fields that are its
# arguments, each with a default followed by whether it is given (see generate_construction).
const emit_read_object = (ir: IrBuilder, reader: Coder, type: ObjectType) ->
  const info = info_of(reader.program, type)
  const to_read = (field: FieldInfo) ->
    FieldToRead name: field.name.name, type: field.type!, has_default: field.has_default
  const fields = [to_read(field) for field in info.fields when is_argument(field)]
  const make = (values: FieldValues) ->
    const args: String[] = []
    for field, i in fields
      args.push "#{ir_type(field.type)} #{values.value(i)}"
      args.push "i1 #{values.given(i)}" if field.has_default
    const object = ir.assign("call ptr #{constructor_symbol(type)}(#{args.join(', ')})")
    emit_check_with ir, -> values.unwind()
    # The constructor retains the values, which this function owned.
    values.release()
    object
  emit_read_fields ir, reader, type, fields, make

# The values of the fields read so far, each in a slot of its own with whether its key was given,
# which `unwind` releases. A field left out holds nil, or zeros for a field with a default, which
# releasing ignores.
class FieldValues
  ir: IrBuilder
  fields: FieldToRead[]
  # The type that the function gives.
  type: Type
  slots: String[] = []
  given_slots: String[] = []

  values = -> [@value(i) for i in 0...@fields.length]
  value = (i: Int) -> @ir.assign("load #{ir_type(@fields[i].type)}, ptr #{@slots[i]}")
  given = (i: Int) -> @ir.assign("load i1, ptr #{@given_slots[i]}")

  release = -> emit_release_value(@ir, @value(i), field.type) for field, i in @fields

  unwind = ->
    @release()
    emit_return_thrown @ir, @type

const emit_read_fields = (
  ir: IrBuilder, reader: Coder, type: Type, fields: FieldToRead[], make: (FieldValues) -> String
) ->
  const values = FieldValues(ir, fields, type)
  for field in fields
    const slot = ir.alloca(ir_type(field.type))
    const empty = field.type is OptionalType then nil_constant(field.type) else 'zeroinitializer'
    ir.emit "store #{ir_type(field.type)} #{empty}, ptr #{slot}"
    values.slots.push slot
    const given = ir.alloca('i1')
    ir.emit "store i1 false, ptr #{given}"
    values.given_slots.push given
  const unwind = -> values.unwind()
  call_void_method ir, reader, 'begin_object', [], unwind
  var key = ''
  const more = ->
    key = call_method(ir, reader, 'next_key', optional_of(string_type), [], unwind)
    ir.assign "icmp ne ptr #{key}, null"
  const read_key = ->
    const release_key = ->
      emit_release ir, key
      unwind()
    emit_read_field_of_key ir, reader, values, key, release_key
    emit_release ir, key
  emit_while ir, more, read_key
  for field, i in fields
    continue if not is_required(field)
    const fail = ->
      call_void_method ir, reader, 'fail_missing', field_name_args(ir, field.name), unwind
    emit_when ir, ir.assign("xor i1 #{values.given(i)}, true"), fail
  make values

# Reads the value of the key into the field whose key it is (see JsonKeys), or skips it if no
# field has it as its key.
const emit_read_field_of_key = (
  ir: IrBuilder, reader: Coder, values: FieldValues, key: String, unwind: () -> void
) ->
  const done = ir.fresh_label('json.key.done')
  for field, i in values.fields
    const read = ir.fresh_label('json.key.field')
    const next = ir.fresh_label('json.key.next')
    const args = ["ptr #{key}", field_name_args(ir, field.name)...]
    const matches = call_method(ir, reader, 'is_field_key', bool_type, args, unwind)
    ir.emit "br i1 #{matches}, label %#{read}, label %#{next}"
    ir.start_block read
    const value = emit_read(ir, reader, field.type, unwind)
    ir.emit "store #{ir_type(field.type)} #{value}, ptr #{values.slots[i]}"
    ir.emit "store i1 true, ptr #{values.given_slots[i]}"
    ir.emit "br label %#{done}"
    ir.start_block next
  call_void_method ir, reader, 'skip_value', [], unwind
  ir.emit "br label %#{done}"
  ir.start_block done

# The member that the kind of the value tells (see checker/json), in its box if it has one.
const emit_read_union = (ir: IrBuilder, reader: Coder, type: UnionType) ->
  const unwind = -> emit_return_thrown(ir, type)
  const kind = call_method(ir, reader, 'peek_kind', int_type, [], unwind)
  const done = ir.fresh_label('json.member.done')
  const other = ir.fresh_label('json.member.other')
  const labels = [ir.fresh_label('json.member') for _ in type.members]
  const cases = ["i64 #{json_kind(member)}, label %#{labels[i]}" for member, i in type.members]
  ir.emit "switch i64 #{kind}, label %#{other} [ #{cases.join(' ')} ]"
  const incoming: String[] = []
  for member, i in type.members
    ir.start_block labels[i]
    const value = emit_read(ir, reader, member, unwind)
    const boxed = is_boxed(member) then emit_box(ir, value, member) else value
    incoming.push "[ #{boxed}, %#{ir.current_block} ]"
    ir.emit "br label %#{done}"
  ir.start_block other
  const expected = shared_string_constant(ir, format_type(type))
  call_void_method ir, reader, 'fail_expected', ["ptr #{expected}"], unwind
  ir.emit 'unreachable'
  ir.start_block done
  ir.assign "phi ptr #{incoming.join(', ')}"

const release_and_return = (ir: IrBuilder, value: String, type: Type) ->
  emit_release ir, value
  emit_return_thrown ir, type
