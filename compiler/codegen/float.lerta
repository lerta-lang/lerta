# Floats in the generated code (see docs/internals.md#floats).
import float_bits from '../float_literals'
import Generator from './generator'
import IrBuilder from './ir_builder'
import NOT_A_NUMBER, throw_if from './runtime_errors'
import scalar_of, widened_to_word from './scalar'
import Type from '../types'

PREDICATES := { '==': 'oeq', '!=': 'one', '<': 'olt', '<=': 'ole', '>': 'ogt', '>=': 'oge' }

# The literal's value as the type, a Float or a Float32, written as a double by its bits (see
# docs/internals.md#floats); the checker has found it finite (see float_literal).
export float_constant := (text: String, type: Type) ->
  bits := float_bits(text, type)!
  return "0x#{bits.to_hex(16).to_upper()}" if bits >= 0
  # A negative double's bits are a negative Int: its sign bit, the top one, is set apart from the
  # rest, which to_hex writes, as it throws for a negative number.
  rest := bits - INT_MIN
  "0x#{((rest >> 60) + 8).to_hex(1).to_upper()}#{(rest & 0x0FFFFFFFFFFFFFFF).to_hex(15).to_upper()}"

# `+`, `-`, `*` or `/` of two floats of the type, which throws where the result is NaN, but in the
# operands of a tree whose root checks it (see float_tree).
export apply_float_arithmetic := (
  g: Generator, operator: String, left: String, right: String, type: Type
) ->
  ir := g.ir
  float := scalar_of(type)!.ir_type
  instruction :=
    case operator
      when '+' then 'fadd'
      when '-' then 'fsub'
      when '*' then 'fmul'
      when '/' then 'fdiv'
      else panic("no Float operator #{operator}")
  result := ir.assign("#{instruction} #{float} #{left}, #{right}")
  return result if g.defers_float_checks
  throw_if g, ir.assign("fcmp uno #{float} #{result}, 0.0"), NOT_A_NUMBER
  result

export emit_float_negation := (ir: IrBuilder, operand: String, type: Type) ->
  ir.assign "fneg #{scalar_of(type)!.ir_type} #{operand}"

# A comparison of two floats of the type; none is NaN, so they are ordered, infinities too.
export emit_float_comparison := (
  ir: IrBuilder, operator: String, left: String, right: String, type: Type
) -> ir.assign("fcmp #{PREDICATES[operator]!} #{scalar_of(type)!.ir_type} #{left}, #{right}")

# The float's bits as a word, with -0.0 made 0.0, so that equal floats give the same word.
export emit_float_word := (ir: IrBuilder, value: String, type: Type) ->
  scalar := scalar_of(type)!
  positive_zero := ir.assign("fadd #{scalar.ir_type} #{value}, 0.0")
  widened_to_word ir, positive_zero, scalar
