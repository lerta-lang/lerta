# `case` and `then`/`else` in the generated code: the tests of their arms, and the values they
# merge.
import Case, CaseArm, Conditional, Expression, If, NilLiteral, Statement from '../ast'
import generate_borrowed_value, is_borrowable_in_scope from './borrowing'
import generate_condition_of, generate_if from './control_flow'
import generate, generate_condition, type_of from './expression'
import generate_block, generate_block_value, hold from './function'
import Generator from './generator'
import any_of, phi_incoming from './ir_builder'
import emit_type_test from './heap_object'
import emit_release, ir_type, ownership from './lerta_ir'
import emit_is_nil, emit_present_test from './optional'
import emit_string_equals from './string'
import is_kind, ObjectType, OptionalType, Type, UnionType from '../types'

# The subject is evaluated once and released at the end. The arms are tested in order; every arm
# jumps to one end block that merges the values. A case over every type of a union has no else
# arm, and falling past its last test cannot happen. A subject that is a reference is held (see
# hold), so that a jump out of an arm releases it too, but for one borrowed from a local that keeps
# it through the arms (see is_borrowable_in_scope).
export generate_case := (g: Generator, case_expression: Case) ->
  ir := g.ir
  subject := case_expression.subject
  is_borrowed := subject != nil and is_borrowable_in_scope(g, subject)
  subject_operand :=
    if not subject
      ''
    else if is_borrowed
      generate_borrowed_value g, subject
    else
      generate g, subject
  subject_type :=
    if subject
      type_of g, subject
    else
      nil
  holds_subject := subject_type != nil and not is_borrowed and ownership(subject_type) != NONE
  release_nothing := -> return
  held :=
    if holds_subject
      hold g, subject_operand, subject_type!
    else
      nil
  release_subject := held else release_nothing
  end_label := ir.fresh_label('case.end')
  incoming: String[]
  type := type_of(g, case_expression)

  # One that gives no value runs its arms as statements, which release the values they discard, as
  # an if does. An arm that ends with a jump gives no operand; it never reaches the end.
  generate_arm_value := (body: Statement[]) ->
    if is_kind(type, 'void')
      generate_block g, body
    else
      incoming.push phi_incoming(generate_block_value(g, body), ir.current_block)
    ir.branch end_label
  for arm in case_expression.arms
    test := generate_test(g, arm, subject_type, subject_operand)
    arm_label := ir.fresh_label('case.arm')
    next_label := ir.fresh_label('case.next')
    ir.branch_if test, arm_label, next_label
    ir.start_block arm_label
    generate_arm_value arm.body
    ir.start_block next_label
  if otherwise := case_expression.otherwise
    generate_arm_value otherwise
  else
    ir.emit 'unreachable'
  ir.start_block end_label
  result := merge(g, type, incoming)
  release_subject()
  result

# The condition is tested as an `if` tests it; both values jump to one end block that merges
# them.
export generate_conditional := (g: Generator, conditional: Conditional) ->
  test := generate_condition(g, conditional.condition)
  value_of := (value: Expression) -> -> generate_block_value(g, [value])
  incoming :=
    branch_values(g, test, value_of(conditional.then_value), value_of(conditional.else_value))
  merge(g, type_of(g, conditional), incoming)

# An `if` that gives a value merges those of its branches as then/else does; one that gives none
# runs as a statement, which releases the values its branches discard.
export generate_if_value := (g: Generator, if_expression: If) ->
  if is_kind(type_of(g, if_expression), 'void')
    generate_if g, if_expression
    return ''
  condition := generate_condition_of(g, if_expression.condition)
  then_value := -> generate_block_value(g, if_expression.then_body, condition.define)
  else_value := -> generate_block_value(g, if_expression.else_body)
  merge(g, type_of(g, if_expression), branch_values(g, condition.test, then_value, else_value))

# Branches on the test to the two values, each generated in a block of its own that then jumps to
# one end block: the incoming values of that block, which merge takes.
branch_values := (g: Generator, test: String, then_value: () -> String, else_value: () -> String) ->
  ir := g.ir
  then_label := ir.fresh_label('branch.then')
  else_label := ir.fresh_label('branch.else')
  end_label := ir.fresh_label('branch.end')
  ir.branch_if test, then_label, else_label
  branch := (label: String, value: () -> String) ->
    ir.start_block label
    operand := value()
    from := ir.current_block
    ir.branch end_label
    phi_incoming(operand, from)
  incoming := [branch(then_label, then_value), branch(else_label, else_value)]
  ir.start_block end_label
  incoming

# The value of the arms at their end block: none for void, and none that comes for never.
export merge := (g: Generator, type: Type, incoming: String[]) ->
  case
    when is_kind(type, 'void') then ''
    when is_kind(type, 'never') then 'poison'
    else g.ir.assign("phi #{ir_type(type)} #{incoming.join(', ')}")

# An i1 that holds when any of the arm's patterns matches.
generate_test := (g: Generator, arm: CaseArm, subject_type: Type?, operand: String) ->
  type := subject_type else return generate_condition(g, arm.patterns[0])
  test_of := (pattern: Expression) ->
    if type is OptionalType
      if pattern is NilLiteral
        return emit_is_nil(g.ir, operand, type)
      test_value := (value: String) -> pattern_test(g, value, type.inner, pattern)
      return emit_present_test(g.ir, operand, type, test_value)
    pattern_test(g, operand, type, pattern)
  any_of(g.ir, [test_of(pattern) for pattern in arm.patterns])

# A subject of a union narrowed to one of its members is still tested for its type.
pattern_test := (g: Generator, subject: String, type: Type, pattern: Expression) ->
  if type is UnionType | ObjectType
    emit_type_test(g.ir, subject, type_of(g, pattern))
  else
    value_test(g, subject, type, pattern)

# The subject is borrowed by the comparison, as it is tested again by the next patterns.
value_test := (g: Generator, subject: String, type: Type, pattern: Expression) ->
  value := generate(g, pattern)
  return g.ir.assign("icmp eq #{ir_type(type)} #{subject}, #{value}") unless is_kind(type, 'String')
  equal := emit_string_equals(g.ir, subject, value)
  emit_release g.ir, value
  equal
