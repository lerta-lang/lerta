# `case` and `then`/`else` in the generated code: the tests of their arms, and the values they
# merge.
import { Case, CaseArm, Conditional, Expression, If, NilLiteral, Statement } from '../ast'
import { generate_condition_of, generate_if } from './control_flow'
import { generate, generate_condition, type_of } from './expression'
import { generate_block_value, hold, no_locals } from './function'
import { CodegenLocal, Generator } from './generator'
import { emit_type_test } from './heap_object'
import { emit_release, ir_type, ownership } from './lerta_ir'
import { emit_is_nil, emit_present_test } from './optional'
import { emit_string_equals } from './string'
import { is_kind, OptionalType, Type, UnionType } from '../types'

# The subject is evaluated once and released at the end. The arms are tested in order; every arm
# jumps to one end block that merges the values. A case over every type of a union has no else
# arm, and falling past its last test cannot happen. A subject that is a reference is held (see
# hold), so that a jump out of an arm releases it too.
export const generate_case = (g: Generator, case_expression: Case) ->
  const ir = g.ir
  const subject = case_expression.subject
  const subject_operand = subject then generate(g, subject) else ''
  const subject_type = subject then type_of(g, subject) else nil
  const holds_subject = subject_type then ownership(subject_type) != NONE else false
  const release_nothing = -> return
  const held = holds_subject then hold(g, subject_operand, subject_type!) else nil
  const release_subject = held ? release_nothing
  const end_label = ir.fresh_label('case.end')
  const incoming: Array<String> = []
  # An arm that ends with a jump gives no operand; it never reaches the end.
  const generate_arm_value = (body: Array<Statement>) ->
    const value = generate_block_value(g, body, no_locals)
    const operand = value == '' then 'poison' else value
    incoming.push "[ #{operand}, %#{ir.current_block} ]"
    ir.emit "br label %#{end_label}"
  for arm in case_expression.arms
    const test = generate_test(g, arm, subject_type, subject_operand)
    const arm_label = ir.fresh_label('case.arm')
    const next_label = ir.fresh_label('case.next')
    ir.emit "br i1 #{test}, label %#{arm_label}, label %#{next_label}"
    ir.start_block arm_label
    generate_arm_value arm.body
    ir.start_block next_label
  if const otherwise = case_expression.otherwise
    generate_arm_value otherwise
  else
    ir.emit 'unreachable'
  ir.start_block end_label
  const result = merge(g, type_of(g, case_expression), incoming)
  release_subject()
  result

# The condition is tested as an `if` tests it; both values jump to one end block that merges
# them.
export const generate_conditional = (g: Generator, conditional: Conditional) ->
  const ir = g.ir
  const test = generate_condition(g, conditional.condition)
  const then_label = ir.fresh_label('then')
  const else_label = ir.fresh_label('else')
  const end_label = ir.fresh_label('then.end')
  ir.emit "br i1 #{test}, label %#{then_label}, label %#{else_label}"
  const branch = (label: String, value: Expression) ->
    ir.start_block label
    const operand = generate_block_value(g, [value], no_locals)
    const from = ir.current_block
    ir.emit "br label %#{end_label}"
    "[ #{operand == '' then 'poison' else operand}, %#{from} ]"
  const incoming = [
    branch(then_label, conditional.then_value), branch(else_label, conditional.else_value)
  ]
  ir.start_block end_label
  merge g, type_of(g, conditional), incoming

# An `if` that gives a value merges those of its branches as then/else does; one that gives none
# runs as a statement, which releases the values its branches discard.
export const generate_if_value = (g: Generator, if_expression: If) ->
  if is_kind(type_of(g, if_expression), 'void')
    generate_if g, if_expression
    return ''
  const ir = g.ir
  const condition = generate_condition_of(g, if_expression.condition)
  const then_label = ir.fresh_label('if.then')
  const else_label = ir.fresh_label('if.else')
  const end_label = ir.fresh_label('if.end')
  ir.emit "br i1 #{condition.test}, label %#{then_label}, label %#{else_label}"
  const branch = (
    label: String, body: Array<Statement>, define: (Map<String, CodegenLocal>) -> void
  ) ->
    ir.start_block label
    const operand = generate_block_value(g, body, define)
    const from = ir.current_block
    ir.emit "br label %#{end_label}"
    "[ #{operand == '' then 'poison' else operand}, %#{from} ]"
  const incoming = [
    branch(then_label, if_expression.then_body, condition.define)
    branch(else_label, if_expression.else_body, no_locals)
  ]
  ir.start_block end_label
  merge g, type_of(g, if_expression), incoming

# The value of the arms at their end block: none for void, and none that comes for never.
export const merge = (g: Generator, type: Type, incoming: Array<String>) ->
  case
    when is_kind(type, 'void') then ''
    when is_kind(type, 'never') then 'poison'
    else g.ir.assign("phi #{ir_type(type)} #{incoming.join(', ')}")

# An i1 that holds when any of the arm's patterns matches.
const generate_test = (g: Generator, arm: CaseArm, subject_type: Type?, operand: String) ->
  const type = subject_type ? return generate_condition(g, arm.patterns[0])
  const test_of = (pattern: Expression) ->
    if type is OptionalType
      return emit_is_nil(g.ir, operand, type) if pattern is NilLiteral
      const test_value = (value: String) -> pattern_test(g, value, type.inner, pattern)
      return emit_present_test(g.ir, operand, type, test_value)
    pattern_test g, operand, type, pattern
  const tests = [test_of(pattern) for pattern in arm.patterns]
  var all = tests[0]
  all = g.ir.assign("or i1 #{all}, #{tests[i]}") for i in 1...tests.length
  all

const pattern_test = (g: Generator, subject: String, type: Type, pattern: Expression) ->
  if type is UnionType
    emit_type_test(g.ir, subject, type_of(g, pattern))
  else
    value_test(g, subject, type, pattern)

# The subject is borrowed by the comparison, as it is tested again by the next patterns.
const value_test = (g: Generator, subject: String, type: Type, pattern: Expression) ->
  const value = generate(g, pattern)
  if not is_kind(type, 'String')
    return g.ir.assign("icmp eq #{ir_type(type)} #{subject}, #{value}")
  const equal = emit_string_equals(g.ir, subject, value)
  emit_release g.ir, value
  equal
