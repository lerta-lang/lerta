# Loops over a call of a function that yields, which generate its body in place, and loops over a
# lazy comprehension, which go through its source and generate its functions in place, so that no
# Iter or coroutine is made (see docs/internals.md#fused-loops).
import
  Assignment, Binding, Call, Case, Comprehension, Condition, Declaration, Expression, For,
  FunctionLiteral, Identifier, If, Member, operands_of, Position, Statement, Try, While, Yield
from '../ast'
import extended_type from '../checker/extensions'
import Method from '../checker/member_targets'
import ExtensionSource from '../checker/methods'
import FunctionReference from '../checker/references'
import arguments_of from '../checker/shared'
import generate_loop_body, iterated from './control_flow'
import emit_traced_unwind, TRACE_PUSH from './exceptions'
import generate, held_value, type_at_use, type_of from './expression'
import nan_free_operations from './float_ranges'
import all_but_last from '../arrays'
import
  generate_block_value, generate_block_with, generate_last_statement, generate_statements,
  no_locals, release_scope, store_in_slot
from './function'
import emit_when from './ir_builder'
import referred_local from './references'
import CodegenLocal, deferred_value, Generator, locate, trace_name, ValueLocal from './generator'
import function_type_of from './closure'
import BUILTINS_MODULE from '../loader'
import InterfaceType, iterable_item, Type, void_type from '../types'

# A call of a function that yields, of the module, which a loop takes in place: the function's
# literal and name, and the arguments.
export struct FusedCall
  literal: FunctionLiteral
  name: String
  args: Expression[]
  yields: Int

# The most copies of a loop's body that taking functions in place may make: each yield of the
# function generates the body, and a loop in that body that takes another function in place copies
# that function's yields as many times over.
MOST_COPIES := 8

# The call, if a loop can take it in place: a call of a top-level function of the module that
# yields, not generic, given every argument, and not being taken in place already, as a recursive
# one would be, within MOST_COPIES, and none of whose yields is in an expression (see
# yield_count), so that it holds no temporaries where it yields.
export fused_call := (g: Generator, iterable: Expression): FusedCall? ->
  return nil if iterable is not Call or g.facts.instances[iterable] != nil
  callee := iterable.callee as Identifier ? return nil
  reference := g.facts.references[callee] as FunctionReference ? return nil
  return nil if reference.module_index != g.code.module.index
  literal := top_level_function(g, reference.name) ? return nil
  return nil if not literal.yields or not literal.type_params.is_empty()
  yields := yield_count(literal.body) ? return nil
  return nil if literal in g.fused or g.fused_copies * yields > MOST_COPIES
  args := arguments_of(g.facts, iterable)
  return nil if args.length != literal.params.length
  { literal, args, yields, name: reference.name }

top_level_function := (g: Generator, name: String) ->
  for statement in g.code.module.program
    continue if statement is not Declaration or statement.name.name != name
    return statement.value as FunctionLiteral?
  nil

# Runs `body` for each item that the call yields, with `variable` bound to it. The arguments are
# held for the loop. The function's body is generated by a generator of its own, which shares the
# IR: at each yield, the loop's body is generated by the loop's, with the function's scopes held
# under it, which a break, a return or an exception out of the body releases.
export generate_fused_loop := (
  g: Generator, fused: FusedCall, item: Type, variable: Identifier, body: () -> void
) ->
  ir := g.ir
  position := g.position
  { literal, name, args } := fused
  arguments_scope := g.locals.push()
  operands: String[]
  for arg, i in args
    operand := generate(g, arg)
    arguments_scope["(fused argument #{i})"] = store_in_slot(g, operand, type_at_use(g, arg))
    operands.push operand
  exit_label := ir.fresh_label('fused.exit')
  outer_depth := g.locals.depth()
  code := g.code
  # A top-level function that is not generic is checked with its module's facts and extensions,
  # whatever the loop's are.
  { extensions, facts } := code.shared
  inner := Generator
    code
    extensions
    facts
    ir
    function_name: trace_name(name, nil)
    top_level_code: false
  inner.fused = [g.fused..., literal]
  # The function's body is copied as many times as the loop; the loop's body, once more for each
  # yield.
  inner.fused_copies = g.fused_copies
  copies := g.fused_copies * fused.yields
  inner.nan_free = nan_free_operations(facts, literal.body, false)
  # The function's exception goes on from the loop, as from a call there.
  unwind := ->
    inner_position := g.position
    locate g, position
    emit_traced_unwind g, TRACE_PUSH
    locate g, inner_position
  inner.fused_exit = { unwind, label: exit_label }
  # The function's scopes, which its generator holds, are captured rather than the generator, which
  # holds the function. Their names cannot be written in the source, so that the loop's body finds
  # none of the function's locals.
  inner_locals := inner.locals
  inner.on_yield = (value) ->
    for scope in inner_locals.scopes
      held := g.locals.push()
      held["(fused #{local_name})"] = local for (local_name, local) in scope.entries()
    resume_label := ir.fresh_label('fused.resume')
    define := (scope: Map<String, CodegenLocal>) ->
      scope[variable.name] = store_in_slot(g, value, item)
    # A loop in the body that takes a function in place copies what this one has copied.
    outer_copies := g.fused_copies
    g.fused_copies = copies
    generate_loop_body g, body, exit_label, resume_label, define, outer_depth
    g.fused_copies = outer_copies
    ir.emit "br label %#{resume_label}"
    ir.start_block resume_label
    g.locals.scopes.truncate outer_depth
  params := function_type_of(type_of(inner, literal)).params
  scope := inner.locals.push()
  for param, i in literal.params
    scope[param.name.name] = ValueLocal(operand: operands[i], type: params[i])
  generate_statements inner, all_but_last(literal.body)
  generate_last_statement inner, literal.body, void_type
  inner.locals.pop()
  ir.start_block exit_label
  locate g, position
  release_scope g, arguments_scope
  g.locals.pop()

# How many yields the statements hold, but for those of the function literals in them, which yield
# for themselves; nil if one is in an expression, in a block of an `if`, a `case` or a `try` that
# gives a value, where the function may hold temporaries as it yields.
yield_count := (statements: Statement[]): Int? ->
  var count = 0
  count += yields_of(statement) ? return nil for statement in statements
  count

yields_of := (statement: Statement): Int? ->
  case statement
    when Yield then not has_yield(statement.value) then 1
    when If
      return nil if condition_yields(statement.condition)
      count_in [statement.then_body, statement.else_body]
    when While
      return nil if condition_yields(statement.condition)
      yield_count statement.body
    when For
      return nil if has_yield(statement.iterable)
      yield_count statement.body
    when Case
      subject := statement.subject
      return nil if subject != nil and has_yield(subject)
      return nil if statement.arms.any((arm) -> arm.patterns.any(has_yield))
      count_in [(arm.body for arm in statement.arms)..., statement.otherwise ? []]
    when Try
      bodies := [
        statement.body
        (clause.body for clause in statement.catches)...
        statement.finally_body ? []
      ]
      count_in bodies
    when Declaration then not has_yield(statement.value) then 0
    when Assignment then not has_yield(statement.value) and not has_yield(statement.target) then 0
    else
      expression := statement as Expression ? return 0
      not has_yield(expression) then 0

count_in := (bodies: Statement[][]) ->
  statements: Statement[]
  statements.append body for body in bodies
  yield_count statements

# Whether the expression yields, in its operands or in the blocks it holds, but for those of the
# function literals in it.
has_yield := (expression: Expression): Bool ->
  case expression
    when FunctionLiteral then false
    when Yield then true
    when If, Case, Try then yields_of(expression) != 0
    else operands_of(expression).any(has_yield)

condition_yields := (condition: Condition) ->
  has_yield condition is Binding then condition.value else condition

# The items of a lazy comprehension, or of a call of an Iterable's `map` or `filter` given a
# function literal, as a loop goes through them in place: the source, the guard and the element as
# functions of the source's item, the type of the items, and where it is.
export struct LazySource
  source: Expression
  guard: FunctionLiteral?
  element: FunctionLiteral?
  item: Type
  position: Position

# The lazy source, if a loop can go through its source and take its functions in place: a
# comprehension of no index and no bindings, or a call of `map` or `filter` of std:builtins, which
# are written as such comprehensions, over a range, an array or an Iter; whose functions capture
# nothing weakly.
export fused_comprehension := (g: Generator, iterable: Expression) ->
  lazy := lazy_source(g, iterable) ? return nil
  takes_in_place := (literal: FunctionLiteral?) ->
    return true if literal == nil
    captures := g.facts.captures[literal] ? []
    not literal.weak and not captures.any((capture) -> capture.is_weak)
  takes_in_place(lazy.guard) and takes_in_place(lazy.element) then lazy

lazy_source := (g: Generator, iterable: Expression): LazySource? ->
  return nil if iterable is not Comprehension and iterable is not Call
  item := iterable_item(type_of(g, iterable)) ? return nil
  if iterable is Comprehension
    return nil if iterable.index != nil or not iterable.bindings.is_empty()
    lazy := iterable.lazy ? return nil
    source := iterated(g, iterable.iterable)
    { position } := iterable
    return { source, item, position, guard: lazy.guard, element: lazy.element }
  (name, receiver, literal) := std_iterable_call(g, iterable) ? return nil
  return nil if iterable_item(type_of(g, receiver)) == nil
  position := (iterable as Call!).position
  case name
    when 'map' then { item, position, source: receiver, guard: nil, element: literal }
    when 'filter' then { item, position, source: receiver, guard: literal, element: nil }
    else nil

# The name, the receiver and the function literal of a call of a method of std:builtins' extend
# of Iterable that is given one.
std_iterable_call := (g: Generator, expression: Expression) ->
  return nil if expression is not Call or not expression.named_args.is_empty()
  return nil if expression.args.length != 1
  literal := expression.args[0] as FunctionLiteral ? return nil
  member := expression.callee as Member ? return nil
  target := g.facts.members[member] as Method ? return nil
  source := target.source as ExtensionSource ? return nil
  { method } := source
  return nil if not is_builtins(method.module_name)
  extended := extended_type(method) as InterfaceType ? return nil
  extended.name == 'Iterable' then (member.name.name, deferred_value(g, member.object), literal)

# Whether the module is std:builtins or one of the modules that it is made of.
export is_builtins := (module_name: String) ->
  module_name == BUILTINS_MODULE or module_name.starts_with("#{BUILTINS_MODULE}/")

# The loop over the source, where the guard's function, if any, and then the element's, if any,
# are generated in place for each item, with the item, and the loop's body with the element. The
# source's item is held under a name that the source cannot write.
export generate_fused_comprehension := (
  g: Generator, lazy: LazySource, variable: Identifier, body: () -> void,
  generate_iteration: (Expression, Identifier, () -> void) -> void
) ->
  ir := g.ir
  position := g.position
  held := Identifier(name: '(fused item)', position: lazy.position)
  each := ->
    local := g.locals.lookup(held.name)!
    item := held_value(g, local)
    element := ->
      define := (scope: Map<String, CodegenLocal>) ->
        scope[variable.name] = element_local(g, lazy, item, position)
      generate_block_with g, body, define
    if guard := lazy.guard
      emit_when ir, generate_in_place(g, guard, item, position), element
    else
      element()
  generate_iteration lazy.source, held, each

# The element, owned, or the item itself, borrowed, without an element's function.
element_local := (
  g: Generator, lazy: LazySource, item: String, position: Position?
): CodegenLocal ->
  literal := lazy.element ? return ValueLocal(operand: item, type: lazy.item)
  store_in_slot g, generate_in_place(g, literal, item, position), lazy.item

# The value of a function of one item, generated in place with the item, borrowed, as its
# parameter: by a generator of its own, named as the closure would be in traces, whose scope
# holds what the function captures as the locals of the loop's generator, and whose exception
# goes on from the loop, as from the call of the closure there.
generate_in_place := (g: Generator, literal: FunctionLiteral, item: String, position: Position?) ->
  { code, extensions, facts, ir } := g
  name := "#{g.function_name}.<anonymous>"
  inner := Generator(code, extensions, facts, ir, function_name: name, top_level_code: false)
  inner.fused = g.fused
  inner.fused_copies = g.fused_copies
  inner.unchecked_floats = g.unchecked_floats
  inner.nan_free = nan_free_operations(g.facts, literal.body, false)
  unwind := ->
    inner_position := g.position
    locate g, position
    emit_traced_unwind g, TRACE_PUSH
    locate g, inner_position
  inner.fused_exit = { unwind, label: '' }
  scope := inner.locals.push()
  for capture in g.facts.captures[literal] ? []
    scope[capture.name] = referred_local(g, capture.source, capture.name)
  type := function_type_of(type_of(g, literal))
  scope[literal.params[0].name.name] = ValueLocal(operand: item, type: type.params[0])
  value := generate_block_value(inner, literal.body, no_locals)
  inner.locals.pop()
  value
