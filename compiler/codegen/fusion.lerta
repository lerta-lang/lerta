# Loops over a call of a function that yields, which generate its body in place, so that no Iter
# or coroutine is made (see docs/internals.md#fused-loops).
import
  Assignment, Binding, Call, Case, Condition, Declaration, Expression, For, FunctionLiteral,
  Identifier, If, operands_of, Statement, Try, While, Yield
from '../ast'
import FunctionReference from '../checker/references'
import arguments_of from '../checker/shared'
import generate_loop_body from './control_flow'
import emit_traced_unwind, TRACE_PUSH from './exceptions'
import generate, type_at_use, type_of from './expression'
import nan_free_operations from './float_ranges'
import all_but_last from '../arrays'
import generate_last_statement, generate_statements, release_scope, store_in_slot from './function'
import CodegenLocal, Generator, locate, trace_name, ValueLocal from './generator'
import function_type_of from './closure'
import Type, void_type from '../types'

# A call of a function that yields, of the module, which a loop takes in place: the function's
# literal and name, and the arguments.
export struct FusedCall
  literal: FunctionLiteral
  name: String
  args: Expression[]
  yields: Int

# The most copies of a loop's body that taking functions in place may make: each yield of the
# function generates the body, and a loop in that body that takes another function in place copies
# that function's yields as many times over.
MOST_COPIES := 8

# The call, if a loop can take it in place: a call of a top-level function of the module that
# yields, not generic, given every argument, and not being taken in place already, as a recursive
# one would be, within MOST_COPIES, and none of whose yields is in an expression (see
# yield_count), so that it holds no temporaries where it yields.
export fused_call := (g: Generator, iterable: Expression): FusedCall? ->
  return nil if iterable is not Call or g.facts.instances[iterable] != nil
  callee := iterable.callee as Identifier ? return nil
  reference := g.facts.references[callee] as FunctionReference ? return nil
  return nil if reference.module_index != g.code.module.index
  literal := top_level_function(g, reference.name) ? return nil
  return nil if not literal.yields or not literal.type_params.is_empty()
  yields := yield_count(literal.body) ? return nil
  return nil if literal in g.fused or g.fused_copies * yields > MOST_COPIES
  args := arguments_of(g.facts, iterable)
  return nil if args.length != literal.params.length
  { literal, args, yields, name: reference.name }

top_level_function := (g: Generator, name: String) ->
  for statement in g.code.module.program
    continue if statement is not Declaration or statement.name.name != name
    return statement.value as FunctionLiteral?
  nil

# Runs `body` for each item that the call yields, with `variable` bound to it. The arguments are
# held for the loop. The function's body is generated by a generator of its own, which shares the
# IR: at each yield, the loop's body is generated by the loop's, with the function's scopes held
# under it, which a break, a return or an exception out of the body releases.
export generate_fused_loop := (
  g: Generator, fused: FusedCall, item: Type, variable: Identifier, body: () -> void
) ->
  ir := g.ir
  position := g.position
  { literal, name, args } := fused
  arguments_scope := g.locals.push()
  operands: String[]
  for arg, i in args
    operand := generate(g, arg)
    arguments_scope["(fused argument #{i})"] = store_in_slot(g, operand, type_at_use(g, arg))
    operands.push operand
  exit_label := ir.fresh_label('fused.exit')
  outer_depth := g.locals.depth()
  code := g.code
  # A top-level function that is not generic is checked with its module's facts and extensions,
  # whatever the loop's are.
  { extensions, facts } := code.shared
  inner := Generator
    code
    extensions
    facts
    ir
    function_name: trace_name(name, nil)
    top_level_code: false
  inner.fused = [g.fused..., literal]
  # The function's body is copied as many times as the loop; the loop's body, once more for each
  # yield.
  inner.fused_copies = g.fused_copies
  copies := g.fused_copies * fused.yields
  inner.nan_free = nan_free_operations(facts, literal.body, false)
  # The function's exception goes on from the loop, as from a call there.
  unwind := ->
    inner_position := g.position
    locate g, position
    emit_traced_unwind g, TRACE_PUSH
    locate g, inner_position
  inner.fused_exit = { unwind, label: exit_label }
  # The function's scopes, which its generator holds, are captured rather than the generator, which
  # holds the function. Their names cannot be written in the source, so that the loop's body finds
  # none of the function's locals.
  inner_locals := inner.locals
  inner.on_yield = (value) ->
    for scope in inner_locals.scopes
      held := g.locals.push()
      held["(fused #{local_name})"] = local for (local_name, local) in scope.entries()
    resume_label := ir.fresh_label('fused.resume')
    define := (scope: Map<String, CodegenLocal>) ->
      scope[variable.name] = store_in_slot(g, value, item)
    # A loop in the body that takes a function in place copies what this one has copied.
    outer_copies := g.fused_copies
    g.fused_copies = copies
    generate_loop_body g, body, exit_label, resume_label, define, outer_depth
    g.fused_copies = outer_copies
    ir.emit "br label %#{resume_label}"
    ir.start_block resume_label
    g.locals.scopes.truncate outer_depth
  params := function_type_of(type_of(inner, literal)).params
  scope := inner.locals.push()
  for param, i in literal.params
    scope[param.name.name] = ValueLocal(operand: operands[i], type: params[i])
  generate_statements inner, all_but_last(literal.body)
  generate_last_statement inner, literal.body, void_type
  inner.locals.pop()
  ir.start_block exit_label
  locate g, position
  release_scope g, arguments_scope
  g.locals.pop()

# How many yields the statements hold, but for those of the function literals in them, which yield
# for themselves; nil if one is in an expression, in a block of an `if`, a `case` or a `try` that
# gives a value, where the function may hold temporaries as it yields.
yield_count := (statements: Statement[]): Int? ->
  var count = 0
  count += yields_of(statement) ? return nil for statement in statements
  count

yields_of := (statement: Statement): Int? ->
  case statement
    when Yield then not has_yield(statement.value) then 1
    when If
      return nil if condition_yields(statement.condition)
      count_in [statement.then_body, statement.else_body]
    when While
      return nil if condition_yields(statement.condition)
      yield_count statement.body
    when For
      return nil if has_yield(statement.iterable)
      yield_count statement.body
    when Case
      subject := statement.subject
      return nil if subject != nil and has_yield(subject)
      return nil if statement.arms.any((arm) -> arm.patterns.any(has_yield))
      count_in [(arm.body for arm in statement.arms)..., statement.otherwise ? []]
    when Try
      bodies := [
        statement.body
        (clause.body for clause in statement.catches)...
        statement.finally_body ? []
      ]
      count_in bodies
    when Declaration then not has_yield(statement.value) then 0
    when Assignment then not has_yield(statement.value) and not has_yield(statement.target) then 0
    else
      expression := statement as Expression ? return 0
      not has_yield(expression) then 0

count_in := (bodies: Statement[][]) ->
  statements: Statement[]
  statements.append body for body in bodies
  yield_count statements

# Whether the expression yields, in its operands or in the blocks it holds, but for those of the
# function literals in it.
has_yield := (expression: Expression): Bool ->
  case expression
    when FunctionLiteral then false
    when Yield then true
    when If, Case, Try then yields_of(expression) != 0
    else operands_of(expression).any(has_yield)

condition_yields := (condition: Condition) ->
  has_yield condition is Binding then condition.value else condition
