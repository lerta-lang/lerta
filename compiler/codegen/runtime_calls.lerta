# Calls to runtime C functions: those that externs declare, and those that a module lists by its
# signature.
import { IrBuilder } from './ir_builder'
import { ir_c_return_type, ir_param_type } from './lerta_ir'
import { FunctionType, is_kind, Type } from '../types'

# Calls a runtime function; the value of one that never returns is poison (see
# emit_valueless_call).
export const emit_runtime_call = (
  ir: IrBuilder, symbol: String, type: FunctionType, args: Array<String>
) ->
  const params = [ir_param_type(param) for param in type.params].join(', ')
  const result = ir_c_return_type(type.result)
  ir.module.declare symbol, "declare #{result} @#{symbol}(#{params})"
  const arg_list = ["#{ir_param_type(type.params[i])} #{args[i]}" for i in 0...args.length]
  const call = "call #{result} @#{symbol}(#{arg_list.join(', ')})"
  return ir.assign(call) if result != 'void'
  emit_valueless_call ir, call, type.result

# Emits a call that gives no value, of a void function, or of a never one, which returns only
# with an exception pending, for the caller's check to take: its value is poison, which nothing
# reads.
export const emit_valueless_call = (ir: IrBuilder, call: String, result: Type) ->
  ir.emit call
  is_kind(result, 'never') then 'poison' else ''

# Declares and calls the function of the signature, as in `i64 @f(ptr, i64)`, giving its result,
# or '' for void.
export const call_runtime = (ir: IrBuilder, signature: String, args: String) ->
  const parts = signature.split(' @')
  const result_type = parts[0]
  const name = parts[1].split('(')[0]
  ir.module.declare name, "declare #{signature}"
  const instruction = "call #{result_type} @#{name}(#{args})"
  return ir.assign(instruction) if result_type != 'void'
  ir.emit instruction
  ''
