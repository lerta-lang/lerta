# The protocol of Iters in the generated code (see docs/internals/iteration.md#iter).
import
  access_tag, define_heap_object, emit_heap_allocate, emit_heap_field_pointer, emit_laundered,
  fixed, HeapField, heap_object_type, plain_field, value_field
from './heap_object'
import emit_branch, emit_when, IrBuilder, IrModule from './ir_builder'
import emit_check_with from './exceptions'
import ir_type, ownership, suffixed_symbol from './lerta_ir'
import call_void_runtime from './runtime_calls'
import Type from '../types'

# The fields every Iter starts with: the code of next, which is fixed (see invariant), whether a
# traversal has started, and the item that the method has_next took from next, if it holds one.
# Those of any Iter of an item type are reached through the layout of these fields.
CODE := fixed(plain_field('ptr'))
NEXT_FIELD := 0
STARTED_FIELD := 1
HELD_FIELD := 2
HELD_ITEM_FIELD := 3

protocol := (item: Type) -> [CODE, plain_field('i1'), plain_field('i1'), value_field(item)]

protocol_layout := (item: Type) -> heap_object_type(protocol(item))

# A kind of Iter: its LLVM struct type, its item type, and the fields of its state.
export struct IterKind
  layout: String
  item: Type
  state: HeapField[]

# The code of a kind is the body of next, which gets the Iter as `%iter` and returns a step: an i1
# that tells whether it gives an item, and the item, owned. Past the end it gives none, again each
# time it is called.
type IterCode = (IrBuilder, IterKind) -> void

step_type := (item: Type) -> "{ i1, #{ir_type(item)} }"

symbol_of := (kind: IterKind, part: String) -> suffixed_symbol(kind.layout, part)

all_fields := (kind: IterKind) -> protocol(kind.item) + kind.state

# The kind of `key`, defined with the type of its Iters and code the first time it is given.
export define_kind := (
  ir: IrBuilder, key: String, state: HeapField[], item: Type, next: IterCode
) ->
  define := (layout: String, module: IrModule) ->
    kind := IterKind(layout, item, state)
    type := symbol_of(kind, 'type')
    define_heap_object module, layout, type, 'private ', all_fields(kind), 'Iter'
    body := IrBuilder(module)
    next body, kind
    body.finish "private #{step_type(item)} #{symbol_of(kind, 'next')}(ptr %iter)"
  IterKind(item, state, layout: ir.module.named("iter #{key}", '%lerta.iter', define))

# Returns the item, owned, from next.
export emit_give := (body: IrBuilder, kind: IterKind, item: String) ->
  type := step_type(kind.item)
  item_type := ir_type(kind.item)
  given :=
    body.assign("insertvalue #{type} { i1 true, #{item_type} poison }, #{item_type} #{item}, 1")
  body.emit "ret #{type} #{given}"

# Returns from next without an item, at the end or when it throws.
export emit_end := (body: IrBuilder, kind: IterKind) ->
  body.emit "ret #{step_type(kind.item)} zeroinitializer"

export emit_check_or_end := (body: IrBuilder, kind: IterKind) ->
  emit_check_with body, -> emit_end(body, kind)

export emit_end_unless := (body: IrBuilder, kind: IterKind, condition: String) ->
  end_label := body.fresh_label('iter.end')
  go_label := body.fresh_label('iter.go')
  body.branch_if condition, go_label, end_label
  body.start_block end_label
  emit_end body, kind
  body.start_block go_label

# Throws an IterError unless the condition holds, which `check` then finds.
emit_throw_unless := (ir: IrBuilder, condition: String, check: () -> void) ->
  ended_label := ir.fresh_label('iter.ended')
  go_label := ir.fresh_label('iter.go')
  ir.branch_if condition, go_label, ended_label
  ir.start_block ended_label
  call_void_runtime ir, 'void @lerta_raise_iter_ended()', ''
  check()
  ir.emit 'unreachable'
  ir.start_block go_label

# A new Iter of the kind, not started, which takes over the values of its state.
export emit_iter := (ir: IrBuilder, kind: IterKind, state_values: String[]) ->
  iter := emit_laundered(ir, emit_heap_allocate(ir, kind.layout, symbol_of(kind, 'type')))
  values := [symbol_of(kind, 'next'), 'false', 'false', 'zeroinitializer', state_values...]
  for field at i in all_fields(kind)
    pointer := emit_heap_field_pointer(ir, kind.layout, iter, i)
    ir.store field.ir_type, values[i], pointer, access_tag(ir, field)
  iter

state_pointer := (ir: IrBuilder, kind: IterKind, index: Int) ->
  emit_heap_field_pointer(ir, kind.layout, '%iter', protocol(kind.item).length + index)

export load_state := (ir: IrBuilder, kind: IterKind, index: Int) ->
  field := kind.state[index]
  pointer := state_pointer(ir, kind, index)
  ir.load(field.ir_type, pointer, access_tag(ir, field))

export store_state := (ir: IrBuilder, kind: IterKind, index: Int, value: String) ->
  field := kind.state[index]
  panic "the fixed field #{index} of an Iter is written after it is made" if field.fixed
  pointer := state_pointer(ir, kind, index)
  ir.store field.ir_type, value, pointer

protocol_field := (ir: IrBuilder, iter: String, item: Type, index: Int) ->
  emit_heap_field_pointer(ir, protocol_layout(item), iter, index)

# What a call of next gave: whether there was an item, and the item, owned, which is one only then.
export struct Step
  more: String
  item: String

# A call of the next of a borrowed Iter, whose kind's code may throw.
export emit_step := (ir: IrBuilder, iter: String, item: Type) ->
  code := ir.load('ptr', protocol_field(ir, iter, item, NEXT_FIELD), access_tag(ir, CODE))
  step := ir.assign("call #{step_type(item)} #{code}(ptr #{iter})")
  Step(
    more: ir.assign("extractvalue #{step_type(item)} #{step}, 0")
    item: ir.assign("extractvalue #{step_type(item)} #{step}, 1")
  )

# Starts a traversal, which throws if the Iter has started one.
export emit_iter_start := (ir: IrBuilder, iter: String, item: Type) ->
  started := protocol_field(ir, iter, item, STARTED_FIELD)
  call_void_runtime ir, 'void @lerta_start_traversal(ptr)', "ptr #{started}"

# Runs `body` for each item, owned, of a borrowed Iter whose traversal has started. `body` gets the
# item and the labels that leave the loop and go on to the next item.
# `check` runs after each call, which may throw.
export emit_iter_loop := (
  ir: IrBuilder, iter: String, item: Type, body: (String, String, String) -> void, check: () -> void
) ->
  header_label := ir.fresh_label('iter.header')
  body_label := ir.fresh_label('iter.body')
  exit_label := ir.fresh_label('iter.exit')
  ir.branch header_label
  ir.start_block header_label
  step := emit_step(ir, iter, item)
  check()
  ir.branch_if step.more, body_label, exit_label
  ir.start_block body_label
  body step.item, exit_label, header_label
  ir.branch header_label
  ir.start_block exit_label

# The methods of a borrowed Iter, which go on with one traversal, so that it cannot be started
# again. has_next holds the item it takes from next, until the method next gives it.
export emit_has_next_method := (ir: IrBuilder, iter: String, item: Type, check: () -> void) ->
  emit_mark_started ir, iter, item
  held := protocol_field(ir, iter, item, HELD_FIELD)
  take := ->
    step := emit_step(ir, iter, item)
    check()
    emit_when ir, step.more, ->
      ir.store ir_type(item), step.item, protocol_field(ir, iter, item, HELD_ITEM_FIELD)
      ir.store 'i1', 'true', held
    step.more
  emit_branch(ir, 'i1', ir.negate(ir.load('i1', held)), take, 'true')

# Past the end, next throws.
export emit_next_method := (ir: IrBuilder, iter: String, item: Type, check: () -> void) ->
  emit_mark_started ir, iter, item
  held := protocol_field(ir, iter, item, HELD_FIELD)
  held_item := protocol_field(ir, iter, item, HELD_ITEM_FIELD)
  is_held := ir.load('i1', held)
  held_value := ir.load(ir_type(item), held_item)

  # The held item passes to the caller; a reference is cleared, so that the drop does not release
  # it. One not held is cleared already.
  ir.store 'i1', 'false', held
  if ownership(item) != NONE
    ir.store ir_type(item), 'zeroinitializer', held_item
  take := ->
    step := emit_step(ir, iter, item)
    check()
    emit_throw_unless ir, step.more, check
    step.item
  emit_branch(ir, ir_type(item), ir.negate(is_held), take, held_value)

emit_mark_started := (ir: IrBuilder, iter: String, item: Type) ->
  ir.store 'i1', 'true', protocol_field(ir, iter, item, STARTED_FIELD)
