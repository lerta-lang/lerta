# The protocol of Iters in the generated code (see docs/internals.md#iter).
import
  define_heap_object, emit_heap_allocate, emit_heap_field_pointer, HeapField, heap_object_type,
  plain_field
from './heap_object'
import IrBuilder, IrModule from './ir_builder'
import ir_type, suffixed_symbol from './lerta_ir'
import call_void_runtime from './runtime_calls'
import Type from '../types'

# The fields every Iter starts with, and the layout through which those of any Iter are reached.
PROTOCOL := [plain_field('ptr'), plain_field('ptr'), plain_field('i1')]
HAS_NEXT_FIELD := 0
NEXT_FIELD := 1
STARTED_FIELD := 2
PROTOCOL_LAYOUT := heap_object_type(PROTOCOL)

# A kind of Iter: its LLVM struct type, and the fields of its state.
export struct IterKind(layout: String, state: HeapField[])

# The code of a kind is the bodies of has_next, which returns an i1, and of next, which returns the
# item and runs only when has_next is true. They get the Iter as `%iter`.
type IterCode = (IrBuilder, IterKind) -> void

symbol_of := (kind: IterKind, part: String) -> suffixed_symbol(kind.layout, part)

all_fields := (kind: IterKind) -> [PROTOCOL..., kind.state...]

# The kind of `key`, defined with the type of its Iters and code the first time it is given. Its
# next does not check for the end: its callers ask has_next first (see emit_checked_next).
export define_kind := (
  ir: IrBuilder, key: String, state: HeapField[], item: Type, has_next: IterCode, next: IterCode
) ->
  define := (layout: String, module: IrModule) ->
    kind := IterKind(layout, state)
    type := symbol_of(kind, 'type')
    define_heap_object module, layout, type, 'private ', all_fields(kind), 'Iter', nil, nil
    has_next_body := IrBuilder(module)
    has_next has_next_body, kind
    has_next_body.finish "private i1 #{symbol_of(kind, 'has_next')}(ptr %iter)"
    next_body := IrBuilder(module)
    next next_body, kind
    next_body.finish "private #{ir_type(item)} #{symbol_of(kind, 'next')}(ptr %iter)"
  IterKind state, layout: ir.module.named("iter #{key}", '%lerta.iter', define)

# Throws an IterError unless the condition holds, which `check` then finds.
emit_throw_unless := (ir: IrBuilder, condition: String, check: () -> void) ->
  ended_label := ir.fresh_label('iter.ended')
  go_label := ir.fresh_label('iter.go')
  ir.emit "br i1 #{condition}, label %#{go_label}, label %#{ended_label}"
  ir.start_block ended_label
  call_void_runtime ir, 'void @lerta_raise_iter_ended()', ''
  check()
  ir.emit 'unreachable'
  ir.start_block go_label

# A new Iter of the kind, not started, which takes over the values of its state.
export emit_iter := (ir: IrBuilder, kind: IterKind, state_values: String[]) ->
  iter := emit_heap_allocate(ir, kind.layout, symbol_of(kind, 'type'))
  values := [symbol_of(kind, 'has_next'), symbol_of(kind, 'next'), 'false', state_values...]
  fields := all_fields(kind)
  for field, i in fields
    pointer := emit_heap_field_pointer(ir, kind.layout, iter, i)
    ir.emit "store #{field.ir_type} #{values[i]}, ptr #{pointer}"
  iter

state_pointer := (ir: IrBuilder, kind: IterKind, index: Int) ->
  emit_heap_field_pointer ir, kind.layout, '%iter', PROTOCOL.length + index

export load_state := (ir: IrBuilder, kind: IterKind, index: Int) ->
  pointer := state_pointer(ir, kind, index)
  ir.assign "load #{kind.state[index].ir_type}, ptr #{pointer}"

export store_state := (ir: IrBuilder, kind: IterKind, index: Int, value: String) ->
  pointer := state_pointer(ir, kind, index)
  ir.emit "store #{kind.state[index].ir_type} #{value}, ptr #{pointer}"

protocol_field := (ir: IrBuilder, iter: String, index: Int) ->
  emit_heap_field_pointer ir, PROTOCOL_LAYOUT, iter, index

# Whether the Iter, which is borrowed, has a next item.
export emit_has_next := (ir: IrBuilder, iter: String) ->
  code := ir.assign("load ptr, ptr #{protocol_field(ir, iter, HAS_NEXT_FIELD)}")
  ir.assign "call i1 #{code}(ptr #{iter})"

# The next item, owned, of a borrowed Iter whose has_next is true.
export emit_next := (ir: IrBuilder, iter: String, item: Type) ->
  code := ir.assign("load ptr, ptr #{protocol_field(ir, iter, NEXT_FIELD)}")
  ir.assign "call #{ir_type(item)} #{code}(ptr #{iter})"

# The next item, owned, of a borrowed Iter, which code outside the Iters asks for without knowing
# that there is one: past the end, it throws.
# `check` runs after each call, which may throw.
export emit_checked_next := (ir: IrBuilder, iter: String, item: Type, check: () -> void) ->
  more := emit_has_next(ir, iter)
  check()
  emit_throw_unless ir, more, check
  emit_next ir, iter, item

# Starts a traversal, which throws if the Iter has started one.
export emit_iter_start := (ir: IrBuilder, iter: String) ->
  call_void_runtime ir, 'void @lerta_iter_start(ptr)', "ptr #{iter}"

# Runs `body` for each item, owned, of a borrowed Iter whose traversal has started. `body` gets the
# item and the labels that leave the loop and go on to the next item.
export emit_iter_loop := (
  ir: IrBuilder, iter: String, item: Type, body: (String, String, String) -> void, check: () -> void
) ->
  header_label := ir.fresh_label('iter.header')
  body_label := ir.fresh_label('iter.body')
  exit_label := ir.fresh_label('iter.exit')
  ir.emit "br label %#{header_label}"
  ir.start_block header_label
  more := emit_has_next(ir, iter)
  check()
  ir.emit "br i1 #{more}, label %#{body_label}, label %#{exit_label}"
  ir.start_block body_label
  value := emit_next(ir, iter, item)
  check()
  body value, exit_label, header_label
  ir.emit "br label %#{header_label}"
  ir.start_block exit_label

# Calling has_next or next traverses the Iter, so that it cannot be traversed again.
export emit_mark_started := (ir: IrBuilder, iter: String) ->
  ir.emit "store i1 true, ptr #{protocol_field(ir, iter, STARTED_FIELD)}"
