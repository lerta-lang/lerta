# Operations on Strings and Binaries in the generated code, through the runtime (runtime/string.c
# and runtime/binary.c), or read in place, as a LertaString of runtime/lerta.h lays them out.
import emit_branch, IrBuilder from './ir_builder'
import emit_release, string_layout from './lerta_ir'
import call_runtime from './runtime_calls'
import is_kind, Type from '../types'

# A String holding the parts, which are owned Strings, one after another; the runtime takes the
# parts, and extends in place the longest that nothing else holds and whose place has room for the
# result, if any.
export emit_concat := (ir: IrBuilder, parts: String[]) ->
  ir.module.declare 'lerta_string_concat_taken', 'declare ptr @lerta_string_concat_taken(i64, ...)'
  args := ["ptr #{part}" for part in parts].join(', ')
  call := "call ptr (i64, ...) @lerta_string_concat_taken(i64 #{parts.length}, #{args})"
  ir.assign call

# `left + right` of a String or a Binary, both owned and released, `right` being one of the same
# type or a Byte: the runtime appends in place when nothing else holds `left`.
export emit_extend := (ir: IrBuilder, left: String, right: String, right_type: Type) ->
  if is_kind(right_type, 'Byte')
    push := 'ptr @lerta_binary_push(ptr, i8 zeroext)'
    return call_runtime(ir, push, "ptr #{left}, i8 zeroext #{right}")
  result := call_runtime(ir, 'ptr @lerta_string_extend(ptr, ptr)', "ptr #{left}, ptr #{right}")
  emit_release ir, right
  result

# Whether two Strings have the same bytes; both are borrowed.
export emit_string_equals := (ir: IrBuilder, left: String, right: String) ->
  call_runtime ir, 'zeroext i1 @lerta_string_equals(ptr, ptr)', "ptr #{left}, ptr #{right}"

# Whether two owned Strings have the same bytes; both are released.
export emit_equals := (ir: IrBuilder, left: String, right: String) ->
  result := emit_string_equals(ir, left, right)
  emit_release ir, left
  emit_release ir, right
  result

LAYOUT := string_layout('[0 x i8]')
LENGTH_FIELD := 2
BYTES_FIELD := 3

export emit_binary_length := (ir: IrBuilder, binary: String) ->
  length := ir.assign("getelementptr #{LAYOUT}, ptr #{binary}, i32 0, i32 #{LENGTH_FIELD}")
  ir.assign "load i64, ptr #{length}"

# Whether the index is out of the Binary's range; compared as unsigned, a negative index is out of
# range too.
export emit_binary_out_of_range := (ir: IrBuilder, binary: String, index: String) ->
  ir.assign "icmp uge i64 #{index}, #{emit_binary_length(ir, binary)}"

# The bytes of the Binary from `start` up to `end`, copied into a new one, owned; the runtime throws
# unless 0 <= start <= end <= its length.
export emit_binary_slice := (ir: IrBuilder, binary: String, start: String, end: String) ->
  args := "ptr #{binary}, i64 #{start}, i64 #{end}"
  call_runtime ir, 'ptr @lerta_binary_slice(ptr, i64, i64)', args

# The byte at the index, which is in the Binary's range.
export emit_binary_get := (ir: IrBuilder, binary: String, index: String) ->
  byte :=
    ir.assign("getelementptr #{LAYOUT}, ptr #{binary}, i32 0, i32 #{BYTES_FIELD}, i64 #{index}")
  ir.assign "load i8, ptr #{byte}"

# As emit_binary_get, of an index that may be out of range, as `outside` tells: 0 then. The read is
# guarded rather than made after the caller's throw, as the caller releases the Binary first.
export emit_binary_get_unless := (ir: IrBuilder, binary: String, index: String, outside: String) ->
  inside := ir.assign("xor i1 #{outside}, true")
  emit_branch ir, 'i8', inside, -> emit_binary_get(ir, binary, index), '0'
