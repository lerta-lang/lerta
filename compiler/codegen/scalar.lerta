# The representation of the types whose values are not references, one row per type: the integer
# types, whose bits and sign come from types, Float, Float32, Bool and enums, whose values are the
# places of their members among them.
import IrBuilder from './ir_builder'
import integer_bits, is_signed, kind_of, SimpleType, Type, TypeKind from '../types'

export struct Scalar
  ir_type: String
  bits: Int
  signed: Bool
  is_float = default false

integer_row := (kind: TypeKind) ->
  type := SimpleType(kind)
  bits := integer_bits(type)
  Scalar bits, ir_type: "i#{bits}", signed: is_signed(type)

INT := integer_row('Int')
INT8 := integer_row('Int8')
INT16 := integer_row('Int16')
INT32 := integer_row('Int32')
BYTE := integer_row('Byte')
UINT16 := integer_row('UInt16')
UINT32 := integer_row('UInt32')
UINT64 := integer_row('UInt64')
CHAR := integer_row('Char')
BOOL := Scalar(ir_type: 'i1', bits: 1, signed: false)
# Its sign is that of no integer: its bits are a word already, and a Float32's are zero-extended.
FLOAT := Scalar(ir_type: 'double', bits: 64, signed: false, is_float: true)
FLOAT32 := Scalar(ir_type: 'float', bits: 32, signed: false, is_float: true)
# A place is never negative.
ENUM_VALUE := Scalar(ir_type: 'i64', bits: 64, signed: false)

export scalar_of := (type: Type) ->
  case kind_of(type)
    when 'Int' then INT
    when 'Int8' then INT8
    when 'Int16' then INT16
    when 'Int32' then INT32
    when 'Byte' then BYTE
    when 'UInt16' then UINT16
    when 'UInt32' then UINT32
    when 'UInt64' then UINT64
    when 'Char' then CHAR
    when 'Bool' then BOOL
    when 'Float' then FLOAT
    when 'Float32' then FLOAT32
    when ENUM then ENUM_VALUE
    else nil

# The value as an i64: a float's bits, or another value, extended by its sign.
export widened_to_word := (ir: IrBuilder, operand: String, scalar: Scalar) ->
  bits_type := "i#{scalar.bits}"
  as_bits := -> ir.assign("bitcast #{scalar.ir_type} #{operand} to #{bits_type}")
  bits := scalar.is_float then as_bits() else operand
  return bits if scalar.bits == 64
  extension := scalar.signed then 'sext' else 'zext'
  ir.assign "#{extension} #{bits_type} #{bits} to i64"

# The value from an i64, as widened_to_word gives it.
export narrowed_from_word := (ir: IrBuilder, word: String, scalar: Scalar) ->
  bits_type := "i#{scalar.bits}"
  bits := scalar.bits == 64 then word else ir.assign("trunc i64 #{word} to #{bits_type}")
  return bits if not scalar.is_float
  ir.assign "bitcast #{bits_type} #{bits} to #{scalar.ir_type}"
