# Generates operators: arithmetic, comparisons, `and`/`or`, nil tests, `!` and `?`.
import BinaryOperation, Coalesce, is_nil_test, NilLiteral, UnaryOperation, Unwrap from '../ast'
import compares_by_contents from '../checker/equality'
import is_numeric_operator from '../checker/operator'
import apply_integer_operator from './checked_int'
import holding from './exceptions'
import apply_float_arithmetic, emit_float_comparison, emit_float_negation from './float'
import generate, generate_condition, release_if_reference, type_at_use, type_of from './expression'
import emit_equals_by_contents, emit_value_equals from './equality'
import Generator from './generator'
import emit_branch from './ir_builder'
import emit_release, ir_type from './lerta_ir'
import emit_is_nil, emit_is_present, emit_unwrap from './optional'
import emit_concat, emit_equals, emit_string_equals from './string'
import throw_if, UNWRAPPED_NIL from './runtime_errors'
import
  inner_of, is_identity_type, is_integer, is_kind, is_one_of_kinds, is_reference_type, is_signed,
  OptionalType, Type
from '../types'

# The predicates of `icmp` for the comparisons of signed integers; unsigned ones, as Byte, are
# ordered as unsigned.
const SIGNED_PREDICATES =
  '==': 'eq', '!=': 'ne', '<': 'slt', '<=': 'sle', '>': 'sgt', '>=': 'sge'
const UNSIGNED_PREDICATES =
  '==': 'eq', '!=': 'ne', '<': 'ult', '<=': 'ule', '>': 'ugt', '>=': 'uge'

export const generate_unary = (g: Generator, unary: UnaryOperation) ->
  if unary.operator == 'not'
    return g.ir.assign("xor i1 #{generate_condition(g, unary.operand)}, true")
  const operand = generate(g, unary.operand)
  const type = type_of(g, unary)
  return emit_float_negation(g.ir, operand) if is_kind(type, 'Float')
  apply_integer_operator g, '-', '0', operand, type

export const generate_binary = (g: Generator, binary: BinaryOperation) ->
  const operator = binary.operator
  return generate_logical(g, binary) if operator == 'and' or operator == 'or'
  return generate_nil_test(g, binary) if is_nil_test(binary)
  const left = generate(g, binary.left)
  const operand_type = type_at_use(g, binary.left)
  const right = holding(g, left, operand_type, -> generate(g, binary.right))
  const is_string = is_kind(operand_type, 'String')
  return emit_concat(g.ir, [left, right]) if is_string and operator == '+'
  # nil is the null pointer, so optional objects compare as pointers too.
  if is_identity_type(inner_of(operand_type))
    return negate_if_unequal(g, operator, generate_same_object(g, left, right))
  if compares_by_contents(inner_of(operand_type))
    const program = g.code.program
    const equal = emit_equals_by_contents(g.ir, program, left, right, operand_type)
    emit_release g.ir, left
    emit_release g.ir, right
    return negate_if_unequal(g, operator, equal)
  if operand_type is OptionalType
    return negate_if_unequal(g, operator, generate_optional_equals(g, left, right, operand_type))
  if is_one_of_kinds(operand_type, ['String', 'Binary'])
    return negate_if_unequal(g, operator, emit_equals(g.ir, left, right))
  return apply_numeric(g, operator, left, right, operand_type) if is_numeric_operator(operator)
  return emit_float_comparison(g.ir, operator, left, right) if is_kind(operand_type, 'Float')
  const is_unsigned = is_integer(operand_type) and not is_signed(operand_type)
  const predicate = (is_unsigned then UNSIGNED_PREDICATES else SIGNED_PREDICATES)[operator]!
  g.ir.assign "icmp #{predicate} #{ir_type(operand_type)} #{left}, #{right}"

# An arithmetic operator applied to two numbers of the type: Floats, or integers.
export const apply_numeric = (
  g: Generator, operator: String, left: String, right: String, type: Type
) ->
  return apply_float_arithmetic(g, operator, left, right) if is_kind(type, 'Float')
  apply_integer_operator g, operator, left, right, type

# `!=` is the negation of the equality.
const negate_if_unequal = (g: Generator, operator: String, equal: String) ->
  operator == '!=' then g.ir.assign("xor i1 #{equal}, true") else equal

# Whether two optional values are both nil, or hold equal values; releases them. Strings and
# Binaries, which are null for nil, are compared only where both are present.
const generate_optional_equals = (g: Generator, left: String, right: String, type: OptionalType) ->
  const ir = g.ir
  const inner = type.inner
  const left_present = emit_is_present(ir, left, type)
  const right_present = emit_is_present(ir, right, type)
  const same_presence = ir.assign("icmp eq i1 #{left_present}, #{right_present}")
  if not is_reference_type(inner)
    # A nil's value is unspecified (see docs/internals.md#memory-management), so the values count
    # only where present.
    const left_value = emit_unwrap(ir, left, type)
    const right_value = emit_unwrap(ir, right, type)
    const same_value = emit_value_equals(ir, left_value, right_value, inner)
    const values_agree = ir.assign("select i1 #{left_present}, i1 #{same_value}, i1 true")
    return ir.assign("and i1 #{same_presence}, #{values_agree}")
  const both_present = ir.assign("and i1 #{left_present}, #{right_present}")
  const same_bytes = -> emit_string_equals(ir, left, right)
  const equal = emit_branch(ir, 'i1', both_present, same_bytes, same_presence)
  emit_release ir, left
  emit_release ir, right
  equal

# Whether two references are to one object; releases them.
const generate_same_object = (g: Generator, left: String, right: String) ->
  const same = g.ir.assign("icmp eq ptr #{left}, #{right}")
  emit_release g.ir, left
  emit_release g.ir, right
  same

# `x == nil` or `x != nil`.
const generate_nil_test = (g: Generator, binary: BinaryOperation) ->
  const value = binary.left is NilLiteral then binary.right else binary.left
  const operand = generate(g, value)
  const present = emit_is_present(g.ir, operand, type_of(g, value))
  release_if_reference g, value, operand
  binary.operator == '!=' then present else g.ir.assign("xor i1 #{present}, true")

# Short-circuit: the right operand is evaluated only when the left one does not decide.
const generate_logical = (g: Generator, binary: BinaryOperation) ->
  const ir = g.ir
  const left = generate_condition(g, binary.left)
  const left_block = ir.current_block
  const right_label = ir.fresh_label('logical.right')
  const end_label = ir.fresh_label('logical.end')
  const is_and = binary.operator == 'and'
  const if_true = is_and then right_label else end_label
  const if_false = is_and then end_label else right_label
  ir.emit "br i1 #{left}, label %#{if_true}, label %#{if_false}"
  ir.start_block right_label
  const right = generate_condition(g, binary.right)
  const right_block = ir.current_block
  ir.emit "br label %#{end_label}"
  ir.start_block end_label
  const decided = is_and then 'false' else 'true'
  ir.assign "phi i1 [ #{decided}, %#{left_block} ], [ #{right}, %#{right_block} ]"

# `x!` throws if x is nil.
export const generate_unwrap = (g: Generator, unwrap: Unwrap) ->
  const operand = generate(g, unwrap.operand)
  const type = type_of(g, unwrap.operand)
  throw_if g, emit_is_nil(g.ir, operand, type), UNWRAPPED_NIL
  emit_unwrap g.ir, operand, type

# The fallback is only evaluated when the value is nil.
export const generate_coalesce = (g: Generator, coalesce: Coalesce) ->
  const ir = g.ir
  const operand = generate(g, coalesce.value)
  const type = type_of(g, coalesce.value)
  const present = emit_is_present(ir, operand, type)
  const unwrapped = emit_unwrap(ir, operand, type)
  const value_block = ir.current_block
  const fallback_label = ir.fresh_label('coalesce.fallback')
  const end_label = ir.fresh_label('coalesce.end')
  ir.emit "br i1 #{present}, label %#{end_label}, label %#{fallback_label}"
  ir.start_block fallback_label
  const fallback = generate(g, coalesce.fallback)
  const fallback_block = ir.current_block
  ir.emit "br label %#{end_label}"
  ir.start_block end_label
  const incoming = "[ #{unwrapped}, %#{value_block} ], [ #{fallback}, %#{fallback_block} ]"
  ir.assign "phi #{ir_type(type_of(g, coalesce))} #{incoming}"
