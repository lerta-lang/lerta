# Generates operators: arithmetic, comparisons, `and`/`or`, nil tests, `!` and `?`.
import
  BinaryOperation, Coalesce, Expression, FloatLiteral, Identifier, IntegerLiteral, is_nil_test,
  is_order_operator, Member, NilLiteral, StringLiteral, This, UnaryOperation, Unwrap
from '../ast'
import ScopedLocal from '../checker/references'
import compares_by_contents, own_equality from '../checker/equality'
import is_numeric_operator, operator_of_method from '../checker/operator'
import apply_integer_operator from './checked_int'
import generate_borrowed, plain_field_of from './borrowing'
import generate_in_test from './call'
import holding from './exceptions'
import apply_float_arithmetic, emit_float_comparison, emit_float_negation from './float'
import generate, generate_condition, release_if_reference, type_at_use, type_of from './expression'
import emit_own_compare, GREATER, LESS from './comparison_methods'
import emit_equals_by_contents, emit_value_equals from './equality'
import Generator from './generator'
import emit_branch, IrBuilder from './ir_builder'
import emit_release, emit_retain, ir_type, string_constant from './lerta_ir'
import emit_is_nil, emit_is_present, emit_unwrap from './optional'
import emit_concat, emit_equals, emit_extend, emit_string_equals from './string'
import throw_if, UNWRAPPED_NIL from './runtime_errors'
import
  inner_of, is_float, is_identity_type, is_integer, is_kind, is_one_of_kinds, is_reference_type,
  is_signed, OptionalType, Type
from '../types'

# The predicates of `icmp` for the comparisons of signed integers; unsigned ones, as Byte, are
# ordered as unsigned.
SIGNED_PREDICATES := { '==': 'eq', '!=': 'ne', '<': 'slt', '<=': 'sle', '>': 'sgt', '>=': 'sge' }
UNSIGNED_PREDICATES := { '==': 'eq', '!=': 'ne', '<': 'ult', '<=': 'ule', '>': 'ugt', '>=': 'uge' }

export generate_unary := (g: Generator, unary: UnaryOperation) ->
  return generate(g, call) if call := g.facts.operator_calls[unary]
  if unary.operator == 'not'
    return g.ir.assign("xor i1 #{generate_condition(g, unary.operand)}, true")
  negate g, generate(g, unary.operand), type_of(g, unary)

negate := (g: Generator, operand: String, type: Type) ->
  return emit_float_negation(g.ir, operand, type) if is_float(type)
  apply_integer_operator g, '-', '0', operand, type

# The method of a number, `add` and so on, or a String's or a Binary's add, which applies its
# operator to the object and the arguments, both borrowed.
export apply_operator_method := (
  g: Generator, name: String, object: String, args: String[], type: Type
) ->
  return negate(g, object, type) if name == 'neg'
  if is_bytes(type)
    emit_retain g.ir, part for part in [object, args[0]]
    return emit_concat(g.ir, [object, args[0]])
  apply_numeric g, operator_of_method(name)!, object, args[0], type

# What `+` appends: the operand, or the call of `to_string()` that gives the text of a Char that the
# checker made (see appends_unit).
export appended := (g: Generator, operand: Expression) ->
  return call if call := g.facts.appended_texts[operand]
  operand

# An operator that applies through a method is the call of it that the checker made (see
# type_of_operator_call).
export generate_binary := (g: Generator, binary: BinaryOperation) ->
  return generate(g, call) if call := g.facts.operator_calls[binary]
  return generate_in_test(g, call) if call := g.facts.in_tests[binary]
  if call := g.facts.order_calls[binary]
    return emit_order_test(g.ir, binary.operator, generate(g, call))
  operator := binary.operator
  return generate_logical(g, binary) if operator == 'and' or operator == 'or'
  return generate_nil_test(g, binary) if is_nil_test(binary)
  return string_constant(g.ir, text) if text := constant_text(g, binary)
  # The root of a tree of float arithmetic alone checks its result, which its operands leave
  # unchecked.
  is_root := not g.defers_float_checks and float_tree(g, binary)
  g.defers_float_checks = true if is_root
  left := generate(g, binary.left)
  operand_type := type_at_use(g, binary.left)
  right_operand := appended(g, binary.right)
  right := holding(g, left, operand_type, -> generate(g, right_operand))
  g.defers_float_checks = false if is_root
  if is_bytes(operand_type) and operator == '+'
    return emit_extend(g.ir, left, right, type_at_use(g, right_operand))
  # An operation that would check its result, a tree's root or one of no tree, checks none where it
  # gives no NaN, as its ranges tell (see float_ranges): a root with its operands, which check none,
  # and one of no tree alone, as its operands check theirs.
  safe := is_root then g.nan_free.whole else g.nan_free.alone
  unchecked := not g.defers_float_checks and binary in safe
  g.defers_float_checks = true if unchecked
  result := apply_binary(g, operator, left, right, operand_type)
  g.defers_float_checks = false if unchecked
  result

# The text of a String that literals joined by `+` make, which the compiler joins, so that a long
# literal can be split over lines at no cost.
constant_text := (g: Generator, expression: Expression): String? ->
  return nil if not is_kind(type_of(g, expression), 'String')
  case expression
    when StringLiteral then expression.value
    when BinaryOperation
      return nil if expression.operator != '+' or expression in g.facts.operator_calls
      left := constant_text(g, expression.left) ? return nil
      right := constant_text(g, expression.right) ? return nil
      left + right
    else nil

is_bytes := (type: Type) -> is_one_of_kinds(type, ['String', 'Binary'])

# Whether the operation is a tree of float `+ - * /` whose leaves are locals, fields read through
# them or `@` (see is_field_path) and literals, maybe negated: a NaN in it, which each of them
# gives for a NaN operand, is a NaN at its root, so that its root alone need check that its result
# is no NaN. The leaves neither throw nor do anything else, so nothing runs between the operation
# that makes the NaN and the root; the error is reported at the root's position rather than at
# that operation's.
float_tree := (g: Generator, binary: BinaryOperation) ->
  return false if not ['+', '-', '*', '/'].contains(binary.operator)
  return false if binary in g.facts.operator_calls or not is_float(type_of(g, binary))
  float_leaf(g, binary.left) and float_leaf(g, binary.right)

float_leaf := (g: Generator, expression: Expression): Bool ->
  case expression
    when FloatLiteral, IntegerLiteral then true
    when Identifier, Member then is_field_path(g, expression)
    when UnaryOperation
      is_negation := expression.operator == '-' and expression not in g.facts.operator_calls
      is_negation and float_leaf(g, expression.operand)
    when BinaryOperation then float_tree(g, expression)
    else false

# Whether the expression reads, as a leaf does, a local, `@` or a field of one, through fields of
# classes and structs that it reads as they are held (see plain_field_of).
is_field_path := (g: Generator, expression: Expression): Bool ->
  case expression
    when This then true
    when Identifier then g.facts.references[expression] is ScopedLocal
    when Member then plain_field_of(g, expression) != nil and is_field_path(g, expression.object)
    else false

# The operator applied to the values of the operands, of the type, which it takes over.
apply_binary := (g: Generator, operator: String, left: String, right: String, operand_type: Type) ->
  program := g.code.program
  inner := inner_of(operand_type)
  by_contents := compares_by_contents(program, inner)
  # nil is the null pointer, so optional objects compare as pointers too.
  if is_identity_type(inner) and not by_contents
    return negate_if_unequal(g, operator, generate_same_object(g, left, right))
  released := (result: String) ->
    emit_release g.ir, left
    emit_release g.ir, right
    result
  if own_equality(program, operand_type) == 'compare' and is_order_operator(operator)
    ordering := emit_own_compare(g.ir, program, left, right, operand_type)
    return released(emit_order_test(g.ir, operator, ordering))
  if by_contents
    equal := emit_equals_by_contents(g.ir, program, left, right, operand_type)
    return negate_if_unequal(g, operator, released(equal))
  if operand_type is OptionalType
    return negate_if_unequal(g, operator, generate_optional_equals(g, left, right, operand_type))
  return negate_if_unequal(g, operator, emit_equals(g.ir, left, right)) if is_bytes(operand_type)
  return apply_numeric(g, operator, left, right, operand_type) if is_numeric_operator(operator)
  return emit_float_comparison(g.ir, operator, left, right, operand_type) if is_float(operand_type)
  is_unsigned := is_integer(operand_type) and not is_signed(operand_type)
  predicate := (is_unsigned then UNSIGNED_PREDICATES else SIGNED_PREDICATES)[operator]!
  g.ir.assign "icmp #{predicate} #{ir_type(operand_type)} #{left}, #{right}"

# An arithmetic operator applied to two numbers of the type: floats, or integers.
export apply_numeric := (g: Generator, operator: String, left: String, right: String, type: Type) ->
  return apply_float_arithmetic(g, operator, left, right, type) if is_float(type)
  apply_integer_operator g, operator, left, right, type

# Whether the Ordering, an i64, is one that the operator, `<` or the like, holds for.
emit_order_test := (ir: IrBuilder, operator: String, ordering: String) ->
  test :=
    case operator
      when '<' then "eq i64 #{ordering}, #{LESS}"
      when '<=' then "ne i64 #{ordering}, #{GREATER}"
      when '>' then "eq i64 #{ordering}, #{GREATER}"
      else "ne i64 #{ordering}, #{LESS}"
  ir.assign "icmp #{test}"

# `!=` is the negation of the equality.
negate_if_unequal := (g: Generator, operator: String, equal: String) ->
  operator == '!=' then g.ir.assign("xor i1 #{equal}, true") else equal

# Whether two optional values are both nil, or hold equal values; releases them. Strings and
# Binaries, which are null for nil, are compared only where both are present.
generate_optional_equals := (g: Generator, left: String, right: String, type: OptionalType) ->
  ir := g.ir
  inner := type.inner
  left_present := emit_is_present(ir, left, type)
  right_present := emit_is_present(ir, right, type)
  same_presence := ir.assign("icmp eq i1 #{left_present}, #{right_present}")
  if not is_reference_type(inner)
    # A nil's value is unspecified (see docs/internals.md#memory-management), so the values count
    # only where present.
    left_value := emit_unwrap(ir, left, type)
    right_value := emit_unwrap(ir, right, type)
    same_value := emit_value_equals(ir, left_value, right_value, inner)
    values_agree := ir.assign("select i1 #{left_present}, i1 #{same_value}, i1 true")
    return ir.assign("and i1 #{same_presence}, #{values_agree}")
  both_present := ir.assign("and i1 #{left_present}, #{right_present}")
  same_bytes := -> emit_string_equals(ir, left, right)
  equal := emit_branch(ir, 'i1', both_present, same_bytes, same_presence)
  emit_release ir, left
  emit_release ir, right
  equal

# Whether two references are to one object; releases them.
generate_same_object := (g: Generator, left: String, right: String) ->
  same := g.ir.assign("icmp eq ptr #{left}, #{right}")
  emit_release g.ir, left
  emit_release g.ir, right
  same

# `x == nil` or `x != nil`.
generate_nil_test := (g: Generator, binary: BinaryOperation) ->
  value := binary.left is NilLiteral then binary.right else binary.left
  (operand, is_owned) := generate_borrowed(g, value, [], true)
  present := emit_is_present(g.ir, operand, type_of(g, value))
  release_if_reference g, value, operand if is_owned
  binary.operator == '!=' then present else g.ir.assign("xor i1 #{present}, true")

# Short-circuit: the right operand is evaluated only when the left one does not decide.
generate_logical := (g: Generator, binary: BinaryOperation) ->
  ir := g.ir
  left := generate_condition(g, binary.left)
  is_and := binary.operator == 'and'
  undecided := is_and then left else ir.assign("xor i1 #{left}, true")
  right := -> generate_condition(g, binary.right)
  emit_branch ir, 'i1', undecided, right, is_and then 'false' else 'true'

# `x!` throws if x is nil.
export generate_unwrap := (g: Generator, unwrap: Unwrap) ->
  operand := generate(g, unwrap.operand)
  type := type_of(g, unwrap.operand)
  throw_if g, emit_is_nil(g.ir, operand, type), UNWRAPPED_NIL
  emit_unwrap g.ir, operand, type

# The fallback is only evaluated when the value is nil.
export generate_coalesce := (g: Generator, coalesce: Coalesce) ->
  ir := g.ir
  operand := generate(g, coalesce.value)
  type := type_of(g, coalesce.value)
  is_nil := emit_is_nil(ir, operand, type)
  unwrapped := emit_unwrap(ir, operand, type)
  fallback := -> generate(g, coalesce.fallback)
  emit_branch ir, ir_type(type_of(g, coalesce)), is_nil, fallback, unwrapped
