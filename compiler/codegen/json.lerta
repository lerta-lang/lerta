# The code of std:json's builtin write_json and read_json (see checker/json): a function for each
# type that writes or reads its values (json_write and json_read), defined at its first use,
# through the methods of the JsonWriter or the JsonReader that it takes. A scalar, an enum or an
# optional value is written and read inline, the others by their own functions, through which a
# type that holds itself is a recursive call. An exception that a method throws is passed on at
# once, releasing what the function holds.
import camel_case from '../checker/json'
import ProgramWide from '../checker/shared'
import emit_check_with from './exceptions'
import IrBuilder from './ir_builder'
import ir_return_type, method_symbol, shared_string_constant from './lerta_ir'
import emit_valueless_call from './runtime_calls'
import
  binary_type, bool_type, EnumType, float32_type, float_type, is_integer, kind_of, ObjectType,
  OptionalType, SimpleType, string_type, Type, TypeKind, void_type
from '../types'

# The JsonWriter or JsonReader, of its type, as the operand that the code holds.
export struct Coder(program: ProgramWide, type: ObjectType, operand: String)

# The methods that write and read a scalar of the type, which they take and give as it is; an
# integer of another type goes through an Int (see json_write and json_read).
export struct ScalarMethods(write: String, read: String, type: Type)

export const SCALARS: Map<TypeKind, ScalarMethods> =
  'UInt64': ScalarMethods(
    write: 'write_uint64'
    read: 'read_uint64'
    type: SimpleType(kind: 'UInt64')
  )
  'Float': ScalarMethods(write: 'write_float', read: 'read_float', type: float_type)
  'Float32': ScalarMethods(write: 'write_float32', read: 'read_float32', type: float32_type)
  'Bool': ScalarMethods(write: 'write_bool', read: 'read_bool', type: bool_type)
  'String': ScalarMethods(write: 'write_string', read: 'read_string', type: string_type)
  'Binary': ScalarMethods(write: 'write_binary', read: 'read_binary', type: binary_type)

# Whether the type is written and read inline rather than by a function of its own.
export const is_inline = (type: Type) ->
  SCALARS.has(kind_of(type)) or is_integer(type) or type is EnumType or type is OptionalType

# The arguments that give a method a field's name, as written and in camel case (see JsonKeys in
# std:json).
export const field_name_args = (ir: IrBuilder, name: String) ->
  const as_written = shared_string_constant(ir, name)
  ["ptr #{as_written}", "ptr #{shared_string_constant(ir, camel_case(name))}"]

# Calls the method of the writer or reader, of the result type, with the arguments after the
# object; `unwind` runs if it throws.
export const call_method = (
  ir: IrBuilder, coder: Coder, name: String, result: Type, args: String[], unwind: () -> void
) ->
  const operands = ["ptr #{coder.operand}", args...].join(', ')
  const call = "call #{ir_return_type(result)} #{method_symbol(coder.type, name)}(#{operands})"
  const value =
    returns_value(result) then ir.assign(call) else emit_valueless_call(ir, call, result)
  emit_check_with ir, unwind
  value

# Calls the method, which gives no value, as call_method does.
export const call_void_method = (
  ir: IrBuilder, coder: Coder, name: String, args: String[], unwind: () -> void
): void -> call_method(ir, coder, name, void_type, args, unwind)

const returns_value = (result: Type) -> ir_return_type(result) != 'void'
