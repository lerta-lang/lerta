# Bodies that suspend, as LLVM coroutines (see docs/internals/iteration.md#functions-that-yield).
import release_held from './exceptions'
import Coroutine, Generator from './generator'
import IrBuilder, IrModule from './ir_builder'
import call_runtime, call_void_runtime from './runtime_calls'

# The function `symbol`, of the parameters, as in `i64 %p0`, whose body `generate_body` generates
# as a coroutine, whose handle it finds in `g.coroutine`. The body goes on to `end` once it has
# released what it holds, which goes to the free label or suspends for the last time.
export generate_coroutine := (
  g: Generator, symbol: String, params: String[], generate_body: () -> void, end: () -> void
) ->
  coroutine := start_coroutine(g.ir)
  g.coroutine = coroutine
  generate_body()
  g.ir.start_block coroutine.end_label
  end()
  finish_coroutine g.ir, coroutine
  g.ir.finish "private void #{symbol}(#{params.join(', ')}) presplitcoroutine"

# The function `symbol`, of the linkage and the parameters, which makes a handle with
# `make_handle`, runs the body `body_symbol` with it first and returns it.
export emit_ramp := (
  module: IrModule, linkage: String, symbol: String, body_symbol: String, params: String[],
  make_handle: (IrBuilder) -> String
) ->
  ir := IrBuilder(module)
  handle := make_handle(ir)
  ir.emit "call void #{body_symbol}(#{["ptr #{handle}", params...].join(', ')})"
  ir.emit "ret ptr #{handle}"
  ir.finish "#{linkage}ptr #{symbol}(#{params.join(', ')})"

# Makes the coroutine's frame.
start_coroutine := (ir: IrBuilder) ->
  no_promise := 'i32 0, ptr null, ptr null, ptr null'
  id := call_runtime(ir, 'token @llvm.coro.id(i32, ptr, ptr, ptr)', no_promise)
  size := call_runtime(ir, 'i64 @llvm.coro.size.i64()', '')
  frame := call_runtime(ir, 'ptr @lerta_frame_alloc(i64)', "i64 #{size}")
  handle := call_runtime(ir, 'ptr @llvm.coro.begin(token, ptr)', "token #{id}, ptr #{frame}")
  Coroutine(
    id
    handle
    end_label: ir.fresh_label('coroutine.end')
    free_label: ir.fresh_label('coroutine.free')
    suspended_label: ir.fresh_label('coroutine.suspended')
  )

# Suspends the body for the last time; it is never resumed from there, only destroyed, which frees
# the frame.
export emit_final_suspension := (g: Generator) ->
  ir := g.ir
  coroutine := g.coroutine!
  state := emit_suspend_call(ir, true)
  resumed_label := ir.fresh_label('coroutine.resumed')
  emit_suspend_switch ir, state, coroutine, resumed_label, coroutine.free_label
  ir.start_block resumed_label
  ir.emit 'unreachable'

# Goes on by the state that a suspension gives: at `resumed` where the body is resumed, at
# `destroyed` where it is destroyed, and back to the caller while it is suspended.
emit_suspend_switch := (
  ir: IrBuilder, state: String, coroutine: Coroutine, resumed: String, destroyed: String
) ->
  cases := "i8 0, label %#{resumed} i8 1, label %#{destroyed}"
  ir.emit "switch i8 #{state}, label %#{coroutine.suspended_label} [ #{cases} ]"

# Frees the frame, and gives control back to the caller, or to whatever resumed the body.
finish_coroutine := (ir: IrBuilder, coroutine: Coroutine) ->
  { id, handle, free_label, suspended_label } := coroutine
  ir.start_block free_label
  memory := call_runtime(ir, 'ptr @llvm.coro.free(token, ptr)', "token #{id}, ptr #{handle}")
  call_void_runtime ir, 'void @lerta_frame_free(ptr)', "ptr #{memory}"
  ir.branch suspended_label
  ir.start_block suspended_label
  signature := "#{ir.module.coro_end_type} @llvm.coro.end(ptr, i1, token)"
  args := "ptr #{handle}, i1 false, token none"
  if ir.module.coro_end_type == 'void'
    call_void_runtime ir, signature, args
  else
    call_runtime ir, signature, args
  ir.emit 'ret void'

emit_suspend_call := (ir: IrBuilder, is_final: Bool) ->
  call_runtime(ir, 'i8 @llvm.coro.suspend(token, i1)', "token none, i1 #{is_final}")

# Suspends the body until it is resumed. If it is destroyed instead, it releases what it holds and
# frees its frame.
export emit_suspend := (g: Generator) ->
  destroy := ->
    release_held g, 0, 0
    g.ir.branch g.coroutine!.free_label
  emit_suspension g, destroy

# Suspends the body until it is resumed, which is all that can happen to it: nothing destroys a
# body that waits.
export emit_wait := (g: Generator) -> emit_suspension(g, -> g.ir.emit('unreachable'))

emit_suspension := (g: Generator, destroy: () -> void) ->
  ir := g.ir
  coroutine := g.coroutine!
  state := emit_suspend_call(ir, false)
  resume_label := ir.fresh_label('coroutine.resume')
  destroy_label := ir.fresh_label('coroutine.destroy')
  emit_suspend_switch ir, state, coroutine, resume_label, destroy_label
  ir.start_block destroy_label
  destroy()
  ir.start_block resume_label
