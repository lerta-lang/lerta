# Calls: of functions written in Lerta, of C functions, of closures, of constructors and of
# methods.
import Call, Expression, Identifier, Member from '../ast'
import BuiltinMethod from '../checker/builtins'
import ExternExport, named_export from '../checker/imports'
import EnumParse, InterfaceProperty, Method, Property from '../checker/member_targets'
import ExtensionSource, InterfaceMethod, MethodSource, OwnMethod from '../checker/methods'
import info_of, is_argument from '../checker/object_types'
import call_builtin_method, takes_object from './builtins'
import emit_conversion from './checked_int'
import emit_closure_call, function_type_of from './closure'
import emit_parse from './enum'
import
  generate, holding_all, read_any_field, release_if_reference, type_at_use, type_of
from './expression'
import lookup_local from './function'
import emit_exception_check, holding from './exceptions'
import Generator from './generator'
import emit_interface_call from './interface'
import IrBuilder from './ir_builder'
import
  constructor_symbol, default_entry_symbol, emit_release, extension_symbol, instance_symbol,
  ir_return_type, ir_type, method_symbol, returns_nothing
from './lerta_ir'
import emit_add_items, emit_map_new from './map'
import nil_constant from './optional'
import emit_runtime_call, emit_valueless_call from './runtime_calls'
import FunctionType, MapType, ObjectType, Type from '../types'

export const generate_call = (g: Generator, call: Call) ->
  const callee = call.callee
  return generate_member_call(g, call, callee) if callee is Member
  if const instance = g.facts.instances[call]
    const symbol = instance_symbol(g.code.program, instance)
    return call_function(g, symbol, instance.entry.type!, call.args, nil)
  if callee is Identifier
    return generate_named_call(g, call, callee.name) if lookup_local(g, callee.name) == nil
  call_closure g, generate(g, callee), type_of(g, callee), call.args

# A call of a name that no local takes: of the builtin Map, a constructor, a C function or a
# function written in Lerta.
const generate_named_call = (g: Generator, call: Call, name: String) ->
  # A name of the module may take the builtin's name; the checker types the callee of every call
  # but those of the builtins.
  if (name == 'Map' or name == 'Set') and not g.facts.types.has(call.callee)
    const map_type = type_of(g, call) as MapType!
    const map = emit_map_new(g.ir, g.code.program, map_type)
    if const items = call.args.first()
      const array = generate(g, items)
      emit_add_items g.ir, map, array, map_type
      emit_release g.ir, array
    return map
  const callee_type = type_of(g, call.callee)
  return generate_construction(g, call, callee_type) if callee_type is ObjectType
  const exported = g.code.symbols.has(name) then nil else named_export(g.code.shared, name)
  if exported is ExternExport
    const emit_call = (operands: String[]) ->
      emit_runtime_call g.ir, exported.symbol, function_type_of(callee_type), operands
    const result = with_arguments(g, call.args, emit_call)
    # A C function of the runtime may throw (see lerta_raise).
    emit_exception_check g
    return result
  call_function g, g.code.symbols[name]!, callee_type, call.args, nil

# A member that is called: `E.parse`, a field that holds a function, or a method.
const generate_member_call = (g: Generator, call: Call, member: Member) ->
  const target = g.facts.members[member]!
  case target
    when EnumParse
      with_arguments g, call.args, (args) -> emit_parse(g.ir, args[0], target.type)
    when Property
      const object = generate(g, member.object)
      const field_type = type_of(g, member)
      const closure =
        read_any_field(g, object, type_of(g, member.object), member.name.name, field_type)
      call_closure g, closure, field_type, call.args
    when Method then generate_method_call(g, call, member, target.source)
    when InterfaceProperty then panic('a member of an interface that is called is a method')

# The methods of Iters (see takes_object) take the object and the arguments; the other
# methods borrow them, and the object is released after the call.
const generate_method_call = (g: Generator, call: Call, member: Member, source: MethodSource) ->
  const object_type = type_of(g, member.object)
  const object = generate(g, member.object)
  const check = -> emit_exception_check(g)
  # An Iter's has_next and next run the code of its kind, which may throw.
  if source is BuiltinMethod and takes_object(source.member)
    # The object is held until the Iter's method takes it over.
    const call_iter = -> call_builtin_method(g.ir, source.member, object, object_type, [], check)
    const result = holding(g, object, object_type, call_iter)
    emit_exception_check g
    return result
  # A conversion between integer types throws where the value does not fit.
  if source is BuiltinMethod and source.member == INTEGER_CONVERSION
    const target = (source.type as FunctionType!).result
    return emit_conversion(g, object, object_type, target)
  const call_written = (symbol: String) ->
    const receiver = "#{ir_type(object_type)} #{object}"
    call_function g, symbol, type_of(g, member), call.args, receiver
  const call_method = ->
    case source
      when BuiltinMethod
        const emit_call = (args: String[]) ->
          call_builtin_method g.ir, source.member, object, object_type, args, check
        with_arguments g, call.args, emit_call
      when InterfaceMethod
        const emit_call = (operands: String[]) ->
          const args = typed_arguments(g, call.args, operands)
          emit_interface_call g.ir, object, source.index, source.type, args
        with_arguments g, call.args, emit_call
      when OwnMethod then call_written(own_method_symbol(g, source, member.name.name, call))
      when ExtensionSource then call_written(extension_method_symbol(g, source, call))
  const result = holding(g, object, object_type, call_method)
  release_if_reference g, member.object, object
  emit_exception_check g
  result

# The symbol of a method written in Lerta: of a class or struct, or of an extend; or of the
# instance of a generic method that the call calls.
const own_method_symbol = (g: Generator, source: OwnMethod, name: String, call: Call) ->
  return method_symbol(source.receiver, name) if source.generic == nil
  instance_symbol g.code.program, g.facts.instances[call]!

const extension_method_symbol = (g: Generator, source: ExtensionSource, call: Call) ->
  const method = source.method
  return extension_symbol(g.code.program, method) if method.generic == nil
  instance_symbol g.code.program, g.facts.instances[call]!

# Calls a function written in Lerta by its symbol, or by the entry that computes the defaults of
# the arguments left out; a method gets `receiver`, its object as an IR argument, first.
const call_function = (
  g: Generator, symbol: String, type: Type, args: Expression[], receiver: String?
) ->
  const left_out = args.length < function_type_of(type).params.length
  const target = left_out then default_entry_symbol(symbol, args.length) else symbol
  const emit_call = (operands: String[]) ->
    const all_args: String[] = []
    all_args.push receiver if receiver
    all_args.append typed_arguments(g, args, operands)
    call_user_function g.ir, target, type, all_args.join(', ')
  const result = with_arguments(g, args, emit_call)
  # A method's receiver is released after the check.
  emit_exception_check g if receiver == nil
  result

# The arguments' operands with their IR types.
const typed_arguments = (g: Generator, args: Expression[], operands: String[]) ->
  ["#{ir_type(type_at_use(g, arg))} #{operands[i]}" for arg, i in args]

export const call_user_function = (ir: IrBuilder, symbol: String, type: Type, args: String) ->
  const result = function_type_of(type).result
  const call = "call #{ir_return_type(result)} #{symbol}(#{args})"
  return ir.assign(call) if not returns_nothing(result)
  emit_valueless_call ir, call, result

# Calls a function value, a closure, which the call owns and releases; it is evaluated before
# the arguments, as a named function is known before them.
const call_closure = (g: Generator, closure: String, type: Type, args: Expression[]) ->
  const emit_call = (operands: String[]) -> emit_closure_call(g.ir, closure, type, operands)
  const result = holding(g, closure, type, -> with_arguments(g, args, emit_call))
  emit_release g.ir, closure
  emit_exception_check g
  result

# Generates the arguments, which `emit_call` borrows, and releases them after the call. Each is
# held while the next ones are evaluated, which may throw.
const with_arguments = (g: Generator, args: Expression[], emit_call: (String[]) -> String) ->
  const call_and_release = (operands: String[]) ->
    const result = emit_call(operands)
    release_if_reference g, arg, operands[i] for arg, i in args
    result
  holding_all g, args, call_and_release

# The named arguments are evaluated in the order they are written, then passed in the order of
# the fields; an optional field left out is nil. One with a default is followed by whether it is
# given.
const generate_construction = (g: Generator, call: Call, type: ObjectType) ->
  const info = info_of(g.code.program, type)
  const named_args = call.named_args
  const construct_and_release = (operands: String[]) ->
    const given = Map<String, String>()
    given[arg.name.name] = operands[i] for arg, i in named_args
    const args: String[] = []
    for field in info.fields
      continue if not is_argument(field)
      const field_type = field.type!
      const value = given[field.name.name]
      const passed =
        value ? (field.has_default then 'zeroinitializer' else nil_constant(field_type))
      args.push "#{ir_type(field_type)} #{passed}"
      args.push "i1 #{value != nil}" if field.has_default
    const object = g.ir.assign("call ptr #{constructor_symbol(info.type)}(#{args.join(', ')})")
    release_if_reference g, arg.value, operands[i] for arg, i in named_args
    object
  const object = holding_all(g, [arg.value for arg in named_args], construct_and_release)
  emit_exception_check g
  object
