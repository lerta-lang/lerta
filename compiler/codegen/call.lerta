# Calls: of functions written in Lerta, of C functions, of closures, of constructors and of
# methods. Arguments are borrowed: the caller releases its temporaries after the call.
import { Call, Expression, Identifier, Member } from '../ast'
import { ExternExport, imported_export } from '../checker/imports'
import {
  BuiltinMethod, ExtensionSource, find_method, MethodSource, OwnMethod
} from '../checker/methods'
import { info_of } from '../checker/object_types'
import { call_array_method } from './array'
import { emit_closure_call, function_type_of } from './closure'
import { emit_member_name, emit_parse } from './enum'
import { generate, read_field, release_if_reference, type_at_use, type_of } from './expression'
import { lookup_local } from './function'
import { Generator } from './generator'
import { IrBuilder } from './ir_builder'
import { call_iter_method, is_iter_method } from './iter'
import {
  constructor_symbol, emit_release, extension_symbol, instance_symbol, ir_return_type, ir_type
  method_symbol, returns_nothing
} from './lerta_ir'
import { call_map_method, emit_map_new } from './map'
import { nil_constant } from './optional'
import { emit_runtime_call, emit_unreachable } from './runtime_calls'
import { ArrayType, EnumType, is_kind, kind_of, MapType, ObjectType, Type } from '../types'

export const generate_call = (g: Generator, call: Call) ->
  const callee = call.callee
  if const parsed = g.facts.enum_parses[callee]
    return with_arguments(g, call.args, (args) -> emit_parse(g.ir, args[0], parsed))
  return generate_method_call(g, call, callee) if callee is Member
  if const instance = g.facts.instances[call]
    const symbol = instance_symbol(g.code.program, instance)
    return call_function(g, symbol, instance.entry.type!, call.args, nil)
  if callee is Identifier
    return generate_named_call(g, call, callee.name) if lookup_local(g, callee.name) == nil
  call_closure g, generate(g, callee), type_of(g, callee), call.args

# A call of a name that no local takes: of the builtin Map, a constructor, a C function or a
# function written in Lerta.
const generate_named_call = (g: Generator, call: Call, name: String) ->
  # A top-level function may take the builtin's name.
  if name == 'Map' and not g.code.symbols.has(name)
    const map_type = type_of(g, call)
    return emit_map_new(g.ir, map_type is MapType then map_type else throw 'Map() has a map type')
  const callee_type = type_of(g, call.callee)
  return generate_construction(g, call, callee_type) if callee_type is ObjectType
  if const imported = g.code.shared.imports.names[name]
    const exported = imported_export(g.code.program, imported)
    if exported is ExternExport
      const emit_call = (operands: Array<String>) ->
        emit_runtime_call g.ir, exported.symbol, function_type_of(callee_type), operands
      return with_arguments(g, call.args, emit_call)
  call_function g, g.code.symbols[name]!, callee_type, call.args, nil

# The methods of Iters (see call_iter_method) take the object and the arguments; the other
# methods borrow them, and the object is released after the call. A member that is no method
# (see find_method) is a field that holds a function.
const generate_method_call = (g: Generator, call: Call, member: Member) ->
  const object_type = type_of(g, member.object)
  const object = generate(g, member.object)
  const name = member.name.name
  const program = g.code.program
  const source = find_method(program, object_type, name, g.extensions)
  if source == nil
    const closure = read_field(g, object, object_type, name)
    return call_closure(g, closure, type_of(g, member), call.args)
  if source is BuiltinMethod and is_iter_method(object_type, name)
    const args = [generate(g, arg) for arg in call.args]
    return call_iter_method(g.ir, name, object, object_type, args)
  const result = case source
    when BuiltinMethod
      const emit_call = (args: Array<String>) ->
        call_builtin_method g.ir, name, object, object_type, args
      with_arguments g, call.args, emit_call
    else
      const symbol = lerta_method_symbol(g, source, name, call)
      const receiver = "#{ir_type(object_type)} #{object}"
      call_function g, symbol, type_of(g, member), call.args, receiver
  release_if_reference g, member.object, object
  result

# The symbol of a method written in Lerta: of a class or struct, of an extend, or of the instance
# of a generic method that the call calls.
const lerta_method_symbol = (g: Generator, source: MethodSource, name: String, call: Call) ->
  case source
    when OwnMethod
      return method_symbol(source.receiver, name) if source.generic == nil
      instance_symbol g.code.program, g.facts.instances[call]!
    when ExtensionSource
      const method = source.method
      return extension_symbol(method) if method.generic == nil
      instance_symbol g.code.program, g.facts.instances[call]!
    else throw 'a builtin method is not written in Lerta'

# Calls a function written in Lerta by its symbol; a method gets `receiver`, its object as an IR
# argument, first.
const call_function = (
  g: Generator, symbol: String, type: Type, args: Array<Expression>, receiver: String?
) ->
  const emit_call = (operands: Array<String>) ->
    const all_args: Array<String> = []
    all_args.push receiver if receiver
    all_args.push "#{ir_type(type_at_use(g, args[i]))} #{operands[i]}" for i in 0...args.length
    call_user_function g.ir, symbol, type, all_args.join(', ')
  with_arguments g, args, emit_call

const call_user_function = (ir: IrBuilder, symbol: String, type: Type, args: String) ->
  const result = function_type_of(type).result
  const call = "call #{ir_return_type(result)} #{symbol}(#{args})"
  return ir.assign(call) if not returns_nothing(result)
  ir.emit call
  return '' if not is_kind(result, 'never')
  emit_unreachable ir
  'poison'

# Calls a function value, a closure, which the call owns and releases; it is evaluated before
# the arguments, as a named function is known before them.
const call_closure = (g: Generator, closure: String, type: Type, args: Array<Expression>) ->
  const emit_call = (operands: Array<String>) -> emit_closure_call(g.ir, closure, type, operands)
  const result = with_arguments(g, args, emit_call)
  emit_release g.ir, closure
  result

# Generates the arguments, which `emit_call` borrows, and releases them after the call.
const with_arguments = (
  g: Generator, args: Array<Expression>, emit_call: (Array<String>) -> String
) ->
  const operands = [generate(g, arg) for arg in args]
  const result = emit_call(operands)
  release_if_reference g, args[i], operands[i] for i in 0...args.length
  result

# The named arguments are evaluated in the order they are written, then passed in the order of
# the fields; an optional field left out is nil.
const generate_construction = (g: Generator, call: Call, type: ObjectType) ->
  const info = info_of(g.code.program, type)
  const given: Map<String, String> = Map()
  given[arg.name.name] = generate(g, arg.value) for arg in call.named_args
  const args: Array<String> = []
  for field in info.fields
    continue if field.value != nil
    const field_type = field.type!
    const value = given[field.name.name] ? nil_constant(field_type)
    args.push "#{ir_type(field_type)} #{value}"
  const object = g.ir.assign("call ptr #{constructor_symbol(info.type)}(#{args.join(', ')})")
  release_if_reference g, arg.value, given[arg.name.name]! for arg in call.named_args
  object

const call_builtin_method = (
  ir: IrBuilder, name: String, object: String, type: Type, args: Array<String>
) ->
  case type
    when ArrayType then call_array_method(ir, name, object, type.element, args)
    when MapType then call_map_method(ir, name, object, args, type)
    when EnumType then emit_member_name(ir, object, type)
    else throw "no method '#{name}' of #{kind_of(type)}"
