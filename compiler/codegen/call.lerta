# Calls: of functions written in Lerta, of C functions, of closures, of constructors and of
# methods.
import Call, construction_arguments, Expression, Identifier, Member from '../ast'
import BuiltinMethod from '../checker/builtins'
import EnumParse, EnumValue, InterfaceProperty, Method, Property from '../checker/member_targets'
import
  CollectionMaker, Constructor, ExternReference, FunctionReference, JsonConversion, ScopedLocal,
  TopLevelValue
from '../checker/references'
import
  ExtensionSource, InterfaceMethod, MethodSource, OwnMethod, UnionMethod
from '../checker/methods'
import Instance from '../checker/generics'
import arguments_of from '../checker/shared'
import info_of, is_argument from '../checker/object_types'
import call_builtin_method, may_leave_exception, takes_object from './builtins'
import emit_array_filled, emit_assume_length from './array'
import emit_conversion from './checked_int'
import emit_member_value from './boxes'
import emit_closure_call, function_type_of from './closure'
import borrowing_all, generate_borrowed from './borrowing'
import emit_parse from './enum'
import
  generate, holding_all, read_any_field, release_if_reference, type_at_use, type_of
from './expression'
import function_reference_symbol from './references'
import emit_exception_check, holding, unwind_from, while_holding from './exceptions'
import generate_each from './control_flow'
import deferred_value, Generator from './generator'
import emit_borrowed_value, emit_member_dispatch from './heap_object'
import emit_interface_call from './interface'
import IrBuilder from './ir_builder'
import emit_read_json from './json_read'
import emit_write_json from './json_write'
import
  constructor_symbol, default_entry_symbol, emit_release, extension_symbol, instance_symbol,
  ir_return_type, ir_type, method_symbol, returns_nothing
from './lerta_ir'
import generate_inlined_method, inlined_method from './inlined_methods'
import emit_map_new, emit_map_set, emit_set_add from './map'
import apply_operator_method from './operator'
import nil_constant from './optional'
import emit_runtime_call, emit_valueless_call from './runtime_calls'
import ArrayType, is_set, MapType, ObjectType, TupleType, Type from '../types'

export generate_call := (g: Generator, call: Call): String ->
  callee := call.callee
  return generate_member_call(g, call, callee) if callee is Member
  if instance := g.facts.instances[call]?.instance
    symbol := instance_symbol(g.code.program, instance)
    return call_function(g, symbol, instance.entry.type!, arguments_of(g.facts, call), nil)
  return generate_named_call(g, call, callee) if callee is Identifier
  call_closure g, callee, arguments_of(g.facts, call)

# A call of a name: of the builtin Map, Set or Array, std:json's write_json or read_json, a
# constructor, a C function, a function written in Lerta, or a local or a top-level value that holds
# a function.
generate_named_call := (g: Generator, call: Call, callee: Identifier) ->
  # The checker types the callee of every call but those of the builtin collections and of
  # std:json.
  callee_type := -> type_of(g, callee)
  reference := g.facts.references[callee]!
  args := arguments_of(g.facts, call)
  case reference
    when CollectionMaker then generate_new_collection(g, call, reference.type)
    when JsonConversion then generate_json_conversion(g, call, reference)
    when Constructor then generate_construction(g, call, reference.type)
    when ExternReference
      emit_call := (operands: String[]) ->
        emit_runtime_call g.ir, reference.symbol, function_type_of(callee_type()), operands
      result := borrowing_all(g, args, emit_call)
      # A C function of the runtime may throw (see lerta_raise).
      emit_exception_check g
      result
    when FunctionReference
      call_function g, function_reference_symbol(g, reference), callee_type(), args, nil
    when ScopedLocal, TopLevelValue then call_closure(g, callee, args)
    when EnumValue then panic('an enum value is not called')

generate_new_collection := (g: Generator, call: Call, type: MapType | ArrayType) ->
  case type
    when MapType then generate_new_map(g, call, type)
    when ArrayType then generate_filled_array(g, call, type)

# `Map()` or `Set()`, empty or of what a loop goes through: `Set(items)`, or `Map(entries)` of
# (key, value) tuples, the last of each key winning, as in a map literal.
generate_new_map := (g: Generator, call: Call, map_type: MapType) ->
  ir := g.ir
  map := emit_map_new(ir, g.code.program, map_type)
  add := (item: String) ->
    if is_set(map_type)
      emit_set_add ir, map, item, map_type
    else
      entry := TupleType([map_type.key, map_type.value])
      key := emit_borrowed_value(ir, item, entry, 0)
      emit_map_set ir, map, key, emit_borrowed_value(ir, item, entry, 1), map_type
  if items := call.args.first()
    while_holding g, map, map_type, -> generate_each(g, items, add)
  map

# `Array(n, value)`.
generate_filled_array := (g: Generator, call: Call, type: ArrayType) ->
  fill := (operands: String[]) ->
    array := emit_array_filled(g.ir, operands[0], operands[1], type.element)
    # After the check: a negative length throws and gives no array, which the assumption would
    # then not hold of.
    emit_exception_check g
    emit_assume_length g.ir, array, operands[0]
    array
  borrowing_all g, call.args, fill

# The writer or reader is the first argument, and the value written the second.
generate_json_conversion := (g: Generator, call: Call, conversion: JsonConversion) ->
  coder_type := type_of(g, call.args[0]) as ObjectType!
  emit_call := (operands: String[]) ->
    case conversion.direction
      when WRITE
        emit_write_json g.ir, g.code.program, coder_type, operands[0], operands[1], conversion.type
        ''
      when READ then emit_read_json(g.ir, g.code.program, coder_type, operands[0], conversion.type)
  result := borrowing_all(g, call.args, emit_call)
  emit_exception_check g
  result

# A member that is called: `E.parse`, a field that holds a function, or a method.
generate_member_call := (g: Generator, call: Call, member: Member) ->
  target := g.facts.members[member]!
  case target
    when EnumParse
      borrowing_all g, arguments_of(g.facts, call), (operands) ->
        emit_parse g.ir, operands[0], target.type
    when Property then call_closure(g, member, arguments_of(g.facts, call))
    when Method then generate_method_call(g, call, member, target.source)
    when InterfaceProperty then panic('a member of an interface that is called is a method')
    when EnumValue then panic('an enum value is not called')

# The methods of Iters (see takes_object) take the object and the arguments; the other
# methods borrow them, and the object, if owned (see generate_borrowed), is released after the
# call.
generate_method_call := (g: Generator, call: Call, member: Member, source: MethodSource) ->
  if instance := inlined_method(g, call, member, source)
    return generate_inlined_method(g, call, member, instance)
  receiver := deferred_value(g, member.object)
  object_type := type_of(g, receiver)
  # An Iter's has_next and next run the code of its kind, which may throw.
  if source is BuiltinMethod and takes_object(source.member)
    # The object is owned, and held until the Iter's method takes it over.
    object := generate(g, receiver)
    check := -> emit_exception_check(g)
    call_iter := ->
      call_builtin_method g.ir, g.code.program, source.member, object, object_type, [], check
    result := holding(g, object, object_type, call_iter)
    emit_exception_check g
    return result
  (object, is_owned) := generate_borrowed(g, receiver, arguments_of(g.facts, call))
  call_method := ->
    emit_call := (operands: String[]) ->
      args := typed_arguments(g, arguments_of(g.facts, call), operands)
      method_call := method_call_of(g, call, member, operands, args)
      emit_method_call g, source, object, object_type, method_call
    borrowing_all g, arguments_of(g.facts, call), emit_call
  result := is_owned then holding(g, object, object_type, call_method) else call_method()
  release_if_reference g, receiver, object if is_owned
  check_after_method g, source, object_type
  result

# `x in xs`, the call of `xs.contains(x)` that the checker made (see in_tests), with its argument
# evaluated before its object, as they are written.
export generate_in_test := (g: Generator, call: Call) ->
  member := call.callee as Member!
  target := g.facts.members[member]!
  object := deferred_value(g, member.object)
  object_type := type_of(g, object)
  argument := arguments_of(g.facts, call)[0]
  if target is Method
    result := borrowing_all(g, [argument, object], (operands) ->
      args := typed_arguments(g, [argument], [operands[0]])
      method_call := method_call_of(g, call, member, [operands[0]], args)
      emit_method_call g, target.source, operands[1], object_type, method_call
    )
    check_after_method g, target.source, object_type
    return result
  # A field that holds a function, which the call owns and releases, as call_closure does.
  field_type := type_of(g, member)
  result := borrowing_all(g, [argument, object], (operands) ->
    closure := read_any_field(g, operands[1], object_type, member.name.name, field_type, false)
    called := holding(g, closure, field_type, ->
      emit_closure_call g.ir, closure, field_type, [operands[0]]
    )
    emit_release g.ir, closure
    called
  )
  emit_exception_check g
  result

export method_call_of := (
  g: Generator, call: Call, member: Member, operands: String[], args: String[]
) ->
  MethodCall
    name: member.name.name
    type: type_of(g, member)
    operands: operands
    args: args
    instance: g.facts.instances[call]?.instance
    check: -> emit_exception_check(g)

check_after_method := (g: Generator, source: MethodSource, object_type: Type) ->
  may_throw := source is not BuiltinMethod or may_leave_exception(source.member, object_type)
  emit_exception_check g if may_throw

# A call of a method, of the type, once its object and its arguments are evaluated: `operands`,
# and `args`, the operands with their IR types. A generic method's instance is the one it calls,
# and `check` checks for an exception that a builtin method throws while it runs.
export struct MethodCall
  name: String
  type: Type
  operands: String[]
  args: String[]
  instance: Instance?
  check: () -> void

# Calls the method of the source on the object, borrowed.
export emit_method_call := (
  g: Generator, source: MethodSource, object: String, object_type: Type, call: MethodCall
): String ->
  case source
    when BuiltinMethod
      if source.member == OPERATOR
        return apply_operator_method(g, call.name, object, call.operands, object_type)
      # A conversion between integer types gives nil where the value does not fit.
      if source.member == INTEGER_CONVERSION
        return emit_conversion(g.ir, object, object_type, function_type_of(source.type).result)
      { program } := g.code
      { operands, check } := call
      call_builtin_method g.ir, program, source.member, object, object_type, operands, check
    when InterfaceMethod
      emit_interface_call g.ir, object, source.index, source.type, call.args
    when OwnMethod
      call_written_method g, own_method_symbol(g, source, call), object, object_type, call
    when ExtensionSource
      call_written_method g, extension_method_symbol(g, source, call), object, object_type, call
    when UnionMethod
      of_member := (member_type: Type) ->
        found := source.members.find((each) -> each.member == member_type)!
        value := emit_member_value(g.ir, object, member_type)
        emit_method_call g, found.source, value, member_type, call
      result_type := ir_return_type(function_type_of(source.type).result)
      members := [each.member for each in source.members]
      emit_member_dispatch g.ir, object, members, result_type, of_member

# Calls a method written in Lerta by its symbol, with the object first.
call_written_method := (
  g: Generator, symbol: String, object: String, object_type: Type, call: MethodCall
) ->
  receiver := "#{ir_type(object_type)} #{object}"
  emit_function_call g, symbol, call.type, call.args, receiver

# The symbol of a method written in Lerta: of a class or struct, or of an extend; or of the
# instance of a generic method that the call calls.
own_method_symbol := (g: Generator, source: OwnMethod, call: MethodCall) ->
  return method_symbol(source.receiver, call.name) if source.generic == nil
  instance_symbol g.code.program, call.instance!

extension_method_symbol := (g: Generator, source: ExtensionSource, call: MethodCall) ->
  method := source.method
  return extension_symbol(g.code.program, method) if method.generic == nil
  instance_symbol g.code.program, call.instance!

# Calls a function written in Lerta by its symbol, or by the entry that computes the defaults of
# the arguments left out; a method gets `receiver`, its object as an IR argument, first.
call_function := (
  g: Generator, symbol: String, type: Type, args: Expression[], receiver: String?
) ->
  emit_call := (operands: String[]) ->
    emit_function_call g, symbol, type, typed_arguments(g, args, operands), receiver
  result := borrowing_all(g, args, emit_call)
  # A method's receiver is released after the check.
  emit_exception_check g if receiver == nil
  result

# Calls the function by its symbol, or by the entry that computes the defaults of the arguments
# left out, with the arguments, typed operands, after `receiver` if given.
emit_function_call := (
  g: Generator, symbol: String, type: Type, args: String[], receiver: String?
) ->
  left_out := args.length < function_type_of(type).params.length
  target := left_out then default_entry_symbol(symbol, args.length) else symbol
  all_args := receiver then [receiver, args...] else args
  call_user_function g.ir, target, type, all_args.join(', ')

# The arguments' operands with their IR types.
typed_arguments := (g: Generator, args: Expression[], operands: String[]) ->
  ["#{ir_type(type_at_use(g, arg))} #{operands[i]}" for arg, i in args]

export call_user_function := (ir: IrBuilder, symbol: String, type: Type, args: String) ->
  result := function_type_of(type).result
  call := "call #{ir_return_type(result)} #{symbol}(#{args})"
  return ir.assign(call) unless returns_nothing(result)
  emit_valueless_call ir, call, result

# Calls a function value, a closure: a local's, a field's or any other, borrowed where it can be
# while the arguments are evaluated and the call runs (see generate_borrowed), and otherwise owned
# and released after the call; it is evaluated before the arguments, as a named function is known
# before them.
call_closure := (g: Generator, callee: Expression, args: Expression[]) ->
  if call_in_place := in_place_call(g, callee)
    unwind := unwind_from(g, g.position)
    return borrowing_all(g, args, (operands) -> call_in_place(operands, unwind))
  type := type_of(g, callee)
  (closure, is_owned) := generate_borrowed(g, callee, args)
  emit_call := (operands: String[]) -> emit_closure_call(g.ir, closure, type, operands)
  call_with_arguments := -> borrowing_all(g, args, emit_call)
  result := is_owned then holding(g, closure, type, call_with_arguments) else call_with_arguments()
  emit_release g.ir, closure if is_owned
  emit_exception_check g
  result

# What generates the callee's function literal in place, if it is a parameter of a method generated
# in place that is given one (see in_place_calls).
in_place_call := (g: Generator, callee: Expression) ->
  return nil unless callee is Identifier
  declaration := g.facts.local_declarations[callee] ? return nil
  g.in_place_calls[declaration]

# The named arguments are evaluated in the order they are written, then passed in the order of
# the fields; an optional field left out is nil. One with a default is followed by whether it is
# given.
generate_construction := (g: Generator, call: Call, type: ObjectType) ->
  info := info_of(g.code.program, type)
  named_args := construction_arguments(call)
  construct := (operands: String[]) ->
    given: Map<String, String>
    given[arg.name.name] = operands[i] for arg, i in named_args
    args: String[]
    for field in info.fields
      continue unless is_argument(field)
      field_type := field.type!
      value := given[field.name.name]
      passed := value ? (field.has_default then 'zeroinitializer' else nil_constant(field_type))
      args.push "#{ir_type(field_type)} #{passed}"
      args.push "i1 #{value != nil}" if field.has_default
    g.ir.assign "call ptr #{constructor_symbol(info.type)}(#{args.join(', ')})"
  # The constructor takes the arguments over, owned.
  object := holding_all(g, [arg.value for arg in named_args], construct)
  emit_exception_check g
  object
