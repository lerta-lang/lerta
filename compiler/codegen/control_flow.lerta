# Generates control flow: `if`, `while`, `for` over ranges, arrays, Binary values and Iters,
# comprehensions, `break` and `continue`.
import
  Binding, Comprehension, Condition, Expression, For, Identifier, If, Jump, LazyFunctions, Range,
  statement_else_body, While
from '../ast'
import emit_array_new, emit_push from './array'
import function_type_of from './closure'
import generate, generate_condition, release_if_reference, type_of from './expression'
import
  generate_block, generate_block_with, generate_closure, no_locals, release_scope, statements_code,
  store_in_slot
from './function'
import CodegenLocal, Generator, ValueLocal from './generator'
import emit_if_else, emit_when from './ir_builder'
import
  emit_comprehension_iter, emit_range_iter, emit_reading_iter, emit_sequence_get,
  emit_sequence_length, emit_source_start
from './iter'
import emit_exception_check, leave_scopes, while_holding from './exceptions'
import emit_iter_loop, emit_iter_start from './iter_protocol'
import emit_is_present, emit_unwrap from './optional'
import ArrayType, int_type, iterable_item, IterType, OptionalType, Type from '../types'

export generate_if := (g: Generator, if_statement: If) ->
  condition := generate_condition_of(g, if_statement.condition)
  then_body := -> generate_block(g, if_statement.then_body, condition.define)
  else_body := -> generate_block(g, statement_else_body(if_statement), no_locals)
  emit_if_else g.ir, condition.test, then_body, else_body

# The test of a condition, and what it defines in the body: for `name := value`, the value
# without nil, which the body's scope owns.
export generate_condition_of := (g: Generator, condition: Condition) ->
  if condition is Binding
    value := generate(g, condition.value)
    optional := type_of(g, condition.value) as OptionalType!
    define := (scope: Map<String, CodegenLocal>) ->
      unwrapped := emit_unwrap(g.ir, value, optional)
      scope[condition.name.name] = store_in_slot(g, unwrapped, optional.inner)
    { test: emit_is_present(g.ir, value, optional), define }
  else
    { test: generate_condition(g, condition), define: no_locals }

export generate_while := (g: Generator, while_statement: While) ->
  ir := g.ir
  header_label := ir.fresh_label('while.header')
  body_label := ir.fresh_label('while.body')
  exit_label := ir.fresh_label('while.exit')
  ir.emit "br label %#{header_label}"
  ir.start_block header_label
  condition := generate_condition_of(g, while_statement.condition)
  ir.emit "br i1 #{condition.test}, label %#{body_label}, label %#{exit_label}"
  ir.start_block body_label
  body := statements_code(g, while_statement.body)
  generate_loop_body g, body, exit_label, header_label, condition.define
  ir.emit "br label %#{header_label}"
  ir.start_block exit_label

# A range's bounds are evaluated once. An array, a Binary or an Iter is held for the whole loop
# in a scope of its own, so a `return` from the body releases it too.
export generate_for := (g: Generator, for_statement: For) ->
  { variable, index } := for_statement
  iterable := iterated(g, for_statement.iterable)
  generate_iteration g, iterable, variable, index, statements_code(g, for_statement.body)

# A new array, of the comprehension's elements, which the loop pushes. Its loop can be the target
# of no `break` or `continue`, which its element and guard cannot hold (see jump_positions).
export generate_comprehension := (g: Generator, comprehension: Comprehension) ->
  iterable := iterated(g, comprehension.iterable)
  return generate_iter_comprehension(g, iterable, lazy) if lazy := comprehension.lazy
  array_type := type_of(g, comprehension) as ArrayType!
  result := emit_array_new(g.ir, array_type.element)
  push := -> push_comprehension(g, comprehension, result)
  while_holding g, result, array_type, push
  result

# Pushes the comprehension's elements to `result`, an array of them, which may hold others, as
# for a spread in an array literal.
export push_comprehension := (g: Generator, comprehension: Comprehension, result: String) ->
  { element, variable, index, guard, bindings } := comprehension
  iterable := iterated(g, comprehension.iterable)
  element_type := (type_of(g, comprehension) as ArrayType!).element
  ir := g.ir
  body := ->
    statements_code(g, bindings)()
    test := guard then generate_condition(g, guard) else 'true'
    emit_when ir, test, ->
      value := generate(g, element)
      emit_push ir, result, value, element_type
      release_if_reference g, element, value
  generate_iteration g, iterable, variable, index, body

# What a `for` or a comprehension goes through: the iterable, or the call of its `iter()` that
# the checker made (see type_of_iterated).
iterated := (g: Generator, iterable: Expression) ->
  return call if call := g.facts.iter_calls[iterable]
  iterable

# The source is evaluated first, then the closures, which capture the values they see then. The
# Iter is made before the traversal of a source Iter starts, which may throw, so that LLVM can tell
# which Iter a function that gives it gives (see docs/internals.md#iter).
generate_iter_comprehension := (g: Generator, iterable: Expression, lazy: LazyFunctions) ->
  ir := g.ir
  if iterable is Range
    range := emit_range_iter(ir, generate(g, iterable.start), generate(g, iterable.end))
    return generate_lazy_iter(g, range, int_type, lazy)
  type := type_of(g, iterable)
  value := generate(g, iterable)
  source := emit_reading_iter(ir, value, type)
  iter := generate_lazy_iter(g, source, iterable_item(type)!, lazy)
  emit_source_start ir, value, type
  element_type := function_type_of(type_of(g, lazy.element)).result
  while_holding g, iter, IterType(element_type), -> emit_exception_check(g)
  iter

# The comprehension's Iter of the source, whose items are of the type, with its closures.
generate_lazy_iter := (g: Generator, source: String, item: Type, lazy: LazyFunctions) ->
  lazy_guard := lazy.guard
  guard := lazy_guard then generate_closure(g, lazy_guard)
  element := generate_closure(g, lazy.element)
  emit_comprehension_iter g.ir, source, item, guard, element, type_of(g, lazy.element)

# The body generates the loop's code in its scope, where the loop variable, and the index if the
# loop names it, are defined.
generate_iteration := (
  g: Generator, iterable: Expression, variable: Identifier, index: Identifier?, body: () -> void
) ->
  define_index := (scope: Map<String, CodegenLocal>, place: String) ->
    scope[index.name] = ValueLocal(operand: place, type: int_type) if index
  if iterable is Range
    start := generate(g, iterable.start)
    end := generate(g, iterable.end)
    define := (scope: Map<String, CodegenLocal>, current: String) ->
      scope[variable.name] = ValueLocal(operand: current, type: int_type)
      define_index scope, g.ir.assign("sub i64 #{current}, #{start}") if index
    generate_counting_loop g, start, -> end, body, define
    return
  type := type_of(g, iterable)
  return generate_iter_loop(g, iterable, type, variable, define_index, body) if type is IterType
  item_type := iterable_item(type)!
  sequence_scope := g.locals.push()
  sequence := generate(g, iterable)
  sequence_scope[' iterated sequence'] = store_in_slot(g, sequence, type)
  define := (scope: Map<String, CodegenLocal>, current: String) ->
    item := emit_sequence_get(g.ir, sequence, current, type)
    scope[variable.name] = store_in_slot(g, item, item_type)
    define_index scope, current
  end := -> emit_sequence_length(g.ir, sequence, type)
  generate_counting_loop g, '0', end, body, define
  release_scope g, sequence_scope
  g.locals.pop()

# The items' places are counted in a slot, which each round reads and increments first.
generate_iter_loop := (
  g: Generator, iterable: Expression, type: Type, variable: Identifier,
  define_index: (Map<String, CodegenLocal>, String) -> void, body: () -> void
) ->
  item := iterable_item(type)!
  iter_scope := g.locals.push()
  iter := generate(g, iterable)
  iter_scope[' iterated Iter'] = store_in_slot(g, iter, type)
  emit_iter_start g.ir, iter
  emit_exception_check g
  counter := g.ir.alloca('i64')
  g.ir.emit "store i64 0, ptr #{counter}"
  loop_body := (value: String, exit_label: String, next_label: String) ->
    place := g.ir.assign("load i64, ptr #{counter}")
    next_place := g.ir.assign("add i64 #{place}, 1")
    g.ir.emit "store i64 #{next_place}, ptr #{counter}"
    define := (scope: Map<String, CodegenLocal>) ->
      scope[variable.name] = store_in_slot(g, value, item)
      define_index scope, place
    generate_loop_body g, body, exit_label, next_label, define
  emit_iter_loop g.ir, iter, item, loop_body, -> emit_exception_check(g)
  release_scope g, iter_scope
  g.locals.pop()

# Counts from start while the counter is below the end, which is evaluated in the header. The
# counter is a phi in the header, incremented in the latch block; it cannot overflow there, since
# it is below the end.
generate_counting_loop := (
  g: Generator, start: String, end: () -> String, body: () -> void,
  define: (Map<String, CodegenLocal>, String) -> void
) ->
  ir := g.ir
  preheader_label := ir.current_block
  header_label := ir.fresh_label('for.header')
  body_label := ir.fresh_label('for.body')
  latch_label := ir.fresh_label('for.latch')
  exit_label := ir.fresh_label('for.exit')
  next := ir.fresh_register()
  ir.emit "br label %#{header_label}"

  ir.start_block header_label
  incoming := "[ #{start}, %#{preheader_label} ], [ #{next}, %#{latch_label} ]"
  current := ir.assign("phi i64 #{incoming}")
  in_range := ir.assign("icmp slt i64 #{current}, #{end()}")
  ir.emit "br i1 #{in_range}, label %#{body_label}, label %#{exit_label}"

  ir.start_block body_label
  define_current := (scope: Map<String, CodegenLocal>) -> define(scope, current)
  generate_loop_body g, body, exit_label, latch_label, define_current
  ir.emit "br label %#{latch_label}"

  ir.start_block latch_label
  ir.assign_to next, "add nsw i64 #{current}, 1"
  ir.emit "br label %#{header_label}"

  ir.start_block exit_label

generate_loop_body := (
  g: Generator, body: () -> void, break_label: String, continue_label: String,
  define: (Map<String, CodegenLocal>) -> void
): void ->
  g.loops.push { break_label, continue_label, scope_depth: g.locals.depth() }
  generate_block_with g, body, define
  g.loops.pop()

# Leaving the loop's scopes early releases their references, as their ends would, and runs the
# finally blocks inside the loop.
export generate_control_jump := (g: Generator, jump: Jump) ->
  loop := g.loops.last()!
  leave_scopes g, loop.scope_depth
  target := jump.kind == 'break' then loop.break_label else loop.continue_label
  g.ir.emit "br label %#{target}"
  g.ir.start_unreachable()
