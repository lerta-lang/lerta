# Generates control flow: `if`, `while`, `for` over ranges, arrays, Binary values, Strings and
# Iters, comprehensions, `break` and `continue`.
import
  Binding, Comprehension, Condition, Expression, For, Identifier, If, is_nested, Jump,
  LazyFunctions, Range, statement_else_body, This, While
from '../ast'
import emit_array_new, emit_borrowed_item, emit_push from './array'
import are_items_taken from '../checker/taken_items'
import function_type_of from './closure'
import generate, generate_condition, release_if_reference, type_of from './expression'
import
  generate_block, generate_block_with, generate_closure, generate_statements, hold, no_locals,
  push_held_scope, statements_code, store_in_slot
from './function'
import CodegenLocal, deferred_value, Generator, ValueLocal from './generator'
import held_value from './expression'
import emit_if_else, emit_when, phi_incoming from './ir_builder'
import NONPOSITIVE_STEP, throw_if from './runtime_errors'
import
  emit_comprehension_iter, emit_indexed_comprehension_iter, emit_range_iter, emit_reading_iter,
  emit_sequence_get, emit_sequence_length, emit_source_start
from './iter'
import emit_exception_check, holding, leave_scopes, while_holding from './exceptions'
import
  fused_call, fused_comprehension, generate_fused_comprehension, generate_fused_loop
from './fusion'
import emit_iter_loop, emit_iter_start from './iter_protocol'
import emit_is_present, emit_unwrap from './optional'
import generate_string_loop, iterated_string from './string_loop'
import ArrayType, int_type, iterable_item, IterType, OptionalType, Type from '../types'

export generate_if := (g: Generator, if_statement: If) ->
  condition := generate_condition_of(g, if_statement.condition)
  then_body := -> generate_block(g, if_statement.then_body, condition.define)
  else_body := -> generate_block(g, statement_else_body(if_statement))
  emit_if_else g.ir, condition.test, then_body, else_body

# The test of a condition, and what it defines in the body: for `name := value`, the value
# without nil, which the body's scope owns.
export generate_condition_of := (g: Generator, condition: Condition) ->
  if condition is Binding
    value := generate(g, condition.value)
    optional := type_of(g, condition.value) as OptionalType!
    define := (scope: Map<String, CodegenLocal>) ->
      unwrapped := emit_unwrap(g.ir, value, optional)
      scope[condition.name.name] = store_in_slot(g, unwrapped, optional.inner)
    { test: emit_is_present(g.ir, value, optional), define }
  else
    { test: generate_condition(g, condition), define: no_locals }

export generate_while := (g: Generator, while_statement: While) ->
  ir := g.ir
  header_label := ir.fresh_label('while.header')
  body_label := ir.fresh_label('while.body')
  exit_label := ir.fresh_label('while.exit')
  ir.branch header_label
  ir.start_block header_label
  condition := generate_condition_of(g, while_statement.condition)
  ir.branch_if condition.test, body_label, exit_label
  ir.start_block body_label
  body := statements_code(g, while_statement.body)
  generate_loop_body g, body, exit_label, header_label, condition.define
  ir.branch header_label
  ir.start_block exit_label

# A range's bounds are evaluated once. An array, a Binary or an Iter is held for the whole loop
# in a scope of its own, so a `return` from the body releases it too.
export generate_for := (g: Generator, for_statement: For) ->
  { variable, index } := for_statement
  body := statements_code(g, for_statement.body)
  if go_through := g.iterates_this
    if for_statement.iterable is This and index == nil
      return go_through(g, variable, body)
  iterable := iterated(g, for_statement.iterable)
  generate_iteration g, iterable, variable, index, body

# A new array, of the comprehension's elements, which the loop pushes. Its loop can be the target
# of no `break` or `continue`, which its element and guard cannot hold (see jump_positions).
export generate_comprehension := (g: Generator, comprehension: Comprehension) ->
  iterable := iterated(g, comprehension.iterable)
  if lazy := comprehension.lazy
    return generate_iter_comprehension(g, iterable, lazy)
  array_type := type_of(g, comprehension) as ArrayType!
  result := emit_array_new(g.ir, array_type.element)

  push := -> push_comprehension(g, comprehension, result)
  unless comprehension.prefix
    while_holding g, result, array_type, push
    return result

  # Held in a scope, which a `return` from its block leaves, releasing it, as an exception does;
  # once the loop ends, the array is the value, which the scope lets go of unreleased.
  push_held_scope g, result, array_type
  push()
  g.locals.pop()
  result

# Pushes the comprehension's elements to `result`, an array of them, which may hold others, as
# for a spread in an array literal; those of a nested comprehension, its element, are its own.
export push_comprehension := (g: Generator, comprehension: Comprehension, result: String): void ->
  { element, variable, index, guard, bindings } := comprehension
  iterable := iterated(g, comprehension.iterable)
  element_type := (type_of(g, comprehension) as ArrayType!).element
  ir := g.ir

  # The block's locals are a scope of their own, which is only entered where the condition holds.
  push_element := ->
    generate_statements g, comprehension.body
    if is_nested(element)
      return push_comprehension(g, element as Comprehension!, result)
    value := generate(g, element)
    emit_push ir, result, value, element_type
    release_if_reference g, element, value
  body := ->
    generate_statements g, bindings
    test :=
      if guard
        generate_condition g, guard
      else
        'true'
    emit_when ir, test, -> generate_block_with(g, push_element, no_locals)

  generate_iteration g, iterable, variable, index, body

# What a `for` or a comprehension goes through: the iterable, or the call of its `iter()` that
# the checker made (see type_of_iterated).
export iterated := (g: Generator, iterable: Expression) ->
  return call if call := g.facts.iter_calls[iterable]
  deferred_value(g, iterable)

# The source is evaluated first, then the closures, which capture the values they see then. The
# Iter is made before the traversal of a source Iter starts, which may throw, so that LLVM can tell
# which Iter a function that gives it gives (see docs/internals/iteration.md#iter).
generate_iter_comprehension := (g: Generator, iterable: Expression, lazy: LazyFunctions) ->
  ir := g.ir
  if iterable is Range
    start := generate(g, iterable.start!)
    range := emit_range_iter(ir, start, generate(g, iterable.end!), iterable.inclusive)
    return generate_lazy_iter(g, range, int_type, lazy)
  type := type_of(g, iterable)
  value := generate(g, iterable)
  source := emit_reading_iter(ir, value, type)
  iter := generate_lazy_iter(g, source, iterable_item(type)!, lazy)
  emit_source_start ir, value, type
  element_type := function_type_of(type_of(g, lazy.element)).result
  while_holding g, iter, IterType(element_type), -> emit_exception_check(g)
  iter

# The comprehension's Iter of the source, whose items are of the type, with its closures. Making a
# closure throws if a local that it captures holds a NaN, so the source and the guard's closure are
# held while the closures after them are made.
generate_lazy_iter := (g: Generator, source: String, item: Type, lazy: LazyFunctions) ->
  make_element := -> generate_closure(g, lazy.element)
  make_closures := ->
    lazy_guard := lazy.guard
    guard :=
      if lazy_guard
        generate_closure g, lazy_guard
      else
        nil
    element :=
      if guard
        holding g, guard, type_of(g, lazy_guard!), make_element
      else
        make_element()
    element_type := type_of(g, lazy.element)
    if lazy.indexed
      emit_indexed_comprehension_iter(g.ir, source, item, guard, element, element_type)
    else
      emit_comprehension_iter(g.ir, source, item, guard, element, element_type)
  holding(g, source, IterType(item), make_closures)

# The body generates the loop's code in its scope, where the loop variable, and the index if the
# loop names it, are defined.
export generate_iteration := (
  g: Generator, iterable: Expression, variable: Identifier, index: Identifier?, body: () -> void
): void ->
  define_index := (scope: Map<String, CodegenLocal>, place: String) ->
    if index
      scope[index.name] = ValueLocal(operand: place, type: int_type)
  if iterable is Range
    start := generate(g, iterable.start!)
    end := generate(g, iterable.end!)
    if iterable.step or iterable.reversed
      return generate_stride_loop(g, iterable, start, end, variable, define_index, body)
    define := (scope: Map<String, CodegenLocal>, current: String) ->
      scope[variable.name] = ValueLocal(operand: current, type: int_type)
      if index
        define_index scope, g.ir.assign("sub i64 #{current}, #{start}")
    generate_counting_loop g, start, -> end, body, define, iterable.inclusive
    return
  type := type_of(g, iterable)
  if index == nil
    if fused := fused_call(g, iterable)
      generate_fused_loop g, fused, iterable_item(type)!, variable, body
      return
    if lazy := fused_comprehension(g, iterable)
      go_through := (source: Expression, held: Identifier, each: () -> void) ->
        generate_iteration g, source, held, nil, each
      generate_fused_comprehension g, lazy, variable, body, go_through
      return
  if text := iterated_string(g, iterable)
    return generate_string_loop(g, text, variable, define_index, body)
  if type is IterType
    return generate_iter_loop(g, iterable, type, variable, define_index, body)
  item_type := iterable_item(type)!
  sequence := generate(g, iterable)
  release := hold(g, sequence, type)
  borrows := borrows_items(g, type)
  define := (scope: Map<String, CodegenLocal>, current: String) ->
    if borrows
      item := emit_borrowed_item(g.ir, sequence, current, item_type)
      scope[variable.name] = ValueLocal(operand: item, type: item_type)
    else
      item := emit_sequence_get(g.ir, sequence, current, type)
      scope[variable.name] = store_in_slot(g, item, item_type)
    define_index scope, current
  end := -> emit_sequence_length(g.ir, sequence, type)
  generate_counting_loop g, '0', end, body, define
  release()

# Whether a loop's variable borrows each item of what the loop goes through, which the loop holds:
# an array's, where no code of the program takes out an item of an array of its type (see
# are_items_taken), so that the item stays as long as the array does. A body that suspends holds
# the item, as it does a borrowed const (see holds_borrowed).
borrows_items := (g: Generator, type: Type) ->
  return false if g.coroutine != nil
  array := type as ArrayType else return false
  not are_items_taken(g.code.program, array)

# Generates `use` of each item, borrowed, of what a loop goes through, as `Set(items)` does.
export generate_each := (g: Generator, iterable: Expression, use: (String) -> void) ->
  variable := Identifier(name: '(each item)', position: iterable.position)
  body := -> use(held_value(g, g.locals.lookup(variable.name)!))
  generate_iteration g, iterated(g, iterable), variable, nil, body

# The items' places are counted in a slot, which each round reads and increments first.
generate_iter_loop := (
  g: Generator, iterable: Expression, type: Type, variable: Identifier,
  define_index: (Map<String, CodegenLocal>, String) -> void, body: () -> void
) ->
  item := iterable_item(type)!
  iter := generate(g, iterable)
  release := hold(g, iter, type)
  emit_iter_start g.ir, iter, item
  emit_exception_check g
  counter := g.ir.alloca('i64')
  g.ir.store 'i64', '0', counter
  loop_body := (value: String, exit_label: String, next_label: String) ->
    place := g.ir.load('i64', counter)
    next_place := g.ir.assign("add i64 #{place}, 1")
    g.ir.store 'i64', next_place, counter
    define := (scope: Map<String, CodegenLocal>) ->
      scope[variable.name] = store_in_slot(g, value, item)
      define_index scope, place
    generate_loop_body g, body, exit_label, next_label, define
  emit_iter_loop g.ir, iter, item, loop_body, -> emit_exception_check(g)
  release()

# The items of `a..b by step`, or of `a..b reversed`, from the first, each the one before plus the
# step, or minus it reversed, while it is in the range. Reversed, the first is the last item going
# forward, whose distance from `a` is worked out unsigned, as the span `b - a` fits only so.
generate_stride_loop := (
  g: Generator, range: Range, start: String, end: String, variable: Identifier,
  define_index: (Map<String, CodegenLocal>, String) -> void, body: () -> void
) ->
  ir := g.ir
  step :=
    if range.step
      generate g, range.step!
    else
      '1'
  if range.step
    throw_if g, ir.assign("icmp slt i64 #{step}, 1"), NONPOSITIVE_STEP
  test := range.inclusive then 'sle' else 'slt'
  stepping := StrideStepping(step, test, first: start, bound: end, advance: 'add')
  unless range.reversed
    return generate_stepping_loop(g, stepping, variable, define_index, body)
  holds_one := ir.assign("icmp #{range.inclusive then 'sge' else 'sgt'} i64 #{end}, #{start}")
  emit_when ir, holds_one, ->
    span := ir.assign("sub i64 #{end}, #{start}")
    counted := range.inclusive then span else ir.assign("sub i64 #{span}, 1")
    distance := ir.assign("mul i64 #{ir.assign("udiv i64 #{counted}, #{step}")}, #{step}")
    first := ir.assign("add i64 #{start}, #{distance}")
    backward := StrideStepping(first, step, bound: start, test: 'sge', advance: 'sub')
    generate_stepping_loop g, backward, variable, define_index, body

# A loop of the items from `first`, each `advance`d by the step, while it passes the `test` against
# the bound and the step does not overflow.
struct StrideStepping
  first: String
  bound: String
  step: String
  test: String
  advance: String

# The item is a phi in the header, and the next is worked out in the latch block, where an overflow
# leaves the loop, as the next item would be beyond every Int. The index is counted in a slot.
generate_stepping_loop := (
  g: Generator, stepping: StrideStepping, variable: Identifier,
  define_index: (Map<String, CodegenLocal>, String) -> void, body: () -> void
) ->
  ir := g.ir
  preheader_label := ir.current_block
  header_label := ir.fresh_label('stride.header')
  body_label := ir.fresh_label('stride.body')
  latch_label := ir.fresh_label('stride.latch')
  exit_label := ir.fresh_label('stride.exit')
  next := ir.fresh_register()
  index_slot := ir.alloca('i64')
  ir.store 'i64', '0', index_slot
  ir.branch header_label

  ir.start_block header_label
  incoming := [phi_incoming(stepping.first, preheader_label), phi_incoming(next, latch_label)]
  item := ir.assign("phi i64 #{incoming.join(', ')}")
  in_range := ir.assign("icmp #{stepping.test} i64 #{item}, #{stepping.bound}")
  ir.branch_if in_range, body_label, exit_label

  ir.start_block body_label
  define := (scope: Map<String, CodegenLocal>) ->
    scope[variable.name] = ValueLocal(operand: item, type: int_type)
    index := ir.load('i64', index_slot)
    ir.store 'i64', ir.assign("add i64 #{index}, 1"), index_slot
    define_index scope, index
  generate_loop_body g, body, exit_label, latch_label, define
  ir.branch latch_label

  ir.start_block latch_label
  overflow_intrinsic := "llvm.s#{stepping.advance}.with.overflow.i64"
  ir.module.declare overflow_intrinsic, "declare { i64, i1 } @#{overflow_intrinsic}(i64, i64)"
  result := ir.assign("call { i64, i1 } @#{overflow_intrinsic}(i64 #{item}, i64 #{stepping.step})")
  ir.assign_to next, "extractvalue { i64, i1 } #{result}, 0"
  overflowed := ir.assign("extractvalue { i64, i1 } #{result}, 1")
  ir.branch_if overflowed, exit_label, header_label

  ir.start_block exit_label

# Counts from start while the counter is below the end, or up to it if `inclusive`, which is
# evaluated in the header. The counter is a phi in the header, incremented in the latch block; it
# cannot overflow there, since it is below the end: an inclusive loop leaves at the end first, so
# that an end of the largest Int is counted to.
generate_counting_loop := (
  g: Generator
  start: String
  end: () -> String
  body: () -> void
  define: (Map<String, CodegenLocal>, String) -> void
  inclusive = false
) ->
  ir := g.ir
  preheader_label := ir.current_block
  header_label := ir.fresh_label('for.header')
  body_label := ir.fresh_label('for.body')
  latch_label := ir.fresh_label('for.latch')
  exit_label := ir.fresh_label('for.exit')
  increment_label := inclusive then ir.fresh_label('for.increment') else latch_label
  next := ir.fresh_register()
  ir.branch header_label

  ir.start_block header_label
  incoming := [phi_incoming(start, preheader_label), phi_incoming(next, increment_label)].join(', ')
  current := ir.assign("phi i64 #{incoming}")
  comparison := inclusive then 'sle' else 'slt'
  in_range := ir.assign("icmp #{comparison} i64 #{current}, #{end()}")
  ir.branch_if in_range, body_label, exit_label

  ir.start_block body_label
  define_current := (scope: Map<String, CodegenLocal>) -> define(scope, current)
  generate_loop_body g, body, exit_label, latch_label, define_current
  ir.branch latch_label

  ir.start_block latch_label
  if inclusive
    ir.branch_if ir.assign("icmp eq i64 #{current}, #{end()}"), exit_label, increment_label
    ir.start_block increment_label
  ir.assign_to next, "add nsw i64 #{current}, 1"
  ir.branch header_label

  ir.start_block exit_label

# A break leaves the scopes from `break_depth` on, where it is given: those that a loop of a
# function taken in place holds (see generate_fused_loop).
export generate_loop_body := (
  g: Generator
  body: () -> void
  break_label: String
  continue_label: String
  define: (Map<String, CodegenLocal>) -> void
  break_depth: Int? = nil
): void ->
  scope_depth := g.locals.depth()
  g.loops.push {
    break_label
    continue_label
    scope_depth
    break_depth: break_depth else scope_depth
  }
  generate_block_with g, body, define
  g.loops.pop()

# Leaving the loop's scopes early releases their references, as their ends would, and runs the
# finally blocks inside the loop.
export generate_control_jump := (g: Generator, jump: Jump) ->
  loop := g.loops.last()!
  is_break := jump.kind == 'break'
  leave_scopes g, is_break then loop.break_depth else loop.scope_depth
  target := is_break then loop.break_label else loop.continue_label
  g.ir.branch target
  g.ir.start_unreachable()
