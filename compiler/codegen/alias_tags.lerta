# The metadata of clang's type-based alias analysis on accesses to memory, so that LLVM knows that
# writing one kind of memory leaves another as it was, and keeps reads of it out of a loop (see
# docs/internals.md#alias-analysis). Each kind is a type of its own under char, which the runtime's
# C reads and writes anything as. An access without a tag may touch anything, so a kind of memory
# stays sound as long as no access gives it another kind's tag.
import IrBuilder from './ir_builder'
import is_float, Type from '../types'

# Tags an access to memory of the type of the name.
tag := (ir: IrBuilder, name: String) ->
  metadata := ir.module.metadata
  root := metadata.node('!{!"Simple C/C++ TBAA"}')
  char := metadata.node("!{!\"omnipotent char\", #{root}, i64 0}")
  type := metadata.node("!{!\"#{name}\", #{char}, i64 0}")
  ", !tbaa #{metadata.node("!{#{type}, #{type}, i64 0}")}"

# Items, and map values, so that writing one leaves the length and the items of an array, which the
# runtime's C reads as an integer and a pointer, as they were. That holds as long as the runtime's
# C moves items only by memcpy (see runtime/lerta.h).
export item_tag := (ir: IrBuilder) -> tag(ir, 'lerta item')

# Fields of classes and structs that hold a Float or a Float32, which only the generated code reads
# and writes; other fields are untagged.
export field_tag := (ir: IrBuilder, type: Type) ->
  is_float(type) then tag(ir, 'lerta float') else ''

# Top-level values and the flags that tell that they are set, which only the generated code reads
# and writes.
export top_level_tag := (ir: IrBuilder) -> tag(ir, 'lerta top level')

# A pointer that the runtime's C holds, as clang tags it: the pending exception's.
export pointer_tag := (ir: IrBuilder) -> tag(ir, 'any pointer')
