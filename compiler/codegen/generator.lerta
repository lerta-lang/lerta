# The state of the generation of a module's code, and of one function of it. Objects refer to the
# checker's results and to the IR being built, never back to the generator, so that they form no
# cycle.
import take_from from '../arrays'
import Expression, FunctionLiteral, Identifier, Position, Statement from '../ast'
import Extensions from '../checker/extensions'
import NodeFacts, ProgramWide, Shared from '../checker/shared'
import NanFree from './float_ranges'
import IrBuilder, IrModule from './ir_builder'
import IterKind from './iter_protocol'
import SourceScope from './source_lines'
import Module from '../loader'
import Ownership from './lerta_ir'
import format_type, Type, void_type from '../types'

# A top-level value: the global that holds it, and the flag that tells whether it is initialized
# (see top_level).
export struct TopLevelGlobal
  name: String
  type: Type
  pointer: String
  flag: String
  is_var: Bool
  # What a read of a const whose value is a literal gives, generated in place (see constant_of in
  # top_level.lerta).
  constant: ((IrBuilder) -> String)?

# What the generation of one module's code shares: the program as checked, the IR module and the
# top-level values of every module, by module index; and whether exceptions are traced (see
# emit_trace_entry).
export class ModuleCode
  program: ProgramWide
  ir_module: IrModule
  globals: Map<String, TopLevelGlobal>[]
  module: Module
  shared: Shared
  traces: Bool
  # Each float operation checks its result for NaN where it is, as no tree or local defers it.
  eager_nan_checks = default false

# A loop variable or a parameter is an SSA value; a `const` or `var` lives in a stack slot.
export struct ValueLocal
  operand: String
  type: Type
  # A weak local holds the weak box of its object, or null for nil (see emit_weak_box_of).
  weak = default false

export struct TopLevelSlot
  global: TopLevelGlobal
  is_checked: Bool

# The cell of a captured var, which the scope that declares it owns; a function literal's scope
# reads it from its closure, which owns it.
export struct CellSlot
  cell: String
  is_owned: Bool

# A slot of a var that function literals capture points into its cell (see heap_object).
export struct SlotLocal
  pointer: String
  type: Type
  top_level: TopLevelSlot?
  cell: CellSlot?
  weak = default false
  # A `var`, which assignments may change.
  is_var = default false
  # The exception that a catch takes, whose throw goes on with its trace (see emit_throw_error).
  caught = default false
  # Another generator's, which this one reads in place and does not release (see generate_in_place).
  is_borrowed = default false

export type CodegenLocal = ValueLocal | SlotLocal

# Nested scopes of locals, innermost last. A name that refers to no local of a scope is found by
# its reference (see local_of of references).
export class Locals
  scopes: Map<String, CodegenLocal>[] = []

  depth = -> @scopes.length

  push = ->
    scope: Map<String, CodegenLocal>
    @scopes.push scope
    scope

  pop = (): void -> @scopes.pop()

  # The checker rejects a name declared twice in one scope.
  define = (name: String, local: CodegenLocal) ->
    innermost := @scopes.last()!
    panic "'#{name}' is already defined in this scope" if name in innermost
    innermost[name] = local

  lookup = (name: String) ->
    for scope in @scopes.reversed()
      return local if local := scope[name]
    nil

  # The scopes from `depth` inward, innermost first.
  inner_scopes = (depth: Int) -> @scopes.slice(depth).reversed()

  truncate = (depth: Int) -> @scopes.truncate(depth)

  # Removes the scopes from `depth` inward and gives them, in order, for `put_back`.
  set_aside = (depth: Int) -> take_from(@scopes, depth)

  put_back = (scopes: Map<String, CodegenLocal>[]) -> @scopes.append(scopes)

  # Pushes a scope for each of the scopes, holding its locals under names that the source cannot
  # write, `(<prefix> <name>)`, so that a jump or an exception out of the code releases them.
  hold_all = (scopes: Map<String, CodegenLocal>[], prefix: String) ->
    for scope in scopes
      held := @push()
      held["(#{prefix} #{name})"] = local for (name, local) in scope.entries()

# An owned value that an expression holds, by how it holds references.
export struct Temporary
  operand: String
  owned: Ownership

# Where an exception thrown in a `try` block goes, its catches, and how many scopes and temporaries
# are outside the block.
export struct Handler
  label: String
  scope_depth: Int
  temporary_depth: Int

# The finally block of a `try`, which a jump out of the `try` runs on the way, and how many scopes
# and handlers are outside the `try`.
export struct Finally
  body: Statement[]
  scope_depth: Int
  handler_depth: Int

# Where `break` and `continue` jump, how many scopes enclose the loop, and how many a break leaves.
export struct Loop
  break_label: String
  continue_label: String
  scope_depth: Int
  break_depth: Int

# Where a function that a loop takes in place goes as it ends (see generate_fused_loop): `label`
# once it has released its locals, and `unwind` with an exception that leaves it.
export struct FusedExit
  label: String
  unwind: () -> void

# A body that suspends, an LLVM coroutine (see coroutine): its `id` token and its `handle`. It
# leaves through `end_label`, rather than by returning, once it has released what it holds;
# `free_label` frees the frame, and `suspended_label` gives control back to the caller.
export struct Coroutine
  id: String
  handle: String
  end_label: String
  free_label: String
  suspended_label: String

# The generation of one function. `top_level_code` tells whether it is the module's top-level code,
# which declares the top-level values, rather than a function, which uses them once they are
# initialized; `extensions` are those its body sees (see Instance); `function_name` names it in
# traces (see trace_name).
export class Generator
  code: ModuleCode
  extensions: Extensions
  facts: NodeFacts
  top_level_code: Bool
  function_name: String
  ir = default IrBuilder(module: @code.ir_module, scope: source_scope(@code, @function_name))
  locals = Locals()
  loops: Loop[] = []
  # The result type of the function being generated; the top-level code returns nothing.
  result_type: Type = void_type
  # The owned values that an expression holds while it evaluates others, which an exception
  # releases (see exceptions), innermost last.
  temporaries: Temporary[] = []
  # The `try` blocks around the code, innermost last.
  handlers: Handler[] = []
  # The finally blocks of the `try` blocks and catches around the code, innermost last.
  finallies: Finally[] = []
  # What an exception that leaves the function releases besides its scopes, as a constructor
  # releases the object it was making.
  unwind_cleanup: (() -> void)? = nil
  # Set while a body that suspends is generated.
  coroutine: Coroutine? = nil
  # The kind of Iter that the body of a function that yields stores its items in.
  yield_kind: IterKind? = nil
  # What the body of a coroutine does with the value it returns, owned, or '', before it ends.
  on_return: ((String) -> void)? = nil
  # The functions that loops take in place around the code (see fusion), outermost first.
  fused: FunctionLiteral[] = []
  # How many copies of the code being generated they make (see MOST_COPIES in fusion).
  fused_copies = 1
  # Set while a function that a loop takes in place is generated: where it ends, and what its
  # yields do with their values, owned.
  fused_exit: FusedExit? = nil
  on_yield: ((String) -> void)? = nil
  # Set while a method is generated in place (see inlined_methods): how its loop over `@` goes
  # through the receiver, with the method's generator, the loop variable and the body; and while
  # the receiver's code is, which adds no sites to traces, as the method's loop adds its own.
  iterates_this: ((Generator, Identifier, () -> void) -> void)? = nil
  # The parameters of such a method that are given function literals that it only calls, by their
  # declarations' names: each generates its literal in place with the arguments, borrowed, and
  # what an exception does, and gives its value, owned.
  in_place_calls: Map<Identifier, (String[], () -> void) -> String> = Map()
  traceless = false
  # The values of the locals left undeclared (see defers_to_read in function.lerta), by their only
  # reads, which generate them in place.
  deferred_values: Map<Identifier, Expression> = Map()
  # Where the code being generated is in the source, the innermost statement or expression; nil
  # outside them, as in the code that a function runs before its body.
  position: Position? = nil
  # Set while the operands of a tree of float arithmetic are generated, whose root alone checks that
  # its result is no NaN (see float_tree in operator.lerta).
  defers_float_checks = false
  # Set where a tree of float arithmetic reads a local whose value is not checked for NaN yet, so
  # that its root checks its result even where it gives no NaN of its own (see generate_binary in
  # operator.lerta).
  reads_unchecked_floats = false
  # The slots of the float locals whose values are not checked for NaN yet (see
  # defers_declaration in function.lerta), by their pointers.
  unchecked_floats: Map<String, Bool> = Map()
  # The float operations of the body that give no NaN, which check none (see float_ranges).
  nan_free = NanFree()

# The expression that the value of what a loop goes through, or of the object of a method, is
# generated from: that of the local that it reads, if the local is left undeclared.
export deferred_value := (g: Generator, expression: Expression) ->
  (expression is Identifier then g.deferred_values[expression]) ? expression

# The generator of a function's body, which is not top-level code. Code that is no function of the
# program has the name '', which no trace shows, since it adds no sites: it has no position (see
# emit_trace_entry).
export function_generator := (
  code: ModuleCode, extensions: Extensions, facts: NodeFacts, function_name: String
) -> Generator(code, extensions, facts, function_name, top_level_code: false)

# Where a function of the program is in the source, for the module's source lines; code that is no
# function of the program has the name '' (see function_generator), and none.
source_scope := (code: ModuleCode, function_name: String) ->
  return nil if function_name.is_empty() or code.ir_module.source_lines == nil
  SourceScope name: function_name, path: code.module.key

# Moves the place of the code being generated in the source, for traces and source lines.
export locate := (g: Generator, position: Position?) ->
  g.position = position
  g.ir.location = position

# Generates `body` at the position, after which the place is where it was.
export located := (g: Generator, position: Position?, body: () -> void) ->
  outer := g.position
  locate g, position
  body()
  locate g, outer

# The operand that `value` generates at the position, as `located` generates.
export located_value := (g: Generator, position: Position?, value: () -> String) ->
  var result = ''
  located g, position, -> result = value()
  result

# What `body` generates with the float checks deferred or not (see float_tree), after which they
# are as they were.
export with_deferred_checks := (g: Generator, defers: Bool, body: () -> String) ->
  outer := g.defers_float_checks
  g.defers_float_checks = defers
  result := body()
  g.defers_float_checks = outer
  result

# How a trace names a function: a method by its type and its name, as `Point.length`.
export trace_name := (name: String, this_type: Type?) ->
  this_type then "#{format_type(this_type)}.#{name}" else name

# How a trace names the top-level code of a module.
export TOP_LEVEL_NAME := '<top level>'
