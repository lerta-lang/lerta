# The functions that write values of a type through a JsonWriter (see codegen/json), which borrow
# the value. A writer that throws is let go of as it is, so a function releases only what it took.
import info_of from '../checker/object_types'
import ProgramWide from '../checker/shared'
import emit_borrowed_item, emit_length, emit_load_item, emit_item_slot, from_item from './array'
import emit_member_name from './enum'
import emit_check_with, emit_return_thrown from './exceptions'
import emit_member_value from './boxes'
import
  emit_field_pointer, emit_member_dispatch, emit_value_pointer, value_types
from './heap_object'
import emit_count_up, emit_if_else, emit_while, IrBuilder, IrModule from './ir_builder'
import call_void_method, Coder, field_name_args, is_inline, SCALARS from './json'
import emit_release, emit_release_value, ir_type from './lerta_ir'
import emit_is_present, emit_unwrap from './optional'
import scalar_of, widened_to_word from './scalar'
import call_runtime, call_void_runtime from './runtime_calls'
import
  ArrayType, EnumType, kind_of, MapType, ObjectType, OptionalType, RecordType, TupleType, Type,
  type_key, UnionType, void_type
from '../types'

# Writes the value, borrowed; the caller checks for an exception after it.
export emit_write_json := (
  ir: IrBuilder, program: ProgramWide, writer_type: ObjectType, writer: String, value: String,
  type: Type
) -> emit_write_call(ir, { program, type: writer_type, operand: writer }, value, type)

emit_write_call := (ir: IrBuilder, writer: Coder, value: String, type: Type) ->
  symbol := write_function(ir.module, writer, type)
  ir.emit "call void #{symbol}(ptr #{writer.operand}, #{ir_type(type)} #{value})"

write_function := (module: IrModule, writer: Coder, type: Type) ->
  define := (name: String, defined: IrModule) ->
    ir := IrBuilder(module: defined)
    own := Coder(writer..., operand: '%writer')
    emit_write_parts ir, own, '%value', type
    ir.emit 'ret void'
    ir.finish "private void #{name}(ptr %writer, #{ir_type(type)} %value)"
  module.named "json write #{type_key(type)}", '@lerta.json.write', define

# The body of the function of a type: its parts, or the value itself for a type that others write
# inline, which write_json may write too.
emit_write_parts := (ir: IrBuilder, writer: Coder, value: String, type: Type) ->
  unwind := -> emit_return_thrown(ir, void_type)
  case type
    when ArrayType then emit_write_array(ir, writer, value, type.element, unwind)
    when MapType then emit_write_map(ir, writer, value, type)
    when TupleType then emit_write_tuple(ir, writer, value, type, unwind)
    when RecordType then emit_write_record(ir, writer, value, type, unwind)
    when ObjectType then emit_write_object(ir, writer, value, type, unwind)
    when UnionType then emit_write_union(ir, writer, value, type, unwind)
    else emit_write(ir, writer, value, type, unwind)

# Writes the value, borrowed; `unwind` releases what the function holds and returns.
emit_write := (ir: IrBuilder, writer: Coder, value: String, type: Type, unwind: () -> void): void ->
  if not is_inline(type)
    emit_write_call ir, writer, value, type
    emit_check_with ir, unwind
    return
  case type
    when OptionalType
      write_inner := -> emit_write(ir, writer, emit_unwrap(ir, value, type), type.inner, unwind)
      write_null := -> call_void_method(ir, writer, 'write_null', [], unwind)
      emit_if_else ir, emit_is_present(ir, value, type), write_inner, write_null
    when EnumType
      name := emit_member_name(ir, value, type)
      call_void_method ir, writer, 'write_string', ["ptr #{name}"], unwind
    else
      if scalar := SCALARS[kind_of(type)]
        call_void_method ir, writer, scalar.write, ["#{ir_type(type)} #{value}"], unwind
      else
        word := widened_to_word(ir, value, scalar_of(type)!)
        call_void_method ir, writer, 'write_int', ["i64 #{word}"], unwind

emit_write_array := (
  ir: IrBuilder, writer: Coder, array: String, element: Type, unwind: () -> void
): void ->
  call_void_method ir, writer, 'begin_array', [], unwind
  write_item := (index: String) ->
    call_void_method ir, writer, 'next_item', [], unwind
    emit_write ir, writer, emit_borrowed_item(ir, array, index, element), element, unwind
  emit_count_up ir, emit_length(ir, array), write_item
  call_void_method ir, writer, 'end_array', [], unwind

# The entries in their order, through a cursor of the runtime, which gives each key and value
# owned.
emit_write_map := (ir: IrBuilder, writer: Coder, map: String, type: MapType): void ->
  cursor := call_runtime(ir, 'ptr @lerta_map_cursor(ptr)', "ptr #{map}")
  release_cursor := ->
    emit_release ir, cursor
    emit_return_thrown ir, void_type
  call_void_method ir, writer, 'begin_object', [], release_cursor
  more := -> call_runtime(ir, 'i1 @lerta_map_cursor_has_next(ptr)', "ptr #{cursor}")
  write_entry := ->
    key_slot := ir.alloca('i64')
    value_slot := emit_item_slot(ir, type.value)
    args := "ptr #{cursor}, ptr #{key_slot}, ptr #{value_slot}"
    call_void_runtime ir, 'void @lerta_map_cursor_next(ptr, ptr, ptr)', args
    key := from_item(ir, ir.assign("load i64, ptr #{key_slot}"), type.key)
    value := emit_load_item(ir, value_slot, type.value)
    release_entry := ->
      emit_release ir, key
      emit_release_value ir, value, type.value
    unwind := ->
      release_entry()
      release_cursor()
    call_void_method ir, writer, 'next_key', ["ptr #{key}"], unwind
    emit_write ir, writer, value, type.value, unwind
    release_entry()
  emit_while ir, more, write_entry
  emit_release ir, cursor
  call_void_method ir, writer, 'end_object', [], -> emit_return_thrown(ir, void_type)

emit_write_tuple := (
  ir: IrBuilder, writer: Coder, tuple: String, type: TupleType, unwind: () -> void
): void ->
  call_void_method ir, writer, 'begin_array', [], unwind
  for item_type, i in type.items
    call_void_method ir, writer, 'next_item', [], unwind
    emit_write ir, writer, emit_borrowed_value(ir, tuple, type, i), item_type, unwind
  call_void_method ir, writer, 'end_array', [], unwind

emit_write_record := (
  ir: IrBuilder, writer: Coder, record: String, type: RecordType, unwind: () -> void
): void ->
  write_field := (name: String, value: String, field_type: Type) ->
    emit_write_field ir, writer, name, unwind
    emit_write ir, writer, value, field_type, unwind
  call_void_method ir, writer, 'begin_object', [], unwind
  for field, i in type.fields
    write_field field.name, emit_borrowed_value(ir, record, type, i), field.type
  call_void_method ir, writer, 'end_object', [], unwind

# A class or struct that may hold itself is entered, so that the writer finds a cycle.
emit_write_object := (
  ir: IrBuilder, writer: Coder, object: String, type: ObjectType, unwind: () -> void
): void ->
  info := info_of(writer.program, type)
  may_cycle := may_hold_itself(writer.program, type)
  if may_cycle
    address := ir.assign("ptrtoint ptr #{object} to i64")
    call_void_method ir, writer, 'enter', ["i64 #{address}"], unwind
  call_void_method ir, writer, 'begin_object', [], unwind
  for field in info.fields
    name := field.name.name
    field_type := field.type!
    pointer := emit_field_pointer(ir, object, info, name)
    emit_write_field ir, writer, name, unwind
    emit_write
      ir
      writer
      ir.assign("load #{ir_type(field_type)}, ptr #{pointer}")
      field_type
      unwind
  call_void_method ir, writer, 'end_object', [], unwind
  call_void_method ir, writer, 'leave', [], unwind if may_cycle

# The member that the value is, as it is written alone.
emit_write_union := (
  ir: IrBuilder, writer: Coder, union: String, type: UnionType, unwind: () -> void
): void ->
  write_member := (member: Type) ->
    emit_write ir, writer, emit_member_value(ir, union, member), member, unwind
    # emit_member_dispatch joins the members' values, which writing has none of.
    'true'
  emit_member_dispatch ir, union, type.members, 'i1', write_member

emit_write_field := (ir: IrBuilder, writer: Coder, name: String, unwind: () -> void) ->
  call_void_method ir, writer, 'next_field', field_name_args(ir, name), unwind

# The value of an anonymous struct or a tuple at the index, borrowed.
emit_borrowed_value := (ir: IrBuilder, values: String, type: Type, index: Int) ->
  value_type := value_types(type)[index]
  ir.assign "load #{ir_type(value_type)}, ptr #{emit_value_pointer(ir, values, type, index)}"

# Whether a value of the class or struct may hold itself, through its parts and theirs.
may_hold_itself := (program: ProgramWide, type: ObjectType) ->
  reach := Reach(program, target: type_key(type))
  info_of(program, type).fields.any((field) -> reach.reaches(field.type!))

# The parts of types that lead to a value of the target, a class or struct by its key.
class Reach
  program: ProgramWide
  target: String
  # The classes and structs looked through already.
  visited: Set<String> = Set()

  reaches = (part: Type): Bool ->
    case part
      when OptionalType then @reaches(part.inner)
      when ArrayType then @reaches(part.element)
      when MapType then @reaches(part.value)
      when TupleType then part.items.any((item) -> @reaches(item))
      when RecordType then part.fields.any((field) -> @reaches(field.type))
      when ObjectType then @reaches_object(part)
      when UnionType then part.members.any((member) -> @reaches(member))
      else false

  reaches_object = (type: ObjectType) ->
    key := type_key(type)
    return true if key == @target
    return false if @visited.has(key)
    @visited.add key
    info_of(@program, type).fields.any((field) -> @reaches(field.type!))
