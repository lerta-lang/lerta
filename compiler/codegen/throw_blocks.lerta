# Exceptions raised by the generated code itself. Each has one shared block per function that
# throws it, which a check branches to.
import { Generator } from './generator'
import { string_constant } from './lerta_ir'
import { emit_throw } from './runtime_calls'

# An exception, by the name of its block, and its message.
export struct CheckedException
  name: String
  message: String

export const OVERFLOW = CheckedException(name: 'overflow', message: 'integer overflow')
export const DIVISION_BY_ZERO = CheckedException(
  name: 'division_by_zero', message: 'division by zero'
)
export const UNWRAPPED_NIL = CheckedException(name: 'unwrapped_nil', message: 'unwrapped nil')

export const throw_if = (g: Generator, condition: String, exception: CheckedException) ->
  const name = exception.name
  g.thrown.push(exception) if not g.thrown.any((each) -> each.name == name)
  const continue_label = g.ir.fresh_label('continue')
  g.ir.emit("br i1 #{condition}, label %throw.#{name}, label %#{continue_label}")
  g.ir.start_block(continue_label)

# Called after the function's final `ret`, so that the main flow never falls into a throw block.
export const emit_throw_blocks = (g: Generator) ->
  const ir = g.ir
  for exception in g.thrown
    const message = string_constant(ir, exception.message)
    ir.start_block("throw.#{exception.name}")
    emit_throw(ir, message)
    ir.emit('unreachable')
