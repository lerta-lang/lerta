# Borrowing: which values a consumer can use without retaining them, and their operands.
import Expression, Identifier, Index, Member, Range, This from '../ast'
import is_assigned_field from '../checker/fields'
import names_assigned from '../checker/literal_assignments'
import Property from '../checker/member_targets'
import ScopedLocal, TopLevelValue from '../checker/references'
import are_items_taken from '../checker/taken_items'
import FieldInfo, info_of from '../checker/object_types'
import generate_index from './collection'
import pop_temporaries, push_temporary from './exceptions'
import
  declared_field_type, emit_narrowed, generate, held_field, is_boxed_narrowing, read_borrowed,
  release_if_reference, type_at_use, type_of
from './expression'
import Generator, locate, SlotLocal from './generator'
import field_named from './heap_object'
import local_of from './references'
import ArrayType, ObjectType from '../types'

# The operands of the expressions, which `use` borrows: borrowed from their locals where they can
# be (see generate_borrowed), and otherwise owned, held while the later ones are evaluated, which
# may throw, and released after `use`.
export borrowing_all := (g: Generator, expressions: Expression[], use: (String[]) -> String) ->
  depth := g.temporaries.length
  operands: String[]
  owned: Bool[]
  for expression, i in expressions
    later := [other for other, j in expressions when j > i]
    (operand, is_owned) := generate_borrowed(g, expression, later)
    push_temporary g, operand, type_at_use(g, expression) if is_owned
    operands.push operand
    owned.push is_owned
  result := use(operands)
  pop_temporaries g, depth
  for expression, i in expressions
    release_if_reference g, expression, operands[i] if owned[i]
  result

# The value of the expression and whether it is owned: borrowed when it is a local whose scope
# keeps the value for as long as its consumer uses it, so that using an array in a loop retains and
# releases nothing (see docs/internals.md#memory-management), or a field that holds the same value
# as long as its object lives, or any field `in_place`, where the consumer runs no code of the
# program before it is done (see is_borrowable); owned otherwise, as where it is converted to
# another type, which makes a new value. `later` are the expressions that the consumer evaluates
# while it uses the value.
export generate_borrowed := (
  g: Generator
  expression: Expression
  later: Expression[]
  in_place = false
) ->
  return (generate(g, expression), true) if not is_borrowable(g, expression, later, in_place)
  (generate_borrowed_value(g, expression), false)

# Whether the value can be borrowed for the whole scope of a const that it initializes: as
# generate_borrowed borrows it, but never from a var, which any statement of the scope may assign.
export is_borrowable_in_scope := (g: Generator, expression: Expression) ->
  is_borrowable g, expression, nil, false

# Whether the value can be borrowed (see generate_borrowed): a local's that cannot go meanwhile; and
# a field's of a class or struct whose object can be borrowed in the same way, so that nothing can
# replace it meanwhile: anywhere, one that holds the same value as long as its object lives, and any
# one in place, where no code of the program runs before its consumer is done with it, as for `a.b`
# in `a.b.c`. An anonymous struct's field is not borrowed so far. An array's item is borrowed too,
# from an array that can be borrowed, where no code of the program takes out an item of an array of
# its type (see are_items_taken), so that the item stays as long as the array does; not in place,
# as its position may run code.
is_borrowable := (
  g: Generator, expression: Expression, later: Expression[]?, in_place: Bool
): Bool ->
  return false if expression in g.facts.conversions
  if local := named_local(g, expression)
    # A weak local's object may go.
    return false if local.weak
    return local is not SlotLocal or not local.is_var or is_var_kept(local, expression, later)
  case expression
    when Member
      field := plain_field_of(g, expression) ? return false
      is_kept := in_place or keeps_value(g, expression, field)
      is_kept and is_borrowable(g, expression.object, later, in_place)
    when Index
      # The array is borrowed while its position is evaluated too, as generate_index borrows it.
      array_later := later then [later..., expression.index]
      is_kept_item(g, expression) and is_borrowable(g, expression.object, array_later, false)
    else false

# Whether the item at the index stays in its array as long as the array lives.
is_kept_item := (g: Generator, index: Index) ->
  return false if index in g.facts.replacements
  array := type_of(g, index.object) as ArrayType ? return false
  index.index is not Range and not are_items_taken(g.code.program, array)

# Whether the field holds the same value as long as its object lives: a const one, or one that no
# assignment in the program changes.
keeps_value := (g: Generator, member: Member, field: FieldInfo) ->
  object_type := type_of(g, member.object) as ObjectType!
  not field.mutable or not is_assigned_field(g.code.program, object_type, member.name.name)

# Whether the var keeps its value while `later` are evaluated. One that no function literal captures
# and that is not top-level can be assigned only by its function's own code, not by a function
# called meanwhile; so it keeps its value if none of `later` assigns its name. Without `later`, what
# will be evaluated is not known, and no var is kept.
is_var_kept := (local: SlotLocal, expression: Expression, later: Expression[]?) ->
  return false if local.cell or local.top_level or later == nil
  name := (expression as Identifier!).name
  name not in names_assigned(later)

# The field of a class or struct that the member reads, if it holds its value as it is read: not
# weak, nor narrowed to a member of a union in a box, which the read takes out.
export plain_field_of := (g: Generator, member: Member) ->
  target := g.facts.members[member]
  return nil if target is not Property or target.kind != FIELD
  object_type := type_of(g, member.object) as ObjectType?
  return nil if object_type == nil
  field := field_named(info_of(g.code.program, object_type), member.name.name)
  return nil if field.weak or is_boxed_narrowing(field.type!, type_of(g, member))
  field

# The value of an expression that is_borrowable, borrowed.
export generate_borrowed_value := (g: Generator, expression: Expression): String ->
  return read_borrowed(g, local, type_of(g, expression)) if local := named_local(g, expression)
  return generate_borrowed_item(g, expression) if expression is Index
  member := expression as Member!
  object := generate_borrowed_value(g, member.object)
  object_type := type_of(g, member.object) as ObjectType!
  name := member.name.name
  held := held_field(g, object, object_type, name)
  emit_narrowed g.ir, held, declared_field_type(g, object_type, name)!, type_of(g, member)

# The item, borrowed, located at the index for the trace of what it throws, as `generate` locates
# an expression.
generate_borrowed_item := (g: Generator, index: Index) ->
  outer := g.position
  locate g, index.position
  item := generate_index(g, index, true)
  locate g, outer
  item

# The local of a scope or the top-level value that the expression names, `@` among them, if it
# names one. A top-level const keeps its value until the program ends, when the values are released
# one by one, each unset first, so that code that a release runs finds it unset or still held.
named_local := (g: Generator, expression: Expression) ->
  case expression
    when This then g.locals.lookup('@')
    when Identifier
      reference := g.facts.references[expression]
      return nil if reference is not ScopedLocal and reference is not TopLevelValue
      local_of g, expression
    else nil
