# Operations on arrays in the generated code. Get, set and push read and write an item in place, as
# its item_ir_type, after the runtime (runtime/array.c) has checked the index or made room, so that
# no code there depends on the item kind; other operations go through the runtime, which takes and
# gives items through pointers to them. Items are represented as docs/internals.md#builtins states;
# map keys, and the items that the runtime hashes and compares, are words: 8 bytes, a narrower value
# extended by its sign (see to_item).
import emit_branch, emit_when, IrBuilder from './ir_builder'
import emit_release_value, emit_retain_value, ir_type, ownership from './lerta_ir'
import call_runtime, call_void_runtime from './runtime_calls'
import narrowed_from_word, scalar_of, widened_to_word from './scalar'
import is_kind, Type from '../types'

# The value as a word.
export const to_item = (ir: IrBuilder, operand: String, type: Type) ->
  const scalar = scalar_of(type) ? return ir.assign("ptrtoint ptr #{operand} to i64")
  widened_to_word ir, operand, scalar

# The value of a word.
export const from_item = (ir: IrBuilder, item: String, type: Type) ->
  const scalar = scalar_of(type) ? return ir.assign("inttoptr i64 #{item} to ptr")
  narrowed_from_word ir, item, scalar

# A value narrower than a word, an integer or a Bool, is held at its own size: the value of
# LertaItemKind in runtime/lerta.h of its bytes, LERTA_INTEGER_ITEMS, and LERTA_SIGNED_ITEMS if it
# is signed. Nil for a value of a word, which is held as one.
export const narrow_item_kind = (type: Type) ->
  const scalar = scalar_of(type) ? return nil
  return nil if scalar.bits == 64
  const bytes = scalar.bits <= 8 then 1 else scalar.bits >> 3
  const signed = scalar.signed then SIGNED_ITEMS else 0
  bytes | INTEGER_ITEMS | signed

# The flags of LertaItemKind in runtime/lerta.h.
const INTEGER_ITEMS = 0x10
const SIGNED_ITEMS = 0x20

# The value of LertaItemKind in runtime/lerta.h that holds values of the type.
export const item_kind = (type: Type) ->
  const narrow = narrow_item_kind(type)
  return narrow if narrow != nil
  # A map's value type is void only for a set, whose values take no bytes; the checker rejects void
  # elsewhere, as an array's items.
  return 4 if is_kind(type, 'void')
  case ownership(type)
    when NONE then 0
    when REFERENCE then 1
    when INTERFACE then 2
    when COROUTINE then panic('no item holds a coroutine')
    when TRACE then panic('no item holds a trace')

# The IR type of an item of the type.
const item_ir_type = (type: Type) ->
  case
    when is_kind(type, INTERFACE) then ir_type(type)
    when is_kind(type, 'Bool') then 'i8'
    when narrow_item_kind(type) != nil then ir_type(type)
    else 'i64'

const to_held_item = (ir: IrBuilder, operand: String, type: Type) ->
  case
    when is_kind(type, 'Bool') then ir.assign("zext i1 #{operand} to i8")
    when item_ir_type(type) == 'i64' then to_item(ir, operand, type)
    else operand

# The value of an item as it is held.
const from_held_item = (ir: IrBuilder, item: String, type: Type) ->
  case
    when is_kind(type, 'Bool') then ir.assign("trunc i8 #{item} to i1")
    when item_ir_type(type) == 'i64' then from_item(ir, item, type)
    else item

# Room for an item of the type, which the runtime writes.
export const emit_item_slot = (ir: IrBuilder, type: Type) -> ir.alloca(item_ir_type(type))

# A pointer to the value as an item, which stays owned by the caller.
export const emit_item_pointer = (ir: IrBuilder, value: String, type: Type) ->
  const pointer = emit_item_slot(ir, type)
  ir.emit "store #{item_ir_type(type)} #{to_held_item(ir, value, type)}, ptr #{pointer}"
  pointer

# The value of the item at the pointer.
export const emit_load_item = (ir: IrBuilder, pointer: String, type: Type) ->
  from_held_item ir, ir.assign("load #{item_ir_type(type)}, ptr #{pointer}"), type

export const emit_array_new = (ir: IrBuilder, element: Type) ->
  call_runtime ir, 'ptr @lerta_array_create(i32)', "i32 #{item_kind(element)}"

export const emit_length = (ir: IrBuilder, array: String) ->
  call_runtime ir, 'i64 @lerta_array_length(ptr)', "ptr #{array}"

# The item is owned. An index out of range throws, and gives poison.
export const emit_get = (ir: IrBuilder, array: String, index: String, element: Type) ->
  const items = emit_checked_items(ir, array, index)
  const read = ->
    const item = emit_load_item(ir, emit_item_address(ir, items, index, element), element)
    emit_retain_value ir, item, element
    item
  emit_branch ir, ir_type(element), emit_is_in_range(ir, items), read, 'poison'

# The array retains the item, which stays owned by the caller. The new item is retained before the
# old one is released, in case they are the same object.
export const emit_set = (
  ir: IrBuilder, array: String, index: String, value: String, element: Type
) ->
  const items = emit_checked_items(ir, array, index)
  const write = ->
    const address = emit_item_address(ir, items, index, element)
    emit_retain_value ir, value, element
    const old = emit_load_item(ir, address, element)
    emit_store_item ir, address, value, element
    emit_release_value ir, old, element
  emit_when ir, emit_is_in_range(ir, items), write

# The items of the array, which are read and written in place, or null, after the runtime has
# thrown, when the index is out of range.
const emit_checked_items = (ir: IrBuilder, array: String, index: String) ->
  call_runtime ir, 'ptr @lerta_array_checked_items(ptr, i64)', "ptr #{array}, i64 #{index}"

const emit_is_in_range = (ir: IrBuilder, items: String) -> ir.assign("icmp ne ptr #{items}, null")

const emit_store_item = (ir: IrBuilder, address: String, value: String, element: Type) ->
  ir.emit "store #{item_ir_type(element)} #{to_held_item(ir, value, element)}, ptr #{address}"

const emit_item_address = (ir: IrBuilder, items: String, index: String, element: Type) ->
  ir.assign "getelementptr #{item_ir_type(element)}, ptr #{items}, i64 #{index}"

# The array retains the item, which stays owned by the caller.
export const emit_push = (ir: IrBuilder, array: String, value: String, element: Type) ->
  const items = call_runtime(ir, 'ptr @lerta_array_pushed_items(ptr)', "ptr #{array}")
  const last = ir.assign("sub i64 #{emit_length(ir, array)}, 1")
  emit_retain_value ir, value, element
  emit_store_item ir, emit_item_address(ir, items, last, element), value, element

# The item is owned.
export const emit_pop = (ir: IrBuilder, array: String, element: Type) ->
  const pointer = emit_item_slot(ir, element)
  call_void_runtime ir, 'void @lerta_array_take_last(ptr, ptr)', "ptr #{array}, ptr #{pointer}"
  emit_load_item ir, pointer, element
