# Operations on arrays in the generated code. Get, set and push read and write an item in place, as
# its item_ir_type, after the runtime (runtime/array.c) has checked the index or made room, so that
# no code there depends on the item kind; other operations go through the runtime, which takes and
# gives items through pointers to them. Items are represented as
# docs/internals/representation.md#builtins states; map keys, and the items that the runtime hashes
# and compares, are words: 8 bytes, a narrower value extended by its sign (see to_item).
import ProgramWide from '../checker/shared'
import is_value_type from '../checker/value_layout'
import item_tag from './alias_tags'
import emit_assume, emit_branch, emit_when, IrBuilder from './ir_builder'
import emit_box, emit_stack_box, emit_unbox from './boxes'
import
  emit_release, emit_release_value, emit_retain_value, ir_type, is_reference, ownership
from './lerta_ir'
import call_runtime, call_void_runtime from './runtime_calls'
import narrowed_from_word, scalar_of, widened_to_word from './scalar'
import inner_of, is_kind, OptionalType, Type from '../types'

# The value as a word.
export to_item := (ir: IrBuilder, operand: String, type: Type) ->
  scalar := scalar_of(type) else return ir.assign("ptrtoint ptr #{operand} to i64")
  widened_to_word(ir, operand, scalar)

# The value of a word, or of the address of an optional item that the runtime gives as its word.
export from_item := (ir: IrBuilder, item: String, type: Type) ->
  if is_optional_value(ir.program, type)
    return
      ir.load(ir_type(ir.program, type), ir.assign("inttoptr i64 #{item} to ptr"), item_tag(ir))
  scalar := scalar_of(type) else return ir.assign("inttoptr i64 #{item} to ptr")
  narrowed_from_word(ir, item, scalar)

# A value narrower than a word, an integer, a Bool or a Float32's bits, is held at its own size: the
# value of LertaItemKind in runtime/lerta.h of its bytes, LERTA_INTEGER_ITEMS, and
# LERTA_SIGNED_ITEMS if it is signed. Nil for a value of a word, which is held as one.
export narrow_item_kind := (type: Type) ->
  scalar := scalar_of(type) else return nil
  return nil if scalar.bits == 64
  bytes := scalar.bits <= 8 then 1 else scalar.bits >> 3
  signed := scalar.signed then SIGNED_ITEMS else 0
  bytes | INTEGER_ITEMS | signed

# The kinds and the flags of LertaItemKind in runtime/lerta.h.
PLAIN_ITEMS := 0
REFERENCE_ITEMS := 1
INTERFACE_ITEMS := 2
NO_ITEMS := 4
OPTIONAL_ITEMS := 5
INTEGER_ITEMS := 0x10
SIGNED_ITEMS := 0x20

# The value of LertaItemKind in runtime/lerta.h that holds values of the type.
export item_kind := (program: ProgramWide, type: Type) ->
  narrow := narrow_item_kind(type)
  return narrow if narrow != nil

  # A map's value type is void only for a set, whose values take no bytes; the checker rejects void
  # elsewhere, as an array's items.
  return NO_ITEMS if is_kind(type, 'void')

  return REFERENCE_ITEMS if is_boxed_item(program, type)
  return OPTIONAL_ITEMS if is_optional_value(program, type)
  case ownership(program, type)
    when NONE then PLAIN_ITEMS
    when REFERENCE then REFERENCE_ITEMS
    when INTERFACE then INTERFACE_ITEMS
    when VALUE then panic('a value is held in a box')
    when COROUTINE then panic('no item holds a coroutine')
    when TRACE then panic('no item holds a trace')

# An optional value that is not a reference, held as its `{ i1, T }`, in the room of an item.
is_optional_value := (program: ProgramWide, type: Type) ->
  type is OptionalType and ownership(program, type) == NONE and not is_boxed_item(program, type)

# Whether an item of the type is held in a box (see emit_box), as a reference is: a value of an
# anonymous struct or a tuple, optional or not, which neither a word nor a LertaItem may hold.
is_boxed_item := (program: ProgramWide, type: Type) -> is_value_type(program, inner_of(type))

# The IR type of an item of the type.
item_ir_type := (program: ProgramWide, type: Type) ->
  case
    when is_optional_value(program, type) then ir_type(program, type)
    when ownership(program, type) == INTERFACE then ir_type(program, type)
    when is_kind(type, 'Bool') then 'i8'
    when narrow_item_kind(type) != nil then ir_type(program, type)
    else 'i64'

# The room that an item of the type takes, as the runtime's lerta_item_size gives it: an optional
# value takes a whole LertaItem, whatever its `{ i1, T }` takes.
item_room_type := (program: ProgramWide, type: Type) ->
  if is_optional_value(program, type)
    '{ i64, i64 }'
  else
    item_ir_type(program, type)

# The item that holds the value, owned, which it takes over.
to_held_item := (ir: IrBuilder, operand: String, type: Type) ->
  case
    when is_boxed_item(ir.program, type) then to_item(ir, emit_box(ir, operand, type), type)
    when is_optional_value(ir.program, type) then operand
    when is_kind(type, 'Bool') then ir.assign("zext i1 #{operand} to i8")
    when item_ir_type(ir.program, type) == 'i64' then to_item(ir, operand, type)
    else operand

# The value of an item as it is held, borrowed as the item is.
from_held_item := (ir: IrBuilder, item: String, type: Type) ->
  case
    when is_boxed_item(ir.program, type) then from_key(ir, item, type)
    when is_optional_value(ir.program, type) then item
    when is_kind(type, 'Bool') then ir.assign("trunc i8 #{item} to i1")
    when item_ir_type(ir.program, type) == 'i64' then from_item(ir, item, type)
    else item

# Room for an item of the type, which the runtime writes.
export emit_item_slot := (ir: IrBuilder, type: Type) -> ir.alloca(item_room_type(ir.program, type))

# The value of the item at the pointer, borrowed as the item is.
export emit_load_item := (ir: IrBuilder, pointer: String, type: Type) ->
  from_held_item(ir, load_held(ir, pointer, type), type)

load_held := (ir: IrBuilder, pointer: String, type: Type) ->
  ir.load(item_ir_type(ir.program, type), pointer, item_tag(ir))

# The value of the item at the pointer, which the caller owns, owned: taken out of its box, if it
# has one, which is released.
export emit_take_item := (ir: IrBuilder, pointer: String, type: Type) ->
  if is_boxed_item(ir.program, type)
    emit_taken(ir, load_held(ir, pointer, type), type)
  else
    emit_load_item(ir, pointer, type)

# The value of a word, a key, owned, of which the caller owns the box of a value.
export emit_taken := (ir: IrBuilder, word: String, type: Type) ->
  value := from_key(ir, word, type)
  if is_boxed_item(ir.program, type)
    emit_retain_value ir, value, type
    emit_release ir, from_item(ir, word, type)
  value

# The value of a word, a key, borrowed as it is: that in the box of a value.
export from_key := (ir: IrBuilder, word: String, type: Type) ->
  value := from_item(ir, word, type)
  if is_boxed_item(ir.program, type)
    emit_unbox(ir, value, type)
  else
    value

# The word of a key, borrowed, given to `use`: that of a box of a value, made for it, on the heap
# if the runtime may keep it, and otherwise on the stack (see emit_stack_box).
export with_key_word := (
  ir: IrBuilder, key: String, type: Type, may_keep: Bool, word_of: (String) -> String,
  use: (String) -> String
) ->
  return use(word_of(key)) unless is_boxed_item(ir.program, type)
  unless may_keep
    return use(to_item(ir, emit_stack_box(ir, key, type), type))
  emit_retain_value ir, key, type
  box := emit_box(ir, key, type)
  result := use(to_item(ir, box, type))
  emit_release ir, box
  result

# The item at the address of an index in range. Neither the runtime nor the generated code writes
# null into the items below an array's length, so an item of a reference type without nil is not
# null; LLVM is told so, so that a retain or release of it inlined checks none.
load_indexed_item := (ir: IrBuilder, address: String, type: Type) ->
  item := emit_load_item(ir, address, type)
  if is_reference(ir.program, type) and type is not OptionalType
    emit_assume ir, ir.is_not_null(item)
  item

export emit_array_new := (ir: IrBuilder, element: Type) ->
  call_runtime(ir, 'ptr @lerta_array_create(i32)', "i32 #{item_kind(ir.program, element)}")

# An array of `length` copies of the value, which the array retains and the caller still owns;
# a negative length throws.
export emit_array_filled := (ir: IrBuilder, length: String, value: String, element: Type) ->
  item := emit_item_slot(ir, element)
  boxed := is_boxed_item(ir.program, element)
  if boxed
    emit_retain_value ir, value, element
  emit_store_item ir, item, value, element
  args := "i32 #{item_kind(ir.program, element)}, i64 #{length}, ptr #{item}"
  array := call_runtime(ir, 'ptr @lerta_array_filled(i32, i64, ptr)', args)
  if boxed
    emit_release ir, from_item(ir, load_held(ir, item, element), element)
  array

# Tells LLVM that the array that Array(n, v) made has the length n, so that a loop whose bound is n
# needs no comparison with the length of its own to check an index.
export emit_assume_length := (ir: IrBuilder, array: String, length: String) ->
  emit_assume ir, ir.assign("icmp eq i64 #{emit_length(ir, array)}, #{length}")

# A new array of the items from `start` up to `end`, which it retains; a range out of the array's
# throws.
export emit_array_slice := (ir: IrBuilder, array: String, start: String, end: String) ->
  call_runtime(
    ir
    'ptr @lerta_array_slice(ptr, i64, i64)'
    "ptr #{array}, i64 #{start}, i64 #{end}"
  )

export emit_length := (ir: IrBuilder, array: String) ->
  call_runtime(ir, 'i64 @lerta_array_length(ptr)', "ptr #{array}")

# The item is owned. An index out of range throws, and gives poison.
export emit_get := (ir: IrBuilder, array: String, index: String, element: Type) ->
  emit_get_from(ir, emit_checked_items(ir, array, index), index, element)

# The item, owned or else borrowed, of items that emit_checked_items gives, or poison where it gives
# none.
export emit_get_from := (
  ir: IrBuilder
  items: String
  index: String
  element: Type
  owned = true
) ->
  read := ->
    item := load_indexed_item(ir, emit_item_address(ir, items, index, element), element)
    if owned
      emit_retain_value ir, item, element
    item
  emit_branch(ir, ir_type(ir.program, element), emit_is_in_range(ir, items), read, 'poison')

# The item at an index in range, which stays owned by the array.
export emit_borrowed_item := (ir: IrBuilder, array: String, index: String, element: Type) ->
  items := emit_checked_items(ir, array, index)
  load_indexed_item(ir, emit_item_address(ir, items, index, element), element)

# Sets the item in items that emit_checked_items gives, unless it gives none. The array retains the
# item, which stays owned by the caller; the new item is retained before the old one is released,
# in case they are the same object.
export emit_set_in := (ir: IrBuilder, items: String, index: String, value: String, element: Type) ->
  write := -> emit_replace_item(ir, emit_item_address(ir, items, index, element), value, element)
  emit_when ir, emit_is_in_range(ir, items), write

# Writes the value, retained, as the item at the address, releasing the one there.
export emit_replace_item := (ir: IrBuilder, address: String, value: String, type: Type) ->
  emit_retain_value ir, value, type
  old := load_held(ir, address, type)
  emit_store_item ir, address, value, type
  if is_boxed_item(ir.program, type)
    emit_release ir, from_item(ir, old, type)
  else
    emit_release_value ir, from_held_item(ir, old, type), type

# The items of the array, which are read and written in place, or null, after the runtime has
# thrown, when the index is out of range.
export emit_checked_items := (ir: IrBuilder, array: String, index: String) ->
  call_runtime(ir, 'ptr @lerta_array_checked_items(ptr, i64)', "ptr #{array}, i64 #{index}")

# Whether emit_checked_items gave no items, having thrown.
export emit_is_out_of_range := (ir: IrBuilder, items: String) -> ir.is_null(items)

emit_is_in_range := (ir: IrBuilder, items: String) -> ir.is_not_null(items)

export emit_store_item := (ir: IrBuilder, address: String, value: String, element: Type) ->
  held := to_held_item(ir, value, element)
  ir.store item_ir_type(ir.program, element), held, address, item_tag(ir)

emit_item_address := (ir: IrBuilder, items: String, index: String, element: Type) ->
  ir.assign("getelementptr #{item_room_type(ir.program, element)}, ptr #{items}, i64 #{index}")

# The array retains the item, which stays owned by the caller.
export emit_push := (ir: IrBuilder, array: String, value: String, element: Type) ->
  items := call_runtime(ir, 'ptr @lerta_array_pushed_items(ptr)', "ptr #{array}")
  last := ir.assign("sub i64 #{emit_length(ir, array)}, 1")
  emit_retain_value ir, value, element
  emit_store_item ir, emit_item_address(ir, items, last, element), value, element

# The item is owned.
export emit_pop := (ir: IrBuilder, array: String, element: Type) ->
  pointer := emit_item_slot(ir, element)
  call_void_runtime ir, 'void @lerta_array_take_last(ptr, ptr)', "ptr #{array}, ptr #{pointer}"
  emit_take_item(ir, pointer, element)
