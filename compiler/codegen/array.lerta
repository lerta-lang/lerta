# Operations on arrays in the generated code. Get, set and push read and write an item in place, as
# its item_ir_type, after the runtime (runtime/array.c) has checked the index or made room, so that
# no code there depends on the item kind; other operations go through the runtime, which takes and
# gives items through pointers to them. Items are represented as docs/internals.md#builtins states;
# map keys, and the items that the runtime hashes and compares, are words: 8 bytes, a narrower value
# extended by its sign (see to_item).
import item_tag from './alias_tags'
import emit_branch, emit_when, IrBuilder from './ir_builder'
import emit_release_value, emit_retain_value, ir_type, ownership from './lerta_ir'
import call_runtime, call_void_runtime from './runtime_calls'
import narrowed_from_word, scalar_of, widened_to_word from './scalar'
import is_kind, Type from '../types'

# The value as a word.
export to_item := (ir: IrBuilder, operand: String, type: Type) ->
  scalar := scalar_of(type) ? return ir.assign("ptrtoint ptr #{operand} to i64")
  widened_to_word ir, operand, scalar

# The value of a word.
export from_item := (ir: IrBuilder, item: String, type: Type) ->
  scalar := scalar_of(type) ? return ir.assign("inttoptr i64 #{item} to ptr")
  narrowed_from_word ir, item, scalar

# A value narrower than a word, an integer, a Bool or a Float32's bits, is held at its own size: the
# value of LertaItemKind in runtime/lerta.h of its bytes, LERTA_INTEGER_ITEMS, and
# LERTA_SIGNED_ITEMS if it is signed. Nil for a value of a word, which is held as one.
export narrow_item_kind := (type: Type) ->
  scalar := scalar_of(type) ? return nil
  return nil if scalar.bits == 64
  bytes := scalar.bits <= 8 then 1 else scalar.bits >> 3
  signed := scalar.signed then SIGNED_ITEMS else 0
  bytes | INTEGER_ITEMS | signed

# The flags of LertaItemKind in runtime/lerta.h.
INTEGER_ITEMS := 0x10
SIGNED_ITEMS := 0x20

# The value of LertaItemKind in runtime/lerta.h that holds values of the type.
export item_kind := (type: Type) ->
  narrow := narrow_item_kind(type)
  return narrow if narrow != nil
  # A map's value type is void only for a set, whose values take no bytes; the checker rejects void
  # elsewhere, as an array's items.
  return 4 if is_kind(type, 'void')
  case ownership(type)
    when NONE then 0
    when REFERENCE then 1
    when INTERFACE then 2
    when COROUTINE then panic('no item holds a coroutine')
    when TRACE then panic('no item holds a trace')

# The IR type of an item of the type.
item_ir_type := (type: Type) ->
  case
    when is_kind(type, INTERFACE) then ir_type(type)
    when is_kind(type, 'Bool') then 'i8'
    when narrow_item_kind(type) != nil then ir_type(type)
    else 'i64'

to_held_item := (ir: IrBuilder, operand: String, type: Type) ->
  case
    when is_kind(type, 'Bool') then ir.assign("zext i1 #{operand} to i8")
    when item_ir_type(type) == 'i64' then to_item(ir, operand, type)
    else operand

# The value of an item as it is held.
from_held_item := (ir: IrBuilder, item: String, type: Type) ->
  case
    when is_kind(type, 'Bool') then ir.assign("trunc i8 #{item} to i1")
    when item_ir_type(type) == 'i64' then from_item(ir, item, type)
    else item

# Room for an item of the type, which the runtime writes.
export emit_item_slot := (ir: IrBuilder, type: Type) -> ir.alloca(item_ir_type(type))

# The value of the item at the pointer.
export emit_load_item := (ir: IrBuilder, pointer: String, type: Type) ->
  from_held_item ir, ir.load(item_ir_type(type), pointer, item_tag(ir)), type

export emit_array_new := (ir: IrBuilder, element: Type) ->
  call_runtime ir, 'ptr @lerta_array_create(i32)', "i32 #{item_kind(element)}"

# An array of `length` copies of the value, which the array retains and the caller still owns;
# a negative length throws.
export emit_array_filled := (ir: IrBuilder, length: String, value: String, element: Type) ->
  item := emit_item_slot(ir, element)
  emit_store_item ir, item, value, element
  args := "i32 #{item_kind(element)}, i64 #{length}, ptr #{item}"
  call_runtime ir, 'ptr @lerta_array_filled(i32, i64, ptr)', args

export emit_length := (ir: IrBuilder, array: String) ->
  call_runtime ir, 'i64 @lerta_array_length(ptr)', "ptr #{array}"

# The item is owned. An index out of range throws, and gives poison.
export emit_get := (ir: IrBuilder, array: String, index: String, element: Type) ->
  emit_get_from ir, emit_checked_items(ir, array, index), index, element

# The item, owned or else borrowed, of items that emit_checked_items gives, or poison where it gives
# none.
export emit_get_from := (
  ir: IrBuilder
  items: String
  index: String
  element: Type
  owned = true
) ->
  read := ->
    item := emit_load_item(ir, emit_item_address(ir, items, index, element), element)
    emit_retain_value ir, item, element if owned
    item
  emit_branch ir, ir_type(element), emit_is_in_range(ir, items), read, 'poison'

# The item at an index in range, which stays owned by the array.
export emit_borrowed_item := (ir: IrBuilder, array: String, index: String, element: Type) ->
  items := emit_checked_items(ir, array, index)
  emit_load_item ir, emit_item_address(ir, items, index, element), element

# Sets the item in items that emit_checked_items gives, unless it gives none. The array retains the
# item, which stays owned by the caller; the new item is retained before the old one is released,
# in case they are the same object.
export emit_set_in := (ir: IrBuilder, items: String, index: String, value: String, element: Type) ->
  write := ->
    address := emit_item_address(ir, items, index, element)
    emit_retain_value ir, value, element
    old := emit_load_item(ir, address, element)
    emit_store_item ir, address, value, element
    emit_release_value ir, old, element
  emit_when ir, emit_is_in_range(ir, items), write

# The items of the array, which are read and written in place, or null, after the runtime has
# thrown, when the index is out of range.
export emit_checked_items := (ir: IrBuilder, array: String, index: String) ->
  call_runtime ir, 'ptr @lerta_array_checked_items(ptr, i64)', "ptr #{array}, i64 #{index}"

# Whether emit_checked_items gave no items, having thrown.
export emit_is_out_of_range := (ir: IrBuilder, items: String) ->
  ir.assign "icmp eq ptr #{items}, null"

emit_is_in_range := (ir: IrBuilder, items: String) -> ir.assign("icmp ne ptr #{items}, null")

export emit_store_item := (ir: IrBuilder, address: String, value: String, element: Type) ->
  held := to_held_item(ir, value, element)
  ir.store item_ir_type(element), held, address, item_tag(ir)

emit_item_address := (ir: IrBuilder, items: String, index: String, element: Type) ->
  ir.assign "getelementptr #{item_ir_type(element)}, ptr #{items}, i64 #{index}"

# The array retains the item, which stays owned by the caller.
export emit_push := (ir: IrBuilder, array: String, value: String, element: Type) ->
  items := call_runtime(ir, 'ptr @lerta_array_pushed_items(ptr)', "ptr #{array}")
  last := ir.assign("sub i64 #{emit_length(ir, array)}, 1")
  emit_retain_value ir, value, element
  emit_store_item ir, emit_item_address(ir, items, last, element), value, element

# The item is owned.
export emit_pop := (ir: IrBuilder, array: String, element: Type) ->
  pointer := emit_item_slot(ir, element)
  call_void_runtime ir, 'void @lerta_array_take_last(ptr, ptr)', "ptr #{array}, ptr #{pointer}"
  emit_load_item ir, pointer, element
