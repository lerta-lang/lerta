# Operations on arrays in the generated code. Get, set and push read and write an item in place, as
# its form decides (see items), after the runtime (runtime/array.c) has checked the index or made
# room, so that no code there depends on the item kind; other operations go through the runtime,
# which takes and gives items through pointers to them.
import emit_assume, emit_branch, emit_when, IrBuilder from './ir_builder'
import
  emit_item_kind, emit_item_slot, emit_load_item, emit_replace_item, emit_store_item,
  emit_take_item, item_room_type, with_item_slot
from './items'
import emit_retain_value, ir_type, is_reference from './lerta_ir'
import call_runtime, call_void_runtime from './runtime_calls'
import OptionalType, Type from '../types'

# The item at the address of an index in range. Neither the runtime nor the generated code writes
# null into the items below an array's length, so an item of a reference type without nil is not
# null; LLVM is told so, so that a retain or release of it inlined checks none.
load_indexed_item := (ir: IrBuilder, address: String, type: Type) ->
  item := emit_load_item(ir, address, type)
  if is_reference(ir.program, type) and type is not OptionalType
    emit_assume ir, ir.is_not_null(item)
  item

export emit_array_new := (ir: IrBuilder, element: Type) ->
  call_runtime(ir, 'ptr @lerta_array_create(i32)', "i32 #{emit_item_kind(ir, element)}")

# An array of `length` copies of the value, which the array retains and the caller still owns;
# a negative length throws.
export emit_array_filled := (ir: IrBuilder, length: String, value: String, element: Type) ->
  with_item_slot(ir, value, element, (item) ->
    args := "i32 #{emit_item_kind(ir, element)}, i64 #{length}, ptr #{item}"
    call_runtime(ir, 'ptr @lerta_array_filled(i32, i64, ptr)', args)
  )

# Tells LLVM that the array that Array(n, v) made has the length n, so that a loop whose bound is n
# needs no comparison with the length of its own to check an index.
export emit_assume_length := (ir: IrBuilder, array: String, length: String) ->
  emit_assume ir, ir.assign("icmp eq i64 #{emit_length(ir, array)}, #{length}")

# A new array of the items from `start` up to `end`, which it retains; a range out of the array's
# throws.
export emit_array_slice := (ir: IrBuilder, array: String, start: String, end: String) ->
  call_runtime(
    ir
    'ptr @lerta_array_slice(ptr, i64, i64)'
    "ptr #{array}, i64 #{start}, i64 #{end}"
  )

export emit_length := (ir: IrBuilder, array: String) ->
  call_runtime(ir, 'i64 @lerta_array_length(ptr)', "ptr #{array}")

# The item is owned. An index out of range throws, and gives poison.
export emit_get := (ir: IrBuilder, array: String, index: String, element: Type) ->
  emit_get_from(ir, emit_checked_items(ir, array, index), index, element)

# The item, owned or else borrowed, of items that emit_checked_items gives, or poison where it gives
# none.
export emit_get_from := (
  ir: IrBuilder
  items: String
  index: String
  element: Type
  owned = true
) ->
  read := ->
    item := load_indexed_item(ir, emit_item_address(ir, items, index, element), element)
    if owned
      emit_retain_value ir, item, element
    item
  emit_branch(ir, ir_type(ir.program, element), emit_is_in_range(ir, items), read, 'poison')

# The item at an index in range, which stays owned by the array.
export emit_borrowed_item := (ir: IrBuilder, array: String, index: String, element: Type) ->
  items := emit_checked_items(ir, array, index)
  load_indexed_item(ir, emit_item_address(ir, items, index, element), element)

# Sets the item in items that emit_checked_items gives, unless it gives none. The array retains the
# item, which stays owned by the caller; the new item is retained before the old one is released,
# in case they are the same object.
export emit_set_in := (ir: IrBuilder, items: String, index: String, value: String, element: Type) ->
  write := -> emit_replace_item(ir, emit_item_address(ir, items, index, element), value, element)
  emit_when ir, emit_is_in_range(ir, items), write

# The items of the array, which are read and written in place, or null, after the runtime has
# thrown, when the index is out of range.
export emit_checked_items := (ir: IrBuilder, array: String, index: String) ->
  call_runtime(ir, 'ptr @lerta_array_checked_items(ptr, i64)', "ptr #{array}, i64 #{index}")

# Whether emit_checked_items gave no items, having thrown.
export emit_is_out_of_range := (ir: IrBuilder, items: String) -> ir.is_null(items)

emit_is_in_range := (ir: IrBuilder, items: String) -> ir.is_not_null(items)

emit_item_address := (ir: IrBuilder, items: String, index: String, element: Type) ->
  ir.assign("getelementptr #{item_room_type(ir.program, element)}, ptr #{items}, i64 #{index}")

# The array retains the item, which stays owned by the caller.
export emit_push := (ir: IrBuilder, array: String, value: String, element: Type) ->
  items := call_runtime(ir, 'ptr @lerta_array_pushed_items(ptr)', "ptr #{array}")
  last := ir.assign("sub i64 #{emit_length(ir, array)}, 1")
  emit_retain_value ir, value, element
  emit_store_item ir, emit_item_address(ir, items, last, element), value, element

# The item is owned.
export emit_pop := (ir: IrBuilder, array: String, element: Type) ->
  pointer := emit_item_slot(ir, element)
  call_void_runtime ir, 'void @lerta_array_take_last(ptr, ptr)', "ptr #{array}, ptr #{pointer}"
  emit_take_item(ir, pointer, element)
