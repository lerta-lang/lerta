# Function values in the generated code. A function value is a closure: a reference-counted
# object `{ i64 ref_count, ptr drop, ptr code, captured values... }`. Its code takes the closure
# first, then the arguments, which are borrowed, and gives an owned result.
import
  emit_heap_allocate, emit_heap_field_pointer, heap_object_type, HeapField, plain_field
from './heap_object'
import IrBuilder, IrModule from './ir_builder'
import emit_release_stored, ir_return_type, ir_type, LERTA_IMMORTAL, without_sigil from './lerta_ir'
import emit_valueless_call from './runtime_calls'
import FunctionType, Type from '../types'

# The code pointer comes after the header.
const CODE_FIELD = 2

export const function_type_of = (type: Type) ->
  type as FunctionType!

# The closure of a top-level function, `symbol`: an immortal constant whose code, a thunk defined
# with it, calls the function without the closure.
export const emit_function_closure = (ir: IrBuilder, symbol: String, type: Type) ->
  const { params, result } = function_type_of(type)
  const thunk = "@lerta.thunk.#{without_sigil(symbol)}"
  const define = (module: IrModule) ->
    const typed_params = ["#{ir_type(param)} %p#{i}" for param, i in params]
    const return_type = ir_return_type(result)
    const call = "call #{return_type} #{symbol}(#{typed_params.join(', ')})"
    # A never function returns, with an exception pending, to the caller's check.
    const body =
      if return_type == 'void'
        ["  #{call}", '  ret void']
      else
        ["  %result = #{call}", "  ret #{return_type} %result"]
    const all_params = ['ptr %closure', typed_params...]
    const signature = "#{return_type} #{thunk}(#{all_params.join(', ')})"
    const lines = ["define private #{signature} {", body..., '}']
    module.add_function lines.join("\n")
  ir.module.define_once thunk, define
  emit_static_closure ir, thunk

# A closure of `code` that captures nothing: an immortal constant, defined once, which is never
# allocated or freed.
export const emit_static_closure = (ir: IrBuilder, code: String) ->
  const closure = "@lerta.closure.#{without_sigil(code)}"
  const define = (module: IrModule) ->
    const header = "i64 #{LERTA_IMMORTAL}, ptr null, ptr #{code}"
    module.define_global closure, "private constant { i64, ptr, ptr } { #{header} }"
  ir.module.define_once closure, define
  closure

# The place of the closure's code.
const emit_code_pointer = (ir: IrBuilder, closure: String) ->
  ir.assign "getelementptr { i64, ptr, ptr }, ptr #{closure}, i32 0, i32 #{CODE_FIELD}"

# Calls a closure with the operands of its arguments; the closure is borrowed.
export const emit_closure_call = (
  ir: IrBuilder, closure: String, type: Type, args: Array<String>
) ->
  const { params, result } = function_type_of(type)
  const code = ir.assign("load ptr, ptr #{emit_code_pointer(ir, closure)}")
  const all_args = ["ptr #{closure}"]
  all_args.push "#{ir_type(param)} #{arg}" for (param, arg) in params.zip(args)
  const return_type = ir_return_type(result)
  const call = "call #{return_type} #{code}(#{all_args.join(', ')})"
  return ir.assign(call) if return_type != 'void'
  emit_valueless_call ir, call, result

# What a closure holds for each capture is a field (see HeapField): a value, or the cell of a
# captured var (see heap_object), which is an owned reference.
export const CELL_SLOT = HeapField(ir_type: 'ptr', owned: REFERENCE)

# The IR type of a closure that holds these captures.
const closure_ir_type = (slots: Array<HeapField>) ->
  heap_object_type [plain_field('ptr'), slots...]

# The pointer to the closure's `index`th capture.
export const emit_capture_pointer = (
  ir: IrBuilder, closure: String, slots: Array<HeapField>, index: Int
) -> emit_heap_field_pointer(ir, closure_ir_type(slots), closure, 1 + index)

# A new closure of the code `symbol`, which takes over the captured operands, owned, held in the
# slots. Its drop function, defined with it, releases those that are references.
export const emit_closure = (
  ir: IrBuilder, symbol: String, slots: Array<HeapField>, operands: Array<String>
) ->
  const holds_reference = slots.any((slot) -> slot.owned != NONE)
  const drop = holds_reference then "#{symbol}.drop" else 'null'
  define_closure_drop ir, drop, slots if holds_reference
  const closure = emit_heap_allocate(ir, closure_ir_type(slots), drop)
  ir.emit "store ptr #{symbol}, ptr #{emit_code_pointer(ir, closure)}"
  for slot, i in slots
    const pointer = emit_capture_pointer(ir, closure, slots, i)
    ir.emit "store #{slot.ir_type} #{operands[i]}, ptr #{pointer}"
  closure

const define_closure_drop = (ir: IrBuilder, drop: String, slots: Array<HeapField>) ->
  const define = (module: IrModule) ->
    const body = IrBuilder(module)
    for slot, i in slots
      continue if slot.owned == NONE
      const pointer = emit_capture_pointer(body, '%closure', slots, i)
      emit_release_stored body, pointer, slot.ir_type, slot.owned
    body.emit 'ret void'
    body.finish "void #{drop}(ptr %closure)"
  ir.module.define_once drop, define
