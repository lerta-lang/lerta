# Objects on the heap with fields: classes and structs, anonymous structs and tuples, and cells
# (see docs/internals/representation.md#objects).
import FieldInfo, info_of, ObjectInfo from '../checker/object_types'
import ProgramWide from '../checker/shared'
import field_order, field_place, is_boxed_member, is_value_type from '../checker/value_layout'
import emit_box_test from './boxes'
import any_of, emit_branch, IrBuilder, IrModule, phi_incoming from './ir_builder'
import
  emit_each_reference, emit_load_reference, emit_release_as, emit_retain_value, ir_type, is_counted,
  object_ir_type, Ownership, ownership, quoted_name, shared_string_constant, special_method_symbol,
  suffixed_symbol, type_symbol, value_layout_of
from './lerta_ir'
import call_runtime, call_void_runtime from './runtime_calls'
import
  ArrayType, format_type, inner_of, is_kind, MapType, members_of, ObjectType, OptionalType,
  RecordType, TupleType, Type, type_key
from '../types'

# The two header fields come before the object's own.
HEADER_FIELDS := 2

# A field, by its IR type and how it holds references, which the drop function releases, and the
# type of its values, which a field that holds a value needs for that. A fixed one is written only
# as its object is made (see invariant).
export struct HeapField
  ir_type: String
  owned: Ownership
  type: Type?
  fixed := false

# A field that holds a value of the type.
export value_field := (program: ProgramWide, type: Type) ->
  HeapField(type, ir_type: ir_type(program, type), owned: ownership(program, type))

# The field, written only as its object is made.
export fixed := (field: HeapField) -> HeapField(field..., fixed: true)

# The metadata of an access to a field that keeps the value written as its object is made, which
# lets LLVM take what was written for what is read, through calls that it cannot see into, so that
# an Iter's or a closure's code is called directly and inlined. The object's pointer is laundered
# as it is made (see emit_laundered), so that an object made later at the same place, which LLVM
# might take for it, is no longer the same pointer.
invariant := (ir: IrBuilder) -> ", !invariant.group #{ir.module.metadata.node('!{}')}"

# The metadata of an access to the field: invariant for a fixed one.
export access_tag := (ir: IrBuilder, field: HeapField) -> field.fixed then invariant(ir) else ''

# The new object, as a pointer of its own for the fields that it keeps (see invariant).
export emit_laundered := (ir: IrBuilder, object: String) ->
  launder := 'llvm.launder.invariant.group.p0'
  ir.module.declare launder, "declare ptr @#{launder}(ptr)"
  ir.assign("call ptr @#{launder}(ptr #{object})")

# A field that holds no reference, such as a pointer to code, of the IR type.
export plain_field := (ir: String) -> HeapField(ir_type: ir, owned: NONE)

# The LLVM struct type of a heap object with the fields: the header, then the fields.
export heap_object_type := (fields: HeapField[]) ->
  types := ['i64', 'ptr'] + [field.ir_type for field in fields]
  "{ #{types.join(', ')} }"

# Defines the LLVM struct type `layout` with the fields, and the type of its objects (see
# define_type).
export define_heap_object := (
  module: IrModule
  layout: String
  type: String
  linkage: String
  fields: HeapField[]
  name: String
  deinit: String? = nil
  weak_slot: Int? = nil
) ->
  module.add_type layout, heap_object_type(fields)
  define_type module, layout, type, linkage, fields, name, deinit, weak_slot

# Defines `type` and its functions, of the `linkage`, private for the layouts that each module
# numbers of its own (see Definition): the type of the objects of `layout` with the fields, as
# runtime/lerta.h has it, which the leak check names `name`. Its drop function, for a class's
# object, first lets go of the object's weak box, held in the field at `weak_slot` (see weak_box),
# and runs `deinit`, the symbol of the class's deinit method, if there is one.
export define_type := (
  module: IrModule
  layout: String
  type: String
  linkage: String
  fields: HeapField[]
  name: String
  deinit: String? = nil
  weak_slot: Int? = nil
) ->
  visit := suffixed_symbol(type, 'visit')
  define_visit module, layout, visit, linkage, fields
  drop := suffixed_symbol(type, 'drop')
  define_drop module, layout, drop, visit, linkage, fields, deinit, weak_slot
  name_constant := shared_string_constant(IrBuilder(module), name)
  initial := "{ ptr #{drop}, ptr #{visit}, ptr #{name_constant} }"
  module.define_constant type, linkage, '{ ptr, ptr, ptr }', initial

# Gives the visitor the reference that each counted field holds. It is inlined into the drop
# function, whose visitor, lerta_release, then is called directly.
define_visit := (
  module: IrModule, layout: String, visit: String, linkage: String, fields: HeapField[]
) ->
  ir := IrBuilder(module)
  for field at i in fields
    continue unless is_counted(field.owned)
    pointer := emit_heap_field_pointer(ir, layout, '%object', i)
    visit := (reference: String) -> ir.emit("call void %visitor(ptr #{reference})")
    if field.owned == VALUE
      emit_each_reference ir, ir.load(field.ir_type, pointer), field.type!, visit
    else
      visit emit_load_reference(ir, pointer, field.ir_type, field.owned)
  ir.emit 'ret void'
  ir.finish "#{linkage}void #{visit}(ptr %object, ptr %visitor) alwaysinline"

# The fields that are not counted are released first, as a generator's coroutine, which may use
# what the others hold.
define_drop := (
  module: IrModule, layout: String, drop: String, visit: String, linkage: String,
  fields: HeapField[], deinit: String?, weak_slot: Int?
) ->
  ir := IrBuilder(module)
  if weak_slot
    slot := emit_heap_field_pointer(ir, layout, '%object', weak_slot)
    call_void_runtime ir, 'void @lerta_weak_detach(ptr)', "ptr #{slot}"
  if deinit
    call_void_runtime ir, 'void @lerta_run_deinit(ptr, ptr)', "ptr %object, ptr #{deinit}"
  for field at i in fields
    continue if field.owned == NONE or is_counted(field.owned)
    pointer := emit_heap_field_pointer(ir, layout, '%object', i)
    emit_release_as ir, ir.load(field.ir_type, pointer), field.owned
  ir.module.declare 'lerta_release', 'declare void @lerta_release(ptr)'
  ir.emit "call void #{visit}(ptr %object, ptr @lerta_release)"
  ir.emit 'ret void'
  ir.finish "#{linkage}void #{drop}(ptr %object)"

export emit_heap_field_pointer := (ir: IrBuilder, layout: String, object: String, index: Int) ->
  ir.assign("getelementptr #{layout}, ptr #{object}, i32 0, i32 #{HEADER_FIELDS + index}")

# A new object of the type, with reference count 1 and uninitialized fields.
export emit_heap_allocate := (ir: IrBuilder, layout: String, type: String) ->
  end := ir.assign("getelementptr #{layout}, ptr null, i32 1")
  size := ir.assign("ptrtoint ptr #{end} to i64")
  call_runtime(ir, 'ptr @lerta_new(i64, ptr)', "i64 #{size}, ptr #{type}")

# Classes and structs: named by their types. Constructors and methods are generated like
# functions (see function).

# The pointer to the field of the name.
export emit_field_pointer := (ir: IrBuilder, object: String, info: ObjectInfo, name: String) ->
  place := object_field_place(ir.program, info, name)
  emit_heap_field_pointer(ir, object_ir_type(info.type), object, place)

# The value of the field of the class or struct, borrowed: of the object, or of the value.
export emit_borrowed_field := (ir: IrBuilder, object: String, info: ObjectInfo, field: FieldInfo) ->
  name := field.name.name
  unless is_value_type(ir.program, info.type)
    return ir.load(ir_type(ir.program, field.type!), emit_field_pointer(ir, object, info, name))
  place := object_field_place(ir.program, info, name)
  ir.assign("extractvalue #{ir_type(ir.program, info.type)} #{object}, #{place}")

# The pointer to the field of the name of a struct's value in the slot, as its constructor builds
# it.
export emit_slot_field_pointer := (ir: IrBuilder, slot: String, info: ObjectInfo, name: String) ->
  place := object_field_place(ir.program, info, name)
  ir.assign("getelementptr #{ir_type(ir.program, info.type)}, ptr #{slot}, i32 0, i32 #{place}")

# The place of the field of the name among the fields of the class or struct as laid out (see
# field_order), looked up by the info, which is quicker to hash than its type.
object_field_place := (program: ProgramWide, info: ObjectInfo, name: String) ->
  places_of := ->
    order := field_order(program, field_types(info))
    names := [info.fields[index].name.name for index in order]
    Map([(name, place) for name at place in names])
  program.object_field_places.get_or_add(info, places_of)[name]!

# The field of the name, which the class or struct has.
export field_named := (info: ObjectInfo, name: String) -> info.fields[field_index(info, name)]

field_types := (info: ObjectInfo) -> [field.type! for field in info.fields]

field_index := (info: ObjectInfo, name: String) ->
  info.fields.find_index((field) -> field.name.name == name)!

# The index of the field of the name, which the anonymous struct has.
export record_field_index := (type: RecordType, name: String) ->
  type.fields.find_index((field) -> field.name == name)!

# A class's object starts without a weak box.
export emit_allocate := (ir: IrBuilder, info: ObjectInfo) ->
  object := emit_heap_allocate(ir, object_ir_type(info.type), type_symbol(info.type))
  if is_class(info)
    ir.store 'ptr', 'null', emit_weak_slot_pointer(ir, object, info)
  object

# Its type has the linkage.
export define_object := (
  module: IrModule, program: ProgramWide, info: ObjectInfo, linkage: String
) ->
  types := field_types(info)
  fields := [
    for i in field_order(program, types)
      value_field(program, types[i])
  ]
  weak_slot := is_class(info) then fields.length
  fields.push plain_field('ptr') if is_class(info)
  deinit := info.has_deinit then special_method_symbol(program, info, 'deinit')
  layout := object_ir_type(info.type)
  type := type_symbol(info.type)
  name := format_type(info.type)
  define_heap_object module, layout, type, linkage, fields, name, deinit, weak_slot

is_class := (info: ObjectInfo) -> not info.type.is_struct

emit_weak_slot_pointer := (ir: IrBuilder, object: String, info: ObjectInfo) ->
  emit_heap_field_pointer(ir, object_ir_type(info.type), object, info.fields.length)

# The slot of the weak box of a class's object, or null for a struct's, which has none.
export emit_weak_slot_or_null := (ir: IrBuilder, object: String, info: ObjectInfo) ->
  if is_class(info)
    emit_weak_slot_pointer(ir, object, info)
  else
    'null'

# The weak box of a class's object, which a weak field holds instead of the object, owned; the
# object is borrowed.
emit_weak_box := (ir: IrBuilder, object: String, info: ObjectInfo) ->
  slot := emit_weak_slot_pointer(ir, object, info)
  call_runtime(ir, 'ptr @lerta_weak_box(ptr, ptr)', "ptr #{object}, ptr #{slot}")

# The weak box of a value of a class or of its optional type, which a weak local or field holds,
# owned, or null for nil; the object is borrowed.
export emit_weak_box_of := (ir: IrBuilder, program: ProgramWide, object: String, type: Type) ->
  info := info_of(program, inner_of(type) as ObjectType!)
  unless type is OptionalType
    return emit_weak_box(ir, object, info)
  is_present := ir.is_not_null(object)
  emit_branch(ir, 'ptr', is_present, -> emit_weak_box(ir, object, info), 'null')

# The object of a weak box, borrowed, or null if it is gone; a null box, for nil, gives null.
export emit_weak_object := (ir: IrBuilder, box: String) ->
  call_runtime(ir, 'ptr @lerta_weak_object(ptr)', "ptr #{box}")

# An i1: whether the object is of the type, or of a member of the union.
export emit_type_test := (ir: IrBuilder, object: String, type: Type) ->
  tests := [
    for member in members_of(type)
      emit_object_test(ir, object, member)
  ]
  any_of(ir, tests)

emit_object_test := (ir: IrBuilder, object: String, type: Type) ->
  object_type := emit_object_type(ir, object)
  if is_boxed_member(ir.program, type)
    return emit_box_test(ir, object_type, type)
  ir.assign("icmp eq ptr #{object_type}, #{object_type_symbol(ir, type)}")

# The type in the header of the objects of a member of a union that is no box: an array's or a
# map's, which the runtime gives, the same whatever their items, a class's, a struct's, a tuple's
# or an anonymous struct's own, or a String's, which is none.
object_type_symbol := (ir: IrBuilder, type: Type) ->
  return 'null' if is_kind(type, 'String')
  case type
    when ArrayType then runtime_type(ir, 'lerta_array_type')
    when MapType then runtime_type(ir, 'lerta_map_type')
    when TupleType, RecordType then values_type(ir, type)
    else type_symbol(type as ObjectType!)

runtime_type := (ir: IrBuilder, name: String) ->
  ir.module.declare name, "@#{name} = external constant { ptr, ptr, ptr }"
  "@#{name}"

# The type in the object's header.
export emit_object_type := (ir: IrBuilder, object: String) ->
  pointer := ir.assign("getelementptr { i64, ptr }, ptr #{object}, i32 0, i32 1")
  ir.load('ptr', pointer)

# A value of the IR type, computed by `of_member` for the member of the union that the object is:
# each member but the last is tested in turn.
export emit_member_dispatch := (
  ir: IrBuilder, object: String, members: Type[], result_type: String, of_member: (Type) -> String
) ->
  done := ir.fresh_label('member.done')
  incoming: String[]
  emit_member := (member: Type) ->
    value := of_member(member)
    incoming.push phi_incoming(value, ir.current_block)
    ir.branch done

  # The last member is what the object is where it is none of the others.
  for member in members.all_but_last()
    next := ir.fresh_label('member.next')
    matched := ir.fresh_label('member.matched')
    ir.branch_if emit_type_test(ir, object, member), matched, next
    ir.start_block matched
    emit_member member
    ir.start_block next
  emit_member members.last()!

  ir.start_block done
  return '' if result_type == 'void'
  ir.assign("phi #{result_type} #{incoming.join(', ')}")

# The types of the values, as declared, a record's fields in name order.
export value_types := (type: Type) ->
  case type
    when RecordType then [field.type for field in type.fields]
    when TupleType then type.items
    else panic('not an anonymous struct or a tuple')

# The LLVM struct type of the type, defined with the type of its objects at the first use.
values_layout := (ir: IrBuilder, type: Type) ->
  types := value_types(type)
  fields := [
    for i in field_order(ir.module.program, types)
      value_field(ir.program, types[i])
  ]
  define := (layout: String, module: IrModule) ->
    name := format_type(type)
    define_heap_object module, layout, values_type_symbol(type), 'linkonce_odr ', fields, name
  prefix := type is TupleType then '%lerta.tuple' else '%lerta.record'
  ir.module.named("values #{type_key(type)}", prefix, define)

# The type of the objects of a tuple or an anonymous struct, the same in every module, since a
# union may get one made in one and test it in another, as a box's is.
values_type_symbol := (type: Type) -> "@#{quoted_name("lerta.values.#{type_key(type)}")}"

# The type of the objects of the type, defined first.
values_type := (ir: IrBuilder, type: Type) ->
  values_layout ir, type
  values_type_symbol(type)

# The type of the objects of a layout that a module numbers of its own.
layout_type := (layout: String) -> suffixed_symbol(layout, 'type')

# A new anonymous struct or tuple, which takes over the values, owned, in their order.
export emit_values := (ir: IrBuilder, type: Type, values: String[]) ->
  if layout := value_layout_of(ir.program, type)
    value_type := ir_type(ir.program, type)
    var value = 'undef'
    for field at place in layout.fields
      part := "#{ir_type(ir.program, field.type)} #{values[field.index]}"
      value = ir.assign("insertvalue #{value_type} #{value}, #{part}, #{place}")
    return value
  layout := values_layout(ir, type)
  object := emit_heap_allocate(ir, layout, values_type_symbol(type))
  for value_type at i in value_types(type)
    ir.store ir_type(ir.program, value_type), values[i], emit_value_pointer(ir, object, type, i)
  object

# A new anonymous struct, which takes over the values, owned, given by field name.
export emit_record := (ir: IrBuilder, type: Type, values: Map<String, String>) ->
  emit_values(ir, type, [values[field.name]! for field in (type as RecordType!).fields])

# The pointer to the value at the index.
emit_value_pointer := (ir: IrBuilder, object: String, type: Type, index: Int) ->
  place := field_place(ir.module.program, type, value_types(type), index)
  emit_heap_field_pointer(ir, values_layout(ir, type), object, place)

# The value at the index, retained if a reference; the object is borrowed.
export emit_value_at := (ir: IrBuilder, object: String, type: Type, index: Int) ->
  value := emit_borrowed_value(ir, object, type, index)
  emit_retain_value ir, value, value_types(type)[index]
  value

# The value of an anonymous struct or a tuple at the index, borrowed.
export emit_borrowed_value := (ir: IrBuilder, values: String, type: Type, index: Int) ->
  if is_value_type(ir.program, type)
    place := field_place(ir.program, type, value_types(type), index)
    return ir.assign("extractvalue #{ir_type(ir.program, type)} #{values}, #{place}")
  value_type := value_types(type)[index]
  ir.load(ir_type(ir.program, value_type), emit_value_pointer(ir, values, type, index))

# The value of a field of an anonymous struct, as emit_value_at gives it.
export emit_record_field := (ir: IrBuilder, record: String, type: Type, name: String) ->
  emit_value_at(ir, record, type, record_field_index(type as RecordType!, name))

# The LLVM struct type of a cell of the type, defined with the type of its cells at the first use.
cell_layout := (ir: IrBuilder, type: Type) ->
  define := (layout: String, module: IrModule) ->
    # Cells of all types of the same IR type and ownership share it, but a value's, whose type tells
    # what of it to release.
    fields := [value_field(module.program, type)]
    define_heap_object module, layout, layout_type(layout), 'private ', fields, 'var'
  owned := ownership(ir.program, type)
  of_type := owned == VALUE then " #{type_key(type)}" else ''
  key := "cell #{ir_type(ir.program, type)} #{owned}#{of_type}"
  ir.module.named(key, '%lerta.cell', define)

# A new cell, which takes over the value, owned.
export emit_cell := (ir: IrBuilder, type: Type, value: String) ->
  layout := cell_layout(ir, type)
  cell := emit_heap_allocate(ir, layout, layout_type(layout))
  ir.store ir_type(ir.program, type), value, emit_cell_pointer(ir, type, cell)
  cell

# The pointer to the cell's value, which a var's reads and writes go through.
export emit_cell_pointer := (ir: IrBuilder, type: Type, cell: String) ->
  emit_heap_field_pointer(ir, cell_layout(ir, type), cell, 0)
