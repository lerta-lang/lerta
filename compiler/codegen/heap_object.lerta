# Objects on the heap with fields: classes and structs, anonymous structs, and cells. Each starts
# with the header `{ i64 ref_count, ptr drop }`, then holds its fields in order; its drop function
# releases the references the fields hold.
import { ObjectInfo } from '../checker/object_types'
import { IrBuilder, IrModule } from './ir_builder'
import {
  drop_symbol, emit_release, emit_retain, ir_type, method_symbol, object_ir_type, without_sigil
} from './lerta_ir'
import { is_reference_type, ObjectType, RecordType, Type, type_key } from '../types'

# The two header fields come before the object's own.
const HEADER_FIELDS = 2

# A field, by its IR type and whether it holds a reference, which the drop function releases.
export struct HeapField
  ir_type: String
  holds_reference: Bool

# A field that holds a value of the type.
export const value_field = (type: Type) ->
  HeapField ir_type: ir_type(type), holds_reference: is_reference_type(type)

# A field that holds no reference, such as a pointer to code, of the IR type.
export const plain_field = (ir: String) -> HeapField(ir_type: ir, holds_reference: false)

# The LLVM struct type of a heap object with the fields: the header, then the fields.
export const heap_object_type = (fields: Array<HeapField>) ->
  const types = ['i64', 'ptr']
  types.push field.ir_type for field in fields
  "{ #{types.join(', ')} }"

# Defines the LLVM struct type `layout` and the drop function `drop`, which first runs `deinit`,
# the symbol of a class's deinit method, if there is one.
export const define_heap_object = (
  module: IrModule
  layout: String
  drop: String
  fields: Array<HeapField>
  deinit: String?
) ->
  module.add_type "#{layout} = type #{heap_object_type(fields)}"
  const ir = IrBuilder(module)
  if deinit
    module.declare 'lerta_run_deinit', 'declare void @lerta_run_deinit(ptr, ptr)'
    ir.emit "call void @lerta_run_deinit(ptr %object, ptr #{deinit})"
  for i in 0...fields.length
    continue if not fields[i].holds_reference
    const pointer = emit_heap_field_pointer(ir, layout, '%object', i)
    emit_release ir, ir.assign("load ptr, ptr #{pointer}")
  ir.emit 'ret void'
  ir.finish "void #{drop}(ptr %object)"

export const emit_heap_field_pointer = (
  ir: IrBuilder
  layout: String
  object: String
  index: Int
) -> ir.assign("getelementptr #{layout}, ptr #{object}, i32 0, i32 #{HEADER_FIELDS + index}")

# A new object with reference count 1 and uninitialized fields.
export const emit_heap_allocate = (ir: IrBuilder, layout: String, drop: String) ->
  ir.module.declare 'lerta_alloc', 'declare ptr @lerta_alloc(i64, ptr)'
  const end = ir.assign("getelementptr #{layout}, ptr null, i32 1")
  const size = ir.assign("ptrtoint ptr #{end} to i64")
  ir.assign "call ptr @lerta_alloc(i64 #{size}, ptr #{drop})"

# Classes and structs: named by their types. Constructors and methods are generated like
# functions (see function).

# The pointer to the field of the name.
export const emit_field_pointer = (ir: IrBuilder, object: String, info: ObjectInfo, name: String) ->
  const index = info.fields.find_index((field) -> field.name.name == name)!
  emit_heap_field_pointer ir, object_ir_type(info.type), object, index

export const emit_allocate = (ir: IrBuilder, info: ObjectInfo) ->
  emit_heap_allocate ir, object_ir_type(info.type), drop_symbol(info.type)

export const define_object = (module: IrModule, info: ObjectInfo) ->
  const fields = [value_field(field.type!) for field in info.fields]
  const deinit = info.has_deinit then method_symbol(info.type, 'deinit') else nil
  define_heap_object module, object_ir_type(info.type), drop_symbol(info.type), fields, deinit

# An i1: whether the object is of the type. The drop function in the header tells the type, since
# every type has its own.
export const emit_type_test = (ir: IrBuilder, object: String, type: Type) ->
  const object_type = type is ObjectType then type else throw 'is tests a class or struct'
  const pointer = ir.assign("getelementptr { i64, ptr }, ptr #{object}, i32 0, i32 1")
  const drop = ir.assign("load ptr, ptr #{pointer}")
  ir.assign "icmp eq ptr #{drop}, #{drop_symbol(object_type)}"

# A value of the IR type, computed by `of_member` for the member of the union that the object is:
# each member but the last is tested in turn.
export const emit_member_dispatch = (
  ir: IrBuilder
  object: String
  members: Array<Type>
  result_type: String
  of_member: (Type) -> String
) ->
  const done = ir.fresh_label('member.done')
  const incoming: Array<String> = []
  for i in 0...members.length
    const is_last = i == members.length - 1
    const next = is_last then '' else ir.fresh_label('member.next')
    if not is_last
      const matched = ir.fresh_label('member.matched')
      const test = emit_type_test(ir, object, members[i])
      ir.emit "br i1 #{test}, label %#{matched}, label %#{next}"
      ir.start_block matched
    const value = of_member(members[i])
    const block = ir.current_block
    ir.emit "br label %#{done}"
    ir.start_block next if not is_last
    incoming.push "[ #{value}, %#{block} ]"
  ir.start_block done
  ir.assign "phi #{result_type} #{incoming.join(', ')}"

# Anonymous structs: their fields are in name order. Each structural type has its own LLVM type
# and drop function, defined once.

# The LLVM struct type of the record type, defined with its drop function at the first use.
const record_layout = (ir: IrBuilder, type: RecordType) ->
  const fields = [value_field(field.type) for field in type.fields]
  const define = (name: String, module: IrModule) ->
    define_heap_object module, name, drop_name(name), fields, nil
  ir.module.named "record #{type_key(type)}", '%lerta.record', define

const drop_name = (layout: String) -> "@#{without_sigil(layout)}.drop"

const record_type_of = (type: Type) ->
  type is RecordType then type else throw 'expected an anonymous struct type'

# A new anonymous struct, which takes over the values, owned, given by field name.
export const emit_record = (ir: IrBuilder, type: Type, values: Map<String, String>) ->
  const record_type = record_type_of(type)
  const layout = record_layout(ir, record_type)
  const record = emit_heap_allocate(ir, layout, drop_name(layout))
  for i in 0...record_type.fields.length
    const field = record_type.fields[i]
    const pointer = emit_heap_field_pointer(ir, layout, record, i)
    ir.emit "store #{ir_type(field.type)} #{values[field.name]!}, ptr #{pointer}"
  record

# The value of a field, retained if a reference; the record is borrowed.
export const emit_record_field = (ir: IrBuilder, record: String, type: Type, name: String) ->
  const record_type = record_type_of(type)
  const layout = record_layout(ir, record_type)
  const index = record_type.fields.find_index((field) -> field.name == name)!
  const field_type = record_type.fields[index].type
  const pointer = emit_heap_field_pointer(ir, layout, record, index)
  const value = ir.assign("load #{ir_type(field_type)}, ptr #{pointer}")
  emit_retain ir, value if is_reference_type(field_type)
  value

# Cells: each holds one `var` that function literals capture, so that the function that declares
# it and the literals share it. The scope that declares the var owns its cell, and each closure
# that captures it holds a reference too.

# The LLVM struct type of a cell of the type, defined with its drop function at the first use;
# types of the same representation share them.
const cell_layout = (ir: IrBuilder, type: Type) ->
  const define = (name: String, module: IrModule) ->
    define_heap_object module, name, drop_name(name), [value_field(type)], nil
  const key = "cell #{ir_type(type)} #{is_reference_type(type)}"
  ir.module.named key, '%lerta.cell', define

# A new cell, which takes over the value, owned.
export const emit_cell = (ir: IrBuilder, type: Type, value: String) ->
  const layout = cell_layout(ir, type)
  const cell = emit_heap_allocate(ir, layout, drop_name(layout))
  ir.emit "store #{ir_type(type)} #{value}, ptr #{emit_cell_pointer(ir, type, cell)}"
  cell

# The pointer to the cell's value, which a var's reads and writes go through.
export const emit_cell_pointer = (ir: IrBuilder, type: Type, cell: String) ->
  emit_heap_field_pointer ir, cell_layout(ir, type), cell, 0
