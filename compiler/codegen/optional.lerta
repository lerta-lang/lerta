# Optional values in the generated code (see docs/internals/memory.md, and
# is_nil_by_null for interface values).
import emit_branch, IrBuilder from './ir_builder'
import emit_interface_data, ir_type, is_nil_by_null from './lerta_ir'
import is_reference_type, optional_type, OptionalType, Type from '../types'

# The IR constant for nil of the optional type.
export nil_constant := (type: Type) ->
  return 'zeroinitializer' if is_nil_by_null(type)
  inner := type is OptionalType then type.inner else panic('expected an optional type')
  "{ i1 false, #{ir_type(inner)} zeroinitializer }"

# A value of the inner type, made optional.
export emit_wrap := (ir: IrBuilder, operand: String, inner: Type) ->
  return operand if is_nil_by_null(optional_type(inner))
  type := ir_type(optional_type(inner))
  inner_ir := ir_type(inner)
  present := "{ i1 true, #{inner_ir} zeroinitializer }"
  ir.assign("insertvalue #{type} #{present}, #{inner_ir} #{operand}, 1")

# An i1 that is true when the optional value is not nil.
export emit_is_present := (ir: IrBuilder, operand: String, type: Type) ->
  if is_nil_by_null(type)
    pointer := is_reference_type(type) then operand else emit_interface_data(ir, operand)
    return ir.is_not_null(pointer)
  ir.assign("extractvalue #{ir_type(type)} #{operand}, 0")

export emit_is_nil := (ir: IrBuilder, operand: String, type: Type) ->
  ir.negate(emit_is_present(ir, operand, type))

# The value without nil, which must not be nil.
export emit_unwrap := (ir: IrBuilder, operand: String, type: Type) ->
  is_nil_by_null(type) then operand else ir.assign("extractvalue #{ir_type(type)} #{operand}, 1")

# An i1: whether the optional value is not nil and `test` holds for it without nil; it is tested
# only then.
export emit_present_test := (
  ir: IrBuilder, operand: String, type: Type, test: (String) -> String
) ->
  present := emit_is_present(ir, operand, type)
  emit_branch(ir, 'i1', present, -> test(emit_unwrap(ir, operand, type)), 'false')
