# Optional values in the generated code (see docs/internals/memory.md, and
# is_nil_by_null for interface values).
import ProgramWide from '../checker/shared'
import emit_branch, IrBuilder from './ir_builder'
import emit_interface_data, ir_type, is_nil_by_null, is_reference, LERTA_IMMORTAL from './lerta_ir'
import optional_type, OptionalType, Type from '../types'

# The IR constant for nil of the optional type.
export nil_constant := (program: ProgramWide, type: Type) ->
  return 'zeroinitializer' if is_nil_by_null(program, type)
  inner := type is OptionalType then type.inner else panic('expected an optional type')
  "{ i1 false, #{ir_type(program, inner)} zeroinitializer }"

# A value of the inner type, made optional. An inner value that is nil when null, made optional
# again, is null only for the outer nil (see nil_object).
export emit_wrap := (ir: IrBuilder, operand: String, inner: Type) ->
  if is_nil_by_null(ir.program, optional_type(inner))
    return operand if inner is not OptionalType or inner.opaque == nil
    depth := optional_depth(inner)
    shift := (pointer: String) ->
      from := ['null', nil_objects(ir, depth - 1)...]
      emit_mapped(ir, pointer, from, nil_objects(ir, depth))
    return with_pointer(ir, operand, inner, shift)
  type := ir_type(ir.program, optional_type(inner))
  inner_ir := ir_type(ir.program, inner)
  present := "{ i1 true, #{inner_ir} zeroinitializer }"
  ir.assign("insertvalue #{type} #{present}, #{inner_ir} #{operand}, 1")

# An i1 that is true when the optional value is not nil.
export emit_is_present := (ir: IrBuilder, operand: String, type: Type) ->
  if is_nil_by_null(ir.program, type)
    return ir.is_not_null(pointer_of(ir, operand, type))
  ir.assign("extractvalue #{ir_type(ir.program, type)} #{operand}, 0")

export emit_is_nil := (ir: IrBuilder, operand: String, type: Type) ->
  ir.negate(emit_is_present(ir, operand, type))

# The value without nil, which must not be nil.
export emit_unwrap := (ir: IrBuilder, operand: String, type: Type) ->
  unless is_nil_by_null(ir.program, type)
    return ir.assign("extractvalue #{ir_type(ir.program, type)} #{operand}, 1")
  inner := type is OptionalType then type.inner else panic('expected an optional type')
  return operand unless inner is OptionalType
  depth := optional_depth(inner)
  shift := (pointer: String) ->
    to := ['null', nil_objects(ir, depth - 1)...]
    emit_mapped(ir, pointer, nil_objects(ir, depth), to)
  with_pointer(ir, operand, type, shift)

# A value of an instance's own result type as its caller's (see caller_type in checker generics):
# the result made optional of an optional type argument is the type argument, nil where either is.
export emit_as_caller := (ir: IrBuilder, value: String, own: Type, caller: Type) ->
  return value if optional_depth(own) <= optional_depth(caller)
  present := emit_is_present(ir, value, own)
  emit_branch(
    ir
    ir_type(ir.program, caller)
    present
    -> emit_unwrap(ir, value, own)
    nil_constant(ir.program, caller)
  )

# How many times the type is optional, as an opaque type argument made optional is again.
optional_depth := (type: Type): Int ->
  type is OptionalType then 1 + optional_depth(type.inner) else 0

# The objects that stand for the nils inside a reference, or an interface value, optional again:
# the first `count`, the first of them for nil of the type that it is optional again of, the next
# for nil of the type that that one is optional again of, and so on. Null is the outer nil. They are
# immortal and no value is one; each module defines them alike, which the linker keeps one of.
nil_objects := (ir: IrBuilder, count: Int) ->
  object := (depth: Int) ->
    name := "@lerta.nil.#{depth}"
    ir.module.define_once "nil object #{depth}", (module) ->
      initial := "{ i64 #{LERTA_IMMORTAL}, ptr null }"
      module.define_global name, "linkonce_odr global { i64, ptr } #{initial}"
    name
  [object(depth) for depth in 1..=count]

# The pointer, each of `from` replaced by the one of `to` at its place.
emit_mapped := (ir: IrBuilder, pointer: String, from: String[], to: String[]) ->
  var mapped = pointer
  for replaced at i in from
    is_replaced := ir.assign("icmp eq ptr #{pointer}, #{replaced}")
    mapped = ir.assign("select i1 #{is_replaced}, ptr #{to[i]}, ptr #{mapped}")
  mapped

# The pointer of a reference, or the data of an interface value, which is null for nil.
pointer_of := (ir: IrBuilder, operand: String, type: Type) ->
  if is_reference(ir.program, type)
    operand
  else
    emit_interface_data(ir, operand)

# The value with its pointer (see pointer_of) replaced by `shift` of it.
with_pointer := (ir: IrBuilder, operand: String, type: Type, shift: (String) -> String) ->
  shifted := shift(pointer_of(ir, operand, type))
  return shifted if is_reference(ir.program, type)
  ir.assign("insertvalue #{ir_type(ir.program, type)} #{operand}, ptr #{shifted}, 0")

# An i1: whether the optional value is not nil and `test` holds for it without nil; it is tested
# only then.
export emit_present_test := (
  ir: IrBuilder, operand: String, type: Type, test: (String) -> String
) ->
  present := emit_is_present(ir, operand, type)
  emit_branch(ir, 'i1', present, -> test(emit_unwrap(ir, operand, type)), 'false')
