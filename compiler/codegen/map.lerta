# Operations on maps in the generated code, through the runtime (runtime/map.c).
import compares_by_contents from '../checker/equality'
import ProgramWide from '../checker/shared'
import
  emit_get, emit_item_slot, emit_length, emit_load_item, emit_store_item, from_item, item_kind,
  narrow_item_kind, to_item
from './array'
import item_functions from './equality'
import emit_float_word from './float'
import emit_values, HeapField from './heap_object'
import emit_branch, emit_count_up, IrBuilder from './ir_builder'
import define_kind, emit_iter, IterKind, load_state from './iter_protocol'
import emit_release_value, emit_retain_value, ir_type, is_nil_by_null from './lerta_ir'
import call_runtime, call_void_runtime from './runtime_calls'
import
  is_float, is_identity_type, is_number, is_one_of_kinds, MapType, optional_type, TupleType, Type,
  type_key
from '../types'

# The values of LertaKeyKind in runtime/lerta.h: a key narrower than a word is of the integer keys
# of the kind of its items.
key_kind := (program: ProgramWide, key: Type) ->
  narrow := narrow_item_kind(key)
  case
    when narrow != nil then narrow
    when is_number(key) or is_one_of_kinds(key, ['Char', ENUM]) then 0
    when is_one_of_kinds(key, ['String', 'Binary']) then 1
    when is_identity_type(key) and not compares_by_contents(program, key) then 2
    else 3

# Whether the runtime hashes and compares the keys itself, rather than through functions that may
# run code of the program, as a key's own `hash` and `==` do.
export are_keys_plain := (program: ProgramWide, key: Type) -> key_kind(program, key) != 3

key_word := (ir: IrBuilder, key: String, type: Type) ->
  is_float(type) then emit_float_word(ir, key, type) else to_item(ir, key, type)

# Keys that compare by their contents come with the functions that hash and compare them.
export emit_map_new := (ir: IrBuilder, program: ProgramWide, type: MapType) ->
  kind := key_kind(program, type.key)
  functions := kind == 3 then item_functions(ir.module, program, type.key)
  hash := functions?.hash ? 'null'
  equals := functions?.equals ? 'null'
  args := "i32 #{kind}, i32 #{item_kind(type.value)}, ptr #{hash}, ptr #{equals}"
  call_runtime ir, 'ptr @lerta_map_create(i32, i32, ptr, ptr)', args

export emit_map_length := (ir: IrBuilder, map: String) ->
  call_runtime ir, 'i64 @lerta_map_length(ptr)', "ptr #{map}"

# The place of the key's value in the map, which is read and written there as the value's type, as
# an array's items are, or null for a key that the map does not hold.
export emit_find := (ir: IrBuilder, map: String, key: String, type: MapType) ->
  args := "ptr #{map}, i64 #{key_word(ir, key, type.key)}"
  call_runtime ir, 'ptr @lerta_map_find(ptr, i64)', args

# The place of the key's value, with zeros for a key that the map then holds, retained; the caller
# writes the value there, retained.
export emit_place := (ir: IrBuilder, map: String, key: String, type: MapType) ->
  args := "ptr #{map}, i64 #{key_word(ir, key, type.key)}"
  call_runtime ir, 'ptr @lerta_map_place(ptr, i64)', args

# The value as a V?, owned; a missing reference, or interface value, reads as zeros, which are
# nil.
export emit_map_get := (ir: IrBuilder, map: String, key: String, type: MapType) ->
  place := emit_find(ir, map, key, type)
  found := ir.assign("icmp ne ptr #{place}, null")
  value := emit_held_at(ir, place, found, type)
  optional := optional_type(type.value)
  return value if is_nil_by_null(optional)
  optional_ir := ir_type(optional)
  flagged := ir.assign("insertvalue #{optional_ir} undef, i1 #{found}, 0")
  ir.assign "insertvalue #{optional_ir} #{flagged}, #{ir_type(type.value)} #{value}, 1"

# The value at the place that emit_find gave, owned, where `found` tells that it gave one; zeros
# elsewhere.
export emit_held_at := (ir: IrBuilder, place: String, found: String, type: MapType) ->
  read := ->
    held := emit_load_item(ir, place, type.value)
    emit_retain_value ir, held, type.value
    held
  emit_branch ir, ir_type(type.value), found, read, 'zeroinitializer'

# The map retains the key and the value, which stay owned by the caller. The new value is retained
# before the old one is released, in case they are the same object.
export emit_map_set := (ir: IrBuilder, map: String, key: String, value: String, type: MapType) ->
  emit_set_at ir, emit_place(ir, map, key, type), value, type

# Writes the value, retained, at the place of a key's value, releasing the one there.
export emit_set_at := (ir: IrBuilder, place: String, value: String, type: MapType) ->
  emit_retain_value ir, value, type.value
  old := emit_load_item(ir, place, type.value)
  emit_store_item ir, place, value, type.value
  emit_release_value ir, old, type.value

# The builtin methods of maps and sets (see codegen builtins), of borrowed arguments.
export emit_map_remove := (ir: IrBuilder, map: String, key: String, type: MapType) ->
  args := "ptr #{map}, i64 #{key_word(ir, key, type.key)}"
  call_void_runtime ir, 'void @lerta_map_remove(ptr, i64)', args

export emit_map_keys := (ir: IrBuilder, map: String, type: MapType) ->
  emit_cursor_iter ir, map, type, true

export emit_map_entries := (ir: IrBuilder, map: String, type: MapType) ->
  emit_cursor_iter ir, map, type, false

# A set is a map whose values take no bytes, which the place of an item holds.
export emit_set_contains := (ir: IrBuilder, set: String, item: String, type: MapType) ->
  ir.assign "icmp ne ptr #{emit_find(ir, set, item, type)}, null"

# Whether the item is new to the set, which it then holds: whether the write made the set longer,
# which takes one lookup of the item.
export emit_set_add := (ir: IrBuilder, set: String, item: String, type: MapType) ->
  before := emit_map_length(ir, set)
  emit_place ir, set, item, type
  ir.assign "icmp ne i64 #{before}, #{emit_map_length(ir, set)}"

export emit_set_iter := (ir: IrBuilder, set: String, type: MapType) ->
  emit_cursor_iter ir, set, type, true

# The entries of a borrowed map, which the Iter traverses by a cursor (LertaMapCursor in
# runtime/lerta.h): the keys alone, as a set gives its items, or as tuples of a key and a value.
emit_cursor_iter := (ir: IrBuilder, map: String, type: MapType, keys_only: Bool) ->
  item := keys_only then type.key else TupleType([type.key, type.value])
  has_next := (body: IrBuilder, kind: IterKind) ->
    cursor := load_state(body, kind, 0)
    more := call_runtime(body, 'i1 @lerta_map_cursor_has_next(ptr)', "ptr #{cursor}")
    body.emit "ret i1 #{more}"
  next := (body: IrBuilder, kind: IterKind) ->
    key_slot := body.alloca('i64')
    # The keys alone take no value from the cursor.
    value_slot := keys_only then 'null' else emit_item_slot(body, type.value)
    args := "ptr #{load_state(body, kind, 0)}, ptr #{key_slot}, ptr #{value_slot}"
    call_void_runtime body, 'void @lerta_map_cursor_next(ptr, ptr, ptr)', args
    key := from_item(body, body.assign("load i64, ptr #{key_slot}"), type.key)
    return body.emit("ret #{ir_type(item)} #{key}") if keys_only
    entry := emit_values(body, item, [key, emit_load_item(body, value_slot, type.value)])
    body.emit "ret ptr #{entry}"
  state := [HeapField(ir_type: 'ptr', owned: REFERENCE)]
  traversed := keys_only then 'keys' else 'entries'
  kind := define_kind(ir, "map #{traversed} #{type_key(type)}", state, item, has_next, next)
  emit_iter ir, kind, [call_runtime(ir, 'ptr @lerta_map_cursor(ptr)', "ptr #{map}")]

# Adds the items of a borrowed array to the set, in order, as `Set(xs)` does.
export emit_add_items := (ir: IrBuilder, set: String, array: String, type: MapType) ->
  emit_count_up ir, emit_length(ir, array), (index) ->
    item := emit_get(ir, array, index, type.key)
    emit_set_add ir, set, item, type
    emit_release_value ir, item, type.key
