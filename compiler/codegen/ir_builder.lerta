# Accumulates the text of an LLVM IR module. It knows IR syntax only, not Lerta semantics.

# A function or a global of a module.
export struct Definition
  symbol: String
  text: String
  declaration: String?

const LINKAGES = ['private ', 'internal ', 'external ', 'linkonce_odr ']

export class IrModule
  # Quoted, the name of the Lerta module, or of the program's entry for all modules as one.
  source_filename: String
  # The attributes of every function, such as the target's CPU, or none.
  function_attributes: String
  # The type of llvm.coro.end, i1, or void from LLVM 23 on, as the LLVM that reads the IR has it.
  coro_end_type: String
  # The definitions of named types, by name.
  types: Map<String, String> = Map()
  globals: Definition[] = []
  # The declarations by symbol, in the order they were first made.
  declarations: Map<String, String> = Map()
  functions: Definition[] = []
  defined: Set<String> = Set()
  symbol_count = 0
  names: Map<String, String> = Map()

  # The name `<prefix>.<n>` given to `key`, the same for the same key; `define` runs when the name
  # is first given, to define what it names.
  named = (key: String, prefix: String, define: (String, IrModule) -> void) ->
    return existing if const existing = @names[key]
    const name = "#{prefix}.#{@names.length}"
    @names[key] = name
    define name, @
    name

  # A new global symbol, `@<prefix>.<n>`.
  fresh_symbol = (prefix: String) ->
    const symbol = "@#{prefix}.#{@symbol_count}"
    @symbol_count += 1
    symbol

  # Runs `define` the first time `key` is given, for definitions that are made on demand.
  define_once = (key: String, define: (IrModule) -> void) ->
    return if @defined.has(key)
    @defined.add key
    define @

  # Declaring the same symbol again with the same text is harmless.
  declare = (symbol: String, declaration: String) ->
    if const existing = @declarations[symbol]
      panic "conflicting declarations of #{symbol}" if existing != declaration
    @declarations[symbol] = declaration

  # Adds `@<prefix>.<n> = <definition>`, which gives its linkage, and returns the global's name.
  global = (prefix: String, definition: String) ->
    const name = "@#{prefix}.#{@globals.length}"
    @define_global name, definition
    name

  # Adds `<name> = <definition>`, which gives its linkage, for a global named by the caller.
  define_global = (name: String, definition: String) ->
    @globals.push Definition(symbol: name, text: "#{name} = #{definition}", declaration: nil)

  # A global variable of the IR type, which other modules may use.
  define_variable = (name: String, type: String, initial: String) ->
    const declaration = "#{name} = external global #{type}"
    const symbol = name
    const text = "#{name} = global #{type} #{initial}"
    @globals.push Definition(symbol, text, declaration)

  add_type = (name: String, body: String) -> @types[name] = "#{name} = type #{body}"

  # Adds the function `define <signature>` with the lines of its body; without a linkage, the other
  # modules may use it (see Definition).
  define_function = (signature: String, body: String[]) ->
    const attributes = @function_attributes == '' then '' else ' #0'
    const text = ["define #{signature}#{attributes} {", body..., '}'].join("\n")
    const has_linkage = LINKAGES.any((linkage) -> signature.starts_with(linkage))
    const declaration = has_linkage then nil else "declare #{signature}"
    const symbol = defined_symbol(signature)
    @functions.push Definition(symbol, text, declaration)

  # The module, with the declarations and the types that it takes from other modules.
  render = (imported_types: String[], imported_declarations: String[]) ->
    const lines = [
      "source_filename = #{@source_filename}"
      imported_types...
      @types.values().to_array()...
      [definition.text for definition in @globals]...
      @declarations.values().to_array()...
      imported_declarations...
      [definition.text for definition in @functions]...
    ]
    lines.push "attributes #0 = { #{@function_attributes} }" if @function_attributes != ''
    "#{lines.join("\n")}\n"

# The symbol that a function's signature defines: the first, after its result type and attributes.
const defined_symbol = (signature: String) ->
  const after_sigil = signature.split('@')[1]
  return "@#{after_sigil.split('(')[0]}" if not after_sigil.starts_with('"')
  "@\"#{after_sigil.split('"')[1]}\""

# Accumulates the body of one function of a module.
export class IrBuilder
  module: IrModule
  body: String[] = []
  # Stack slots go first in the entry block, where LLVM promotes them to registers.
  stack_slots: String[] = []
  register_count = 0
  label_count = 0
  # The block that instructions are being emitted into, as needed by `phi`.
  current_block = 'entry'

  # Emits `%r<n> = <value>` and returns the register.
  assign = (value: String) ->
    const register = @fresh_register()
    @assign_to register, value
    register

  # A register to be assigned later with `assign_to`, for `phi` operands defined further down.
  fresh_register = ->
    const register = "%r#{@register_count}"
    @register_count += 1
    register

  assign_to = (register: String, value: String) -> @emit("#{register} = #{value}")

  # A stack slot for a value of the IR type, valid in the whole function.
  alloca = (type: String) ->
    const register = @fresh_register()
    @stack_slots.push "  #{register} = alloca #{type}"
    register

  emit = (instruction: String) -> @body.push("  #{instruction}")

  fresh_label = (prefix: String) ->
    const label = "#{prefix}.#{@label_count}"
    @label_count += 1
    label

  start_block = (label: String) ->
    @body.push "#{label}:"
    @current_block = label

  # A block for the code after a jump or a throw, which never runs but still needs one to go in.
  start_unreachable = -> @start_block(@fresh_label('unreachable'))

  # Adds the function `define <signature>`, holding everything emitted, to the module.
  finish = (signature: String) ->
    @module.define_function signature, ['entry:', @stack_slots..., @body...]

# Emits `body` to run only where the condition holds.
export const emit_when = (ir: IrBuilder, condition: String, body: () -> void) ->
  const then_label = ir.fresh_label('branch.then')
  const end_label = ir.fresh_label('branch.end')
  ir.emit "br i1 #{condition}, label %#{then_label}, label %#{end_label}"
  ir.start_block then_label
  body()
  ir.emit "br label %#{end_label}"
  ir.start_block end_label

# A value of the IR type: `then_value` where the condition holds, computed only there, and
# `otherwise` elsewhere.
export const emit_branch = (
  ir: IrBuilder, type: String, condition: String, then_value: () -> String, otherwise: String
) ->
  const from = ir.current_block
  var value = ''
  var value_block = ''
  const compute = ->
    value = then_value()
    value_block = ir.current_block
  emit_when ir, condition, compute
  ir.assign "phi #{type} [ #{otherwise}, %#{from} ], [ #{value}, %#{value_block} ]"
