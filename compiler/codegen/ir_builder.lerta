# Accumulates the text of an LLVM IR module. It knows IR syntax only, not Lerta semantics.
import Position from '../ast'
import Metadata from './metadata'
import SourceLines, SourceScope from './source_lines'

# A function or a global of a module.
export struct Definition
  symbol: String
  text: String
  declaration: String?
  # The names in the text (see names_in), which linking looks up.
  names: String[]

definition_of := (symbol: String, text: String, declaration: String?) ->
  Definition symbol, text, declaration, names: names_in(text)

# The symbols, `@name` or `@"name"`, and the named types, `%"name"`, in the text, in order, read in
# one pass, as the text of a function is long. Other quoted text, as a `c"..."` constant, is passed
# over, so that an `@` in it starts no name; in well-formed IR, every quote is closed.
names_in := (text: String) ->
  bytes := text.binary
  names: String[]
  var i = 0
  while i < bytes.length
    byte := bytes[i]
    is_type := byte == '%' and i + 1 < bytes.length and bytes[i + 1] == '"'
    if byte == '@' or is_type
      start := i
      i += 1
      if i < bytes.length and bytes[i] == '"'
        i = after_quote(bytes, i)
      else
        i += 1 while i < bytes.length and is_name_byte(bytes[i])
      names.push bytes.text(start, i)!
    else if byte == '"'
      i = after_quote(bytes, i)
    else
      i += 1
  names

# The place after the quote that closes the one at `start`.
after_quote := (bytes: Binary, start: Int) ->
  var i = start + 1
  i += 1 while i < bytes.length and bytes[i] != '"'
  min i + 1, bytes.length

is_name_byte := (byte: Byte) ->
  byte.is_letter() or byte.is_digit() or byte == '.' or byte == '_' or byte == '$' or byte == '-'

LINKAGES := ['private ', 'internal ', 'external ', 'linkonce_odr ']

export class IrModule
  # Quoted, the name of the Lerta module, or of the program's entry for all modules as one.
  source_filename: String
  # The attributes of every function, such as the target's CPU, or none.
  function_attributes: String
  # The type of llvm.coro.end, i1, or void from LLVM 23 on, as the LLVM that reads the IR has it.
  coro_end_type: String
  # The definitions of named types, by name.
  types: Map<String, String> = Map()
  globals: Definition[] = []
  # The declarations by symbol, in the order they were first made.
  declarations: Map<String, String> = Map()
  functions: Definition[] = []
  defined: Set<String> = Set()
  var symbol_count = 0
  names: Map<String, String> = Map()
  metadata := Metadata()
  # With `--source-lines`, the metadata of the debug information, where the instructions come
  # from in the source, as LLVM's line tables have it; nil without.
  var source_lines: SourceLines? = nil

  # The name `<prefix>.<n>` given to `key`, the same for the same key; `define` runs when the name
  # is first given, to define what it names.
  named := (key: String, prefix: String, define: (String, IrModule) -> void) ->
    return existing if existing := @names[key]
    name := "#{prefix}.#{@names.length}"
    @names[key] = name
    define name, @
    name

  # A new global symbol, `@<prefix>.<n>`.
  fresh_symbol := (prefix: String) ->
    symbol := "@#{prefix}.#{@symbol_count}"
    @symbol_count += 1
    symbol

  # Runs `define` the first time `key` is given, for definitions that are made on demand.
  define_once := (key: String, define: (IrModule) -> void) ->
    return unless @defined.add(key)
    define @

  # Declaring the same symbol again with the same text is harmless.
  declare := (symbol: String, declaration: String) ->
    if existing := @declarations[symbol]
      panic "conflicting declarations of #{symbol}" if existing != declaration
    @declarations[symbol] = declaration

  # Adds `@<prefix>.<n> = <definition>`, which gives its linkage, and returns the global's name.
  global := (prefix: String, definition: String) ->
    name := "@#{prefix}.#{@globals.length}"
    @define_global name, definition
    name

  # Adds `<name> = <definition>`, which gives its linkage, for a global named by the caller.
  define_global := (name: String, definition: String) ->
    @globals.push definition_of(name, "#{name} = #{definition}", nil)

  # A constant of the IR type, of the linkage; without one, the other modules may use it.
  define_constant := (name: String, linkage: String, type: String, initial: String) ->
    declaration := linkage.is_empty() then "#{name} = external constant #{type}"
    symbol := name
    text := "#{name} = #{linkage}constant #{type} #{initial}"
    @globals.push definition_of(symbol, text, declaration)

  # A global variable of the IR type, which other modules may use.
  define_variable := (name: String, type: String, initial: String) ->
    declaration := "#{name} = external global #{type}"
    symbol := name
    text := "#{name} = global #{type} #{initial}"
    @globals.push definition_of(symbol, text, declaration)

  add_type := (name: String, body: String) -> @types[name] = "#{name} = type #{body}"

  # Adds the function `define <signature>` with the lines of its body; without a linkage, the other
  # modules may use it (see Definition).
  define_function := (signature: String, body: String[]) ->
    @define_function_in signature, body, nil

  # As define_function, with the debug information of the function, `!<n>`, if it has some.
  define_function_in := (signature: String, body: String[], subprogram: String?) ->
    attributes := @function_attributes.is_empty() then '' else ' #0'
    debug := subprogram then " !dbg #{subprogram}" else ''
    text := ["define #{signature}#{attributes}#{debug} {", body..., '}'].join("\n")
    has_linkage := LINKAGES.any(signature.starts_with)
    declaration := has_linkage then nil else "declare #{signature}"
    symbol := defined_symbol(signature)
    @functions.push definition_of(symbol, text, declaration)

  # The lines of the module, with the declarations and the types that it takes from other modules,
  # which are written out one by one rather than joined, as a module's text is large.
  render := (imported_types: String[], imported_declarations: String[]) ->
    lines := [
      "source_filename = #{@source_filename}"
      imported_types...
      @types.values().to_array()...
      [definition.text for definition in @globals]...
      @declarations.values().to_array()...
      imported_declarations...
      [definition.text for definition in @functions]...
    ]
    lines.push "attributes #0 = { #{@function_attributes} }" unless @function_attributes.is_empty()
    # Naming the nodes may make more of them.
    named: String[]
    named.append source_lines.named_metadata() if source_lines := @source_lines
    lines.append @metadata.nodes
    lines.append named
    lines

# The symbol that a function's signature defines: the first, after its result type and attributes.
defined_symbol := (signature: String) ->
  after_sigil := signature.split('@')[1]
  return "@#{after_sigil.split('(')[0]}" unless after_sigil.starts_with('"')
  "@\"#{after_sigil.split('"')[1]}\""

# Accumulates the body of one function of a module.
export class IrBuilder
  module: IrModule
  body: String[] = []
  # Stack slots go first in the entry block, where LLVM promotes them to registers.
  stack_slots: String[] = []
  var register_count = 0
  var label_count = 0
  # The block that instructions are being emitted into, as needed by `phi`.
  var current_block = 'entry'
  # Where the code being emitted is in the source, of the function of the name in the file, for
  # the module's source lines; nil for code that is no function of the program.
  scope: SourceScope? = default nil
  var location: Position? = nil
  # Where the function is declared, which its subprogram starts at.
  var declared_at: Position? = nil
  var subprogram: String? = nil

  # Emits `%r<n> = <value>` and returns the register.
  assign := (value: String) ->
    register := @fresh_register()
    @assign_to register, value
    register

  # A register to be assigned later with `assign_to`, for `phi` operands defined further down.
  fresh_register := ->
    register := "%r#{@register_count}"
    @register_count += 1
    register

  assign_to := (register: String, value: String) -> @emit("#{register} = #{value}")

  # A stack slot for a value of the IR type, valid in the whole function.
  alloca := (type: String) ->
    register := @fresh_register()
    @stack_slots.push "  #{register} = alloca #{type}"
    register

  emit := (instruction: String) -> @body.push("  #{instruction}#{@debug_location()}")

  # Loads a value of the IR type; the tag, as `, !tbaa !<n>`, says what the memory may alias.
  load := (type: String, pointer: String, tag = '') -> @assign("load #{type}, ptr #{pointer}#{tag}")

  store := (type: String, value: String, pointer: String, tag = '') ->
    @emit "store #{type} #{value}, ptr #{pointer}#{tag}"

  # An i1 that is true where the i1 is false.
  negate := (condition: String) -> @assign("xor i1 #{condition}, true")

  is_null := (pointer: String) -> @assign("icmp eq ptr #{pointer}, null")

  is_not_null := (pointer: String) -> @assign("icmp ne ptr #{pointer}, null")

  branch := (label: String) -> @emit("br label %#{label}")

  branch_if := (condition: String, then_label: String, else_label: String) ->
    @emit "br i1 #{condition}, label %#{then_label}, label %#{else_label}"

  # `, !dbg !<n>`: where the instruction comes from, if the module has source lines and the
  # function a place in the source.
  debug_location := ->
    lines := @module.source_lines ? return ''
    scope := @scope ? return ''
    position := @location ? return ''
    subprogram := @subprogram ? lines.subprogram(scope, (@declared_at ? position).line)
    @subprogram = subprogram
    ", !dbg #{lines.location(subprogram, position)}"

  fresh_label := (prefix: String) ->
    label := "#{prefix}.#{@label_count}"
    @label_count += 1
    label

  start_block := (label: String) ->
    @body.push "#{label}:"
    @current_block = label

  # A block for the code after a jump or a throw, which never runs but still needs one to go in.
  start_unreachable := -> @start_block(@fresh_label('unreachable'))

  # Adds the function `define <signature>`, holding everything emitted, to the module.
  finish := (signature: String) ->
    lines := ['entry:', @stack_slots..., @body...]
    subprogram := @subprogram ? return @module.define_function(signature, lines)
    # Every instruction of a function that has debug information has a location, as LLVM requires
    # of its calls: those before the first position get the function's own.
    start := @module.source_lines!.start_of(subprogram)
    located := (line: String) ->
      is_instruction := line.starts_with('  ') and '!dbg' not in line
      is_instruction then "#{line}, !dbg #{start}" else line
    # A private function has no symbol, which dsymutil finds the function's debug information by:
    # an internal one does, and is the same otherwise.
    linked := signature.without_prefix('private ')
    kept := linked then "internal #{linked}" else signature
    @module.define_function_in kept, [located(line) for line in lines], subprogram

# Branches to the label `seldom` where the condition holds, and to `otherwise` elsewhere, with the
# branch weights that clang gives `__builtin_expect`, so that LLVM lays out the code, and gives the
# registers, for `otherwise` first. Use it for a branch to a throw or to an unwinding, which a
# program seldom takes.
export emit_seldom_branch := (
  ir: IrBuilder, condition: String, seldom: String, otherwise: String
) ->
  weights := '!prof !{!"branch_weights", i32 1, i32 2000}'
  ir.emit "br i1 #{condition}, label %#{seldom}, label %#{otherwise}, #{weights}"

# Emits `body` to run only where the condition holds.
export emit_when := (ir: IrBuilder, condition: String, body: () -> void): void ->
  run := ->
    body()
    ''
  emit_when_valued ir, condition, run

# As emit_when, with the value that `body` gives and the block where it ends, which a phi takes.
emit_when_valued := (ir: IrBuilder, condition: String, body: () -> String) ->
  then_label := ir.fresh_label('branch.then')
  end_label := ir.fresh_label('branch.end')
  ir.branch_if condition, then_label, end_label
  ir.start_block then_label
  value := body()
  value_block := ir.current_block
  ir.branch end_label
  ir.start_block end_label
  (value, value_block)

# Emits `then_body` to run where the condition holds, and `else_body` elsewhere.
export emit_if_else := (
  ir: IrBuilder, condition: String, then_body: () -> void, else_body: () -> void
) ->
  then_label := ir.fresh_label('branch.then')
  else_label := ir.fresh_label('branch.else')
  end_label := ir.fresh_label('branch.end')
  ir.branch_if condition, then_label, else_label
  ir.start_block then_label
  then_body()
  ir.branch end_label
  ir.start_block else_label
  else_body()
  ir.branch end_label
  ir.start_block end_label

# A value of the IR type: `then_value` where the condition holds, computed only there, and
# `otherwise` elsewhere.
export emit_branch := (
  ir: IrBuilder, type: String, condition: String, then_value: () -> String, otherwise: String
) ->
  from := ir.current_block
  (value, value_block) := emit_when_valued(ir, condition, then_value)
  ir.assign "phi #{type} [ #{otherwise}, %#{from} ], [ #{value}, %#{value_block} ]"

# Runs `body` with each index from 0 up to `count`, as an i64.
export emit_count_up := (ir: IrBuilder, count: String, body: (String) -> void) ->
  counter := ir.alloca('i64')
  ir.store 'i64', '0', counter
  loop := ir.fresh_label('count')
  step := ir.fresh_label('count.step')
  done := ir.fresh_label('count.done')
  ir.branch loop
  ir.start_block loop
  index := ir.load('i64', counter)
  is_done := ir.assign("icmp eq i64 #{index}, #{count}")
  ir.branch_if is_done, done, step
  ir.start_block step
  body index
  ir.store 'i64', ir.assign("add i64 #{index}, 1"), counter
  ir.branch loop
  ir.start_block done

# Runs `body` while `more`, which it emits at the start of each turn, gives true.
export emit_while := (ir: IrBuilder, more: () -> String, body: () -> void) ->
  loop := ir.fresh_label('while')
  step := ir.fresh_label('while.step')
  done := ir.fresh_label('while.done')
  ir.branch loop
  ir.start_block loop
  ir.branch_if more(), step, done
  ir.start_block step
  body()
  ir.branch loop
  ir.start_block done

# An incoming value of a phi, from the block; a branch that gives no operand never comes, as poison.
export phi_incoming := (operand: String, block: String) ->
  "[ #{operand.is_empty() then 'poison' else operand}, %#{block} ]"

# An i1: whether any of the tests, of which there is at least one, holds.
export any_of := (ir: IrBuilder, tests: String[]) ->
  tests[1..].fold(tests[0], (any, test) -> ir.assign("or i1 #{any}, #{test}"))

# An i1: whether all the tests hold, true for none.
export all_of := (ir: IrBuilder, tests: String[]) ->
  tests.fold 'true', (all, test) -> ir.assign("and i1 #{all}, #{test}")
