# The functions that write values of a type through an Encoder (see codegen/codable), which borrow
# the value. A writer that throws is let go of as it is, so a function releases only what it took.
import is_value_type from '../checker/value_layout'
import field_names, part_types from '../checker/object_types'
import ProgramWide from '../checker/shared'
import emit_borrowed_item, emit_length from './array'
import emit_item_slot, emit_take_item, emit_taken from './items'
import emit_member_name from './enum'
import emit_check_with, emit_return_thrown from './exceptions'
import emit_member_value from './boxes'
import emit_borrowed_part, emit_borrowed_value, emit_member_dispatch from './heap_object'
import emit_count_up, emit_if_else, emit_while, IrBuilder, IrModule from './ir_builder'
import call_void_method, Coder, is_inline, map_shape, MAP, name_arg, SCALARS, SET from './codable'
import emit_release, emit_release_value, ir_type from './lerta_ir'
import emit_is_present, emit_unwrap from './optional'
import scalar_of, widened_to_word from './scalar'
import call_runtime, call_void_runtime from './runtime_calls'
import
  ArrayType, EnumType, format_type, kind_of, MapType, ObjectType, OptionalType, RecordType,
  TupleType, Type, type_key, UnionType, void_type
from '../types'

# Writes the value, borrowed; the caller checks for an exception after it.
export emit_encode := (
  ir: IrBuilder, program: ProgramWide, writer_type: ObjectType, writer: String, value: String,
  type: Type
) -> emit_write_call(ir, { program, type: writer_type, operand: writer }, value, type)

emit_write_call := (ir: IrBuilder, writer: Coder, value: String, type: Type) ->
  symbol := write_function(ir.module, writer, type)
  ir.emit "call void #{symbol}(ptr #{writer.operand}, #{ir_type(ir.program, type)} #{value})"

write_function := (module: IrModule, writer: Coder, type: Type) ->
  define := (name: String, defined: IrModule) ->
    ir := IrBuilder(defined)
    own := Coder(writer..., operand: '%writer')
    emit_write_parts ir, own, '%value', type
    ir.emit 'ret void'
    ir.finish "private void #{name}(ptr %writer, #{ir_type(module.program, type)} %value)"
  module.named("encode #{type_key(writer.type)} #{type_key(type)}", '@lerta.encode', define)

# The body of the function of a type: its parts, or the value itself for a type that others write
# inline, which a builtin may write too.
emit_write_parts := (ir: IrBuilder, writer: Coder, value: String, type: Type) ->
  unwind := -> emit_return_thrown(ir, void_type)
  case type
    when ArrayType then emit_write_array(ir, writer, value, type.element, unwind)
    when MapType then emit_write_map(ir, writer, value, type)
    when TupleType then emit_write_tuple(ir, writer, value, type, unwind)
    when RecordType, ObjectType then emit_write_fields(ir, writer, value, type, unwind)
    when UnionType then emit_write_union(ir, writer, value, type, unwind)
    else emit_write(ir, writer, value, type, unwind)

# Writes the value, borrowed; `unwind` releases what the function holds and returns.
emit_write := (ir: IrBuilder, writer: Coder, value: String, type: Type, unwind: () -> void): void ->
  unless is_inline(type)
    emit_write_call ir, writer, value, type
    emit_check_with ir, unwind
    return
  case type
    when OptionalType
      write_inner := -> emit_write(ir, writer, emit_unwrap(ir, value, type), type.inner, unwind)
      write_nil := -> call_void_method(ir, writer, 'write_nil', [], unwind)
      emit_if_else ir, emit_is_present(ir, value, type), write_inner, write_nil
    when EnumType
      name := emit_member_name(ir, value, type)
      args := [name_arg(ir, format_type(type)), "ptr #{name}"]
      call_void_method ir, writer, 'write_member', args, unwind
    else
      if scalar := SCALARS[kind_of(type)]
        call_void_method ir, writer, scalar.write, ["#{ir_type(ir.program, type)} #{value}"], unwind
      else
        word := widened_to_word(ir, value, scalar_of(type)!)
        call_void_method ir, writer, 'write_int', ["i64 #{word}"], unwind

emit_write_array := (
  ir: IrBuilder, writer: Coder, array: String, element: Type, unwind: () -> void
): void ->
  may_cycle := leads_to_value_cycle(ir.program, element, Set())
  if may_cycle
    emit_enter ir, writer, array, unwind
  call_void_method ir, writer, 'begin_array', [], unwind
  write_item := (index: String) ->
    call_void_method ir, writer, 'next_item', [], unwind
    emit_write ir, writer, emit_borrowed_item(ir, array, index, element), element, unwind
  emit_count_up ir, emit_length(ir, array), write_item
  call_void_method ir, writer, 'end_array', [], unwind
  if may_cycle
    call_void_method ir, writer, 'leave', [], unwind

# Enters the object, so that the writer finds a cycle back to it.
emit_enter := (ir: IrBuilder, writer: Coder, object: String, unwind: () -> void) ->
  address := ir.assign("ptrtoint ptr #{object} to i64")
  call_void_method ir, writer, 'enter', ["i64 #{address}"], unwind

# Whether a value of the type, an array's item or a map's key or value, leads to a struct's value
# that may hold itself, through objects of which the array or the map may be the one on its way
# back; as that value has no address, the array or the map is entered instead. An object, an array
# or a map further in is entered itself.
leads_to_value_cycle := (program: ProgramWide, type: Type, visited: Set<String>): Bool ->
  return false if type is ArrayType | MapType
  if type is ObjectType
    return false unless is_value_type(program, type)
    return true if may_hold_itself(program, type)
    return false unless visited.add(type_key(type))
  part_types(program, type, nil).any((part) -> leads_to_value_cycle(program, part, visited))

# The entries in their order, through a cursor of the runtime, which gives each key and value
# owned: a set's items, a map's keys of String with their values, or another map's entries, each of
# a key and a value (see map_shape).
emit_write_map := (ir: IrBuilder, writer: Coder, map: String, type: MapType): void ->
  shape := map_shape(type)
  may_cycle := [type.key, type.value].any((part) -> leads_to_value_cycle(ir.program, part, Set()))
  return_thrown := -> emit_return_thrown(ir, void_type)
  if may_cycle
    emit_enter ir, writer, map, return_thrown
  cursor := call_runtime(ir, 'ptr @lerta_map_cursor(ptr)', "ptr #{map}")
  release_cursor := ->
    emit_release ir, cursor
    emit_return_thrown ir, void_type
  call_void_method ir, writer, "begin_#{shape}", [], release_cursor
  more := -> call_runtime(ir, 'i1 @lerta_map_cursor_has_next(ptr)', "ptr #{cursor}")
  write_entry := ->
    key_slot := ir.alloca('i64')
    value_slot := shape == SET then 'null' else emit_item_slot(ir, type.value)
    args := "ptr #{cursor}, ptr #{key_slot}, ptr #{value_slot}"
    call_void_runtime ir, 'void @lerta_map_cursor_next(ptr, ptr, ptr)', args
    key := emit_taken(ir, ir.load('i64', key_slot), type.key)
    value :=
      if shape == SET
        ''
      else
        emit_take_item ir, value_slot, type.value
    release_entry := ->
      emit_release_value ir, key, type.key
      unless shape == SET
        emit_release_value ir, value, type.value
    unwind := ->
      release_entry()
      release_cursor()
    write_value := -> emit_write(ir, writer, value, type.value, unwind)
    case shape
      when SET
        call_void_method ir, writer, 'next_item', [], unwind
        emit_write ir, writer, key, type.key, unwind
      when MAP
        call_void_method ir, writer, 'write_key', ["ptr #{key}"], unwind
        write_value()
      else
        call_void_method ir, writer, 'next_entry', [], unwind
        emit_write ir, writer, key, type.key, unwind
        call_void_method ir, writer, 'entry_value', [], unwind
        write_value()
        call_void_method ir, writer, 'end_entry', [], unwind
    release_entry()
  emit_while ir, more, write_entry
  emit_release ir, cursor
  call_void_method ir, writer, "end_#{shape}", [], -> emit_return_thrown(ir, void_type)
  if may_cycle
    call_void_method ir, writer, 'leave', [], return_thrown

emit_write_tuple := (
  ir: IrBuilder, writer: Coder, tuple: String, type: TupleType, unwind: () -> void
): void ->
  call_void_method ir, writer, 'begin_tuple', ["i64 #{type.items.length}"], unwind
  for item_type at i in type.items
    call_void_method ir, writer, 'next_item', [], unwind
    emit_write ir, writer, emit_borrowed_value(ir, tuple, type, i), item_type, unwind
  call_void_method ir, writer, 'end_tuple', [], unwind

# The fields of an anonymous struct, a class or a struct. A class or struct that may hold itself is
# entered, so that the writer finds a cycle.
emit_write_fields := (
  ir: IrBuilder, writer: Coder, value: String, type: Type, unwind: () -> void
): void ->
  { program } := writer

  # A struct's value has no address: the array or the map on its way back to itself is entered
  # instead (see leads_to_value_cycle).
  may_cycle :=
    type is ObjectType and not is_value_type(program, type) and may_hold_itself(program, type)
  if may_cycle
    emit_enter ir, writer, value, unwind
  call_void_method ir, writer, 'begin_record', [], unwind
  names := field_names(program, type)
  for part at i in part_types(program, type, nil)
    emit_write_field ir, writer, names[i], unwind
    emit_write ir, writer, emit_borrowed_part(ir, value, type, i), part, unwind
  call_void_method ir, writer, 'end_record', [], unwind
  if may_cycle
    call_void_method ir, writer, 'leave', [], unwind

# The member that the value is, as it is written alone.
emit_write_union := (
  ir: IrBuilder, writer: Coder, union: String, type: UnionType, unwind: () -> void
): void ->
  write_member := (member: Type) ->
    emit_write ir, writer, emit_member_value(ir, union, member), member, unwind
    ''
  emit_member_dispatch ir, union, type.members, 'void', write_member

emit_write_field := (ir: IrBuilder, writer: Coder, name: String, unwind: () -> void) ->
  call_void_method ir, writer, 'write_field', [name_arg(ir, name)], unwind

# Whether a value of the class or struct may hold itself, through its parts and theirs.
may_hold_itself := (program: ProgramWide, type: ObjectType) ->
  reach := Reach(program, target: type_key(type))
  part_types(program, type, nil).any((part) -> reach.reaches(part))

# The parts of types that lead to a value of the target, a class or struct by its key.
class Reach
  args
    program: ProgramWide
    target: String

  # The classes and structs looked through already.
  private
    visited := Set<String>()

    reaches := (part: Type): Bool ->
      if part is ObjectType
        key := type_key(part)
        return true if key == @target
        return false unless @visited.add(key)
      part_types(@program, part, nil).any(@reaches)
