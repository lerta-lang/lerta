# The debug information of a module with `--source-lines`: where the instructions come from in the
# source, as LLVM's line tables have it, for a debugger and the reports of crashes and panics.
import Position from '../ast'
import quoted_name from './lerta_ir'
import Metadata from './metadata'
import is_standard_name, standard_short_name, STD_PREFIX from '../source'

# A function of the program, by its name in traces, in the source file of the path.
export struct SourceScope
  name: String
  path: String

# Its nodes are among the module's metadata.
export class SourceLines
  args
    metadata: Metadata

    # As `-O` builds the program.
    optimized: Bool

  # The compile units, by their text.
  private
    units := Map<String, String>()

    # The places where each subprogram starts, by subprogram.
    starts := Map<String, String>()

    # A standard module, which has no file, is named in the directory `std:`, as Apple's ld
    # records the object of a unit that has no directory, and a name that is no absolute path, as a
    # Swift module, which dsymutil fails to read and leaves out.
    file := (path: String) ->
      standard := is_standard_name(path)
      name := standard then standard_short_name(path) else path
      directory := quoted_name(standard then STD_PREFIX else '')
      @metadata.node("!DIFile(filename: #{quoted_name(name)}, directory: #{directory})")

    unit := (path: String) ->
      file := @file(path)
      options := "emissionKind: LineTablesOnly, isOptimized: #{@optimized}, runtimeVersion: 0"
      text := "!DICompileUnit(language: DW_LANG_C, file: #{file}, producer: \"lerta\", #{options})"
      @units.get_or_add(text, -> @metadata.distinct(text))

  # The function's node, starting at the line.
  subprogram := (scope: SourceScope, line: Int) ->
    file := @file(scope.path)
    type := @metadata.node('!DISubroutineType(types: !{})')
    unit := @unit(scope.path)
    fields :=
      "name: #{quoted_name(scope.name)}"
      "scope: #{file}"
      "file: #{file}"
      "line: #{line}"
      "scopeLine: #{line}"
      "type: #{type}"
      'spFlags: DISPFlagDefinition'
      "unit: #{unit}"
    text := "!DISubprogram(#{fields.join(', ')})"
    subprogram := @metadata.distinct(text)
    @starts[subprogram] =
      @metadata.node("!DILocation(line: #{line}, column: 1, scope: #{subprogram})")
    subprogram

  location := (subprogram: String, position: Position) ->
    { line, column } := position
    @metadata.node("!DILocation(line: #{line}, column: #{column}, scope: #{subprogram})")

  start_of := (subprogram: String) -> @starts[subprogram]!

  # The lines that end the module after its nodes, which name its compile units.
  named_metadata := ->
    version := @metadata.node('!{i32 2, !"Debug Info Version", i32 3}')
    dwarf := @metadata.node('!{i32 7, !"Dwarf Version", i32 4}')
    [
      "!llvm.dbg.cu = !{#{@units.values().join(', ')}}"
      "!llvm.module.flags = !{#{version}, #{dwarf}}"
    ]
