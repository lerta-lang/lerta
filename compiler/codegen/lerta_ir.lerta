# How Lerta values are represented in LLVM IR.
import { ExtensionMethod } from '../checker/extensions'
import { generic_of, Instance } from '../checker/generics'
import { ObjectInfo } from '../checker/object_types'
import { ProgramWide } from '../checker/shared'
import { hex } from '../hex'
import { IrBuilder } from './ir_builder'
import { call_void_runtime } from './runtime_calls'
import {
  inner_of, is_kind, is_one_of_kinds, is_reference_type, kind_of, ObjectType, OptionalType, Type
  type_key
} from '../types'

export const LERTA_IMMORTAL = '-9223372036854775808'

export const INTERFACE_IR_TYPE = '{ ptr, ptr }'

# Whether nil of the optional type is a null pointer: that of a reference, or the data of an
# interface value.
export const is_nil_by_null = (type: Type) ->
  is_reference_type(type) or is_kind(inner_of(type), INTERFACE)

export const ir_type = (type: Type): String ->
  # A reference is nil when null, and so is an interface value when its data is; a value carries a
  # flag that tells whether it is there.
  if type is OptionalType
    return ir_type(type.inner) if is_nil_by_null(type)
    return "{ i1, #{ir_type(type.inner)} }"
  case kind_of(type)
    when 'Int', ENUM then 'i64'
    when 'Bool' then 'i1'
    when 'Byte' then 'i8'
    when 'String', 'Binary', ARRAY, ITER, PROMISE, MAP, OBJECT, UNION, RECORD, TUPLE then 'ptr'
    when FUNCTION then 'ptr'
    # The data, a reference, and the itab (see interface).
    when INTERFACE then INTERFACE_IR_TYPE
    else panic("no IR type for #{kind_of(type)}")

# A function that never returns is declared as returning nothing.
export const ir_return_type = (type: Type) ->
  returns_nothing(type) then 'void' else ir_type(type)

export const returns_nothing = (result: Type) -> is_one_of_kinds(result, ['void', 'never'])

# C `bool` and `uint8_t` values are zero-extended, as parameters and as results.
const is_zero_extended = (type: Type) -> is_one_of_kinds(type, ['Bool', 'Byte'])

# A C function's `bool` and `uint8_t` results come zero-extended, as its parameters go.
export const ir_c_return_type = (type: Type) ->
  is_zero_extended(type) then "zeroext #{ir_type(type)}" else ir_return_type(type)

# C `bool` and `uint8_t` parameters expect their arguments zero-extended.
export const ir_param_type = (type: Type) ->
  is_zero_extended(type) then "#{ir_type(type)} zeroext" else ir_type(type)

# Symbols of generated functions; the prefixes keep them apart from the runtime's C symbols.
# A function is named by its module too, since two modules may declare the same name.
export const function_symbol = (module_index: Int, name: String) ->
  "@lerta.fn.#{module_index}.#{name}"

# An instance of a generic function or method is named as the function or method, by its type
# arguments too, and by its variant if there are several (see Instance).
export const instance_symbol = (program: ProgramWide, instance: Instance) ->
  const generic = generic_of(program, instance.generic)
  const module_index = generic.module_index
  const receiver = generic.receiver
  const prefix =
    if receiver
      "lerta.extend.#{module_index}.#{type_key(receiver.type)}"
    else
      "lerta.fn.#{module_index}"
  const type_arguments = [type_key(type) for type in instance.type_arguments].join(', ')
  const symbol = "#{prefix}.#{generic.name.name}<#{type_arguments}>"
  quoted instance.variant == 0 then symbol else "#{symbol}.#{instance.variant}"

# The entry of the function of the symbol that a call giving only its first `given` arguments
# calls (see generate_default_entry).
export const default_entry_symbol = (symbol: String, given: Int) ->
  suffixed_symbol symbol, "given#{given}"

# The symbol of something that belongs to that of a function, as its name and `.suffix`.
export const suffixed_symbol = (symbol: String, suffix: String) ->
  const name = without_sigil(symbol)
  const quoted_name = name.without_prefix('"')
  const unquoted = quoted_name then quoted_name.without_suffix('"')! else name
  quoted "#{unquoted}.#{suffix}"

# Names with characters such as `<` are quoted.
const quoted = (name: String) -> "@\"#{name}\""

# The global that holds a top-level value, and its flag (see top_level).
export const top_level_symbol = (module_index: Int, name: String) ->
  "@lerta.value.#{module_index}.#{name}"

export const module_init_symbol = (module_index: Int) -> "@lerta.module.#{module_index}"

# A class or struct is named by its symbol (see ObjectType), which tells apart those of different
# modules.
export const method_symbol = (type: ObjectType, method: String) ->
  "@lerta.method.#{type.symbol}.#{method}"

# A method of an extend is named by its module, which may extend a type that another module
# extends too, and by its receiver (see type_key).
export const extension_symbol = (method: ExtensionMethod) ->
  const receiver = type_key(method.receiver)
  quoted "lerta.extend.#{method.module_index}.#{receiver}.#{method.name.name}"

# The init or deinit of a class or struct: the instance of its generic one's, for an instance of a
# generic one.
export const special_method_symbol = (program: ProgramWide, info: ObjectInfo, name: String) ->
  const instance = name == 'init' then info.init else info.deinit
  instance then instance_symbol(program, instance) else method_symbol(info.type, name)

# An instance of a generic class or struct is named by its type arguments too (see type_key).
export const constructor_symbol = (type: ObjectType) -> quoted("lerta.new.#{type_key(type)}")

export const drop_symbol = (type: ObjectType) -> quoted("lerta.drop.#{type_key(type)}")

# The LLVM struct type of a class or struct: the object header, then the fields in order.
export const object_ir_type = (type: ObjectType) -> "%\"lerta.object.#{type_key(type)}\""

# The name without its first character, the sigil `@` or `%`, to build other names from it.
export const without_sigil = (name: String) ->
  const bytes = name.binary
  bytes.text(1)!

# Bytes other than printable ASCII, '"' and '\' are written as \XX in IR strings.
const ir_string_bytes = (bytes: Binary) ->
  const written: Array<Byte> = []
  for b in bytes
    if b >= 0x20 and b <= 0x7e and b != '"' and b != '\'
      written.push b
      continue
    written.push '\'
    written.push digit for digit in hex(b.to_int(), 2).binary
  written.to_binary().text()!

# An immortal LertaString (see runtime/lerta.h) holding the literal's bytes.
export const string_constant = (ir: IrBuilder, value: String) ->
  const bytes = value.binary
  const bytes_type = "[#{bytes.length} x i8]"
  # The header (reference count and drop function), the length and the bytes.
  const type = "{ i64, ptr, i64, #{bytes_type} }"
  const bytes_init = "#{bytes_type} c\"#{ir_string_bytes(bytes)}\""
  const init = "{ i64 #{LERTA_IMMORTAL}, ptr null, i64 #{bytes.length}, #{bytes_init} }"
  ir.module.global 'lerta.string', "private unnamed_addr constant #{type} #{init}"

# How a value holds what it owns: nothing, a reference, the data of an interface value, or, in a
# generator's Iter alone (see yielding), the coroutine of the function that yields, which is
# destroyed rather than released.
export enum Ownership
  NONE
  REFERENCE
  INTERFACE
  COROUTINE

export const ownership = (type: Type) ->
  case
    when is_reference_type(type) then Ownership.REFERENCE
    when is_kind(inner_of(type), INTERFACE) then Ownership.INTERFACE
    else Ownership.NONE

# Reference counting of a value of the type: of the references it holds, if any.
export const emit_retain_value = (ir: IrBuilder, operand: String, type: Type) ->
  emit_retain_as ir, operand, ownership(type)

export const emit_release_value = (ir: IrBuilder, operand: String, type: Type) ->
  emit_release_as ir, operand, ownership(type)

const emit_retain_as = (ir: IrBuilder, operand: String, owned: Ownership) ->
  emit_retain ir, reference if const reference = reference_of(ir, operand, owned)

export const emit_release_as = (ir: IrBuilder, operand: String, owned: Ownership) ->
  if owned == COROUTINE
    ir.module.declare 'llvm.coro.destroy', 'declare void @llvm.coro.destroy(ptr)'
    ir.emit "call void @llvm.coro.destroy(ptr #{operand})"
    return
  emit_release ir, reference if const reference = reference_of(ir, operand, owned)

const reference_of = (ir: IrBuilder, operand: String, owned: Ownership) ->
  case owned
    when NONE then nil
    when REFERENCE then operand
    when INTERFACE then emit_interface_data(ir, operand)
    when COROUTINE then panic('a coroutine is not reference counted')

# The data of an interface value, null for nil.
export const emit_interface_data = (ir: IrBuilder, value: String) ->
  ir.assign "extractvalue #{INTERFACE_IR_TYPE} #{value}, 0"

# Releases what the value of the IR type at the pointer holds.
export const emit_release_stored = (
  ir: IrBuilder, pointer: String, value_type: String, owned: Ownership
) ->
  return if owned == NONE
  emit_release_as ir, ir.assign("load #{value_type}, ptr #{pointer}"), owned

# Reference counting of an object operand (see runtime/memory.c).
export const emit_retain = (ir: IrBuilder, operand: String) ->
  call_void_runtime ir, 'void @lerta_retain(ptr)', "ptr #{operand}"

export const emit_release = (ir: IrBuilder, operand: String) ->
  call_void_runtime ir, 'void @lerta_release(ptr)', "ptr #{operand}"
