# How Lerta values are represented in LLVM IR.
import Constant from '../checker/constants'
import ExtensionMethod from '../checker/extensions'
import generic_of, Instance from '../checker/generics'
import ObjectInfo from '../checker/object_types'
import module_symbol_name, ProgramWide from '../checker/shared'
import is_value_type, value_layout, ValueLayout from '../checker/value_layout'
import emit_when, IrBuilder, IrModule from './ir_builder'
import call_void_runtime from './runtime_calls'
import scalar_of from './scalar'
import
  is_kind, is_one_of_kinds, is_reference_type, kind_of, ObjectType, OptionalType, RecordType,
  TupleType, Type, type_key
from '../types'

export LERTA_IMMORTAL := '-9223372036854775808'

export INTERFACE_IR_TYPE := '{ ptr, ptr }'

# Whether nil of the optional type is a null pointer: that of a reference, the data of an interface
# value, or that at the nil_path of a value (see value_layout).
export is_nil_by_null := (program: ProgramWide, type: Type) ->
  inner := without_nil(type)
  is_reference(program, type) or
    is_kind(inner, INTERFACE) or
    value_layout_of(program, inner)?.nil_path != nil

# Whether a value of the type, optional or not, is a reference to an object: not of a type whose
# values are values (see value_layout_of).
export is_reference := (program: ProgramWide, type: Type) ->
  is_reference_type(type) and value_layout_of(program, without_nil(type)) == nil

# The layout of the values of an anonymous struct or a tuple that is a value rather than a heap
# object (see checker value_layout); nil for another type.
export value_layout_of := (program: ProgramWide, type: Type): ValueLayout? ->
  is_value_type(program, type) then value_layout(program, type)

# The type without nil, however many times it is optional (see OptionalType).
export without_nil := (type: Type): Type ->
  type is OptionalType then without_nil(type.inner) else type

# The program decides how some types are laid out, as which small types are values (see
# checker value_layout).
export ir_type := (program: ProgramWide, type: Type): String ->
  return find_ir_type(program, type) unless may_be_value(type)
  program.ir_types.get_or_add(type, -> find_ir_type(program, type))

# Whether a value of the type, or of the type without nil, may be a value rather than a reference,
# whose IR type depends on its layout.
may_be_value := (type: Type) ->
  inner := without_nil(type)
  case inner
    when ObjectType then inner.is_struct
    when RecordType, TupleType then true
    else false

find_ir_type := (program: ProgramWide, type: Type): String ->
  # A reference is nil when null, and so is an interface value when its data is, and a value whose
  # nil_path is; another carries a flag that tells whether it is there.
  if type is OptionalType
    return ir_type(program, type.inner) if is_nil_by_null(program, type)
    return "{ i1, #{ir_type(program, type.inner)} }"
  if layout := value_layout_of(program, type)
    return "{ #{[ir_type(program, field.type) for field in layout.fields].join(', ')} }"
  return scalar.ir_type if scalar := scalar_of(type)
  case kind_of(type)
    when 'String', 'Binary', ARRAY, ITER, PROMISE, MAP, OBJECT, UNION, RECORD, TUPLE, FUNCTION
      'ptr'
    # The data, a reference, and the itab (see interface).
    when INTERFACE then INTERFACE_IR_TYPE
    else panic("no IR type for #{kind_of(type)}")

export ir_return_type := (program: ProgramWide, type: Type) ->
  returns_nothing(type) then 'void' else ir_type(program, type)

# The parameters of a function of the types, typed, `%p<i>` each.
export typed_params := (program: ProgramWide, types: Type[]) ->
  ["#{ir_type(program, type)} %p#{i}" for type at i in types]

export returns_nothing := (result: Type) -> is_one_of_kinds(result, ['void', 'never'])

# C values narrower than 32 bits, `bool`, `int8_t`, `uint16_t` and so on, are extended to them, as
# parameters and as results, by their sign; clang marks them so.
extension := (type: Type) ->
  scalar := scalar_of(type) else return ''
  return '' if scalar.is_float or scalar.bits > 16
  scalar.signed then 'signext' else 'zeroext'

export ir_c_return_type := (program: ProgramWide, type: Type) ->
  attribute := extension(type)
  return ir_return_type(program, type) if attribute.is_empty()
  "#{attribute} #{ir_type(program, type)}"

export ir_param_type := (program: ProgramWide, type: Type) ->
  attribute := extension(type)
  attribute.is_empty() then ir_type(program, type) else "#{ir_type(program, type)} #{attribute}"

# Symbols of generated functions; the prefixes keep them apart from the runtime's C symbols.
export function_symbol := (module: String, name: String) -> quoted("lerta.fn.#{module}.#{name}")

export instance_symbol := (program: ProgramWide, instance: Instance) ->
  generic := generic_of(program, instance.generic)
  module := module_symbol_name(program, generic.module_index)
  receiver := generic.receiver
  prefix :=
    receiver then "lerta.extend.#{module}.#{type_key(receiver.type)}" else "lerta.fn.#{module}"
  type_arguments := [type_key(type) for type in instance.type_arguments].join(', ')
  symbol := "#{prefix}.#{generic.name.name}<#{type_arguments}>"
  quoted(instance.variant == 0 then symbol else "#{symbol}.#{instance.variant}")

# The entry of the function of the symbol that a call giving only its first `given` arguments
# calls (see generate_default_entry).
export default_entry_symbol := (symbol: String, given: Int) ->
  suffixed_symbol(symbol, "given#{given}")

# The symbol of something that belongs to that of a function, as its name and `.suffix`. The name
# is escaped already, and so needs no escaping, as the constant suffixes and prefixes do not.
export suffixed_symbol := (symbol: String, suffix: String) ->
  "@\"#{written_name(symbol)}.#{suffix}\""

# The symbol of something made for that of a function, as `prefix.` and its name.
export prefixed_symbol := (prefix: String, symbol: String) ->
  "@\"#{prefix}.#{written_name(symbol)}\""

# The name of a global or a type as it is written, without its sigil and quotes, to build other
# names from.
written_name := (symbol: String) ->
  name := without_sigil(symbol)
  opened := name.without_prefix('"')
  opened then opened.without_suffix('"')! else name

quoted := (name: String) -> "@#{quoted_name(name)}"

export quoted_name := (name: String) -> "\"#{ir_string_bytes(name.binary)}\""

# The global that holds a top-level value, and its flag (see top_level).
export top_level_symbol := (module: String, name: String) -> quoted("lerta.value.#{module}.#{name}")

export module_init_symbol := (module: String) -> quoted("lerta.module.#{module}")

# A class or struct is named by its symbol (see ObjectType), which tells apart those of different
# modules.
export method_symbol := (type: ObjectType, method: String) ->
  quoted("lerta.method.#{type.symbol}.#{method}")

# A method of an extend is named by its module, which may extend a type that another module
# extends too, and by its receiver (see type_key).
export extension_symbol := (program: ProgramWide, method: ExtensionMethod) ->
  module := module_symbol_name(program, method.module_index)
  receiver := type_key(method.receiver)
  quoted("lerta.extend.#{module}.#{receiver}.#{method.name.name}")

# The init or deinit of a class or struct: the instance of its generic one's, for an instance of a
# generic one.
export special_method_symbol := (program: ProgramWide, info: ObjectInfo, name: String) ->
  instance := name == 'init' then info.init else info.deinit
  if instance
    instance_symbol(program, instance)
  else
    method_symbol(info.type, name)

# An instance of a generic class or struct is named by its type arguments too (see type_key).
export constructor_symbol := (type: ObjectType) -> quoted("lerta.new.#{type_key(type)}")

export type_symbol := (type: ObjectType) -> quoted("lerta.type.#{type_key(type)}")

# The LLVM struct type of a class or struct (see define_object).
export object_ir_type := (type: ObjectType) -> "%#{quoted_name("lerta.object.#{type_key(type)}")}"

# The name without its sigil, `@` or `%`, to build other names from it.
without_sigil := (name: String) -> name.without_prefix('@') else name.without_prefix('%')!

# Bytes other than printable ASCII, '"' and '\' are written as \XX in IR strings.
ir_string_bytes := (bytes: Binary) ->
  var written = ''
  for b in bytes
    is_plain := b in 0x20..=0x7e and b not in [b'"', b'\']
    written += is_plain then b.to_char().to_string() else "\\#{b.to_hex(2).to_upper()}"
  written

# An immortal LertaString (see runtime/lerta.h) holding the literal's bytes.
export string_constant := (ir: IrBuilder, value: String) -> binary_constant(ir, value.binary)

# As string_constant, of a Binary, which a LertaString holds too.
export binary_constant := (ir: IrBuilder, bytes: Binary) ->
  ir.module.global('lerta.string', string_definition(bytes))

# The operand of the value of a constant expression (see checker/constants).
export constant_operand := (ir: IrBuilder, constant: Constant) ->
  constant is String then string_constant(ir, constant) else "#{constant}"

# As string_constant, one per module for each value: for the names that the module's traces repeat
# at every call.
export shared_string_constant := (ir: IrBuilder, value: String) ->
  define := (symbol: String, module: IrModule) ->
    module.define_global symbol, string_definition(value.binary)
  ir.module.named("string #{value}", '@lerta.name', define)

# As binary_constant, of the const whose slot is `slot`: each IR module that reads it defines it
# alike, by a symbol of the slot's, which the linker keeps one of, as an embedded file may be large.
export shared_binary_constant := (ir: IrBuilder, slot: String, bytes: Binary) ->
  symbol := suffixed_symbol(slot, 'bytes')
  ir.module.define_once "bytes #{slot}", (module) ->
    module.define_global symbol, string_definition(bytes, 'linkonce_odr constant')
  symbol

# The LLVM type of a LertaString (see runtime/lerta.h) whose bytes have the IR type: the header
# (reference count and type, none), the length and the bytes.
export string_layout := (bytes_type: String) -> "{ i64, ptr, i64, #{bytes_type} }"

string_definition := (bytes: Binary, linkage = 'private unnamed_addr constant') ->
  bytes_type := "[#{bytes.length} x i8]"
  type := string_layout(bytes_type)
  bytes_init := "#{bytes_type} c\"#{ir_string_bytes(bytes)}\""
  init := "{ i64 #{LERTA_IMMORTAL}, ptr null, i64 #{bytes.length}, #{bytes_init} }"
  "#{linkage} #{type} #{init}"

# How a value holds what it owns: nothing, a reference, the data of an interface value; in a
# generator's Iter alone (see yielding), the coroutine of the function that yields, which is
# destroyed rather than released; or, while a finally block runs, the saved trace of the exception
# set aside (see generate_try), which is freed.
export enum Ownership
  NONE
  REFERENCE
  INTERFACE
  VALUE
  COROUTINE
  TRACE

export ownership := (program: ProgramWide, type: Type): Ownership ->
  inner := without_nil(type)
  return INTERFACE if is_kind(inner, INTERFACE)
  layout := value_layout_of(program, inner)
  return layout.holds_references then VALUE else NONE if layout
  return REFERENCE if is_reference_type(type)
  parts := value_parts(type, layout) else return NONE
  if parts.any((part) -> ownership(program, part) != NONE)
    VALUE
  else
    NONE

# The parts of a value that is neither a reference nor an interface value, of the layout of the type
# without nil: the value that an optional one, which so has a flag, holds, or the fields of an
# anonymous struct or a tuple that is a value, as laid out; nil for another type.
value_parts := (type: Type, layout: ValueLayout?): Type[]? ->
  return [type.inner] if type is OptionalType
  fields := layout?.fields else return nil
  [field.type for field in fields]

# Reference counting of a value of the type: of the references it holds, if any.
export emit_retain_value := (ir: IrBuilder, operand: String, type: Type) ->
  emit_each_reference ir, operand, type, (reference) -> emit_retain(ir, reference)

export emit_release_value := (ir: IrBuilder, operand: String, type: Type) ->
  emit_each_reference ir, operand, type, (reference) -> emit_release(ir, reference)

# Calls `each` with each counted reference that the value of the type holds, which may be null; one
# that an optional value with a flag holds only where it is present, as its value is unspecified
# where it is nil.
export emit_each_reference := (
  ir: IrBuilder, operand: String, type: Type, each: (String) -> void
): void ->
  program := ir.program
  owned := ownership(program, type)
  return if owned == NONE
  unless owned == VALUE
    each reference_of(ir, operand, owned)!
    return
  value_type := ir_type(program, type)
  part := (place: Int) -> ir.assign("extractvalue #{value_type} #{operand}, #{place}")
  if type is OptionalType
    # Nil by null holds null references, which need no release, as an optional reference does.
    if is_nil_by_null(program, type)
      emit_each_reference ir, operand, type.inner, each
    else
      emit_when ir, part(0), -> emit_each_reference(ir, part(1), type.inner, each)
    return
  for part_type at place in value_parts(type, value_layout_of(program, type))!
    continue if ownership(program, part_type) == NONE
    emit_each_reference ir, part(place), part_type, each

# The paths, of indexes into the value's IR type, of the counted references that a value of the
# type holds, as emit_each_reference visits them; of a value that is nil by null, or none, only.
export reference_paths := (program: ProgramWide, type: Type): Int[][] ->
  case ownership(program, type)
    when REFERENCE then [[]]
    when INTERFACE then [[0]]
    when VALUE
      inner := without_nil(type)
      [
        for part_type at place in value_parts(inner, value_layout_of(program, inner))!
          for path in reference_paths(program, part_type)
            [place, path...]
      ]
    else []

# Releases what the value holds, but a value's, which emit_release_value releases, as it needs its
# type.
export emit_release_as := (ir: IrBuilder, operand: String, owned: Ownership) ->
  case owned
    when COROUTINE then call_void_runtime(ir, 'void @llvm.coro.destroy(ptr)', "ptr #{operand}")
    when TRACE then call_void_runtime(ir, 'void @lerta_trace_free(ptr)', "ptr #{operand}")
    when VALUE then panic('a value is released by its type')
    else emit_release(ir, reference) if reference := reference_of(ir, operand, owned)

# Whether the value holds references that are counted, as a COROUTINE or a TRACE does not.
export is_counted := (owned: Ownership) -> owned in [REFERENCE, INTERFACE, VALUE]

# The reference that the value of the IR type at the pointer holds, which may be null; the value is
# counted.
export emit_load_reference := (
  ir: IrBuilder, pointer: String, value_type: String, owned: Ownership
) -> reference_of(ir, ir.load(value_type, pointer), owned)!

reference_of := (ir: IrBuilder, operand: String, owned: Ownership) ->
  case owned
    when NONE then nil
    when REFERENCE then operand
    when INTERFACE then emit_interface_data(ir, operand)
    when VALUE then panic('a value holds its references in its parts')
    when COROUTINE then panic('a coroutine is not reference counted')
    when TRACE then panic('a trace is not reference counted')

# The data of an interface value, null for nil.
export emit_interface_data := (ir: IrBuilder, value: String) ->
  ir.assign("extractvalue #{INTERFACE_IR_TYPE} #{value}, 0")

# Releases what the value of the type at the pointer holds.
export emit_release_stored := (ir: IrBuilder, pointer: String, type: Type) ->
  return if ownership(ir.program, type) == NONE
  emit_release_value ir, ir.load(ir_type(ir.program, type), pointer), type

# Reference counting of an object operand (see runtime/memory.c).
export emit_retain := (ir: IrBuilder, operand: String) ->
  call_void_runtime ir, 'void @lerta_retain(ptr)', "ptr #{operand}"

export emit_release := (ir: IrBuilder, operand: String) ->
  call_void_runtime ir, 'void @lerta_release(ptr)', "ptr #{operand}"
