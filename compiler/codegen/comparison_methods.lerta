# The calls of a class's or struct's own equals, compare and hash, by which `==`, `<` and the like
# and map keys compare its values (see checker/equality); a compare gives an Ordering as the place
# of its member.
import own_equality from '../checker/equality'
import info_of from '../checker/object_types'
import ProgramWide from '../checker/shared'
import IrBuilder from './ir_builder'
import instance_symbol, ir_type, method_symbol from './lerta_ir'
import call_void_runtime from './runtime_calls'
import ORDERING from './scalar'
import ObjectType, Type from '../types'

# An i1, by the class's or struct's own equals, or by its compare giving EQUAL.
export emit_own_equals := (
  ir: IrBuilder, program: ProgramWide, left: String, right: String, type: Type
) ->
  if own_equality(program, type) == 'equals'
    return emit_own_call(ir, program, 'i1', type, 'equals', [left, right])
  ir.assign("icmp eq #{ORDERING} #{emit_own_compare(ir, program, left, right, type)}, #{EQUAL}")

# The Ordering of the two values, as an ORDERING, by the class's or struct's own compare.
export emit_own_compare := (
  ir: IrBuilder, program: ProgramWide, left: String, right: String, type: Type
) -> emit_own_call(ir, program, ORDERING, type, 'compare', [left, right])

# The i64 hash of the value by the class's or struct's own hash.
export emit_own_hash := (ir: IrBuilder, program: ProgramWide, value: String, type: Type) ->
  emit_own_call(ir, program, 'i64', type, 'hash', [value])

# Calls the method with the operands, values of the type, which cannot throw (see
# lerta_check_comparison).
emit_own_call := (
  ir: IrBuilder, program: ProgramWide, result: String, type: Type, name: String, operands: String[]
) ->
  args := ["#{ir_type(program, type)} #{operand}" for operand in operands].join(', ')
  value := ir.assign("call #{result} #{own_method_symbol(program, type, name)}(#{args})")
  call_void_runtime ir, 'void @lerta_check_comparison()', ''
  value

# The method of a class, or of an instance of a generic class, whose method is an instance of a
# generic one (see check_equality_methods).
own_method_symbol := (program: ProgramWide, type: Type, name: String) ->
  assert type is ObjectType
  instance := info_of(program, type).comparison_instances[name]
  if instance
    instance_symbol(program, instance)
  else
    method_symbol(type, name)

# The places of the members of Ordering, LESS, EQUAL and GREATER, as compare gives them.
export LESS := 0
export EQUAL := 1
export GREATER := 2
