# The boxes in which a union holds a value of a type other than a class or a struct, as an Int or a
# Binary (see is_boxed): a heap object of the value, whose type in its header tells the value's, as
# a class's does, so that a union value stays one pointer, null for nil.
import
  define_heap_object, emit_heap_allocate, emit_heap_field_pointer, value_field
from './heap_object'
import IrBuilder, IrModule from './ir_builder'
import ir_type, LERTA_IMMORTAL, quoted_name from './lerta_ir'
import is_boxed_member from '../checker/value_layout'
import format_type, is_kind, type_key, Type from '../types'

# The type of the boxes of the type, the same in every module, since a box may be made in one and
# tested in another: each defines it, and the linker keeps one.
box_type := (type: Type) -> "@#{quoted_name("lerta.box.#{type_key(type)}")}"

# The LLVM struct type of the boxes of the type, defined with the type of the boxes at the first
# use.
box_layout := (ir: IrBuilder, type: Type) ->
  define := (layout: String, module: IrModule) ->
    name := "box of #{format_type(type)}"
    define_heap_object
      module
      layout
      box_type(type)
      'linkonce_odr '
      [value_field(module.program, type)]
      name
  ir.module.named("box #{type_key(type)}", '%lerta.box', define)

# A box that takes over the value, owned: of a member of a union, or of a value (see
# value_layout_of), optional or not, as the data of an interface value or an item, which a word
# cannot hold. A Bool's is one of two immortal boxes, which every module shares, so that boxing one
# allocates nothing.
export emit_box := (ir: IrBuilder, value: String, type: Type) ->
  layout := box_layout(ir, type)
  if is_kind(type, 'Bool')
    return emit_bool_box(ir, value, layout, box_type(type))
  box := emit_heap_allocate(ir, layout, box_type(type))
  ir.store ir_type(ir.program, type), value, emit_heap_field_pointer(ir, layout, box, 0)
  box

# A box of the value, borrowed, in the function's stack frame, immortal, as a key that the runtime
# hashes and compares but does not keep takes it, so that looking it up allocates nothing.
export emit_stack_box := (ir: IrBuilder, value: String, type: Type) ->
  layout := box_layout(ir, type)
  box := ir.alloca(layout)
  header := (index: Int) -> ir.assign("getelementptr #{layout}, ptr #{box}, i32 0, i32 #{index}")
  ir.store 'i64', LERTA_IMMORTAL, header(0)
  ir.store 'ptr', box_type(type), header(1)
  ir.store ir_type(ir.program, type), value, emit_heap_field_pointer(ir, layout, box, 0)
  box

emit_bool_box := (ir: IrBuilder, value: String, layout: String, type: String) ->
  box := (bool: String) -> "@lerta.box.Bool.#{bool}"
  ir.module.define_once 'bool boxes', (module) ->
    for bool in ['true', 'false']
      initial := "{ i64 #{LERTA_IMMORTAL}, ptr #{type}, i1 #{bool} }"
      module.define_global box(bool), "linkonce_odr global #{layout} #{initial}"
  ir.assign("select i1 #{value}, ptr #{box('true')}, ptr #{box('false')}")

# The value of the box, borrowed as the box is.
export emit_unbox := (ir: IrBuilder, box: String, type: Type) ->
  pointer := emit_heap_field_pointer(ir, box_layout(ir, type), box, 0)
  ir.load(ir_type(ir.program, type), pointer)

# An i1: whether the object of the type `object_type` is a box of the type.
export emit_box_test := (ir: IrBuilder, object_type: String, type: Type) ->
  box_layout ir, type
  ir.assign("icmp eq ptr #{object_type}, #{box_type(type)}")

# The value of the member that the union's object is, borrowed: the object itself, or the value of
# its box.
export emit_member_value := (ir: IrBuilder, object: String, member: Type) ->
  if is_boxed_member(ir.program, member)
    emit_unbox(ir, object, member)
  else
    object
