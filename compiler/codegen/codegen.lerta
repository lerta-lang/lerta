# Generates the program: the modules' top-level code, and every function of theirs (see
# function).
import Declaration, FunctionLiteral, Statement, TypeDeclaration from '../ast'
import is_generic_object from '../checker/object_types'
import module_symbol_name, ProgramWide, Shared from '../checker/shared'
import generate_constructor, generate_function, generate_main, TopLevelCode from './function'
import
  function_generator, Generator, ModuleCode, TOP_LEVEL_NAME, TopLevelGlobal, trace_name
from './generator'
import define_object from './heap_object'
import IrModule from './ir_builder'
import define_on_demand, link_modules from './ir_linking'
import instances_on_demand from './instances'
import
  extension_symbol, function_symbol, method_symbol, module_init_symbol, quoted_name
from './lerta_ir'
import Module from '../loader'
import define_raise_error, emit_register_raise from './runtime_errors'
import define_top_level_globals from './top_level'
import SourceLines from './source_lines'
import format_type, Type from '../types'

# How generate emits the IR: each module as an LLVM module of its own, if `separate`, or else all
# as one; with the exceptions traced, if `traces`; with the instructions telling where they come
# from in the source, if `source_lines`, of a build that is `optimized` or not (see SourceLines);
# and with each float operation checking its own result for NaN where it is, if `eager_nan_checks`
# (see docs/internals/representation.md#floats); for the `system`, which the intrinsic value
# `platform` gives, or, where nil, for no target, as dump-llvm's IR and so the seed are, whose code
# reads the system where it runs.
export struct GenerateOptions
  separate := false
  traces := false
  source_lines := false
  optimized := false
  eager_nan_checks := false
  system: String?

# Emits LLVM IR for the checked program (see check_modules and
# docs/internals/architecture.md#per-module-output). Every function has `function_attributes`, if
# any, and llvm.coro.end has the type `coro_end_type` (see IrModule).
export generate := (
  program: ProgramWide, function_attributes: String, coro_end_type: String, options: GenerateOptions
) ->
  { separate, traces, source_lines, optimized, eager_nan_checks, system } := options
  modules := program.modules
  ir_module_of := (module: Module) ->
    source_filename := quoted_name(module.symbol_name)
    ir_module := IrModule(source_filename, function_attributes, coro_end_type)
    metadata := ir_module.metadata
    ir_module.source_lines = SourceLines(metadata, optimized) if source_lines
    ir_module
  # The entry module comes last (see load_modules).
  entry := modules.last()!
  one := ir_module_of(entry)
  ir_modules := [separate then ir_module_of(module) else one for module in modules]
  globals :=
    [define_top_level_globals(ir_modules[i], module, program.shared[i]) for module at i in modules]
  module_code := (i: Int, ir_module: IrModule) ->
    shared := program.shared[i]
    ModuleCode(
      program
      globals
      ir_module
      shared
      traces
      eager_nan_checks
      optimized
      system
      module: modules[i]
    )
  generate_module module_code(i, ir_modules[i]) for _ at i in modules
  linked := separate then ir_modules else [one]
  on_demand := instances_on_demand(program, module_code)
  define_on_demand ir_module, on_demand for ir_module in linked
  link_modules(linked)

# The module's top-level code, functions, instances of generic functions, classes and structs,
# and methods of extends.
generate_module := (code: ModuleCode) ->
  { program, module, shared } := code
  { extensions, facts } := shared
  generate_one := (symbol: String, name: String, literal: FunctionLiteral, this_type: Type?) ->
    g := function_generator(code, extensions, facts, trace_name(name, this_type))
    generate_function g, '', symbol, literal, this_type, nil
  main := Generator(code, extensions, facts, function_name: TOP_LEVEL_NAME, top_level_code: true)
  main_code := [statement for statement in module.program when is_main_code(statement)]
  entry_index := program.modules.length - 1
  top_level_code := (index: Int) ->
    symbol := module_init_symbol(module_symbol_name(program, index))
    TopLevelCode(symbol, awaits: program.shared[index].top_level_awaits)
  if module.index == entry_index
    emit_register_raise main if program.builtins != nil
    runs_first := [top_level_code(i) for i in 0..entry_index]
    awaits := program.shared.any(Shared.top_level_awaits)
    releases := released_globals(code.globals)
    program_code := TopLevelCode(awaits, symbol: '@lerta_main')
    generate_main main, main_code, program_code, runs_first, releases, true
  else
    generate_main main, main_code, top_level_code(module.index), [], [], false
  if module.index == program.builtins
    define_raise_error function_generator(code, extensions, facts, '')
  for statement in module.program
    (name, literal) := plain_function(statement) ? continue
    generate_one function_symbol(module.symbol_name, name), name, literal, nil
  for info in shared.objects.values()
    # A generic class or struct is generated by its instances (see instances_on_demand), whose
    # methods are all generic.
    continue if is_generic_object(info)
    define_object code.ir_module, program, info, ''
    constructor := function_generator(code, extensions, info.facts, format_type(info.type))
    generate_constructor constructor, '', info
    for (method, literal) in info.methods
      continue if method in info.generics
      generate_one method_symbol(info.type, method), method, literal, info.type
  for method in shared.own_methods
    continue if method.generic != nil
    symbol := extension_symbol(program, method)
    generate_one symbol, method.name.name, method.literal, method.receiver

# The top-level code: the statements other than the declarations of functions and types.
is_main_code := (statement: Statement) ->
  case statement
    when Declaration then statement.value is not FunctionLiteral
    when TypeDeclaration then false
    else true

# The name and the literal of a top-level function that is not generic; a generic function is
# generated per instance instead.
plain_function := (statement: Statement) ->
  return nil unless statement is Declaration
  value := statement.value
  return nil if value is not FunctionLiteral or not value.type_params.is_empty()
  (statement.name.name, value)

released_globals := (globals: Map<String, TopLevelGlobal>[]) ->
  in_order: TopLevelGlobal[]
  in_order.append values.values().to_array() for values in globals
  in_order.reversed()
