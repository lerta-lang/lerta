# Integer arithmetic, which throws on overflow and on division by zero; and the methods that wrap
# around instead (see emit_wrapping).
import Generator from './generator'
import IrBuilder from './ir_builder'
import ir_type from './lerta_ir'
import DIVISION_BY_ZERO, OVERFLOW, SHIFT_OUT_OF_RANGE, throw_if from './runtime_errors'
import is_kind, Type from '../types'

const INT_MIN = '-9223372036854775808'

# An arithmetic operator, `+`, `-`, `*`, `/` or `%`, or a bitwise one, `&`, `|`, `^`, `<<` or `>>`,
# applied to two Ints or two Bytes.
export const apply_integer_operator = (
  g: Generator, operator: String, left: String, right: String, type: Type
) ->
  return bitwise(g, operator, left, right, type) if BITWISE_INSTRUCTIONS.has(operator)
  return shift(g, operator, left, right, type) if operator == '<<' or operator == '>>'
  const is_division = operator == '/' or operator == '%'
  const is_byte = is_kind(type, 'Byte')
  case
    when is_division and is_byte then byte_division(g, operator, left, right)
    when is_division then division(g, operator, left, right)
    else checked(g, operator, left, right, is_byte then 'i8' else 'i64', not is_byte)

# Byte is unsigned, so that 0 - 1 overflows as 255 + 1 does.
const checked = (
  g: Generator, operator: String, left: String, right: String, width: String, signed: Bool
) ->
  const sign = signed then 's' else 'u'
  const operation =
    case operator
      when '+' then 'add'
      when '-' then 'sub'
      when '*' then 'mul'
      else panic("no arithmetic operator #{operator}")
  const intrinsic = "llvm.#{sign}#{operation}.with.overflow.#{width}"
  const result_type = "{ #{width}, i1 }"
  const ir = g.ir
  ir.module.declare intrinsic, "declare #{result_type} @#{intrinsic}(#{width}, #{width})"
  const args = "#{width} #{left}, #{width} #{right}"
  const result = ir.assign("call #{result_type} @#{intrinsic}(#{args})")
  const overflowed = ir.assign("extractvalue #{result_type} #{result}, 1")
  throw_if g, overflowed, OVERFLOW
  ir.assign "extractvalue #{result_type} #{result}, 0"

const BITWISE_INSTRUCTIONS = { '&': 'and', '|': 'or', '^': 'xor' }

const bitwise = (g: Generator, operator: String, left: String, right: String, type: Type) ->
  g.ir.assign "#{BITWISE_INSTRUCTIONS[operator]!} #{ir_type(type)} #{left}, #{right}"

# A shift by a negative amount, or by the type's bits or more, throws: compared as unsigned, a
# negative amount is above the bits. `<<` of a signed type throws unless shifting the result back
# gives the value, as it does when no bit that differs from the sign is shifted out.
const shift = (g: Generator, operator: String, left: String, right: String, type: Type) ->
  const ir = g.ir
  const is_byte = is_kind(type, 'Byte')
  const width = ir_type(type)
  const out_of_range = ir.assign("icmp uge #{width} #{right}, #{is_byte then 8 else 64}")
  throw_if g, out_of_range, SHIFT_OUT_OF_RANGE
  if operator == '>>'
    return ir.assign("#{is_byte then 'lshr' else 'ashr'} #{width} #{left}, #{right}")
  const shifted = ir.assign("shl #{width} #{left}, #{right}")
  return shifted if is_byte
  const back = ir.assign("ashr #{width} #{shifted}, #{right}")
  throw_if g, ir.assign("icmp ne #{width} #{back}, #{left}"), OVERFLOW
  shifted

# INT_MIN / -1 overflows; INT_MIN % -1 is rejected too, since LLVM leaves it undefined.
const division = (g: Generator, operator: String, left: String, right: String) ->
  const ir = g.ir
  const is_zero = ir.assign("icmp eq i64 #{right}, 0")
  throw_if g, is_zero, DIVISION_BY_ZERO
  const is_min = ir.assign("icmp eq i64 #{left}, #{INT_MIN}")
  const is_minus_one = ir.assign("icmp eq i64 #{right}, -1")
  const overflows = ir.assign("and i1 #{is_min}, #{is_minus_one}")
  throw_if g, overflows, OVERFLOW
  const instruction = operator == '/' then 'sdiv' else 'srem'
  ir.assign "#{instruction} i64 #{left}, #{right}"

const byte_division = (g: Generator, operator: String, left: String, right: String) ->
  const is_zero = g.ir.assign("icmp eq i8 #{right}, 0")
  throw_if g, is_zero, DIVISION_BY_ZERO
  const instruction = operator == '/' then 'udiv' else 'urem'
  g.ir.assign "#{instruction} i8 #{left}, #{right}"

# `x.wrapping_add(y)` and the like: the operation without the check, modulo 2 to the type's bits.
export const emit_wrapping = (
  ir: IrBuilder, name: String, left: String, right: String, type: Type
) ->
  const instruction = name.without_prefix('wrapping_')!
  ir.assign "#{instruction} #{ir_type(type)} #{left}, #{right}"
