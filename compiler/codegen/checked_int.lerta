# Integer arithmetic, which throws on overflow and on division by zero, and the builtin methods of
# the integer types: those that wrap around instead, the conversions, to_float and to_string.
import Generator from './generator'
import IrBuilder from './ir_builder'
import ir_type from './lerta_ir'
import call_runtime from './runtime_calls'
import DIVISION_BY_ZERO, NOT_A_CHAR, OVERFLOW, SHIFT_OUT_OF_RANGE, throw_if from './runtime_errors'
import char_type, int_type, integer_bits, integer_range, is_kind, is_signed, Type from '../types'

# An arithmetic operator, `+`, `-`, `*`, `/` or `%`, or a bitwise one, `&`, `|`, `^`, `<<` or `>>`,
# applied to two values of an integer type, by its bits and its sign.
export const apply_integer_operator = (
  g: Generator, operator: String, left: String, right: String, type: Type
) ->
  return bitwise(g, operator, left, right, type) if BITWISE_INSTRUCTIONS.has(operator)
  return shift(g, operator, left, right, type) if operator == '<<' or operator == '>>'
  return division(g, operator, left, right, type) if operator == '/' or operator == '%'
  checked g, operator, left, right, type

# An unsigned type overflows below 0, as 0 - 1 does, as it does above its largest value.
const checked = (g: Generator, operator: String, left: String, right: String, type: Type) ->
  const sign = is_signed(type) then 's' else 'u'
  const operation =
    case operator
      when '+' then 'add'
      when '-' then 'sub'
      when '*' then 'mul'
      else panic("no arithmetic operator #{operator}")
  const width = ir_type(type)
  const intrinsic = "llvm.#{sign}#{operation}.with.overflow.#{width}"
  const result_type = "{ #{width}, i1 }"
  const ir = g.ir
  ir.module.declare intrinsic, "declare #{result_type} @#{intrinsic}(#{width}, #{width})"
  const args = "#{width} #{left}, #{width} #{right}"
  const result = ir.assign("call #{result_type} @#{intrinsic}(#{args})")
  const overflowed = ir.assign("extractvalue #{result_type} #{result}, 1")
  throw_if g, overflowed, OVERFLOW
  ir.assign "extractvalue #{result_type} #{result}, 0"

const BITWISE_INSTRUCTIONS = { '&': 'and', '|': 'or', '^': 'xor' }

const bitwise = (g: Generator, operator: String, left: String, right: String, type: Type) ->
  g.ir.assign "#{BITWISE_INSTRUCTIONS[operator]!} #{ir_type(type)} #{left}, #{right}"

# A shift by a negative amount, or by the type's bits or more, throws: compared as unsigned, a
# negative amount is above the bits. `<<` of a signed type throws unless shifting the result back
# gives the value, as it does when no bit that differs from the sign is shifted out.
const shift = (g: Generator, operator: String, left: String, right: String, type: Type) ->
  const ir = g.ir
  const signed = is_signed(type)
  const width = ir_type(type)
  const out_of_range = ir.assign("icmp uge #{width} #{right}, #{integer_bits(type)}")
  throw_if g, out_of_range, SHIFT_OUT_OF_RANGE
  if operator == '>>'
    return ir.assign("#{signed then 'ashr' else 'lshr'} #{width} #{left}, #{right}")
  const shifted = ir.assign("shl #{width} #{left}, #{right}")
  return shifted if not signed
  const back = ir.assign("ashr #{width} #{shifted}, #{right}")
  throw_if g, ir.assign("icmp ne #{width} #{back}, #{left}"), OVERFLOW
  shifted

# The least value of a signed type / -1 overflows; its % -1 is rejected too, since LLVM leaves it
# undefined.
const division = (g: Generator, operator: String, left: String, right: String, type: Type) ->
  const ir = g.ir
  const width = ir_type(type)
  throw_if g, ir.assign("icmp eq #{width} #{right}, 0"), DIVISION_BY_ZERO
  const is_quotient = operator == '/'
  if not is_signed(type)
    return ir.assign("#{is_quotient then 'udiv' else 'urem'} #{width} #{left}, #{right}")
  const is_min = ir.assign("icmp eq #{width} #{left}, #{integer_range(type).least}")
  const is_minus_one = ir.assign("icmp eq #{width} #{right}, -1")
  throw_if g, ir.assign("and i1 #{is_min}, #{is_minus_one}"), OVERFLOW
  ir.assign "#{is_quotient then 'sdiv' else 'srem'} #{width} #{left}, #{right}"

# `x.wrapping_add(y)` and the like: the operation without the check, modulo 2 to the type's bits.
export const emit_wrapping = (
  ir: IrBuilder, instruction: String, left: String, right: String, type: Type
) -> ir.assign("#{instruction} #{ir_type(type)} #{left}, #{right}")

# The text of a value of an integer type, through that of an Int, or that of a UInt64, which may be
# above an Int's values.
export const emit_integer_text = (ir: IrBuilder, value: String, type: Type) ->
  if is_kind(type, 'UInt64')
    return call_runtime(ir, 'ptr @lerta_uint64_to_string(i64)', "i64 #{value}")
  call_runtime(
    ir
    'ptr @lerta_int_to_string(i64)'
    "i64 #{resized(ir, value, type, int_type, is_signed(type))}"
  )

export const emit_integer_to_float = (ir: IrBuilder, value: String, type: Type) ->
  ir.assign "#{is_signed(type) then 'sitofp' else 'uitofp'} #{ir_type(type)} #{value} to double"

# `x.to_int8()` and the like, which throw unless the value fits in the type: converted there and
# back, it must come back the same, and with the same sign, as a value of one sign that is
# negative as one of the other is no value of it.
export const emit_conversion = (g: Generator, value: String, from: Type, to: Type) ->
  return emit_char_conversion(g, value, from) if is_kind(to, 'Char')
  const ir = g.ir
  const converted = resized(ir, value, from, to, is_signed(from))
  const back = resized(ir, converted, to, from, is_signed(to))
  const changed = ir.assign("icmp ne #{ir_type(from)} #{back}, #{value}")
  const is_negative = (operand: String, type: Type) ->
    is_signed(type) then ir.assign("icmp slt #{ir_type(type)} #{operand}, 0") else 'false'
  const negative = is_signed(from) then is_negative(value, from) else is_negative(converted, to)
  const lost =
    is_signed(from) == is_signed(to) then changed else ir.assign("or i1 #{changed}, #{negative}")
  throw_if g, lost, OVERFLOW
  converted

# `n.to_char()`, which throws unless the number is a Unicode scalar value: from 0 to 0x10FFFF, but
# for the surrogates, from 0xD800 to 0xDFFF. The number is compared as a word, where no value of a
# narrower type is out of place.
const emit_char_conversion = (g: Generator, value: String, from: Type) ->
  const ir = g.ir
  const word = resized(ir, value, from, int_type, is_signed(from))
  const beyond = ir.assign("icmp ugt i64 #{word}, #{MAX_CHAR}")
  const above_surrogates = ir.assign("sub i64 #{word}, #{FIRST_SURROGATE}")
  const is_surrogate = ir.assign("icmp ult i64 #{above_surrogates}, #{SURROGATE_COUNT}")
  throw_if g, ir.assign("or i1 #{beyond}, #{is_surrogate}"), NOT_A_CHAR
  resized ir, word, int_type, char_type, false

const MAX_CHAR = 0x10FFFF
const FIRST_SURROGATE = 0xD800
const SURROGATE_COUNT = 0x800

# The value with the bits of `to`: cut, or extended by its sign if `signed`.
const resized = (ir: IrBuilder, value: String, from: Type, to: Type, signed: Bool) ->
  const from_bits = integer_bits(from)
  const to_bits = integer_bits(to)
  return value if from_bits == to_bits
  const instruction = to_bits < from_bits then 'trunc' else signed then 'sext' else 'zext'
  ir.assign "#{instruction} #{ir_type(from)} #{value} to #{ir_type(to)}"
