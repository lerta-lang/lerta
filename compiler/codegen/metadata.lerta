# The metadata nodes of a module, `!<n> = ...`, which its instructions and other nodes name by
# number, made on demand, each node once.
export class Metadata
  nodes: String[] = []
  keys: Map<String, String> = Map()

  # The node of the text, the same for the same text.
  node = (text: String) -> @keys[text, default: @added(text)]

  # A node of its own, as a subprogram is, which no other may share.
  distinct = (text: String) -> @added("distinct #{text}")

  added = (text: String) ->
    name := "!#{@nodes.length}"
    @nodes.push "#{name} = #{text}"
    name
