# The functions that read values of a type through a Decoder (see codegen/codable), which give the
# value owned, and release what they have read of it when a method throws.
import codable_kind from '../checker/codable'
import FieldInfo, info_of, is_argument from '../checker/object_types'
import ProgramWide from '../checker/shared'
import emit_array_new, emit_push from './array'
import emit_parse from './enum'
import emit_check_with, emit_return_thrown from './exceptions'
import emit_box from './boxes'
import emit_values from './heap_object'
import emit_branch, emit_when, emit_while, IrBuilder, IrModule, phi_incoming from './ir_builder'
import
  call_method, call_void_method, Coder, is_inline, map_shape, MAP, name_arg, SCALARS, SET
from './codable'
import
  constructor_symbol, emit_release, emit_release_value, ir_type, shared_string_constant
from './lerta_ir'
import emit_map_new, emit_map_set, emit_set_add, emit_set_contains from './map'
import emit_is_nil, emit_unwrap, emit_wrap, nil_constant from './optional'
import narrowed_from_word, scalar_of from './scalar'
import
  ArrayType, bool_type, EnumType, format_type, kind_of, MapType, ObjectType, optional_type,
  OptionalType, int_type, integer_range, is_boxed, RecordType, string_type, TupleType, Type,
  type_key, UnionType
from '../types'

# The value read, owned; the caller checks for an exception after it.
export emit_decode := (
  ir: IrBuilder, program: ProgramWide, reader_type: ObjectType, reader: String, type: Type
) -> emit_read_call(ir, { program, type: reader_type, operand: reader }, type)

emit_read_call := (ir: IrBuilder, reader: Coder, type: Type) ->
  symbol := read_function(ir.module, reader, type)
  ir.assign "call #{ir_type(type)} #{symbol}(ptr #{reader.operand})"

read_function := (module: IrModule, reader: Coder, type: Type) ->
  define := (name: String, defined: IrModule) ->
    ir := IrBuilder(defined)
    own := Coder(reader..., operand: '%reader')
    ir.emit "ret #{ir_type(type)} #{emit_read_parts(ir, own, type)}"
    ir.finish "private #{ir_type(type)} #{name}(ptr %reader)"
  module.named "decode #{type_key(type)}", '@lerta.decode', define

# The body of the function of a type: its parts, or the value itself for a type that others read
# inline, which a builtin may read too.
emit_read_parts := (ir: IrBuilder, reader: Coder, type: Type) ->
  case type
    when ArrayType then emit_read_array(ir, reader, type)
    when MapType then emit_read_map(ir, reader, type)
    when TupleType then emit_read_tuple(ir, reader, type)
    when RecordType then emit_read_record(ir, reader, type)
    when ObjectType then emit_read_object(ir, reader, type)
    when UnionType then emit_read_union(ir, reader, type)
    else emit_read(ir, reader, type, -> emit_return_thrown(ir, type))

# The value read, owned. `unwind` releases what the function holds and returns.
emit_read := (ir: IrBuilder, reader: Coder, type: Type, unwind: () -> void): String ->
  unless is_inline(type)
    value := emit_read_call(ir, reader, type)
    emit_check_with ir, unwind
    return value
  case type
    when OptionalType
      is_null := call_method(ir, reader, 'read_nil', bool_type, [], unwind)
      present := ir.negate(is_null)
      read_inner := -> emit_wrap(ir, emit_read(ir, reader, type.inner, unwind), type.inner)
      emit_branch ir, ir_type(type), present, read_inner, nil_constant(type)
    when EnumType then emit_read_member(ir, reader, type, unwind)
    else
      if scalar := SCALARS[kind_of(type)]
        return call_method(ir, reader, scalar.read, scalar.type, [], unwind)
      emit_read_integer ir, reader, type, unwind

# An integer of a type that SCALARS has not, read as an Int in the type's range.
emit_read_integer := (ir: IrBuilder, reader: Coder, type: Type, unwind: () -> void) ->
  { least, most } := integer_range(type)
  name := format_type(type)
  article := name.starts_with('I') then 'an' else 'a'
  expected := shared_string_constant(ir, "#{article} #{name}")
  args := ["ptr #{expected}", "i64 #{least}", "i64 #{most}"]
  word := call_method(ir, reader, 'read_integer', int_type, args, unwind)
  narrowed_from_word ir, word, scalar_of(type)!

# The member that the name read names.
emit_read_member := (ir: IrBuilder, reader: Coder, type: EnumType, unwind: () -> void) ->
  enum_name := name_arg(ir, format_type(type))
  text := call_method(ir, reader, 'read_member', string_type, [enum_name], unwind)
  member := emit_parse(ir, text, type)
  release_text := ->
    emit_release ir, text
    unwind()
  fail := -> call_void_method(ir, reader, 'fail_member', [enum_name, "ptr #{text}"], release_text)
  optional := optional_type(type)
  emit_when ir, emit_is_nil(ir, member, optional), fail
  emit_release ir, text
  emit_unwrap ir, member, optional

# The array, which the function holds while it reads the items.
emit_read_array := (ir: IrBuilder, reader: Coder, type: ArrayType) ->
  element := type.element
  array := emit_array_new(ir, element)
  unwind := -> release_and_return(ir, array, type)
  call_void_method ir, reader, 'begin_array', [], unwind
  more := -> call_method(ir, reader, 'next_item', bool_type, [], unwind)
  read_item := ->
    item := emit_read(ir, reader, element, unwind)
    # The array retains the item, which this function owned.
    emit_push ir, array, item, element
    emit_release_value ir, item, element
  emit_while ir, more, read_item
  array

# The map, which the function holds while it reads the items of a set, the keys of String and the
# values of a map, or the entries of another map, each of a key and a value (see map_shape).
emit_read_map := (ir: IrBuilder, reader: Coder, type: MapType) ->
  map := emit_map_new(ir, reader.program, type)
  unwind := -> release_and_return(ir, map, type)
  shape := map_shape(type)
  call_void_method ir, reader, "begin_#{shape}", [], unwind
  # The map retains the key and the value, which this function owned.
  add := (key: String, release_key: () -> void) ->
    value := emit_read(ir, reader, type.value, release_key)
    emit_map_set ir, map, key, value, type
    emit_release_value ir, value, type.value
    emit_release_value ir, key, type.key
  case shape
    when MAP then emit_for_each_key(ir, reader, 'read_key', unwind, add)
    when SET then emit_read_set_items(ir, reader, map, type, unwind)
    else emit_for_each_entry(ir, reader, map, type, unwind, add)
  map

# Adds each item of the set, read, to it. An item that the set holds already fails, as a key of a
# map of String keys read twice does.
emit_read_set_items := (
  ir: IrBuilder, reader: Coder, set: String, type: MapType, unwind: () -> void
) ->
  more := -> call_method(ir, reader, 'next_item', bool_type, [], unwind)
  read := ->
    item := emit_read(ir, reader, type.key, unwind)
    release_item := ->
      emit_release_value ir, item, type.key
      unwind()
    fail := -> call_void_method(ir, reader, 'fail_duplicate', [], release_item)
    # The set retains the item, which this function owned.
    emit_when ir, ir.negate(emit_set_add(ir, set, item, type)), fail
    emit_release_value ir, item, type.key
  emit_while ir, more, read

# Runs `add` with the key of each entry, read, owned, and what releases it and unwinds, after which
# it reads the end of the entry. A key that the map holds already fails.
emit_for_each_entry := (
  ir: IrBuilder, reader: Coder, map: String, type: MapType, unwind: () -> void,
  add: (String, () -> void) -> void
) ->
  more := -> call_method(ir, reader, 'next_entry', bool_type, [], unwind)
  read := ->
    key := emit_read(ir, reader, type.key, unwind)
    release_key := ->
      emit_release_value ir, key, type.key
      unwind()
    fail := -> call_void_method(ir, reader, 'fail_duplicate', [], release_key)
    emit_when ir, emit_set_contains(ir, map, key, type), fail
    call_void_method ir, reader, 'entry_value', [], release_key
    add key, release_key
    call_void_method ir, reader, 'end_entry', [], unwind
  emit_while ir, more, read

# Runs `body` with each key of the map or record being read, which the method gives, owned, and
# what releases the key and unwinds, for where reading its value fails.
emit_for_each_key := (
  ir: IrBuilder, reader: Coder, method: String, unwind: () -> void,
  body: (String, () -> void) -> void
) ->
  var key = ''
  more := ->
    key = call_method(ir, reader, method, optional_type(string_type), [], unwind)
    ir.is_not_null key
  release_key := ->
    emit_release ir, key
    unwind()
  emit_while ir, more, -> body(key, release_key)

# The items in their order, which the function holds until it makes the tuple of them.
emit_read_tuple := (ir: IrBuilder, reader: Coder, type: TupleType) ->
  count := "i64 #{type.items.length}"
  items: String[]
  unwind := ->
    emit_release_value ir, item, type.items[i] for item, i in items
    emit_return_thrown ir, type
  call_void_method ir, reader, 'begin_tuple', [count], unwind
  for item_type in type.items
    call_void_method ir, reader, 'next_tuple_item', [count], unwind
    items.push emit_read(ir, reader, item_type, unwind)
  call_void_method ir, reader, 'end_tuple', [count], unwind
  emit_values ir, type, items

# A field read from a record's key: a field with a default, or of an optional type, may be left
# out.
struct FieldToRead
  name: String
  type: Type
  has_default: Bool

is_required := (field: FieldToRead) -> not field.has_default and field.type is not OptionalType

emit_read_record := (ir: IrBuilder, reader: Coder, type: RecordType) ->
  fields :=
    [FieldToRead(name: field.name, type: field.type, has_default: false) for field in type.fields]
  make := (values: FieldValues) -> emit_values(ir, type, values.values())
  emit_read_fields ir, reader, type, fields, make

# The object is constructed as a call of its constructor does it: of the fields that are its
# arguments, each with a default followed by whether it is given (see generate_construction).
emit_read_object := (ir: IrBuilder, reader: Coder, type: ObjectType) ->
  info := info_of(reader.program, type)
  to_read := (field: FieldInfo) ->
    FieldToRead name: field.name.name, type: field.type!, has_default: field.has_default
  fields := [to_read(field) for field in info.fields when is_argument(field)]
  make := (values: FieldValues) ->
    args: String[]
    for field, i in fields
      args.push "#{ir_type(field.type)} #{values.value(i)}"
      args.push "i1 #{values.given(i)}" if field.has_default
    # The constructor takes the values over, owned, and releases them if it throws.
    object := ir.assign("call ptr #{constructor_symbol(type)}(#{args.join(', ')})")
    emit_check_with ir, -> emit_return_thrown(ir, type)
    object
  emit_read_fields ir, reader, type, fields, make

# The values of the fields read so far, each in a slot of its own with whether its key was given,
# which `unwind` releases. A field left out holds nil, or zeros for a field with a default, which
# releasing ignores.
class FieldValues
  ir: IrBuilder
  fields: FieldToRead[]
  # The type that the function gives.
  type: Type
  slots: FieldSlots[] = []

  values := -> [@value(i) for i in 0...@fields.length]
  value := (i: Int) -> @ir.load(ir_type(@fields[i].type), @slots[i].value)
  given := (i: Int) -> @ir.load('i1', @slots[i].given)

  unwind := ->
    emit_release_value @ir, @value(i), field.type for field, i in @fields
    emit_return_thrown @ir, @type

# The slots of a field: of its value, and of whether its key was given.
struct FieldSlots
  value: String
  given: String

emit_read_fields := (
  ir: IrBuilder, reader: Coder, type: Type, fields: FieldToRead[], make: (FieldValues) -> String
) ->
  values := FieldValues(ir, fields, type)
  for field in fields
    slot := ir.alloca(ir_type(field.type))
    empty := field.type is OptionalType then nil_constant(field.type) else 'zeroinitializer'
    ir.store ir_type(field.type), empty, slot
    given := ir.alloca('i1')
    ir.store 'i1', 'false', given
    values.slots.push { value: slot, given }
  unwind := -> values.unwind()
  call_void_method ir, reader, 'begin_record', [], unwind
  read_key := (key: String, release_key: () -> void) ->
    emit_read_field_of_key ir, reader, values, key, release_key
    emit_release ir, key
  emit_for_each_key ir, reader, 'read_field', unwind, read_key
  for field, i in fields
    continue unless is_required(field)
    fail := ->
      call_void_method ir, reader, 'fail_missing_field', [name_arg(ir, field.name)], unwind
    emit_when ir, ir.negate(values.given(i)), fail
  make values

# Reads the value of the key into the field whose key it is, as the decoder tells, or skips it if no
# field has it as its key.
emit_read_field_of_key := (
  ir: IrBuilder, reader: Coder, values: FieldValues, key: String, unwind: () -> void
) ->
  done := ir.fresh_label('decode.key.done')
  for field, i in values.fields
    read := ir.fresh_label('decode.key.field')
    next := ir.fresh_label('decode.key.next')
    args := ["ptr #{key}", name_arg(ir, field.name)]
    matches := call_method(ir, reader, 'is_field', bool_type, args, unwind)
    ir.branch_if matches, read, next
    ir.start_block read
    value := emit_read(ir, reader, field.type, unwind)
    ir.store ir_type(field.type), value, values.slots[i].value
    ir.store 'i1', 'true', values.slots[i].given
    ir.branch done
    ir.start_block next
  call_void_method ir, reader, 'skip_value', [], unwind
  ir.branch done
  ir.start_block done

# The member that the kind of the value tells (see checker/codable), in its box if it has one.
emit_read_union := (ir: IrBuilder, reader: Coder, type: UnionType) ->
  unwind := -> emit_return_thrown(ir, type)
  kind := call_method(ir, reader, 'peek_kind', int_type, [], unwind)
  done := ir.fresh_label('decode.member.done')
  other := ir.fresh_label('decode.member.other')
  labels := [ir.fresh_label('decode.member') for _ in type.members]
  cases := ["i64 #{codable_kind(member)!}, label %#{labels[i]}" for member, i in type.members]
  ir.emit "switch i64 #{kind}, label %#{other} [ #{cases.join(' ')} ]"
  incoming: String[]
  for member, i in type.members
    ir.start_block labels[i]
    value := emit_read(ir, reader, member, unwind)
    boxed := is_boxed(member) then emit_box(ir, value, member) else value
    incoming.push phi_incoming(boxed, ir.current_block)
    ir.branch done
  ir.start_block other
  expected := shared_string_constant(ir, format_type(type))
  call_void_method ir, reader, 'fail_expected', ["ptr #{expected}"], unwind
  ir.emit 'unreachable'
  ir.start_block done
  ir.assign "phi ptr #{incoming.join(', ')}"

release_and_return := (ir: IrBuilder, value: String, type: Type) ->
  emit_release ir, value
  emit_return_thrown ir, type
