# Generates the constructors of objects.
import is_value_type from '../checker/value_layout'
import FieldInfo, is_argument, ObjectInfo from '../checker/object_types'
import emit_exception_check from './exceptions'
import generate from './expression'
import Generator, ValueLocal from './generator'
import
  emit_allocate, emit_field_pointer, emit_slot_field_pointer, emit_weak_slot_or_null
from './heap_object'
import emit_when from './ir_builder'
import
  constructor_symbol, emit_release, emit_release_stored, ir_type, special_method_symbol
from './lerta_ir'
import call_runtime, call_void_runtime from './runtime_calls'
import finish, weak_box_of from './function'

# Takes the constructor arguments (see is_argument, in order) owned, unlike any other call, and
# stores those given first, so that the fields own them before anything can throw; then computes
# the other fields, and the defaults of the arguments not given, in order, and runs `init` last.
# Storing the arguments first does not show, as an initializer reads only the fields before it. An
# exception on the way releases the fields, which start as nil, and frees the object without
# running its deinit, or panics if init let it escape. An argument with a default comes with whether
# it is given (see generate_construction). It has the linkage (see Definition).
# A struct that is a value (see value_layout) is built in a slot of its own, which `@` reads as it
# is so far, and is returned whole.
export generate_constructor := (g: Generator, linkage: String, info: ObjectInfo) ->
  ir := g.ir
  g.result_type = info.type
  type := ir_type(ir.program, info.type)
  is_value := is_value_type(ir.program, info.type)
  object := is_value then ir.alloca(type) else emit_allocate(ir, info)
  field_pointer := (field: FieldInfo) ->
    name := field.name.name
    if is_value
      emit_slot_field_pointer(ir, object, info, name)
    else
      emit_field_pointer(ir, object, info, name)
  this := -> is_value then ir.load(type, object) else object
  for field in info.fields
    ir.store ir_type(ir.program, field.type!), 'zeroinitializer', field_pointer(field)
  g.unwind_cleanup = ->
    mark := is_value then '' else call_runtime(ir, 'i64 @lerta_drop_mark()', '')
    for field in info.fields
      emit_release_stored ir, field_pointer(field), field.type!
    unless is_value
      weak_slot := emit_weak_slot_or_null(ir, object, info)
      args := "ptr #{object}, ptr #{weak_slot}, i64 #{mark}"
      call_void_runtime ir, 'void @lerta_free_unfinished(ptr, ptr, i64)', args
  arguments := [field for field in info.fields when is_argument(field)]
  given := (field: FieldInfo) -> "%given#{argument_index(arguments, field)}"
  for field at i in arguments
    store_argument := -> store_field(g, field_pointer(field), field, "%p#{i}")
    if field.has_default
      emit_when ir, given(field), store_argument
    else
      store_argument()
  scope := g.locals.push()
  for field in info.fields
    value := field.value else continue
    compute := ->
      scope['@'] = ValueLocal(operand: this(), type: info.type)
      store_field g, field_pointer(field), field, generate(g, value)
    if field.has_default
      emit_when ir, ir.negate(given(field)), compute
    else
      compute()
  g.locals.pop()
  result := this()
  init := special_method_symbol(ir.program, info, 'init')
  if info.has_init
    ir.emit "call void #{init}(#{type} #{result})"
    emit_exception_check g
  ir.emit "ret #{type} #{result}"
  params: String[]
  for argument at i in arguments
    params.push "#{ir_type(ir.program, argument.type!)} %p#{i}"
    params.push "i1 %given#{i}" if argument.has_default
  finish g, "#{linkage}#{type} #{constructor_symbol(info.type)}(#{params.join(', ')})"

argument_index := (arguments: FieldInfo[], field: FieldInfo) -> arguments.index_of(field)!

# The field at the pointer takes over the value, owned; a weak field takes its box instead.
store_field := (g: Generator, pointer: String, field: FieldInfo, value: String) ->
  stored := field.weak then weak_box_of(g, value, field.type!) else value
  emit_release g.ir, value if field.weak
  g.ir.store ir_type(g.code.program, field.type!), stored, pointer
