# The kinds of Iter, and the methods of Iters, in the generated code (see docs/internals.md#iter).
import emit_get, emit_length from './array'
import emit_closure_call, function_type_of from './closure'
import fixed, value_field from './heap_object'
import emit_check_or_return_thrown, emit_check_with, emit_return_thrown from './exceptions'
import emit_interface_call from './interface'
import IrBuilder from './ir_builder'
import
  define_kind, emit_checked_next, emit_has_next, emit_iter, emit_iter_start, emit_mark_started,
  emit_next, IterKind, load_state, store_state
from './iter_protocol'
import emit_release, emit_release_value, ir_type, ownership from './lerta_ir'
import emit_binary_get, emit_binary_length from './string'
import
  bool_type, FunctionType, int_type, is_kind, is_one_of_kinds, iterable_item, IterType, Type,
  type_key
from '../types'

# The length and the items of an array or a Binary, which for loops and their Iters read by index.
export emit_sequence_length := (ir: IrBuilder, sequence: String, type: Type) ->
  is_kind(type, 'Binary') then emit_binary_length(ir, sequence) else emit_length(ir, sequence)

# The item is owned when it is a reference.
export emit_sequence_get := (ir: IrBuilder, sequence: String, index: String, type: Type) ->
  if is_kind(type, 'Binary')
    emit_binary_get ir, sequence, index
  else
    emit_get ir, sequence, index, iterable_item(type)!

# The items of an array or a Binary, which the Iter holds.
emit_sequence_iter := (ir: IrBuilder, sequence: String, type: Type) ->
  element := iterable_item(type)!
  has_next := (body: IrBuilder, kind: IterKind) ->
    length := emit_sequence_length(body, load_state(body, kind, 0), type)
    index := load_state(body, kind, 1)
    is_below := body.assign("icmp slt i64 #{index}, #{length}")
    body.emit "ret i1 #{is_below}"
  next := (body: IrBuilder, kind: IterKind) ->
    index := load_state(body, kind, 1)
    item := emit_sequence_get(body, load_state(body, kind, 0), index, type)
    store_state body, kind, 1, body.assign("add nsw i64 #{index}, 1")
    body.emit "ret #{ir_type(element)} #{item}"
  state := [fixed(value_field(type)), value_field(int_type)]
  kind := define_kind(ir, "sequence #{type_key(type)}", state, element, has_next, next)
  emit_iter ir, kind, [sequence, '0']

# The items that a value with has_next and next gives, which the Iter holds as an interface value
# of the type `source_type` (see iter_source_type), and calls through its itab.
export emit_adapter_iter := (ir: IrBuilder, source: String, source_type: Type, item: Type) ->
  has_next := (body: IrBuilder, kind: IterKind) ->
    type := FunctionType(params: [], result: bool_type)
    more := emit_interface_call(body, load_state(body, kind, 0), 0, type, [])
    emit_check_or_return_thrown body, bool_type
    body.emit "ret i1 #{more}"
  next := (body: IrBuilder, kind: IterKind) ->
    type := FunctionType(params: [], result: item)
    value := emit_interface_call(body, load_state(body, kind, 0), 1, type, [])
    emit_check_or_return_thrown body, item
    body.emit "ret #{ir_type(item)} #{value}"
  state := [fixed(value_field(source_type))]
  kind := define_kind(ir, "adapter #{type_key(source_type)}", state, item, has_next, next)
  emit_iter ir, kind, [source]

# The Ints from start up to, but not including, end.
export emit_range_iter := (ir: IrBuilder, start: String, end: String) ->
  has_next := (body: IrBuilder, kind: IterKind) ->
    current := load_state(body, kind, 0)
    last := load_state(body, kind, 1)
    is_below := body.assign("icmp slt i64 #{current}, #{last}")
    body.emit "ret i1 #{is_below}"
  # The current Int is below the end, so the next one cannot overflow.
  next := (body: IrBuilder, kind: IterKind) ->
    current := load_state(body, kind, 0)
    store_state body, kind, 0, body.assign("add nsw i64 #{current}, 1")
    body.emit "ret i64 #{current}"
  state := [value_field(int_type), fixed(value_field(int_type))]
  emit_iter ir, define_kind(ir, 'range', state, int_type, has_next, next), [start, end]

# The results of a function of one item, a closure of the type, for each item of the source.
emit_map_iter := (ir: IrBuilder, source: String, mapper: String, type: Type) ->
  function_type := function_type_of(type)
  item := function_type.params[0]
  has_next := (body: IrBuilder, kind: IterKind) ->
    more := emit_has_next(body, load_state(body, kind, 0))
    emit_check_or_return_thrown body, bool_type
    body.emit "ret i1 #{more}"
  next := (body: IrBuilder, kind: IterKind) ->
    value := emit_next(body, load_state(body, kind, 0), item)
    emit_check_or_return_thrown body, function_type.result
    result := emit_closure_call(body, load_state(body, kind, 1), type, [value])
    emit_release_value body, value, item
    emit_check_or_return_thrown body, function_type.result
    body.emit "ret #{ir_type(function_type.result)} #{result}"
  state := [fixed(value_field(IterType(item))), fixed(value_field(type))]
  key := "map #{type_key(type)}"
  kind := define_kind(ir, key, state, function_type.result, has_next, next)
  emit_iter ir, kind, [source, mapper]

# The items of the source for which a function, a closure, gives true. has_next finds the next
# such item and holds it until next takes it; the state is the source, the function, whether an
# item is held, and that item.
emit_filter_iter := (ir: IrBuilder, source: String, test: String, item: Type) ->
  test_type := FunctionType(params: [item], result: bool_type)
  has_next := (body: IrBuilder, kind: IterKind) ->
    search_label := body.fresh_label('filter.search')
    test_label := body.fresh_label('filter.test')
    keep_label := body.fresh_label('filter.keep')
    skip_label := body.fresh_label('filter.skip')
    found_label := body.fresh_label('filter.found')
    end_label := body.fresh_label('filter.end')
    is_held := load_state(body, kind, 2)
    body.emit "br i1 #{is_held}, label %#{found_label}, label %#{search_label}"
    body.start_block search_label
    source_iter := load_state(body, kind, 0)
    has_more := emit_has_next(body, source_iter)
    emit_check_or_return_thrown body, bool_type
    body.emit "br i1 #{has_more}, label %#{test_label}, label %#{end_label}"
    body.start_block test_label
    value := emit_next(body, source_iter, item)
    emit_check_or_return_thrown body, bool_type
    keep := emit_closure_call(body, load_state(body, kind, 1), test_type, [value])
    release_and_return := ->
      emit_release_value body, value, item
      emit_return_thrown body, bool_type
    emit_check_with body, release_and_return
    body.emit "br i1 #{keep}, label %#{keep_label}, label %#{skip_label}"
    body.start_block keep_label
    store_state body, kind, 3, value
    store_state body, kind, 2, 'true'
    body.emit "br label %#{found_label}"
    body.start_block skip_label
    emit_release_value body, value, item
    body.emit "br label %#{search_label}"
    body.start_block found_label
    body.emit 'ret i1 true'
    body.start_block end_label
    body.emit 'ret i1 false'
  # The held item passes to the caller; a reference is cleared, so that the drop does not release
  # it.
  next := (body: IrBuilder, kind: IterKind) ->
    store_state body, kind, 2, 'false'
    value := load_state(body, kind, 3)
    store_state body, kind, 3, 'zeroinitializer' if ownership(item) != NONE
    body.emit "ret #{ir_type(item)} #{value}"
  state :=
    fixed(value_field(IterType(item)))
    fixed(value_field(test_type))
    value_field(bool_type)
    value_field(item)
  kind := define_kind(ir, "filter #{type_key(item)}", state, item, has_next, next)
  emit_iter ir, kind, [source, test, 'false', 'zeroinitializer']

# An owned array, Binary or Iter as an Iter to read from: an Iter of the array's or the Binary's
# items, or the Iter itself, whose traversal starts here.
export emit_source_iter := (ir: IrBuilder, value: String, type: Type) ->
  emit_source_start ir, value, type
  emit_reading_iter ir, value, type

# An owned array, Binary or Iter as an Iter to read from, as emit_source_iter gives it, but with the
# traversal of an Iter not started yet: see emit_source_start.
export emit_reading_iter := (ir: IrBuilder, value: String, type: Type) ->
  is_sequence(type) then emit_sequence_iter(ir, value, type) else value

# Starts the traversal of an Iter that emit_reading_iter reads from, which throws if one has.
export emit_source_start := (ir: IrBuilder, value: String, type: Type) ->
  emit_iter_start ir, value if not is_sequence(type)

is_sequence := (type: Type) -> is_one_of_kinds(type, [ARRAY, 'Binary'])

# The methods of an Iter, has_next and next (see codegen builtins), which take over the object.
export call_has_next := (ir: IrBuilder, object: String) ->
  emit_mark_started ir, object
  consume ir, object, emit_has_next(ir, object)

export call_next := (ir: IrBuilder, object: String, type: Type, check: () -> void) ->
  emit_mark_started ir, object
  consume ir, object, emit_checked_next(ir, object, iterable_item(type)!, check)

consume := (ir: IrBuilder, object: String, result: String) ->
  emit_release ir, object
  result

# A comprehension's Iter: the items of the source for which the guard, if any, gives true, mapped
# by the element's function. The closures are owned, of functions of the item.
export emit_comprehension_iter := (
  ir: IrBuilder, source: String, item: Type, guard: String?, element: String, element_type: Type
) ->
  kept := guard then emit_filter_iter(ir, source, guard, item) else source
  emit_map_iter ir, kept, element, element_type
