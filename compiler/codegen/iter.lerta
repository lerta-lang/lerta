# The kinds of Iter in the generated code (see iter_protocol): an Iter of the items of an array or
# a Binary, of a range's Ints, and those that map, filter or take the items of another Iter, which
# they own; each is generated once per type it depends on. Also the methods of Iters.
import { emit_get, emit_length } from './array'
import { emit_closure_call, function_type_of } from './closure'
import { value_field } from './heap_object'
import { emit_interface_call } from './interface'
import { IrBuilder } from './ir_builder'
import {
  define_kind, emit_checked_next, emit_has_next, emit_iter, emit_iter_start, emit_mark_started
  emit_next, IterKind, load_state, store_state
} from './iter_protocol'
import { emit_release, emit_release_value, ir_type, ownership } from './lerta_ir'
import { emit_binary_get, emit_binary_length } from './string'
import {
  bool_type, FunctionType, int_type, is_kind, is_one_of_kinds, iterable_item, IterType, Type
  type_key
} from '../types'

# The length and the items of an array or a Binary, which for loops and their Iters read by index.
export const emit_sequence_length = (ir: IrBuilder, sequence: String, type: Type) ->
  is_kind(type, 'Binary') then emit_binary_length(ir, sequence) else emit_length(ir, sequence)

# The item is owned when it is a reference.
export const emit_sequence_get = (ir: IrBuilder, sequence: String, index: String, type: Type) ->
  case
    when is_kind(type, 'Binary') then emit_binary_get(ir, sequence, index)
    else emit_get(ir, sequence, index, iterable_item(type)!)

# The items of an array or a Binary, which the Iter holds. The length is read each time, as a for
# loop reads it, so items pushed to an array meanwhile are visited too.
const emit_sequence_iter = (ir: IrBuilder, sequence: String, type: Type) ->
  const element = iterable_item(type)!
  const has_next = (body: IrBuilder, kind: IterKind) ->
    const length = emit_sequence_length(body, load_state(body, kind, 0), type)
    const index = load_state(body, kind, 1)
    const is_below = body.assign("icmp slt i64 #{index}, #{length}")
    body.emit "ret i1 #{is_below}"
  const next = (body: IrBuilder, kind: IterKind) ->
    const index = load_state(body, kind, 1)
    const item = emit_sequence_get(body, load_state(body, kind, 0), index, type)
    store_state body, kind, 1, body.assign("add nsw i64 #{index}, 1")
    body.emit "ret #{ir_type(element)} #{item}"
  const state = [value_field(type), value_field(int_type)]
  const kind = define_kind(ir, "sequence #{type_key(type)}", state, element, has_next, next)
  emit_iter ir, kind, [sequence, '0']

# The items that a value with has_next and next gives, which the Iter holds as an interface value
# of the type `source_type` (see iter_source_type), and calls through its itab.
export const emit_adapter_iter = (ir: IrBuilder, source: String, source_type: Type, item: Type) ->
  const has_next = (body: IrBuilder, kind: IterKind) ->
    const type = FunctionType(params: [], result: bool_type)
    body.emit "ret i1 #{emit_interface_call(body, load_state(body, kind, 0), 0, type, [])}"
  const next = (body: IrBuilder, kind: IterKind) ->
    const type = FunctionType(params: [], result: item)
    const value = emit_interface_call(body, load_state(body, kind, 0), 1, type, [])
    body.emit "ret #{ir_type(item)} #{value}"
  const state = [value_field(source_type)]
  const kind = define_kind(ir, "adapter #{type_key(source_type)}", state, item, has_next, next)
  emit_iter ir, kind, [source]

# The Ints from start up to, but not including, end.
export const emit_range_iter = (ir: IrBuilder, start: String, end: String) ->
  const has_next = (body: IrBuilder, kind: IterKind) ->
    const current = load_state(body, kind, 0)
    const last = load_state(body, kind, 1)
    const is_below = body.assign("icmp slt i64 #{current}, #{last}")
    body.emit "ret i1 #{is_below}"
  # The current Int is below the end, so the next one cannot overflow.
  const next = (body: IrBuilder, kind: IterKind) ->
    const current = load_state(body, kind, 0)
    store_state body, kind, 0, body.assign("add nsw i64 #{current}, 1")
    body.emit "ret i64 #{current}"
  const state = [value_field(int_type), value_field(int_type)]
  emit_iter ir, define_kind(ir, 'range', state, int_type, has_next, next), [start, end]

# The results of a function of one item, a closure of the type, for each item of the source.
const emit_map_iter = (ir: IrBuilder, source: String, mapper: String, type: Type) ->
  const function_type = function_type_of(type)
  const item = function_type.params[0]
  const has_next = (body: IrBuilder, kind: IterKind) ->
    body.emit "ret i1 #{emit_has_next(body, load_state(body, kind, 0))}"
  const next = (body: IrBuilder, kind: IterKind) ->
    const value = emit_next(body, load_state(body, kind, 0), item)
    const result = emit_closure_call(body, load_state(body, kind, 1), type, [value])
    emit_release_value body, value, item
    body.emit "ret #{ir_type(function_type.result)} #{result}"
  const state = [value_field(IterType(item)), value_field(type)]
  const key = "map #{type_key(type)}"
  const kind = define_kind(ir, key, state, function_type.result, has_next, next)
  emit_iter ir, kind, [source, mapper]

# The items of the source for which a function, a closure, gives true. has_next finds the next
# such item and holds it until next takes it; the state is the source, the function, whether an
# item is held, and that item.
const emit_filter_iter = (ir: IrBuilder, source: String, test: String, item: Type) ->
  const test_type = FunctionType(params: [item], result: bool_type)
  const has_next = (body: IrBuilder, kind: IterKind) ->
    const search_label = body.fresh_label('filter.search')
    const test_label = body.fresh_label('filter.test')
    const keep_label = body.fresh_label('filter.keep')
    const skip_label = body.fresh_label('filter.skip')
    const found_label = body.fresh_label('filter.found')
    const end_label = body.fresh_label('filter.end')
    const is_held = load_state(body, kind, 2)
    body.emit "br i1 #{is_held}, label %#{found_label}, label %#{search_label}"
    body.start_block search_label
    const source_iter = load_state(body, kind, 0)
    const has_more = emit_has_next(body, source_iter)
    body.emit "br i1 #{has_more}, label %#{test_label}, label %#{end_label}"
    body.start_block test_label
    const value = emit_next(body, source_iter, item)
    const keep = emit_closure_call(body, load_state(body, kind, 1), test_type, [value])
    body.emit "br i1 #{keep}, label %#{keep_label}, label %#{skip_label}"
    body.start_block keep_label
    store_state body, kind, 3, value
    store_state body, kind, 2, 'true'
    body.emit "br label %#{found_label}"
    body.start_block skip_label
    emit_release_value body, value, item
    body.emit "br label %#{search_label}"
    body.start_block found_label
    body.emit 'ret i1 true'
    body.start_block end_label
    body.emit 'ret i1 false'
  # The held item passes to the caller; a reference is cleared, so that the drop does not release
  # it.
  const next = (body: IrBuilder, kind: IterKind) ->
    store_state body, kind, 2, 'false'
    const value = load_state(body, kind, 3)
    store_state body, kind, 3, 'zeroinitializer' if ownership(item) != NONE
    body.emit "ret #{ir_type(item)} #{value}"
  const state = [
    value_field(IterType(item)), value_field(test_type), value_field(bool_type), value_field(item)
  ]
  const kind = define_kind(ir, "filter #{type_key(item)}", state, item, has_next, next)
  emit_iter ir, kind, [source, test, 'false', 'zeroinitializer']

# At most `count` items of the source: none if it is not positive.
const emit_take_iter = (ir: IrBuilder, source: String, count: String, item: Type) ->
  const has_next = (body: IrBuilder, kind: IterKind) ->
    const ask_label = body.fresh_label('take.ask')
    const end_label = body.fresh_label('take.end')
    const remaining = load_state(body, kind, 1)
    const is_positive = body.assign("icmp sgt i64 #{remaining}, 0")
    body.emit "br i1 #{is_positive}, label %#{ask_label}, label %#{end_label}"
    body.start_block ask_label
    body.emit "ret i1 #{emit_has_next(body, load_state(body, kind, 0))}"
    body.start_block end_label
    body.emit 'ret i1 false'
  const next = (body: IrBuilder, kind: IterKind) ->
    const remaining = load_state(body, kind, 1)
    store_state body, kind, 1, body.assign("sub nsw i64 #{remaining}, 1")
    const value = emit_next(body, load_state(body, kind, 0), item)
    body.emit "ret #{ir_type(item)} #{value}"
  const state = [value_field(IterType(item)), value_field(int_type)]
  const kind = define_kind(ir, "take #{type_key(item)}", state, item, has_next, next)
  emit_iter ir, kind, [source, count]

# An owned array, Binary or Iter as an Iter to read from: an Iter of the array's or the Binary's
# items, or the Iter itself, whose traversal starts here.
export const emit_source_iter = (ir: IrBuilder, value: String, type: Type) ->
  return emit_sequence_iter(ir, value, type) if is_one_of_kinds(type, [ARRAY, 'Binary'])
  emit_iter_start ir, value
  value

export const is_iter_method = (type: Type, name: String) ->
  is_kind(type, ITER) or (is_kind(type, ARRAY) and name == 'take')

# A method of an Iter, or one of an array that makes an Iter (see is_iter_method). It takes over
# the object and the operands of the arguments, owned: an Iter it makes holds them.
export const call_iter_method = (
  ir: IrBuilder, name: String, object: String, type: Type, args: Array<String>
) ->
  const item = iterable_item(type)!
  const consume = (result: String) ->
    emit_release ir, object
    result
  case name
    when 'has_next'
      emit_mark_started ir, object
      consume emit_has_next(ir, object)
    when 'next'
      emit_mark_started ir, object
      consume emit_checked_next(ir, object, item)
    when 'take' then emit_take_iter(ir, emit_source_iter(ir, object, type), args[0], item)
    else throw "no Iter method #{name}"

# A comprehension's Iter: the items of the source for which the guard, if any, gives true, mapped
# by the element's function. The closures are owned, of functions of the item.
export const emit_comprehension_iter = (
  ir: IrBuilder, source: String, item: Type, guard: String?, element: String, element_type: Type
) ->
  const kept = guard then emit_filter_iter(ir, source, guard, item) else source
  emit_map_iter ir, kept, element, element_type
