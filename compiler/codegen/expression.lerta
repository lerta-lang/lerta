# Expressions. Each yields an IR operand; a reference-typed one is owned by the consumer.
import
  ArrayLiteral, Await, binary_literal_bytes, BinaryOperation, BooleanLiteral, Call, Case, Cast,
  Coalesce, Comprehension, Conditional, Expression, FloatLiteral, FunctionLiteral, Identifier, If,
  Index, IntegerLiteral, Interpolation, IsTest, Jump, MapLiteral, Member, NilLiteral, Node, Range,
  RecordLiteral, RegexLiteral, Return, StringLiteral, This, Throw, Try, TupleItem, TupleLiteral,
  UnaryOperation, Unwrap, Yield
from '../ast'
import generate_regex from './regex'
import TextPart from '../lexer/string_literal'
import generate_await from './awaiting'
import generate_call from './call'
import generate_case, generate_conditional, generate_if_value from './case'
import emit_function_closure from './closure'
import generate_array, generate_index, generate_map from './collection'
import generate_comprehension from './control_flow'
import emit_settling_closure, generate_closure from './function'
import generate_jump from './statement'
import function_reference_symbol, local_of from './references'
import Generator, located_value, SlotLocal, with_deferred_checks from './generator'
import emit_record, emit_value_at, emit_values from './heap_object'
import EnumValue from '../checker/member_targets'
import FunctionReference, LocalFunction, ScopedLocal, TopLevelValue from '../checker/references'
import boxes_member_into, is_value_type from '../checker/value_layout'
import emit_throw_error, generate_try, pop_temporaries, push_temporary from './exceptions'
import emit_interface_value from './interface'
import Itab from '../checker/interface_values'
import emit_adapter_iter from './iter'
import
  binary_constant, constant_operand, constructor_symbol, emit_release_value, ir_type,
  string_constant
from './lerta_ir'
import generate_binary, generate_coalesce, generate_unary, generate_unwrap from './operator'
import emit_is_present, emit_wrap, nil_constant from './optional'
import emit_concat from './string'
import scalar_literal from './scalar'
import emit_platform_member from './enum'
import generate_yield from './yielding'
import
  EnumType, inner_of, is_kind, IterType, ObjectType, OptionalType, settles_into, string_type, Type,
  UnionType
from '../types'
import generate_cast, generate_is_test from './cast'
import generate_property from './field'
import emit_box_value, read_local from './local'

# The type that the checker gave the node.
export type_of := (g: Generator, node: Node) -> g.facts.types[node] else panic('no type')

# Returns the IR operand holding the value, converted where it is used (an Int as an Int?, for
# example); void calls return ''.
export generate := (g: Generator, expression: Expression) ->
  target := conversion_of(g, expression)
  return nil_constant(g.code.program, target!) if expression is NilLiteral
  operand := generate_value(g, expression)
  return operand if target == nil
  source := type_of(g, expression)
  itab := g.facts.itabs[expression]

  # A value of a member's interface, made first, is what the union's box holds.
  if inner_of(target) is UnionType and itab != nil
    return emit_box_value(g.ir, emit_interface_value(g, operand, itab), itab.target)

  if boxes_member_into(g.code.program, source, target)
    return emit_box_value(g.ir, operand, source)
  if settles_into(source, target)
    closure := emit_settling_closure(g, operand, source, inner_of(target))
    return
      if target is OptionalType
        emit_wrap(g.ir, closure, inner_of(target))
      else
        closure
  unless itab
    return emit_wrap(g.ir, operand, wrapped_type(source, target))
  value := emit_interface_value(g, operand, itab)
  converted := inner_of(target)
  return value unless converted is IterType
  emit_adapter_iter(g.ir, value, itab.target, converted.item)

# The type that a value of the type `source` is wrapped as, converted to the optional type `target`:
# the target's inner type, which may be opaque where the source's is not (see emit_wrap).
wrapped_type := (source: Type, target: Type) ->
  target is OptionalType and target.inner == source then target.inner else source

# The type of the operand that `generate` returns: the type the expression is converted to, if
# it is.
export type_at_use := (g: Generator, expression: Expression) ->
  conversion_of(g, expression) else type_of(g, expression)

# The type that the expression is converted to where it is used, or the union it goes into, which
# holds it in a box if it is a value (see NodeFacts.boxings); nil if neither.
export conversion_of := (g: Generator, expression: Expression): Type? ->
  return converted if converted := g.facts.conversions[expression]
  boxed := g.facts.boxings[expression] else return nil
  if is_value_type(g.code.program, inner_of(type_of(g, expression)))
    boxed
  else
    nil

# An i1 for a condition: a Bool, or an optional value that holds when not nil.
export generate_condition := (g: Generator, expression: Expression) ->
  operand := generate(g, expression)
  type := type_of(g, expression)
  return operand unless type is OptionalType
  present := emit_is_present(g.ir, operand, type)
  release_if_reference g, expression, operand
  present

# A call typed `never` does not come back to the code after it, whether its check unwinds the
# exception that it returns with or it does not return at all.
export generate_call_ending_if_never := (g: Generator, call: Call) ->
  operand := generate_call(g, call)
  if is_kind(type_of(g, call), 'never')
    g.ir.emit 'unreachable'
    g.ir.start_unreachable()
  operand

# A call, which may be a leaf of a tree of float arithmetic (see float_tree), checks its arguments
# where it is called, as their values leave the tree; the trees in them are their own, whose roots
# leave the tree's way of checking as it was.
generate_call_in_tree := (g: Generator, call: Call) ->
  with_deferred_checks(g, false, -> generate_call_ending_if_never(g, call))

generate_value := (g: Generator, expression: Expression) ->
  located_value(g, expression.position, -> generate_node(g, replaced(g, expression)))

# What the checker replaced the expression with, through each replacement in turn, or the
# expression itself (see NodeFacts.replacements).
export replaced := (g: Generator, expression: Expression): Expression ->
  replacement := g.facts.replacements[expression] else return expression
  replaced(g, replacement)

generate_node := (g: Generator, expression: Expression): String ->
  return constant_operand(g.ir, constant) if constant := g.facts.constants[expression]
  case expression
    when NilLiteral then panic('nil is generated by generate, where it is converted')
    when RegexLiteral then generate_regex(g, expression)
    when Throw then generate_throw(g, expression)
    when Yield then generate_yield(g, expression)
    when Await then generate_await(g, expression)
    when Try then generate_try(g, expression)
    when Jump, Return
      generate_jump g, expression
      'poison'
    when IsTest then generate_is_test(g, expression)
    when Cast then generate_cast(g, expression)
    when This
      object := g.locals.lookup('@')!
      read_local(g, object, object.type)
    when Unwrap then generate_unwrap(g, expression)
    when Coalesce then generate_coalesce(g, expression)
    when StringLiteral
      return "#{index}" if index := g.facts.enum_literals[expression]
      return "#{expression.value.iter().next().to_int()}" if is_kind(type_of(g, expression), 'Char')
      string_constant(g.ir, expression.value)
    when Interpolation
      is_byte := is_kind(type_of(g, expression), 'Byte')
      return "#{binary_literal_bytes(expression)![0]}" if is_byte
      generate_interpolation(g, expression)
    when BooleanLiteral, FloatLiteral, IntegerLiteral
      scalar_literal(expression, type_of(g, expression))
    when Call then generate_call_in_tree(g, expression)
    when UnaryOperation then generate_unary(g, expression)
    when BinaryOperation then generate_binary(g, expression)
    when Case then generate_case(g, expression)
    when If then generate_if_value(g, expression)
    when Conditional then generate_conditional(g, expression)
    when Identifier then generate_identifier(g, expression)
    when Range then panic('ranges are only generated by for')
    when Member then generate_property(g, expression)
    when ArrayLiteral then generate_array(g, expression)
    when MapLiteral then generate_map(g, expression)
    when Comprehension then generate_comprehension(g, expression)
    when RecordLiteral
      fields := expression.fields
      emit := (operands: String[]) ->
        values := Map([(field.name.name, operand) for (field, operand) in fields.zip(operands)])
        emit_record(g.ir, type_of(g, expression), values)
      holding_all(g, [field.value for field in fields], emit)
    when TupleLiteral
      emit := (operands: String[]) -> emit_values(g.ir, type_of(g, expression), operands)
      holding_all(g, expression.items, emit)
    when TupleItem
      tuple := generate(g, expression.tuple)
      tuple_type := type_of(g, expression.tuple)
      item := emit_value_at(g.ir, tuple, tuple_type, expression.index)
      emit_release_value g.ir, tuple, tuple_type
      item
    when Index then generate_index(g, expression)
    when FunctionLiteral then generate_closure(g, expression)

generate_interpolation := (g: Generator, interpolation: Interpolation) ->
  only := interpolation.parts[0]
  return binary_constant(g.ir, only.bytes) if interpolation.parts.length == 1 and only is TextPart
  parts: String[]
  depth := g.temporaries.length
  for part in interpolation.parts
    operand :=
      case part
        when Call then generate_interpolated(g, part)
        when TextPart then binary_constant(g.ir, part.bytes)
    push_temporary g, operand, string_type
    parts.push operand
  pop_temporaries g, depth
  emit_concat(g.ir, parts)

# The text of the value, or a Binary as it is, which only a Binary literal takes (see
# check_interpolated).
generate_interpolated := (g: Generator, part: Call) ->
  return generate(g, part) unless is_kind(type_of(g, part), 'Binary')
  generate(g, (part.callee as Member!).object)

# Generates the expressions in order, each held while the later ones are evaluated, which may
# throw, and gives their operands to `use`; they are let go of after it. Unlike `holding`, it
# generates what it holds, so it lives here, beside `generate`.
export holding_all := (g: Generator, expressions: Expression[], use: (String[]) -> String) ->
  depth := g.temporaries.length
  operands := [
    for expression in expressions
      operand := generate(g, expression)
      push_temporary g, operand, type_at_use(g, expression)
      operand
  ]
  result := use(operands)
  pop_temporaries g, depth
  result

export release_if_reference := (g: Generator, expression: Expression, operand: String) ->
  emit_release_value g.ir, operand, type_at_use(g, expression)

# A local's value, a member of an enum, or a top-level function's closure (see
# emit_function_closure).
generate_identifier := (g: Generator, identifier: Identifier) ->
  if name := g.facts.intrinsic_values[identifier]
    return intrinsic_value(g, identifier, name)
  reference := g.facts.references[identifier]!
  type := type_of(g, identifier)
  case reference
    when EnumValue then "#{reference.index}"
    when FunctionReference
      emit_function_closure(g.ir, function_reference_symbol(g, reference), type)
    when ScopedLocal, TopLevelValue then read_local(g, local_of(g, identifier), type)
    when LocalFunction then generate_closure(g, reference.literal)
    # A C function can only be called, and generate_named_call generates the callee of a
    # construction or of Map or Set.
    else panic("no value for '#{identifier.name}'")

# The value of the build that the intrinsic value gives (see VALUE_INTRINSICS).
intrinsic_value := (g: Generator, identifier: Identifier, name: String) ->
  case name
    when 'optimized'
      g.code.optimized then 'true' else 'false'
    # The member of Platform that the target's system names, by its place; read where the code
    # runs, in a build for no target, as the seed's code is, which builds on every system.
    when 'platform'
      type := type_of(g, identifier) as EnumType!
      system := g.code.system else return emit_platform_member(g.ir, type)
      "#{type.members.index_of({ text: system, is_name: false }) else panic('no such system')}"
    else panic("no intrinsic value '#{name}'")

# The Error becomes the exception (see exceptions).
# An AssertionError of the message, a String, which its constructor takes owned.
generate_assertion_throw := (g: Generator, message: Expression) ->
  is_assertion_error := (itab: Itab) -> (itab.type as ObjectType!).name == 'AssertionError'
  itab := g.code.program.runtime_errors.find(is_assertion_error)!
  text := generate(g, message)
  type := itab.type as ObjectType!
  error :=
    g.ir.assign("call #{ir_type(g.code.program, type)} #{constructor_symbol(type)}(ptr #{text})")
  emit_throw_error(g, emit_interface_value(g, error, itab), false)

generate_throw := (g: Generator, throw_expression: Throw) ->
  message := throw_expression.message
  return generate_assertion_throw(g, message) if throw_expression.assertion
  local := message is Identifier then local_of(g, message)
  rethrows := local is SlotLocal and local.caught
  emit_throw_error(g, generate(g, message), rethrows)
