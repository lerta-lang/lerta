# Expressions. Each yields an IR operand; a reference-typed one is owned by the consumer.
import
  ArrayLiteral, Await, BinaryOperation, BooleanLiteral, Call, Case, Cast, Coalesce, Comprehension,
  Conditional, Expression, FloatLiteral, FunctionLiteral, Identifier, If, Index, IntegerLiteral,
  Interpolation, IsTest, Jump, MapLiteral, Member, NamedType, NilLiteral, Node, Range,
  RecordLiteral, Return, StringLiteral, This, Throw, Try, TupleItem, TupleLiteral, UnaryOperation,
  Unwrap, Yield
from '../ast'
import integer_float_text from '../float_literals'
import TextPart from '../lexer/string_literal'
import emit_length from './array'
import generate_await from './awaiting'
import float_constant from './float'
import generate_call from './call'
import generate_case, generate_conditional, generate_if_value from './case'
import emit_function_closure from './closure'
import generate_array, generate_index, generate_map from './collection'
import generate_comprehension from './control_flow'
import generate_closure, generate_jump from './function'
import function_reference_symbol, local_of from './references'
import CodegenLocal, Generator, locate, SlotLocal, ValueLocal from './generator'
import
  emit_field_pointer, emit_member_dispatch, emit_record, emit_record_field, emit_type_test,
  emit_value_at, emit_values, emit_weak_object, field_named, record_field_index
from './heap_object'
import
  EnumParse, EnumValue, InterfaceProperty, Method, Property, PropertyKind
from '../checker/member_targets'
import FunctionReference, ScopedLocal, TopLevelValue from '../checker/references'
import info_of from '../checker/object_types'
import
  emit_throw_error, generate_try, holding, pop_temporaries, push_temporary, while_holding
from './exceptions'
import emit_interface_read, emit_interface_value from './interface'
import emit_box, emit_unbox from './boxes'
import emit_branch, IrBuilder from './ir_builder'
import emit_adapter_iter from './iter'
import
  emit_release, emit_release_value, emit_retain, emit_retain_value, ir_type, string_constant
from './lerta_ir'
import emit_map_length from './map'
import generate_binary, generate_coalesce, generate_unary, generate_unwrap from './operator'
import emit_is_present, emit_present_test, emit_unwrap, emit_wrap, nil_constant from './optional'
import emit_binary_length, emit_concat from './string'
import DEAD_OBJECT, FAILED_CAST, throw_if from './runtime_errors'
import emit_initialized_check from './top_level'
import generate_yield from './yielding'
import
  boxes_into, inner_of, InterfaceType, is_boxed, is_float, is_kind, IterType, ObjectType,
  optional_type, OptionalType, RecordType, string_type, Type, UnionType
from '../types'

# The type that the checker gave the node.
export const type_of = (g: Generator, node: Node) -> g.facts.types[node] ? panic('no type')

# Returns the IR operand holding the value, converted where it is used (an Int as an Int?, for
# example); void calls return ''.
export const generate = (g: Generator, expression: Expression) ->
  const target = g.facts.conversions[expression]
  return nil_constant(target!) if expression is NilLiteral
  const operand = generate_value(g, expression)
  return operand if target == nil
  const source = type_of(g, expression)
  return emit_box_value(g.ir, operand, source) if boxes_into(source, target)
  const itab = g.facts.itabs[expression] ? return emit_wrap(g.ir, operand, type_of(g, expression))
  const value = emit_interface_value(g, operand, itab)
  const converted = inner_of(target)
  return value if converted is not IterType
  emit_adapter_iter g.ir, value, itab.target, converted.item

# The type of the operand that `generate` returns: the type the expression is converted to, if
# it is.
export const type_at_use = (g: Generator, expression: Expression) ->
  g.facts.conversions[expression] ? type_of(g, expression)

# An i1 for a condition: a Bool, or an optional value that holds when not nil (a Bool? holds
# when it is true).
export const generate_condition = (g: Generator, expression: Expression) ->
  const operand = generate(g, expression)
  const type = type_of(g, expression)
  return operand if type is not OptionalType
  const present = emit_is_present(g.ir, operand, type)
  release_if_reference g, expression, operand
  return present if not is_kind(type.inner, 'Bool')
  const value = emit_unwrap(g.ir, operand, type)
  g.ir.assign "and i1 #{present}, #{value}"

const generate_value = (g: Generator, expression: Expression) ->
  const outer = g.position
  locate g, expression.position
  const value = generate_node(g, expression)
  locate g, outer
  value

const generate_node = (g: Generator, expression: Expression): String ->
  case expression
    when NilLiteral then panic('nil is generated by generate, where it is converted')
    when Throw then generate_throw(g, expression)
    when Yield then generate_yield(g, expression)
    when Await then generate_await(g, expression)
    when Try then generate_try(g, expression)
    when Jump
      generate_jump g, expression
      'poison'
    when Return
      generate_jump g, expression
      'poison'
    when IsTest then generate_is_test(g, expression)
    when Cast then generate_cast(g, expression)
    when This
      const object = g.locals.lookup('@')!
      read_local g, object, object.type
    when Unwrap then generate_unwrap(g, expression)
    when Coalesce then generate_coalesce(g, expression)
    when StringLiteral
      return "#{index}" if const index = g.facts.enum_literals[expression]
      return "#{expression.value.binary[0]}" if is_kind(type_of(g, expression), 'Byte')
      return "#{expression.value.iter().next().to_int()}" if is_kind(type_of(g, expression), 'Char')
      string_constant g.ir, expression.value
    when Interpolation then generate_interpolation(g, expression)
    when IntegerLiteral
      const type = type_of(g, expression)
      return float_constant(integer_float_text(expression), type) if is_float(type)
      "#{expression.value!}"
    when FloatLiteral then float_constant(expression.text, type_of(g, expression))
    when BooleanLiteral then "#{expression.value}"
    when Call then generate_call(g, expression)
    when UnaryOperation then generate_unary(g, expression)
    when BinaryOperation then generate_binary(g, expression)
    when Case then generate_case(g, expression)
    when If then generate_if_value(g, expression)
    when Conditional then generate_conditional(g, expression)
    when Identifier then generate_identifier(g, expression)
    when Range then panic('ranges are only generated by for')
    when Member
      return generate(g, name) if const name = g.facts.qualified[expression]
      generate_property g, expression
    when ArrayLiteral then generate_array(g, expression)
    when MapLiteral then generate_map(g, expression)
    when Comprehension then generate_comprehension(g, expression)
    when RecordLiteral
      const fields = expression.fields
      const emit = (operands: String[]) ->
        const values = Map<String, String>()
        values[field.name.name] = operand for (field, operand) in fields.zip(operands)
        emit_record g.ir, type_of(g, expression), values
      holding_all g, [field.value for field in fields], emit
    when TupleLiteral
      const emit = (operands: String[]) -> emit_values(g.ir, type_of(g, expression), operands)
      holding_all g, expression.items, emit
    when TupleItem
      const tuple = generate(g, expression.tuple)
      const item = emit_value_at(g.ir, tuple, type_of(g, expression.tuple), expression.index)
      emit_release g.ir, tuple
      item
    when Index then generate_index(g, expression)
    when FunctionLiteral then generate_closure(g, expression)

const generate_is_test = (g: Generator, test: IsTest) ->
  const object = generate(g, test.value)
  const result = emit_member_test(g, object, test.value, test.type)
  emit_release g.ir, object
  result

# The object if it holds the type, and otherwise nil, or a throw.
const generate_cast = (g: Generator, cast: Cast) ->
  const ir = g.ir
  const object = generate(g, cast.value)
  const holds = emit_member_test(g, object, cast.value, cast.type)
  const member = type_of(g, cast.type)
  if cast.throws
    const fails = ir.assign("xor i1 #{holds}, true")
    while_holding g, object, type_of(g, cast.value), -> throw_if(g, fails, FAILED_CAST)
    return object if not is_boxed(member)
    return emit_narrowed_owned(ir, object, type_of(g, cast.value), member)
  if is_boxed(member)
    const optional = optional_type(member)
    const value = -> emit_wrap(ir, emit_unbox(ir, object, member), member)
    const result = emit_branch(ir, ir_type(optional), holds, value, nil_constant(optional))
    emit_retain_value ir, result, optional
    emit_release ir, object
    return result
  const result = ir.assign("select i1 #{holds}, ptr #{object}, ptr null")
  emit_retain ir, result
  emit_release ir, object
  result

# An i1: whether the object, the value of a union type, optional or not, holds the type.
const emit_member_test = (g: Generator, object: String, value: Expression, type_name: NamedType) ->
  const value_type = type_of(g, value)
  const type = type_of(g, type_name)
  const test_of = (each: String) -> emit_type_test(g.ir, each, type)
  return test_of(object) if value_type is not OptionalType
  emit_present_test g.ir, object, value_type, test_of

# A field's value, of a class, a struct or an anonymous struct; the object is released, and the
# value retained.
const read_field = (g: Generator, object: String, type: Type, name: String) ->
  const ir = g.ir
  if type is RecordType
    const value = emit_record_field(ir, object, type, name)
    emit_release ir, object
    return value
  const object_type = type as ObjectType!
  const info = info_of(g.code.program, object_type)
  const field = field_named(info, name)
  const field_type = field.type!
  const pointer = emit_field_pointer(ir, object, info, name)
  const loaded = ir.assign("load #{ir_type(field_type)}, ptr #{pointer}")
  # The object is held while its `weak!` field is checked; a `weak` one gives nil once its object is
  # gone.
  const read_weak = -> weak_object(g, loaded)
  const value =
    case
      when not field.weak then loaded
      when field_type is OptionalType then emit_weak_object(ir, loaded)
      else holding(g, object, object_type, read_weak)
  emit_retain_value ir, value, field_type
  emit_release ir, object
  value

# A field of a class, a struct or an anonymous struct, or one that every member of a union has.
export const read_any_field = (
  g: Generator, object: String, object_type: Type, name: String, field_type: Type
) ->
  return read_field(g, object, object_type, name) if object_type is not UnionType
  const of_member = (type: Type) -> read_field(g, object, type, name)
  emit_member_dispatch g.ir, object, object_type.members, ir_type(field_type), of_member

# The object that a `weak!` field's box holds, borrowed; it throws if the object is gone.
const weak_object = (g: Generator, box: String) ->
  const object = emit_weak_object(g.ir, box)
  throw_if g, g.ir.assign("icmp eq ptr #{object}, null"), DEAD_OBJECT
  object

# `E.MEMBER` is a member of an enum.
const generate_property = (g: Generator, member: Member) ->
  const target = g.facts.members[member]!
  return "#{target.index}" if target is EnumValue
  const object = generate(g, member.object)
  const object_type = type_of(g, member.object)
  const name = member.name.name
  const type = type_of(g, member)
  const value =
    case target
      when Property then read_property(g, object, object_type, target.kind, name, type)
      when InterfaceProperty
        emit_interface_read g, object, object_type as InterfaceType!, target.index, type
      when Method, EnumParse then panic('a method must be called')
      when EnumValue then panic('an enum value is read before its object')
  # A field narrowed where it is read (see checker narrowable FieldPath).
  const field_type = declared_field_type(g, object_type, name) ? return value
  emit_narrowed_owned g.ir, value, field_type, type

const declared_field_type = (g: Generator, object_type: Type, name: String) ->
  case object_type
    when RecordType then object_type.fields[record_field_index(object_type, name)].type
    when ObjectType then field_named(info_of(g.code.program, object_type), name).type
    else nil

# The property of the object, which is owned and released: a field, or a property of a builtin
# type. `s.binary` is the string itself, passing on its ownership; `length` borrows its object.
export const read_property = (
  g: Generator, object: String, object_type: Type, kind: PropertyKind, name: String, type: Type
) ->
  const ir = g.ir
  case kind
    when FIELD then read_any_field(g, object, object_type, name, type)
    when STRING_BINARY then object
    when ARRAY_LENGTH then released(ir, object, emit_length(ir, object))
    when MAP_LENGTH then released(ir, object, emit_map_length(ir, object))
    when BINARY_LENGTH then released(ir, object, emit_binary_length(ir, object))

const released = (ir: IrBuilder, object: String, value: String) ->
  emit_release ir, object
  value

const generate_interpolation = (g: Generator, interpolation: Interpolation) ->
  const parts: String[] = []
  const depth = g.temporaries.length
  for part in interpolation.parts
    const operand =
      case part
        when Call then generate(g, part)
        when TextPart then string_constant(g.ir, part.text)
    push_temporary g, operand, string_type
    parts.push operand
  pop_temporaries g, depth
  emit_concat g.ir, parts

# Generates the expressions in order, each held while the later ones are evaluated, which may
# throw, and gives their operands to `use`; they are let go of after it. Unlike `holding`, it
# generates what it holds, so it lives here, beside `generate`.
export const holding_all = (g: Generator, expressions: Expression[], use: (String[]) -> String) ->
  const depth = g.temporaries.length
  const operands: String[] = []
  for expression in expressions
    const operand = generate(g, expression)
    push_temporary g, operand, type_at_use(g, expression)
    operands.push operand
  const result = use(operands)
  pop_temporaries g, depth
  result

export const release_if_reference = (g: Generator, expression: Expression, operand: String) ->
  emit_release_value g.ir, operand, type_at_use(g, expression)

# A local's value, a member of an enum, or a top-level function's closure (see
# emit_function_closure).
const generate_identifier = (g: Generator, identifier: Identifier) ->
  const reference = g.facts.references[identifier]!
  const type = type_of(g, identifier)
  case reference
    when EnumValue then "#{reference.index}"
    when FunctionReference
      emit_function_closure g.ir, function_reference_symbol(g, reference), type
    when ScopedLocal, TopLevelValue then read_local(g, local_of(g, identifier), type)
    # A C function can only be called, and generate_named_call generates the callee of a
    # construction or of Map or Set.
    else panic("no value for '#{identifier.name}'")

# The value of the expression and whether it is owned: borrowed when it is a local whose scope
# keeps the value for as long as its consumer uses it, so that using an array in a loop retains and
# releases nothing (see docs/internals.md#memory-management); owned otherwise.
export const generate_borrowed = (g: Generator, expression: Expression) ->
  if expression is Identifier and g.facts.references[expression] is ScopedLocal
    const local = local_of(g, expression)
    const can_go = local.weak or (local is SlotLocal and local.is_var)
    return (read_borrowed(g, local, type_of(g, expression)), false) if not can_go
  (generate(g, expression), true)

# The slot's pointer, once a top-level value is known to be initialized.
export const slot_pointer = (g: Generator, local: SlotLocal) ->
  if const top_level = local.top_level
    emit_initialized_check g, top_level.global if top_level.is_checked
  local.pointer

# The local's value, retained if a reference, as the type it has where it is read: without nil
# where it is narrowed.
export const read_local = (g: Generator, local: CodegenLocal, type: Type) ->
  const value = read_borrowed(g, local, type)
  emit_retain_value g.ir, value, type
  value

# The local's value, borrowed, as read_local reads it.
const read_borrowed = (g: Generator, local: CodegenLocal, type: Type) ->
  const ir = g.ir
  const held = held_value(g, local)
  # A weak local's object, which may be gone, is never narrowed.
  const value = local.weak then emit_weak_object(ir, held) else held
  emit_narrowed ir, value, local.type, type

# What the local holds, borrowed: its value, or a weak local's box.
export const held_value = (g: Generator, local: CodegenLocal) ->
  case local
    when SlotLocal then g.ir.assign("load #{ir_type(local.type)}, ptr #{slot_pointer(g, local)}")
    when ValueLocal then local.operand

# The value of the declared type as the narrower one where it is narrowed: without nil, or as one
# member of its union, out of its box if the union holds one; borrowed as `value` is.
const emit_narrowed = (ir: IrBuilder, value: String, declared: Type, type: Type) ->
  if not is_boxed_narrowing(declared, type)
    const present = declared is OptionalType and type is not OptionalType
    return present then emit_unwrap(ir, value, declared) else value
  # A union value is a pointer, null for nil, whether optional or not.
  return emit_unbox(ir, value, type) if type is not OptionalType
  const member = -> emit_wrap(ir, emit_unbox(ir, value, type.inner), type.inner)
  emit_branch ir, ir_type(type), ir.assign("icmp ne ptr #{value}, null"), member, nil_constant(type)

# As emit_narrowed, of a value that is owned and given over.
const emit_narrowed_owned = (ir: IrBuilder, value: String, declared: Type, type: Type) ->
  return emit_narrowed(ir, value, declared, type) if not is_boxed_narrowing(declared, type)
  const narrowed = emit_narrowed(ir, value, declared, type)
  emit_retain_value ir, narrowed, type
  emit_release ir, value
  narrowed

# Whether the value of the union narrowed to the type, one member, optional or not, is in a box.
const is_boxed_narrowing = (declared: Type, type: Type) ->
  inner_of(declared) is UnionType and is_boxed(inner_of(type))

# A box of the value, owned, for a union, and of a T? a box or null.
const emit_box_value = (ir: IrBuilder, value: String, type: Type) ->
  return emit_box(ir, value, type) if type is not OptionalType
  const box = -> emit_box(ir, emit_unwrap(ir, value, type), type.inner)
  emit_branch ir, 'ptr', emit_is_present(ir, value, type), box, 'null'

# The Error becomes the exception (see exceptions).
const generate_throw = (g: Generator, throw_expression: Throw) ->
  const message = throw_expression.message
  const local = message is Identifier then local_of(g, message)
  const rethrows = local is SlotLocal and local.caught
  emit_throw_error g, generate(g, message), rethrows
