# Expressions. Each yields an IR operand; a reference-typed one is owned by the consumer.
import {
  ArrayLiteral, BinaryOperation, BooleanLiteral, Call, Case, Coalesce, Comprehension, Conditional
  Expression, FunctionLiteral, Identifier, Index, IntegerLiteral, Interpolation, IsTest, Jump
  MapLiteral, Member, NilLiteral, Node, Range, RecordLiteral, Return, StringLiteral, This, Throw
  UnaryOperation, Unwrap
} from '../ast'
import { TextPart } from '../lexer/string_literal'
import { emit_length } from './array'
import { generate_call } from './call'
import { generate_case, generate_conditional } from './case'
import { emit_function_closure } from './closure'
import { generate_array, generate_index, generate_map } from './collection'
import { generate_comprehension } from './control_flow'
import { generate_closure, generate_jump, lookup_local } from './function'
import { CodegenLocal, Generator, SlotLocal, ValueLocal } from './generator'
import {
  emit_field_pointer, emit_member_dispatch, emit_present_type_test, emit_record, emit_record_field
  emit_type_test
} from './heap_object'
import { info_of } from '../checker/object_types'
import { IrBuilder } from './ir_builder'
import { emit_release, emit_retain, ir_type, string_constant } from './lerta_ir'
import { emit_map_length } from './map'
import {
  generate_binary, generate_coalesce, generate_unary, generate_unwrap
} from './operator'
import { emit_is_present, emit_unwrap, emit_wrap, nil_constant } from './optional'
import { emit_throw, emit_unreachable } from './runtime_calls'
import { emit_binary_length, emit_concat } from './string'
import { emit_initialized_check } from './top_level'
import {
  is_kind, is_reference_type, kind_of, ObjectType, OptionalType, RecordType, Type, UnionType
} from '../types'

# The type that the checker gave the node.
export const type_of = (g: Generator, node: Node) -> g.code.shared.types[node] ? throw 'no type'

# Returns the IR operand holding the value, converted where it is used (an Int as an Int?, for
# example); void calls return ''.
export const generate = (g: Generator, expression: Expression) ->
  const target = g.code.shared.conversions[expression]
  return nil_constant(target!) if expression is NilLiteral
  const operand = generate_value(g, expression)
  return operand if target == nil
  emit_wrap g.ir, operand, type_of(g, expression)

# The type of the operand that `generate` returns: the type the expression is converted to, if
# it is.
export const type_at_use = (g: Generator, expression: Expression) ->
  g.code.shared.conversions[expression] ? type_of(g, expression)

# An i1 for a condition: a Bool, or an optional value that holds when not nil (a Bool? holds
# when it is true).
export const generate_condition = (g: Generator, expression: Expression) ->
  const operand = generate(g, expression)
  const type = type_of(g, expression)
  return operand if not (type is OptionalType)
  const present = emit_is_present(g.ir, operand, type)
  release_if_reference g, expression, operand
  return present if not is_kind(type.inner, BOOL)
  const value = emit_unwrap(g.ir, operand, type)
  g.ir.assign "and i1 #{present}, #{value}"

const generate_value = (g: Generator, expression: Expression): String ->
  case expression
    when NilLiteral then throw 'nil is generated by generate, where it is converted'
    when Throw then generate_throw(g, expression)
    when Jump
      generate_jump g, expression
      'poison'
    when Return
      generate_jump g, expression
      'poison'
    when IsTest then generate_is_test(g, expression)
    when This
      const object = lookup_local(g, '@')!
      read_local g, object, object.type
    when Unwrap then generate_unwrap(g, expression)
    when Coalesce then generate_coalesce(g, expression)
    when StringLiteral
      if const index = g.code.shared.enum_values[expression]
        return "#{index}"
      return "#{expression.value.binary[0]}" if is_kind(type_of(g, expression), BYTE)
      string_constant g.ir, expression.value
    when Interpolation then generate_interpolation(g, expression)
    when IntegerLiteral then "#{expression.value}"
    when BooleanLiteral then "#{expression.value}"
    when Call then generate_call(g, expression)
    when UnaryOperation then generate_unary(g, expression)
    when BinaryOperation then generate_binary(g, expression)
    when Case then generate_case(g, expression)
    when Conditional then generate_conditional(g, expression)
    when Identifier then generate_identifier(g, expression)
    when Range then throw 'ranges are only generated by for'
    when Member then generate_property(g, expression)
    when ArrayLiteral then generate_array(g, expression)
    when MapLiteral then generate_map(g, expression)
    when Comprehension then generate_comprehension(g, expression)
    when RecordLiteral
      const values: Map<String, String> = Map()
      values[field.name.name] = generate(g, field.value) for field in expression.fields
      emit_record g.ir, type_of(g, expression), values
    when Index then generate_index(g, expression)
    when FunctionLiteral then generate_closure(g, expression)

const generate_is_test = (g: Generator, test: IsTest) ->
  const object = generate(g, test.value)
  const is_optional = type_of(g, test.value) is OptionalType
  const test_of = is_optional then emit_present_type_test else emit_type_test
  const result = test_of(g.ir, object, type_of(g, test.type))
  emit_release g.ir, object
  result

# A field's value, of a class, a struct or an anonymous struct; the object is released, and the
# value retained, since every expression yields an owned reference.
export const read_field = (g: Generator, object: String, type: Type, name: String) ->
  const ir = g.ir
  if type is RecordType
    const value = emit_record_field(ir, object, type, name)
    emit_release ir, object
    return value
  const object_type = type is ObjectType then type else throw 'expected a class or struct type'
  const info = info_of(g.code.program, object_type)
  const field_type = info.fields.find((field) -> field.name.name == name)!.type!
  const pointer = emit_field_pointer(ir, object, info, name)
  const value = ir.assign("load #{ir_type(field_type)}, ptr #{pointer}")
  emit_retain ir, value if is_reference_type(field_type)
  emit_release ir, object
  value

# `s.binary` is the string itself, passing on its ownership; `length` borrows its object. `E.MEMBER`
# is a member of an enum.
const generate_property = (g: Generator, member: Member) ->
  if const index = g.code.shared.enum_values[member]
    return "#{index}"
  const ir = g.ir
  const object = generate(g, member.object)
  const object_type = type_of(g, member.object)
  const name = member.name.name
  if object_type is UnionType
    const of_member = (type: Type) -> read_field(g, object, type, name)
    const result_type = ir_type(type_of(g, member))
    return emit_member_dispatch(ir, object, object_type.members, result_type, of_member)
  const length = case kind_of(object_type)
    when OBJECT, RECORD then return read_field(g, object, object_type, name)
    when STRING then return object
    when BINARY then emit_binary_length(ir, object)
    when MAP then emit_map_length(ir, object)
    else emit_length(ir, object)
  emit_release ir, object
  length

const generate_interpolation = (g: Generator, interpolation: Interpolation) ->
  const parts: Array<String> = []
  for part in interpolation.parts
    const operand = case part
      when Call then generate(g, part)
      when TextPart then string_constant(g.ir, part.text)
    parts.push operand
  emit_concat g.ir, parts

# Every expression of a reference type yields an owned reference, which its consumer releases.
export const release_if_reference = (g: Generator, expression: Expression, operand: String) ->
  emit_release g.ir, operand if is_reference_type(type_at_use(g, expression))

# A local's value, a member of an enum, or a top-level function's closure (see
# emit_function_closure).
const generate_identifier = (g: Generator, identifier: Identifier) ->
  if const index = g.code.shared.enum_values[identifier]
    return "#{index}"
  const name = identifier.name
  const local = lookup_local(g, name)
  if local == nil
    if const symbol = g.code.symbols[name]
      return emit_function_closure(g.ir, symbol, type_of(g, identifier))
  # The checker allows no other name as a value: a C function can only be called.
  const found = local ? throw "no value for '#{name}'"
  read_local g, found, type_of(g, identifier)

# The slot's pointer, once a top-level value is known to be initialized.
export const slot_pointer = (ir: IrBuilder, local: SlotLocal) ->
  if const top_level = local.top_level
    emit_initialized_check ir, top_level.global if top_level.is_checked
  local.pointer

# The local's value, retained if a reference, as the type it has where it is read: without nil
# where it is narrowed. Reading a reference retains it, since every expression yields an owned
# reference.
export const read_local = (g: Generator, local: CodegenLocal, type: Type) ->
  const ir = g.ir
  const value = case local
    when SlotLocal then ir.assign("load #{ir_type(local.type)}, ptr #{slot_pointer(ir, local)}")
    when ValueLocal then local.operand
  emit_retain ir, value if is_reference_type(local.type)
  const is_narrowed = local.type is OptionalType and not (type is OptionalType)
  is_narrowed then emit_unwrap(ir, value, local.type) else value

const generate_throw = (g: Generator, throw_expression: Throw) ->
  const message = generate(g, throw_expression.message)
  emit_throw g.ir, message
  emit_unreachable g.ir
  'poison'
