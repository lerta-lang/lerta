# Expressions. Each yields an IR operand; a reference-typed one is owned by the consumer.
import
  ArrayLiteral, Await, BinaryOperation, BooleanLiteral, Call, Case, Cast, Coalesce, Comprehension,
  Conditional, Expression, FloatLiteral, FunctionLiteral, Identifier, If, Index, IntegerLiteral,
  Interpolation, IsTest, Jump, MapLiteral, Member, NilLiteral, Node, Range, RecordLiteral, Return,
  StringLiteral, This, Throw, Try, TupleItem, TupleLiteral, TypeName, UnaryOperation, Unwrap, Yield
from '../ast'
import integer_float_text from '../float_literals'
import TextPart from '../lexer/string_literal'
import field_tag, top_level_tag from './alias_tags'
import emit_length from './array'
import generate_await from './awaiting'
import generate_borrowed from './borrowing'
import emit_nan_check, float_constant from './float'
import generate_call from './call'
import generate_case, generate_conditional, generate_if_value from './case'
import emit_function_closure from './closure'
import generate_array, generate_index, generate_map from './collection'
import generate_comprehension from './control_flow'
import emit_settling_closure, generate_closure, generate_jump from './function'
import function_reference_symbol, local_of from './references'
import CodegenLocal, Generator, locate, SlotLocal, ValueLocal from './generator'
import
  emit_field_pointer, emit_member_dispatch, emit_record, emit_record_field, emit_type_test,
  emit_value_at, emit_values, emit_weak_object, field_named, record_field_index
from './heap_object'
import
  EnumParse, EnumValue, InterfaceProperty, Method, Property, PropertyKind
from '../checker/member_targets'
import FunctionReference, ScopedLocal, TopLevelValue from '../checker/references'
import info_of from '../checker/object_types'
import
  emit_throw_error, generate_try, holding, pop_temporaries, push_temporary, while_holding
from './exceptions'
import emit_interface_read, emit_interface_value from './interface'
import emit_box, emit_unbox from './boxes'
import emit_branch, IrBuilder from './ir_builder'
import emit_adapter_iter from './iter'
import
  emit_release, emit_release_value, emit_retain, emit_retain_value, ir_type, string_constant
from './lerta_ir'
import emit_map_length from './map'
import generate_binary, generate_coalesce, generate_unary, generate_unwrap from './operator'
import
  emit_is_nil, emit_is_present, emit_present_test, emit_unwrap, emit_wrap, nil_constant
from './optional'
import emit_binary_length, emit_concat from './string'
import DEAD_OBJECT, FAILED_CAST, throw_if from './runtime_errors'
import emit_initialized_check from './top_level'
import generate_yield from './yielding'
import
  boxes_into, inner_of, InterfaceType, is_assignable, is_boxed, is_float, is_kind, IterType,
  ObjectType, optional_type, OptionalType, RecordType, settles_into, string_type, Type, UnionType
from '../types'

# The type that the checker gave the node.
export type_of := (g: Generator, node: Node) -> g.facts.types[node] ? panic('no type')

# Returns the IR operand holding the value, converted where it is used (an Int as an Int?, for
# example); void calls return ''.
export generate := (g: Generator, expression: Expression) ->
  target := g.facts.conversions[expression]
  return nil_constant(target!) if expression is NilLiteral
  operand := generate_value(g, expression)
  return operand if target == nil
  source := type_of(g, expression)
  itab := g.facts.itabs[expression]
  # A value of a member's interface, made first, is what the union's box holds.
  if inner_of(target) is UnionType and itab != nil
    return emit_box_value(g.ir, emit_interface_value(g, operand, itab), itab.target)
  return emit_box_value(g.ir, operand, source) if boxes_into(source, target)
  if settles_into(source, target)
    closure := emit_settling_closure(g, operand, source, inner_of(target))
    return target is OptionalType then emit_wrap(g.ir, closure, inner_of(target)) else closure
  return emit_wrap(g.ir, operand, type_of(g, expression)) if not itab
  value := emit_interface_value(g, operand, itab)
  converted := inner_of(target)
  return value if converted is not IterType
  emit_adapter_iter g.ir, value, itab.target, converted.item

# The type of the operand that `generate` returns: the type the expression is converted to, if
# it is.
export type_at_use := (g: Generator, expression: Expression) ->
  g.facts.conversions[expression] ? type_of(g, expression)

# An i1 for a condition: a Bool, or an optional value that holds when not nil (a Bool? holds
# when it is true).
export generate_condition := (g: Generator, expression: Expression) ->
  operand := generate(g, expression)
  type := type_of(g, expression)
  return operand if type is not OptionalType
  present := emit_is_present(g.ir, operand, type)
  release_if_reference g, expression, operand
  return present if not is_kind(type.inner, 'Bool')
  value := emit_unwrap(g.ir, operand, type)
  g.ir.assign "and i1 #{present}, #{value}"

# A call typed `never` does not come back to the code after it, whether its check unwinds the
# exception that it returns with or it does not return at all.
generate_call_ending_if_never := (g: Generator, call: Call) ->
  operand := generate_call(g, call)
  if is_kind(type_of(g, call), 'never')
    g.ir.emit 'unreachable'
    g.ir.start_unreachable()
  operand

generate_value := (g: Generator, expression: Expression) ->
  outer := g.position
  locate g, expression.position
  value := generate_node(g, replaced(g, expression))
  locate g, outer
  value

# What the checker replaced the expression with, through each replacement in turn, or the
# expression itself (see NodeFacts.replacements).
replaced := (g: Generator, expression: Expression): Expression ->
  replacement := g.facts.replacements[expression] ? return expression
  replaced g, replacement

generate_node := (g: Generator, expression: Expression): String ->
  case expression
    when NilLiteral then panic('nil is generated by generate, where it is converted')
    when Throw then generate_throw(g, expression)
    when Yield then generate_yield(g, expression)
    when Await then generate_await(g, expression)
    when Try then generate_try(g, expression)
    when Jump, Return
      generate_jump g, expression
      'poison'
    when IsTest then generate_is_test(g, expression)
    when Cast then generate_cast(g, expression)
    when This
      object := g.locals.lookup('@')!
      read_local g, object, object.type
    when Unwrap then generate_unwrap(g, expression)
    when Coalesce then generate_coalesce(g, expression)
    when StringLiteral
      return "#{index}" if index := g.facts.enum_literals[expression]
      return "#{expression.value.binary[0]}" if is_kind(type_of(g, expression), 'Byte')
      return "#{expression.value.iter().next().to_int()}" if is_kind(type_of(g, expression), 'Char')
      string_constant g.ir, expression.value
    when Interpolation then generate_interpolation(g, expression)
    when IntegerLiteral
      type := type_of(g, expression)
      return float_constant(integer_float_text(expression), type) if is_float(type)
      "#{expression.value!}"
    when FloatLiteral then float_constant(expression.text, type_of(g, expression))
    when BooleanLiteral then "#{expression.value}"
    when Call then generate_call_in_tree(g, expression)
    when UnaryOperation then generate_unary(g, expression)
    when BinaryOperation then generate_binary(g, expression)
    when Case then generate_case(g, expression)
    when If then generate_if_value(g, expression)
    when Conditional then generate_conditional(g, expression)
    when Identifier then generate_identifier(g, expression)
    when Range then panic('ranges are only generated by for')
    when Member then generate_property(g, expression)
    when ArrayLiteral then generate_array(g, expression)
    when MapLiteral then generate_map(g, expression)
    when Comprehension then generate_comprehension(g, expression)
    when RecordLiteral
      fields := expression.fields
      emit := (operands: String[]) ->
        values: Map<String, String>
        values[field.name.name] = operand for (field, operand) in fields.zip(operands)
        emit_record g.ir, type_of(g, expression), values
      holding_all g, [field.value for field in fields], emit
    when TupleLiteral
      emit := (operands: String[]) -> emit_values(g.ir, type_of(g, expression), operands)
      holding_all g, expression.items, emit
    when TupleItem
      tuple := generate(g, expression.tuple)
      item := emit_value_at(g.ir, tuple, type_of(g, expression.tuple), expression.index)
      emit_release g.ir, tuple
      item
    when Index then generate_index(g, expression)
    when FunctionLiteral then generate_closure(g, expression)

generate_is_test := (g: Generator, test: IsTest) ->
  object := generate(g, test.value)
  result := emit_member_test(g, object, test.value, test.type)
  emit_release_value g.ir, object, type_of(g, test.value)
  result

# The cast of a value narrowed to one member, held as the member itself, not boxed in the union:
# whether it holds the type is known but for nil.
emit_narrowed_cast := (g: Generator, cast: Cast, object: String) ->
  ir := g.ir
  member := type_of(g, cast.type)
  value_type := type_of(g, cast.value)
  narrowed := inner_of(value_type)
  if not is_assignable(narrowed, member)
    emit_release_value ir, object, value_type
    return nil_constant(optional_type(member)) if not cast.throws
    throw_if g, 'true', FAILED_CAST
    return 'undef'
  if cast.throws and value_type is OptionalType
    fails := emit_is_nil(ir, object, value_type)
    while_holding g, object, value_type, -> throw_if(g, fails, FAILED_CAST)
  # A union's value, a pointer, is null for nil, so it needs no unwrapping or wrapping.
  if inner_of(member) is UnionType
    return is_boxed(narrowed) then emit_box_value(ir, object, value_type) else object
  if value_type is not OptionalType
    return cast.throws then object else emit_wrap(ir, object, member)
  cast.throws then emit_unwrap(ir, object, value_type) else object

# The object if it holds the type, and otherwise nil, or a throw.
generate_cast := (g: Generator, cast: Cast) ->
  ir := g.ir
  object := generate(g, cast.value)
  member := type_of(g, cast.type)
  value_type := type_of(g, cast.value)
  return emit_narrowed_cast(g, cast, object) if inner_of(value_type) is not UnionType
  holds := emit_member_test(g, object, cast.value, cast.type)
  if cast.throws
    fails := ir.assign("xor i1 #{holds}, true")
    while_holding g, object, value_type, -> throw_if(g, fails, FAILED_CAST)
    return object if not is_boxed(member)
    return emit_narrowed_owned(ir, object, value_type, member)
  if is_boxed(member)
    optional := optional_type(member)
    value := -> emit_wrap(ir, emit_unbox(ir, object, member), member)
    result := emit_branch(ir, ir_type(optional), holds, value, nil_constant(optional))
    emit_retain_value ir, result, optional
    emit_release ir, object
    return result
  result := ir.assign("select i1 #{holds}, ptr #{object}, ptr null")
  emit_retain ir, result
  emit_release ir, object
  result

# An i1: whether the object, the value of a union type or of a member it is narrowed to, optional
# or not, holds the type.
emit_member_test := (g: Generator, object: String, value: Expression, type_name: TypeName) ->
  value_type := type_of(g, value)
  type := type_of(g, type_name)
  # A value narrowed to one member is held as the member itself, not boxed in the union, so there is
  # no header to test, and whether it holds the type is known.
  held := inner_of(value_type)
  if held is not UnionType
    return 'false' if not is_assignable(held, type)
    return value_type is OptionalType then emit_is_present(g.ir, object, value_type) else 'true'
  test_of := (each: String) -> emit_type_test(g.ir, each, type)
  return test_of(object) if value_type is not OptionalType
  emit_present_test g.ir, object, value_type, test_of

# A field's value, of a class, a struct or an anonymous struct; the object is released if it is
# owned, and the value retained.
read_field := (g: Generator, object: String, type: Type, name: String, is_owned: Bool) ->
  ir := g.ir
  if type is RecordType
    value := emit_record_field(ir, object, type, name)
    emit_release ir, object if is_owned
    return value
  object_type := type as ObjectType!
  field := field_named(info_of(g.code.program, object_type), name)
  field_type := field.type!
  loaded := held_field(g, object, object_type, name)
  # The object is held while its `weak!` field is checked; a `weak` one gives nil once its object is
  # gone.
  read_weak := -> weak_object(g, loaded)
  value :=
    case
      when not field.weak then loaded
      when field_type is OptionalType then emit_weak_object(ir, loaded)
      when is_owned then holding(g, object, object_type, read_weak)
      else read_weak()
  emit_retain_value ir, value, field_type
  emit_release ir, object if is_owned
  value

# What a field of a class or struct holds, borrowed: its value, or a weak field's box.
export held_field := (g: Generator, object: String, type: ObjectType, name: String) ->
  info := info_of(g.code.program, type)
  pointer := emit_field_pointer(g.ir, object, info, name)
  field_type := field_named(info, name).type!
  g.ir.assign "load #{ir_type(field_type)}, ptr #{pointer}#{field_tag(g.ir, field_type)}"

# A field of a class, a struct or an anonymous struct, or one that every member of a union has,
# of the object, which is released if it is owned.
export read_any_field := (
  g: Generator
  object: String
  object_type: Type
  name: String
  field_type: Type
  is_owned = true
) ->
  return read_field(g, object, object_type, name, is_owned) if object_type is not UnionType
  of_member := (type: Type) -> read_field(g, object, type, name, is_owned)
  emit_member_dispatch g.ir, object, object_type.members, ir_type(field_type), of_member

# The object that a `weak!` field's box holds, borrowed; it throws if the object is gone.
weak_object := (g: Generator, box: String) ->
  object := emit_weak_object(g.ir, box)
  throw_if g, g.ir.assign("icmp eq ptr #{object}, null"), DEAD_OBJECT
  object

# `E.MEMBER` is a member of an enum.
generate_property := (g: Generator, member: Member) ->
  target := g.facts.members[member]!
  return "#{target.index}" if target is EnumValue
  object_type := type_of(g, member.object)
  type := type_of(g, member)
  if target is InterfaceProperty
    # An interface's getter takes its object owned.
    object := generate(g, member.object)
    return emit_interface_read(g, object, object_type as InterfaceType!, target.index, type)
  (object, is_owned) := generate_borrowed(g, member.object, [], true)
  name := member.name.name
  value :=
    case target
      when Property then read_property(g, object, object_type, target.kind, name, type, is_owned)
      when InterfaceProperty then panic('an interface property is read above')
      when Method, EnumParse then panic('a method must be called')
      when EnumValue then panic('an enum value is read before its object')
  # A field narrowed where it is read (see checker narrowable FieldPath).
  field_type := declared_field_type(g, object_type, name) ? return value
  emit_narrowed_owned g.ir, value, field_type, type

export declared_field_type := (g: Generator, object_type: Type, name: String) ->
  case object_type
    when RecordType then object_type.fields[record_field_index(object_type, name)].type
    when ObjectType then field_named(info_of(g.code.program, object_type), name).type
    else nil

# The property of the object, which is released if it is owned: a field, or a property of a
# builtin type. `s.binary` is the string itself, passing on its ownership, or retained if it is
# borrowed; `length` borrows its object.
export read_property := (
  g: Generator
  object: String
  object_type: Type
  kind: PropertyKind
  name: String
  type: Type
  is_owned = true
) ->
  ir := g.ir
  released := (value: String) ->
    emit_release ir, object if is_owned
    value
  case kind
    when FIELD then read_any_field(g, object, object_type, name, type, is_owned)
    when STRING_BINARY
      emit_retain ir, object if not is_owned
      object
    when ARRAY_LENGTH then released(emit_length(ir, object))
    when MAP_LENGTH then released(emit_map_length(ir, object))
    when BINARY_LENGTH then released(emit_binary_length(ir, object))

generate_interpolation := (g: Generator, interpolation: Interpolation) ->
  parts: String[]
  depth := g.temporaries.length
  for part in interpolation.parts
    operand :=
      case part
        when Call then generate(g, part)
        when TextPart then string_constant(g.ir, part.text)
    push_temporary g, operand, string_type
    parts.push operand
  pop_temporaries g, depth
  emit_concat g.ir, parts

# Generates the expressions in order, each held while the later ones are evaluated, which may
# throw, and gives their operands to `use`; they are let go of after it. Unlike `holding`, it
# generates what it holds, so it lives here, beside `generate`.
export holding_all := (g: Generator, expressions: Expression[], use: (String[]) -> String) ->
  depth := g.temporaries.length
  operands: String[]
  for expression in expressions
    operand := generate(g, expression)
    push_temporary g, operand, type_at_use(g, expression)
    operands.push operand
  result := use(operands)
  pop_temporaries g, depth
  result

export release_if_reference := (g: Generator, expression: Expression, operand: String) ->
  emit_release_value g.ir, operand, type_at_use(g, expression)

# A local's value, a member of an enum, or a top-level function's closure (see
# emit_function_closure).
generate_identifier := (g: Generator, identifier: Identifier) ->
  reference := g.facts.references[identifier]!
  type := type_of(g, identifier)
  case reference
    when EnumValue then "#{reference.index}"
    when FunctionReference
      emit_function_closure g.ir, function_reference_symbol(g, reference), type
    when ScopedLocal, TopLevelValue then read_local(g, local_of(g, identifier), type)
    # A C function can only be called, and generate_named_call generates the callee of a
    # construction or of Map or Set.
    else panic("no value for '#{identifier.name}'")

# The slot's pointer, once a top-level value is known to be initialized.
export slot_pointer := (g: Generator, local: SlotLocal) ->
  if top_level := local.top_level
    emit_initialized_check g, top_level.global if top_level.is_checked
  local.pointer

# The metadata of an access to the slot (see alias_tags).
export slot_tag := (ir: IrBuilder, local: SlotLocal) ->
  local.top_level then top_level_tag(ir) else ''

# The local's value, retained if a reference, as the type it has where it is read: without nil
# where it is narrowed.
export read_local := (g: Generator, local: CodegenLocal, type: Type) ->
  value := read_borrowed(g, local, type)
  emit_retain_value g.ir, value, type
  value

# The local's value, borrowed, as read_local reads it.
export read_borrowed := (g: Generator, local: CodegenLocal, type: Type) ->
  ir := g.ir
  held := held_value(g, local)
  # A weak local's object, which may be gone, is never narrowed.
  value := local.weak then emit_weak_object(ir, held) else held
  check_where_read g, local, value
  emit_narrowed ir, value, local.type, type

# Checks the local for NaN if it holds a float not checked yet, as a read of it would.
export emit_deferred_check := (g: Generator, local: CodegenLocal) ->
  check_where_read g, local, held_value(g, local)

# Checks the value read from the local for NaN if the local holds a float not checked yet (see
# defers_declaration): but as an operand of a tree, whose root checks it.
check_where_read := (g: Generator, local: CodegenLocal, value: String) ->
  return if local is not SlotLocal or g.unchecked_floats[local.pointer] == nil
  if g.defers_float_checks
    g.reads_unchecked_floats = true
  else
    emit_nan_check g, value, local.type

# A call, which may be a leaf of a tree of float arithmetic (see float_tree), checks its arguments
# where it is called, as their values leave the tree; the trees in them are their own, whose roots
# leave the tree's way of checking as it was.
generate_call_in_tree := (g: Generator, call: Call) ->
  defers := g.defers_float_checks
  g.defers_float_checks = false
  value := generate_call_ending_if_never(g, call)
  g.defers_float_checks = defers
  value

# What the local holds, borrowed: its value, or a weak local's box.
export held_value := (g: Generator, local: CodegenLocal) ->
  case local
    when SlotLocal
      pointer := slot_pointer(g, local)
      g.ir.assign "load #{ir_type(local.type)}, ptr #{pointer}#{slot_tag(g.ir, local)}"
    when ValueLocal then local.operand

# The value of the declared type as the narrower one where it is narrowed: without nil, or as one
# member of its union, out of its box if the union holds one; borrowed as `value` is.
export emit_narrowed := (ir: IrBuilder, value: String, declared: Type, type: Type) ->
  if not is_boxed_narrowing(declared, type)
    present := declared is OptionalType and type is not OptionalType
    return present then emit_unwrap(ir, value, declared) else value
  # A union value is a pointer, null for nil, whether optional or not.
  return emit_unbox(ir, value, type) if type is not OptionalType
  member := -> emit_wrap(ir, emit_unbox(ir, value, type.inner), type.inner)
  emit_branch ir, ir_type(type), ir.assign("icmp ne ptr #{value}, null"), member, nil_constant(type)

# As emit_narrowed, of a value that is owned and given over.
emit_narrowed_owned := (ir: IrBuilder, value: String, declared: Type, type: Type) ->
  return emit_narrowed(ir, value, declared, type) if not is_boxed_narrowing(declared, type)
  narrowed := emit_narrowed(ir, value, declared, type)
  emit_retain_value ir, narrowed, type
  emit_release ir, value
  narrowed

# Whether the value of the union narrowed to the type, one member, optional or not, is in a box.
export is_boxed_narrowing := (declared: Type, type: Type) ->
  inner_of(declared) is UnionType and is_boxed(inner_of(type))

# A box of the value, owned, for a union, and of a T? a box or null.
emit_box_value := (ir: IrBuilder, value: String, type: Type) ->
  return emit_box(ir, value, type) if type is not OptionalType
  box := -> emit_box(ir, emit_unwrap(ir, value, type), type.inner)
  emit_branch ir, 'ptr', emit_is_present(ir, value, type), box, 'null'

# The Error becomes the exception (see exceptions).
generate_throw := (g: Generator, throw_expression: Throw) ->
  message := throw_expression.message
  local := message is Identifier then local_of(g, message)
  rethrows := local is SlotLocal and local.caught
  emit_throw_error g, generate(g, message), rethrows
