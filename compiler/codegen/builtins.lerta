# The builtin methods (see checker builtins) in the generated code.
import BuiltinMember from '../checker/builtins'
import ProgramWide from '../checker/shared'
import emit_pop, emit_push from './array'
import emit_integer_to_float, emit_wrapping from './checked_int'
import emit_member_literal, emit_member_name from './enum'
import emit_equals_by_contents, emit_hash_by_contents, emit_number_compare from './equality'
import IrBuilder from './ir_builder'
import call_void_runtime from './runtime_calls'
import call_has_next, call_next from './iter'
import
  emit_map_entries, emit_map_keys, emit_map_remove, emit_set_add, emit_set_contains, emit_set_iter
from './map'
import ArrayType, EnumType, is_one_of_kinds, MapType, Type from '../types'

# Whether the method takes the object over, as an Iter's do; the others borrow it.
export takes_object := (member: BuiltinMember) -> member == ITER_HAS_NEXT or member == ITER_NEXT

# Whether the method of the object's type may return with an exception pending, which the caller
# checks for. A number's operator throws by unwinding at once, as its overflow does, and these
# others call nothing that throws; the operator of a String or a Binary calls the runtime.
export may_leave_exception := (member: BuiltinMember, type: Type) ->
  case member
    when OPERATOR then is_one_of_kinds(type, ['String', 'Binary'])
    when
      INTEGER_CONVERSION, INTEGER_TO_FLOAT, WRAPPING_ADD, WRAPPING_SUB, WRAPPING_MUL,
      NUMBER_COMPARE, ENUM_TO_STRING, ENUM_TO_LITERAL
    then false
    else true

# Calls the method of the object, of the type, with borrowed arguments. `check` checks for an
# exception, which an Iter's next may throw.
export call_builtin_method := (
  ir: IrBuilder, program: ProgramWide, member: BuiltinMember, object: String, type: Type,
  args: String[], check: () -> void
) ->
  case member
    when ARRAY_PUSH
      emit_push ir, object, args[0], element_of(type)
      ''
    when ARRAY_POP then emit_pop(ir, object, element_of(type))
    when MAP_REMOVE
      emit_map_remove ir, object, args[0], type as MapType!
      ''
    when MAP_KEYS then emit_map_keys(ir, object, type as MapType!)
    when MAP_ENTRIES then emit_map_entries(ir, object, type as MapType!)
    when SET_CONTAINS then emit_set_contains(ir, object, args[0], type as MapType!)
    when SET_ADD then emit_set_add(ir, object, args[0], type as MapType!)
    when SET_ITER then emit_set_iter(ir, object, type as MapType!)
    when ITER_HAS_NEXT then call_has_next(ir, object)
    when ITER_NEXT then call_next(ir, object, type, check)
    when ENUM_TO_STRING then emit_member_name(ir, object, type as EnumType!)
    when ENUM_TO_LITERAL then emit_member_literal(ir, object, type as EnumType!)
    when WRAPPING_ADD then emit_wrapping(ir, 'add', object, args[0], type)
    when WRAPPING_SUB then emit_wrapping(ir, 'sub', object, args[0], type)
    when WRAPPING_MUL then emit_wrapping(ir, 'mul', object, args[0], type)
    when INTEGER_TO_FLOAT then emit_integer_to_float(ir, object, type)
    when INTEGER_CONVERSION then panic('a conversion is generated by generate_method_call')
    # It may throw, as its operator does, which generate_method_call checks.
    when OPERATOR then panic('an operator is generated by generate_method_call')
    when EQUALS then emit_equals_by_contents(ir, program, object, args[0], type)
    when HASH then emit_hash_by_contents(ir, program, object, type)
    when NUMBER_COMPARE then emit_number_compare(ir, object, args[0], type)
    when PROMISE_CANCEL
      call_void_runtime ir, 'void @lerta_promise_cancel(ptr)', "ptr #{object}"
      ''

element_of := (type: Type) -> (type as ArrayType!).element
