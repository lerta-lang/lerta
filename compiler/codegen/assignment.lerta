# Generates assignments to names, fields, array items and map values.
import
  Assignment, BinaryOperation, Call, combining_operator, Expression, Identifier, Index, Member,
  Position, Statement, This, UnaryOperation
from '../ast'
import Method from '../checker/member_targets'
import info_of from '../checker/object_types'
import field_tag from './alias_tags'
import emit_checked_items, emit_get, emit_is_out_of_range, emit_set_in from './array'
import
  emit_exception_check, emit_exception_check_if, holding, pop_temporaries, push_temporary,
  while_holding
from './exceptions'
import
  generate, release_if_reference, slot_pointer, slot_tag, type_at_use, type_of
from './expression'
import generate_borrowed from './borrowing'
import emit_method_call, MethodCall from './call'
import weak_box_of from './function'
import local_of from './references'
import ScopedLocal from '../checker/references'
import Generator, locate, SlotLocal from './generator'
import emit_branch, emit_seldom_branch from './ir_builder'
import emit_field_pointer, emit_member_dispatch, field_named from './heap_object'
import emit_release, emit_release_value, ir_type, ownership from './lerta_ir'
import emit_find, emit_held_at, emit_map_set, emit_place, emit_set_at from './map'
import appended, apply_numeric, is_float_leaf from './operator'
import NOT_A_NUMBER, throw_if from './runtime_errors'
import emit_extend from './string'
import is_float, is_one_of_kinds, MapType, ObjectType, Type, UnionType from '../types'

# The new value is stored before the old one is released, which is safe even if they are the
# same object.
export generate_assignment := (g: Generator, written: Assignment) ->
  assignment := through_method(g, written)
  target := assignment.target
  case target
    when Index then generate_index_assignment(g, assignment, target)
    when Member then generate_field_assignment(g, assignment, target)
    when Identifier
      local := local_of(g, target)
      slot := local as SlotLocal!
      pointer := slot_pointer(g, slot)
      if slot.weak
        assign_weak g, assignment, pointer, slot.type
      else
        assign_through g, assignment, pointer, slot.type, slot_tag(g.ir, slot)

# `a += b` through a method assigns the call of it that the checker made, `a.add(b)` (see
# check_operator_assignment), but for a target with a default, which update_with_default reads
# once, without putting the default first.
through_method := (g: Generator, assignment: Assignment) ->
  call := g.facts.operator_calls[assignment] ? return assignment
  return assignment if (assignment.target as Index?)?.default_value
  Assignment(assignment..., operator: '=', value: call)

# The field takes the new value's reference and releases the old one. Through a union, the field
# is that of the member the object is. The object is borrowed where it can be while the value is
# evaluated (see generate_borrowed), so that assigning a field of a local retains nothing.
generate_field_assignment := (g: Generator, assignment: Assignment, target: Member) ->
  object_type := type_of(g, target.object)
  (object, owned) := generate_borrowed(g, target.object, [assignment.value])
  name := target.name.name
  pointer_of := (type: Type) -> field_pointer(g, object, type, name)
  pointer :=
    if object_type is UnionType
      emit_member_dispatch g.ir, object, object_type.members, 'ptr', pointer_of
    else
      pointer_of object_type
  field_type := type_of(g, target)
  weak := is_weak_field(g, object_type, name)
  assign := ->
    if weak
      assign_weak g, assignment, pointer, field_type
    else
      assign_through g, assignment, pointer, field_type, field_tag(g.ir, field_type)
  return assign() if not owned
  while_holding g, object, object_type, assign
  emit_release g.ir, object

# The checker allows no weak field to be assigned through a union.
is_weak_field := (g: Generator, type: Type, name: String): Bool ->
  if type is UnionType
    has_weak := type.members.any((member) -> is_weak_field(g, member, name))
    panic "a weak field '#{name}' assigned through a union" if has_weak
    return false
  info := info_of(g.code.program, type as ObjectType!)
  field_named(info, name).weak

# A weak local or field takes the box of the new value's object, and releases its old box; only
# `=` applies, to an optional class's object.
assign_weak := (g: Generator, assignment: Assignment, pointer: String, type: Type) ->
  panic "'#{assignment.operator}' on a weak local or field" if assignment.operator != '='
  ir := g.ir
  value := generate(g, assignment.value)
  box := weak_box_of(g, value, type)
  emit_release ir, value
  replaced := ir.assign("load ptr, ptr #{pointer}")
  ir.emit "store ptr #{box}, ptr #{pointer}"
  emit_release ir, replaced

field_pointer := (g: Generator, object: String, type: Type, name: String) ->
  object_type := type as ObjectType!
  emit_field_pointer g.ir, object, info_of(g.code.program, object_type), name

# The array or map retains the new item and releases the old one. For `+=` and so on, the old item
# is read after the value is evaluated, as a name's is (see assign_through).
generate_index_assignment := (g: Generator, assignment: Assignment, target: Index) ->
  object_type := type_of(g, target.object)
  return generate_map_assignment(g, assignment, target, object_type) if object_type is MapType
  ir := g.ir
  element := type_of(g, target)
  (array, is_owned) := generate_borrowed(g, target.object, [target.index, assignment.value])
  depth := g.temporaries.length
  push_temporary g, array, object_type if is_owned
  index := generate(g, target.index)
  operand := appended(g, assignment.value)
  value := generate(g, operand)
  push_temporary g, value, type_at_use(g, operand)
  old := assignment.operator == '=' then '' else emit_get(ir, array, index, element)
  # An index out of range throws.
  emit_exception_check g if not old.is_empty()
  pop_temporaries g, depth
  result := combine(g, assignment.operator, old, value, element, type_at_use(g, operand))
  items := emit_checked_items(ir, array, index)
  emit_set_in ir, items, index, result, element
  emit_release_value ir, result, element
  emit_release ir, array if is_owned
  # An index out of range throws, which the items tell; an operator such as `+=` may have thrown
  # before, on an overflow, with the index in range, so that only the pending exception tells it.
  if assignment.operator == '='
    emit_exception_check_if g, emit_is_out_of_range(ir, items)
  else
    emit_exception_check g

# `=` sets a map value, and `+=` and so on update that of `m[k, default: d]`. The key, like an
# index, is evaluated before the value.
generate_map_assignment := (g: Generator, assignment: Assignment, target: Index, type: MapType) ->
  later := [target.index, assignment.value]
  later.push default_value if default_value := target.default_value
  (map, is_owned) := generate_borrowed(g, target.object, later)
  depth := g.temporaries.length
  push_temporary g, map, type if is_owned
  key := generate(g, target.index)
  push_temporary g, key, type_at_use(g, target.index)
  if assignment.operator == '='
    value := generate(g, assignment.value)
    pop_temporaries g, depth
    emit_map_set g.ir, map, key, value, type
    release_if_reference g, assignment.value, value
  else
    update_with_default g, assignment, target.default_value!, map, key, type
    pop_temporaries g, depth
  release_if_reference g, target.index, key
  emit_release g.ir, map if is_owned

# `m[k, default: d] += x` and so on, of a borrowed map and key: the value is evaluated first, then
# the key's value is read, or else `d` is evaluated, and the two combined, by the operator or by
# the method that it calls. The map holds the key only once the result is written, so that one
# that throws, as an overflow, leaves the map as it was.
update_with_default := (
  g: Generator, assignment: Assignment, default_value: Expression, map: String, key: String,
  type: MapType
) ->
  ir := g.ir
  by_method := g.facts.operator_calls[assignment]
  operand := by_method then assignment.value else appended(g, assignment.value)
  value := generate(g, operand)
  value_type := type_at_use(g, operand)
  place := emit_find(ir, map, key, type)
  found := ir.assign("icmp ne ptr #{place}, null")
  missing := ir.assign("xor i1 #{found}, true")
  held := emit_held_at(ir, place, found, type)
  old := holding(g, value, value_type, ->
    emit_branch ir, ir_type(type.value), missing, -> generate(g, default_value), held
  )
  result :=
    if by_method
      combine_by_method g, by_method, old, value, type.value, value_type
    else
      combine g, assignment.operator, old, value, type.value, value_type
  # A method, unlike an operator, may change the map, as the default may.
  place_anew := -> emit_place(ir, map, key, type)
  written := by_method then place_anew() else emit_branch(ir, 'ptr', missing, place_anew, place)
  emit_set_at ir, written, result, type
  emit_release_value ir, result, type.value

# `old.add(value)` and so on, of both owned, by the method of the call that the checker made for
# `+=` (see through_method), which borrows them; they are released after it.
combine_by_method := (
  g: Generator, call: Call, old: String, value: String, type: Type, value_type: Type
) ->
  member := call.callee as Member!
  method := g.facts.members[member] as Method!
  method_call := MethodCall
    name: member.name.name
    type: type_of(g, member)
    operands: [value]
    args: ["#{ir_type(value_type)} #{value}"]
    instance: g.facts.instances[call]?.instance
    check: -> emit_exception_check(g)
  call_method := -> emit_method_call(g, method.source, old, type, method_call)
  result := holding(g, old, type, -> holding(g, value, value_type, call_method))
  emit_release_value g.ir, old, type
  emit_release_value g.ir, value, value_type
  emit_exception_check g
  result

# The value is evaluated first, and then, for `+=` and so on, the old value is loaded, which sees
# what the value did to the target, as a method that assigns the same field does. The target's
# reference to the old value passes to `combine`, which consumes it, so that a String or a Binary
# that nothing else holds grows in place; `=` releases the old value once the new one is stored.
assign_through := (
  g: Generator, assignment: Assignment, pointer: String, type: Type, tag: String
) ->
  ir := g.ir
  load := -> ir.assign("load #{ir_type(type)}, ptr #{pointer}#{tag}")
  operand := appended(g, assignment.value)
  is_plain := assignment.operator == '='
  # `x += e` of a Float or a Float32, where e is a tree (see float_tree) or a leaf, is a tree whose
  # root is the combining operation, as the old value, loaded after e, is a leaf too.
  is_root :=
    not is_plain and is_float(type) and not g.defers_float_checks and is_float_leaf(g, operand)
  g.defers_float_checks = true if is_root
  value := generate(g, operand)
  g.defers_float_checks = false if is_root
  old := is_plain then '' else load()
  result := combine(g, assignment.operator, old, value, type, type_at_use(g, operand))
  replaced := is_plain and ownership(type) != NONE then load() else ''
  ir.emit "store #{ir_type(type)} #{result}, ptr #{pointer}#{tag}"
  emit_release_value ir, replaced, type if not replaced.is_empty()

# The value to store: the new one for `=`, or the old one combined with it for `+=` and so on.
# Both are owned.
combine := (
  g: Generator, operator: String, old: String, value: String, type: Type, value_type: Type
) ->
  case
    when operator == '=' then value
    when is_one_of_kinds(type, ['String', 'Binary']) then emit_extend(g.ir, old, value, value_type)
    else apply_numeric(g, combining_operator(operator), old, value, type)

# How many of the statements from `start` on are a batch of writes of Float fields: the
# assignments that follow one another as `x.f += e`, `-=`, `*=` or `/=` of a Float or a Float32
# field, where x is a local or `@` of a class, no union, and e is a tree of float
# arithmetic (see float_tree) or a leaf, so that it calls nothing, up to one that reads a field of
# a name that one before it writes, its target's old value too, which would see the field before
# the write is stored (see generate_batched_field_writes). The last statement of a body, which
# generate_last_statement generates, is in none.
export batched_field_writes := (g: Generator, statements: Statement[], start: Int) ->
  written: String[]
  var count = 0
  while start + count < statements.length
    statement := statements[start + count]
    break if not is_batched_write(g, statement)
    assignment := statement as Assignment!
    target := assignment.target as Member!
    read := [field_names_read(target)..., field_names_read(appended(g, assignment.value))...]
    break if read.any((name) -> name in written)
    written.push target.name.name
    count += 1
  count

is_batched_write := (g: Generator, statement: Statement) ->
  return false if statement is not Assignment
  return false if statement.operator == '=' or statement in g.facts.operator_calls
  target := statement.target
  return false if target is not Member or not is_float(type_of(g, target))
  if not is_local_or_this(g, target.object) or type_of(g, target.object) is not ObjectType
    return false
  is_float_leaf g, appended(g, statement.value)

is_local_or_this := (g: Generator, expression: Expression) ->
  case expression
    when This then true
    when Identifier then g.facts.references[expression] is ScopedLocal
    else false

# The names of the fields that a leaf or a tree of float arithmetic reads.
field_names_read := (expression: Expression): String[] ->
  case expression
    when Member then [expression.name.name, field_names_read(expression.object)...]
    when BinaryOperation
      [field_names_read(expression.left)..., field_names_read(expression.right)...]
    when UnaryOperation then field_names_read(expression.operand)
    else []

# The writes of a batch (see batched_field_writes) compute every value first, each as
# assign_through does, then one branch checks them all for NaN, and the stores follow, so that LLVM
# can keep the writes together. Where one is NaN, the branch takes the writes one by one, each
# checked where its statement is and then stored, as they are without a batch, so that the first
# that is NaN throws and the fields before it are written.
export generate_batched_field_writes := (g: Generator, statements: Statement[]) ->
  ir := g.ir
  outer := g.position
  depth := g.temporaries.length
  owned: String[]
  writes: BatchedWrite[]
  for statement in statements
    locate g, statement.position
    assignment := statement as Assignment!
    target := assignment.target as Member!
    object_type := type_of(g, target.object)
    (object, is_owned) := generate_borrowed(g, target.object, [assignment.value])
    if is_owned
      push_temporary g, object, object_type
      owned.push object
    type := type_of(g, target)
    pointer := field_pointer(g, object, object_type, target.name.name)
    tag := field_tag(ir, type)
    operand := appended(g, assignment.value)
    g.defers_float_checks = true
    value := generate(g, operand)
    old := ir.assign("load #{ir_type(type)}, ptr #{pointer}#{tag}")
    result := combine(g, assignment.operator, old, value, type, type_at_use(g, operand))
    g.defers_float_checks = false
    is_nan := ir.assign("fcmp uno #{ir_type(type)} #{result}, 0.0")
    store := "store #{ir_type(type)} #{result}, ptr #{pointer}#{tag}"
    writes.push { is_nan, store, position: statement.position }
  var any = writes[0].is_nan
  any = ir.assign("or i1 #{any}, #{write.is_nan}") for write in writes.slice(1, writes.length)
  one_by_one := ir.fresh_label('nan.one.by.one')
  stored := ir.fresh_label('nan.none')
  emit_seldom_branch ir, any, one_by_one, stored
  ir.start_block one_by_one
  for write in writes
    locate g, write.position
    throw_if g, write.is_nan, NOT_A_NUMBER
    ir.emit write.store
  ir.emit "br label %#{stored}"
  ir.start_block stored
  ir.emit write.store for write in writes
  pop_temporaries g, depth
  emit_release ir, object for object in owned
  locate g, outer

struct BatchedWrite
  position: Position
  is_nan: String
  store: String
