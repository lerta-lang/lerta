# Generates assignments to names, fields, array items and map values.
import { Assignment, combining_operator, Identifier, Index, Member } from '../ast'
import { info_of } from '../checker/object_types'
import { emit_get, emit_set } from './array'
import { apply_arithmetic } from './checked_int'
import { generate, release_if_reference, slot_pointer, type_of } from './expression'
import { lookup_local } from './function'
import { Generator, SlotLocal } from './generator'
import { emit_field_pointer, emit_member_dispatch } from './heap_object'
import { emit_release, emit_retain, ir_type } from './lerta_ir'
import { emit_map_set } from './map'
import { emit_concat } from './string'
import { is_kind, is_reference_type, MapType, ObjectType, Type, UnionType } from '../types'

# The new value is stored before the old one is released, which is safe even if they are the
# same object.
export const generate_assignment = (g: Generator, assignment: Assignment) ->
  const target = assignment.target
  case target
    when Index then generate_index_assignment(g, assignment, target)
    when Member then generate_field_assignment(g, assignment, target)
    when Identifier
      const local = lookup_local(g, target.name)!
      const slot = local as SlotLocal!
      assign_through g, assignment, slot_pointer(g.ir, slot), slot.type

# The field takes the new value's reference and releases the old one. Through a union, the field
# is that of the member the object is.
const generate_field_assignment = (g: Generator, assignment: Assignment, target: Member) ->
  const object_type = type_of(g, target.object)
  const object = generate(g, target.object)
  const name = target.name.name
  const pointer_of = (type: Type) -> field_pointer(g, object, type, name)
  const pointer = case object_type
    when UnionType then emit_member_dispatch(g.ir, object, object_type.members, 'ptr', pointer_of)
    else pointer_of(object_type)
  assign_through g, assignment, pointer, type_of(g, target)
  emit_release g.ir, object

const field_pointer = (g: Generator, object: String, type: Type, name: String) ->
  const object_type = type as ObjectType!
  emit_field_pointer g.ir, object, info_of(g.code.program, object_type), name

# The array or map retains the new item and releases the old one.
const generate_index_assignment = (g: Generator, assignment: Assignment, target: Index) ->
  const object_type = type_of(g, target.object)
  return generate_map_assignment(g, assignment, target, object_type) if object_type is MapType
  const ir = g.ir
  const element = type_of(g, target)
  const array = generate(g, target.object)
  const index = generate(g, target.index)
  const old = assignment.operator == '=' then '' else emit_get(ir, array, index, element)
  const value = generate(g, assignment.value)
  const result = combine(g, assignment.operator, old, value, element)
  emit_set ir, array, index, result, element
  emit_release ir, result if is_reference_type(element)
  emit_release ir, array

# Only `=` applies to a map value. The key, like an index, is evaluated before the value.
const generate_map_assignment = (
  g: Generator, assignment: Assignment, target: Index, type: MapType
) ->
  const map = generate(g, target.object)
  const key = generate(g, target.index)
  const value = generate(g, assignment.value)
  emit_map_set g.ir, map, key, value, type
  release_if_reference g, target.index, key
  release_if_reference g, assignment.value, value
  emit_release g.ir, map

# For `+=` and so on, the old value is loaded, and owned, before the value is evaluated, as it is
# combined. Evaluating the value may change the target (a method that assigns the same field, for
# example), so the value to release is loaded again after it: releasing a stale one would free it
# twice.
const assign_through = (g: Generator, assignment: Assignment, pointer: String, type: Type) ->
  const ir = g.ir
  const load = () -> ir.assign("load #{ir_type(type)}, ptr #{pointer}")
  const is_reference = is_reference_type(type)
  var old = ''
  if assignment.operator != '='
    old = load()
    emit_retain ir, old if is_reference
  const value = generate(g, assignment.value)
  const result = combine(g, assignment.operator, old, value, type)
  const replaced = is_reference then load() else ''
  ir.emit "store #{ir_type(type)} #{result}, ptr #{pointer}"
  emit_release ir, replaced if is_reference

# The value to store: the new one for `=`, or the old one combined with it for `+=` and so on.
# Both are owned.
const combine = (g: Generator, operator: String, old: String, value: String, type: Type) ->
  case
    when operator == '=' then value
    when is_kind(type, 'String') then emit_concat(g.ir, [old, value])
    else apply_arithmetic(g, combining_operator(operator), old, value, type)
