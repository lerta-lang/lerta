# Generates assignments to names, fields, array items and map values.
import Assignment, combining_operator, Identifier, Index, Member from '../ast'
import info_of from '../checker/object_types'
import emit_checked_items, emit_get, emit_is_out_of_range, emit_set_in from './array'
import
  emit_exception_check, emit_exception_check_if, pop_temporaries, push_temporary, while_holding
from './exceptions'
import
  generate, generate_borrowed, release_if_reference, slot_pointer, type_at_use, type_of
from './expression'
import weak_box_of from './function'
import local_of from './references'
import Generator, SlotLocal from './generator'
import emit_field_pointer, emit_member_dispatch, field_named from './heap_object'
import emit_release, emit_release_value, ir_type, ownership from './lerta_ir'
import emit_map_set from './map'
import appended, apply_numeric from './operator'
import emit_extend from './string'
import is_one_of_kinds, MapType, ObjectType, Type, UnionType from '../types'

# The new value is stored before the old one is released, which is safe even if they are the
# same object.
export generate_assignment := (g: Generator, written: Assignment) ->
  assignment := through_method(g, written)
  target := assignment.target
  case target
    when Index then generate_index_assignment(g, assignment, target)
    when Member then generate_field_assignment(g, assignment, target)
    when Identifier
      local := local_of(g, target)
      slot := local as SlotLocal!
      pointer := slot_pointer(g, slot)
      if slot.weak
        assign_weak g, assignment, pointer, slot.type
      else
        assign_through g, assignment, pointer, slot.type

# `a += b` through a method assigns the call of it that the checker made, `a.add(b)` (see
# check_operator_assignment).
through_method := (g: Generator, assignment: Assignment) ->
  call := g.facts.operator_calls[assignment] ? return assignment
  Assignment operator: '=', target: assignment.target, value: call, position: assignment.position

# The field takes the new value's reference and releases the old one. Through a union, the field
# is that of the member the object is.
generate_field_assignment := (g: Generator, assignment: Assignment, target: Member) ->
  object_type := type_of(g, target.object)
  object := generate(g, target.object)
  name := target.name.name
  pointer_of := (type: Type) -> field_pointer(g, object, type, name)
  pointer :=
    if object_type is UnionType
      emit_member_dispatch g.ir, object, object_type.members, 'ptr', pointer_of
    else
      pointer_of object_type
  field_type := type_of(g, target)
  weak := is_weak_field(g, object_type, name)
  assign := ->
    if weak
      assign_weak g, assignment, pointer, field_type
    else
      assign_through g, assignment, pointer, field_type
  while_holding g, object, object_type, assign
  emit_release g.ir, object

# The checker allows no weak field to be assigned through a union.
is_weak_field := (g: Generator, type: Type, name: String): Bool ->
  if type is UnionType
    has_weak := type.members.any((member) -> is_weak_field(g, member, name))
    panic "a weak field '#{name}' assigned through a union" if has_weak
    return false
  info := info_of(g.code.program, type as ObjectType!)
  field_named(info, name).weak

# A weak local or field takes the box of the new value's object, and releases its old box; only
# `=` applies, to an optional class's object.
assign_weak := (g: Generator, assignment: Assignment, pointer: String, type: Type) ->
  panic "'#{assignment.operator}' on a weak local or field" if assignment.operator != '='
  ir := g.ir
  value := generate(g, assignment.value)
  box := weak_box_of(g, value, type)
  emit_release ir, value
  replaced := ir.assign("load ptr, ptr #{pointer}")
  ir.emit "store ptr #{box}, ptr #{pointer}"
  emit_release ir, replaced

field_pointer := (g: Generator, object: String, type: Type, name: String) ->
  object_type := type as ObjectType!
  emit_field_pointer g.ir, object, info_of(g.code.program, object_type), name

# The array or map retains the new item and releases the old one. For `+=` and so on, the old item
# is read after the value is evaluated, as a name's is (see assign_through).
generate_index_assignment := (g: Generator, assignment: Assignment, target: Index) ->
  object_type := type_of(g, target.object)
  return generate_map_assignment(g, assignment, target, object_type) if object_type is MapType
  ir := g.ir
  element := type_of(g, target)
  (array, is_owned) := generate_borrowed(g, target.object)
  depth := g.temporaries.length
  push_temporary g, array, object_type if is_owned
  index := generate(g, target.index)
  operand := appended(g, assignment.value)
  value := generate(g, operand)
  push_temporary g, value, type_at_use(g, operand)
  old := assignment.operator == '=' then '' else emit_get(ir, array, index, element)
  # An index out of range throws.
  emit_exception_check g if old != ''
  pop_temporaries g, depth
  result := combine(g, assignment.operator, old, value, element, type_at_use(g, operand))
  items := emit_checked_items(ir, array, index)
  emit_set_in ir, items, index, result, element
  emit_release_value ir, result, element
  emit_release ir, array if is_owned
  # An index out of range throws, which the items tell; an operator such as `+=` may have thrown
  # before, on an overflow, with the index in range, so that only the pending exception tells it.
  if assignment.operator == '='
    emit_exception_check_if g, emit_is_out_of_range(ir, items)
  else
    emit_exception_check g

# Only `=` applies to a map value. The key, like an index, is evaluated before the value.
generate_map_assignment := (g: Generator, assignment: Assignment, target: Index, type: MapType) ->
  (map, is_owned) := generate_borrowed(g, target.object)
  depth := g.temporaries.length
  push_temporary g, map, type if is_owned
  key := generate(g, target.index)
  push_temporary g, key, type_at_use(g, target.index)
  value := generate(g, assignment.value)
  pop_temporaries g, depth
  emit_map_set g.ir, map, key, value, type
  release_if_reference g, target.index, key
  release_if_reference g, assignment.value, value
  emit_release g.ir, map if is_owned

# The value is evaluated first, and then, for `+=` and so on, the old value is loaded, which sees
# what the value did to the target, as a method that assigns the same field does. The target's
# reference to the old value passes to `combine`, which consumes it, so that a String or a Binary
# that nothing else holds grows in place; `=` releases the old value once the new one is stored.
assign_through := (g: Generator, assignment: Assignment, pointer: String, type: Type) ->
  ir := g.ir
  load := -> ir.assign("load #{ir_type(type)}, ptr #{pointer}")
  operand := appended(g, assignment.value)
  value := generate(g, operand)
  is_plain := assignment.operator == '='
  old := is_plain then '' else load()
  result := combine(g, assignment.operator, old, value, type, type_at_use(g, operand))
  replaced := is_plain and ownership(type) != NONE then load() else ''
  ir.emit "store #{ir_type(type)} #{result}, ptr #{pointer}"
  emit_release_value ir, replaced, type if replaced != ''

# The value to store: the new one for `=`, or the old one combined with it for `+=` and so on.
# Both are owned.
combine := (
  g: Generator, operator: String, old: String, value: String, type: Type, value_type: Type
) ->
  case
    when operator == '=' then value
    when is_one_of_kinds(type, ['String', 'Binary']) then emit_extend(g.ir, old, value, value_type)
    else apply_numeric(g, combining_operator(operator), old, value, type)
