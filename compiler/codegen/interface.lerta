# Interface values in the generated code (see docs/internals/representation.md#interfaces).
import Itab, ItabEntry from '../checker/interface_values'
import BuiltinMethod from '../checker/builtins'
import is_value_type from '../checker/value_layout'
import EnumValue, InterfaceProperty, Method, Property from '../checker/member_targets'
import ExtensionSource, OwnMethod, UnionMethod from '../checker/methods'
import emit_box, emit_unbox from './boxes'
import call_builtin_method, takes_object from './builtins'
import call_user_function, emit_by_parts, emit_method_call, MethodCall from './call'
import emit_closure_call, function_type_of from './closure'
import
  emit_check_or_return_thrown, emit_check_with, emit_exception_check, emit_return_thrown
from './exceptions'
import read_any_field, read_property from './expression'
import finish from './function'
import function_generator, Generator from './generator'
import IrBuilder, IrModule from './ir_builder'
import
  emit_interface_data, emit_release, emit_release_value, emit_retain_value, extension_symbol,
  instance_symbol, INTERFACE_IR_TYPE, ir_return_type, ir_type, method_symbol, returns_nothing,
  typed_params
from './lerta_ir'
import FunctionType, InterfaceType, Type, type_key from '../types'

# The value converted to the interface value that the itab gives; the value's reference passes to
# it.
export emit_interface_value := (g: Generator, value: String, itab: Itab) ->
  ir := g.ir
  data :=
    if is_value_type(g.code.program, itab.type)
      emit_box ir, value, itab.type
    else
      value
  with_data := ir.assign("insertvalue #{INTERFACE_IR_TYPE} undef, ptr #{data}, 0")
  ir.assign("insertvalue #{INTERFACE_IR_TYPE} #{with_data}, ptr #{define_itab(g, itab)}, 1")

# Calls the member at the index through the interface value's itab, with the arguments, typed IR
# operands, which stay owned by the caller, as the value does.
export emit_interface_call := (
  ir: IrBuilder, value: String, index: Int, type: Type, args: String[]
) ->
  itab := ir.assign("extractvalue #{INTERFACE_IR_TYPE} #{value}, 1")
  slot := ir.assign("getelementptr ptr, ptr #{itab}, i64 #{index}")
  entry := ir.load('ptr', slot)
  all_args := ["ptr #{emit_interface_data(ir, value)}", args...]
  call_user_function(ir, entry, type, all_args.join(', '))

# The member of the interface value that is no method, which is released.
export emit_interface_read := (
  g: Generator, value: String, type: InterfaceType, index: Int, member_type: Type
) ->
  getter := FunctionType(params: [], result: member_type)
  result := emit_interface_call(g.ir, value, index, getter, [])
  emit_release_value g.ir, value, type
  result

# The itab's global, defined in the module at its first use.
define_itab := (g: Generator, itab: Itab) ->
  entries := [
    for entry in itab.entries
      entry_function(g, itab, entry)
  ]
  key := "itab #{type_key(itab.type)} #{type_key(itab.target)} #{entries.join(' ')}"
  define := (name: String, _module: IrModule) ->
    array_type := "[#{entries.length} x ptr]"
    init := ["ptr #{entry}" for entry in entries].join(', ')
    g.ir.module.define_global name, "private unnamed_addr constant #{array_type} [#{init}]"
  g.ir.module.named(key, '@lerta.itab', define)

# The function of the entry: the method that gives the member, if it is written in Lerta, which
# takes its object first, or one that calls it with the value in the box of a struct's value;
# otherwise a function that reads the member, defined once.
entry_function := (g: Generator, itab: Itab, entry: ItabEntry) ->
  method := method_of(g, entry) else return define_reader(g, itab.type, entry)
  return method unless is_value_type(g.code.program, itab.type)
  define_unboxing_entry(g, itab.type, entry, method)

# The symbol of the method that gives the member, if it is written in Lerta.
method_of := (g: Generator, entry: ItabEntry) ->
  return instance_symbol(g.code.program, instance) if instance := entry.instance
  source := entry.target is Method then entry.target.source
  case source
    when OwnMethod then method_symbol(source.receiver, entry.member.name)
    when ExtensionSource then extension_symbol(g.code.program, source.method)
    else nil

# A function that calls the method of the symbol with the value in the box, `%data`, which it
# borrows, as the method does its object.
define_unboxing_entry := (g: Generator, type: Type, entry: ItabEntry, method: String) ->
  function_type := function_type_of(entry.member.type)
  define := (symbol: String, module: IrModule) ->
    ir := IrBuilder(module)
    program := ir.program
    params := typed_params(program, function_type.params)
    value := "#{ir_type(program, type)} #{emit_unbox(ir, '%data', type)}"
    result := call_user_function(ir, method, function_type, [value, params...].join(', '))
    result_type := function_type.result
    return_type := ir_return_type(program, result_type)
    ir.emit returns_nothing(result_type) then 'ret void' else "ret #{return_type} #{result}"
    ir.finish "private #{return_type} #{symbol}(#{['ptr %data', params...].join(', ')})"
  g.ir.module.named("unboxing #{method}", '@lerta.unboxing', define)

# A function that gives the member of a value of the type: calls a builtin method or a field that
# holds a function, or reads a field or a property.
define_reader := (g: Generator, type: Type, entry: ItabEntry) ->
  member_type := entry.member.type
  key := "reader #{type_key(type)} #{entry.member.name}"
  define := (symbol: String, _module: IrModule) ->
    reader := function_generator(g.code, g.extensions, g.facts, '')
    function_type := member_type is FunctionType then member_type
    params := function_type?.params else []
    operands := ["%p#{i}" for i in 0..params.length]
    result_type := function_type?.result else member_type

    # What the reader returns when it passes an exception on.
    reader.result_type = result_type

    result := generate_reading(reader, type, entry, operands)
    return_type := ir_return_type(g.code.program, result_type)
    reader.ir.emit return_type == 'void' then 'ret void' else "ret #{return_type} #{result}"
    params_list := ['ptr %data', typed_params(g.code.program, params)...]
    finish reader, "private #{return_type} #{symbol}(#{params_list.join(', ')})"
  g.ir.module.named(key, '@lerta.reader', define)

# The reader's result, computed from its data, `%data`, and its parameters, `operands`.
generate_reading := (reader: Generator, type: Type, entry: ItabEntry, operands: String[]) ->
  { name } := entry.member
  member_type := entry.member.type
  target := entry.target
  case target
    when Property
      call := -> call_field(reader, type, name, member_type, operands)
      read := ->
        read_property(reader, take_data(reader.ir, type), type, target.kind, name, member_type)
      member_type is FunctionType then call() else read()
    when Method
      source := target.source
      if source is UnionMethod
        return call_union_method(reader, type, name, source, operands)

      # The other methods are written in Lerta (see entry_function).
      call_builtin(reader, type, source as BuiltinMethod!, operands)
    when InterfaceProperty, EnumValue
      panic('a reader reads a field, a property or a builtin method')

# Calls the method of the name of the member that the union, `%data`, is.
call_union_method := (
  reader: Generator, type: Type, name: String, method: UnionMethod, operands: String[]
) ->
  params := function_type_of(method.type).params
  args := ["#{ir_type(reader.code.program, param)} #{operands[i]}" for param at i in params]
  check := -> emit_exception_check(reader)
  call := MethodCall(name, operands, args, check, type: method.type, instance: nil)
  emit_method_call(reader, method, '%data', type, call)

# The value of the type that `%data` gives, retained: the reader borrows its data, while reading a
# field or a property, or an Iter's method, takes the object over.
take_data := (ir: IrBuilder, type: Type) ->
  value := data_value(ir, type)
  emit_retain_value ir, value, type
  value

# The value of the type that `%data` gives, borrowed: the data itself, or the value in its box.
data_value := (ir: IrBuilder, type: Type) ->
  if is_value_type(ir.program, type)
    emit_unbox(ir, '%data', type)
  else
    '%data'

# Calls the field that holds a function with the operands, returning what it throws.
call_field := (reader: Generator, type: Type, name: String, field_type: Type, operands: String[]) ->
  ir := reader.ir
  closure := read_any_field(reader, take_data(ir, type), type, name, field_type)
  value := emit_closure_call(ir, closure, field_type, operands)
  emit_release ir, closure
  emit_check_or_return_thrown ir, reader.result_type
  value

# Calls the builtin method on the data, releasing the data if an Iter's next throws before it
# takes the data over.
call_builtin := (reader: Generator, type: Type, builtin: BuiltinMethod, operands: String[]) ->
  ir := reader.ir
  program := reader.code.program
  release_and_return := ->
    emit_release ir, '%data'
    emit_return_thrown ir, reader.result_type

  # Only an Iter's next calls it, past the end, before it takes the object over.
  check := -> emit_check_with(ir, release_and_return)

  if id := builtin.parts
    value := emit_by_parts(reader, builtin, id, data_value(ir, type), operands)
    emit_check_or_return_thrown ir, reader.result_type
    return value
  object :=
    if takes_object(builtin.member)
      take_data ir, type
    else
      data_value ir, type
  call_builtin_method(ir, program, builtin.member, object, type, operands, check)
