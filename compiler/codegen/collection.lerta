# Arrays and maps in the generated code: their literals, and indexing (of a Binary too).
import { ArrayLiteral, Index, MapLiteral } from '../ast'
import { emit_array_new, emit_get, emit_push } from './array'
import { generate, release_if_reference, type_of } from './expression'
import { Generator } from './generator'
import { emit_release } from './lerta_ir'
import { emit_map_get, emit_map_new, emit_map_set } from './map'
import { emit_binary_get } from './string'
import { ArrayType, is_kind, MapType } from '../types'

# Each item is pushed, so the array retains it; the item's own reference is then released.
export const generate_array = (g: Generator, array: ArrayLiteral) ->
  const type = type_of(g, array)
  const array_type = type is ArrayType then type else throw 'an array literal has an array type'
  const result = emit_array_new(g.ir, array_type.element)
  for element in array.elements
    const value = generate(g, element)
    emit_push(g.ir, result, value, array_type.element)
    release_if_reference(g, element, value)
  result

# Each entry is set, so the map retains its key and value, whose own references are then
# released.
export const generate_map = (g: Generator, map: MapLiteral) ->
  const type = type_of(g, map)
  const map_type = type is MapType then type else throw 'a map literal has a map type'
  const result = emit_map_new(g.ir, map_type)
  for entry in map.entries
    const key = generate(g, entry.key)
    const value = generate(g, entry.value)
    emit_map_set(g.ir, result, key, value, map_type)
    release_if_reference(g, entry.key, key)
    release_if_reference(g, entry.value, value)
  result

export const generate_index = (g: Generator, index: Index) ->
  const object = generate(g, index.object)
  const object_type = type_of(g, index.object)
  const position = generate(g, index.index)
  const item = case
    when object_type is MapType then emit_map_get(g.ir, object, position, object_type)
    when is_kind(object_type, 'Binary') then emit_binary_get(g.ir, object, position)
    else emit_get(g.ir, object, position, type_of(g, index))
  release_if_reference(g, index.index, position)
  emit_release(g.ir, object)
  item
