# Arrays and maps in the generated code: their literals, and indexing (of a Binary too).
import
  ArrayLiteral, Comprehension, Expression, Identifier, Index, IntegerLiteral, is_spread, MapLiteral,
  Range, StringLiteral
from '../ast'
import
  emit_array_new, emit_checked_items, emit_get_from, emit_is_out_of_range, emit_push
from './array'
import push_comprehension from './control_flow'
import emit_exception_check, emit_exception_check_if, holding, while_holding from './exceptions'
import
  borrowing_all, generate, generate_borrowed, release_if_reference, type_at_use, type_of
from './expression'
import Generator from './generator'
import emit_branch from './ir_builder'
import emit_release, ir_type from './lerta_ir'
import
  are_keys_plain, emit_find, emit_held_at, emit_map_get, emit_map_new, emit_map_set, emit_place,
  emit_set_at
from './map'
import emit_binary_get, emit_binary_out_of_range, emit_binary_slice from './string'
import ArrayType, is_kind, MapType, Type from '../types'

# Each item is pushed, so the array retains it; the item's own reference is then released.
export generate_array := (g: Generator, array: ArrayLiteral) ->
  array_type := type_of(g, array) as ArrayType!
  result := emit_array_new(g.ir, array_type.element)
  push_all := ->
    for element in array.elements
      if is_spread(element)
        push_comprehension g, element as Comprehension!, result
        continue
      value := generate(g, element)
      emit_push g.ir, result, value, array_type.element
      release_if_reference g, element, value
  while_holding g, result, array_type, push_all
  result

# Each entry is set, so the map retains its key and value, whose own references are then
# released.
export generate_map := (g: Generator, map: MapLiteral) ->
  map_type := type_of(g, map) as MapType!
  result := emit_map_new(g.ir, g.code.program, map_type)
  set_all := ->
    for entry in map.entries
      key := generate(g, entry.key)
      value := holding(g, key, type_at_use(g, entry.key), -> generate(g, entry.value))
      emit_map_set g.ir, result, key, value, map_type
      release_if_reference g, entry.key, key
      release_if_reference g, entry.value, value
  while_holding g, result, map_type, set_all
  result

# `m[k, default: d]`, of a borrowed map and key: the key's value, owned, or else `d`, evaluated
# only then, which the map then holds.
generate_put_default := (
  g: Generator, map: String, key: String, type: MapType, default_value: Expression
) ->
  ir := g.ir
  place := emit_find(ir, map, key, type)
  found := ir.assign("icmp ne ptr #{place}, null")
  held := emit_held_at(ir, place, found, type)
  put := ->
    value := generate(g, default_value)
    emit_set_at ir, emit_place(ir, map, key, type), value, type
    value
  emit_branch ir, ir_type(type.value), ir.assign("xor i1 #{found}, true"), put, held

# `b[start...end]`: the runtime copies the bytes, and throws where the range is not the Binary's.
generate_slice := (g: Generator, object: Expression, range: Range) ->
  slice := (operands: String[]) -> emit_binary_slice(g.ir, operands[0], operands[1], operands[2])
  result := borrowing_all(g, [object, range.start, range.end], slice)
  emit_exception_check g
  result

# Whether the index runs no code of the program between its object and the item, so that it may
# borrow a field as its object: its position is a name or a literal, it puts no default, and a
# map's keys are found without their own `hash` and `==`.
can_borrow_in_place := (g: Generator, index: Index, object_type: Type) ->
  position := index.index
  is_simple := position is Identifier or position is IntegerLiteral or position is StringLiteral
  are_keys_found := object_type is not MapType or are_keys_plain(g.code.program, object_type.key)
  is_simple and index.default_value == nil and are_keys_found

export generate_index := (g: Generator, index: Index) ->
  range := index.index as Range?
  return generate_slice(g, index.object, range) if range
  object_type := type_of(g, index.object)
  (object, is_owned) :=
    generate_borrowed(g, index.object, can_borrow_in_place(g, index, object_type))
  generate_position := -> generate(g, index.index)
  position :=
    is_owned then holding(g, object, object_type, generate_position) else generate_position()
  is_map := object_type is MapType
  is_binary := is_kind(object_type, 'Binary')
  items := not is_map and not is_binary then emit_checked_items(g.ir, object, position)
  outside := is_binary then emit_binary_out_of_range(g.ir, object, position)
  get_or_put := (default_value: Expression) ->
    put := -> generate_put_default(g, object, position, object_type as MapType!, default_value)
    held_position := -> holding(g, position, type_at_use(g, index.index), put)
    is_owned then holding(g, object, object_type, held_position) else held_position()
  item :=
    case
      when items then emit_get_from(g.ir, items, position, type_of(g, index))
      when index.default_value then get_or_put(index.default_value!)
      when object_type is MapType then emit_map_get(g.ir, object, position, object_type)
      else emit_binary_get(g.ir, object, position)
  release_if_reference g, index.index, position
  emit_release g.ir, object if is_owned
  # An index out of range throws, which an array's items, or a Binary's length, tell.
  thrown := items then emit_is_out_of_range(g.ir, items) else outside
  if thrown
    emit_exception_check_if g, thrown
  else
    emit_exception_check g
  item
