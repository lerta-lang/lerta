# `==` of values that compare by their contents (see checker/equality), and their hashes as map
# keys: a function for each type, defined at its first use, which borrows its operands. A part of
# such a value compares as `==` compares it: by value, by its bytes, or as the same object.
# Numbers compare here too, giving an Ordering, as their builtin compare.
import compares_by_contents, has_own_hash, own_equality from '../checker/equality'
import FieldInfo, info_of from '../checker/object_types'
import ProgramWide from '../checker/shared'
import from_item from './array'
import emit_member_value from './boxes'
import emit_own_equals, emit_own_hash, EQUAL, GREATER, LESS from './comparison_methods'
import emit_float_word from './float'
import
  emit_borrowed_field, emit_borrowed_value, emit_member_dispatch, emit_object_type, value_types
from './heap_object'
import all_of, emit_branch, IrBuilder, IrModule from './ir_builder'
import ir_type from './lerta_ir'
import emit_is_present, emit_unwrap from './optional'
import call_runtime from './runtime_calls'
import scalar_of, widened_to_word from './scalar'
import emit_string_equals from './string'
import
  ArrayType, is_float, is_identity_type, is_one_of_kinds, is_set, is_signed, MapType, ObjectType,
  OptionalType, Type, type_key, UnionType
from '../types'

# An i1: whether the two values of the type are equal. A part that holds parts of its own is
# compared by its function, so that a type that holds itself is compared by a recursive call.
export emit_equals_by_contents := (
  ir: IrBuilder, program: ProgramWide, left: String, right: String, type: Type
) ->
  if is_whole(program, type)
    return emit_equals(ir, program, left, right, type)
  symbol := equals_function(ir.module, program, type)
  ir.assign("call i1 #{symbol}(#{ir_type(type)} #{left}, #{ir_type(type)} #{right})")

export emit_hash_by_contents := (ir: IrBuilder, program: ProgramWide, value: String, type: Type) ->
  if is_whole(program, type)
    return emit_hash(ir, program, value, type)
  ir.assign("call i64 #{hash_function(ir.module, program, type)}(#{ir_type(type)} #{value})")

# A type whose values have no parts that compare on their own: a value, an object that compares as
# itself, or one that compares by its own method.
is_whole := (program: ProgramWide, type: Type) ->
  return true if is_value_type(type) or own_equality(program, type) != nil
  is_identity(program, type)

# Whether values of the type compare as the same object: a class, or a union of classes, none of
# which has its own equality.
is_identity := (program: ProgramWide, type: Type) ->
  is_identity_type(type) and not compares_by_contents(program, type)

# The functions that compare and hash items of the type, as a map with keys of it takes them.
export item_functions := (module: IrModule, program: ProgramWide, type: Type) ->
  equals := item_equals_function(module, program, type)
  { equals, hash: item_hash_function(module, program, type) }

# The same object is equal to itself at once, which also ends `s == s` for a value that holds
# itself through an array (see docs/reference/objects.md#equality-and-order).
equals_function := (module: IrModule, program: ProgramWide, type: Type) ->
  define := (name: String, defined: IrModule) ->
    ir := IrBuilder(defined)
    compare := -> emit_equals(ir, program, '%a', '%b', type)
    result :=
      if ir_type(type) == 'ptr'
        differ := ir.assign('icmp ne ptr %a, %b')
        emit_branch ir, 'i1', differ, compare, 'true'
      else
        compare()
    ir.emit "ret i1 #{result}"
    ir.finish "private i1 #{name}(#{ir_type(type)} %a, #{ir_type(type)} %b)"
  module.named("equals #{type_key(type)}", '@lerta.equals', define)

hash_function := (module: IrModule, program: ProgramWide, type: Type) ->
  define := (name: String, defined: IrModule) ->
    ir := IrBuilder(defined)
    ir.emit "ret i64 #{emit_hash(ir, program, '%a', type)}"
    ir.finish "private i64 #{name}(#{ir_type(type)} %a)"
  module.named("hash #{type_key(type)}", '@lerta.hash', define)

item_equals_function := (module: IrModule, program: ProgramWide, type: Type) ->
  define := (name: String, defined: IrModule) ->
    ir := IrBuilder(defined)
    left := from_item(ir, '%a', type)
    right := from_item(ir, '%b', type)
    ir.emit "ret i1 #{emit_equals(ir, program, left, right, type)}"
    ir.finish "private zeroext i1 #{name}(i64 %a, i64 %b)"
  module.named("item equals #{type_key(type)}", '@lerta.item_equals', define)

item_hash_function := (module: IrModule, program: ProgramWide, type: Type) ->
  define := (name: String, defined: IrModule) ->
    ir := IrBuilder(defined)
    ir.emit "ret i64 #{emit_hash(ir, program, from_item(ir, '%a', type), type)}"
    ir.finish "private i64 #{name}(i64 %a)"
  module.named("item hash #{type_key(type)}", '@lerta.item_hash', define)

emit_equals := (
  ir: IrBuilder, program: ProgramWide, left: String, right: String, type: Type
): String ->
  nested := (part: Type, a: String, b: String) -> emit_equals_by_contents(ir, program, a, b, part)
  case
    when own_equality(program, type) then emit_own_equals(ir, program, left, right, type)
    when is_one_of_kinds(type, ['String', 'Binary']) then emit_string_equals(ir, left, right)
    when is_identity(program, type) then ir.assign("icmp eq ptr #{left}, #{right}")
    when type is OptionalType then emit_optional_equals(ir, program, left, right, type)
    when type is ObjectType and type.is_struct
      info := info_of(program, type)
      field_equals := (field: FieldInfo) ->
        load := (object: String) -> emit_borrowed_field(ir, object, info, field)
        nested(field.type!, load(left), load(right))
      all_of(ir, [field_equals(field) for field in info.fields])
    when is_one_of_kinds(type, [RECORD, TUPLE])
      value_equals := (value_type: Type, index: Int) ->
        load := (object: String) -> emit_borrowed_value(ir, object, type, index)
        nested(value_type, load(left), load(right))
      equals := [
        for each at i in value_types(type)
          value_equals(each, i)
      ]
      all_of(ir, equals)
    when type is ArrayType
      items := item_equals_function(ir.module, program, type.element)
      args := "ptr #{left}, ptr #{right}, ptr #{items}"
      call_runtime(ir, 'zeroext i1 @lerta_array_equals(ptr, ptr, ptr)', args)
    when type is MapType
      values :=
        if is_set(type)
          'null'
        else
          item_equals_function ir.module, program, type.value
      args := "ptr #{left}, ptr #{right}, ptr #{values}"
      call_runtime(ir, 'zeroext i1 @lerta_map_equals(ptr, ptr, ptr)', args)
    when type is UnionType then emit_union_equals(ir, program, left, right, type)
    else emit_value_equals(ir, left, right, type)

# Both nil, or both present and equal; a nil's value is unspecified (see
# docs/internals/memory.md).
emit_optional_equals := (
  ir: IrBuilder, program: ProgramWide, left: String, right: String, type: OptionalType
) ->
  left_present := emit_is_present(ir, left, type)
  right_present := emit_is_present(ir, right, type)
  both := ir.assign("and i1 #{left_present}, #{right_present}")
  neither := ir.assign("icmp eq i1 #{left_present}, #{right_present}")
  compare_values := ->
    left_value := emit_unwrap(ir, left, type)
    right_value := emit_unwrap(ir, right, type)
    emit_equals_by_contents(ir, program, left_value, right_value, type.inner)
  emit_branch(ir, 'i1', both, compare_values, neither)

# Members of the same type, compared as that member compares.
emit_union_equals := (
  ir: IrBuilder, program: ProgramWide, left: String, right: String, type: UnionType
) ->
  left_type := emit_object_type(ir, left)
  same_type := ir.assign("icmp eq ptr #{left_type}, #{emit_object_type(ir, right)}")
  compare_members := ->
    of_member := (member: Type) ->
      left_value := emit_member_value(ir, left, member)
      right_value := emit_member_value(ir, right, member)
      emit_equals_by_contents(ir, program, left_value, right_value, member)
    emit_member_dispatch(ir, left, type.members, 'i1', of_member)
  emit_branch(ir, 'i1', same_type, compare_members, 'false')

emit_hash := (ir: IrBuilder, program: ProgramWide, value: String, type: Type): String ->
  case
    when type is ObjectType and has_own_hash(program, type)
      emit_own_hash(ir, program, value, type)
    when is_value_type(type) then emit_value_hash(ir, value, type)
    when is_identity(program, type) then ir.assign("ptrtoint ptr #{value} to i64")
    when type is OptionalType
      # A nil holds no value to hash, as a null pointer.
      hash_inner := -> emit_hash_by_contents(ir, program, emit_unwrap(ir, value, type), type.inner)
      emit_branch(ir, 'i64', emit_is_present(ir, value, type), hash_inner, '0')
    when type is ObjectType and type.is_struct
      info := info_of(program, type)
      field_hash := (field: FieldInfo) ->
        loaded := emit_borrowed_field(ir, value, info, field)
        emit_hash_by_contents(ir, program, loaded, field.type!)
      combine(ir, [field_hash(field) for field in info.fields])
    when is_one_of_kinds(type, [RECORD, TUPLE])
      value_hash := (value_type: Type, index: Int) ->
        loaded := emit_borrowed_value(ir, value, type, index)
        emit_hash_by_contents(ir, program, loaded, value_type)
      hashes := [
        for each at i in value_types(type)
          value_hash(each, i)
      ]
      combine(ir, hashes)
    when type is ArrayType
      items := item_hash_function(ir.module, program, type.element)
      call_runtime(ir, 'i64 @lerta_array_hash(ptr, ptr)', "ptr #{value}, ptr #{items}")
    when type is UnionType
      of_member := (member: Type) ->
        emit_hash_by_contents(ir, program, emit_member_value(ir, value, member), member)
      emit_member_dispatch(ir, value, type.members, 'i64', of_member)
    else value

combine := (ir: IrBuilder, hashes: String[]) ->
  add := (result: String, hash: String) ->
    scaled := ir.assign("mul i64 #{result}, 31")
    ir.assign("add i64 #{scaled}, #{hash}")
  hashes.fold('17', add)

# Whether two values of a type that is neither a reference nor optional are equal: as bits, but a
# float's -0.0 equals 0.0.
export emit_value_equals := (ir: IrBuilder, left: String, right: String, type: Type) ->
  comparison := is_float(type) then 'fcmp oeq' else 'icmp eq'
  ir.assign("#{comparison} #{ir_type(type)} #{left}, #{right}")

# A value of a number, a Char, a Bool, a String, a Binary or an enum (see checker builtins).
is_value_type := (type: Type) ->
  scalar_of(type) != nil or is_one_of_kinds(type, ['String', 'Binary'])

emit_value_hash := (ir: IrBuilder, value: String, type: Type) ->
  if is_one_of_kinds(type, ['String', 'Binary'])
    return call_runtime(ir, 'i64 @lerta_string_hash(ptr)', "ptr #{value}")

  # Equal floats, as 0.0 and -0.0, hash alike.
  if is_float(type)
    return emit_float_word(ir, value, type)

  widened_to_word(ir, value, scalar_of(type)!)

# The Ordering of two numbers of the type, as an i64.
export emit_number_compare := (ir: IrBuilder, left: String, right: String, type: Type) ->
  signed := is_float(type) or is_signed(type)
  less := is_float(type) then 'fcmp olt' else "icmp #{signed then 'slt' else 'ult'}"
  operands := "#{ir_type(type)} #{left}, #{right}"
  is_less := ir.assign("#{less} #{operands}")
  is_equal := emit_value_equals(ir, left, right, type)
  not_less := ir.assign("select i1 #{is_equal}, i64 #{EQUAL}, i64 #{GREATER}")
  ir.assign("select i1 #{is_less}, i64 #{LESS}, i64 #{not_less}")
