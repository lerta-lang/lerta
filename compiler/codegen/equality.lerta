# `==` of values that compare by their contents (see checker/equality), and their hashes as map
# keys: a function for each type, defined at its first use, which borrows its operands. A part of
# such a value compares as `==` compares it: by value, by its bytes, or as the same object.
import { info_of } from '../checker/object_types'
import { ProgramWide } from '../checker/shared'
import { from_item } from './array'
import {
  emit_drop_function, emit_field_pointer, emit_member_dispatch, emit_record_field_pointer
} from './heap_object'
import { IrBuilder, IrModule } from './ir_builder'
import { ir_type } from './lerta_ir'
import { emit_is_present, emit_unwrap } from './optional'
import { call_runtime } from './runtime_calls'
import { emit_string_equals } from './string'
import {
  ArrayType, is_identity_type, is_one_of_kinds, ObjectType, OptionalType, RecordType, Type, type_key
  UnionType
} from '../types'

# An i1: whether the two values of the type are equal. A part that holds parts of its own is
# compared by its function, so that a type that holds itself is compared by a recursive call.
export const emit_equals_by_contents = (
  ir: IrBuilder, program: ProgramWide, left: String, right: String, type: Type
): String ->
  return emit_equals(ir, program, left, right, type) if is_whole(type)
  const symbol = equals_function(ir.module, program, type)
  ir.assign "call i1 #{symbol}(#{ir_type(type)} #{left}, #{ir_type(type)} #{right})"

const emit_hash_by_contents = (ir: IrBuilder, program: ProgramWide, value: String, type: Type) ->
  return emit_hash(ir, program, value, type) if is_whole(type)
  ir.assign "call i64 #{hash_function(ir.module, program, type)}(#{ir_type(type)} #{value})"

# A type whose values have no parts that compare on their own.
const is_whole = (type: Type) ->
  is_one_of_kinds(type, ['Int', 'Byte', 'Bool', 'String', 'Binary', ENUM]) or is_identity_type(type)

# The functions that compare and hash items of the type, as a map with keys of it takes them.
export const item_functions = (module: IrModule, program: ProgramWide, type: Type) ->
  const equals = item_equals_function(module, program, type)
  { equals, hash: item_hash_function(module, program, type) }

# The same object is equal to itself at once, which also ends `s == s` for a value that holds
# itself through an array; comparing two such distinct values, or hashing one, does not end.
const equals_function = (module: IrModule, program: ProgramWide, type: Type): String ->
  const define = (name: String, defined: IrModule) ->
    const ir = IrBuilder(module: defined)
    const compare = () -> emit_equals(ir, program, '%a', '%b', type)
    const result = if ir_type(type) == 'ptr'
      const differ = ir.assign('icmp ne ptr %a, %b')
      emit_branch ir, 'i1', differ, compare, 'true'
    else
      compare()
    ir.emit "ret i1 #{result}"
    ir.finish "i1 #{name}(#{ir_type(type)} %a, #{ir_type(type)} %b)"
  module.named "equals #{type_key(type)}", '@lerta.equals', define

const hash_function = (module: IrModule, program: ProgramWide, type: Type): String ->
  const define = (name: String, defined: IrModule) ->
    const ir = IrBuilder(module: defined)
    ir.emit "ret i64 #{emit_hash(ir, program, '%a', type)}"
    ir.finish "i64 #{name}(#{ir_type(type)} %a)"
  module.named "hash #{type_key(type)}", '@lerta.hash', define

const item_equals_function = (module: IrModule, program: ProgramWide, type: Type) ->
  const define = (name: String, defined: IrModule) ->
    const ir = IrBuilder(module: defined)
    const left = from_item(ir, '%a', type)
    const right = from_item(ir, '%b', type)
    ir.emit "ret i1 #{emit_equals(ir, program, left, right, type)}"
    ir.finish "zeroext i1 #{name}(i64 %a, i64 %b)"
  module.named "item equals #{type_key(type)}", '@lerta.item_equals', define

const item_hash_function = (module: IrModule, program: ProgramWide, type: Type) ->
  const define = (name: String, defined: IrModule) ->
    const ir = IrBuilder(module: defined)
    ir.emit "ret i64 #{emit_hash(ir, program, from_item(ir, '%a', type), type)}"
    ir.finish "i64 #{name}(i64 %a)"
  module.named "item hash #{type_key(type)}", '@lerta.item_hash', define

const emit_equals = (
  ir: IrBuilder, program: ProgramWide, left: String, right: String, type: Type
): String ->
  const nested = (part: Type, a: String, b: String) ->
    emit_equals_by_contents ir, program, a, b, part
  case
    when is_one_of_kinds(type, ['String', 'Binary']) then emit_string_equals(ir, left, right)
    when is_identity_type(type) then ir.assign("icmp eq ptr #{left}, #{right}")
    when type is OptionalType then emit_optional_equals(ir, program, left, right, type)
    when type is ObjectType and type.is_struct
      const info = info_of(program, type)
      const field_equals = (name: String, field_type: Type) ->
        const load = (object: String) ->
          ir.assign "load #{ir_type(field_type)}, ptr #{emit_field_pointer(ir, object, info, name)}"
        nested field_type, load(left), load(right)
      all_of ir, [field_equals(field.name.name, field.type!) for field in info.fields]
    when type is RecordType
      const field_equals = (index: Int) ->
        const field_type = type.fields[index].type
        const load = (record: String) ->
          const pointer = emit_record_field_pointer(ir, record, type, index)
          ir.assign "load #{ir_type(field_type)}, ptr #{pointer}"
        nested field_type, load(left), load(right)
      all_of ir, [field_equals(i) for i in 0...type.fields.length]
    when type is ArrayType
      const items = item_equals_function(ir.module, program, type.element)
      const args = "ptr #{left}, ptr #{right}, ptr #{items}"
      call_runtime ir, 'zeroext i1 @lerta_array_equals(ptr, ptr, ptr)', args
    when type is UnionType then emit_union_equals(ir, program, left, right, type)
    else ir.assign("icmp eq #{ir_type(type)} #{left}, #{right}")

# Both nil, or both present and equal. A nil of a value type may hold any value, as one from C may.
const emit_optional_equals = (
  ir: IrBuilder, program: ProgramWide, left: String, right: String, type: OptionalType
) ->
  const left_present = emit_is_present(ir, left, type)
  const right_present = emit_is_present(ir, right, type)
  const both = ir.assign("and i1 #{left_present}, #{right_present}")
  const neither = ir.assign("icmp eq i1 #{left_present}, #{right_present}")
  const compare_values = () ->
    const values = [emit_unwrap(ir, left, type), emit_unwrap(ir, right, type)]
    emit_equals_by_contents ir, program, values[0], values[1], type.inner
  emit_branch ir, 'i1', both, compare_values, neither

# Members of the same type, compared as that member compares.
const emit_union_equals = (
  ir: IrBuilder, program: ProgramWide, left: String, right: String, type: UnionType
) ->
  const left_type = emit_drop_function(ir, left)
  const same_type = ir.assign("icmp eq ptr #{left_type}, #{emit_drop_function(ir, right)}")
  const compare_members = () ->
    const of_member = (member: Type) -> emit_equals_by_contents(ir, program, left, right, member)
    emit_member_dispatch ir, left, type.members, 'i1', of_member
  emit_branch ir, 'i1', same_type, compare_members, 'false'

# A value of the IR type: `then_value` where the condition holds, computed only there, and
# `otherwise` elsewhere.
const emit_branch = (
  ir: IrBuilder, type: String, condition: String, then_value: () -> String, otherwise: String
) ->
  const from = ir.current_block
  const then_label = ir.fresh_label('equals.then')
  const end_label = ir.fresh_label('equals.end')
  ir.emit "br i1 #{condition}, label %#{then_label}, label %#{end_label}"
  ir.start_block then_label
  const value = then_value()
  const value_block = ir.current_block
  ir.emit "br label %#{end_label}"
  ir.start_block end_label
  ir.assign "phi #{type} [ #{otherwise}, %#{from} ], [ #{value}, %#{value_block} ]"

const all_of = (ir: IrBuilder, tests: Array<String>) ->
  var all = 'true'
  all = ir.assign("and i1 #{all}, #{test}") for test in tests
  all

const emit_hash = (ir: IrBuilder, program: ProgramWide, value: String, type: Type): String ->
  case
    when is_one_of_kinds(type, ['String', 'Binary'])
      call_runtime ir, 'i64 @lerta_string_hash(ptr)', "ptr #{value}"
    when is_one_of_kinds(type, ['Bool', 'Byte'])
      ir.assign "zext #{ir_type(type)} #{value} to i64"
    when is_identity_type(type) then ir.assign("ptrtoint ptr #{value} to i64")
    when type is OptionalType
      # A nil holds no value to hash, as a null pointer.
      const hash_inner = () ->
        emit_hash_by_contents ir, program, emit_unwrap(ir, value, type), type.inner
      emit_branch ir, 'i64', emit_is_present(ir, value, type), hash_inner, '0'
    when type is ObjectType and type.is_struct
      const info = info_of(program, type)
      const field_hash = (name: String, field_type: Type) ->
        const pointer = emit_field_pointer(ir, value, info, name)
        const loaded = ir.assign("load #{ir_type(field_type)}, ptr #{pointer}")
        emit_hash_by_contents ir, program, loaded, field_type
      combine ir, [field_hash(field.name.name, field.type!) for field in info.fields]
    when type is RecordType
      const field_hash = (index: Int) ->
        const field_type = type.fields[index].type
        const pointer = emit_record_field_pointer(ir, value, type, index)
        const loaded = ir.assign("load #{ir_type(field_type)}, ptr #{pointer}")
        emit_hash_by_contents ir, program, loaded, field_type
      combine ir, [field_hash(i) for i in 0...type.fields.length]
    when type is ArrayType
      const items = item_hash_function(ir.module, program, type.element)
      call_runtime ir, 'i64 @lerta_array_hash(ptr, ptr)', "ptr #{value}, ptr #{items}"
    when type is UnionType
      const of_member = (member: Type) -> emit_hash_by_contents(ir, program, value, member)
      emit_member_dispatch ir, value, type.members, 'i64', of_member
    else value

const combine = (ir: IrBuilder, hashes: Array<String>) ->
  var result = '17'
  for hash in hashes
    const scaled = ir.assign("mul i64 #{result}, 31")
    result = ir.assign("add i64 #{scaled}, #{hash}")
  result
