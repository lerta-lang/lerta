# Top-level values in the generated code. Each is a global, which the top-level code initializes
# and functions read; a flag, set once it is initialized, lets a function that runs before then
# throw instead of reading it.
import { Shared } from '../checker/shared'
import { top_level_value } from '../checker/top_level_values'
import { Module } from '../loader'
import { TopLevelGlobal } from './generator'
import { emit_throw } from './runtime_calls'
import { IrBuilder, IrModule } from './ir_builder'
import { emit_release, ir_type, string_constant, top_level_symbol } from './lerta_ir'
import { is_reference_type } from '../types'

export const define_top_level_globals = (ir_module: IrModule, module: Module, shared: Shared) ->
  const globals: Map<String, TopLevelGlobal> = Map()
  for statement in module.program
    const declaration = top_level_value(statement) ? continue
    const name = declaration.name.name
    const type = shared.types[declaration.name]!
    const pointer = top_level_symbol(module.index, name)
    const flag = "#{pointer}.set"
    ir_module.define_global(pointer, "internal global #{ir_type(type)} zeroinitializer")
    ir_module.define_global(flag, 'internal global i1 false')
    globals[name] = TopLevelGlobal(name, type, pointer, flag)
  globals

export const emit_mark_initialized = (ir: IrBuilder, global: TopLevelGlobal) ->
  ir.emit("store i1 true, ptr #{global.flag}")

# Throws unless the value has been initialized.
export const emit_initialized_check = (ir: IrBuilder, global: TopLevelGlobal) ->
  const is_set = ir.assign("load i1, ptr #{global.flag}")
  const set_label = ir.fresh_label('value.set')
  const unset_label = ir.fresh_label('value.unset')
  ir.emit("br i1 #{is_set}, label %#{set_label}, label %#{unset_label}")
  ir.start_block(unset_label)
  const message = string_constant(ir, "'#{global.name}' is used before it is initialized")
  emit_throw ir, message
  ir.emit('unreachable')
  ir.start_block(set_label)

# At the end of the program, the references the values hold.
export const emit_release_globals = (ir: IrBuilder, globals: Array<TopLevelGlobal>) ->
  for global in globals
    emit_release ir, ir.assign("load ptr, ptr #{global.pointer}") if is_reference_type(global.type)
