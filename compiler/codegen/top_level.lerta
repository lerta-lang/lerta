# Top-level values in the generated code (see docs/internals/compiler.md#modules).
import BooleanLiteral, Declaration, FloatLiteral, IntegerLiteral from '../ast'
import Shared from '../checker/shared'
import top_level_value from '../checker/top_level_values'
import Module from '../loader'
import top_level_tag from './alias_tags'
import Generator, TopLevelGlobal from './generator'
import throw_if from './runtime_errors'
import IrBuilder, IrModule from './ir_builder'
import
  constant_operand, emit_release_stored, ir_type, ownership, suffixed_symbol, top_level_symbol
from './lerta_ir'
import scalar_literal from './scalar'
import format_type, Type from '../types'

export define_top_level_globals := (ir_module: IrModule, module: Module, shared: Shared) ->
  globals: Map<String, TopLevelGlobal>
  for statement in module.program
    declaration := top_level_value(statement) else continue
    name := declaration.name.name
    type := shared.facts.types[declaration.name]!
    pointer := top_level_symbol(module.symbol_name, name)
    flag := suffixed_symbol(pointer, 'set')

    # A const that is a literal keeps its slot, which no read reads, so that its declaration is
    # generated as any other's.
    ir_module.define_variable pointer, ir_type(type), 'zeroinitializer'
    ir_module.define_variable flag, 'i1', 'false'

    constant := constant_of(declaration, type, shared)
    globals[name] = { name, type, pointer, flag, is_var: declaration.mutable, constant }
  globals

# The operand of the const's value, if it is of its own type and a constant expression (see
# checker/constants) or a literal, a Bool or a number: such a const is initialized from the start
# and never released, so that reading it, in its module or another, checks nothing. The value is
# known only to its module's facts, so its operand is worked out here, but for a String's, which
# each IR module defines for itself.
constant_of := (declaration: Declaration, type: Type, shared: Shared): ((IrBuilder) -> String)? ->
  return nil if declaration.mutable
  value := declaration.value
  return nil if format_type(shared.facts.types[value]!) != format_type(type)
  if constant := shared.facts.constants[value]
    return (ir) -> constant_operand(ir, constant)
  case value
    when BooleanLiteral, FloatLiteral, IntegerLiteral
      operand := scalar_literal(value, type)
      (_) -> operand
    else nil

export emit_mark_initialized := (ir: IrBuilder, global: TopLevelGlobal) ->
  ir.store 'i1', 'true', global.flag, top_level_tag(ir)

# Throws an InitError unless the value has been initialized.
export emit_initialized_check := (g: Generator, global: TopLevelGlobal) ->
  is_set := g.ir.load('i1', global.flag, top_level_tag(g.ir))
  is_unset := g.ir.negate(is_set)
  message := "'#{global.name}' is used before it is initialized"
  throw_if g, is_unset, { message, type_name: 'InitError' }

# At the end of the program, the references the values hold. Each value is unset first, so that a
# deinit run by the releases fails the initialized check instead of reading a released value.
export emit_release_globals := (ir: IrBuilder, globals: TopLevelGlobal[]) ->
  for global in globals
    ir.store 'i1', 'false', global.flag, top_level_tag(ir)
    emit_release_stored ir, global.pointer, ir_type(global.type), ownership(global.type)
