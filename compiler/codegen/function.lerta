# Generates a function of a program: its body and its returns; statement generates its
# statements, control_flow control flow, and constructor constructors.
import Expression, FunctionLiteral, Statement from '../ast'
import required_params from '../checker/functions'
import Capture from '../checker/shared'
import emit_await_owned, emit_loop_run, generate_awaiting_function from './awaiting'
import call_user_function from './call'
import
  capture_slot, emit_capture_pointer, emit_closure, emit_closure_call, emit_local_closure,
  emit_static_closure, function_type_of
from './closure'
import emit_suspend from './coroutine'
import nan_free_operations from './float_ranges'
import
  emit_assume_no_exception, emit_exception_check, leave_scopes, while_holding
from './exceptions'
import emit_deferred_check, held_value, read_borrowed, read_local from './local'
import generate, type_at_use, type_of from './expression'
import
  CellSlot, CodegenLocal, function_generator, Generator, SlotLocal, TopLevelGlobal, ValueLocal
from './generator'
import
  access_tag, emit_cell_pointer, emit_weak_box_of, emit_weak_object, fixed, HeapField, value_field
from './heap_object'
import IrBuilder, IrModule from './ir_builder'
import
  default_entry_symbol, emit_release, emit_retain, emit_retain_value, ir_return_type, ir_type,
  returns_nothing, typed_params
from './lerta_ir'
import referred_local from './references'
import call_void_runtime from './runtime_calls'
import emit_release_globals from './top_level'
import generate_yielding_function from './yielding'
import is_kind, iterable_item, PromiseType, Type, void_type from '../types'
import generate_block, generate_statement, generate_statements, store_in_slot from './statement'

# A module's top-level code: the symbol of its function, and whether it awaits, which makes the
# function return a Promise.
export struct TopLevelCode
  symbol: String
  awaits: Bool

# The module's top-level code, after that of the modules in `runs_first`, which it awaits where
# needed. The entry module's, the program's, then runs the event loop, and releases the values of
# all modules; if it awaits, the program's top-level code is a coroutine of its own, which the loop
# must finish.
export generate_main := (
  g: Generator, statements: Statement[], code: TopLevelCode, runs_first: TopLevelCode[],
  releases: TopLevelGlobal[], is_program: Bool
) ->
  g.nan_free = nan_free_operations(g.facts, statements, true)
  run := ->
    for first in runs_first
      if first.awaits
        emit_await_owned g, g.ir.assign("call ptr #{first.symbol}()"), void_type
      else
        g.ir.emit "call void #{first.symbol}()"
        emit_exception_check g
    generate_block g, statements
  unless code.awaits
    run()
    emit_loop_run g.ir if is_program
    emit_release_globals g.ir, releases
    g.ir.emit 'ret void'
    finish g, is_program then PROGRAM_MAIN else "void #{code.symbol}()"
    return
  run_and_return := ->
    run()
    emit_return g, '', void_type
  body := is_program then '@lerta.top_level' else code.symbol
  generate_awaiting_function g, '', body, [], void_type, run_and_return
  if is_program
    generate_program_main g.ir.module, body, releases

# Runs the program's top-level code, a coroutine, and the event loop, which must settle it; its
# exception is the program's, which ends it as soon as it is thrown.
generate_program_main := (module: IrModule, body: String, releases: TopLevelGlobal[]) ->
  ir := IrBuilder(module)
  promise := ir.assign("call ptr #{body}()")
  call_void_runtime ir, 'void @lerta_watch_top_level(ptr)', "ptr #{promise}"
  emit_loop_run ir
  call_void_runtime ir, 'void @lerta_finish_top_level(ptr)', "ptr #{promise}"
  emit_release ir, promise
  emit_release_globals ir, releases
  ir.emit 'ret void'
  ir.finish PROGRAM_MAIN

# The program's top-level code, which the runtime calls.
PROGRAM_MAIN := 'external void @lerta_main()'

# Defines nothing, for a block that declares no locals besides its statements'.
export no_locals := (_scope: Map<String, CodegenLocal>) -> return

# A function literal in an expression: its code, generated as a function of its own, and a new
# closure of it with the values it captures. The closure of one that never outlives the call that
# makes it, `is_local`, is on the stack (see emit_local_closure), unless it captures a weak local,
# whose box it would have to make and hold, or it yields or awaits, as the Iter or the Promise that
# a call of it gives holds the closure.
export generate_closure := (g: Generator, literal: FunctionLiteral, is_local = false) ->
  captures := g.facts.captures[literal]!
  name := "#{g.function_name}.<anonymous>"
  symbol := literal_symbol(g, literal, name, captures)
  return emit_static_closure(g.ir, symbol) if captures.is_empty()
  local_of := (capture: Capture) -> referred_local(g, capture.source, capture.name)
  is_weak := (capture: Capture) -> capture.is_weak or local_of(capture).weak
  is_coroutine := literal.yields or is_awaiting(g, literal)
  on_stack := is_local and not is_coroutine and not literal.weak and not captures.any(is_weak)

  # A float that holds a NaN throws before any capture is retained, so that none is left held.
  for capture in captures
    unless capture.is_var
      emit_deferred_check g, local_of(capture)

  slots: HeapField[]
  operands: String[]
  for capture in captures
    local := local_of(capture)
    slots.push capture_slot(g.code.program, capture)
    unless capture.is_var
      borrowed := -> read_borrowed(g, local, capture.type)
      operand := on_stack then borrowed() else captured_value(g, local, capture)
      operands.push operand
      continue
    cell := local is SlotLocal then local.cell
    owned := cell else panic("the captured var '#{capture.name}' has no cell")
    emit_retain g.ir, owned.cell unless on_stack
    operands.push owned.cell
  if on_stack
    return emit_local_closure(g.ir, symbol, slots, operands)
  emit_closure(g.ir, symbol, name, slots, operands)

# The code of the literal, generated once outside the loops that take functions in place; within
# them, as many times as the code it is in is copied (see fusion).
literal_symbol := (g: Generator, literal: FunctionLiteral, name: String, captures: Capture[]) ->
  symbols: Map<FunctionLiteral, String>? = g.fusion.literals.is_empty() then shared_symbols(g)
  if symbols
    return found if found := symbols[literal]

  # Its symbol is numbered within the module.
  symbol := g.code.ir_module.fresh_symbol('lerta.lambda')
  symbols[literal] = symbol if symbols

  body_generator := function_generator(g.code, g.extensions, g.facts, name)
  body_generator.fusion = g.fusion
  generate_function body_generator, 'private ', symbol, literal, nil, captures
  symbol

shared_symbols := (g: Generator) ->
  symbols := g.code.literal_symbols
  return found if found := symbols[g.facts]
  added: Map<FunctionLiteral, String>
  symbols[g.facts] = added
  added

# The function value, an owned closure of the type `source`, as one of the type `target` that calls
# it and settles the Promise that it returns with its result (see settles_into): a new closure,
# which holds the one it calls.
export emit_settling_closure := (g: Generator, closure: String, source: Type, target: Type) ->
  symbol := g.code.ir_module.fresh_symbol('lerta.settling')
  name := "#{g.function_name}.<settling>"
  body_generator := function_generator(g.code, g.extensions, g.facts, name)
  { params } := function_type_of(source)
  value := (function_type_of(target).result as PromiseType!).value
  slots := [fixed(value_field(g.code.program, source))]
  args := ["%p#{i}" for _ at i in params]
  generate_body := ->
    ir := body_generator.ir
    pointer := emit_capture_pointer(ir, '%closure', slots, 0)
    callee := ir.load('ptr', pointer, access_tag(ir, slots[0]))
    result := emit_closure_call(ir, callee, source, args)
    emit_exception_check body_generator
    emit_return body_generator, result, value
  all_params := ['ptr %closure', typed_params(g.code.program, params)...]
  generate_awaiting_function body_generator, 'private ', symbol, all_params, value, generate_body
  emit_closure(g.ir, symbol, name, slots, [closure])

# The value a function literal captures, owned: the box of a weak local, or of `@` for a weak
# literal, rather than its object.
captured_value := (g: Generator, local: CodegenLocal, capture: Capture) ->
  type := capture.type
  if local.weak
    box := held_value(g, local)
    emit_retain g.ir, box
    return box
  value := read_local(g, local, type)
  return value unless capture.is_weak
  box := weak_box_of(g, value, type)
  emit_release g.ir, value
  box

# A weak literal's `@`, captured as its box, is its object for the whole call, which does nothing if
# the object is gone.
hold_weak_this := (g: Generator, scope: Map<String, CodegenLocal>) ->
  captured := scope['@'] else return
  ir := g.ir
  object := emit_weak_object(ir, held_value(g, captured))
  gone_label := ir.fresh_label('weak.gone')
  alive_label := ir.fresh_label('weak.alive')
  is_gone := ir.is_null(object)
  ir.branch_if is_gone, gone_label, alive_label
  ir.start_block gone_label
  emit_return g, '', void_type
  ir.start_block alive_label
  emit_retain ir, object
  scope['@'] = store_in_slot(g, object, captured.type)

# Parameters are borrowed SSA values; a method gets its object first, as `@`, and a function
# literal its closure, from which it reads the values it captures. The last statement, if an
# expression, gives the result. A function that yields returns an Iter that runs its body, and one
# that awaits a Promise that the body settles (see yielding and awaiting). The function and its
# entries for defaults have the linkage (see Definition), unless `with_defaults` is false, as for
# an instance whose defaults no call uses (see check_instance_defaults).
export generate_function := (
  g: Generator
  linkage: String
  symbol: String
  literal: FunctionLiteral
  this_type: Type?
  captures: Capture[]?
  with_defaults = true
) ->
  type := function_type_of(type_of(g, literal))
  g.ir.declared_at = literal.position
  params: String[]
  params.push 'ptr %closure' if captures != nil
  params.push "#{ir_type(g.code.program, this_type)} %this" if this_type
  params.append typed_params(g.code.program, type.params)
  generate_body := (result: Type) -> generate_function_body(g, literal, this_type, captures, result)
  if literal.yields
    item := iterable_item(type.result)!
    generate_yielding_function g, linkage, symbol, params, item, -> generate_body(void_type)
  else if is_awaiting(g, literal)
    value := (type.result as PromiseType!).value
    generate_awaiting_function g, linkage, symbol, params, value, -> generate_body(value)
  else
    g.result_type = type.result
    generate_body type.result

    # A function that never returns throws or ends the program: a cold path, kept out of its
    # callers, so that those stay short enough to be inlined themselves.
    attributes := is_kind(type.result, 'never') then ' cold noinline' else ''
    result_type := ir_return_type(g.code.program, type.result)
    signature := "#{result_type} #{symbol}(#{params.join(', ')})#{attributes}"
    finish g, "#{linkage}#{signature}"
  fewest := with_defaults then required_params(literal) else literal.params.length
  for given in fewest..literal.params.length
    entry_generator := function_generator(g.code, g.extensions, g.facts, g.function_name)
    generate_default_entry entry_generator, linkage, symbol, literal, this_type, given

# Whether the function returns a Promise that its body settles: one that awaits, or one that
# settles it without awaiting (see NodeFacts.settling).
export is_awaiting := (g: Generator, literal: FunctionLiteral) ->
  literal.awaits or literal in g.facts.settling

# The body of a coroutine may run after its call returns, so it holds its parameters, its object
# and its closure, which its scope releases; that of a function that yields waits for its first
# item to be asked for before running its statements. `result` is what its last statement gives.
generate_function_body := (
  g: Generator, literal: FunctionLiteral, this_type: Type?, captures: Capture[]?, result: Type
) ->
  type := function_type_of(type_of(g, literal))
  ir := g.ir
  g.nan_free = nan_free_operations(g.facts, literal.body, false)
  holds := g.coroutine != nil
  emit_assume_no_exception ir

  # A local function that sees itself is its own closure, outside its parameters and locals, which
  # may hide it; the closure outlives the call, held as `(closure)` by a coroutine.
  itself := literal in g.facts.sees_itself then g.facts.local_function_names[literal]
  if itself
    g.locals.push()[itself.name] = ValueLocal(type, operand: '%closure')

  scope := g.locals.push()
  bind := (name: String, operand: String, local_type: Type) ->
    unless holds
      scope[name] = ValueLocal(operand, type: local_type)
      return
    emit_retain_value ir, operand, local_type
    scope[name] = store_in_slot(g, operand, local_type)
  if this_type
    bind '@', '%this', this_type
  for param at i in literal.params
    bind param.name.name, "%p#{i}", type.params[i]

  # The name cannot be written in the source, so no code can read it.
  if holds and captures != nil
    bind '(closure)', '%closure', type

  # A captured var is its cell, which the closure holds; the literal reads and writes through it.
  captured := captures else []
  slots := [
    for capture in captured
      capture_slot(ir.program, capture)
  ]
  for capture at i in captured
    { name, type, is_var } := capture
    pointer := emit_capture_pointer(ir, '%closure', slots, i)
    value := ir.load(slots[i].ir_type, pointer, access_tag(ir, slots[i]))
    cell := CellSlot(cell: value, is_owned: false)
    weak := capture.is_weak
    scope[name] =
      if is_var
        SlotLocal type, cell, weak, is_var, pointer: emit_cell_pointer(ir, type, value)
      else
        ValueLocal type, weak, operand: value

  hold_weak_this g, scope if literal.weak
  emit_suspend g if literal.yields
  generate_body_returning_last g, literal.body, result
  g.locals.pop()
  g.locals.pop() if itself

# The entry that takes the first `given` arguments, borrowed, and the object of a method; computes
# the defaults of the others in order, each seeing `@` and the parameters before it; and calls the
# function with them all.
generate_default_entry := (
  g: Generator, linkage: String, symbol: String, literal: FunctionLiteral, this_type: Type?,
  given: Int
) ->
  type := function_type_of(type_of(g, literal))
  g.result_type = type.result
  scope := g.locals.push()
  if this_type
    scope['@'] = ValueLocal(operand: '%this', type: this_type)
  operands := [
    for param at i in literal.params
      param_type := type.params[i]
      if i < given
        scope[param.name.name] = ValueLocal(operand: "%p#{i}", type: param_type)
        "%p#{i}"
      else
        value := generate(g, param.default!)
        scope[param.name.name] = store_in_slot(g, value, param_type)
        value
  ]
  args: String[]
  args.push "#{ir_type(g.code.program, this_type)} %this" if this_type
  for (param, operand) in type.params.zip(operands)
    args.push "#{ir_type(g.code.program, param)} #{operand}"
  result := call_user_function(g.ir, symbol, type, args.join(', '))
  emit_exception_check g
  emit_return g, result, type.result
  g.locals.pop()
  params: String[]
  params.push "#{ir_type(g.code.program, this_type)} %this" if this_type
  params.append typed_params(g.code.program, type.params[..given])
  entry := default_entry_symbol(symbol, given)
  finish
    g
    "#{linkage}#{ir_return_type(g.code.program, type.result)} #{entry}(#{params.join(', ')})"

# The statements of a function's body, the last returning its value, if it is an expression and the
# function has a result.
export generate_body_returning_last := (g: Generator, body: Statement[], result: Type) ->
  generate_statements g, body.all_but_last()
  has_result := not is_kind(result, 'void')
  last := body.last()
  value := last as Expression?
  if value and has_result
    return emit_return(g, generate(g, value), type_at_use(g, value))
  generate_statement g, last if last
  if has_result
    g.ir.emit 'unreachable'
  else
    emit_return g, '', void_type

# A weak local or field holds the box of its object, which stays borrowed.
export weak_box_of := (g: Generator, object: String, type: Type) ->
  emit_weak_box_of(g.ir, g.code.program, object, type)

export finish := (g: Generator, signature: String) -> g.ir.finish(signature)

# Releases every scope of the function, running the finally blocks of the `try` blocks it leaves,
# while it holds the owned value of the type, which it then returns. The function's result type
# decides the instruction: a returned value that never comes (`return throw ...`) is poison. The
# body of a coroutine gives its value to `on_return`, if any, and goes to its end instead.
export emit_return := (g: Generator, value: String, type: Type): void ->
  while_holding g, value, type, -> leave_scopes(g, 0)
  on_return value if on_return := g.on_return
  if exit := g.fused_exit
    g.ir.branch exit.label
    return
  if coroutine := g.coroutine
    g.ir.branch coroutine.end_label
    return
  result := g.result_type
  g.ir.emit
    returns_nothing(result) then 'ret void' else "ret #{ir_type(g.code.program, result)} #{value}"
