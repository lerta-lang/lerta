# Generates a function of a program: its blocks, declarations, returns and constructors;
# control_flow generates control flow, and assignment assignments.
import
  Assignment, BinaryOperation, Declaration, EnumDeclaration, Expression, Extend, Extern, Intrinsic,
  For, FunctionLiteral, If, Import, InterfaceDeclaration, Jump, NilLiteral, Pass, Return, Statement,
  TypeAlias, TypeDeclaration, While
from '../ast'
import required_params from '../checker/functions'
import FieldInfo, is_argument, ObjectInfo from '../checker/object_types'
import Capture from '../checker/shared'
import top_level_tag from './alias_tags'
import generate_assignment from './assignment'
import batched_field_writes, generate_batched_field_writes from './batched_writes'
import generate_borrowed_value, is_borrowable_in_scope from './borrowing'
import emit_await_owned, emit_loop_run, generate_awaiting_function from './awaiting'
import call_user_function from './call'
import float_tree from './operator'
import
  capture_slot, emit_capture_pointer, emit_closure, emit_closure_call, emit_local_closure,
  emit_static_closure, function_type_of
from './closure'
import generate_control_jump, generate_for, generate_if, generate_while from './control_flow'
import emit_suspend from './coroutine'
import nan_free_operations from './float_ranges'
import emit_exception_check, leave_scopes, while_holding from './exceptions'
import
  emit_deferred_check, generate, held_value, read_borrowed, read_local, release_if_reference,
  type_at_use, type_of
from './expression'
import
  CellSlot, CodegenLocal, function_generator, Generator, located, SlotLocal, TopLevelGlobal,
  with_deferred_checks, ValueLocal
from './generator'
import is_fused_source from './inlined_methods'
import
  access_tag, emit_allocate, emit_cell, emit_cell_pointer, emit_field_pointer, emit_weak_box_of,
  emit_weak_object, emit_weak_slot_or_null, fixed, HeapField, value_field
from './heap_object'
import emit_when, IrBuilder, IrModule from './ir_builder'
import
  constructor_symbol, default_entry_symbol, emit_release, emit_release_stored, emit_retain,
  emit_retain_value, ir_return_type, ir_type, ownership, returns_nothing, special_method_symbol,
  typed_params
from './lerta_ir'
import referred_local, top_level_slot from './references'
import call_runtime, call_void_runtime from './runtime_calls'
import emit_mark_initialized, emit_release_globals from './top_level'
import generate_yielding_function from './yielding'
import is_kind, iterable_item, PromiseType, Type, void_type from '../types'

# A module's top-level code: the symbol of its function, and whether it awaits, which makes the
# function return a Promise.
export struct TopLevelCode
  symbol: String
  awaits: Bool

# The module's top-level code, after that of the modules in `runs_first`, which it awaits where
# needed. The entry module's, the program's, then runs the event loop, and releases the values of
# all modules; if it awaits, the program's top-level code is a coroutine of its own, which the loop
# must finish.
export generate_main := (
  g: Generator, statements: Statement[], code: TopLevelCode, runs_first: TopLevelCode[],
  releases: TopLevelGlobal[], is_program: Bool
) ->
  g.nan_free = nan_free_operations(g.facts, statements, true)
  run := ->
    for first in runs_first
      if first.awaits
        emit_await_owned g, g.ir.assign("call ptr #{first.symbol}()"), void_type
      else
        g.ir.emit "call void #{first.symbol}()"
        emit_exception_check g
    generate_block g, statements
  unless code.awaits
    run()
    emit_loop_run g.ir if is_program
    emit_release_globals g.ir, releases
    g.ir.emit 'ret void'
    finish g, is_program then PROGRAM_MAIN else "void #{code.symbol}()"
    return
  run_and_return := ->
    run()
    emit_return g, '', void_type
  body := is_program then '@lerta.top_level' else code.symbol
  generate_awaiting_function g, '', body, [], void_type, run_and_return
  generate_program_main g.ir.module, body, releases if is_program

# Runs the program's top-level code, a coroutine, and the event loop, which must settle it; its
# exception is the program's, which ends it as soon as it is thrown.
generate_program_main := (module: IrModule, body: String, releases: TopLevelGlobal[]) ->
  ir := IrBuilder(module)
  promise := ir.assign("call ptr #{body}()")
  call_void_runtime ir, 'void @lerta_watch_top_level(ptr)', "ptr #{promise}"
  emit_loop_run ir
  call_void_runtime ir, 'void @lerta_finish_top_level(ptr)', "ptr #{promise}"
  emit_release ir, promise
  emit_release_globals ir, releases
  ir.emit 'ret void'
  ir.finish PROGRAM_MAIN

# The program's top-level code, which the runtime calls.
PROGRAM_MAIN := 'external void @lerta_main()'

# Defines nothing, for a block that declares no locals besides its statements'.
export no_locals := (_scope: Map<String, CodegenLocal>) -> return

# A function literal in an expression: its code, generated as a function of its own, and a new
# closure of it with the values it captures. The closure of one that never outlives the call that
# makes it, `is_local`, is on the stack (see emit_local_closure), unless it captures a weak local,
# whose box it would have to make and hold, or it yields or awaits, as the Iter or the Promise that
# a call of it gives holds the closure.
export generate_closure := (g: Generator, literal: FunctionLiteral, is_local = false) ->
  captures := g.facts.captures[literal]!
  symbol := g.code.ir_module.fresh_symbol('lerta.lambda')
  name := "#{g.function_name}.<anonymous>"
  body_generator := function_generator(g.code, g.extensions, g.facts, name)
  # It is generated within the functions taken in place around it, and copied as many times as the
  # code it is in (see fusion).
  body_generator.fusion = g.fusion
  # Its symbol is numbered within the module.
  generate_function body_generator, 'private ', symbol, literal, nil, captures
  return emit_static_closure(g.ir, symbol) if captures.is_empty()
  local_of := (capture: Capture) -> referred_local(g, capture.source, capture.name)
  is_weak := (capture: Capture) -> capture.is_weak or local_of(capture).weak
  is_coroutine := literal.yields or is_awaiting(g, literal)
  on_stack := is_local and not is_coroutine and not literal.weak and not captures.any(is_weak)
  # A float that holds a NaN throws before any capture is retained, so that none is left held.
  for capture in captures
    emit_deferred_check g, local_of(capture) unless capture.is_var
  slots: HeapField[]
  operands: String[]
  for capture in captures
    local := local_of(capture)
    slots.push capture_slot(capture)
    unless capture.is_var
      borrowed := -> read_borrowed(g, local, capture.type)
      operands.push on_stack then borrowed() else captured_value(g, local, capture)
      continue
    cell := local is SlotLocal then local.cell
    owned := cell ? panic("the captured var '#{capture.name}' has no cell")
    emit_retain g.ir, owned.cell unless on_stack
    operands.push owned.cell
  return emit_local_closure(g.ir, symbol, slots, operands) if on_stack
  emit_closure g.ir, symbol, name, slots, operands

# The function value, an owned closure of the type `source`, as one of the type `target` that calls
# it and settles the Promise that it returns with its result (see settles_into): a new closure,
# which holds the one it calls.
export emit_settling_closure := (g: Generator, closure: String, source: Type, target: Type) ->
  symbol := g.code.ir_module.fresh_symbol('lerta.settling')
  name := "#{g.function_name}.<settling>"
  body_generator := function_generator(g.code, g.extensions, g.facts, name)
  { params } := function_type_of(source)
  value := (function_type_of(target).result as PromiseType!).value
  slots := [fixed(value_field(source))]
  args := ["%p#{i}" for _ at i in params]
  generate_body := ->
    ir := body_generator.ir
    pointer := emit_capture_pointer(ir, '%closure', slots, 0)
    callee := ir.load('ptr', pointer, access_tag(ir, slots[0]))
    result := emit_closure_call(ir, callee, source, args)
    emit_exception_check body_generator
    emit_return body_generator, result, value
  all_params := ['ptr %closure', typed_params(params)...]
  generate_awaiting_function body_generator, 'private ', symbol, all_params, value, generate_body
  emit_closure g.ir, symbol, name, slots, [closure]

# The value a function literal captures, owned: the box of a weak local, or of `@` for a weak
# literal, rather than its object.
captured_value := (g: Generator, local: CodegenLocal, capture: Capture) ->
  type := capture.type
  if local.weak
    box := held_value(g, local)
    emit_retain g.ir, box
    return box
  value := read_local(g, local, type)
  return value unless capture.is_weak
  box := weak_box_of(g, value, type)
  emit_release g.ir, value
  box

# A weak literal's `@`, captured as its box, is its object for the whole call, which does nothing if
# the object is gone.
hold_weak_this := (g: Generator, scope: Map<String, CodegenLocal>) ->
  captured := scope['@'] ? return
  ir := g.ir
  object := emit_weak_object(ir, held_value(g, captured))
  gone_label := ir.fresh_label('weak.gone')
  alive_label := ir.fresh_label('weak.alive')
  is_gone := ir.is_null(object)
  ir.branch_if is_gone, gone_label, alive_label
  ir.start_block gone_label
  emit_return g, '', void_type
  ir.start_block alive_label
  emit_retain ir, object
  scope['@'] = store_in_slot(g, object, captured.type)

# Parameters are borrowed SSA values; a method gets its object first, as `@`, and a function
# literal its closure, from which it reads the values it captures. The last statement, if an
# expression, gives the result. A function that yields returns an Iter that runs its body, and one
# that awaits a Promise that the body settles (see yielding and awaiting). The function and its
# entries for defaults have the linkage (see Definition), unless `with_defaults` is false, as for
# an instance whose defaults no call uses (see check_instance_defaults).
export generate_function := (
  g: Generator
  linkage: String
  symbol: String
  literal: FunctionLiteral
  this_type: Type?
  captures: Capture[]?
  with_defaults = true
) ->
  type := function_type_of(type_of(g, literal))
  g.ir.declared_at = literal.position
  params: String[]
  params.push 'ptr %closure' if captures != nil
  params.push "#{ir_type(this_type)} %this" if this_type
  params.append typed_params(type.params)
  generate_body := (result: Type) -> generate_function_body(g, literal, this_type, captures, result)
  if literal.yields
    item := iterable_item(type.result)!
    generate_yielding_function g, linkage, symbol, params, item, -> generate_body(void_type)
  else if is_awaiting(g, literal)
    value := (type.result as PromiseType!).value
    generate_awaiting_function g, linkage, symbol, params, value, -> generate_body(value)
  else
    g.result_type = type.result
    generate_body type.result
    finish g, "#{linkage}#{ir_return_type(type.result)} #{symbol}(#{params.join(', ')})"
  fewest := with_defaults then required_params(literal) else literal.params.length
  for given in fewest..literal.params.length
    entry_generator := function_generator(g.code, g.extensions, g.facts, g.function_name)
    generate_default_entry entry_generator, linkage, symbol, literal, this_type, given

# Whether the function returns a Promise that its body settles: one that awaits, or one that
# settles it without awaiting (see NodeFacts.settling).
export is_awaiting := (g: Generator, literal: FunctionLiteral) ->
  literal.awaits or literal in g.facts.settling

# The body of a coroutine may run after its call returns, so it holds its parameters, its object
# and its closure, which its scope releases; that of a function that yields waits for its first
# item to be asked for before running its statements. `result` is what its last statement gives.
generate_function_body := (
  g: Generator, literal: FunctionLiteral, this_type: Type?, captures: Capture[]?, result: Type
) ->
  type := function_type_of(type_of(g, literal))
  ir := g.ir
  g.nan_free = nan_free_operations(g.facts, literal.body, false)
  holds := g.coroutine != nil
  scope := g.locals.push()
  bind := (name: String, operand: String, local_type: Type) ->
    unless holds
      scope[name] = ValueLocal(operand, type: local_type)
      return
    emit_retain_value ir, operand, local_type
    scope[name] = store_in_slot(g, operand, local_type)
  bind '@', '%this', this_type if this_type
  bind param.name.name, "%p#{i}", type.params[i] for param at i in literal.params
  # The name cannot be written in the source, so no code can read it.
  bind '(closure)', '%closure', type if holds and captures != nil
  # A captured var is its cell, which the closure holds; the literal reads and writes through it.
  captured := captures ? []
  slots := [capture_slot(capture) for capture in captured]
  for capture at i in captured
    { name, type, is_var } := capture
    pointer := emit_capture_pointer(ir, '%closure', slots, i)
    value := ir.load(slots[i].ir_type, pointer, access_tag(ir, slots[i]))
    cell := CellSlot(cell: value, is_owned: false)
    weak := capture.is_weak
    scope[name] =
      if is_var
        SlotLocal type, cell, weak, is_var, pointer: emit_cell_pointer(ir, type, value)
      else
        ValueLocal type, weak, operand: value
  hold_weak_this g, scope if literal.weak
  emit_suspend g if literal.yields
  generate_body_returning_last g, literal.body, result
  g.locals.pop()

# The entry that takes the first `given` arguments, borrowed, and the object of a method; computes
# the defaults of the others in order, each seeing `@` and the parameters before it; and calls the
# function with them all.
generate_default_entry := (
  g: Generator, linkage: String, symbol: String, literal: FunctionLiteral, this_type: Type?,
  given: Int
) ->
  type := function_type_of(type_of(g, literal))
  g.result_type = type.result
  scope := g.locals.push()
  scope['@'] = ValueLocal(operand: '%this', type: this_type) if this_type
  operands: String[]
  for param at i in literal.params
    param_type := type.params[i]
    if i < given
      scope[param.name.name] = ValueLocal(operand: "%p#{i}", type: param_type)
      operands.push "%p#{i}"
    else
      value := generate(g, param.default!)
      scope[param.name.name] = store_in_slot(g, value, param_type)
      operands.push value
  args: String[]
  args.push "#{ir_type(this_type)} %this" if this_type
  args.push "#{ir_type(param)} #{operand}" for (param, operand) in type.params.zip(operands)
  result := call_user_function(g.ir, symbol, type, args.join(', '))
  emit_exception_check g
  emit_return g, result, type.result
  g.locals.pop()
  params: String[]
  params.push "#{ir_type(this_type)} %this" if this_type
  params.append typed_params(type.params[..given])
  entry := default_entry_symbol(symbol, given)
  finish g, "#{linkage}#{ir_return_type(type.result)} #{entry}(#{params.join(', ')})"

# The statements of a function's body, the last returning its value, if it is an expression and the
# function has a result.
export generate_body_returning_last := (g: Generator, body: Statement[], result: Type) ->
  generate_statements g, body.all_but_last()
  has_result := not is_kind(result, 'void')
  last := body.last()
  value := last as Expression?
  return emit_return(g, generate(g, value), type_at_use(g, value)) if value and has_result
  generate_statement g, last if last
  if has_result
    g.ir.emit 'unreachable'
  else
    emit_return g, '', void_type

# Takes the constructor arguments (see is_argument, in order) owned, unlike any other call, and
# stores those given first, so that the fields own them before anything can throw; then computes
# the other fields, and the defaults of the arguments not given, in order, and runs `init` last.
# Storing the arguments first does not show, as an initializer reads only the fields before it. An
# exception on the way releases the fields, which start as nil, and frees the object without
# running its deinit, or panics if init let it escape. An argument with a default comes with whether
# it is given (see generate_construction). It has the linkage (see Definition).
export generate_constructor := (g: Generator, linkage: String, info: ObjectInfo) ->
  ir := g.ir
  g.result_type = info.type
  object := emit_allocate(ir, info)
  field_pointer := (field: FieldInfo) -> emit_field_pointer(ir, object, info, field.name.name)
  ir.store ir_type(field.type!), 'zeroinitializer', field_pointer(field) for field in info.fields
  g.unwind_cleanup = ->
    mark := call_runtime(ir, 'i64 @lerta_drop_mark()', '')
    for field in info.fields
      type := field.type!
      emit_release_stored ir, field_pointer(field), ir_type(type), ownership(type)
    weak_slot := emit_weak_slot_or_null(ir, object, info)
    args := "ptr #{object}, ptr #{weak_slot}, i64 #{mark}"
    call_void_runtime ir, 'void @lerta_free_unfinished(ptr, ptr, i64)', args
  arguments := [field for field in info.fields when is_argument(field)]
  given := (field: FieldInfo) -> "%given#{argument_index(arguments, field)}"
  for field at i in arguments
    store_argument := -> store_field(g, object, info, field, "%p#{i}")
    if field.has_default
      emit_when ir, given(field), store_argument
    else
      store_argument()
  scope := g.locals.push()
  scope['@'] = ValueLocal(operand: object, type: info.type)
  for field in info.fields
    value := field.value ? continue
    compute := -> store_field(g, object, info, field, generate(g, value))
    if field.has_default
      emit_when ir, ir.negate(given(field)), compute
    else
      compute()
  g.locals.pop()
  init := special_method_symbol(g.code.program, info, 'init')
  if info.has_init
    ir.emit "call void #{init}(ptr #{object})"
    emit_exception_check g
  ir.emit "ret ptr #{object}"
  params: String[]
  for argument at i in arguments
    params.push "#{ir_type(argument.type!)} %p#{i}"
    params.push "i1 %given#{i}" if argument.has_default
  finish g, "#{linkage}ptr #{constructor_symbol(info.type)}(#{params.join(', ')})"

argument_index := (arguments: FieldInfo[], field: FieldInfo) -> arguments.index_of(field)!

# The field takes over the value, owned; a weak field takes its box instead.
store_field := (g: Generator, object: String, info: ObjectInfo, field: FieldInfo, value: String) ->
  pointer := emit_field_pointer(g.ir, object, info, field.name.name)
  stored := field.weak then weak_box_of(g, value, field.type!) else value
  emit_release g.ir, value if field.weak
  g.ir.store ir_type(field.type!), stored, pointer

# A weak local or field holds the box of its object, which stays borrowed.
export weak_box_of := (g: Generator, object: String, type: Type) ->
  emit_weak_box_of g.ir, g.code.program, object, type

export finish := (g: Generator, signature: String) -> g.ir.finish(signature)

# Releases every scope of the function, running the finally blocks of the `try` blocks it leaves,
# while it holds the owned value of the type, which it then returns. The function's result type
# decides the instruction: a returned value that never comes (`return throw ...`) is poison. The
# body of a coroutine gives its value to `on_return`, if any, and goes to its end instead.
emit_return := (g: Generator, value: String, type: Type): void ->
  while_holding g, value, type, -> leave_scopes(g, 0)
  on_return value if on_return := g.on_return
  if exit := g.fused_exit
    g.ir.branch exit.label
    return
  if coroutine := g.coroutine
    g.ir.branch coroutine.end_label
    return
  result := g.result_type
  g.ir.emit returns_nothing(result) then 'ret void' else "ret #{ir_type(result)} #{value}"

# The only read of the local, if its value is generated there rather than where it is declared: one
# that a loop goes through in place, whose parts that are evaluated before its loop cannot change
# in between, and which the read goes through, as a loop or a comprehension does or as the object
# of a method, in the local's own scope, so that what the value reads by name is the same there.
defers_to_read := (g: Generator, declaration: Declaration) ->
  read := g.facts.lazy_reads[declaration.name] ? return nil
  # A top-level value is read by functions too, which the checker counts no reads of.
  return nil if g.top_level_code and g.locals.depth() == 1
  is_fused_source(g, declaration.value, false) then read

# Holds an owned reference in a scope of its own, which a jump out of it releases; the returned
# function releases it where the code goes on.
export hold := (g: Generator, value: String, type: Type) ->
  scope := push_held_scope(g, value, type)
  ->
    release_scope g, scope
    g.locals.pop()

# The arguments' operands, which `generate_arg` generates, held in a scope pushed for them, under
# names that the source cannot write, `(<prefix> argument <i>)`; the caller releases and pops it.
export hold_arguments := (
  g: Generator, args: Expression[], prefix: String, generate_arg: (Expression, Int) -> String
) ->
  scope := g.locals.push()
  operands: String[]
  for arg at i in args
    operand := generate_arg(arg, i)
    scope["(#{prefix} argument #{i})"] = store_in_slot(g, operand, type_at_use(g, arg))
    operands.push operand
  (scope, operands)

# Pushes a scope that holds an owned reference, which a jump out of it releases.
push_held_scope := (g: Generator, value: String, type: Type) ->
  scope := g.locals.push()
  # The name cannot be written in the source, so no code can read it.
  scope['(held)'] = store_in_slot(g, value, type)
  scope

# A jump ends the block; the code after it, until the next label, is unreachable.
export generate_jump := (g: Generator, jump: Jump | Return) ->
  case jump
    when Jump then generate_control_jump(g, jump)
    when Return
      value := jump.value
      if value
        emit_return g, generate(g, value), type_at_use(g, value)
      else
        emit_return g, '', void_type
      g.ir.start_unreachable()

# A block that gives a value: its last statement, if an expression, gives it, or ''. The value is
# computed before the locals are released, as it may be one of them.
export generate_block_value := (
  g: Generator
  body: Statement[]
  define: (Map<String, CodegenLocal>) -> void = no_locals
) ->
  scope := g.locals.push()
  define scope
  generate_statements g, body.all_but_last()
  last := body.last()!
  expression := last as Expression?
  # nil that ends a branch of an if or a try that gives no value has no type to be converted to.
  is_discarded_nil := expression is NilLiteral and g.facts.conversions[expression] == nil
  value := expression and not is_discarded_nil then generate(g, expression) else ''
  generate_statement g, last if expression == nil
  release_scope g, scope
  g.locals.pop()
  value

# A block is a scope: the references held by its locals are released at its end. `define`
# declares the locals that belong to it besides its statements'.
export generate_block := (
  g: Generator
  body: Statement[]
  define: (Map<String, CodegenLocal>) -> void = no_locals
) -> generate_block_with(g, statements_code(g, body), define)

# What generates the statements, for a block whose code is given that way.
export statements_code := (g: Generator, statements: Statement[]) ->
  -> generate_statements(g, statements)

# The statements in order, those that are a batch of writes of Float fields together (see
# batched_field_writes).
export generate_statements := (g: Generator, statements: Statement[]) ->
  var i = 0
  while i < statements.length
    count := batched_field_writes(g, statements, i)
    if count > 1
      generate_batched_field_writes g, statements[i..(i + count)]
      i += count
    else
      generate_statement g, statements[i]
      i += 1

# A block whose code `generate` generates in its scope.
export generate_block_with := (
  g: Generator, generate_body: () -> void, define: (Map<String, CodegenLocal>) -> void
) ->
  scope := g.locals.push()
  define scope
  generate_body()
  release_scope g, scope
  g.locals.pop()

export release_scope := (g: Generator, scope: Map<String, CodegenLocal>) ->
  ir := g.ir
  for local in scope.values()
    continue unless local is SlotLocal
    continue if local.top_level != nil or local.is_borrowed
    if cell := local.cell
      emit_release ir, cell.cell if cell.is_owned
    else
      emit_release_stored ir, local.pointer, ir_type(local.type), ownership(local.type)

export generate_statement := (g: Generator, statement: Statement) ->
  located g, statement.position, -> generate_statement_node(g, statement)

generate_statement_node := (g: Generator, statement: Statement): void ->
  case statement
    when For then generate_for(g, statement)
    when While then generate_while(g, statement)
    when If then generate_if(g, statement)
    when Declaration then generate_declaration(g, statement)
    when Assignment then generate_assignment(g, statement)
    when TypeDeclaration, EnumDeclaration, InterfaceDeclaration, TypeAlias then pass
    when Import, Extern, Intrinsic, Extend, Pass then pass
    # One that ends a branch of an if that gives no value, which the checker allows alone.
    when NilLiteral then pass
    else release_if_reference(g, statement, generate(g, statement))

generate_declaration := (g: Generator, declaration: Declaration) ->
  if read := defers_to_read(g, declaration)
    g.deferred_values[read] = declaration.value
    return
  code := g.code
  is_top_level := g.top_level_code and g.locals.depth() == 1
  if global := is_top_level then code.globals[code.module.index][declaration.name.name]
    generate_top_level_declaration g, declaration, global
  else
    generate_local_declaration g, declaration

# A top-level value is never shared, as no function literal captures it.
generate_top_level_declaration := (
  g: Generator, declaration: Declaration, global: TopLevelGlobal
) ->
  ir := g.ir
  type := type_of(g, declaration.name)
  value := held_value_of(g, declaration, generate_declared_value(g, declaration, false), type)
  ir.store ir_type(type), value, global.pointer, top_level_tag(ir)
  emit_mark_initialized ir, global
  g.locals.define declaration.name.name, top_level_slot(global, false)

generate_local_declaration := (g: Generator, declaration: Declaration) ->
  ir := g.ir
  type := type_of(g, declaration.name)
  { weak, mutable } := declaration
  name := declaration.name.name
  if holds_borrowed(g, declaration)
    borrowed := generate_borrowed_value(g, declaration.value)
    g.locals.define name, ValueLocal(type, operand: borrowed)
    return
  defers := defers_declaration(g, declaration)
  generate_value := -> generate_declared_value(g, declaration, not weak)
  generated := with_deferred_checks(g, g.defers_float_checks or defers, generate_value)
  value := held_value_of(g, declaration, generated, type)
  if declaration.name in g.facts.shared_vars
    cell := emit_cell(ir, type, value)
    pointer := emit_cell_pointer(ir, type, cell)
    owned := CellSlot(cell, is_owned: true)
    g.locals.define name, SlotLocal(type, pointer, weak, is_var: mutable, cell: owned)
    return
  slot := store_in_slot(g, value, type)
  g.unchecked_floats.add slot.pointer if defers
  g.locals.define name, SlotLocal(type, weak, is_var: mutable, pointer: slot.pointer)

# What the declared name holds of the value generated for it: the value, or its weak box.
held_value_of := (g: Generator, declaration: Declaration, generated: String, type: Type) ->
  return generated unless declaration.weak
  box := weak_box_of(g, generated, type)
  emit_release g.ir, generated
  box

# Whether the const, which is no top-level value, holds its value unchecked for NaN: a tree of float
# arithmetic (see float_tree) whose root may give a NaN, which is checked where the value leaves
# the local, read but as an operand of a tree whose root checks it (see check_where_read), so
# that the trees it goes on into check it once at their roots. A NaN that never leaves it throws
# nowhere.
defers_declaration := (g: Generator, declaration: Declaration) ->
  return false if declaration.mutable or declaration.name in g.facts.shared_vars
  value := declaration.value
  return false if value is not BinaryOperation or g.defers_float_checks
  # Not one that a loop reads, which would check it at each turn rather than once here.
  read_in_loop := declaration.name in g.nan_free.read_in_loops
  float_tree(g, value) and value not in g.nan_free.whole and not read_in_loop

# Whether the local, which is no top-level value, holds its value borrowed, retaining nothing: a
# const whose value stays where it is borrowed from while the local is in scope (see
# is_borrowable_in_scope). A body that suspends holds it, as it does its parameters, since what it
# is borrowed from may change while the body is suspended.
holds_borrowed := (g: Generator, declaration: Declaration) ->
  return false if declaration.mutable or declaration.weak or g.coroutine != nil
  is_borrowable_in_scope g, declaration.value

# The value of a local that is a const and is held as it is: the closure of a function literal
# is local if the local never leaves the function, being only called (see escaping_locals).
generate_declared_value := (g: Generator, declaration: Declaration, is_held_as_is: Bool) ->
  value := declaration.value
  if value is FunctionLiteral and is_held_as_is and not declaration.mutable
    return generate_closure(g, value, declaration.name not in g.facts.escaping_locals)
  generate g, value

export store_in_slot := (g: Generator, value: String, type: Type) ->
  pointer := g.ir.alloca(ir_type(type))
  g.ir.store ir_type(type), value, pointer
  SlotLocal pointer, type
