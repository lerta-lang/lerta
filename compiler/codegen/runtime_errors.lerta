# The runtime's errors (see docs/internals/execution.md#exceptions).
import Itab from '../checker/interface_values'
import emit_traced_unwind, exception_global, TRACE_START from './exceptions'
import emit_interface_value from './interface'
import Generator from './generator'
import emit_seldom_branch from './ir_builder'
import constructor_symbol, emit_retain, INTERFACE_IR_TYPE, string_constant from './lerta_ir'
import call_void_runtime from './runtime_calls'
import ObjectType from '../types'

RAISE_ERROR := '@lerta.raise_error'

# Defines the function, in the module that std:builtins is.
export define_raise_error := (g: Generator) ->
  ir := g.ir
  itabs := g.code.program.runtime_errors
  cases := ["i32 #{i}, label %kind.#{i}" for i in 0..itabs.length].join(' ')
  ir.emit "switch i32 %kind, label %done [ #{cases} ]"
  for itab at i in itabs
    ir.start_block "kind.#{i}"
    emit_set_error g, itab
    ir.branch 'done'
  ir.start_block 'done'
  ir.emit 'ret void'
  ir.finish "void #{RAISE_ERROR}(i32 %kind, ptr %message)"

# The constructor takes the message owned, which the runtime lends.
emit_set_error := (g: Generator, itab: Itab) ->
  type := itab.type as ObjectType!
  emit_retain g.ir, '%message'
  error := g.ir.assign("call ptr #{constructor_symbol(type)}(ptr %message)")
  value := emit_interface_value(g, error, itab)
  g.ir.store INTERFACE_IR_TYPE, value, exception_global(g.ir)

# Registers the function with the runtime, as the program starts.
export emit_register_raise := (g: Generator) ->
  call_void_runtime g.ir, 'void @lerta_register_raise(ptr)', "ptr #{RAISE_ERROR}"

# An error that a check of the generated code throws, by the name of its type, and its message.
export struct CheckedError
  type_name: String
  message: String

export OVERFLOW := CheckedError(type_name: 'ArithmeticError', message: 'integer overflow')
export DIVISION_BY_ZERO := CheckedError(type_name: 'ArithmeticError', message: 'division by zero')
export SHIFT_OUT_OF_RANGE :=
  CheckedError(type_name: 'ArithmeticError', message: 'shift out of range')
export NOT_A_NUMBER := CheckedError(type_name: 'ArithmeticError', message: 'not a number')
export UNWRAPPED_NIL := CheckedError(type_name: 'NilError', message: 'unwrapped nil')
export FAILED_CAST := CheckedError(type_name: 'CastError', message: 'failed cast')
export DEAD_OBJECT := CheckedError(type_name: 'WeakError', message: 'weak object is gone')
export INDEX_OUT_OF_RANGE := CheckedError(type_name: 'IndexError', message: 'index out of range')
export NONPOSITIVE_STEP := CheckedError(type_name: 'ValueError', message: 'a step must be positive')

type_name := (itab: Itab) -> (itab.type as ObjectType!).name

# Throws the error where the condition holds, and unwinds from there.
export throw_if := (g: Generator, condition: String, error: CheckedError) ->
  ir := g.ir
  raise_label := ir.fresh_label('raise')
  continue_label := ir.fresh_label('continue')
  emit_seldom_branch ir, condition, raise_label, continue_label
  ir.start_block raise_label
  message := string_constant(ir, error.message)
  errors := g.code.program.runtime_errors
  kind := errors.find_index((itab) -> type_name(itab) == error.type_name)!
  call_void_runtime ir, 'void @lerta_raise(i32, ptr)', "i32 #{kind}, ptr #{message}"
  emit_traced_unwind g, TRACE_START
  ir.start_block continue_label
