# How clang is run, and what it is given for each kind of build, which the program and the runtime
# share. The runtime checks (test/runtime.lerta), which minilerta builds, import the flags too, so
# that they compile the runtime's sources as `build` does.
import cpu_count, platform, run from 'std:process'
import Buffer from 'std:io'
import CompileError from './errors'

# A kind of build: with `-O` or not, with the memory checks or not, and for `target` (a triple such
# as i686-linux-gnu) or else for the host.
export struct BuildKind
  optimize: Bool

  # `--memory-checks`, or no `-O`: the program checks for leaks and for the use of dropped objects.
  memory_checks: Bool

  target: String?

export build_flags := (kind: BuildKind) ->
  [
    optimization_flags(kind.optimize)...
    memory_check_flags(kind.memory_checks)...
    target_flags(kind.target)...
  ]

optimization_flags := (optimize: Bool): String[] -> optimize then ['-O2', '-flto=thin'] else []

memory_check_flags := (memory_checks: Bool): String[] ->
  memory_checks then ['-D', 'LERTA_DEBUG'] else []

# How often LLVM optimizes a function again where a call in it becomes direct, rather than 4: the
# chain of an Iter's methods inlines one more call at each (see docs/internals/iteration.md#iter).
DEVIRT_ITERATIONS := 8

# What the link of an optimized build is given for its link-time optimization: the cache, in `dir`,
# and DEVIRT_ITERATIONS. For Linux, the options are GNU ld's LLVM plugin's, which clang uses by
# default there, as lld takes none of them.
export lto_link_flags := (system: String, dir: String) ->
  devirt := "-max-devirt-iterations=#{DEVIRT_ITERATIONS}"
  case system
    when 'macos' then ["-Wl,-cache_path_lto,#{dir}", "-Wl,-mllvm,#{devirt}"]
    when 'windows' then ["-Wl,--thinlto-cache-dir=#{dir}", "-Wl,-mllvm,#{devirt}"]
    else ["-Wl,-plugin-opt,cache-dir=#{dir}", "-Wl,-plugin-opt=#{devirt}"]

# The directory of the cache of the link-time optimization in the cache directory, named after
# DEVIRT_ITERATIONS, which the linker does not count in the keys of its entries, so that a build
# with another limit takes none made with this one.
export LTO_CACHE := "thinlto-devirt-#{DEVIRT_ITERATIONS}"

# The triples of the targets' short names, `<system>-<architecture>`, which name the systems as
# `platform` does and the architectures as Debian does.
TRIPLES_BY_NAME :=
  'linux-i386': 'i686-linux-gnu'
  'linux-amd64': 'x86_64-linux-gnu'
  'linux-arm64': 'aarch64-linux-gnu'
  'macos-amd64': 'x86_64-apple-macos'
  'macos-arm64': 'arm64-apple-macos'
  'windows-i386': 'i686-w64-mingw32'
  'windows-amd64': 'x86_64-w64-mingw32'
  'windows-arm64': 'aarch64-w64-mingw32'

# The short name of a macOS target for both architectures, which UNIVERSAL_TRIPLES name: a build for
# it links an executable for each and joins them.
export UNIVERSAL_TARGET := 'macos-universal'
export UNIVERSAL_TRIPLES := ['arm64-apple-macos', 'x86_64-apple-macos']

# The triple of a target, given by its short name or as a triple.
export target_triple := (target: String) -> TRIPLES_BY_NAME[target] ? target

# The triple of the target given by its short name or as a triple, or nil for the host's triple,
# for which clang builds the same without --target, so that the build shares the runtime that a
# build without a target caches. A short name is never the host's: its triple may differ, as in the
# minimum macOS version or the C library.
export build_target := (target: String) ->
  target == await clang_host_triple() then nil else target_triple(target)

# The triple that clang builds for without --target, as `arm64-apple-darwin25.6.0`.
export clang_host_triple := ->
  output := Buffer()
  ran := await run('clang', '-print-target-triple', stdout: output)
  throw CompileError('clang -print-target-triple failed') if ran.code != 0
  (output.text() ? throw CompileError('clang -print-target-triple is not valid UTF-8')).trim()

# Whether the target is one of the short names.
export is_target_name := (target: String) -> target in TRIPLES_BY_NAME

# The short name of the host's target, `<platform>-<architecture>`, by the triple that clang prints
# for it, as `arm64-apple-darwin25.6.0`, which none of TRIPLES_BY_NAME is; nil for an architecture
# that has none.
export target_name_of_host := (triple: String) ->
  architecture :=
    case triple.split('-')[0]
      when 'x86_64' then 'amd64'
      when 'aarch64', 'arm64' then 'arm64'
      when 'i386', 'i486', 'i586', 'i686' then 'i386'
      else return nil
  "#{platform}-#{architecture}"

# A mingw-w64 triple, as GCC's toolchains name it or as llvm-mingw's clang does by default.
export is_mingw := (target: String) ->
  target.ends_with('-w64-mingw32') or target.ends_with('-w64-windows-gnu')

target_flags := (target: String?): String[] ->
  return [] unless target
  flags := ["--target=#{target}"]

  # GNU ld, which clang uses for mingw by default, cannot link the bitcode of -flto.
  flags.push '-fuse-ld=lld' if is_mingw(target)

  # 32-bit x86 computes doubles on the x87 by default, in more precision, which hides a result too
  # large for a double from the check of a Float's arithmetic; SSE2 computes them as doubles.
  flags.append ['-msse2', '-mfpmath=sse'] if is_32_bit_x86(target)

  flags

is_32_bit_x86 := (target: String) -> target.split('-')[0] in ['i386', 'i486', 'i586', 'i686']

# What the name of an executable for the target ends with: `.exe` for Windows. Without a target, it
# is nothing, which is enough on Windows too: the linker and libuv's spawn add `.exe` to a name
# without an extension.
export executable_suffix := (target: String?) -> target and is_mingw(target) then '.exe' else ''

# Runs clang once for each list of arguments in `jobs`, as many at once as there are CPUs; false if
# it fails for any, after which no more are started.
export run_clang_jobs := (jobs: String[][]) ->
  var next = 0
  var failed = false

  # Each runs the next job until none is left, or one has failed.
  worker := ->
    while not failed and next < jobs.length
      args := jobs[next]
      next += 1
      failed = true if (await run('clang', args...)).code != 0

  workers := [worker() for _ in 0..cpu_count]

  # Each is waited for, even after one has thrown, so that none still writes into a
  # directory that the caller removes afterwards.
  var error: Error?
  for each in workers
    try
      await each
    catch thrown
      error = thrown
  throw thrown if thrown := error
  not failed
