# libuv, which the runtime is built with, from the sources that the compiler carries, and what a
# target builds the runtime with, as compiler/platform_description.lerta reads it from them.
import make_dir, write_file from 'std:io'
import embedded_source, EMBEDDED_PATHS from '../build/embedded'
import described_build, description_path, target_system from './platform_description'
import dir_name, join from 'std:path'

SOURCE_ROOT := 'third_party/libuv/'

# Every file of libuv that the compiler carries.
export LIBUV_PATHS := [path for path in EMBEDDED_PATHS when path.starts_with(SOURCE_ROOT)]

# The build for the target, or for the host without one.
export platform_build := (target: String?) ->
  system := target_system(target)
  described_build(embedded_source(description_path(system))!, system)

# Writes libuv's files under `dir`, as they are under its root, and gives the flags that find its
# headers there.
export write_libuv_sources := (dir: String) ->
  for path in LIBUV_PATHS
    file := join(dir, path.without_prefix(SOURCE_ROOT)!)
    make_dir dir_name(file)
    await write_file(file, embedded_source(path)!)
  ["-I#{join(dir, 'include')}", "-I#{join(dir, 'src')}"]
