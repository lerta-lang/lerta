# Compiles a program as far as the IR that codegen generates for it, which build has clang
# compile, and the seed prints (see docs/internals/architecture.md#bootstrap).
import Writer from 'std:io'
import exit from 'std:process'
import check_modules from './checker/modules'
import generate from './codegen/codegen'
import ProgramWide from './checker/shared'
import Located, located_line from './errors'
import load_modules from './loader'

# The checked program of the entry module `source`, whose warnings are printed; with
# `warnings_as_errors`, a warning exits with code 1, as an error does. A compile error is thrown.
export check_program := (source: String, warnings_as_errors: Bool) ->
  var has_warnings = false
  print_warnings := (_: ProgramWide, warnings: Located[]) ->
    for warning in warnings
      print_error located_line(warning, 'warning: ')
    has_warnings = not warnings.is_empty()
  program := check_modules(source, await load_modules(source), print_warnings)
  exit 1 if warnings_as_errors and has_warnings
  program

# Writes the lines of a module's IR (see IrModule.render), each followed by a newline.
export write_ir := (lines: String[], writer: Writer) ->
  for line in lines
    await writer.write(line)
    await writer.write("\n")

# The IR as `dump-llvm` prints it: without the function attributes of a target, which a build
# gets from clang, and for LLVM before 23 (see IrModule).
export generate_ir := (source: String, warnings_as_errors: Bool) ->
  generate(await check_program(source, warnings_as_errors), '', 'i1', traces: true)[0]
