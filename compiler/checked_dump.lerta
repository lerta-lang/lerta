# The syntax trees of a program's modules, as dump_ast writes them, with the types that the checker
# gave their nodes, for `dump-checked`, which shows what the checker makes of a program.
import dump_annotated from './ast_dump'
import Node from './ast'
import is_standard_module from './loader'
import ProgramWide, Shared from './checker/shared'
import format_type from './types'

export const dump_checked = (program: ProgramWide) ->
  const dump_module = (shared: Shared) ->
    const module = program.modules[shared.index]
    const header = "module #{module.display_path ? program.entry_path}\n"
    header + dump_annotated(module.program, (node) -> type_annotation(shared, node))
  const is_shown = (shared: Shared) -> not is_standard_module(program.modules[shared.index])
  [dump_module(shared) for shared in program.shared when is_shown(shared)].join('')

# ` : <type>`, and ` => <converted type>` if it is converted; nothing for a node without a type.
const type_annotation = (shared: Shared, node: Node) ->
  const type = shared.facts.types[node] ? return ''
  const converted = shared.facts.conversions[node]
  const conversion = converted then " => #{format_type(converted)}" else ''
  " : #{format_type(type)}#{conversion}"
