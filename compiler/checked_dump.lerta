# The syntax trees of a program's modules, as dump_ast writes them, with the types that the checker
# gave their nodes, for `dump-checked`, which shows what the checker makes of a program.
import dump_annotated from './ast_dump'
import Node from './ast'
import is_standard_module from './loader'
import ProgramWide, Shared from './checker/shared'
import format_type from './types'

export dump_checked := (program: ProgramWide) ->
  dump_module := (shared: Shared) ->
    module := program.modules[shared.index]
    header := "module #{module.display_path ? program.entry_path}\n"
    header + dump_annotated(module.program, (node) -> type_annotation(shared, node))
  is_shown := (shared: Shared) -> not is_standard_module(program.modules[shared.index])
  [dump_module(shared) for shared in program.shared when is_shown(shared)].join('')

type_annotation := (shared: Shared, node: Node) ->
  type := shared.facts.types[node] ? return ''
  converted := shared.facts.conversions[node]
  conversion := converted then " => #{format_type(converted)}" else ''
  " : #{format_type(type)}#{conversion}"
