# The license notices that go with a program the compiler builds, which the compiler carries and
# `lerta license` prints (see docs/reference/compiler.md#license), each with its path from the
# repository's root. The build reads the paths too, to build the compiler again when one changes.
import '../LICENSE-APACHE' as APACHE: String
import '../LICENSE-MIT' as MIT: String
import '../third_party/libuv/LICENSE' as LIBUV: String
import '../third_party/libuv/LICENSE-extra' as LIBUV_EXTRA: String
import '../third_party/ucd/LICENSE' as UCD: String

export NOTICES :=
  ('LICENSE-MIT', MIT)
  ('LICENSE-APACHE', APACHE)
  ('third_party/libuv/LICENSE', LIBUV)
  ('third_party/libuv/LICENSE-extra', LIBUV_EXTRA)
  ('third_party/ucd/LICENSE', UCD)
