# The license notices that go with a program the compiler builds, which the compiler carries and
# `lerta license` prints (see docs/reference/compiler.md#license). The build reads the list too, so
# this module imports nothing that the build makes.
export LICENSE_PATHS :=
  'LICENSE-MIT'
  'LICENSE-APACHE'
  'third_party/libuv/LICENSE'
  'third_party/libuv/LICENSE-extra'
  'third_party/ucd/LICENSE'
