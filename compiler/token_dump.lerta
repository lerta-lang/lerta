# Tokens as text, one per line, for `dump-tokens`, which shows what the lexer makes of a file.
import Token from './lexer/tokens'
import CodePart, TemplatePart, TextPart from './lexer/string_literal'

export dump_tokens := (tokens: Token[]) -> [dump_token(token) for token in tokens].join('')

dump_token := (token: Token) ->
  spacing := token.spaced then 'spaced' else 'joined'
  line := "#{token.line}:#{token.column} #{spacing} #{token.kind} #{quote(token.text)}\n"
  parts := token.parts ? return line
  line + [dump_part(part) for part in parts].join('')

dump_part := (part: TemplatePart) ->
  case part
    when TextPart then "  text #{quote(part.text)}\n"
    when CodePart then "  code #{part.column} #{quote(part.source)}\n"

# The bytes below 0x20, 0x7F, `\` and `"` are written as `\xHH`, so that each token stays on its
# line.
export quote := (text: String) ->
  var quoted = '"'
  for c in text
    code := c.to_int()
    escaped := code < 0x20 or code == 0x7F or c == '\' or c == '"'
    quoted += escaped then "\\x#{code.to_hex(2).to_upper()}" else c.to_string()
  quoted + '"'
