# Tokens as text, one per line, as stage0's `dump-tokens` prints them, so that the two lexers can be
# compared.
import { hex } from './hex'
import { Token } from './syntax/lexer'
import { CodePart, TemplatePart, TextPart } from './syntax/string_literal'

export const dump_tokens = (tokens: Array<Token>): String ->
  [dump_token(token) for token in tokens].join('')

const dump_token = (token: Token): String ->
  const spacing = token.spaced then 'spaced' else 'joined'
  var text = "#{token.line}:#{token.column} #{spacing} #{token.kind} #{quote(token.text)}\n"
  if const parts = token.parts
    text += dump_part(part) for part in parts
  text

const dump_part = (part: TemplatePart): String ->
  case part
    when TextPart then "  text #{quote(part.text)}\n"
    when CodePart then "  code #{part.column} #{quote(part.source)}\n"

# The bytes below 0x20, 0x7F, `\` and `"` are written as `\xHH`, so that each token stays on its
# line.
const quote = (text: String): String ->
  const bytes: Array<Byte> = ['"']
  for byte in text.binary
    if byte < 0x20 or byte == 0x7F or byte == '\' or byte == '"'
      bytes.push(escaped) for escaped in "\\x#{hex(byte.to_int(), 2)}".binary
    else
      bytes.push(byte)
  bytes.push('"')
  bytes.to_binary().decode_utf8()!
