# A deep copy of a function literal, as each instance of a generic function has, so that its nodes
# can have types of their own. A node that the literal holds in several places, as the element of
# a comprehension is held by its lazy function too, is copied once.
import {
  ArrayLiteral, as_expression, Assignment, AssignmentTarget, BinaryOperation, Binding
  BooleanLiteral, Call, Case, CaseArm, Coalesce, Comprehension, Condition, Conditional
  copy_identifier, Declaration, EnumDeclaration, Expression, Extend, Extern, For, FunctionLiteral
  FunctionTypeName, Identifier, If, Import, ImportName, Index, IntegerLiteral, Interpolation
  InterpolationPart, IsTest, Jump, LazyFunctions, MapEntry, MapLiteral, Member, MemberDeclaration
  NamedType, NamedValue, NilLiteral, Parameter, Pass, Range, RecordLiteral, RecordTypeField
  RecordTypeName, Return, Statement, StringLiteral, This, Throw, TypeAlias, TypeDeclaration
  TypeName, TypeParameter, UnaryOperation, UnionMember, UnionTypeName, Unwrap, While
} from './ast'
import { TextPart } from './lexer/string_literal'

# The copies of the expressions copied so far, by original.
class Copies
  expressions: Map<Expression, Expression> = Map()

export const clone_function = (literal: FunctionLiteral) ->
  clone_literal Copies(), literal

const clone_literal = (copies: Copies, literal: FunctionLiteral) ->
  const type_params = [clone_type_parameter(param) for param in literal.type_params]
  const params = [clone_parameter(param) for param in literal.params]
  const return_type = clone_optional_type(literal.return_type)
  const body = clone_statements(copies, literal.body)
  FunctionLiteral type_params, params, return_type, body, position: literal.position

const clone_type_parameter = (param: TypeParameter) ->
  const bound = param.bound
  const name = copy_identifier(param.name)
  TypeParameter name, bound: bound then copy_identifier(bound) else nil

const clone_parameter = (param: Parameter) ->
  Parameter name: copy_identifier(param.name), type: clone_optional_type(param.type)

const clone_statements = (copies: Copies, statements: Array<Statement>) ->
  [clone_statement(copies, statement) for statement in statements]

const clone_statement = (copies: Copies, statement: Statement): Statement ->
  const position = statement.position
  case statement
    when Declaration
      const mutable = statement.mutable
      const name = copy_identifier(statement.name)
      const type = clone_optional_type(statement.type)
      const value = clone(copies, statement.value)
      const declaration = Declaration(mutable, name, type, value, position)
      declaration.exported = statement.exported
      declaration
    when Assignment
      const target = clone(copies, statement.target)
      const assigned: AssignmentTarget = case target
        when Identifier then target
        when Index then target
        when Member then target
        else throw 'an assignment target is copied as one'
      const value = clone(copies, statement.value)
      Assignment value, position, operator: statement.operator, target: assigned
    when If
      const condition = clone_condition(copies, statement.condition)
      const then_body = clone_statements(copies, statement.then_body)
      const else_body = clone_statements(copies, statement.else_body)
      If condition, then_body, else_body, position
    when While
      const condition = clone_condition(copies, statement.condition)
      While condition, position, body: clone_statements(copies, statement.body)
    when For
      const variable = copy_identifier(statement.variable)
      const iterable = clone(copies, statement.iterable)
      For variable, iterable, position, body: clone_statements(copies, statement.body)
    when TypeDeclaration
      const name = copy_identifier(statement.name)
      const members = [clone_member(copies, member) for member in statement.members]
      const declaration = TypeDeclaration(name, members, position, is_struct: statement.is_struct)
      declaration.exported = statement.exported
      declaration
    when EnumDeclaration
      const members = [copy_enum_member(member) for member in statement.members]
      const declaration = EnumDeclaration(members, position, name: copy_identifier(statement.name))
      declaration.exported = statement.exported
      declaration
    when TypeAlias
      const name = copy_identifier(statement.name)
      const alias = TypeAlias(name, position, type: clone_type(statement.type))
      alias.exported = statement.exported
      alias
    when Extern
      const symbol = copy_identifier(statement.symbol)
      const name = copy_identifier(statement.name)
      const declaration = Extern(symbol, name, position, type: clone_type(statement.type))
      declaration.exported = statement.exported
      declaration
    when Extend
      const type_params = [clone_type_parameter(param) for param in statement.type_params]
      const members = [clone_member(copies, member) for member in statement.members]
      Extend type_params, members, position, type: clone_type(statement.type)
    when Pass then Pass(position)
    when Import
      const names = [clone_import_name(name) for name in statement.names]
      Import names, position, module: statement.module
    else clone(copies, as_expression(statement)!)

const copy_enum_member = (member: Identifier | StringLiteral): Identifier | StringLiteral ->
  case member
    when Identifier then copy_identifier(member)
    when StringLiteral then StringLiteral(position: member.position, value: member.value)

const clone_import_name = (name: ImportName) ->
  const alias = name.alias
  ImportName name: copy_identifier(name.name), alias: alias then copy_identifier(alias) else nil

const clone_member = (copies: Copies, member: MemberDeclaration) ->
  const value = member.value
  MemberDeclaration(
    name: copy_identifier(member.name), modifier: member.modifier, position: member.position
    type: clone_optional_type(member.type), value: value then clone(copies, value) else nil
  )

const clone_condition = (copies: Copies, condition: Condition): Condition ->
  case condition
    when Binding
      const name = copy_identifier(condition.name)
      Binding name, value: clone(copies, condition.value), position: condition.position
    else clone(copies, as_expression(condition)!)

const clone = (copies: Copies, expression: Expression) ->
  if const copied = copies.expressions[expression]
    return copied
  const copy = copy_expression(copies, expression)
  copies.expressions[expression] = copy
  copy

const clone_optional = (copies: Copies, expression: Expression?) ->
  expression then clone(copies, expression) else nil

const copy_expression = (copies: Copies, expression: Expression): Expression ->
  const position = expression.position
  const each = (values: Array<Expression>) ->
    [clone(copies, value) for value in values]
  case expression
    when StringLiteral then StringLiteral(position, value: expression.value)
    when Interpolation
      Interpolation position, parts: [clone_part(copies, part) for part in expression.parts]
    when BooleanLiteral then BooleanLiteral(position, value: expression.value)
    when NilLiteral then NilLiteral(position)
    when IntegerLiteral then IntegerLiteral(position, value: expression.value)
    when Identifier then copy_identifier(expression)
    when ArrayLiteral then ArrayLiteral(position, elements: each(expression.elements))
    when Comprehension then clone_comprehension(copies, expression)
    when MapLiteral
      const entries = [clone_entry(copies, entry) for entry in expression.entries]
      MapLiteral entries, position
    when RecordLiteral
      RecordLiteral position, fields: clone_named_values(copies, expression.fields)
    when FunctionLiteral then clone_literal(copies, expression)
    when UnaryOperation
      const operand = clone(copies, expression.operand)
      UnaryOperation operand, position, operator: expression.operator
    when BinaryOperation
      const left = clone(copies, expression.left)
      const right = clone(copies, expression.right)
      BinaryOperation left, right, position, operator: expression.operator
    when Range
      Range position, start: clone(copies, expression.start), end: clone(copies, expression.end)
    when IsTest
      const value = clone(copies, expression.value)
      IsTest value, position, type: clone_named_type(expression.type)
    when Conditional
      const condition = clone(copies, expression.condition)
      const then_value = clone(copies, expression.then_value)
      const else_value = clone(copies, expression.else_value)
      Conditional condition, then_value, else_value, position
    when Unwrap then Unwrap(position, operand: clone(copies, expression.operand))
    when This then This(position)
    when Member
      const object = clone(copies, expression.object)
      Member object, position, name: copy_identifier(expression.name)
    when Index
      const object = clone(copies, expression.object)
      Index object, position, index: clone(copies, expression.index)
    when Call then clone_call(copies, expression)
    when Case
      const subject = clone_optional(copies, expression.subject)
      const arms = [clone_arm(copies, arm) for arm in expression.arms]
      const otherwise = expression.otherwise
      const otherwise_copy = otherwise then clone_statements(copies, otherwise) else nil
      Case subject, arms, position, otherwise: otherwise_copy
    when Coalesce
      const value = clone(copies, expression.value)
      Coalesce value, position, fallback: clone(copies, expression.fallback)
    when Throw then Throw(position, message: clone(copies, expression.message))
    when Jump then Jump(position, kind: expression.kind)
    when Return then Return(position, value: clone_optional(copies, expression.value))

const clone_part = (copies: Copies, part: InterpolationPart): InterpolationPart ->
  case part
    when TextPart then part
    when Call then clone_call(copies, part)

const clone_call = (copies: Copies, call: Call) ->
  const callee = clone(copies, call.callee)
  const args = [clone(copies, arg) for arg in call.args]
  const named_args = clone_named_values(copies, call.named_args)
  const type_args = [clone_type(type) for type in call.type_args]
  Call callee, args, named_args, type_args, position: call.position

const clone_named_values = (copies: Copies, values: Array<NamedValue>) ->
  const clone_value = (value: NamedValue) ->
    NamedValue name: copy_identifier(value.name), value: clone(copies, value.value)
  [clone_value(value) for value in values]

const clone_entry = (copies: Copies, entry: MapEntry) ->
  MapEntry key: clone(copies, entry.key), value: clone(copies, entry.value)

const clone_arm = (copies: Copies, arm: CaseArm) ->
  const patterns = [clone(copies, pattern) for pattern in arm.patterns]
  CaseArm patterns, body: clone_statements(copies, arm.body)

# The lazy functions share the element and the guard, which are copied once.
const clone_comprehension = (copies: Copies, comprehension: Comprehension) ->
  const element = clone(copies, comprehension.element)
  const variable = copy_identifier(comprehension.variable)
  const iterable = clone(copies, comprehension.iterable)
  const guard = clone_optional(copies, comprehension.guard)
  const lazy = comprehension.lazy
  const lazy_copy = lazy then clone_lazy(copies, lazy) else nil
  const position = comprehension.position
  Comprehension element, variable, iterable, guard, position, lazy: lazy_copy

const clone_lazy = (copies: Copies, lazy: LazyFunctions) ->
  const guard = lazy.guard
  const guard_copy = guard then clone_literal(copies, guard) else nil
  LazyFunctions guard: guard_copy, element: clone_literal(copies, lazy.element)

const clone_optional_type = (type: TypeName?) -> type then clone_type(type) else nil

const clone_type = (type: TypeName): TypeName ->
  case type
    when NamedType then clone_named_type(type)
    when UnionTypeName
      const members = [clone_union_member(member) for member in type.members]
      UnionTypeName members, position: type.position
    when FunctionTypeName
      const params = [clone_type(param) for param in type.params]
      const { optional, position } = type
      FunctionTypeName params, optional, position, result: clone_type(type.result)
    when RecordTypeName then clone_record_type(type)

const clone_union_member = (member: UnionMember): UnionMember ->
  case member
    when NamedType then clone_named_type(member)
    when RecordTypeName then clone_record_type(member)

const clone_named_type = (type: NamedType) ->
  const args = [clone_type(arg) for arg in type.args]
  NamedType args, name: type.name, optional: type.optional, position: type.position

const clone_record_type = (type: RecordTypeName) ->
  const clone_field = (field: RecordTypeField) ->
    RecordTypeField name: copy_identifier(field.name), type: clone_type(field.type)
  const fields = [clone_field(field) for field in type.fields]
  RecordTypeName fields, optional: type.optional, position: type.position
