# What clang is given for each kind of build, which the program and the runtime share. The runtime
# checks (test/runtime.lerta), which minilerta builds, import it too, so that they compile the
# runtime's sources as `build` does.

export build_flags := (optimize: Bool, memory_checks: Bool, target: String?) ->
  [optimization_flags(optimize)..., memory_check_flags(memory_checks)..., target_flags(target)...]

optimization_flags := (optimize: Bool): String[] -> optimize then ['-O2', '-flto=thin'] else []

memory_check_flags := (memory_checks: Bool): String[] ->
  memory_checks then ['-D', 'LERTA_DEBUG'] else []

# How often LLVM optimizes a function again where a call in it becomes direct, rather than 4: the
# chain of an Iter's methods inlines one more call at each (see docs/internals.md#iter).
DEVIRT_ITERATIONS := 8

# What the link of an optimized build is given for its link-time optimization: the cache, in `dir`,
# and DEVIRT_ITERATIONS. For Linux, the options are GNU ld's LLVM plugin's, which clang uses by
# default there, as lld takes none of them.
export lto_link_flags := (system: String, dir: String) ->
  devirt := "-max-devirt-iterations=#{DEVIRT_ITERATIONS}"
  case system
    when 'macos' then ["-Wl,-cache_path_lto,#{dir}", "-Wl,-mllvm,#{devirt}"]
    when 'windows' then ["-Wl,--thinlto-cache-dir=#{dir}", "-Wl,-mllvm,#{devirt}"]
    else ["-Wl,-plugin-opt,cache-dir=#{dir}", "-Wl,-plugin-opt=#{devirt}"]

# The directory of the cache of the link-time optimization in the cache directory, named after
# DEVIRT_ITERATIONS, which the linker does not count in the keys of its entries, so that a build
# with another limit takes none made with this one.
export LTO_CACHE := "thinlto-devirt-#{DEVIRT_ITERATIONS}"

export is_mingw := (target: String) -> target.ends_with('-w64-mingw32')

target_flags := (target: String?): String[] ->
  return [] if not target
  flags := ["--target=#{target}"]
  # GNU ld, which clang uses for mingw by default, cannot link the bitcode of -flto.
  flags.push '-fuse-ld=lld' if is_mingw(target)
  # 32-bit x86 computes doubles on the x87 by default, in more precision, which hides a result too
  # large for a double from the check of a Float's arithmetic; SSE2 computes them as doubles.
  flags.append ['-msse2', '-mfpmath=sse'] if is_32_bit_x86(target)
  flags

is_32_bit_x86 := (target: String) ->
  arch := target.split('-')[0]
  arch == 'i386' or arch == 'i486' or arch == 'i586' or arch == 'i686'

# What the name of an executable for the target ends with: `.exe` for Windows. Without a target, it
# is nothing, which is enough on Windows too: the linker and libuv's spawn add `.exe` to a name
# without an extension.
export executable_suffix := (target: String?) -> target and is_mingw(target) then '.exe' else ''
