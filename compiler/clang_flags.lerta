# What clang is given for each kind of build, which the program and the runtime share.

export const build_flags = (optimize: Bool, target: String?) ->
  [optimization_flags(optimize)..., target_flags(target)...]

# Link-time optimization lets the generated code inline the runtime's C functions; ThinLTO
# optimizes each module on a thread of its own, and keeps what it has optimized in a cache (see
# lto_cache_flags). Unoptimized builds use the debug runtime, which checks for leaks at exit.
# test/runtime.ts builds the runtime with the same flags.
const optimization_flags = (optimize: Bool) ->
  optimize then ['-O2', '-flto=thin'] else ['-D', 'LERTA_DEBUG']

# Has the linker of the system (as target_system names it) keep what ThinLTO optimizes in `dir`, so
# that a build optimizes again only the modules that have changed, and those that inline from them:
# ld64 for macOS, lld for Windows (see target_flags), and for Linux, GNU ld with LLVM's plugin,
# which clang uses by default there, as lld takes none of the plugin's options.
export const lto_cache_flags = (system: String, dir: String) ->
  case system
    when 'macos' then ["-Wl,-cache_path_lto,#{dir}"]
    when 'windows' then ["-Wl,--thinlto-cache-dir=#{dir}"]
    else ["-Wl,-plugin-opt,cache-dir=#{dir}"]

export const is_mingw = (target: String) -> target.ends_with('-w64-mingw32')

const target_flags = (target: String?): Array<String> ->
  return [] if not target
  const flags = ["--target=#{target}"]
  # GNU ld, which clang uses for mingw by default, cannot link the bitcode of -flto.
  flags.push '-fuse-ld=lld' if is_mingw(target)
  # 32-bit x86 computes doubles on the x87 by default, in more precision, which hides a result too
  # large for a double from the check of a Float's arithmetic; SSE2 computes them as doubles.
  flags.append ['-msse2', '-mfpmath=sse'] if is_32_bit_x86(target)
  flags

const is_32_bit_x86 = (target: String) ->
  const arch = target.split('-')[0]
  arch == 'i386' or arch == 'i486' or arch == 'i586' or arch == 'i686'

# What the name of an executable for the target ends with: `.exe` for Windows. Without a target,
# it is for the host, which is not Windows, as the compiler does not run there yet.
export const executable_suffix = (target: String?) ->
  target and is_mingw(target) then '.exe' else ''
