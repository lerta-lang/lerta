# The syntax tree. Nodes are classes, so that later passes can key maps by them, and so that the
# parser can adjust some after making them. The groups of fields without a kind of their own are
# structs: they are parts of a node, neither told apart nor changed.
import { TextPart } from './lexer/string_literal'

export struct Position
  line: Int
  column: Int

export class StringLiteral
  value: String
  position: Position

# `"a#{b}c"`: text parts and interpolated values, in order. A value is read as a call of its
# `to_string()`, `b.to_string()`, which gives its text.
export type InterpolationPart = TextPart | Call

export class Interpolation
  parts: Array<InterpolationPart>
  position: Position

export class NilLiteral
  position: Position

export class BooleanLiteral
  value: Bool
  position: Position

export class IntegerLiteral
  value: Int
  position: Position

export class Identifier
  name: String
  position: Position

# `throw message`: stops with the message, a String. It never gives a value.
export class Throw
  message: Expression
  position: Position

# `x!`: x without nil; it throws if x is nil.
export class Unwrap
  operand: Expression
  position: Position

# `x ? fallback`: x without nil, or the fallback if x is nil.
export class Coalesce
  value: Expression
  fallback: Expression
  position: Position

# `[a, b]`
export class ArrayLiteral
  elements: Array<Expression>
  position: Position

export struct MapEntry
  key: Expression
  value: Expression

export class MapLiteral
  entries: Array<MapEntry>
  position: Position

# The guard and the element of an Iter comprehension as function literals of the loop variable
# (see Comprehension).
export struct LazyFunctions
  guard: FunctionLiteral?
  element: FunctionLiteral

# `[f(x) for x in xs when g(x)]`: an array of the values of `element`, for each item for which the
# guard, if any, holds. In parentheses, `(f(x) for x in xs when g(x))`, it is an Iter of them,
# which computes them only as it is consumed; for that, `lazy` holds the guard and the element as
# function literals of the loop variable (the guard's gives a Bool). They share their bodies'
# expressions with `guard` and `element`, which are checked and generated only through them.
export class Comprehension
  element: Expression
  variable: Identifier
  iterable: Expression
  guard: Expression?
  lazy: LazyFunctions?
  position: Position

# A field of an anonymous struct, or a named argument of a call, which gives such a field or
# constructs a class or struct.
export struct NamedValue
  name: Identifier
  value: Expression

# `{ x: 1, y: 'a' }`, an anonymous struct; `{ x }` is short for `{ x: x }`.
export class RecordLiteral
  fields: Array<NamedValue>
  position: Position

# `object[index]`
export class Index
  object: Expression
  index: Expression
  position: Position

# `f(a, b)`, or `Point(x: 1, y: 2)` with named arguments, which construct a class or struct.
# `f<Int>(x)` gives a generic function its type arguments.
export class Call
  callee: Expression
  args: Array<Expression>
  named_args: Array<NamedValue>
  type_args: Array<TypeName>
  position: Position

# `@` inside a method or a field initializer: the object itself. `@x` is `this.x`.
export class This
  position: Position

# `object.name`
export class Member
  object: Expression
  name: Identifier
  position: Position

# `-` or `not`.
export class UnaryOperation
  operator: String
  operand: Expression
  position: Position

# An arithmetic or comparison operator, `and` or `or`.
export class BinaryOperation
  operator: String
  left: Expression
  right: Expression
  position: Position

# `x == nil` or `x != nil`, on either side.
export const is_nil_test = (binary: BinaryOperation) ->
  const compares = binary.operator == '==' or binary.operator == '!='
  compares and (binary.left is NilLiteral or binary.right is NilLiteral)

# `start...end`: the integers from start up to, but not including, end.
export class Range
  start: Expression
  end: Expression
  position: Position

# A type written in the source, such as `Int` in a parameter.
export class NamedType
  name: String
  args: Array<TypeName>
  position: Position
  # Written with `?`: the type or nil.
  optional = default false

export type UnionMember = NamedType | RecordTypeName

# `A | B`: a value of any of the member types.
export class UnionTypeName
  members: Array<UnionMember>
  position: Position

# `(A, B) -> R`: a function. Written in parentheses with `?` after them, `((A) -> R)?`, it may
# be nil.
export class FunctionTypeName
  params: Array<TypeName>
  result: TypeName
  position: Position
  optional = default false

export struct RecordTypeField
  name: Identifier
  type: TypeName

# `{ x: Int, y: String }`: an anonymous struct.
export class RecordTypeName
  fields: Array<RecordTypeField>
  position: Position
  optional = default false

export type TypeName = NamedType | UnionTypeName | FunctionTypeName | RecordTypeName

# A parameter's type may be left out where a function type is expected for the literal, or where
# its default is a literal that gives it.
export struct Parameter
  name: Identifier
  type: TypeName?
  # `y = 0`, which a call may leave out (see required_params).
  default: Expression?

# `T` in `<T>(x: T) -> x`, or `T: Shape`, whose type arguments must satisfy the interface Shape,
# or `X: Iterable<T>`.
export struct TypeParameter
  name: Identifier
  bound: NamedType?

# `(x: Int): Int -> body`. The body's last expression is the return value. A generic one,
# `<T>(x: T) -> body`, has type parameters.
export class FunctionLiteral
  type_params: Array<TypeParameter>
  params: Array<Parameter>
  return_type: TypeName?
  body: Array<Statement>
  position: Position

# `case` without a subject takes the first arm whose condition (its one pattern) is true. With a
# subject, a pattern is a type, which the subject must have, or a value, which it must equal; an
# arm may list several. `otherwise` is the `else` arm, which a case over every type of a union may
# leave out. An arm's body is its value after `then`, or a block whose last statement gives it.
export struct CaseArm
  patterns: Array<Expression>
  body: Array<Statement>

export class Case
  subject: Expression?
  arms: Array<CaseArm>
  otherwise: Array<Statement>?
  position: Position

# `try` and its block, then its `catch` clauses, tried in order, and its `finally` block, if any:
# it has at least one of them.
export class Try
  body: Array<Statement>
  catches: Array<Catch>
  finally_body: Array<Statement>?
  position: Position

# `catch e: T`, which takes an exception of the type, or a member of the union, `T`, or `catch e`,
# which takes any.
export class Catch
  name: Identifier
  type: TypeName?
  body: Array<Statement>
  position: Position

# `x is T`: whether x, of a union type, holds a T.
export class IsTest
  value: Expression
  type: NamedType
  position: Position

# `x as T?`, x if it holds a T and otherwise nil, or `x as T!`, which throws instead; x is of a
# union type. `type` is written without its `?`.
export class Cast
  value: Expression
  type: NamedType
  throws: Bool
  position: Position

# `condition then a else b`.
export class Conditional
  condition: Expression
  then_value: Expression
  else_value: Expression
  position: Position

# `break` or `continue`, which, like `return`, are expressions that never give a value, as `throw`.
export class Jump
  kind: JumpKind
  position: Position

export enum JumpKind
  'break'
  'continue'

# `pass`, an arm of a `case` that does nothing.
export class Pass
  position: Position

export class Return
  value: Expression?
  position: Position

export type Expression =
  StringLiteral | Interpolation | BooleanLiteral | NilLiteral | IntegerLiteral
  ArrayLiteral | Comprehension | MapLiteral | RecordLiteral | FunctionLiteral
  UnaryOperation | BinaryOperation | Range | IsTest | Cast | Conditional | Unwrap
  Identifier | This | Member | Index | Call
  Case | If | Coalesce | Throw | Jump | Return | Try

export class For
  variable: Identifier
  iterable: Expression
  body: Array<Statement>
  position: Position

# `const name = value` or `var name = value`. `exported` is set by `export`, as on the other
# declarations that it can precede.
export class Declaration
  mutable: Bool
  name: Identifier
  type: TypeName?
  value: Expression
  position: Position
  exported = false

# The operator that an assignment such as `+=` combines the old value and the new one with: `+`.
export const combining_operator = (operator: String) ->
  const bytes = operator.binary
  bytes.text(0, bytes.length - 1)!

export type AssignmentTarget = Identifier | Index | Member

export class Assignment
  operator: String
  target: AssignmentTarget
  value: Expression
  position: Position

# `if const name = value`: the condition holds when value is not nil, and name is the value
# without nil inside the body.
export class Binding
  name: Identifier
  value: Expression
  position: Position

export type Condition = Expression | Binding

# `else if` is an `if` alone in the else branch.
export class If
  condition: Condition
  then_body: Array<Statement>
  else_body: Array<Statement>
  position: Position
  # Whether it is `x?.rest`, whose else branch gives nil (see parse_nil_safe).
  nil_safe = false

export class While
  condition: Condition
  body: Array<Statement>
  position: Position

# A member of a class or struct body: a field (with a type, an initial value, or both) or, for a
# function literal value, a method.
export struct MemberDeclaration
  name: Identifier
  modifier: MemberModifier?
  type: TypeName?
  value: Expression?
  # `= default value`: a constructor argument that may be left out, for the value.
  has_default: Bool
  position: Position

export enum MemberModifier
  'const'
  'var'
  'weak!'

export class TypeDeclaration
  is_struct: Bool
  name: Identifier
  # A generic class or struct, `class Stack<T>`, has type parameters.
  type_params: Array<TypeParameter>
  members: Array<MemberDeclaration>
  position: Position
  # `struct IndexError: Error`: an interface that the type satisfies, whose members it has as fields
  # unless it declares them.
  satisfies: NamedType? = default nil
  exported = false

# `enum Name` followed by its members, one per line, each a name or a string literal: a type whose
# values are those members.
export class EnumDeclaration
  name: Identifier
  members: Array<Identifier | StringLiteral>
  position: Position
  exported = false

# `interface Name`, or `interface Name<T>` with type parameters, followed by its members, one per
# line, each `name: Type`: what a type must have to satisfy it.
export class InterfaceDeclaration
  name: Identifier
  type_params: Array<TypeParameter>
  members: Array<MemberDeclaration>
  position: Position
  exported = false

# `type Name = A | B`: another name for a type.
export class TypeAlias
  name: Identifier
  type: TypeName
  position: Position
  exported = false

# `import { a, b as c } from 'std:io'`, or from another file, `'./util'`. An imported name is
# known in the module by its alias, if it has one.
export struct ImportName
  name: Identifier
  alias: Identifier?

export class Import
  names: Array<ImportName>
  module: String
  position: Position

# `extern lerta_write as write: (Int, String) -> Int`: a C function, by its symbol, known in the
# module by the name after `as`, or by its symbol without one.
export class Extern
  symbol: Identifier
  name: Identifier
  type: TypeName
  position: Position
  exported = false

# `extend String` followed by methods, which the type has where the extend is in effect.
# `extend<T> Array<T>` declares the type parameters of a generic extend.
export class Extend
  type_params: Array<TypeParameter>
  type: TypeName
  members: Array<MemberDeclaration>
  position: Position

# The declarations on the second line are those the checker allows only at the top level.
export type Statement =
  Expression | Declaration | Assignment | If | While | For | Pass
  Import | TypeDeclaration | EnumDeclaration | InterfaceDeclaration | TypeAlias | Extern | Extend

export type Node = Statement | Binding | TypeName

# A new node of the same name, so that each place where a name is used has a node of its own.
export const copy_identifier = (identifier: Identifier) ->
  Identifier name: identifier.name, position: identifier.position

# The else branch of an `if` that is a statement. That of `x?.rest` gives the nil of its value,
# which a statement has none of.
export const statement_else_body = (if_statement: If): Array<Statement> ->
  if_statement.nil_safe then [] else if_statement.else_body

# Whether `export` precedes the statement.
export const is_exported = (statement: Statement) -> exported_declaration(statement) != nil

# A declaration that `export` can precede.
export type Exportable =
  Declaration | TypeDeclaration | EnumDeclaration | InterfaceDeclaration | TypeAlias | Extern

# The statement, if `export` can precede it.
export const as_exportable = (statement: Statement): Exportable? ->
  case statement
    when Declaration then statement
    when TypeDeclaration then statement
    when EnumDeclaration then statement
    when InterfaceDeclaration then statement
    when TypeAlias then statement
    when Extern then statement
    else nil

# The statement, if `export` precedes it.
export const exported_declaration = (statement: Statement) ->
  const declaration = as_exportable(statement) ? return nil
  declaration.exported then declaration else nil
