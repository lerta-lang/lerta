# The syntax tree. Nodes are classes, so that later passes can key maps by them, and so that the
# parser can adjust some after making them. The groups of fields without a kind of their own are
# structs: they are parts of a node, neither told apart nor changed.
import TextPart from './lexer/string_literal'
import Position from './position'
export Position from './position'

# `/pattern/flags`: the pattern as written, `\/` too, and the flags, the letters after it.
export class RegexLiteral
  args
    pattern: String
    flags: String
    var position: Position

export class StringLiteral
  args
    value: String
    var position: Position

# `"a#{b}c"`: text parts and interpolated values, in order. A value is read as a call of its
# `to_string()`, `b.to_string()`, which gives its text.
export type InterpolationPart = TextPart | Call

# A Binary literal, `b"..."` or `b'...'`, is one too, whether or not it interpolates, as its bytes
# need not be a String. An interpolated Binary is taken as it is, without its `to_string()`, which
# it has none of.
export class Interpolation
  args
    parts: InterpolationPart[]
    binary: Bool
    var position: Position

export class NilLiteral
  args
    var position: Position

export class BooleanLiteral
  args
    value: Bool
    var position: Position

export class IntegerLiteral
  args
    # Nil for a literal beyond Int, which only a Float can hold.
    value: Int?

    # As written, with its minus, which only `-0` needs as a Float, -0.0, and without separators:
    # `-12`, `0xff`.
    text: String

    var position: Position

# The value of an integer literal as a UInt64, which may be beyond Int, or nil if it is negative or
# beyond UInt64.
export uint64_value := (literal: IntegerLiteral) ->
  return value.to_uint64() if value := literal.value
  return nil if literal.text.starts_with('-')
  hex_digits := literal.text.without_prefix('0x')
  base: UInt64 = hex_digits then 16 else 10
  most := -1.to_bits()
  var value: UInt64 = 0
  for digit in (hex_digits else literal.text).binary
    digit_value := digit.hex_value()!.to_bits()
    return nil if value > (most - digit_value) / base
    value = value * base + digit_value
  value

# `1.5`, `1e9`: its text, without separators, which the compiler converts to a double as C does.
export class FloatLiteral
  args
    text: String
    var position: Position

export class Identifier
  args
    name: String
    var position: Position

  # Whether it is a name that nil_safe_object made.
  is_nil_safe_object := -> @name.starts_with('?')

# The name that the object of `x?.rest` at the position is bound to, which no source can write.
export nil_safe_object := (position: Position) ->
  Identifier(position, name: "?#{position.line}:#{position.column}")

# `throw error`: throws an Error. It never gives a value.
export class Throw
  args
    var message: Expression
    var position: Position

    # Made by the checker for `assert` (see compiler/checker/intrinsics.lerta): the message is a
    # String, of which an AssertionError is thrown.
    assertion := false

# `yield value`
export class Yield
  args
    var value: Expression
    var position: Position

    # That of the element of a comprehension written with its `for` first, which is an Iter.
    of_element := false

# `await promise`
export class Await
  args
    var operand: Expression
    var position: Position

# `x!`
export class Unwrap
  args
    var operand: Expression
    var position: Position

# `x else fallback`
export class Coalesce
  args
    var value: Expression
    var fallback: Expression
    var position: Position

# `[a, b]`
export class ArrayLiteral
  args
    elements: Expression[]
    var position: Position

export struct MapEntry
  key: Expression
  value: Expression

export class MapLiteral
  args
    entries: MapEntry[]
    var position: Position

# The guard and the element of an Iter comprehension as function literals of the loop variable,
# and of the index where it names one, `for x at i in xs` (see Comprehension).
export struct LazyFunctions
  guard: FunctionLiteral?
  element: FunctionLiteral
  indexed := false

# `[f(x) for x in xs when g(x)]`: an array of the values of `element`, for each item for which the
# guard, if any, holds. In parentheses, `(f(x) for x in xs when g(x))`, it is an Iter of them,
# which computes them only as it is consumed; for that, `lazy` holds the guard and the element as
# function literals of the loop variable (the guard's gives a Bool). They share their bodies'
# expressions with `guard` and `element`, which are checked and generated only through them.
export class Comprehension
  args
    element: Expression
    variable: Identifier
    var iterable: Expression
    guard: Expression?
    lazy: LazyFunctions?
    var position: Position

    # `for x at i in xs`: the name of each item's place, from 0.
    index: Identifier?

    # `for (a, b) in xs`: the declarations that take the item apart, before the guard (see
    # LoopHeader).
    bindings: Statement[] = []

    # An item `xs...` of an array literal, whose items it gives in its place, as `[x for x in xs]`.
    spread := false

    # The element of another, whose `for` it follows: `[f(x, y) for x in xs for y in ys]` is the
    # comprehension over `xs` of the nested one over `ys`, whose elements it takes as its own.
    nested := false

    # Written with its `for` first, `[` and a line end, then `for x in xs` and a block whose last
    # value is the element, after `body`, its statements before it.
    prefix := false
    body: Statement[] = []

export is_spread := (item: Expression) -> item is Comprehension and item.spread

# The name of a parameter of the function of an Iter comprehension with its `for` first, given a
# part of the value iterated (see prefix_iter), which the source cannot write: only the function's
# loop reads it. It ends with the position of its identifier, which a dump leaves out (see
# name_text).
export iterated_name := (index: Int, position: Position) ->
  "#{ITERATED}#{index}.#{position.line}.#{position.column}"

export is_iterated_name := (name: String) -> name.starts_with(ITERATED)

ITERATED := 'iterated.'

export is_nested := (element: Expression) -> element is Comprehension and element.nested

# The spread of the value, `value...`: the comprehension `[x for x in value]` marked to give its
# items in its place; its variable's name cannot be written, so no code can read it.
export spread_of_value := (value: Expression) ->
  { position } := value
  variable := Identifier(position, name: ' item')
  element := copy_identifier(variable)
  Comprehension(element, variable, position, iterable: value, guard: nil, lazy: nil, spread: true)

# A field of an anonymous struct, or a named argument of a call, which gives such a field or
# constructs a class or struct.
export struct NamedValue
  name: Identifier
  value: Expression

# `{ x: 1, y: 'a' }`, an anonymous struct; `{ x }` is short for `{ x: x }`.
export class RecordLiteral
  args
    fields: NamedValue[]
    var position: Position

    # `{ p..., x: 1 }`: the fields of p but those written (see the checker's replacements).
    spread: Comprehension?

# `(a, b)`, a tuple of two or more items.
export class TupleLiteral
  args
    items: Expression[]
    var position: Position

# The item at `index` of a tuple of `count` items, which a taking apart, `(a, b) := t`, reads
# for each name; it cannot be written.
export class TupleItem
  args
    tuple: Expression
    index: Int
    count: Int
    var position: Position

# `object[index]`
export class Index
  args
    var object: Expression
    var index: Expression

    # `m[k, default: d]`: what a map takes for a key that it does not hold.
    var default_value: Expression?

    var position: Position

# `f(a, b)`, or `Point(x: 1, y: 2)` with named arguments, which construct a class or struct.
# `f<Int>(x)` gives a generic function its type arguments.
export class Call
  args
    callee: Expression
    var args: Expression[]
    var named_args: NamedValue[]
    var type_args: TypeName[]
    var position: Position

    # Made by the parser for `m: Map<K, V>` without a value: of the builtin Map or Set, which
    # a local that takes the name does not hide, as it does not hide the written type.
    makes_builtin := false

# `@` inside a method or a field initializer: the object itself. `@x` is its member x.
export class This
  args
    var position: Position

# `object.name`
export class Member
  args
    var object: Expression
    name: Identifier
    var position: Position

# `-` or `not`.
export class UnaryOperation
  args
    operator: String
    var operand: Expression
    var position: Position

# An arithmetic or comparison operator, `and` or `or`.
export class BinaryOperation
  args
    operator: String
    var left: Expression
    var right: Expression
    var position: Position

EQUALITY_OPERATORS := ['==', '!=']

export is_equality_operator := (operator: String) -> operator in EQUALITY_OPERATORS

ORDER_OPERATORS := ['<', '<=', '>', '>=']

export is_order_operator := (operator: String) -> operator in ORDER_OPERATORS

# `x == nil` or `x != nil`, on either side.
export is_nil_test := (binary: BinaryOperation) ->
  compares := is_equality_operator(binary.operator)
  compares and (binary.left is NilLiteral or binary.right is NilLiteral)

# The bytes of a Binary literal that interpolates nothing, as `b'a'`; nil for any other expression.
export binary_literal_bytes := (expression: Expression) ->
  return nil if expression is not Interpolation or not expression.binary
  { parts } := expression
  return b'' if parts.is_empty()
  only := parts[0]
  parts.length == 1 and only is TextPart then only.bytes

# `a..b` or `a..=b`, which may leave out its start, `..b`, or its end, `a..`.
export class Range
  args
    var start: Expression?
    var end: Expression?
    var position: Position

    # `a..=b`, whose end is in it, rather than `a..b`; false without an end.
    inclusive: Bool

    # `a..b by step`, and `a..b reversed`, which only a loop goes through.
    var step: Expression?
    reversed := false

# A type written in the source, such as `Int` in a parameter.
export class NamedType
  args
    name: String
    args: TypeName[]
    position: Position

    # Written with `?`: the type or nil.
    var optional = false

export type UnionMember =
  NamedType | RecordTypeName | TupleTypeName | ArrayTypeName | FunctionTypeName

# `A | B`: a value of any of the member types. Written in parentheses with `?` after them,
# `(A | B)?`, it may be nil, as `A | B?` may.
export class UnionTypeName
  args
    members: UnionMember[]
    position: Position
    optional := false

# `(A, B) -> R`: a function. Written in parentheses with `?` after them, `((A) -> R)?`, it may
# be nil.
export class FunctionTypeName
  args
    params: TypeName[]
    result: TypeName
    position: Position
    optional := false

export struct RecordTypeField
  name: Identifier
  type: TypeName

# `{ x: Int, y: String }`: an anonymous struct.
export class RecordTypeName
  args
    fields: RecordTypeField[]
    position: Position
    optional := false

# `(Int, String)`: a tuple, of two or more items.
export class TupleTypeName
  args
    items: TypeName[]
    position: Position
    optional := false

# `T[]`: an array of `T`.
export class ArrayTypeName
  args
    element: TypeName
    position: Position
    var optional = false

export type TypeName =
  NamedType | UnionTypeName | FunctionTypeName | RecordTypeName | TupleTypeName | ArrayTypeName

# A parameter's type may be left out where a function type is expected for the literal, or where
# its default is a literal that gives it.
export struct Parameter
  name: Identifier
  type: TypeName?

  # `y = 0`, which a call may leave out (see required_params).
  default: Expression?

  # `rest: T...`, which takes the arguments after the others as a `T[]` (see packed_arguments).
  variadic := false

  # The names that `(a, b)` or `{ a, b }` takes the argument apart into, declared as the body
  # starts.
  parts: Identifier[] = []

# `T` in `<T>(x: T) -> x`, or `T: Shape`, whose type arguments must satisfy the interface Shape,
# or `X: Iterable<T>`.
export struct TypeParameter
  name: Identifier
  bound: NamedType?

# `<T>(x: T): T -> body`. `yields` and `await_at`, the first `await`, count only the body, outside
# the function literals in it.
export class FunctionLiteral
  args
    type_params: TypeParameter[]
    params: Parameter[]
    var return_type: TypeName?
    body: Statement[]
    var position: Position
    yields: Bool
    await_at: Position?

    # `weak -> body`: captures `@` without keeping it alive, and does nothing once it is gone.
    weak: Bool
  awaits := @await_at != nil

# `when a, b then body`; without a subject, it has one pattern, its condition. `otherwise` (in
# Case) is the `else` arm.
export struct CaseArm
  patterns: Expression[]
  body: Statement[]

export class Case
  args
    var subject: Expression?
    var arms: CaseArm[]
    otherwise: Statement[]?
    var position: Position

# `try` and its block, then its `catch` clauses, tried in order, and its `finally` block, if any:
# it has at least one of them.
export class Try
  args
    body: Statement[]
    catches: Catch[]
    finally_body: Statement[]?
    var position: Position

# `catch e: T` or `catch e`.
export class Catch
  args
    name: Identifier
    type: TypeName?
    body: Statement[]
    position: Position

# `x is T`, where T may be a union written in place: `x is A | B`.
export class IsTest
  args
    value: Expression
    type: TypeName
    var position: Position

# What a cast casts to: a named type or an array of them, written without the cast's `?`.
export type CastTypeName = NamedType | ArrayTypeName

# `x as T?` or `x as T!`.
export class Cast
  args
    var value: Expression
    type: CastTypeName
    throws: Bool
    var position: Position

# `condition then a else b`.
export class Conditional
  args
    var condition: Expression
    var then_value: Expression
    var else_value: Expression
    var position: Position

    # Written without `else`, whose value is then nil.
    without_else := false

# `break` or `continue`, which, like `return`, are expressions that never give a value, as `throw`.
export class Jump
  args
    kind: JumpKind
    var position: Position

enum JumpKind
  'break'
  'continue'

# `pass`, an arm of a `case` that does nothing.
export class Pass
  args
    position: Position

export class Return
  args
    var value: Expression?
    var position: Position

export type Expression =
  StringLiteral | Interpolation | BooleanLiteral | NilLiteral | IntegerLiteral | FloatLiteral
  RegexLiteral
  ArrayLiteral | Comprehension | MapLiteral | RecordLiteral | TupleLiteral | TupleItem
  FunctionLiteral | UnaryOperation | BinaryOperation | Range | IsTest | Cast | Conditional | Unwrap
  Identifier | This | Member | Index | Call | Case | If | Coalesce | Throw | Yield | Await | Jump
  Return | Try

export class For
  args
    variable: Identifier
    var iterable: Expression
    body: Statement[]
    position: Position
    index: Identifier?

# `name := value`, `name: Type = value` or `var name = value`. `exported` is set by `export`, as on
# the other declarations that it can precede.
export class Declaration
  args
    mutable: Bool
    name: Identifier
    var type: TypeName?
    var value: Expression
    position: Position

    # A part of the item of `for (a, b) in xs`, which, as a loop variable, is never warned about
    # when unused.
    of_loop := false

    # `weak const` or `weak var`: a local that holds an object of a class without keeping it alive.
    weak := false

    # `var x: T?` or `var xs: T[]`, whose value, nil or an empty one, is not written; dump_ast
    # writes it as a position, which the formatter's self-check leaves out, as writing the value (`=
    # nil`, `= []`) means the same.
    omits_value := false
  var exported = false

# Which declarations without a value start so, as the errors of those that cannot say.
export OMITTED_VALUES := 'only one of an optional type starts at nil, or one whose type is ' +
  'written as T[], Map<K, V> or Set<T> empty'

# The operator that an assignment such as `+=` combines the old value and the new one with: `+`.
export combining_operator := (operator: String) -> operator.without_suffix('=')!

export type AssignmentTarget = Identifier | Index | Member

export class Assignment
  args
    operator: String
    target: AssignmentTarget
    var value: Expression
    position: Position

# `if name := value`: the condition holds when value is not nil, and name is the value
# without nil inside the body.
export class Binding
  args
    name: Identifier
    var value: Expression
    position: Position

export type Condition = Expression | Binding

# `else if` is an `if` alone in the else branch.
export class If
  args
    var condition: Condition
    then_body: Statement[]
    else_body: Statement[]
    var position: Position

  # Whether it is `x?.rest`, whose else branch gives nil (see parse_nil_safe).
  var nil_safe = false

export class While
  args
    var condition: Condition
    body: Statement[]
    position: Position

# A member of a class or struct body: a field (with a type, an initial value, or both) or, for a
# function literal value, a method.
export struct MemberDeclaration
  name: Identifier
  modifier: MemberModifier?
  type: TypeName?
  value: Expression?

  # A weak field's type written `Type!`: reading it throws once its object is gone.
  throws: Bool

  position: Position

  # `private` before it: only the code of its module reaches it.
  private := false

  # Of the word `private` of the block that it is in, which makes it private.
  private_block: Position?

  # Declared in the `args` block of its type: a constructor argument, whose value is its default.
  in_args := false

  is_weak := -> @modifier == 'weak' or @modifier == 'weak var'
  is_mutable := -> @modifier == 'var' or @modifier == 'weak var'

export enum MemberModifier
  'var'
  'weak'
  'weak var'

export class TypeDeclaration
  args
    is_struct: Bool
    name: Identifier

    # A generic class or struct, `class Stack<T>`, has type parameters.
    type_params: TypeParameter[]

    members: MemberDeclaration[]
    position: Position

    # `struct IndexError: Error`: an interface that the type satisfies, whose members it has as
    # fields unless it declares them.
    satisfies: NamedType?

    # Of the word `args`, where the body's first line declares the constructor's arguments.
    args_position: Position?
  var exported = false

# `enum Name` followed by its members, one per line, each a name or a string literal: a type whose
# values are those members.
export class EnumDeclaration
  args
    name: Identifier
    members: (Identifier | StringLiteral)[]
    position: Position
  var exported = false

# `interface Name`, or `interface Name<T>` with type parameters, followed by its members, one per
# line, each `name: Type`: what a type must have to satisfy it.
export class InterfaceDeclaration
  args
    name: Identifier
    type_params: TypeParameter[]
    members: MemberDeclaration[]
    position: Position
  var exported = false

# `type Name = A | B`: another name for a type.
export class TypeAlias
  args
    name: Identifier
    type: TypeName
    position: Position
  var exported = false

# `import a, b as c from 'std:io'`, or from another file, `'./util'`. An imported name is
# known in the module by its alias, if it has one.
export struct ImportName
  name: Identifier
  alias: Identifier?

# `import 'module' as name`, which takes no names, gives the module's exports as `name.export`;
# with a type, `import './file' as NAME: Binary`, it embeds the file, which the loader makes a
# declaration of (see embedded_declaration).
# `export a, b as c from 'module'` exports the names as the module's own, and `export 'module'`
# exports none: both pass the module's extends on to the modules that import this one.
export class Import
  args
    var names: ImportName[]
    module: String
    position: Position
    alias: Identifier?
    type: TypeName?
  var exported = false

# `extern lerta_write as write: (Int, String) -> Int`: a C function, by its symbol, known in the
# module by the name after `as`, or by its symbol without one.
export class Extern
  args
    symbol: Identifier
    name: Identifier
    type: TypeName
    position: Position
  var exported = false

# `intrinsic assert`: a function of a standard module that the compiler gives, as it cannot be
# written in Lerta; or, with a type, `intrinsic optimized: Bool`, a value that the compiler gives,
# as only the build knows it (see docs/internals/compiler.md#intrinsics).
export class Intrinsic
  args
    name: Identifier
    position: Position
    type: TypeName?
  var exported = false

# `extend String` followed by methods, which the type has where the extend is in effect.
# `extend<T> T[]` declares the type parameters of a generic extend.
export class Extend
  args
    type_params: TypeParameter[]
    type: TypeName
    members: MemberDeclaration[]
    position: Position

# The declarations on the second line are those the checker allows only at the top level.
export type Statement =
  Expression | Declaration | Assignment | If | While | For | Pass | Import | TypeDeclaration
  EnumDeclaration | InterfaceDeclaration | TypeAlias | Extern | Intrinsic | Extend

export type Node = Statement | Binding | TypeName

# A new node of the same name, so that each place where a name is used has a node of its own.
export copy_identifier := (identifier: Identifier) -> Identifier(identifier...)

# The call of the method `name` of `object`, which the checker makes in place of what is written.
export method_call := (object: Expression, name: String, args: Expression[], at: Position) ->
  callee := Member(object, name: Identifier(name, position: at), position: at)
  Call(callee, args, position: at, named_args: [], type_args: [])

# The named arguments of a construction, of a class or struct, whose names alone, as in `Point(x)`,
# are those of the same names, `Point(x: x)`, first; its spread, `Point(p...)`, gives none of them.
export construction_arguments := (call: Call) ->
  from_names := [
    for arg in call.args when not is_spread(arg)
      shorthand_argument(arg as Identifier!)
  ]
  from_names + call.named_args

shorthand_argument := (name: Identifier) -> NamedValue(name: copy_identifier(name), value: name)

# The else branch of an `if` that is a statement. That of `x?.rest` gives the nil of its value,
# which a statement has none of.
export statement_else_body := (if_statement: If): Statement[] ->
  if_statement.nil_safe then [] else if_statement.else_body

# Whether `export` precedes the statement.
export is_exported := (statement: Statement) ->
  statement is Import then statement.exported else exported_declaration(statement) != nil

# A declaration that `export` can precede.
export type Exportable =
  Declaration | TypeDeclaration | EnumDeclaration | InterfaceDeclaration | TypeAlias | Extern
  Intrinsic

# The statement, if `export` can precede it.
export as_exportable := (statement: Statement) ->
  case statement
    when
      Declaration, TypeDeclaration, EnumDeclaration, InterfaceDeclaration, TypeAlias, Extern,
      Intrinsic
    then statement
    else nil

# The statement, if `export` precedes it.
export exported_declaration := (statement: Statement) ->
  declaration := as_exportable(statement) else return nil
  declaration.exported then declaration

# The expressions directly under the expression, in the order of the source, whether it evaluates
# them always, as the operands of `+`, or not, as the branches of `then`/`else` and the element of a
# comprehension. Those of a function literal, an `if`, a `case` and a `try`, which hold statements,
# are left to the passes that go through the syntax tree, as each treats them otherwise.
export operands_of := (expression: Expression): Expression[] ->
  case expression
    when Interpolation then [part for part in expression.parts when part is Call]
    when ArrayLiteral then expression.elements
    when Comprehension
      parts := [expression.element, expression.iterable]
      parts.push guard if guard := expression.guard
      parts
    when MapLiteral
      parts: Expression[]
      for entry in expression.entries
        parts.push entry.key
        parts.push entry.value
      parts
    when RecordLiteral then [field.value for field in expression.fields]
    when TupleLiteral then expression.items
    when TupleItem then [expression.tuple]
    when UnaryOperation then [expression.operand]
    when BinaryOperation then [expression.left, expression.right]
    when Range then [part for part in [expression.start, expression.end, expression.step] when part]
    when IsTest, Cast then [expression.value]
    when Conditional then [expression.condition, expression.then_value, expression.else_value]
    when Unwrap, Await then [expression.operand]
    when Member then [expression.object]
    when Index
      parts := [expression.object, expression.index]
      parts.push default_value if default_value := expression.default_value
      parts
    when Call
      parts := [expression.callee, expression.args...]
      parts.push arg.value for arg in expression.named_args
      parts
    when Coalesce then [expression.value, expression.fallback]
    when Throw then [expression.message]
    when Yield then [expression.value]
    when Return
      value := expression.value
      value then [value] else []
    else []
