# The types of values, as the checker works them out. They are values that are never changed, so
# that they can be shared; two are the same type when their keys are (see type_key).
import { compare_text, sorted } from './sort'

# `String`, `Int`, `Bool`, `Byte`, `Binary`, `void`, `nil`, the type of the literal `nil`, which
# fits any optional type, and `never`, the result of what does not return, such as `throw`, which
# fits wherever a value is expected.
export struct SimpleType
  kind: TypeKind

# The kind of a type: that of a simple type, or the sort of type it is (see kind_of).
export enum TypeKind
  'String'
  'Int'
  'Bool'
  'Byte'
  'Binary'
  'void'
  'never'
  'nil'
  ARRAY
  MAP
  ITER
  RECORD
  OBJECT
  ENUM
  UNION
  OPTIONAL
  TYPE_PARAMETER
  FUNCTION

export struct ArrayType
  element: Type

export struct MapType
  key: Type
  value: Type

# A lazy sequence of items, which can be traversed only once.
export struct IterType
  item: Type

export struct RecordField
  name: String
  type: Type

# An anonymous struct, `{ x: Int, y: String }`; its fields are kept in name order, so that the
# order they are written in does not matter (see record_type).
export struct RecordType
  fields: Array<RecordField>

# A class or struct (see ObjectInfo). Its name is the one it is declared with; its symbol, made of
# its module's index and its name, tells it apart from another module's type of the same name, and
# `module` names that module in messages.
export struct ObjectType
  name: String
  symbol: String
  module: String
  is_struct: Bool

# An enum: its values are its members, held as their places among them (see EnumDeclaration). Its
# name, symbol and module are as those of an ObjectType.
export struct EnumType
  name: String
  symbol: String
  module: String
  members: Array<EnumMember>

# A member of an enum, a name, `INTEGER`, or a string literal, `'('`, by its text, which its
# to_string gives.
export struct EnumMember
  text: String
  is_name: Bool

# How a member is written in messages: as it is declared.
export const format_enum_member = (member: EnumMember) ->
  member.is_name then member.text else "'#{member.text}'"

# `A | B`: classes and structs, by name; the object carries which one it is. The members are kept
# in order (see union_type).
export struct UnionType
  members: Array<Type>

# `T?`: a T or nil.
export struct OptionalType
  inner: Type

# A type parameter of a generic function, `T` in `<T>(x: T) -> x`, in the types of its parameters
# before the type arguments replace it (see GenericFunction).
export struct TypeParameterType
  name: String

export struct FunctionType
  params: Array<Type>
  result: Type

export type Type =
  SimpleType | ArrayType | MapType | IterType | RecordType | ObjectType | EnumType
  UnionType | OptionalType | TypeParameterType | FunctionType

export const string_type = SimpleType(kind: 'String')
export const int_type = SimpleType(kind: 'Int')
export const bool_type = SimpleType(kind: 'Bool')
export const byte_type = SimpleType(kind: 'Byte')
export const binary_type = SimpleType(kind: 'Binary')
export const void_type = SimpleType(kind: 'void')
export const never_type = SimpleType(kind: 'never')
export const nil_type = SimpleType(kind: 'nil')

export const kind_of = (type: Type): TypeKind ->
  case type
    when SimpleType then type.kind
    when ArrayType then ARRAY
    when MapType then MAP
    when IterType then ITER
    when RecordType then RECORD
    when ObjectType then OBJECT
    when EnumType then ENUM
    when UnionType then UNION
    when OptionalType then OPTIONAL
    when TypeParameterType then TYPE_PARAMETER
    when FunctionType then FUNCTION

export const is_kind = (type: Type, kind: TypeKind) -> kind_of(type) == kind

export const is_one_of_kinds = (type: Type, kinds: Array<TypeKind>) ->
  kinds.contains(kind_of(type))

export const record_type = (fields: Array<RecordField>) ->
  RecordType fields: sorted(fields, (a, b) -> compare_text(a.name, b.name))

# `T?` of a T that may be nil already, as a type argument may be, is T.
export const optional_type = (inner: Type): Type ->
  inner is OptionalType then inner else OptionalType(inner)

# The members are kept in the order of their keys, so that `A | B` and `B | A` are the same type.
export const union_type = (members: Array<Type>) ->
  UnionType members: sorted(members, (a, b) -> compare_text(type_key(a), type_key(b)))

# How a type is written in messages. A class, struct or enum is written by its name, and with its
# module where `qualified` says so, or where a union holds another of the same name.
export const format_type = (type: Type) -> format_qualified(type, false)

export const format_qualified = (type: Type, qualified: Bool): String ->
  const format = (inner: Type) -> format_qualified(inner, qualified)
  case type
    when SimpleType then type.kind.to_string()
    when ArrayType then "Array<#{format(type.element)}>"
    when IterType then "Iter<#{format(type.item)}>"
    when MapType then "Map<#{format(type.key)}, #{format(type.value)}>"
    when ObjectType then qualified then "#{type.name} (of #{type.module})" else type.name
    when EnumType then qualified then "#{type.name} (of #{type.module})" else type.name
    when RecordType
      const fields = ["#{field.name}: #{format(field.type)}" for field in type.fields]
      "{ #{fields.join(', ')} }"
    when UnionType
      [format_member_qualified(member, type, qualified) for member in type.members].join(' | ')
    when OptionalType
      const inner = type.inner
      const needs_parentheses = inner is FunctionType or inner is UnionType
      needs_parentheses then "(#{format(inner)})?" else "#{format(inner)}?"
    when TypeParameterType then type.name
    when FunctionType
      "(#{[format(param) for param in type.params].join(', ')}) -> #{format(type.result)}"

# A member of a union, with its module if another member has the same name.
export const format_member = (member: Type, union: Type) ->
  format_member_qualified member, union, false

const format_member_qualified = (member: Type, union: Type, qualified: Bool) ->
  return format_qualified(member, qualified) if not (member is ObjectType)
  return format_qualified(member, qualified) if not (union is UnionType)
  const shares_name = (other: Type) ->
    return false if not (other is ObjectType)
    other.name == member.name and not same_type(other, member)
  format_qualified member, qualified or union.members.any(shares_name)

# Two types for a message: as format_type writes them, or, if that cannot tell them apart, with
# the modules of their classes and structs.
export const format_types = (a: Type, b: Type) ->
  const first = format_type(a)
  const second = format_type(b)
  return { first, second } if first != second
  { first: format_qualified(a, true), second: format_qualified(b, true) }

# Identifies a type: as format_type writes it, with classes and structs by their symbols.
export const type_key = (type: Type): String ->
  case type
    when SimpleType then type.kind.to_string()
    when ObjectType then type.symbol
    when EnumType then type.symbol
    when RecordType
      "{#{["#{field.name}: #{type_key(field.type)}" for field in type.fields].join(', ')}}"
    when ArrayType then "Array<#{type_key(type.element)}>"
    when IterType then "Iter<#{type_key(type.item)}>"
    when MapType then "Map<#{type_key(type.key)}, #{type_key(type.value)}>"
    when UnionType then [type_key(member) for member in type.members].join(' | ')
    when OptionalType then "(#{type_key(type.inner)})?"
    when FunctionType
      "(#{[type_key(param) for param in type.params].join(', ')}) -> #{type_key(type.result)}"
    when TypeParameterType then type.name

export const same_type = (a: Type, b: Type) -> type_key(a) == type_key(b)

# Values of these types are reference counted; a function value is a closure.
export const is_reference_type = (type: Type): Bool ->
  case type
    when SimpleType then type.kind == 'String' or type.kind == 'Binary'
    when OptionalType then is_reference_type(type.inner)
    when TypeParameterType then false
    when EnumType then false
    else true

# The type of the items of an array, a Binary or an Iter, which `for` and lazy methods such as
# `map` go through.
export const iterable_item = (type: Type): Type? ->
  case type
    when ArrayType then type.element
    when IterType then type.item
    else is_kind(type, 'Binary') then byte_type else nil

# A T or nil also fits where a T? is expected.
export const is_assignable = (value: Type, target: Type): Bool ->
  return true if is_kind(value, 'never')
  if target is UnionType
    const members = value is UnionType then value.members else [value]
    const is_member = (member: Type) -> target.members.any((type) -> same_type(type, member))
    return members.all(is_member)
  if target is OptionalType
    return true if is_kind(value, 'nil') or is_assignable(value, target.inner)
  same_type value, target

# A class, or a union of classes, compares by identity. A struct will compare by its fields, so it
# does not compare yet.
export const is_identity_type = (type: Type): Bool ->
  case type
    when ObjectType then not type.is_struct
    when UnionType then type.members.all(is_identity_type)
    else false

# Maps hash and compare their keys in the runtime, which knows these kinds; an enum's value is an
# Int there.
export const is_map_key_type = (type: Type) ->
  is_one_of_kinds(type, ['String', 'Int', ENUM]) or is_identity_type(type)

# The type of a value that is either an `a` or a `b`: the same type, or `T?` for a mix of `T`,
# `T?` and nil; `never`, which gives no value, does not count. Nil if there is none.
export const unify = (a: Type, b: Type) ->
  return a if same_type(a, b) or is_kind(b, 'never')
  return b if is_kind(a, 'never')
  return a if is_kind(a, 'nil') and is_kind(b, 'nil')
  return optional_type(inner_of(b)) if is_kind(a, 'nil')
  return optional_type(inner_of(a)) if is_kind(b, 'nil')
  const is_optional = a is OptionalType or b is OptionalType
  is_optional and same_type(inner_of(a), inner_of(b)) then optional_type(inner_of(a)) else nil

# The type without nil: the inner type of an optional one.
export const inner_of = (type: Type) -> type is OptionalType then type.inner else type
