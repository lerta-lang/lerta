# The types of values, as the checker works them out. They are values that are never changed, so
# that they can be shared; two are the same type when their keys are (see type_key).

# `String`, `Int`, `Float`, `Float32`, `Bool`, `Byte`, `Binary`, `void`, `nil`, the type of the
# literal `nil`, which fits any optional type, and `never`, the result of what does not return, such
# as `throw`, which fits wherever a value is expected.
export struct SimpleType(kind: TypeKind)

# The kind of a type: that of a simple type, or the sort of type it is (see kind_of).
export enum TypeKind
  'String'
  'Int'
  'Float'
  'Float32'
  'Bool'
  'Byte'
  'Int8'
  'Int16'
  'Int32'
  'UInt16'
  'UInt32'
  'UInt64'
  'Char'
  'Binary'
  'void'
  'never'
  'nil'
  ARRAY
  MAP
  ITER
  PROMISE
  RECORD
  TUPLE
  OBJECT
  INTERFACE
  ENUM
  UNION
  OPTIONAL
  TYPE_PARAMETER
  FUNCTION

export struct ArrayType(element: Type)

# A map, or a set: a map whose value type is void, which holds no values (see set_of).
export struct MapType(key: Type, value: Type)

# A lazy sequence of items, which can be traversed only once.
export struct IterType(item: Type)

# The result of an async function, which gives its value, or its exception, once settled.
export struct PromiseType(value: Type)

export struct RecordField(name: String, type: Type)

# An anonymous struct, `{ x: Int, y: String }`; its fields are kept in name order, so that the
# order they are written in does not matter (see record_type).
export struct RecordType(fields: RecordField[])

# `(Int, String)`: values taken apart by position, each named where it is used.
export struct TupleType(items: Type[])

# A class or struct (see ObjectInfo). Its name is the one it is declared with; its symbol, made of
# its module's symbol name and its name, tells it apart from another module's type of the same
# name, and `module` names that module in messages.
export struct ObjectType
  name: String
  symbol: String
  module: String
  is_struct: Bool
  # The type arguments of a generic class or struct, as `Int` of `Stack<Int>`.
  args: Type[]

# An interface (see InterfaceInfo), named as an ObjectType is. Its value holds a value of a type
# that satisfies it, with the itab that reads that type's members.
export struct InterfaceType
  name: String
  symbol: String
  module: String
  # The type arguments of a generic interface, as `Int` of `Iterable<Int>`.
  args: Type[]

# An enum: its values are its members, held as their places among them (see EnumDeclaration). Its
# name, symbol and module are as those of an ObjectType.
export struct EnumType(name: String, symbol: String, module: String, members: EnumMember[])

# A member of an enum, a name, `INTEGER`, or a string literal, `'('`, by its text, which its
# to_string gives.
export struct EnumMember(text: String, is_name: Bool)

# How a member is written in messages: as it is declared.
export format_enum_member := (member: EnumMember) ->
  member.is_name then member.text else "'#{member.text}'"

# `A | B`: classes and structs, by name; the object carries which one it is. The members are kept
# in order (see union_type).
export struct UnionType(members: Type[])

# `T?`: a T or nil.
export struct OptionalType(inner: Type)

# A type parameter of a generic function, `T` in `<T>(x: T) -> x`, in the types of its parameters
# before the type arguments replace it (see GenericFunction).
export struct TypeParameterType(name: String)

export struct FunctionType(params: Type[], result: Type)

export type Type =
  SimpleType | ArrayType | MapType | IterType | PromiseType | RecordType | TupleType | ObjectType
  InterfaceType | EnumType | UnionType | OptionalType | TypeParameterType | FunctionType

export string_type := SimpleType(kind: 'String')
export int_type := SimpleType(kind: 'Int')
export float_type := SimpleType(kind: 'Float')
export float32_type := SimpleType(kind: 'Float32')
export bool_type := SimpleType(kind: 'Bool')
export byte_type := SimpleType(kind: 'Byte')
export char_type := SimpleType(kind: 'Char')
export binary_type := SimpleType(kind: 'Binary')
export void_type := SimpleType(kind: 'void')
export never_type := SimpleType(kind: 'never')
export nil_type := SimpleType(kind: 'nil')

export kind_of := (type: Type): TypeKind ->
  case type
    when SimpleType then type.kind
    when ArrayType then ARRAY
    when MapType then MAP
    when IterType then ITER
    when PromiseType then PROMISE
    when RecordType then RECORD
    when TupleType then TUPLE
    when ObjectType then OBJECT
    when InterfaceType then INTERFACE
    when EnumType then ENUM
    when UnionType then UNION
    when OptionalType then OPTIONAL
    when TypeParameterType then TYPE_PARAMETER
    when FunctionType then FUNCTION

export is_kind := (type: Type, kind: TypeKind) -> kind_of(type) == kind

# The integer types, `Int` and `Byte` among them, which differ in their bits and their sign.
export INTEGER_KINDS: TypeKind[] =
  'Int', 'Byte', 'Int8', 'Int16', 'Int32', 'UInt16', 'UInt32', 'UInt64'

export is_integer := (type: Type) -> is_one_of_kinds(type, INTEGER_KINDS)

# The floating-point types, of 64 and of 32 bits.
export FLOAT_KINDS: TypeKind[] = ['Float', 'Float32']

export is_float := (type: Type) -> is_one_of_kinds(type, FLOAT_KINDS)

export SIGNED_INTEGER_KINDS: TypeKind[] = ['Int', 'Int8', 'Int16', 'Int32']

export is_signed := (type: Type) -> is_one_of_kinds(type, SIGNED_INTEGER_KINDS)

export integer_bits := (type: Type) ->
  case kind_of(type)
    when 'Byte', 'Int8' then 8
    when 'Int16', 'UInt16' then 16
    when 'Int32', 'UInt32', 'Char' then 32
    else 64

# The least and the largest value of an integer type, from its bits and its sign; a UInt64's
# largest is taken as the largest Int, as no value above it can be written.
export integer_range := (type: Type) ->
  bits := integer_bits(type)
  # -(2 to the bits - 1), in steps that stay within an Int.
  var signed_least = -1
  signed_least *= 2 for _ in 1...bits
  signed_most := -(signed_least + 1)
  return { least: signed_least, most: signed_most } if is_signed(type)
  { least: 0, most: bits == 64 then signed_most else signed_most * 2 + 1 }

export is_one_of_kinds := (type: Type, kinds: TypeKind[]) -> kinds.contains(kind_of(type))

export record_type := (fields: RecordField[]) ->
  RecordType fields: fields.sorted((a, b) -> a.name.compare(b.name))

# `T?` of a T that may be nil already, as a type argument may be, is T.
export optional_type := (inner: Type): Type ->
  inner is OptionalType then inner else OptionalType(inner)

# The members are kept in the order of their keys, so that `A | B` and `B | A` are the same type.
export union_type := (members: Type[]) ->
  UnionType members: members.sorted((a, b) -> type_key(a).compare(type_key(b)))

# The union of the types, each a member of a union, a union, or one of those optional, or nil: an
# optional one if any of them is. Nil if one is none of those.
export union_of := (types: Type[]): Type? ->
  members: Type[]
  var optional = false
  for type in types
    optional = true if type is OptionalType or is_kind(type, 'nil')
    continue if is_kind(type, 'nil')
    inner := inner_of(type)
    added: Type[] = inner is UnionType then inner.members else [inner]
    for member in added
      return nil if not is_union_member(member)
      members.push member if not members.any((other) -> same_type(other, member))
  union := members.length == 1 then members[0] else union_type(members)
  optional then optional_type(union) else union

# A type whose values a union may hold: a class or a struct, as it is, or a value of the others,
# which a union holds boxed (see codegen boxes).
export is_union_member := (type: Type) ->
  type is ObjectType or type is EnumType or is_one_of_kinds(type, UNION_VALUE_KINDS)

UNION_VALUE_KINDS: TypeKind[] = [
  INTEGER_KINDS...
  'Char'
  'Float'
  'Float32'
  'Bool'
  'String'
  'Binary'
]

# How a type is written in messages. A class, struct or enum is written by its name, and with its
# module where `qualified` says so, or where a union holds another of the same name.
export format_type := (type: Type) -> format_qualified(type, false)

export format_qualified := (type: Type, qualified: Bool): String ->
  format := (inner: Type) -> format_qualified(inner, qualified)
  case type
    when SimpleType then type.kind.to_string()
    when ArrayType then "#{operand_text(type.element, format)}[]"
    when IterType then "Iter<#{format(type.item)}>"
    when PromiseType then promise_text(type, format)
    when MapType then map_text(type, format)
    when ObjectType, InterfaceType
      format_named type.name, type.module, type.args, format, qualified
    when EnumType then qualified then "#{type.name} (of #{type.module})" else type.name
    when RecordType
      fields := ["#{field.name}: #{format(field.type)}" for field in type.fields]
      "{ #{fields.join(', ')} }"
    when TupleType then "(#{[format(item) for item in type.items].join(', ')})"
    when UnionType
      [format_member_qualified(member, type, qualified) for member in type.members].join(' | ')
    when OptionalType then "#{operand_text(type.inner, format)}?"
    when TypeParameterType then type.name
    when FunctionType
      "(#{[format(param) for param in type.params].join(', ')}) -> #{format(type.result)}"

# The type that `?` or `[]` follows, in parentheses if it would otherwise apply to a part of it.
operand_text := (operand: Type, write: (Type) -> String) ->
  needs_parentheses := operand is FunctionType or operand is UnionType
  needs_parentheses then "(#{write(operand)})" else write(operand)

map_text := (type: MapType, format: (Type) -> String) ->
  key := format(type.key)
  is_set(type) then "Set<#{key}>" else "Map<#{key}, #{format(type.value)}>"

# A Promise of no value is written without a type argument.
promise_text := (type: PromiseType, write: (Type) -> String) ->
  is_kind(type.value, 'void') then 'Promise' else "Promise<#{write(type.value)}>"

# A class, struct or interface, with its type arguments, and its module where `qualified` says so.
format_named := (
  name: String, module: String, args: Type[], format: (Type) -> String, qualified: Bool
) ->
  written_args := [format(arg) for arg in args].join(', ')
  written := args.is_empty() then name else "#{name}<#{written_args}>"
  qualified then "#{written} (of #{module})" else written

# A member of a union, with its module if another member has the same name.
export format_member := (member: Type, union: Type) -> format_member_qualified(member, union, false)

format_member_qualified := (member: Type, union: Type, qualified: Bool) ->
  return format_qualified(member, qualified) if member is not ObjectType
  return format_qualified(member, qualified) if union is not UnionType
  shares_name := (other: Type) ->
    return false if other is not ObjectType
    other.name == member.name and not same_type(other, member)
  format_qualified member, qualified or union.members.any(shares_name)

# Two types for a message: as format_type writes them, or, if that cannot tell them apart, with
# the modules of their classes and structs.
export format_types := (a: Type, b: Type) ->
  first := format_type(a)
  second := format_type(b)
  return { first, second } if first != second
  { first: format_qualified(a, true), second: format_qualified(b, true) }

# Identifies a type: as format_type writes it, with classes and structs by their symbols.
export type_key := (type: Type): String ->
  case type
    when SimpleType then type.kind.to_string()
    when ObjectType, InterfaceType then named_key(type.symbol, type.args)
    when EnumType then type.symbol
    when RecordType
      "{#{["#{field.name}: #{type_key(field.type)}" for field in type.fields].join(', ')}}"
    when TupleType then "(#{[type_key(item) for item in type.items].join(', ')})"
    when ArrayType then "Array<#{type_key(type.element)}>"
    when IterType then "Iter<#{type_key(type.item)}>"
    when PromiseType then promise_text(type, type_key)
    when MapType then "Map<#{type_key(type.key)}, #{type_key(type.value)}>"
    when UnionType then [type_key(member) for member in type.members].join(' | ')
    when OptionalType then "(#{type_key(type.inner)})?"
    when FunctionType
      "(#{[type_key(param) for param in type.params].join(', ')}) -> #{type_key(type.result)}"
    when TypeParameterType then type.name

named_key := (symbol: String, args: Type[]) ->
  return symbol if args.is_empty()
  "#{symbol}<#{[type_key(arg) for arg in args].join(', ')}>"

export same_type := (a: Type, b: Type) -> type_key(a) == type_key(b)

# Values of these types are references to objects that are reference counted; a function value
# is a closure. An interface value holds one, besides its itab.
export is_reference_type := (type: Type): Bool ->
  case type
    when SimpleType then type.kind == 'String' or type.kind == 'Binary'
    when OptionalType then is_reference_type(type.inner)
    when TypeParameterType, EnumType, InterfaceType then false
    else true

# The type of the items of an array, a Binary or an Iter, which `for` and lazy methods such as
# `map` go through.
export iterable_item := (type: Type): Type? ->
  case type
    when ArrayType then type.element
    when IterType then type.item
    else is_kind(type, 'Binary') then byte_type

# The members of a union, or the type alone.
export members_of := (type: Type): Type[] -> type is UnionType then type.members else [type]

# Whether a union holds a value of the type, one of its members, in a box (see codegen boxes):
# one that is not a class or a struct, which are heap objects of their own.
export is_boxed := (member: Type) ->
  member is not ObjectType and member is not UnionType and member is not OptionalType

# Whether a value of the type, a T or a T?, fits where the union, or an optional one, is expected
# only in a box: as an Int where an `Int | String` is.
export boxes_into := (type: Type, target: Type) ->
  value := inner_of(type)
  inner_of(target) is UnionType and value is not UnionType and is_boxed(value)

# A T or nil also fits where a T? is expected.
export is_assignable := (value: Type, target: Type): Bool ->
  return true if is_kind(value, 'never')
  if target is UnionType
    is_member := (member: Type) -> target.members.any((type) -> same_type(type, member))
    return members_of(value).all(is_member)
  if target is OptionalType
    return true if is_kind(value, 'nil') or is_assignable(value, target.inner)
    return is_assignable(value.inner, target.inner) if value is OptionalType
  same_type value, target

# A class, or a union of classes, compares by identity; other types that compare do so by their
# contents.
export is_identity_type := (type: Type): Bool ->
  case type
    when ObjectType then not type.is_struct
    when UnionType then type.members.all(is_identity_type)
    else false

# The type of a value that is either an `a` or a `b`: the same type, `T?` for a mix of `T`, `T?`
# and nil, or a union for a mix of it and some of its members (see wider_union); `never`, which
# gives no value, does not count, and void, which gives none either, unifies with nothing else. Nil
# if there is none.
export unify := (a: Type, b: Type) ->
  return a if same_type(a, b) or is_kind(b, 'never')
  return b if is_kind(a, 'never')
  return a if is_kind(a, 'nil') and is_kind(b, 'nil')
  return nil if is_kind(a, 'void') or is_kind(b, 'void')
  return optional_type(inner_of(b)) if is_kind(a, 'nil')
  return optional_type(inner_of(a)) if is_kind(b, 'nil')
  is_optional := a is OptionalType or b is OptionalType
  inner := wider_union(inner_of(a), inner_of(b)) ? return nil
  is_optional then optional_type(inner) else inner

# Of a type and a union, or two unions, the one that the other fits in, as a narrowed local's type
# fits in its own: the type itself if they are the same.
wider_union := (a: Type, b: Type) ->
  return a if same_type(a, b)
  return b if b is UnionType and is_assignable(a, b)
  return a if a is UnionType and is_assignable(b, a)
  nil

# The type of a value of a union type, optional or not, that is none of `excluded`'s members, or nil
# if it can only be nil.
export other_members := (type: Type, excluded: Type) ->
  excluded_keys := [type_key(member) for member in members_of(excluded)]
  is_left := (member: Type) -> not excluded_keys.contains(type_key(member))
  left := [member for member in members_of(inner_of(type)) when is_left(member)]
  return nil if left.is_empty()
  others: Type = left.length == 1 then left[0] else union_type(left)
  type is OptionalType then optional_type(others) else others

# `Set<T>`, a map without values.
export set_of := (item: Type) -> MapType(key: item, value: void_type)

export is_set := (type: Type) -> type is MapType and is_kind(type.value, 'void')

# The type without nil: the inner type of an optional one.
export inner_of := (type: Type) -> type is OptionalType then type.inner else type
