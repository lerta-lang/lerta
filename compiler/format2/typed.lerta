# The rewrites that need the types of the checking, which reads the nodes that the formatter parsed,
# so the facts that it records of them are found by those nodes.
import
  BinaryOperation, Call, Cast, Expression, Identifier, Import, ImportName, IntegerLiteral, Member,
  NamedValue, Statement, StringLiteral, Index, This
from '../ast'
import check_program from '../checker/modules'
import ImportedName, ModuleAlias from '../checker/imports'
import NodeFacts, ProgramWide from '../checker/shared'
import CompileError from '../errors'
import has_is_empty from '../format/annotations'
import runs_no_code from '../format/rewrites'
import bool_type from '../types'
import CLOSING_BRACKETS, OPENING_BRACKETS from '../lexer/tokens'
import
  EMPTINESS_TESTS, EXPECTED_TYPES, MEMBERSHIP_TESTS, REDUNDANT_CASTS, SHORTHAND_ARGUMENTS,
  UNUSED_IMPORTS
from '../format/rules'
import load_modules from '../loader'
import Change, Edit from './edits'
import Tokens from './tokens'

# What the checking records of the nodes of the source: the facts, and the names that its imports
# give that are never used.
export struct Typed
  facts: NodeFacts
  unused_imports: Set<Identifier>

# Nil where the program does not check, whose types are not known: its typed rewrites wait.
export typed_program := (path: String, source: String, statements: Statement[]): Promise<Typed?> ->
  try
    modules := await load_modules(path, { source, program: statements })
    program := ProgramWide(modules, entry_path: path, finds_all_errors: false)
    check_program program
    shared := program.shared[modules.last()!.index]
    { imports } := shared
    imported: (ImportedName | ModuleAlias)[] = [
      imports.names.values()...
      imports.modules.values()...
    ]
    unused_imports := Set([each.name for each in imported when not each.used])
    { facts: shared.facts, unused_imports }
  catch _: CompileError
    nil

export typed_edits := (tokens: Tokens, value: Expression, typed: Typed): Edit?[] ->
  case value
    when Cast then [redundant_cast(tokens, value, typed.facts)]
    when Member then [unqualified(tokens, value, typed.facts)]
    when BinaryOperation then [emptiness_test(tokens, value, typed.facts)]
    when Call
      { facts } := typed
      [
        recorded(tokens, value, facts)
        membership_test(tokens, value, facts)
        shorthand_arguments(tokens, value, facts)...
      ]
    else []

export typed_statement_edits := (tokens: Tokens, statement: Statement, typed: Typed): Edit?[] ->
  case statement
    when Import then [unused_imports(tokens, statement, typed.unused_imports)]
    else []

# The import without the names that are never used (see Unused names); only reported where it gives
# none that is, as an import runs the module's top-level code and brings its extends, which leaving
# it out would lose. One that exports its names is used by the modules that import it.
unused_imports := (tokens: Tokens, statement: Import, unused: Set<Identifier>) ->
  return nil if statement.exported
  if alias := statement.alias
    return alias in unused then tokens.report(UNUSED_IMPORTS, statement.position)
  { names } := statement
  is_unused := (name: ImportName) -> name.alias ? name.name in unused
  return nil unless names.any(is_unused)
  return tokens.report(UNUSED_IMPORTS, statement.position) if names.all(is_unused)
  spans: Span[]
  for name in names
    first := tokens.at(name.name.position) ? return nil
    last := tokens.at((name.alias ? name.name).position) ? return nil
    spans.push { first, last, unused: is_unused(name) }
  # At the first name left out, not at the comma before it.
  first_unused := spans.find((span) -> span.unused)!
  # A comment after the last name, left out, would stay after a name kept.
  last_line := tokens.code[spans.last()!.last].end_line
  if spans.last()!.unused and tokens.comments.any((comment) -> comment.line == last_line)
    return tokens.report(UNUSED_IMPORTS, tokens.start(first_unused.first))
  tokens.edit_at UNUSED_IMPORTS, tokens.start(first_unused.first), left_out_names(tokens, spans)

# The tokens of a name of an import, from its name through its alias.
struct Span
  first: Int
  last: Int
  unused: Bool

# Each unused name left out with the comma and the spaces after it, but those after the last kept
# name left out from the end of that name, with the commas before them.
left_out_names := (tokens: Tokens, spans: Span[]) ->
  var kept_last = spans.length - 1
  kept_last -= 1 while spans[kept_last].unused
  changes: Change[]
  for span, index in spans[..kept_last]
    next := spans[index + 1].first
    changes.push { from: tokens.start(span.first), to: tokens.start(next), text: '' } if span.unused
  if kept_last < spans.length - 1
    changes.push {
      from: tokens.end(spans[kept_last].last)
      to: tokens.end(spans.last()!.last)
      text: ''
    }
  changes

# `MEMBER` for `E.MEMBER` where E is expected (see Expected types).
unqualified := (tokens: Tokens, member: Member, facts: NodeFacts) ->
  return nil unless member in facts.unqualifiable
  first := tokens.at(member.position) ? return nil
  name := tokens.at(member.name.position) ? return nil
  return nil unless tokens.is_kind(name - 1, '.')
  change := Change(from: tokens.start(first), to: tokens.start(name), text: '')
  tokens.edit_at EXPECTED_TYPES, member.position, [change]

# `{ x: 1 }` for `S(x: 1)` where S is expected (see Expected types): the arguments as they are
# written, between braces for the parentheses. A construction without them, its arguments in a block
# below it, or of type arguments, is only reported.
recorded := (tokens: Tokens, call: Call, facts: NodeFacts) ->
  return nil unless call in facts.recordable
  callee := tokens.at(call.callee.position) ? return nil
  open := callee + 1
  return tokens.report(EXPECTED_TYPES, call.position) unless tokens.is_kind(open, '(')
  close := tokens.matching(open) ? return nil
  # A space inside each brace that has the arguments on its line.
  opening := tokens.code[open + 1].line == tokens.code[open].line then '{ ' else '{'
  closing := tokens.code[close - 1].end_line == tokens.code[close].line then ' }' else '}'
  changes :=
    Change(from: tokens.start(callee), to: tokens.end(open), text: opening)
    tokens.replaced(close, closing)
  tokens.edit_at EXPECTED_TYPES, call.position, changes

# `S(x, y: 1)` for `S(x: x, y: 1)` in a construction (see Shorthand): the named arguments that are
# variables of their names, from the first, up to one that is not or whose name and value are not
# written alone, as `x: (x)`, in one edit, as each would leave a named argument before those after
# it; the others, which would move before others, only reported.
shorthand_arguments := (tokens: Tokens, call: Call, facts: NodeFacts): Edit?[] ->
  return [] unless call in facts.object_constructions
  is_shorthand := (named: NamedValue) ->
    named.value is Identifier and named.value.name == named.name.name
  changes: Change[]
  reports: Edit?[]
  var stays = true
  for named in call.named_args
    shorthand := is_shorthand(named)
    change := shorthand and stays then alone(tokens, named)
    stays = change != nil
    if change
      changes.push change
    else if shorthand
      reports.push tokens.report(SHORTHAND_ARGUMENTS, named.name.position)
  return reports if changes.is_empty()
  [tokens.edit_at(SHORTHAND_ARGUMENTS, changes[0].from, changes), reports...]

# The name alone for the named argument, where both are single tokens.
alone := (tokens: Tokens, named: NamedValue) ->
  name_at := tokens.at(named.name.position) ? return nil
  value_at := tokens.at(named.value.position) ? return nil
  return nil if value_at != name_at + 2 or not tokens.is_kind(value_at, IDENTIFIER)
  Change from: tokens.start(name_at), to: tokens.end(value_at), text: named.name.name

# `x.is_empty()` for a test of the length of x against 0, or of x against '', and `not x.is_empty()`
# for one that x is not empty (see Emptiness tests), where std gives the type of x `is_empty`; the
# test as written, `0 == x.length` and `'' == x` too, but the latter of a name alone, whose end is
# known.
emptiness_test := (tokens: Tokens, test: BinaryOperation, facts: NodeFacts) ->
  { operator, left, right } := test
  return nil unless operator in ['==', '!=', '>']
  written := tested_value(tokens, left, right) ? return nil
  { value, first, last, start, end } := written
  return nil if operator == '>' and not written.length_first
  return nil if not has_is_empty(facts.types[value]) or not is_balanced(tokens, first, last)
  negation := operator == '==' then '' else 'not '
  text := "#{negation}#{tokens.slice(tokens.start(first), tokens.end(last))}.is_empty()"
  at := tokens.start(start)
  tokens.edit_at EMPTINESS_TESTS, at, [{ from: at, to: tokens.end(end), text }]

# The value that a comparison tests the emptiness of, the tokens from `first` through `last`, and
# those of the comparison, from `start` through `end`.
struct TestedValue
  value: Expression
  first: Int
  last: Int
  start: Int
  end: Int
  # Whether it is `x.length` before the operator, which `>` may compare.
  length_first: Bool

tested_value := (tokens: Tokens, left: Expression, right: Expression): TestedValue? ->
  if is_zero(right) and left is Member and left.name.name == 'length'
    name := tokens.at(left.name.position) ? return nil
    zero := tokens.at(right.position) ? return nil
    first := tokens.at(left.object.position) ? return nil
    return nil if not tokens.is_kind(name - 1, '.') or zero != name + 2
    return {
      value: left.object
      first
      last: name - 2
      start: first
      end: zero
      length_first: true
    }
  if is_zero(left) and right is Member and right.name.name == 'length'
    zero := tokens.at(left.position) ? return nil
    name := tokens.at(right.name.position) ? return nil
    first := tokens.at(right.object.position) ? return nil
    return nil if not tokens.is_kind(name - 1, '.') or first != zero + 2
    return {
      value: right.object
      first
      last: name - 2
      start: zero
      end: name
      length_first: false
    }
  if is_empty_string(right)
    empty := tokens.at(right.position) ? return nil
    first := tokens.at(left.position) ? return nil
    last := empty - 2
    return nil unless is_postfix(tokens, left, first, last)
    return { value: left, first, last, start: first, end: empty, length_first: false }
  if is_empty_string(left) and right is Identifier
    empty := tokens.at(left.position) ? return nil
    name := tokens.at(right.position) ? return nil
    return nil if name != empty + 2
    return { value: right, first: name, last: name, start: empty, end: name, length_first: false }
  nil

# Whether the value from `first` through `last` takes `.is_empty()` as written: a name, a member,
# a call, an index or `@`, or a value in parentheses, not an operation, which would give it to its
# last operand.
is_postfix := (tokens: Tokens, value: Expression, first: Int, last: Int) ->
  case value
    when Identifier, Member, Call, Index, This then true
    else tokens.is_kind(first, '(') and tokens.matching(first) == last

is_zero := (value: Expression) -> value is IntegerLiteral and value.value == 0

is_empty_string := (value: Expression) -> value is StringLiteral and value.value.is_empty()

# Whether the brackets that the tokens open they close, so that they are an expression whole.
is_balanced := (tokens: Tokens, first: Int, last: Int) ->
  return false if first > last
  var depth = 0
  for token in tokens.code[first..=last]
    depth += 1 if token.kind in OPENING_BRACKETS
    depth -= 1 if token.kind in CLOSING_BRACKETS
    return false if depth < 0
  depth == 0

# `(x in xs)` for `xs.contains(x)` (see Membership tests), where neither runs code, as `x in xs`
# evaluates x first; the parentheses are left to Parentheses, and `not` before it to Negated in
# tests.
membership_test := (tokens: Tokens, call: Call, facts: NodeFacts) ->
  member := call.callee as Member ? return nil
  has_one := call.args.length == 1 and call.named_args.is_empty() and call.type_args.is_empty()
  return nil if member.name.name != 'contains' or not has_one or facts.types[call] != bool_type
  item := call.args[0]
  return nil if not runs_no_code(member.object) or not runs_no_code(item)
  first := tokens.at(member.object.position) ? return nil
  name := tokens.at(member.name.position) ? return nil
  # `@contains(x)` has no `.`.
  last := tokens.is_kind(name - 1, '.') then name - 2 else name - 1
  open := name + 1
  return nil if not tokens.is_kind(open, '(') or not is_balanced(tokens, first, last)
  close := tokens.matching(open) ? return nil
  collection := tokens.slice(tokens.start(first), tokens.end(last))
  text := "(#{tokens.slice(tokens.start(open + 1), tokens.end(close - 1))} in #{collection})"
  tokens.edit_at MEMBERSHIP_TESTS, member.name.position, [
    { from: tokens.start(first), to: tokens.end(close), text }
  ]

# `x` for `x as T!` where x is a T already (see Redundant casts). The parentheses that held the cast
# are left to Parentheses.
redundant_cast := (tokens: Tokens, cast: Cast, facts: NodeFacts) ->
  return nil unless cast in facts.redundant_casts
  type_at := tokens.at(cast.type.position) ? return nil
  as_at := type_at - 1
  return nil unless tokens.is_word(as_at, 'as')
  bang := cast_end(tokens, type_at) ? return nil
  change := Change(from: tokens.end(as_at - 1), to: tokens.end(bang), text: '')
  tokens.edit_at REDUNDANT_CASTS, cast.position, [change]

# The `!` after the type of a cast that starts at `at`; a type holds none.
cast_end := (tokens: Tokens, at: Int) ->
  var index = at
  index += 1 while index < tokens.code.length and not tokens.is_kind(index, '!')
  index < tokens.code.length then index
