# The first pass of the formatter: walks the syntax tree over the code tokens, in the order of the
# source, and decides each gap between two code tokens that it walks: the spaces inside a statement
# (docs/reference/style.md#spacing), and the line starts of statements. A statement that holds a
# construct it does not walk yet is skipped, and its gaps keep their source text, as do those of a
# statement that the comments mark to keep as it is written (see kept.lerta). It records the
# constructs of the statements that it walks that may break a line (see shapes.lerta), whose gaps
# it decides flat, for lines.lerta to break.
import
  ArrayLiteral, ArrayTypeName, Assignment, Await, BinaryOperation, Binding, BooleanLiteral, Call,
  Case, CaseArm, Coalesce, Comprehension, Condition, Conditional, Declaration, EnumDeclaration,
  Expression, Extend, Extern, FloatLiteral, For, FunctionLiteral, Identifier, If, Import, Index,
  IntegerLiteral, InterfaceDeclaration, Interpolation, Intrinsic, is_exported, is_spread, Jump,
  MapLiteral, Member, NamedType, NamedValue, NilLiteral, Parameter, Pass, Position, Range,
  RecordLiteral, Return, Statement, StringLiteral, This, Throw, Try, TupleItem, TupleLiteral,
  TypeAlias, TypeDeclaration, TypeName, UnaryOperation, Unwrap, While, Yield
from '../ast'
import CLOSING_BRACKETS, OPENING_BRACKETS, Token, TokenKind from '../lexer/tokens'
import BRANCHES, FUNCTION_BODIES, INSIDE_BRACES, SPACING, StyleRule from '../format/rules'
import is_command_callee from '../format/print_statement'
import KeptLines from './kept'
import
  ArmShape, ArmsShape, BlockShape, BodyShape, CallShape, Closer, CodeGap, LineStart, ListShape,
  OperationShape, Shape, Spaces, StatementShape, ValueKind, ValueShape
from './shapes'
import SourceTokens, TextToken from './text'

NONE := Spaces(count: 0, rule: SPACING)
ONE := Spaces(count: 1, rule: SPACING)
INSIDE := Spaces(count: 1, rule: INSIDE_BRACES)

# The gaps that the walk decides, each by the index of the code token after it, and the comments
# that end a line where the formatter cannot place them, which it reports, keeping their statements
# as they are written (docs/reference/style.md#comments): by the index of the code token before
# them; the code tokens of the statements that it skips; the statements that it walks, with the
# tokens that close their bodies; and the items of lists that a line end separates from the item
# before them, rather than a comma, which they would take on one line.
export struct Walked
  gaps: Map<Int, CodeGap>
  stranded: Int[]
  skipped: Set<Int>
  block: BlockShape
  closers: Map<Int, Closer>
  without_commas: Set<Int>

export walk := (statements: Statement[], text: SourceTokens, kept: KeptLines) ->
  { code, line_starts, ending_comments, own_line_comments } := text
  walker := Walker(code, line_starts, ending_comments, own_line_comments, kept)
  block := walker.block(statements, 0, nil)
  walker.resume_at walker.code.length
  { gaps, stranded, skipped, closers, without_commas } := walker
  Walked gaps, stranded, skipped, block, closers, without_commas

# A construct that the walk does not handle yet, whose statement it skips.
struct Unhandled: Error

unhandled := -> throw Unhandled('not walked yet')

# The items of a list in brackets: how many, how to walk each with the gap before it, which are
# simple (see Long lists), and whether the last is a function.
struct ListItems
  count: Int
  walk: (Int, CodeGap) -> void
  simple: (Int) -> Bool
  function_last := default false

# The first token of each item of a list, and whether commas separate them (see ListShape.commas).
struct WalkedList
  starts: Int[]
  commas: Bool?

# The tokens of a binary operation: where it starts, at the parentheses around it, its operator,
# its right operand, and where that ends, before the parentheses that close around it.
struct OperationTokens
  first: Int
  operator: Int
  right: Int
  end: Int

class Walker
  code: Token[]
  # Those of the code tokens where a statement may start.
  line_starts: Set<Int>
  ending_comments: Map<Int, TextToken>
  # The columns of the comments on lines of their own before code tokens (see SourceTokens).
  own_line_comments: Map<Int, Int>
  kept: KeptLines
  var stranded: Int[] = []
  skipped := Set<Int>()
  # The gaps of the statement being walked, which those of the block that holds it take once it is
  # walked through.
  var gaps: Map<Int, CodeGap> = Map()
  # The index of the code token that starts at each position.
  starts := index_by_position(@code)
  var at = 0
  # The parentheses around an expression, which the syntax tree leaves out, that its chain has
  # opened and not closed yet (see chain).
  var open_groups = 0
  # The depth of the statement being walked.
  var depth = 0
  # Where the statements that the walk skips start, up to the next statement that it resumes at.
  var skipped_from: Int? = nil
  # The shapes of the construct being walked, and the statements of the block being walked, with
  # where each starts (see BlockShape).
  var shapes: Shape[] = []
  var block_starts: Int[] = []
  var block_statements: StatementShape[] = []
  # Whether the expression being walked is a whole value, whose operations may break (see Long
  # operations); whether it is inside brackets; and whether it is on a line of its own, rather than
  # on that of `->` or `then`.
  var breaks_operations = true
  var in_brackets = false
  var on_own_line = true
  # The first token of the call being walked that may take its arguments in a block (see
  # ListShape.bracketless), and whether it is written without parentheses.
  var bracketless_call: Int? = nil
  var bracketless_bare = false
  # The heads of the bodies just walked, whose closer the next token of their statement is, and
  # whether one of them is a block (see Closer).
  var closing: Int[] = []
  var closing_block = false
  closers := Map<Int, Closer>()
  without_commas := Set<Int>()
  # The tokens of each binary operation walked, and where the expression being walked starts.
  operations := Map<BinaryOperation, OperationTokens>()
  var node_start = 0

  block := (statements: Statement[], depth: Int, head: Int?) ->
    outer_depth := @depth
    outer_starts := @block_starts
    outer_statements := @block_statements
    @block_starts = []
    @block_statements = []
    @depth = depth
    @statement_on_line statement, { depth }, statements.get(i + 1) for statement, i in statements
    block := BlockShape(head, starts: @block_starts, statements: @block_statements)
    @depth = outer_depth
    @block_starts = outer_starts
    @block_statements = outer_statements
    block

  # The statement, before `next`, the one after it in its block.
  statement_on_line := (statement: Statement, line: LineStart, next: Statement?) ->
    first := @statement_start(statement)
    @resume_at first if first
    start := @at
    return @skip(start) if first != start or @skipped_from != nil
    # A statement that the walk skips starts its line still.
    @gaps[start] = line
    @block_starts.push start
    outer := @gaps
    @gaps = Map()
    outer_walk := @save()
    @shapes = []
    @closing = []
    @closing_block = false
    @breaks_operations = true
    @in_brackets = false
    @on_own_line = true
    outer_stranded := @stranded.length
    walked :=
      try
        @statement statement, line
        true
      catch _: Unhandled
        false
    # Asked after the walk, as the statements inside claim their marked lines first.
    kept := @kept.keeps(@code[start].position(), next then @first_position(next))
    if kept
      # A kept statement reports nothing.
      @stranded = @stranded[..outer_stranded]
    if walked and not kept
      outer[gap] = decided for (gap, decided) in @gaps.entries()
      @block_statements.push { start, end: @at, shapes: @shapes }
    else
      @skip start
    @gaps = outer
    @restore outer_walk

  save := ->
    WalkState
      shapes: @shapes
      closing: @closing
      closing_block: @closing_block
      breaks_operations: @breaks_operations
      in_brackets: @in_brackets
      on_own_line: @on_own_line

  restore := (state: WalkState) ->
    @shapes = state.shapes
    @closing = state.closing
    @closing_block = state.closing_block
    @breaks_operations = state.breaks_operations
    @in_brackets = state.in_brackets
    @on_own_line = state.on_own_line

  # Where the first token of the statement is, which is `export` for an exported one.
  first_position := (statement: Statement) ->
    at := @starts[statement.position] ? return statement.position
    is_exported(statement) then @code[at - 1].position() else statement.position

  skip := (start: Int) ->
    earliest := min(@skipped_from ? start, start)
    @skipped_from = earliest

  # The index of the code token that starts the statement, if it starts a line.
  statement_start := (statement: Statement) ->
    return nil if is_destructuring_part(statement)
    at := @starts[statement.position] ? return nil
    start := is_exported(statement) then at - 1 else at
    start in @line_starts then start

  # Ends the skipping at the code token at `index`.
  resume_at := (index: Int) ->
    from := @skipped_from ? return
    return if index < @at
    @skipped.add skipped for skipped in from..index
    @at = index
    @skipped_from = nil

  statement := (statement: Statement, before: CodeGap): void ->
    case statement
      when If then @if_statement(statement, before)
      when While then @while_statement(statement, before)
      when For then @for_statement(statement, before)
      when Declaration then @declaration(statement, before)
      when Assignment then @assignment(statement, before)
      when
        Pass, Import, TypeDeclaration, EnumDeclaration, InterfaceDeclaration, TypeAlias, Extern,
        Intrinsic, Extend
      then unhandled()
      when Call then @call_statement(statement, before)
      else @expression(statement, before)

  if_statement := (node: If, before: CodeGap): void ->
    keyword := @code[@at].kind
    unhandled() if node.nil_safe or keyword not in ['if', 'unless']
    head := @take(keyword, before)
    @condition node.condition, keyword
    @nested_block node.then_body, head
    return if node.else_body.is_empty()
    first := node.else_body[0]
    @resume_at (@starts[first.position] ? unhandled()) - 1
    else_at := @take('else', LineStart(@depth))
    if first is If and @at not in @line_starts
      @if_statement first, ONE
      return
    block := @block(node.else_body, @depth + 1, else_at)
    if_at := @starts[first.position]!
    if_alone := first is If and node.else_body.length == 1 and @code[if_at].kind == 'if'
    joins_if := if_alone and not @has_comments(else_at, if_at)
    @shapes.push BlockShape(block..., joins_if, head: else_at)
    @close else_at, true

  while_statement := (node: While, before: CodeGap) ->
    keyword := @code[@at].kind
    unhandled() unless keyword in ['while', 'until']
    head := @take(keyword, before)
    @condition node.condition, keyword
    @nested_block node.body, head

  for_statement := (node: For, before: CodeGap) ->
    head := @take('for', before)
    @take IDENTIFIER, ONE
    if node.index
      @take ',', NONE
      @take IDENTIFIER, ONE
    @take_spelled 'in', ONE
    @operand node.iterable, ONE
    @nested_block node.body, head

  # The block of a statement below its head, which the next token of the statement closes.
  nested_block := (statements: Statement[], head: Int) ->
    @shapes.push @block(statements, @depth + 1, head)
    @close head, true

  # The condition after the keyword; that of `unless` or `until` is `not` of what is written. Its
  # operations stay on its line, as the lines below it are the block.
  condition := (condition: Condition, keyword: TokenKind) ->
    case condition
      when Binding
        @take IDENTIFIER, ONE
        @take ':=', ONE
        @operand condition.value, ONE
      when UnaryOperation
        written := keyword in ['unless', 'until'] then condition.operand else condition
        @operand written, ONE
      else @operand(condition, ONE)

  declaration := (node: Declaration, before: CodeGap) ->
    unhandled() if node.weak
    var next = before
    if node.exported
      @take 'export', next
      next = ONE
    if node.mutable
      @take 'var', next
      next = ONE
    @take IDENTIFIER, next
    if type := node.type
      @take ':', NONE
      @type type, ONE
    return if node.omits_value
    assign := @take(node.mutable or node.type then '=' else ':=', ONE)
    @value assign, node.value, true

  assignment := (node: Assignment, before: CodeGap) ->
    @operand node.target, before
    @value @take_spelled(node.operator, ONE), node.value, true

  # A call that is a statement, whose callee could take its arguments without parentheses (see
  # CallShape).
  call_statement := (node: Call, before: CodeGap) ->
    return @expression(node, before) unless is_block_call(node)
    first := @at
    outer := @shapes
    @shapes = []
    @bracketless_call = first
    @expression node, before
    @bracketless_call = nil
    last_arg := node.named_args.is_empty() then node.args.last()
    shape := CallShape
      first
      last: @at - 1
      without_parentheses: @bracketless_bare
      function_last: last_arg is FunctionLiteral
      shapes: @shapes
    @shapes = outer
    @shapes.push shape

  # The value after the token at `after`: after `=`, `:=`, a compound assignment or `return` if
  # `in_block`, and otherwise after a key, `then` or `else`, where it takes the next line only after
  # a comment (see ValueShape). That after `then` or `else` is an operand, which `breaks` tells.
  value := (after: Int, node: Expression, in_block: Bool, breaks = true) ->
    first := @at
    walk := (gap: CodeGap) ->
      if breaks
        @whole node, gap
      else
        @operand node, gap
    kind := @value_kind(after, node, in_block) ? return walk(ONE)
    outer := @shapes
    @shapes = []
    @bracketless_call = first if kind == BLOCK_CALL
    walk ONE
    @bracketless_call = nil
    shape := ValueShape(first, kind, last: @at - 1, shapes: @shapes)
    @shapes = outer
    @shapes.push shape

  value_kind := (after: Int, node: Expression, in_block: Bool): ValueKind? ->
    return BELOW_COMMENT if after in @ending_comments
    return nil if @in_brackets or not in_block
    case node
      when Case then BRANCH
      when ArrayLiteral, RecordLiteral, MapLiteral then is_block_literal(node) then LITERAL_BLOCK
      when FunctionLiteral then nil
      when BinaryOperation then OPERATION
      when Conditional then TWO_WAY
      else
        if literal := literal_under_members(node)
          return LITERAL_BLOCK if is_block_literal(literal)
        is_block_call(node) and @on_own_line then BLOCK_CALL else OTHER

  type := (type: TypeName, before: CodeGap): void ->
    case type
      when NamedType
        @take IDENTIFIER, before
        unless type.args.is_empty()
          @take '<', NONE
          @list type.args.length, NONE, (i, gap) -> @type(type.args[i], gap), false
          @take '>', NONE
        @take '?', NONE if type.optional
      when ArrayTypeName
        @type type.element, before
        @take '[', NONE
        @take ']', NONE
        @take '?', NONE if type.optional
      else unhandled()

  # A whole value, as an item or a value after `=`, whose operations may break.
  whole := (node: Expression, before: CodeGap) ->
    breaks := @breaks_operations
    @breaks_operations = true
    @expression node, before
    @breaks_operations = breaks

  # An operand, or a head, whose operations stay on its line.
  operand := (node: Expression, before: CodeGap) ->
    breaks := @breaks_operations
    @breaks_operations = false
    @expression node, before
    @breaks_operations = breaks

  # An expression, with the parentheses around it.
  expression := (node: Expression, before: CodeGap): void ->
    outer_groups := @open_groups
    @open_groups = 0
    @chain node, before
    unhandled() if @open_groups != 0
    @open_groups = outer_groups

  # The expression and those at its start, as the left operand of an operation, whose parentheses
  # an expression opens at its start: each that the chain closes after its end is around it.
  chain := (node: Expression, before: CodeGap): void ->
    @node_start = @at
    var first = before
    groups := @groups_at_start(node)
    for _ in 0..groups
      @take_before_operand '(', first
      first = NONE
      @open_groups += 1
    # An operation in parentheses stays on its line, which its `)` would end otherwise.
    breaks := @breaks_operations
    @breaks_operations = false if groups > 0
    @node node, first
    @breaks_operations = breaks
    while @open_groups > 0 and @at_kind(')')
      @take ')', NONE
      @open_groups -= 1

  # The parentheses at the start of the node that group it: all of those in a row, but the last of a
  # tuple, or of the parameters of a function literal, rather than one around `-> body`.
  groups_at_start := (node: Expression) ->
    var count = 0
    count += 1 while @kind_at(@at + count) == '('
    for offset in 0..count
      return offset if @opens_own(leftmost(node), @at + offset)
    count

  # Whether the `(` at `open` is the node's own: the first of a run of them whose contents hold a
  # comma of a tuple, or are followed by the `->` or the `:` of a function literal, as no group is.
  opens_own := (node: Expression, open: Int) ->
    close := @closing_bracket(open)
    case node
      when TupleLiteral then @has_comma(open + 1, close)
      when FunctionLiteral then @kind_at(close + 1) == '->' or @kind_at(close + 1) == ':'
      else false

  # The index of the bracket that closes the one at `open`.
  closing_bracket := (open: Int) ->
    var depth = 0
    for index in open..@code.length
      kind := @code[index].kind
      depth += 1 if kind in OPENING_BRACKETS
      depth -= 1 if kind in CLOSING_BRACKETS
      return index if depth == 0
    @code.length

  # Whether a comma is between `start` and `end`, outside the brackets there.
  has_comma := (start: Int, end: Int) ->
    var depth = 0
    for index in start..end
      kind := @code[index].kind
      depth += 1 if kind in OPENING_BRACKETS
      depth -= 1 if kind in CLOSING_BRACKETS
      return true if depth == 0 and kind == ','
    false

  node := (node: Expression, before: CodeGap): void ->
    case node
      when Identifier then @take(IDENTIFIER, before)
      when StringLiteral then @take(STRING, before)
      when Interpolation then @take(node.binary then BINARY else INTERPOLATED, before)
      when BooleanLiteral then @take(node.value then 'true' else 'false', before)
      when NilLiteral then @take('nil', before)
      when IntegerLiteral then @number(node.text, INTEGER, before)
      when FloatLiteral then @number(node.text, FLOAT, before)
      when This then @take('@', before)
      when Jump then @take(node.kind == 'break' then 'break' else 'continue', before)
      when Member then @member(node, before)
      when Call then @call(node, before)
      when Index
        unhandled() if node.default_value
        @chain node.object, before
        index := node.index
        items := ListItems
          count: 1
          walk: (_, gap) -> @expression(index, gap)
          simple: (_) -> false
          function_last: index is FunctionLiteral
        @bracketed '[', NONE, ']', NONE, items
      when Unwrap
        @chain node.operand, before
        @take '!', NONE
      when UnaryOperation then @unary(node, before)
      when BinaryOperation then @binary(node, before)
      when Coalesce
        @chain node.value, before
        @take '?', ONE
        @operand node.fallback, ONE
      when Range then @range(node, before)
      when Conditional
        # Its parts are operands, whose operations stay on their lines.
        breaks := @breaks_operations
        @breaks_operations = false
        @chain node.condition, before
        @breaks_operations = breaks
        @value @take('then', ONE), node.then_value, false, false
        @value @take('else', ONE), node.else_value, false, false unless node.without_else
      when ArrayLiteral then @bracketed('[', before, ']', NONE, @element_items(node.elements))
      when MapLiteral then @map(node, before)
      when RecordLiteral then @record(node, before)
      when TupleLiteral
        { items } := node
        tuple_items := ListItems
          count: items.length
          walk: (i, gap) -> @expression(items[i], gap)
          simple: (i) -> is_simple(items[i])
        @bracketed '(', before, ')', NONE, tuple_items
      when FunctionLiteral then @function(node, before)
      when Case then @case_value(node, before)
      when Return
        return_at := @take('return', before)
        @value return_at, value, true if value := node.value
      when Throw
        @take 'throw', before
        @expression node.message, ONE
      when Yield
        @take 'yield', before
        @expression node.value, ONE
      when Await
        @take 'await', before
        @operand node.operand, ONE
      else unhandled()

  # A negative literal is the two tokens `-` and the number.
  number := (text: String, kind: TokenKind, before: CodeGap) ->
    if text.starts_with('-')
      @take '-', before
      @take kind, NONE
    else
      @take kind, before

  member := (node: Member, before: CodeGap) ->
    if node.object is This and @at_kind('@')
      @take '@', before
    else
      @chain node.object, before
      @take '.', NONE
    @take IDENTIFIER, NONE

  # A call with parentheses, or without them, whose arguments follow a space on its line.
  call := (node: Call, before: CodeGap) ->
    unhandled() unless node.type_args.is_empty()
    start := @at
    bracketless := @bracketless_call == start
    @chain node.callee, before
    bare := not @at_kind('(') or @code[@at].spaced
    { args, named_args } := node
    values := [args..., [named.value for named in named_args]...]
    walk := (i: Int, gap: CodeGap) ->
      if i < args.length
        @element args[i], gap
      else
        @named named_args[i - args.length], gap
    if bare
      # Arguments in a block below the callee are not walked yet.
      unhandled() if @at in @line_starts
      @list values.length, ONE, walk, false
    else
      items := ListItems
        walk
        count: values.length
        simple: (i) -> is_simple(values[i])
        function_last: values.last() is FunctionLiteral
      @bracketed '(', NONE, ')', NONE, items, bracketless
    # Told once the calls in its arguments are walked.
    @bracketless_bare = bare if bracketless

  named := (named: NamedValue, before: CodeGap) ->
    @take IDENTIFIER, before
    @value @take(':', NONE), named.value, false

  element_items := (elements: Expression[]) ->
    ListItems
      count: elements.length
      walk: (i, gap) -> @element(elements[i], gap)
      simple: (i) -> is_simple(elements[i])
      function_last: elements.last() is FunctionLiteral

  # An item of a list, which may be a spread, `xs...`.
  element := (node: Expression, before: CodeGap) ->
    if node is Comprehension and node.spread
      @expression node.iterable, before
      @take '...', NONE
    else
      @expression node, before

  unary := (node: UnaryOperation, before: CodeGap) ->
    if node.operator == '-'
      # `- 1`, which `-1` would make a literal.
      operand := @kind_at(@at + 1)
      unhandled() if operand == INTEGER or operand == FLOAT
      @take_before_operand '-', before
      @operand node.operand, NONE
    else if @at_kind('not')
      @take_before_operand 'not', before
      @operand node.operand, ONE
    else
      # `x not in xs`, which is read as `not (x in xs)`.
      test := node.operand as BinaryOperation ? unhandled()
      unhandled() if test.operator != 'in'
      @chain test.left, before
      @take_before_operand 'not', ONE
      @take_spelled 'in', ONE
      @operand test.right, ONE

  # A binary operation, and the chain of those of its level on its left, which breaks where it is a
  # whole value (see OperationShape).
  binary := (node: BinaryOperation, before: CodeGap) ->
    first := @node_start
    breaks := @breaks_operations
    outer := @shapes
    @shapes = [] if breaks
    @breaks_operations = false
    @chain node.left, before
    operator := @at
    @operator node.operator, ONE
    right := @at
    @expression node.right, ONE
    @operations[node] = { first, operator, right, end: @at }
    @breaks_operations = breaks
    return unless breaks
    operands := [@operations[operation]!.right for operation in @operation_chain(node)]
    shape := OperationShape(first, operands, last: @at - 1, shapes: @shapes)
    @shapes = outer
    @shapes.push shape

  # The operations of the chain from its first, innermost on the left, to `node`: those of its level
  # on its left, outside parentheses. A comparison takes no chain.
  operation_chain := (node: BinaryOperation) ->
    level := level_of(node.operator)
    chain := [node]
    return chain if level == COMPARISON
    while left := chain.last()!.left as BinaryOperation?
      in_parentheses := @operations[left]!.end != @operations[chain.last()!]!.operator
      break if level_of(left.operator) != level or in_parentheses
      chain.push left
    chain.reversed()

  range := (node: Range, before: CodeGap) ->
    operator: TokenKind = node.inclusive then '..=' else '..'
    if start := node.start
      @chain start, before
      @take operator, NONE
    else
      @take operator, before
    @operand end, NONE if end := node.end

  map := (node: MapLiteral, before: CodeGap) ->
    { entries } := node
    walk := (i: Int, gap: CodeGap) ->
      @expression entries[i].key, gap
      @value @take(':', NONE), entries[i].value, false
    items := ListItems
      walk
      count: entries.length
      simple: (i) -> is_simple(entries[i].key) and is_simple(entries[i].value)
      function_last: [entry.value for entry in entries].last() is FunctionLiteral
    @bracketed '{', before, '}', INSIDE, items

  record := (node: RecordLiteral, before: CodeGap) ->
    { spread, fields } := node
    spread_count := spread then 1 else 0
    walk := (i: Int, gap: CodeGap) ->
      if item := i == 0 then spread
        @element item, gap
      else
        field := fields[i - spread_count]
        @take IDENTIFIER, gap
        @value @take(':', NONE), field.value, false if @at_kind(':')
    items := ListItems
      walk
      count: spread_count + fields.length
      simple: (i) -> i >= spread_count and is_simple(fields[i - spread_count].value)
      function_last: [field.value for field in fields].last() is FunctionLiteral
    @bracketed '{', before, '}', INSIDE, items

  function := (node: FunctionLiteral, before: CodeGap) ->
    unhandled() if node.weak or not node.type_params.is_empty()
    var arrow_before = before
    if @at_kind('(')
      { params } := node
      items := ListItems
        count: params.length
        walk: (i, gap) -> @parameter(params[i], gap)
        simple: (i) -> params[i].default == nil
      @bracketed '(', before, ')', NONE, items
      arrow_before = ONE
    if type := node.return_type
      @take ':', NONE
      @type type, ONE
      arrow_before = ONE
    arrow := @take('->', arrow_before)
    @shapes.push @body(arrow, node.body, FUNCTION_BODIES)

  parameter := (node: Parameter, before: CodeGap) ->
    @take IDENTIFIER, before
    if type := node.type
      @take ':', NONE
      @type type, ONE
    @take '...', NONE if node.variadic
    if default := node.default
      @take '=', ONE
      @expression default, ONE

  # The body after the `->`, `then` or `else` at `head`: a block on the lines below it, or one
  # statement on its line (see BodyShape).
  body := (head: Int, statements: Statement[], rule: StyleRule) ->
    start := @at
    if start in @line_starts
      block := @block(statements, @depth + 1, head)
      one := statements.length == 1 and block.statements.length == 1
      inline := one and is_inline(statements[0]) and not is_bare_call(block.statements[0])
      joinable := inline and not @has_comments(head, @at)
      @close head, true
      return BodyShape(head, block, joinable, rule)
    unhandled() if statements.length != 1
    joinable := is_inline(statements[0])
    outer_shapes := @shapes
    outer_line := @on_own_line
    @shapes = []
    @on_own_line = false
    @statement statements[0], ONE
    statement := StatementShape(start, end: @at, shapes: @shapes)
    @shapes = outer_shapes
    @on_own_line = outer_line
    @close head, false
    block := BlockShape(head, starts: [start], statements: [statement])
    BodyShape head, block, joinable, rule

  # Whether a comment ends a line from the token at `first`, the head of a block, up to `end`, after
  # the block, or is on a line of its own among them, indented deeper than the head's line.
  has_comments := (first: Int, end: Int) ->
    for at in first..end
      return true if at in @ending_comments or (at > first and at in @own_line_comments)
    @own_line_comments[end] ? 0 > @indentation_of(first)

  # The column of the first code token on the line of the one at `index`.
  indentation_of := (index: Int) ->
    var at = index
    at -= 1 while at > 0 and at not in @line_starts
    @code[at].column

  # `case`, with its subject or without one, and its arms below it (see ArmsShape).
  case_value := (node: Case, before: CodeGap) ->
    head := @take('case', before)
    @operand subject, ONE if subject := node.subject
    has_subject := node.subject != nil
    arms := [@arm(arm, has_subject) for arm in node.arms]
    if otherwise := node.otherwise
      start := @take('else', LineStart(depth: @depth + 1))
      body := @body(start, otherwise, BRANCHES)
      arms.push {
        start
        body
        patterns: []
        breakable: false
        then_at: nil
        commas: true
        shapes: []
      }
    @shapes.push ArmsShape(head, arms)
    @close head, true

  # An arm, `when` and its patterns, which a subject's may write on lines of their own below it, and
  # its body, after `then` if it is written.
  arm := (arm: CaseArm, has_subject: Bool) ->
    start := @take_spelled('when', LineStart(depth: @depth + 1))
    outer := @shapes
    @shapes = []
    breaks := @breaks_operations
    @breaks_operations = false
    { patterns } := arm
    walked := @list(patterns.length, ONE, (i, gap) -> @expression(patterns[i], gap), has_subject)
    @breaks_operations = breaks
    shapes := @shapes
    @shapes = outer
    then_at := @at_kind('then') then @take('then', ONE)
    body := @body(then_at ? start, arm.body, BRANCHES)
    ArmShape
      start
      then_at
      body
      shapes
      patterns: walked.starts
      breakable: has_subject
      commas: walked.commas

  # A list in brackets (see ListShape), whose items are whole values; `bracketless` if it is the
  # arguments of a call that would take them in a block.
  bracketed := (
    open: TokenKind
    before: CodeGap
    close: TokenKind
    inside: CodeGap
    items: ListItems
    bracketless = false
  ) ->
    open_at := @take(open, before)
    outer := @save()
    @shapes = []
    @in_brackets = true
    @on_own_line = false
    @breaks_operations = true
    walked := @list(items.count, inside, items.walk)
    close_at := @take(close, inside)
    simple := [i for i in 0..items.count].all(items.simple)
    shape := ListShape
      simple
      bracketless
      open: open_at
      close: close_at
      items: walked.starts
      commas: walked.commas
      function_last: items.function_last
      shapes: @shapes
    @restore outer
    @shapes.push shape

  # `count` items, the first after `first`, separated by commas, or by line ends where `lines`
  # allows them.
  list := (count: Int, first: CodeGap, item: (Int, CodeGap) -> void, lines = true) ->
    starts: Int[]
    var commas = 0
    for i in 0..count
      if i > 0
        if @at_kind(',')
          @take ',', NONE
          commas += 1
        else
          unhandled() if not lines or @at not in @line_starts
          @without_commas.add @at
      starts.push @at
      item i, i == 0 then first else ONE
    var separated: Bool?
    separated = true if commas == max(count - 1, 0)
    separated = false if commas == 0 and count > 1
    WalkedList starts, commas: separated

  # An operator, which a shift writes as two tokens, `<` and `<`.
  operator := (operator: String, before: CodeGap) ->
    if operator == '<<' or operator == '>>'
      half := operator == '<<' then '<' else '>'
      @take_spelled half, before
      @take_spelled half, NONE
    else
      @take_spelled operator, before

  # A token that an operand follows, which a comment after it would leave at the start of a line.
  take_before_operand := (kind: TokenKind, before: CodeGap) ->
    index := @take(kind, before)
    if index in @ending_comments
      @stranded.push index
      unhandled()
    index

  take := (kind: TokenKind, before: CodeGap) -> @take_if((token) -> token.kind == kind, before)

  take_spelled := (spelling: String, before: CodeGap) ->
    @take_if (token) -> spelling_of(token) == spelling, before

  # The index of the next code token, which must be as `expected`, consumed, with the gap before it.
  take_if := (expected: (Token) -> Bool, before: CodeGap) ->
    unhandled() if @skipped_from != nil or @at == @code.length or not expected(@code[@at])
    @gaps[@at] = @closing_gap(before)
    @at += 1
    @at - 1

  # The next token closes the bodies at `head` (see Closer).
  close := (head: Int, block: Bool) ->
    @closing = [@closing..., head]
    @closing_block = @closing_block or block

  # The gap before the next token, which starts a line if it closes a block.
  closing_gap := (before: CodeGap) ->
    return before if @closing.is_empty()
    @closers[head] = { at: @at, flat: before } for head in @closing
    gap := @closing_block then LineStart(@depth) else before
    @closing = []
    @closing_block = false
    gap

  at_kind := (kind: TokenKind) -> @kind_at(@at) == kind

  kind_at := (index: Int) -> index < @code.length then @code[index].kind

# What a statement's walk sets aside while it walks one inside it.
struct WalkState
  shapes: Shape[]
  closing: Int[]
  closing_block: Bool
  breaks_operations: Bool
  in_brackets: Bool
  on_own_line: Bool

# A declaration of those that a destructuring stands for, whose position need not be where its line
# starts: the one of the value, whose name cannot be written, or one of a name from it.
is_destructuring_part := (statement: Statement) ->
  declaration := statement as Declaration ? return false
  { name, value } := declaration
  from_holder := value is Member and is_holder(value.object)
  is_holder(name) or value is TupleItem or from_holder

# The name of what holds a value that a destructuring takes apart, which cannot be written.
is_holder := (expression: Expression) -> expression is Identifier and '.' in expression.name

# The expression at the left end of the node, whose parentheses are where the node's start.
leftmost := (node: Expression): Expression ->
  case node
    when Call then leftmost(node.callee)
    when BinaryOperation then leftmost(node.left)
    when Member, Index then leftmost(node.object)
    when Unwrap then leftmost(node.operand)
    when Coalesce then leftmost(node.value)
    when Conditional then leftmost(node.condition)
    when Range
      start := node.start ? return node
      leftmost start
    else node

# The precedence of a binary operator, as those of operators in docs/reference/syntax.md.
COMPARISON := 0

level_of := (operator: String) ->
  case operator
    when 'or' then 1
    when 'and' then 2
    when '+', '-', '|', '^' then 3
    when '*', '/', '%', '&', '<<', '>>' then 4
    else COMPARISON

# A string longer than this may stand for a line of text, which a list puts on a line of its own.
SHORT_STRING := 12

# A name or a short literal, which shares a line with others in a long list (see Long lists).
is_simple := (node: Expression) ->
  case node
    when Identifier, IntegerLiteral, FloatLiteral, BooleanLiteral, NilLiteral then true
    when StringLiteral then node.value.count() <= SHORT_STRING
    else false

# A statement that the line of `->`, `then` or `else` can hold: one that holds no block, nor
# declares; and not the name `pass` alone, which there would be the arm that does nothing.
is_inline := (statement: Statement) ->
  case statement
    when
      Declaration, While, For, TypeDeclaration, EnumDeclaration, InterfaceDeclaration, TypeAlias,
      Extern, Intrinsic, Extend, Import, Case, Try
    then false
    when If then statement.nil_safe
    when Identifier then statement.name != 'pass'
    else true

# Whether the statement is a call without parentheses, which the line of `->` or `then` cannot
# hold (see Calls without parentheses).
is_bare_call := (statement: StatementShape) ->
  call := statement.shapes.first() as CallShape ? return false
  call.without_parentheses

# A call whose callee could take its arguments without parentheses, or in a block.
is_block_call := (node: Expression) ->
  call := node as Call ? return false
  has_arguments := not call.args.is_empty() or not call.named_args.is_empty()
  has_arguments and call.type_args.is_empty() and is_command_callee(call.callee)

# A literal that a block without brackets can hold: one that reads as the literal there, with more
# than one element, no spread, and no name alone for a field, which would read as an element.
is_block_literal := (literal: Expression) ->
  case literal
    when ArrayLiteral then literal.elements.length > 1 and not literal.elements.any(is_spread)
    when RecordLiteral
      shorthand := literal.fields.any((field) -> is_shorthand(field))
      not literal.fields.is_empty() and not shorthand and literal.spread == nil
    when MapLiteral then not literal.entries.is_empty()
    else false

is_shorthand := (field: NamedValue) ->
  value := field.value
  value is Identifier and value.name == field.name.name

# The literal that the members of the value follow, as `[...].join('')`.
literal_under_members := (value: Expression): Expression? ->
  object :=
    case value
      when Member then value.object
      when Call then value.callee
      when Index then value.object
      else return nil
  return object if object is ArrayLiteral or object is RecordLiteral or object is MapLiteral
  literal_under_members object

# A word, as `in`, is an identifier.
spelling_of := (token: Token) ->
  token.kind == IDENTIFIER then token.text else token.kind.to_string()

index_by_position := (code: Token[]) ->
  starts: Map<Position, Int>
  starts[token.position()] = index for token, index in code
  starts
