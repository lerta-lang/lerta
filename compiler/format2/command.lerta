# The command line of `lerta fmt2 [--fix] <path>...`, which runs format2 as `lerta fmt` runs the
# formatter, for its tests until it replaces it.
import is_dir, is_file, read_text, write_file from 'std:io'
import CompileError from '../errors'
import source_files from '../format/command'
import is_off_throughout from '../format/format'
import EntryModule, module_key from '../loader'
import ChangedProgram, format_parsed, format_source, Parsed, parsed_source from './format'
import Typed, typed_programs from './typed'

export format2_command := (paths: String[], fix: Bool) ->
  var status = 0
  for path in paths
    if not is_file(path) and not is_dir(path)
      print_error "'#{path}' is not a file or a directory"
      status = 1
  files := source_files(paths)
  sources: Map<String, Source>
  for file in files
    if source := await source_of(file)
      sources[file] = source
    else
      status = 1
  # Each program that holds some of the files is checked once for all of them, for their first
  # rewrites; a file that they rewrite is checked anew on its own (see rewritten_text).
  given: Map<String, EntryModule>
  for file in files
    if parsed := sources[file]?.parsed
      given[module_key(file)] = { source: parsed.source, program: parsed.statements }
  typed :=
    await typed_programs([file for file in files when given.contains(module_key(file))], given)
  for file in files
    source := sources[file] ? continue
    status = 1 unless await format_file(file, source, typed[module_key(file)], fix)
  status

# A file read, and parsed unless it is off throughout, which is left as it is.
struct Source
  text: String
  parsed: Parsed?

# Nil, reported, for a file that is not UTF-8 or does not parse.
source_of := (path: String): Promise<Source?> ->
  text := await read_text(path) ? return failed_source("#{path}: the file is not valid UTF-8")
  return { text, parsed: nil } if is_off_throughout(text)
  try
    { text, parsed: parsed_source(text, path) }
  catch error: CompileError
    failed_source error.message

# Whether the file is in the style, or is written so with `fix`.
format_file := (path: String, source: Source, typed: Typed?, fix: Bool) ->
  parsed := source.parsed ? return true
  formatted :=
    try
      await format_parsed(parsed, path, typed)
    catch error: CompileError
      return failed(error.message)
    catch error: ChangedProgram
      return failed(error.message)
  findings :=
    if fix and formatted.text != source.text
      await write_file(path, formatted.text)
      (await format_source(formatted.text, path)).findings
    else
      formatted.findings
  for finding in findings
    { at, rule } := finding
    print_error "#{path}:#{at.line}:#{at.column}: #{rule.message} (#{rule.label})"
  findings.is_empty()

failed_source := (message: String): Source? ->
  print_error message
  nil

failed := (message: String) ->
  print_error message
  false
