# `lerta fmt2`, the formatter that is to replace compiler/format: rewrites the tokens of the source
# that the style writes otherwise (see rewrites.lerta), decides each gap between the text tokens of
# the source (see text.lerta), reports where the source differs from that by the rule of the
# rewrite or the decision, and writes the tokens with the gaps decided.
import scan from 'std:scanner'
import Position, Statement from '../ast'
import dump_ast_without_positions from '../ast_dump'
import CompileError from '../errors'
import lex, Lexed from '../lexer/tokens'
import parse from '../parser/statement'
import
  BINARY_LITERALS, BLANK_LINES, COMMENTS, DOUBLE_NEGATIONS, ELSE_NIL, EMPTY_INITIAL_VALUES, LAYOUT,
  RANGE_ENDS, SEMICOLONS, STRANDED_COMMENTS, StyleRule
from '../format/rules'
import is_off_throughout from '../format/format'
import common_indentation, is_blank from '../lexer/string_literal'
import applicable, applied, Edit from './edits'
import kept_lines from './kept'
import break_lines from './lines'
import rewrites_of from './rewrites'
import CodeGap, LineStart, Spaces, StatementShape from './shapes'
import Gap, literal_lines, source_tokens, SourceTokens, TextToken from './text'
import walk, Walked from './walk'

# A place where the source differs from the style, at its position in the source.
export struct Finding
  at: Position
  rule: StyleRule

export struct Formatted
  text: String
  findings: Finding[]

# A program that the formatter would change, which is a fault of the formatter.
export struct ChangedProgram: Error
  message: String

# The text of a gap, and the rule that decides it.
struct Decision
  text: String
  rule: StyleRule

# The source lexed and parsed, and its text tokens.
struct Parsed
  source: String
  lexed: Lexed
  statements: Statement[]
  text: SourceTokens

# The source laid out, what differs from it, but the stranded comments, and the statements walked.
struct LaidOut
  text: String
  findings: Finding[]
  stranded: Finding[]
  statements: StatementShape[]
  skipped: Set<Int>

# Throws a CompileError if the source does not parse. The layout of a statement that holds a
# rewrite is reported once the rewrite is applied, as the rewrite may change it.
export format_source := (source: String, path: String) ->
  return Formatted(text: source, findings: []) if is_off_throughout(source)
  parsed := parsed_source(source, path)
  laid := laid_out(parsed)
  edits := rewrites(parsed)
  held := held_statements(parsed.text, laid, edits)
  is_held := (at: Position) -> held.any((head) -> head.holds(at))
  layout := [finding for finding in laid.findings when not is_held(finding.at)]
  rewritten := [Finding(at: edit.at, rule: edit.rule) for edit in edits]
  # A `;` that a rewrite takes out is a gap that the layout decides too.
  found := distinct([rewritten..., layout..., laid.stranded...])
  sorted := found.sorted((a, b) -> a.at.compare(b.at))
  text :=
    if applicable(edits).is_empty()
      checked_layout(laid.text, parsed, path).source
    else
      rewritten_text parsed, path, edits
  Formatted text, findings: sorted

distinct := (findings: Finding[]) ->
  seen: Set<String>
  found: Finding[]
  for finding in findings
    { at, rule } := finding
    key := "#{at.line}:#{at.column} #{rule.label} #{rule.message}"
    continue if key in seen
    seen.add key
    found.push finding
  found

parsed_source := (source: String, path: String) ->
  lexed := lex(source, path)
  Parsed source, lexed, statements: parse(lexed.tokens, path), text: source_tokens(source, lexed)

rewrites := (parsed: Parsed) ->
  { source, lexed, statements, text } := parsed
  rewrites_of statements, source, text, lexed, kept_lines(source, lexed)

laid_out := (parsed: Parsed) ->
  { source, lexed, statements, text } := parsed
  walked := walk(statements, text, kept_lines(source, lexed))
  break_lines walked, text
  layout := lay_out(text, walked)
  { decisions, texts } := layout
  stranded := [stranded_finding(text, index) for index in walked.stranded]
  found := [findings(text.gaps, decisions)..., token_findings(text.tokens, texts)...]
  LaidOut
    stranded
    text: render(texts, decisions)
    findings: found
    statements: walked.statements
    skipped: walked.skipped

# The part of the innermost statement that holds an edit, from its start up to the end of the line
# `last`, where the edit ends, which leaves out the blocks below its head.
struct Held
  from: Position
  last: Int

  holds := (at: Position) -> @from.compare(at) != GREATER and at.line <= @last

# A statement that the walk skips keeps its gaps, which report nothing.
held_statements := (text: SourceTokens, laid: LaidOut, edits: Edit[]) ->
  held: Held[]
  for edit in edits
    # That of a `;` is the layout's (see rewritten_text).
    continue if edit.rule == SEMICOLONS
    change := edit.change ? continue
    continue if text.starts[edit.at] ? -1 in laid.skipped
    var innermost: StatementShape?
    for statement in laid.statements
      continue unless spans(text, statement, change.from)
      innermost = statement if innermost == nil or statement.start > innermost.start
    held.push { from: text.code[innermost.start].position(), last: change.to.line } if innermost
  held

spans := (text: SourceTokens, statement: StatementShape, at: Position) ->
  first := text.code[statement.start]
  last := text.code[statement.end - 1]
  ends_after := at.compare({ line: last.end_line, column: last.end_column }) == LESS
  first.position().compare(at) != GREATER and ends_after

# The rules whose rewrites change the syntax tree; the others give the same tree, which the
# formatter checks. A comparison of trees cannot check these, which change it by design;
# tests/format2/rewritten_forms.lerta checks that each form means what its rewrite does.
TREE_CHANGES := [BINARY_LITERALS, DOUBLE_NEGATIONS, ELSE_NIL, EMPTY_INITIAL_VALUES, RANGE_ENDS]

# Only the rewrites of the source itself are reported: one that a round enables, as `b'...'` for the
# `b"..."` that `"...".binary` is written as, shows once the text written is formatted again.
# The source with the rewrites applied, round after round, as one may find another in what an
# earlier one wrote, and laid out. Each round checks that the rewrites that keep the syntax tree do,
# and the layout that it keeps the tree of the source rewritten. A `;` goes last, once the layout
# has kept no statement on a line that holds one (see Code kept as written): the layout puts the
# statement after it on a line of its own where it decides where the statement starts, and its
# rewrite elsewhere.
rewritten_text := (parsed: Parsed, path: String, first_edits: Edit[]) ->
  var current = parsed
  var edits = first_edits
  # Whether `current` is laid out: the layout may join the lines of brackets that a rewrite leaves
  # as long as they span lines, which is then found again.
  var is_laid = false
  for _ in 0..MAX_ROUNDS
    chosen := applicable([edit for edit in edits when edit.rule != SEMICOLONS])
    if chosen.is_empty()
      break if is_laid
      current = checked_layout(laid_out(current).text, current, path)
      is_laid = true
    else
      changing := [edit for edit in chosen when edit.rule in TREE_CHANGES]
      expected := written_program(applied(current.source, changing), path, 'its rewrites')
      current = written_program(applied(current.source, chosen), path, 'its rewrites')
      check_same current, expected, path, 'its rewrites'
      is_laid = false
    edits = rewrites(current)
  laid := is_laid then current else checked_layout(laid_out(current).text, current, path)
  separators := applicable([edit for edit in rewrites(laid) when edit.rule == SEMICOLONS])
  return laid.source if separators.is_empty()
  separated := written_program(applied(laid.source, separators), path, 'its rewrites')
  check_same separated, laid, path, 'its rewrites'
  separated.source

# The rounds that the rewrites and the layouts between them take at most: one for each that another
# enables, as `"..."` of `"...".binary` is written `'...'` once it is `b"..."`. What is left after
# the last is reported once the text written is formatted again.
MAX_ROUNDS := 8

# The program laid out, which must be that of the source.
checked_layout := (text: String, source: Parsed, path: String) ->
  laid := written_program(text, path, 'its layout')
  check_same laid, source, path, 'its layout'
  laid

written_program := (text: String, path: String, what: String) ->
  try
    parsed_source text, path
  catch error: CompileError
    throw changed(path, "#{what} would not parse: #{error.message}")

check_same := (written: Parsed, expected: Parsed, path: String, what: String) ->
  same := dump_ast_without_positions(written.statements) ==
    dump_ast_without_positions(expected.statements)
  throw changed(path, "#{what} would change the program") unless same

changed := (path: String, message: String) ->
  ChangedProgram "#{path}: #{message}, which is a fault of the formatter"

stranded_finding := (text: SourceTokens, index: Int) ->
  Finding at: text.ending_comments[index]!.start, rule: STRANDED_COMMENTS

lay_out := (text: SourceTokens, walked: Walked) ->
  layout := Layout(text, code_gaps: walked.gaps, skipped: walked.skipped)
  for gap, index in text.gaps
    layout.decide gap, index
    layout.decide_text text.tokens[index] if index < text.tokens.length
  layout

# The second pass: decides each gap between text tokens, in order, from the gaps between code
# tokens that the walk decides, and the lines laid out before it; and the text of each token.
class Layout
  text: SourceTokens
  code_gaps: Map<Int, CodeGap>
  skipped: Set<Int>
  decisions: Decision[] = []
  texts: String[] = []
  # The depth of the last line start.
  var depth = 0
  # The columns that the last line start moves the indentation of its source line by, which the
  # lines after it that keep their source text move by too, so that their blocks stay as deep as
  # they are under it. A block that the source indents by other than two spaces thus keeps its
  # width there, unreported, until the walk handles the statement that holds it.
  var shift = 0

  decide := (gap: Gap, index: Int) ->
    { tokens } := @text
    decision :=
      case
        when index == 0 then Decision(text: '', rule: LAYOUT)
        when index == tokens.length then Decision(text: "\n", rule: ending_rule(gap))
        else @decide_before(tokens[index], gap)
    @decisions.push decision

  decide_before := (token: TextToken, gap: Gap) ->
    { code } := @text
    has_code := token.next_code < code.length
    code_gap := has_code then @code_gaps[token.next_code] else END
    return @kept(gap) unless code_gap
    comment := token.comment
    if comment and not comment.own_line
      # That of a statement that the walk skips keeps its place as written.
      return @kept(gap) if token.next_code - 1 in @skipped
      return Decision(text: '  ', rule: COMMENTS)
    case code_gap
      when Spaces
        rule := "\n" in gap.text then code_gap.joined else code_gap.rule
        Decision rule, text: ' '.repeat(code_gap.count)
      when LineStart
        next_column := has_code then code[token.next_code].column else 1
        # A comment before a dedent indented deeper than the line after it, as at the end of a
        # block, is indented as the line before it.
        dedent := code_gap.depth < @depth
        deeper_comment := comment and dedent and comment.column > next_column
        @depth = code_gap.depth unless deeper_comment
        @shift = 2 * @depth - token.line_indentation
        line_feed gap, 2 * @depth, code_gap.rule

  # A gap that the walk does not decide keeps its source text, spaces at the ends of lines too,
  # unreported, as the walk vouches only for the statements that it handles; but the indentation
  # after it moves with the line start before it.
  kept := (gap: Gap) ->
    { text } := gap
    return Decision(text, rule: LAYOUT) unless "\n" in text
    head := text.binary[..(text.binary.length - indentation(text))].text()!
    Decision text: head + ' '.repeat(max(0, indentation(text) + @shift)), rule: LAYOUT

  # The lines of a `"""` or `'''` literal after its first are one level deeper than the line that
  # it starts on (see Multi-line literals), or move with it in a statement that the walk skips.
  decide_text := (token: TextToken) ->
    text :=
      if token.comment != nil or "\n" not in token.text
        token.text
      else if token.next_code in @code_gaps
        indented token.text, 2 * (@depth + 1)
      else
        shifted_lines token.text, @shift
    @texts.push text

# The end of the source starts a line at depth 0, which a comment before it is indented by.
END := LineStart(depth: 0)

ending_rule := (gap: Gap) -> line_feeds(gap.text) > 1 then BLANK_LINES else LAYOUT

# A line feed, after a blank line where the source has one, and an indentation of `columns`; `rule`
# decides it where the source has none.
line_feed := (gap: Gap, columns: Int, break_rule: StyleRule) ->
  feeds := line_feeds(gap.text)
  blank := feeds > 1
  text := (blank then "\n\n" else "\n") + ' '.repeat(columns)
  rule :=
    case
      when ';' in gap.text then SEMICOLONS
      when feeds == 0 then break_rule
      # Spaces before the first line feed come before any extra line feed.
      when not gap.text.starts_with("\n") then LAYOUT
      when feeds > 2 then BLANK_LINES
      else LAYOUT
  Decision text, rule

line_feeds := (text: String) -> text.split("\n").length - 1

# The spaces after the last line feed of the text of a gap.
indentation := (text: String) -> text.split("\n").last()!.count()

# A `"""` or `'''` literal with its lines after the first indented by `columns`.
indented := (text: String, columns: Int) ->
  indentation := ' '.repeat(columns)
  lines := [line.is_empty() then '' else indentation + line for line in literal_lines(text)]
  [text.split("\n")[0], lines...].join("\n")

# The text with its lines after the first moved by `shift` columns, those that are not blank.
shifted_lines := (text: String, shift: Int) ->
  lines := text.split("\n")
  # One shift for every line, no more to the left than the lines share, keeps the literal's value.
  moved := max(shift, -common_indentation(lines[1..]))
  [lines[0], [shifted(line, moved) for line in lines[1..]]...].join("\n")

# The line with `shift` spaces more at its start, or fewer; a blank line stays as it is.
shifted := (line: String, shift: Int) ->
  return line if is_blank(line)
  return ' '.repeat(shift) + line if shift >= 0
  line.binary[(-shift)..].text()!

render := (texts: String[], decisions: Decision[]) ->
  var text = decisions[0].text
  text += token_text + decisions[index + 1].text for token_text, index in texts
  text

# A finding for each gap whose decision differs from the source, at the first character that
# differs, once on each line for each rule.
findings := (gaps: Gap[], decisions: Decision[]) ->
  found: Finding[]
  reported: Set<String>
  for gap, index in gaps
    decision := decisions[index]
    at := first_difference(gap, decision.text) ? continue
    { rule } := decision
    key := "#{at.line} #{rule.label} #{rule.message}"
    continue if key in reported
    reported.add key
    found.push { at, rule }
  found

# A finding for each token whose text differs from the source, as the lines of a literal moved.
token_findings := (tokens: TextToken[], texts: String[]) ->
  found: Finding[]
  for token, index in tokens
    source := Gap(text: token.text, start: token.start)
    found.push { at, rule: LAYOUT } if at := first_difference(source, texts[index])
  found

first_difference := (gap: Gap, decided: String) ->
  source := scan(gap.text)
  expected := scan(decided)
  var line = gap.start.line
  var column = gap.start.column
  while true
    c := source.next()
    return Position(line, column) if c != expected.next()
    if c == "\n"
      line += 1
      column = 1
    else if c
      column += 1
    else
      return nil
  nil
