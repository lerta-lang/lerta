# What the walk asks about the syntax: predicates, and the precedence of operators (see walk.lerta).
import
  ArrayLiteral, Assignment, Await, BinaryOperation, BooleanLiteral, Call, Case, Coalesce,
  Conditional, Declaration, EnumDeclaration, Expression, Extend, Extern, FloatLiteral, For,
  FunctionLiteral, Identifier, If, Import, Index, IntegerLiteral, InterfaceDeclaration, Intrinsic,
  is_spread, MapLiteral, Member, NamedValue, NilLiteral, Pass, Position, Range, RecordLiteral,
  Return, Statement, StringLiteral, Throw, Try, TupleItem, TypeAlias, TypeDeclaration,
  UnaryOperation, While, Yield
from '../ast'
import is_command_callee from '../format/print_statement'

# A declaration of those that a destructuring stands for, whose position need not be where its line
# starts: the one of the value, whose name cannot be written, or one of a name from it.
export is_destructuring_part := (statement: Statement) ->
  declaration := statement as Declaration ? return false
  { name, value } := declaration
  from_holder := value is Member and is_holder(value.object)
  is_holder(name) or value is TupleItem or from_holder

# A declaration that takes apart a value that a destructuring holds, which has no tokens of its own.
export is_taken_apart := (statement: Statement) ->
  is_destructuring_part(statement) and not is_destructuring_holder(statement)

# The declaration of what holds the value of a destructuring, `(a, b) := value` or
# `{ a, b } := value`, which starts at its first token.
export is_destructuring_holder := (statement: Statement) ->
  statement is Declaration and is_holder(statement.name)

# The declaration of what holds the value of `(a, b) := value`, whose position is that of the value.
export is_tuple_holder := (statement: Statement) ->
  statement is Declaration and statement.name.name.starts_with('_tuple.')

# The name of what holds a value that a destructuring takes apart, which cannot be written.
is_holder := (expression: Expression) -> expression is Identifier and '.' in expression.name

# The precedence of a binary operator, as those of operators in docs/reference/syntax.md.
export COMPARISON := 0

export level_of := (operator: String) ->
  case operator
    when 'or' then 1
    when 'and' then 2
    when '+', '-', '|', '^' then 3
    when '*', '/', '%', '&', '<<', '>>' then 4
    else COMPARISON

# A string longer than this may stand for a line of text, which a list puts on a line of its own.
SHORT_STRING := 12

# A name or a short literal, which shares a line with others in a long list (see Long lists).
export is_simple := (node: Expression) ->
  case node
    when Identifier, IntegerLiteral, FloatLiteral, BooleanLiteral, NilLiteral then true
    when StringLiteral then node.value.count() <= SHORT_STRING
    else false

# A statement that the line of `->`, `then` or `else` can hold: one that holds no block, nor
# declares.
export is_inline := (statement: Statement) ->
  case statement
    # One in its postfix form, which the line may keep, unless the formatter writes it in a block.
    when If, While, For
      postfix := is_written_postfix(statement)
      postfix then takes_postfix(postfix_body(statement)) else holds_no_block(statement)
    else holds_no_block(statement)

# A statement that holds no block, nor declares.
holds_no_block := (statement: Statement) ->
  case statement
    when
      Declaration, While, For, TypeDeclaration, EnumDeclaration, InterfaceDeclaration, TypeAlias,
      Extern, Intrinsic, Extend, Import, Case, Try
    then false
    when If then statement.nil_safe
    else true

# Whether the `if`, `while` or `for` is written in its postfix form, whose position is that of its
# body (see parse_postfix_conditions).
export is_written_postfix := (statement: Statement) ->
  case statement
    when If then not statement.nil_safe and at_body(statement.then_body[0], statement.position)
    when While then at_body(statement.body[0], statement.position)
    when For then at_body(statement.body.last()!, statement.position)
    else false

# The statement that the postfix form of the `if`, `while` or `for` follows: that of a `for` is its
# last, after the declarations that take its item apart, an `if` where it has a guard.
export postfix_body := (statement: If | While | For) ->
  case statement
    when If then statement.then_body[0]
    when While then statement.body[0]
    when For then statement.body.last()!

at_body := (body: Statement, position: Position) -> body.position.compare(position) == EQUAL

# A statement that a postfix `if`, `while` or `for` can follow: one that holds no block, nor
# declares, has no postfix form of its own, and ends with nothing that would take the postfix
# condition, as a function literal does (see Postfix forms); not `pass`, which is one only alone in
# its body.
export takes_postfix := (statement: Statement) ->
  holds_no_block(statement) and not ends_open(statement) and statement is not Pass

ends_open := (node: Statement): Bool ->
  case node
    when Assignment then ends_open(node.value)
    when Return
      value := node.value ? return false
      ends_open value
    when Throw then ends_open(node.message)
    when Yield then ends_open(node.value)
    when Await then ends_open(node.operand)
    when BinaryOperation then ends_open(node.right)
    when UnaryOperation then ends_open(node.operand)
    when Coalesce then ends_open(node.fallback)
    when Conditional then ends_open(node.without_else then node.then_value else node.else_value)
    when Range
      end := node.end ? return false
      ends_open end
    when Call
      values := [node.args..., [named.value for named in node.named_args]...]
      last := values.last() ? return false
      ends_open last
    when FunctionLiteral, Case, Try then true
    when If then not node.nil_safe
    else false

# A call whose callee could take its arguments without parentheses, or in a block.
export is_block_call := (node: Expression) ->
  call := node as Call ? return false
  has_arguments := not call.args.is_empty() or not call.named_args.is_empty()
  has_arguments and call.type_args.is_empty() and is_command_callee(call.callee)

# A literal that a block without brackets can hold: one that reads as the literal there, with more
# than one element, no spread, and no name alone for a field, which would read as an element.
export is_block_literal := (literal: Expression) ->
  case literal
    when ArrayLiteral then literal.elements.length > 1 and not literal.elements.any(is_spread)
    when RecordLiteral
      shorthand := literal.fields.any((field) -> is_shorthand(field))
      not literal.fields.is_empty() and not shorthand and literal.spread == nil
    when MapLiteral then not literal.entries.is_empty()
    else false

is_shorthand := (field: NamedValue) ->
  value := field.value
  value is Identifier and value.name == field.name.name

# Whether the literal is written in a block without brackets, whose position is that of its first
# item (see parse_block_literal), where one in brackets is that of its opening bracket.
export is_written_in_block := (literal: Expression) ->
  first := first_item_position(literal) ? return false
  first.compare(literal.position) == EQUAL

first_item_position := (literal: Expression) ->
  case literal
    when ArrayLiteral then literal.elements.first()?.position
    when MapLiteral then literal.entries.first()?.key.position
    when RecordLiteral
      spread := literal.spread ? return literal.fields.first()?.name.position
      spread.position
    else nil

# The literal that the members of the value follow, as `[...].join()`.
export literal_under_members := (value: Expression): Expression? ->
  object :=
    case value
      when Member then value.object
      when Call then value.callee
      when Index then value.object
      else return nil
  return object if object is ArrayLiteral or object is RecordLiteral or object is MapLiteral
  literal_under_members object
