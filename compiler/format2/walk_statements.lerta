# The walk of statements and blocks (see walk.lerta).
import
  Assignment, Binding, Call, Case, CaseArm, Condition, Declaration, EnumDeclaration, Extend, Extern,
  For, If, Import, ImportName, InterfaceDeclaration, Intrinsic, MemberDeclaration, Pass, Position,
  Statement, StringLiteral, TypeAlias, TypeDeclaration, TypeParameter, UnaryOperation, While
from '../ast'
import TokenKind from '../lexer/tokens'
import BRANCHES, StyleRule from '../format/rules'
import is_block_call, is_inline, is_written_postfix, takes_postfix from './forms'
import
  ArmShape, ArmsShape, BlockShape, BodyShape, CallShape, CodeGap, ImportShape, LineStart, ListShape,
  PostfixShape, StatementShape
from './shapes'
import NONE, ONE, spelling_of, unhandled, Unhandled, Walker from './walk'
import './walk_expressions'
import ListItems from './walk_lists'

extend Walker
  block := (statements: Statement[], depth: Int, head: Int?) ->
    @lines_block depth, head, statements.length, (i) ->
      @statement_on_line statements[i], { depth }, statements.get(i + 1)

  # The block at `depth` of `count` things on lines of their own, as `line` walks each.
  lines_block := (depth: Int, head: Int?, count: Int, line: (Int) -> void) ->
    outer_depth := @depth
    outer_starts := @block_starts
    outer_statements := @block_statements
    @block_starts = []
    @block_statements = []
    @depth = depth
    line i for i in 0..count
    block := BlockShape(head, starts: @block_starts, statements: @block_statements)
    @depth = outer_depth
    @block_starts = outer_starts
    @block_statements = outer_statements
    block

  # The statement, before `next`, the one after it in its block.
  statement_on_line := (statement: Statement, line: LineStart, next: Statement?) ->
    start := @text.statement_start(statement)
    next_at := next then @text.first_position(next)
    @on_line start, next_at, -> @statement(statement, line)

  # What starts a line at `first`, if it does, up to `next`, where what follows it in its block
  # starts, as `walk` walks it: a statement, or a member of a type.
  on_line := (first: Int?, next: Position?, walk: () -> void) ->
    line := LineStart(@depth)
    @resume_at first if first
    start := @at
    return @skip(start) if first != start or @skipped_from != nil
    # A statement that the walk skips starts its line still.
    @gaps[start] = line
    @block_starts.push start
    outer := @gaps
    @gaps = Map()
    outer_walk := @save()
    @shapes = []
    @closing = []
    @closing_block = false
    @breaks_operations = true
    @in_brackets = false
    @on_own_line = true
    outer_stranded := @stranded.length
    walked :=
      try
        walk()
        true
      catch _: Unhandled
        false
    # Asked after the walk, as the statements inside claim their marked lines first.
    kept := @kept.keeps(@code[start].position(), next)
    if kept
      # A kept statement reports nothing.
      @stranded = @stranded[..outer_stranded]
    if walked and not kept
      outer[gap] = decided for (gap, decided) in @gaps.entries()
      walked_statement := StatementShape(start, end: @at, shapes: @shapes)
      @block_statements.push walked_statement
      @walked.push walked_statement
    else
      @skip start
    @gaps = outer
    @restore outer_walk

  statement := (statement: Statement, before: CodeGap): void ->
    case statement
      when If then @if_statement(statement, before)
      when While then @while_statement(statement, before)
      when For then @for_statement(statement, before)
      when Declaration then @declaration(statement, before)
      when Assignment then @assignment(statement, before)
      when Pass then @take_spelled('pass', before)
      when Import then @import_statement(statement, before)
      when TypeDeclaration then @type_declaration(statement, before)
      when InterfaceDeclaration then @interface_declaration(statement, before)
      when EnumDeclaration then @enum_declaration(statement, before)
      when Extend then @extend_declaration(statement, before)
      when TypeAlias then @type_alias(statement, before)
      when Extern then @extern_declaration(statement, before)
      when Intrinsic then @intrinsic_declaration(statement, before)
      when Call then @call_statement(statement, before)
      else @expression(statement, before)

  # An `if`, which may be the whole body of an `else`, written `else if` or in the block of `else`,
  # whose postfix form would read as the else's.
  if_statement := (node: If, before: CodeGap, in_else = false): void ->
    unhandled() if node.nil_safe
    if is_written_postfix(node)
      @postfix_form node.then_body[0], before, -> @postfix_head(node.condition, ['if', 'unless'])
      return
    keyword := @code[@at].kind
    unhandled() unless keyword in ['if', 'unless']
    alone := in_else or @at in @alone_in_else
    head := @take(keyword, before)
    @condition node.condition, keyword
    @nested_block node.then_body, head
    if node.else_body.is_empty()
      @block_form head, node.then_body unless alone
      return
    first := node.else_body[0]
    @resume_at (@starts[first.position] ? unhandled()) - 1
    else_at := @take('else', LineStart(@depth))
    if first is If and @at not in @line_starts
      @if_statement first, ONE, true
      return
    @alone_in_else.add @starts[first.position]! if first is If and node.else_body.length == 1
    block := @block(node.else_body, @depth + 1, else_at)
    if_at := @starts[first.position]!
    if_alone := first is If and node.else_body.length == 1 and @code[if_at].kind == 'if'
    joins_if := if_alone and not @has_comments(else_at, if_at)
    @shapes.push BlockShape(block..., joins_if, head: else_at)
    @close else_at, true

  while_statement := (node: While, before: CodeGap) ->
    if is_written_postfix(node)
      @postfix_form node.body[0], before, -> @postfix_head(node.condition, ['while', 'until'])
      return
    keyword := @code[@at].kind
    unhandled() unless keyword in ['while', 'until']
    head := @take(keyword, before)
    @condition node.condition, keyword
    @nested_block node.body, head
    @block_form head, node.body

  for_statement := (node: For, before: CodeGap) ->
    return @postfix_for(node, before) if is_written_postfix(node)
    head := @take('for', before)
    @loop_head node
    @nested_block node.body, head
    # One whose item is taken apart has the declarations that do it in its body.
    @block_form head, node.body

  # The variables of the loop, and its iterable after `in`.
  loop_head := (node: For) ->
    @take IDENTIFIER, ONE
    if node.index
      @take_spelled 'at', ONE
      @take IDENTIFIER, ONE
    @take_spelled 'in', ONE
    @operand node.iterable, ONE

  # The `for` in its postfix form; with a guard, `s for x in xs when g`, its body is the `if` of it,
  # as that of `s if g for x in xs` is, which the walk does not handle yet.
  postfix_for := (node: For, before: CodeGap) ->
    unhandled() if node.body.length != 1
    guarded := node.body[0] as If?
    has_guard := guarded != nil and is_written_postfix(guarded)
    body := has_guard then guarded!.then_body[0] else node.body[0]
    @postfix_form body, before, ->
      @take 'for', ONE
      @loop_head node
      return nil unless has_guard
      guard := @take_spelled('when', ONE)
      @condition guarded!.condition, 'if'
      guard

  # The keyword, one of `keywords`, and the condition after it, of a postfix form.
  postfix_head := (condition: Condition, keywords: TokenKind[]): Int? ->
    keyword := @code[@at].kind
    unhandled() unless keyword in keywords
    @take keyword, ONE
    @condition condition, keyword
    nil

  # A statement in its postfix form (see PostfixShape): its body, and the head that `head` walks,
  # which gives the `when` of a guard.
  postfix_form := (body: Statement, before: CodeGap, head: () -> Int?) ->
    outer := @shapes
    @shapes = []
    start := @at
    @statement body, before
    body_shape := StatementShape(start, end: @at, shapes: @shapes)
    @shapes = []
    keyword := @at
    guard := head()
    stacked := (body is If or body is While or body is For) and is_written_postfix(body)
    shape := PostfixShape
      keyword
      guard
      stacked
      body: body_shape
      head_last: (guard ? @at) - 1
      last: @at - 1
      postfix: true
      shapes: @shapes
    @shapes = outer
    @shapes.push shape

  # The statement at `head` in its block form, which a postfix form may write where its block, just
  # walked, holds one statement that can take it, and no comment, which the postfix form would have
  # to move (see PostfixShape).
  block_form := (head: Int, body: Statement[]) ->
    block := @shapes.last() as BlockShape!
    statement := block.statements.first() ? return
    one := body.length == 1 and block.statements.length == 1
    return if not one or not takes_postfix(body[0]) or @has_comments(head, statement.end)
    head_last := block.starts[0] - 1
    shape := PostfixShape
      head_last
      keyword: head
      last: head_last
      body: statement
      postfix: false
      guard: nil
      stacked: false
      shapes: []
    @shapes.push shape

  # The block of a statement below its head, which the next token of the statement closes.
  nested_block := (statements: Statement[], head: Int) ->
    @shapes.push @block(statements, @depth + 1, head)
    @close head, true

  # The condition after the keyword; that of `unless` or `until` is `not` of what is written. Its
  # operations stay on its line, as the lines below it are the block.
  condition := (condition: Condition, keyword: TokenKind) ->
    case condition
      when Binding
        @take IDENTIFIER, ONE
        @take ':=', ONE
        @operand condition.value, ONE
      when UnaryOperation
        written := keyword in ['unless', 'until'] then condition.operand else condition
        @operand written, ONE
      else @operand(condition, ONE)

  declaration := (node: Declaration, before: CodeGap) ->
    unhandled() if node.weak
    var next = before
    if node.exported
      @take 'export', next
      next = ONE
    if node.mutable
      @take 'var', next
      next = ONE
    @take IDENTIFIER, next
    if type := node.type
      @take ':', NONE
      @type type, ONE
    return if node.omits_value
    assign := @take(node.mutable or node.type then '=' else ':=', ONE)
    @value assign, node.value, true

  # `struct` or `class`, its name, its type parameters and the interface it satisfies, and its
  # members in the block below.
  type_declaration := (node: TypeDeclaration, before: CodeGap) ->
    head := @declaration_head(node.exported, node.is_struct then 'struct' else 'class', before)
    @take IDENTIFIER, ONE
    @type_parameters node.type_params
    if satisfies := node.satisfies
      @take ':', NONE
      @type satisfies, ONE
    @members node.members, head

  interface_declaration := (node: InterfaceDeclaration, before: CodeGap) ->
    head := @declaration_head(node.exported, 'interface', before)
    @take IDENTIFIER, ONE
    @type_parameters node.type_params
    @members node.members, head

  # `enum`, its name, and its members in the block below, one on each line.
  enum_declaration := (node: EnumDeclaration, before: CodeGap) ->
    head := @declaration_head(node.exported, 'enum', before)
    @take IDENTIFIER, ONE
    { members } := node
    @in_block head, members.length, (i) -> members[i].position, (i, gap) ->
      @take members[i] is StringLiteral then STRING else IDENTIFIER, gap

  extend_declaration := (node: Extend, before: CodeGap) ->
    head := @take('extend', before)
    @type_parameters node.type_params
    @type node.type, ONE
    @members node.members, head

  type_alias := (node: TypeAlias, before: CodeGap) ->
    @declaration_head node.exported, IDENTIFIER, before
    @take IDENTIFIER, ONE
    @take '=', ONE
    @type node.type, ONE

  # `extern`, its symbol, `as` and its name if it has one, and its type.
  extern_declaration := (node: Extern, before: CodeGap) ->
    @declaration_head node.exported, 'extern', before
    @take IDENTIFIER, ONE
    # Its name may be written as its symbol, after `as` or not.
    if spelling_of(@code[@at]) == 'as'
      @take_spelled 'as', ONE
      @take IDENTIFIER, ONE
    @take ':', NONE
    @type node.type, ONE

  intrinsic_declaration := (node: Intrinsic, before: CodeGap) ->
    @declaration_head node.exported, 'intrinsic', before
    @take IDENTIFIER, ONE
    if type := node.type
      @take ':', NONE
      @type type, ONE

  # The keyword of a declaration, after `export` where it is exported: the head of its block.
  declaration_head := (exported: Bool, keyword: TokenKind, before: CodeGap) ->
    return @take(keyword, before) unless exported
    @take 'export', before
    @take keyword, ONE

  # `<T, U: Bound>`, where there are type parameters.
  type_parameters := (params: TypeParameter[]) ->
    return if params.is_empty()
    @take '<', NONE
    @list params.length, NONE, (i, gap) -> @type_parameter(params[i], gap), false
    @take '>', NONE

  type_parameter := (param: TypeParameter, before: CodeGap) ->
    @take IDENTIFIER, before
    if bound := param.bound
      @take ':', NONE
      @type bound, ONE

  # The members of a type, in the block below its head.
  members := (members: MemberDeclaration[], head: Int) ->
    @in_block head, members.length, (i) -> members[i].position, (i, gap) ->
      @member_declaration members[i], gap

  # `count` things in the block below `head`, each on a line of its own, which starts at its
  # position, as `walk` walks it.
  in_block := (head: Int, count: Int, position: (Int) -> Position, walk: (Int, CodeGap) -> void) ->
    line := (i: Int) ->
      start := @starts[position(i)]
      first := start != nil and start in @line_starts then start
      next := i + 1 < count then position(i + 1)
      @on_line first, next, -> walk(i, LineStart(@depth))
    @shapes.push @lines_block(@depth + 1, head, count, line)
    @close head, true

  # `[var | weak | weak var] name[: Type[!]][ = [default] value]`, or `name := [default] value`.
  member_declaration := (member: MemberDeclaration, before: CodeGap) ->
    var gap = before
    { modifier } := member
    if modifier == 'weak' or modifier == 'weak var'
      @take_spelled 'weak', gap
      gap = ONE
    if modifier == 'var' or modifier == 'weak var'
      @take 'var', gap
      gap = ONE
    @take IDENTIFIER, gap
    if type := member.type
      @take ':', NONE
      @type type, ONE
      @take '!', NONE if member.throws
    value := member.value ? return
    var assign = @take(modifier == nil and member.type == nil then ':=' else '=', ONE)
    assign = @take_spelled('default', ONE) if member.has_default
    @value assign, value, true

  # `import 'module'`, with `as` and a name or not, or `import` or `export` and names, on its line
  # or in a block below it, from the module (see ImportShape).
  import_statement := (node: Import, before: CodeGap) ->
    @take node.exported then 'export' else 'import', before
    if node.names.is_empty()
      @take STRING, ONE
      if node.alias != nil
        @take_spelled 'as', ONE
        @take IDENTIFIER, ONE
      return
    { names } := node
    items := ListItems
      count: names.length
      walk: (i, gap) -> @import_name(names[i], gap)
      simple: (_) -> true
    @unbracketed items
    list := @shapes.pop() as ListShape!
    from_at := @take_spelled('from', ONE)
    @shapes.push ImportShape(from_at, names: list, last: @take(STRING, ONE))

  import_name := (name: ImportName, before: CodeGap) ->
    @take IDENTIFIER, before
    return if name.alias == nil
    @take_spelled 'as', ONE
    @take IDENTIFIER, ONE

  assignment := (node: Assignment, before: CodeGap) ->
    @operand node.target, before
    @value @take_spelled(node.operator, ONE), node.value, true

  # A call that is a statement, whose callee could take its arguments without parentheses (see
  # CallShape).
  call_statement := (node: Call, before: CodeGap) ->
    return @expression(node, before) unless is_block_call(node)
    outer := @shapes
    @shapes = []
    @expression node, before
    shape := CallShape(shapes: @shapes)
    @shapes = outer
    @shapes.push shape

  # The body after the `->`, `then` or `else` at `head`: a block on the lines below it, or one
  # statement on its line (see BodyShape).
  body := (head: Int, statements: Statement[], rule: StyleRule) ->
    start := @at
    if start in @line_starts
      block := @block(statements, @depth + 1, head)
      one := statements.length == 1 and block.statements.length == 1
      # A postfix form inside brackets would not end its line, which it must.
      first := statements[0]
      postfix := (first is If or first is While or first is For) and is_written_postfix(first)
      joinable :=
        one and is_inline(first) and not (postfix and @in_brackets) and not @has_comments(head, @at)
      @close head, true
      return BodyShape(head, block, joinable, rule)
    unhandled() if statements.length != 1
    joinable := is_inline(statements[0])
    outer_shapes := @shapes
    outer_line := @on_own_line
    @shapes = []
    @on_own_line = false
    @statement statements[0], ONE
    statement := StatementShape(start, end: @at, shapes: @shapes)
    @shapes = outer_shapes
    @on_own_line = outer_line
    @close head, false
    block := BlockShape(head, starts: [start], statements: [statement])
    BodyShape head, block, joinable, rule

  # `case`, with its subject or without one, and its arms below it (see ArmsShape).
  case_value := (node: Case, before: CodeGap) ->
    head := @take('case', before)
    @operand subject, ONE if subject := node.subject
    has_subject := node.subject != nil
    arms := [@arm(arm, has_subject) for arm in node.arms]
    if otherwise := node.otherwise
      start := @take('else', LineStart(depth: @depth + 1))
      body := @body(start, otherwise, BRANCHES)
      arms.push {
        start
        body
        patterns: []
        breakable: false
        then_at: nil
        commas: true
        shapes: []
      }
    @shapes.push ArmsShape(head, arms)
    @close head, true

  # An arm, `when` and its patterns, which a subject's may write on lines of their own below it, and
  # its body, after `then` if it is written.
  arm := (arm: CaseArm, has_subject: Bool) ->
    start := @take_spelled('when', LineStart(depth: @depth + 1))
    outer := @shapes
    @shapes = []
    breaks := @breaks_operations
    @breaks_operations = false
    { patterns } := arm
    walked := @list(patterns.length, ONE, (i, gap) -> @expression(patterns[i], gap), has_subject)
    @breaks_operations = breaks
    shapes := @shapes
    @shapes = outer
    then_at := @at_kind('then') then @take('then', ONE)
    body := @body(then_at ? start, arm.body, BRANCHES)
    ArmShape
      start
      then_at
      body
      shapes
      patterns: walked.starts
      breakable: has_subject
      commas: walked.commas
