# The code tokens of the source as the rewrites read and change them (see rewrites.lerta).
import Position from '../ast'
import StyleRule from '../format/rules'
import CLOSING_BRACKETS, Comment, OPENING_BRACKETS, TokenKind from '../lexer/tokens'
import Change, Edit, LineOffsets from './edits'
import SourceTokens from './text'

export class Tokens
  source: String
  text: SourceTokens
  comments: Comment[]
  # The lines of the statements that the comments mark to keep as they are written (see kept.lerta).
  kept: Set<Int>
  code := @text.code
  offsets := LineOffsets(@source)

  # The index of the code token at the position.
  at := (position: Position) -> @text.starts[position]

  start := (index: Int) -> @code[index].position()

  end := (index: Int) -> Position(line: @code[index].end_line, column: @code[index].end_column)

  spelling := (index: Int) -> @slice(@start(index), @end(index))

  # The spellings of the tokens from `first` through `last`, without the spaces between them.
  joined := (first: Int, last: Int) -> [@spelling(index) for index in first..=last].join('')

  slice := (from: Position, to: Position) ->
    @source.binary[@offsets.of(from)..@offsets.of(to)].text()!

  is_kind := (index: Int, kind: TokenKind) -> index in 0..@code.length and @code[index].kind == kind

  is_word := (index: Int, word: String) -> index in 0..@code.length and @code[index].is_word(word)

  # The index of the bracket that closes the one at `open`.
  matching := (open: Int) ->
    var depth = 0
    for token, index in @code[open..]
      depth += 1 if token.kind in OPENING_BRACKETS
      depth -= 1 if token.kind in CLOSING_BRACKETS
      return open + index if depth == 0
    nil

  # The last code token on the line of the one at `first`; nil where one of them spans lines.
  line_end := (first: Int) ->
    { line } := @code[first]
    var last = first
    last += 1 while last + 1 < @code.length and @code[last + 1].line == line
    @code[first..=last].any((token) -> token.end_line > token.line) then nil else last

  # The spaces that the line starts with; nil where it is blank.
  line_indentation := (line: Int) ->
    bytes := @source.binary
    start := @offsets.starts[line - 1]
    var at = start
    at += 1 while at < bytes.length and bytes[at] == b' '[0]
    blank := at == bytes.length or bytes[at] == b"\n"[0]
    blank then nil else at - start

  replaced := (index: Int, text: String) -> Change(text, from: @start(index), to: @end(index))

  # The token left out with the spaces after it, but a space between the words that it would join.
  removed := (index: Int) -> @run_removed(index, index)

  # The tokens from `first` through `last` left out with the spaces after each, likewise.
  run_removed := (first: Int, last: Int) ->
    joined := @are_words(first - 1, last + 1) and @end(first - 1) == @start(first)
    Change from: @start(first), to: @start(last + 1), text: joined then ' ' else ''

  # The token left out with the spaces before it, likewise.
  removed_with_spaces_before := (index: Int) -> @run_removed_with_spaces_before(index, index)

  run_removed_with_spaces_before := (first: Int, last: Int) ->
    joined := @are_words(first - 1, last + 1) and @end(last) == @start(last + 1)
    Change from: @end(first - 1), to: @end(last), text: joined then ' ' else ''

  are_words := (before: Int, after: Int) ->
    return false if not before >= 0 or not after < @code.length
    ends_word(@spelling(before)) and starts_word(@spelling(after))

  # The edit of the changes, in the order of the source, from the first up to the last with the
  # source between them; nil where one would take out a comment, or on a line kept as it is written.
  edit := (rule: StyleRule, changes: Change[]): Edit? ->
    return nil if changes.any((change) -> @holds_comment(change))
    first := changes[0]
    last := changes.last()!
    return nil if @is_kept(first.from.line, last.to.line)
    var text = ''
    for change, i in changes
      text += @slice(changes[i - 1].to, change.from) if i > 0
      text += change.text
    { rule, at: first.from, change: { text, from: first.from, to: last.to } }

  # A rule that is only reported, but not on a line kept as it is written.
  report := (rule: StyleRule, at: Position): Edit? ->
    @is_kept(at.line, at.line) then nil else { at, rule, change: nil }

  holds_comment := (change: Change) ->
    @comments.any (comment) ->
      at := Position(line: comment.line, column: comment.column)
      change.from.compare(at) != GREATER and at.compare(change.to) == LESS

  is_kept := (first: Int, last: Int) ->
    for line in first..=last
      return true if line in @kept
    false

ends_word := (text: String) -> is_word_char(text.binary.last())

starts_word := (text: String) -> is_word_char(text.binary.first())

is_word_char := (byte: Byte?) ->
  char := byte?.to_int().to_char() ? return false
  char.is_letter() or char.is_digit() or char == '_'
