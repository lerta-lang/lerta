# Compiles the runtime, with libuv, once for each kind of build, and keeps its object files in a
# cache directory, so that a build only links them (see docs/reference/compiler.md).
import is_dir, is_file, list_dir, make_dir, read_text, remove_tree, rename, write_file from 'std:io'
import env, is_running, platform, process_id, run from 'std:process'
import embedded_source, EMBEDDED_PATHS from '../build/embedded'
import bits_hex from './bits'
import run_clang_jobs from './clang_jobs'
import build_flags, BuildKind from './clang_flags'
import CompileError from './errors'
import is_for, libuv_build, LibuvBuild, LIBUV_PATHS, write_libuv_sources from './libuv'
import basename, join from './paths'

RUNTIME_PATHS := [path for path in EMBEDDED_PATHS when path.starts_with('runtime/')]

# Where the cache keeps what it reads from the IR that clang writes (see CachedRuntime).
ATTRIBUTES_FILE := 'function_attributes.txt'
CORO_END_FILE := 'coro_end_type.txt'

# The runtime's object files, and the attributes that clang gives its functions, as the target's
# CPU, which the program's functions must have too for LLVM to inline the runtime's into them; and
# the libraries that libuv is linked with; and the type that clang's LLVM gives llvm.coro.end.
export struct CachedRuntime
  objects: String[]
  function_attributes: String
  libraries: String[]
  coro_end_type: String

# The runtime for a kind of build, compiled into the cache first if it does not have it; nil if
# clang fails, after printing its messages. `temp_dir` is the build's own temporary directory.
export cached_runtime := (kind: BuildKind, temp_dir: String) ->
  reject_path_target target if target := kind.target
  clang_version := await clang_version_text() ? return nil
  libuv := libuv_build(kind.target)
  cache := cache_dir()
  runtime_name := cached_runtime_name(kind, clang_version, libuv)
  dir := join(cache, runtime_name)
  objects := [join(dir, name) for name in object_names(libuv)]
  files := [join(dir, name) for name in cached_file_names(libuv)]
  runtime := ->
    function_attributes := await read_text_or_throw(join(dir, ATTRIBUTES_FILE))
    coro_end_type := await read_text_or_throw(join(dir, CORO_END_FILE))
    CachedRuntime objects, function_attributes, coro_end_type, libraries: libuv.libraries
  return await runtime() if is_complete(files)
  if files.any(is_file)
    # Another build may have renamed its runtime into place meanwhile, which puts all the files
    # there at once. Otherwise a person has removed some of them; removing the rest here could
    # pull them from under a build that is linking with them.
    return await runtime() if is_complete(files)
    throw CompileError("the cached runtime #{dir} is incomplete: remove it")
  await remove_abandoned_staging(cache, runtime_name)
  staging_dir := "#{dir}#{STAGING_INFIX}#{process_id}-#{basename(temp_dir)}"
  make_dir staging_dir
  compiled :=
    try
      await compile_runtime(kind, libuv, staging_dir, temp_dir)
    catch error
      await remove_tree(staging_dir)
      throw error
  unless compiled
    await remove_tree(staging_dir)
    return nil
  await move_into_place(staging_dir, dir, files)
  await runtime()

# Where a build compiles the runtime before it moves it into place:
# `<dir>.staging-<process ID>-<name of the build's temporary directory>`. The ID tells a later build
# whether the build has ended, and the temporary directory's name, which no other build has, keeps
# the name unique.
STAGING_INFIX := '.staging-'

# Removes the staging directories of the runtime `name` in `cache` that builds killed while they
# compiled it left: those of a process that is no longer running.
remove_abandoned_staging := (cache: String, name: String) ->
  prefix := "#{name}#{STAGING_INFIX}"
  for entry in list_dir(cache)
    suffix := entry.without_prefix(prefix) ? continue
    id := suffix.split('-')[0].parse_int() ? continue
    continue if is_running(id)
    try
      await remove_tree(join(cache, entry))
    catch _
      # Another build may have removed it first, and one left in place only takes space.
      continue

# What `clang --version` prints, or nil if clang fails.
clang_version_text := ->
  output: Byte[]
  return nil if (await run('clang', '--version', stdout: output)).code != 0
  output.to_binary().text() ? throw CompileError('clang --version is not valid UTF-8')

read_text_or_throw := (path: String) ->
  await read_text(path) ? throw CompileError("#{path} is not valid UTF-8")

# `$LERTA_CACHE_DIR`, or else the system's place for caches. An empty variable counts as unset, as
# the XDG specification has it.
cache_path := -> non_empty_env('LERTA_CACHE_DIR') ? default_cache_dir()

# The cache directory, made if missing.
export cache_dir := ->
  dir := cache_path()
  try
    make_dir dir
  catch _
    throw CompileError("cannot make the cache directory: #{dir}")
  dir

# Removes what builds keep in the cache directory, if there is one: the compiled runtimes, their
# staging directories and the linker's ThinLTO caches, of this compiler (see LTO_CACHE) or an
# earlier one, by the names that builds give them, so that nothing else in a directory that
# `$LERTA_CACHE_DIR` names goes. The paths removed, in the order of their names.
export clean_cache := (): Promise<String[]> ->
  dir := cache_path()
  return [] unless is_dir(dir)
  removed: String[]
  for name in list_dir(dir)
    continue unless is_made_by_builds(name)
    path := join(dir, name)
    try
      await remove_tree(path)
    catch error: IOError
      # A build may have renamed or removed it meanwhile, as one does with its staging directory.
      continue if not is_dir(path) and not is_file(path)
      throw error
    removed.push path
  removed

is_made_by_builds := (name: String) ->
  name.starts_with('runtime-') or name == 'thinlto' or name.starts_with('thinlto-devirt-')

default_cache_dir := -> platform == 'windows' then windows_cache_dir() else posix_cache_dir()

windows_cache_dir := ->
  return join(local_data, 'lerta') if local_data := non_empty_env('LOCALAPPDATA')
  throw CompileError('no cache directory: set LOCALAPPDATA or LERTA_CACHE_DIR')

posix_cache_dir := ->
  return join(cache_home, 'lerta') if cache_home := non_empty_env('XDG_CACHE_HOME')
  return join(home, '.cache/lerta') if home := non_empty_env('HOME')
  throw CompileError('no cache directory: set HOME or LERTA_CACHE_DIR')

non_empty_env := (name: String) ->
  value := env(name)
  value != '' then value

# See Names in docs/reference/compiler.md#cache. A target given is no path (see
# reject_path_target).
cached_runtime_name := (kind: BuildKind, clang_version: String, libuv: LibuvBuild) ->
  kind_name := runtime_kind_name(kind)
  target_name := kind.target ? version_line_value(clang_version, 'Target: ') ? 'unknown'
  clang_name := "clang#{major_version(clang_version) ? 'unknown'}"
  flags := build_flags(kind).join(' ')
  hash := runtime_hash([clang_version, flags, cached_file_names(libuv)...])
  "runtime-#{kind_name}-#{target_name}-#{clang_name}-#{hash}"

runtime_kind_name := (kind: BuildKind) ->
  return 'debug' unless kind.optimize
  kind.memory_checks then 'release-checked' else 'release'

# A target names a directory of the cache, so it cannot be a path.
reject_path_target := (target: String) ->
  throw CompileError("not a target: #{target}") if '/' in target or '\' in target

# The rest of the line of `clang --version` that starts with `prefix`.
version_line_value := (clang_version: String, prefix: String) ->
  clang_version.split("\n").find_map((line) -> line.without_prefix(prefix))

# The number before the first `.` of the word after `version`, as in `clang version 17.0.0`.
major_version := (clang_version: String) ->
  words := clang_version.split("\n")[0].split(' ')
  at := words.index_of('version') ? return nil
  words.get(at + 1)?.split('.')[0]

# FNV-1a of 64 bits, whose offset basis, 0xCBF29CE484222325, is written as the Int of its bits.
FNV_OFFSET_BASIS := -3750763034362895579
FNV_PRIME := 0x100000001B3

runtime_hash := (texts_besides_sources: String[]) ->
  texts := [texts_besides_sources...]
  for path in [RUNTIME_PATHS..., LIBUV_PATHS...]
    texts.push path
    texts.push embedded_source(path)!
  texts_hash texts

# The texts' hash as 16 hex digits, wide enough that two keys do not take one runtime by chance.
# Each text ends with a byte that no UTF-8 text holds, so that the texts' bounds count.
export texts_hash := (texts: String[]) ->
  var hash = FNV_OFFSET_BASIS
  mix := (byte: Int) -> hash = (hash ^ byte).wrapping_mul(FNV_PRIME)
  for text in texts
    mix byte.to_int() for byte in text.binary
    mix 0xFF
  bits_hex hash

# The runtime's C files for `system`: platform_<systems>.c only for those systems, named as in
# third_party/libuv.txt, and the others for all.
c_paths := (system: String) ->
  [path for path in RUNTIME_PATHS when path.ends_with('.c') and is_for(c_systems(path), system)]

c_systems := (path: String) ->
  basename(path).without_suffix('.c')!.without_prefix('platform_') ? 'all'

object_name := (c_path: String) -> "#{basename(c_path).without_suffix('.c')!}.o"

# libuv's object files are named by their sources' paths, as its directories for different systems
# hold files of the same names, as `src/unix/async.c` and `src/win/async.c`.
libuv_object_name := (source: String) -> "libuv-#{source.without_suffix('.c')!.replace('/', '-')}.o"

object_names := (libuv: LibuvBuild) ->
  runtime := [object_name(path) for path in c_paths(libuv.system)]
  [runtime..., [libuv_object_name(path) for path in libuv.sources]...]

cached_file_names := (libuv: LibuvBuild) -> [object_names(libuv)..., ATTRIBUTES_FILE, CORO_END_FILE]

# Writes the runtime's sources and libuv's to `temp_dir`, compiles each C file into `staging_dir`
# and writes what it reads from clang's IR there; false if clang fails.
compile_runtime := (kind: BuildKind, libuv: LibuvBuild, staging_dir: String, temp_dir: String) ->
  source_dir := join(temp_dir, 'runtime')
  make_dir source_dir
  for path in RUNTIME_PATHS
    await write_file(join(source_dir, basename(path)), embedded_source(path)!)
  libuv_dir := join(temp_dir, 'libuv')
  libuv_includes := await write_libuv_sources(libuv_dir)
  # uv.h, which the runtime includes, asks nothing of its users but where it is; libuv's own flags
  # are for its sources, whose warnings are not the program's, which a build prints.
  flags := [build_flags(kind)..., libuv_includes...]
  runtime_job := (path: String) ->
    ['-c', flags..., join(source_dir, basename(path)), '-o', join(staging_dir, object_name(path))]
  libuv_flags := [flags..., libuv.flags..., '-w']
  libuv_job := (path: String) ->
    object := join(staging_dir, libuv_object_name(path))
    ['-c', libuv_flags..., join(libuv_dir, path), '-o', object]
  jobs := [
    [runtime_job(path) for path in c_paths(libuv.system)]...
    [libuv_job(path) for path in libuv.sources]...
  ]
  return false unless await run_clang_jobs(jobs)
  ir := await clang_probe_ir(flags, temp_dir) ? return false
  await write_file(join(staging_dir, ATTRIBUTES_FILE), function_attributes(ir))
  await write_file(join(staging_dir, CORO_END_FILE), coro_end_type(ir))
  true

# The IR that clang writes, with `flags`, for a function that ends a coroutine; nil if clang fails.
# C has no builtin for that, so it is C++.
clang_probe_ir := (flags: String[], temp_dir: String) ->
  source := join(temp_dir, 'probe.cc')
  code := 'extern "C" void lerta_probe(void *handle) { __builtin_coro_end(handle, 0); }'
  await write_file(source, code)
  output: Byte[]
  args := ['-x', 'c++', '-std=c++20', '-S', '-emit-llvm', flags..., source, '-o', '-']
  return nil if (await run('clang', args..., stdout: output)).code != 0
  output.to_binary().text() ? throw CompileError('clang IR is not valid UTF-8')

# The attributes of the target that clang gives its function, as `"target-cpu"="x86-64"`.
function_attributes := (ir: String) ->
  words := attribute_group_of_function(ir).split(' ')
  is_target_attribute := (word: String) ->
    TARGET_ATTRIBUTES.any (name) -> word.starts_with("\"#{name}\"=")
  [word for word in words when is_target_attribute(word)].join(' ')

# The attributes of the group that the IR's one function has, as in `define void @f() #0 {`.
attribute_group_of_function := (ir: String) ->
  lines := ir.split("\n")
  missing := CompileError('clang IR has no function attributes')
  definition := lines.find((line) -> line.starts_with('define ')) ? throw missing
  group := definition.split(' ').find((word) -> word.starts_with('#')) ? throw missing
  lines.find((line) -> line.starts_with("attributes #{group} = { ")) ? throw missing

TARGET_ATTRIBUTES := ['target-cpu', 'target-features', 'tune-cpu']

# The type that clang's LLVM gives llvm.coro.end, which LLVM 23 changed from i1 to void, as in
# `declare i1 @llvm.coro.end(ptr, i1, token)`.
coro_end_type := (ir: String) ->
  missing := CompileError('clang IR has no declaration of llvm.coro.end')
  is_declaration := (line: String) -> line.starts_with('declare ') and ' @llvm.coro.end(' in line
  declaration := ir.split("\n").find(is_declaration) ? throw missing
  declaration.split(' ')[1]

is_complete := (files: String[]) -> files.all(is_file)

# Moves the compiled runtime into place, unless another build has moved its own there first,
# which is as good.
move_into_place := (staging_dir: String, dir: String, files: String[]) ->
  try
    rename staging_dir, dir
  catch _
    await remove_tree(staging_dir)
    unless is_complete(files)
      throw CompileError("cannot move the compiled runtime into the cache: #{dir}")
