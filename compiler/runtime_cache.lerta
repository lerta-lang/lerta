# Compiles the runtime, with libuv, once for each kind of build, and keeps its object files in a
# cache directory, so that a build only links them (see docs/reference/compiler.md).
import is_file, make_dir, read_file, remove_tree, rename, write_file from 'std:io'
import env, platform, run from 'std:process'
import embedded_source, EMBEDDED_PATHS from '../build/embedded'
import build_flags from './clang_flags'
import CompileError from './errors'
import hex from './hex'
import libuv_build, LibuvBuild, LIBUV_PATHS, write_libuv_sources from './libuv'
import basename, join from './paths'

const RUNTIME_PATHS = [path for path in EMBEDDED_PATHS when path.starts_with('runtime/')]

# Where the cache keeps what it reads from the IR that clang writes (see CachedRuntime).
const ATTRIBUTES_FILE = 'function_attributes.txt'
const CORO_END_FILE = 'coro_end_type.txt'

# The runtime's object files, and the attributes that clang gives its functions, as the target's
# CPU, which the program's functions must have too for LLVM to inline the runtime's into them; and
# the libraries that libuv is linked with; and the type that clang's LLVM gives llvm.coro.end.
export struct CachedRuntime
  objects: String[]
  function_attributes: String
  libraries: String[]
  coro_end_type: String

# The runtime for a build with `optimize`, for `target` or else the host, compiled into the cache
# first if it does not have it; nil if clang fails, after printing its messages. `temp_dir` is the
# build's own temporary directory, whose name no other build has.
export const cached_runtime = (optimize: Bool, target: String?, temp_dir: String) ->
  reject_path_target target if target
  const clang_version = await clang_version_text() ? return nil
  const libuv = libuv_build(target)
  const dir = join(cache_dir(), cached_runtime_name(optimize, target, clang_version, libuv))
  const objects = [join(dir, name) for name in object_names(libuv)]
  const files = [join(dir, name) for name in cached_file_names(libuv)]
  const runtime = ->
    const function_attributes = read_text(join(dir, ATTRIBUTES_FILE))
    const coro_end_type = read_text(join(dir, CORO_END_FILE))
    CachedRuntime(
      objects
      function_attributes
      libraries: libuv.libraries
      coro_end_type: coro_end_type
    )
  return runtime() if is_complete(files)
  if files.iter().any((file) -> is_file(file))
    # Another build may have renamed its runtime into place meanwhile, which puts all the files
    # there at once. Otherwise a person has removed some of them; removing the rest here could
    # pull them from under a build that is linking with them.
    return runtime() if is_complete(files)
    throw CompileError(message: "the cached runtime #{dir} is incomplete: remove it")
  const staging_dir = "#{dir}.staging-#{basename(temp_dir)}"
  make_dir staging_dir
  const compiled = try
    await compile_runtime(optimize, target, libuv, staging_dir, temp_dir)
  catch error
    remove_tree staging_dir
    throw error
  if not compiled
    remove_tree staging_dir
    return nil
  move_into_place staging_dir, dir, files
  runtime()

# What `clang --version` prints, or nil if clang fails.
const clang_version_text = (): Promise<String?> ->
  const output: Byte[] = []
  return nil if await run('clang', ['--version'], output) != 0
  output.to_binary().text() ? throw CompileError(message: 'clang --version is not valid UTF-8')

const read_text = (path: String) ->
  read_file(path).text() ? throw CompileError(message: "#{path} is not valid UTF-8")

# `$LERTA_CACHE_DIR`, or else the system's place for caches, made if missing. An empty variable
# counts as unset, as the XDG specification has it.
export const cache_dir = ->
  const dir = non_empty_env('LERTA_CACHE_DIR') ? default_cache_dir()
  try
    make_dir dir
  catch _
    throw CompileError(message: "cannot make the cache directory: #{dir}")
  dir

const default_cache_dir = -> platform == 'windows' then windows_cache_dir() else posix_cache_dir()

const windows_cache_dir = ->
  return join(local_data, 'lerta') if const local_data = non_empty_env('LOCALAPPDATA')
  throw CompileError(message: 'no cache directory: set LOCALAPPDATA or LERTA_CACHE_DIR')

const posix_cache_dir = ->
  return join(cache_home, 'lerta') if const cache_home = non_empty_env('XDG_CACHE_HOME')
  return join(home, '.cache/lerta') if const home = non_empty_env('HOME')
  throw CompileError(message: 'no cache directory: set HOME or LERTA_CACHE_DIR')

const non_empty_env = (name: String): String? ->
  const value = env(name)
  value != '' then value else nil

# Such as `runtime-debug-arm64-apple-darwin25.6.0-clang17-3F9A2C1D`, which a person can tell
# apart from the others. The hash, of the runtime's sources and libuv's, of the flags and of
# clang's version, which `-flto` objects depend on, and of the names of the files it holds, tells
# apart the builds that the rest of the name does not. A target given is no path (see
# reject_path_target).
const cached_runtime_name = (
  optimize: Bool, target: String?, clang_version: String, libuv: LibuvBuild
) ->
  const kind = optimize then 'release' else 'debug'
  const target_name = target ? version_line_value(clang_version, 'Target: ') ? 'unknown'
  const clang_name = "clang#{major_version(clang_version) ? 'unknown'}"
  const flags = build_flags(optimize, target).join(' ')
  const hash = hex(runtime_hash([clang_version, flags, cached_file_names(libuv)...]), 8)
  "runtime-#{kind}-#{target_name}-#{clang_name}-#{hash}"

# A target names a directory of the cache, so it cannot be a path.
const reject_path_target = (target: String) ->
  const is_path = target.split('/').length > 1 or target.split('\').length > 1
  throw CompileError(message: "not a target: #{target}") if is_path

# The rest of the line of `clang --version` that starts with `prefix`.
const version_line_value = (clang_version: String, prefix: String): String? ->
  for line in clang_version.split("\n")
    return value if const value = line.without_prefix(prefix)
  nil

# The number before the first `.` of the word after `version`, as in `clang version 17.0.0`.
const major_version = (clang_version: String): String? ->
  const words = clang_version.split("\n")[0].split(' ')
  for i in 1...words.length
    return words[i].split('.')[0] if words[i - 1] == 'version'
  nil

# A polynomial hash modulo the largest prime below 2^32, so that it fits in 8 hex digits and its
# products stay far within an Int.
const HASH_MODULUS = 4294967291

const runtime_hash = (texts_besides_sources: String[]) ->
  var hash = 0
  const texts = [texts_besides_sources...]
  for path in [RUNTIME_PATHS..., LIBUV_PATHS...]
    texts.push path
    texts.push embedded_source(path)!
  for text in texts
    hash = (hash * 257 + byte.to_int() + 1) % HASH_MODULUS for byte in text.binary
    hash = hash * 257 % HASH_MODULUS
  hash

const c_paths = -> [path for path in RUNTIME_PATHS when path.ends_with('.c')]

const object_name = (c_path: String) -> "#{basename(c_path).without_suffix('.c')!}.o"

# libuv's object files are named by their sources' paths, as its directories for different systems
# hold files of the same names, as `src/unix/async.c` and `src/win/async.c`.
const libuv_object_name = (source: String) ->
  "libuv-#{source.without_suffix('.c')!.split('/').join('-')}.o"

const object_names = (libuv: LibuvBuild) ->
  const runtime = [object_name(path) for path in c_paths()]
  [runtime..., [libuv_object_name(path) for path in libuv.sources]...]

const cached_file_names = (libuv: LibuvBuild) ->
  [object_names(libuv)..., ATTRIBUTES_FILE, CORO_END_FILE]

# Writes the runtime's sources and libuv's to `temp_dir`, compiles each C file into `staging_dir`
# and writes what it reads from clang's IR there; false if clang fails.
const compile_runtime = (
  optimize: Bool, target: String?, libuv: LibuvBuild, staging_dir: String, temp_dir: String
) ->
  const source_dir = join(temp_dir, 'runtime')
  make_dir source_dir
  for path in RUNTIME_PATHS
    write_file join(source_dir, basename(path)), embedded_source(path)!.binary
  const libuv_dir = join(temp_dir, 'libuv')
  const libuv_includes = write_libuv_sources(libuv_dir)
  # uv.h, which the runtime includes, asks nothing of its users but where it is; libuv's own flags
  # are for its sources, whose warnings are not the program's, which a build prints.
  const flags = [build_flags(optimize, target)..., libuv_includes...]
  for path in c_paths()
    const source = join(source_dir, basename(path))
    const object = join(staging_dir, object_name(path))
    return false if await run('clang', ['-c', flags..., source, '-o', object]) != 0
  const libuv_flags = [flags..., libuv.flags..., '-w']
  for path in libuv.sources
    const object = join(staging_dir, libuv_object_name(path))
    const libuv_source = join(libuv_dir, path)
    return false if await run('clang', ['-c', libuv_flags..., libuv_source, '-o', object]) != 0
  const ir = await clang_probe_ir(flags, temp_dir) ? return false
  write_file join(staging_dir, ATTRIBUTES_FILE), function_attributes(ir).binary
  write_file join(staging_dir, CORO_END_FILE), coro_end_type(ir).binary
  true

# The IR that clang writes, with `flags`, for a function that ends a coroutine; nil if clang fails.
# C has no builtin for that, so it is C++.
const clang_probe_ir = (flags: String[], temp_dir: String): Promise<String?> ->
  const source = join(temp_dir, 'probe.cc')
  const code = 'extern "C" void lerta_probe(void *handle) { __builtin_coro_end(handle, 0); }'
  write_file source, code.binary
  const output: Byte[] = []
  const args = ['-x', 'c++', '-std=c++20', '-S', '-emit-llvm', flags..., source, '-o', '-']
  return nil if await run('clang', args, output) != 0
  output.to_binary().text() ? throw CompileError(message: 'clang IR is not valid UTF-8')

# The attributes of the target that clang gives its function, as `"target-cpu"="x86-64"`.
const function_attributes = (ir: String) ->
  const words = attribute_group_of_function(ir).split(' ')
  const is_target_attribute = (word: String) ->
    TARGET_ATTRIBUTES.any (name) -> word.starts_with("\"#{name}\"=")
  [word for word in words when is_target_attribute(word)].join(' ')

# The attributes of the group that the IR's one function has, as in `define void @f() #0 {`.
const attribute_group_of_function = (ir: String) ->
  const lines = ir.split("\n")
  const missing = CompileError(message: 'clang IR has no function attributes')
  const definition = lines.find((line) -> line.starts_with('define ')) ? throw missing
  const group = definition.split(' ').find((word) -> word.starts_with('#')) ? throw missing
  lines.find((line) -> line.starts_with("attributes #{group} = { ")) ? throw missing

const TARGET_ATTRIBUTES = ['target-cpu', 'target-features', 'tune-cpu']

# The type that clang's LLVM gives llvm.coro.end, which LLVM 23 changed from i1 to void, as in
# `declare i1 @llvm.coro.end(ptr, i1, token)`.
const coro_end_type = (ir: String) ->
  const missing = CompileError(message: 'clang IR has no declaration of llvm.coro.end')
  const is_declaration = (line: String) ->
    line.starts_with('declare ') and line.split(' @llvm.coro.end(').length == 2
  const declaration = ir.split("\n").find(is_declaration) ? throw missing
  declaration.split(' ')[1]

const is_complete = (files: String[]) -> files.iter().all((file) -> is_file(file))

# Moves the compiled runtime into place, unless another build has moved its own there first,
# which is as good.
const move_into_place = (staging_dir: String, dir: String, files: String[]) ->
  try
    rename staging_dir, dir
  catch _
    remove_tree staging_dir
    if not is_complete(files)
      throw CompileError(message: "cannot move the compiled runtime into the cache: #{dir}")
