# The types written in a syntax tree that the checker may be able to infer, and how to take them out
# of it.
import
  Assignment, Binding, Call, Case, CaseArm, Cast, Condition, Declaration, EnumDeclaration,
  Expression, Extend, Extern, For, FunctionLiteral, Identifier, If, Import, InterfaceDeclaration,
  Member, MemberDeclaration, NamedType, operands_of, Parameter, Pass, Position, Statement, Try,
  TypeAlias, TypeDeclaration, TypeName, While
from '../ast'
import StyleRule from './rules'

# An expression written in place of what is left out, and the rule that it reports.
export struct Reported
  written: Expression
  rule: StyleRule

# What an annotation annotates, which the checking and the printer find it by, with where that is
# (see AnnotationKey): the return type of a function literal, the type of a parameter, a variable or
# a field, at its name; a member, a construction to write as a record, a named argument to write as
# its name alone, a redundant cast at its type, a test to write with is_empty(), a call of
# `contains`, two comparisons to write as a range test at the second, a range to write otherwise,
# arms to make one at the first pattern, a construction to write with a spread, or a name of an
# import, at the import.
export enum AnnotationKind
  RETURN
  PARAMETER
  VARIABLE
  FIELD
  MEMBER
  RECORD
  SHORTHAND
  CAST
  EMPTY
  IN
  BETWEEN
  RANGE
  ARMS
  SPREAD
  IMPORT

# The checking and the printer find an annotation in syntax trees parsed apart, by its kind and
# where it is, and, for a name of an import, by the name it gives.
export struct AnnotationKey
  kind: AnnotationKind
  at: Position
  name: String? = default nil

# A written type, the enum of a member, the name of a construction (see rewrites_of) or a
# name that an import gives, named by `key`, which `remove` takes out of the syntax tree and
# `restore` puts back.
export struct Annotation
  key: AnnotationKey
  remove: () -> void
  restore: () -> void
  target: AnnotationTarget
  # The expression written in place of what is left out, which reports the rule: what is left out
  # leaves no other trace for the printer to report it at.
  reported: Reported? = default nil

# What an annotation is written for, which tells whether the checking shows that it can be left out
# (see can_leave_out).
export type AnnotationTarget =
  ReturnType | ParameterType | DeclaredType | QualifiedMember | RecordConstruction
  ShorthandArgument | RedundantCast | EmptinessTest | MembershipCall | RangeTest | RangeEnds
  SharedArms | SpreadCopy | ImportedName

# The return type of a function, with its last value, which tell whether it can be inferred (see
# inferable).
export struct ReturnType
  function: FunctionLiteral
  value: Expression?

# The type of the parameter of the name, of the function.
export struct ParameterType
  name: Identifier
  function: FunctionLiteral

# The type of a variable or a field of the name, with its value.
export struct DeclaredType
  name: Identifier
  value: Expression
  # Whether the type of a variable moves to the type arguments of its Map() or Set(), which then
  # give the type.
  moves_to_type_arguments = default false

# A member, which tells whether it can be written alone.
export struct QualifiedMember
  member: Member

# A construction, which tells whether it can be written as a record.
export struct RecordConstruction
  call: Call

# The construction whose named argument may be written as its name alone, with the cast of the
# name that it leaves out, if any. The checking shows them.
export struct ShorthandArgument
  call: Call
  cast: Cast?

# A cast that may be left out, which the checking shows.
export struct RedundantCast
  cast: Cast

# The value whose test of length, or comparison with '', may be written as `is_empty()`, which
# its type shows.
export struct EmptinessTest
  value: Expression

# The call of `contains` that may be written with `in`, which gives a Bool (see Membership tests).
export struct MembershipCall
  call: Call

# The value that two comparisons test, which may be written `x in a..b` where its type compares by
# itself (see Range tests).
export struct RangeTest
  value: Expression

# A range that may be written otherwise (see Ranges): where its end `b + 1` is written `b`, that
# `b`, which must be an integer, as that of a range after `in` may not be.
export struct RangeEnds
  counted: Expression?

# The arms next to each other, of one body, that may be one arm (see Shared arm bodies), with the
# subject of their case, if it is a name, which the arms narrow.
export struct SharedArms
  arms: CaseArm[]
  subject: Identifier?

# The construction whose arguments copied from the fields of a value may be its spread, and that
# value (see Spreads), which the checking shows gives every argument and is of its type.
export struct SpreadCopy
  call: Call
  source: Expression

# The name that an import gives, which is left out once nothing uses it.
export struct ImportedName
  name: Identifier

# A written type, the enum of a member or the name of a construction, of the module of `key`.
export struct Placed
  key: String
  annotation: Annotation

# A name left out of an import, by the import and the name it gives (see import_names_of).
export import_key := (import_node: Import, name: String) ->
  AnnotationKey name, kind: IMPORT, at: import_node.position

# The annotations that may be left out, in the order of the source. Those in generic functions and
# types are not: the checker checks their code only for each instance, which tells nothing of the
# code no instance uses. Nor are the types of the parameters of top-level functions, methods and
# function values held by a `const` without a type, which no function type is expected for (see
# Parameter), but those with a default. This only spares checks that would fail: the checking
# decides which can be left out (see removable_annotations).
export annotations_of := (program: Statement[]) ->
  found: Annotation[]
  add_statements found, program
  found

add_statements := (found: Annotation[], statements: Statement[]) ->
  add_statement found, statement for statement in statements

add_statement := (found: Annotation[], statement: Statement): void ->
  case statement
    when Declaration
      found.push variable_annotation(statement) if statement.type != nil
      add_value found, statement.value, statement.type != nil
    when Assignment
      add_expression found, statement.target
      add_expression found, statement.value
    when While
      add_condition found, statement.condition
      add_statements found, statement.body
    when For
      add_expression found, statement.iterable
      add_statements found, statement.body
    when TypeDeclaration, Extend
      add_members found, statement.members if statement.type_params.is_empty()
    when Pass, EnumDeclaration, InterfaceDeclaration, TypeAlias, Extern, Import then pass
    else add_expression(found, statement)

# The fields with a value, and the methods, whose parameters no function type is expected for.
add_members := (found: Annotation[], members: MemberDeclaration[]) ->
  for member, i in members
    value := member.value ? continue
    if member.type != nil and value is not FunctionLiteral
      found.push field_annotation(members, i, value)
    add_value found, value, false

# A value where a type is `expected` or not, which tells whether a function literal there can leave
# out the types of its parameters.
add_value := (found: Annotation[], value: Expression, expected: Bool) ->
  if value is FunctionLiteral
    add_function found, value, expected
  else
    add_expression found, value

add_function := (found: Annotation[], literal: FunctionLiteral, expected: Bool) ->
  return unless literal.type_params.is_empty()
  for param, i in literal.params
    if param.type != nil and (expected or param.default != nil)
      found.push parameter_annotation(literal, i)
  found.push return_annotation(literal) if literal.return_type != nil
  add_expression found, value for value in default_values(literal.params)
  add_statements found, literal.body

default_values := (params: Parameter[]) ->
  values: Expression[]
  for param in params
    values.push value if value := param.default
  values

add_condition := (found: Annotation[], condition: Condition) ->
  case condition
    when Binding then add_expression(found, condition.value)
    else add_expression(found, condition)

add_expression := (found: Annotation[], expression: Expression): void ->
  case expression
    when FunctionLiteral then add_function(found, expression, true)
    when Case
      add_expression found, subject if subject := expression.subject
      for arm in expression.arms
        add_expression found, pattern for pattern in arm.patterns
        add_statements found, arm.body
      add_statements found, otherwise if otherwise := expression.otherwise
    when If
      add_condition found, expression.condition
      add_statements found, expression.then_body
      add_statements found, expression.else_body
    when Try
      add_statements found, expression.body
      add_statements found, catch_clause.body for catch_clause in expression.catches
      add_statements found, finally_body if finally_body := expression.finally_body
    else add_expression(found, operand) for operand in operands_of(expression)

return_annotation := (literal: FunctionLiteral) ->
  type := literal.return_type
  Annotation
    key: { kind: RETURN, at: literal.position }
    remove: -> literal.return_type = nil
    restore: -> literal.return_type = type
    target: ReturnType(function: literal, value: last_value(literal.body))

last_value := (body: Statement[]) ->
  last := body.last() ? return nil
  last as Expression?

# The parameter's type is put in a Parameter of the default it has then, which may be a member
# written alone (see rewrites_of).
parameter_annotation := (literal: FunctionLiteral, i: Int) ->
  { name, type } := literal.params[i]
  typed := (new_type: TypeName?) ->
    param := literal.params[i]
    literal.params[i] = { param..., type: new_type }
  Annotation
    key: { kind: PARAMETER, at: name.position }
    remove: -> typed(nil)
    restore: -> typed(type)
    target: ParameterType(name, function: literal)

# The type of `Map()` or `Set()` moves to its type arguments: `s := Set<String>()`.
variable_annotation := (declaration: Declaration) ->
  type := declaration.type
  collection := collection_call(declaration)
  remove := ->
    declaration.type = nil
    collection.call.type_args = collection.args if collection
  restore := ->
    declaration.type = type
    collection.call.type_args = [] if collection
  Annotation
    remove
    restore
    key: { kind: VARIABLE, at: declaration.name.position }
    target: DeclaredType(
      name: declaration.name
      value: declaration.value
      moves_to_type_arguments: collection != nil
    )

# A call of Map or Set without type arguments, with those of the type that the declaration writes.
collection_call := (declaration: Declaration) ->
  type := declaration.type as NamedType ? return nil
  call := declaration.value as Call ? return nil
  callee := call.callee as Identifier ? return nil
  is_collection := type.name == 'Map' or type.name == 'Set'
  matches := is_collection and callee.name == type.name and not type.optional
  matches and call.type_args.is_empty() then { call, args: type.args }

# The field's type is put in a MemberDeclaration of the value it has then, which may be a member
# written alone (see rewrites_of).
field_annotation := (members: MemberDeclaration[], i: Int, value: Expression) ->
  { name, type } := members[i]
  typed := (new_type: TypeName?) ->
    member := members[i]
    members[i] = { member..., type: new_type }
  Annotation
    key: { kind: FIELD, at: name.position }
    remove: -> typed(nil)
    restore: -> typed(type)
    target: DeclaredType(name, value)
