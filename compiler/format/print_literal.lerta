# The items of lists, and the literals that hold them: arrays, maps and records; and the values after
# `=`, `key:` and `return`, which may take the lines below (see Multi-line literals).
import
  ArrayLiteral, BooleanLiteral, Call, Case, Comprehension, Expression, FloatLiteral,
  FunctionLiteral, Identifier, If, Index, IntegerLiteral, is_spread, MapEntry, MapLiteral, Member,
  NamedValue, NilLiteral, Position, RecordLiteral, StringLiteral, Try
from '../ast'
import
  breaking, choice, closing, Doc, has_line_feed, indent, join, line_feed, rule, separated, text,
  token
from './doc'
import annotation_key from './annotated'
import function_block_doc from './print_block'
import columns from './source'
import type_arguments from './print_type'
import
  BRANCHES, EXPECTED_TYPES, INSIDE_BRACES, LINE_LENGTH, MULTI_LINE_LITERALS, SHORTHAND
from './rules'
import
  arguments, call_doc, clarified, comprehension_forms, expression_doc, takes_block_arguments
from './print_expression'
import bracketed, bracketed_or, Context, Item, lines_of_items, opened_list from './printing'

export item := (expression: Expression, context: Context) ->
  doc := expression_doc(expression, context)
  after_comment := context.source.comment_before(expression.position)
  opened := opened_doc(expression, context)
  as_block := expression is FunctionLiteral then function_block_doc(expression, context)
  Item doc, after_comment, opened, as_block, simple: is_simple(expression)

# A literal list broken after its opening bracket (see Item.opened).
opened_doc := (expression: Expression, context: Context): Doc? ->
  inside := context.inside_brackets()
  at := expression.position
  closing_of := (close: String) -> closing(close, closing_at(at, context))
  case expression
    when ArrayLiteral
      return nil if expression.elements.length == 0
      items := [item(element, inside) for element in expression.elements]
      opened_list token('[', at), items, closing_of(']')
    when MapLiteral
      items := [entry_item(entry, inside) for entry in expression.entries]
      opened_list token('{', at), items, closing_of('}')
    when RecordLiteral
      return nil if expression.fields.length == 0
      items := [field_item(field, inside) for field in expression.fields]
      opened_list token('{', at), items, closing_of('}')
    when Comprehension
      return nil if expression.spread or expression.lazy != nil
      comprehension_forms(expression, context).broken
    else nil

# The literal on one line, its items separated by commas.
flat_literal := (literal: Expression, context: Context) ->
  inside := context.inside_brackets()
  at := literal.position
  flat := (opening: Doc, items: Item[], close: String) ->
    closing_bracket := closing(close, closing_at(at, context))
    join [opening, separated([item.doc for item in items], text(', ')), closing_bracket]
  case literal
    when ArrayLiteral
      flat token('[', at), [item(element, inside) for element in literal.elements], ']'
    when MapLiteral
      flat token('{ ', at), [entry_item(entry, inside) for entry in literal.entries], ' }'
    when RecordLiteral
      flat
        record_opening(literal, '{ ', context)
        [field_item(field, inside) for field in literal.fields]
        ' }'
    else expression_doc(literal, context)

export named_item := (named: NamedValue, context: Context) ->
  name := token(named.name.name, named.name.position)
  doc := join([name, text(': '), expression_doc(named.value, context)])
  after_comment := context.source.comment_before(named.name.position)
  Item doc, after_comment, simple: is_simple(named.value)

# A name or a literal, which shares a line with others in a long list (see Long lists).
# A string longer than that may stand for a line of text, which is on a line of its own.
SHORT_STRING := 12

# A name or a short literal, which shares a line with others in a long list (see Long lists).
is_simple := (expression: Expression) ->
  case expression
    when Identifier, IntegerLiteral, FloatLiteral, BooleanLiteral, NilLiteral then true
    when StringLiteral then columns(expression.value) <= SHORT_STRING
    else false

# Where the bracket that closes the one at the position is in the source.
export closing_at := (open: Position, context: Context) ->
  source := context.source
  index := source.token_at(open) ? return nil
  # A literal written without brackets has none.
  kind := source.tokens[index].kind
  return nil if kind != '[' and kind != '{' and kind != '('
  closing := source.tokens[source.closing(index)]
  closing.position()

export array_doc := (array: ArrayLiteral, context: Context) ->
  items := [item(element, context.inside_brackets()) for element in array.elements]
  bracketed token('[', array.position), items, ']', closing_at(array.position, context)

export map_doc := (map: MapLiteral, context: Context) ->
  items := [entry_item(entry, context.inside_brackets()) for entry in map.entries]
  braced map.position, items, context, (spelling) -> token(spelling, map.position)

# A map's key that is a name is written in parentheses, as it would be a field's name otherwise.
entry_item := (entry: MapEntry, context: Context) ->
  key :=
    if entry.key is Identifier
      clarified entry.key, context
    else
      expression_doc entry.key, context
  doc := join([key, text(': '), expression_doc(entry.value, context)])
  after_comment := context.source.comment_before(entry.key.position)
  Item doc, after_comment, simple: is_simple(entry.key) and is_simple(entry.value)

export record_doc := (record: RecordLiteral, context: Context) ->
  items := [field_item(field, context.inside_brackets()) for field in record.fields]
  braced record.position, items, context, (spelling) -> record_opening(record, spelling, context)

# The opening brace of a record; that of a construction written as one (see qualified_members_of)
# reports it.
record_opening := (record: RecordLiteral, spelling: String, context: Context) ->
  brace := token(spelling, record.position)
  recorded := context.left_out.contains(annotation_key('record', record.position))
  recorded then rule(EXPECTED_TYPES, brace) else brace

# `{ x }` for `{ x: x }` (see Shorthand).
field_item := (field: NamedValue, context: Context) ->
  name := token(field.name.name, field.name.position)
  value := field.value
  if is_shorthand(field)
    commented := context.source.comment_before(field.name.position)
    return Item(doc: rule(SHORTHAND, name), simple: true, after_comment: commented)
  doc := join([name, text(': '), expression_doc(value, context)])
  after_comment := context.source.comment_before(field.name.position)
  Item doc, after_comment, simple: is_simple(value)

is_shorthand := (field: NamedValue) ->
  value := field.value
  value is Identifier and value.name == field.name.name

# Braces with spaces inside them on one line (see Inside `{}`), opened by `opening` of `{ ` or `{`.
braced := (open_at: Position, items: Item[], context: Context, opening: (String) -> Doc) ->
  close_at := closing_at(open_at, context)
  flat_items := separated([item.doc for item in items], text(', '))
  flat := rule(INSIDE_BRACES, join([opening('{ '), flat_items, closing(' }', close_at)]))
  closing_brace := closing('}', close_at)
  opened := opened_list(opening('{'), items, closing_brace)
  bracketed_or opening('{ '), items, closing_brace, opened, flat

# The value after `=`, `key:` or `return`, with the space before it. A literal of several items
# that does not fit on the line goes in a block below it without brackets (see Multi-line literals),
# and an `if`, a `case` or a `try` starts a line of its own (see Branches).
export value_after := (value: Expression, context: Context) ->
  on_line := join([text(' '), expression_doc(value, context)])
  return on_line if context.in_brackets
  case value
    when If, Case, Try
      if value is If and value.nil_safe
        on_line
      else
        rule BRANCHES, indent(join([line_feed(), expression_doc(value, context)]))
    when ArrayLiteral, RecordLiteral, MapLiteral
      if block := literal_block(value, context)
        # On the line only if all of it fits there, without a comment inside, nor a block that
        # ends its line.
        all_on_line := join([text(' '), flat_literal(value, context)])
        return block if has_line_feed(all_on_line)
        breaking MULTI_LINE_LITERALS, all_on_line, block
      else
        on_line
    when FunctionLiteral then on_line
    else
      if block := literal_block_with_members(value, context)
        return breaking(MULTI_LINE_LITERALS, on_line, block)
      # On the next line, deeper, if it fits there and not on this one; otherwise on this line, a
      # call with its arguments in a block below it if it can take them so.
      next_line := indent(join([line_feed(), expression_doc(value, context)]))
      in_block := value is Call and takes_block_arguments(value, context)
      broken :=
        in_block then join([text(' '), call_doc(value as Call!, context, true)]) else on_line
      breaking LINE_LENGTH, on_line, choice(next_line, broken)

# The items of a literal in an indented block, without brackets, if it can be written so: a block
# reads one element as the element itself, and takes no spread, nor a name alone for a field, which
# it would read as an element of an array.
literal_block := (literal: Expression, context: Context) ->
  items :=
    case literal
      when ArrayLiteral
        spreads := literal.elements.find_index(is_spread) != nil
        return nil if literal.elements.length < 2 or spreads
        [item(element, context) for element in literal.elements]
      when RecordLiteral
        return nil if literal.fields.any(is_shorthand)
        [field_item(field, context) for field in literal.fields]
      when MapLiteral then [entry_item(entry, context) for entry in literal.entries]
      else return nil
  return nil if items.length == 0
  indent join([line_feed(), lines_of_items(items)])

# A literal followed by members, as `.join('')`: the literal in a block, and the members on the
# line after it, where the value starts (see Multi-line literals).
literal_block_with_members := (value: Expression, context: Context) ->
  literal := literal_under_members(value) ? return nil
  block := literal_block(literal, context) ? return nil
  join [block, line_feed(), members_doc(value, literal, context)]

literal_under_members := (value: Expression): Expression? ->
  object :=
    case value
      when Member then value.object
      when Call then value.callee
      when Index then value.object
      else return nil
  return object if object is ArrayLiteral or object is RecordLiteral or object is MapLiteral
  literal_under_members object

# The members that follow the literal, without it.
members_doc := (value: Expression, literal: Expression, context: Context): Doc ->
  return text('') if value == literal
  case value
    when Member
      join [
        members_doc(value.object, literal, context)
        text('.')
        token(value.name.name, value.name.position)
      ]
    when Call
      open := join
        [members_doc(value.callee, literal, context), type_arguments(value.type_args), text('(')]
      bracketed open, arguments(value, context.inside_brackets()), ')', nil
    when Index
      index := expression_doc(value.index, context.inside_brackets())
      join [members_doc(value.object, literal, context), text('['), index, text(']')]
    else expression_doc(value, context)
