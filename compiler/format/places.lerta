# The places of the expressions of a syntax tree, where `lerta fmt` writes other expressions (see
# rewrites_of).
import
  ArrayLiteral, Assignment, Await, BinaryOperation, Binding, Call, Case, Cast, Coalesce,
  Comprehension, Condition, Conditional, Declaration, Expression, Extend, For, FunctionLiteral, If,
  Index, IsTest, MapLiteral, Member, Range, RecordLiteral, Return, Statement, Throw, Try, TupleItem,
  TupleLiteral, TypeDeclaration, UnaryOperation, Unwrap, While, Yield
from '../ast'
import is_taken_apart from './forms'

# What is done at an expression in its place, before its parts are visited; at the condition of an
# `if` or a `while` that binds no name, after it; and at each statement, after its parts, with the
# statement written after it in its block (see written_after).
struct Visit
  before: ((Expression) -> void)?
  condition: ((Expression) -> void)?
  statement: ((Statement, Statement?) -> void)?

  # Each list of statements, the program's and each body's, before its statements.
  statements: ((Statement[]) -> void)?

export places_of := (program: Statement[], visit: Visit) -> visit_statements(visit, program)

visit_place := (visit: Visit, value: Expression) ->
  before value if before := visit.before
  visit_expression visit, value

visit_places := (visit: Visit, values: Expression[]): void ->
  visit_place visit, value for value in values

visit_statements := (visit: Visit, statements: Statement[]): void ->
  at_statements statements if at_statements := visit.statements
  for statement at i in statements
    visit_statement visit, statement
    if at_statement := visit.statement
      at_statement statement, written_after(statements, i)

# The statement written after the one at `at`, past the declarations that take a destructuring
# apart, which have no tokens.
written_after := (statements: Statement[], at: Int) ->
  for next in (at + 1)..statements.length
    return statements[next] unless is_taken_apart(statements[next])
  nil

visit_statement := (visit: Visit, statement: Statement) ->
  case statement
    when Declaration then visit_place(visit, statement.value)
    when Assignment
      visit_expression visit, statement.target
      visit_place visit, statement.value
    when While
      visit_condition visit, statement.condition
      visit_statements visit, statement.body
    when For
      visit_place visit, statement.iterable
      visit_statements visit, statement.body
    when TypeDeclaration, Extend
      for member in statement.members
        visit_place visit, value if value := member.value
    when Expression then visit_place(visit, statement)
    else pass

visit_condition := (visit: Visit, condition: Condition) ->
  if condition is Binding
    visit_place visit, condition.value
  else
    visit_place visit, condition
    at_condition condition if at_condition := visit.condition

# The parts of an expression. The element and the guard of a comprehension are not places: its
# lazy functions share them (see Comprehension). Nor are the values of an interpolation, which is
# kept as written.
visit_expression := (visit: Visit, expression: Expression): void ->
  case expression
    when FunctionLiteral
      for param in expression.params
        visit_place visit, default if default := param.default
      visit_statements visit, expression.body
    when Throw then visit_place(visit, expression.message)
    when Yield then visit_place(visit, expression.value)
    when Await, Unwrap, UnaryOperation then visit_place(visit, expression.operand)
    when Coalesce
      visit_place visit, expression.value
      visit_place visit, expression.fallback
    when ArrayLiteral then visit_places(visit, expression.elements)
    when MapLiteral
      for entry in expression.entries
        visit_place visit, entry.key
        visit_place visit, entry.value
    when Comprehension
      visit_place visit, expression.iterable
      visit_expression visit, guard if guard := expression.guard
      visit_statements visit, expression.body
      visit_expression visit, expression.element
    when RecordLiteral
      visit_place visit, field.value for field in expression.fields
    when TupleLiteral then visit_places(visit, expression.items)
    when TupleItem then visit_expression(visit, expression.tuple)
    when Index
      visit_place visit, expression.object
      visit_place visit, expression.index
      visit_place visit, default_value if default_value := expression.default_value
    when Call
      visit_expression visit, expression.callee
      visit_places visit, expression.args
      visit_place visit, arg.value for arg in expression.named_args
    when Member then visit_place(visit, expression.object)
    when BinaryOperation
      visit_place visit, expression.left
      visit_place visit, expression.right
    when Range
      visit_place visit, start if start := expression.start
      visit_place visit, end if end := expression.end
      visit_place visit, step if step := expression.step
    when IsTest then visit_expression(visit, expression.value)
    when Cast then visit_place(visit, expression.value)
    when Conditional
      visit_place visit, expression.condition
      visit_place visit, expression.then_value
      visit_place visit, expression.else_value
    when Case
      visit_place visit, subject if subject := expression.subject
      for arm in expression.arms
        visit_places visit, arm.patterns
        visit_statements visit, arm.body
      visit_statements visit, otherwise if otherwise := expression.otherwise
    when If
      visit_condition visit, expression.condition
      visit_statements visit, expression.then_body
      visit_statements visit, expression.else_body
    when Return
      visit_place visit, value if value := expression.value
    when Try
      visit_statements visit, expression.body
      visit_statements visit, catch_clause.body for catch_clause in expression.catches
      visit_statements visit, finally_body if finally_body := expression.finally_body
    else pass
