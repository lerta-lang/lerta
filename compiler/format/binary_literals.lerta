# The bytes of string literals, `'...'.binary`, written as Binary literals, `b'...'` (see Binary
# literals in docs/reference/style.md).
import Expression, Interpolation, Member, Statement, StringLiteral from '../ast'
import TextPart from '../lexer/string_literal'
import places_of from './places'
import BINARY_LITERALS, StyleRule from './rules'
import SourceText from './source'

# Writes each, but those on the lines kept as written, as a Binary literal in the syntax tree, and
# reports it.
export write_binary_literals := (
  program: Statement[], reported: Map<Expression, StyleRule>, source: SourceText,
  kept_lines: Set<Int>
) ->
  after := (written: Expression, place: (Expression) -> void) ->
    return if written.position.line in kept_lines
    literal := binary_literal_of(written, source) ? return
    place literal
    reported[literal] = BINARY_LITERALS
  places_of program, { after }

# The Binary literal that the member is the bytes of, if it is `.binary` of a string literal on one
# line, as a Binary literal is. A literal in parentheses takes the position of its `(`.
binary_literal_of := (member: Expression, source: SourceText) ->
  return nil if not (member is Member and member.name.name == 'binary')
  object := member.object
  var index = source.token_at(object.position) ? return nil
  index += 1 while source.tokens[index].kind == '('
  literal := source.tokens[index]
  return nil if literal.end_line > literal.line
  case object
    when StringLiteral
      Interpolation position: object.position, parts: [TextPart(object.value.binary)], binary: true
    when Interpolation then object.binary then nil else Interpolation(object..., binary: true)
    else nil
