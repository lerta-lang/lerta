# The first pass of the formatter: walks the syntax tree over the code tokens, in the order of the
# source, and decides each gap between two code tokens that it walks: the spaces inside a statement
# (docs/reference/style.md#spacing), and the line starts of statements. A statement that holds a
# construct it does not walk yet is skipped, and its gaps keep their source text, as do those of a
# statement that the comments mark to keep as it is written (see kept.lerta). It records the
# constructs of the statements that it walks that may break a line (see shapes.lerta), whose gaps
# it decides flat, for lines.lerta to break. Its methods for each construct are in
# walk_statements.lerta, walk_expressions.lerta and walk_lists.lerta.
import BinaryOperation, Call, Statement from '../ast'
import Token, TokenKind from '../lexer/tokens'
import INSIDE_BRACES, SPACING from './rules'
import KeptLines from './kept'
import BlockShape, Closer, CodeGap, LineStart, Shape, Spaces, StatementShape from './shapes'
import SourceTokens, TextToken from './text'
import './walk_statements'

export NONE := Spaces(count: 0, rule: SPACING)
export ONE := Spaces(count: 1, rule: SPACING)
export INSIDE := Spaces(count: 1, rule: INSIDE_BRACES)

# The gaps that the walk decides, each by the index of the code token after it, and the comments
# that end a line where the formatter cannot place them, which it reports, keeping their statements
# as they are written (docs/reference/style.md#comments): by the index of the code token before
# them; the code tokens of the statements that it skips; the statements that it walks, with the
# tokens that close their bodies; and the items of lists that a line end separates from the item
# before them, rather than a comma, which they would take on one line; and the statements on lines
# of their own that it walks, at every depth.
export struct Walked
  gaps: Map<Int, CodeGap>
  stranded: Int[]
  skipped: Set<Int>
  block: BlockShape
  closers: Map<Int, Closer>
  without_commas: Set<Int>
  statements: StatementShape[]
  line_statements: Set<Int>

export walk := (
  statements: Statement[], text: SourceTokens, kept: KeptLines, results: Set<Call>, checked: Bool
) ->
  { code, line_starts, ending_comments, own_line_comments } := text
  walker :=
    Walker(text, code, line_starts, ending_comments, own_line_comments, kept, results, checked)
  block := walker.block(statements, 0, nil)
  walker.resume_at walker.code.length
  { gaps, stranded, skipped, closers, without_commas, line_statements } := walker
  Walked(
    gaps
    stranded
    skipped
    block
    closers
    without_commas
    line_statements
    statements: walker.walked
  )

# A construct that the walk does not handle yet, whose statement it skips.
export struct Unhandled: Error

export unhandled := -> throw Unhandled('not walked yet')

# The tokens of a binary operation: where it starts, at the parentheses around it, its operator,
# its right operand, and where that ends, before the parentheses that close around it.
struct OperationTokens
  first: Int
  operator: Int
  right: Int
  end: Int

export class Walker
  args
    # The source, which says where its statements start.
    text: SourceTokens
    code: Token[]

    # Those of the code tokens where a statement may start.
    line_starts: Set<Int>

    ending_comments: Map<Int, TextToken>

    # The columns of the comments on lines of their own before code tokens (see SourceTokens).
    own_line_comments: Map<Int, Int[]>

    kept: KeptLines

    # The calls whose values are results, which keep their parentheses (see result_calls); where
    # the program does not check, those that may be, which keep them as written (see
    # possible_result_calls).
    results: Set<Call>

    # Whether the program checks, so that its results are known.
    checked: Bool
  var stranded: Int[] = []
  private skipped := Set<Int>()

  # The gaps of the statement being walked, which those of the block that holds it take once it is
  # walked through.
  var gaps: Map<Int, CodeGap> = Map()

  starts := @text.starts
  var at = 0

  # The parentheses around an expression, which the syntax tree leaves out, that its chain has
  # opened and not closed yet (see chain).
  var open_groups = 0

  # The depth of the statement being walked.
  var depth = 0

  # Where the statements that the walk skips start, up to the next statement that it resumes at.
  var skipped_from: Int?

  # The shapes of the construct being walked, and the statements of the block being walked, with
  # where each starts (see BlockShape).
  var shapes: Shape[] = []
  var block_starts: Int[] = []
  var block_statements: StatementShape[] = []

  # The statements on lines of their own walked, at every depth.
  walked: StatementShape[] = []

  # Whether the expression being walked is a whole value, whose operations may break (see Long
  # operations); whether it is inside brackets; and whether it is on a line of its own, rather than
  # on that of `->` or `then`.
  var breaks_operations = true
  var in_brackets = false
  var on_own_line = true

  # The first tokens of the `if` statements alone in the blocks of `else`.
  alone_in_else := Set<Int>()

  # The heads of the bodies just walked, whose closer the next token of their statement is, and
  # whether one of them is a block (see Closer).
  var closing: Int[] = []
  var closing_block = false

  private closers := Map<Int, Closer>()
  without_commas := Set<Int>()

  # The first tokens of the statements and the members of types walked on lines of their own.
  line_statements := Set<Int>()

  # The tokens of each binary operation walked, and where the expression being walked starts.
  operations := Map<BinaryOperation, OperationTokens>()
  var node_start = 0

  # The `.`s of the chain of members being walked, if one is, which its outermost link gathers (see
  # ChainShape).
  var chain_dots: Int[]?

  # Whether that chain has a `?.`, which a member line would change, or a `.` inside parentheses.
  var chain_nil_safe = false
  var chain_in_group = false

  # Whether the expression whose parentheses at its start the walk is in is a whole value.
  var node_breaks = true

  save := ->
    WalkState(
      shapes: @shapes
      closing: @closing
      closing_block: @closing_block
      breaks_operations: @breaks_operations
      in_brackets: @in_brackets
      on_own_line: @on_own_line
    )

  restore := (state: WalkState) ->
    @shapes = state.shapes
    @closing = state.closing
    @closing_block = state.closing_block
    @breaks_operations = state.breaks_operations
    @in_brackets = state.in_brackets
    @on_own_line = state.on_own_line

  skip := (start: Int) ->
    earliest := min(@skipped_from else start, start)
    @skipped_from = earliest

  # Ends the skipping at the code token at `index`.
  resume_at := (index: Int) ->
    from := @skipped_from else return
    return if index < @at
    @skipped.add skipped for skipped in from..index
    @at = index
    @skipped_from = nil

  # Whether a comment follows the code token: one that ends its line, or one on a line of its own
  # before the next.
  comment_follows := (at: Int) -> at in @ending_comments or at + 1 in @own_line_comments

  # Whether a comment ends a line from the token at `first`, the head of a block, up to `end`, after
  # the block, or is on a line of its own among them, indented deeper than the head's line.
  has_comments := (first: Int, end: Int) ->
    for at in first..end
      return true if at in @ending_comments or (at > first and at in @own_line_comments)
    (@own_line_comments[end] else []).any((column) -> column > @indentation_of(first))

  # The column of the first code token on the line of the one at `index`.
  indentation_of := (index: Int) ->
    var at = index
    at -= 1 while at > 0 and at not in @line_starts
    @code[at].column

  # A token that an operand follows, which a comment after it would leave at the start of a line.
  take_before_operand := (kind: TokenKind, before: CodeGap) ->
    index := @take(kind, before)
    if index in @ending_comments
      @stranded.push index
      unhandled()
    index

  take := (kind: TokenKind, before: CodeGap) -> @take_if((token) -> token.kind == kind, before)

  take_spelled := (spelling: String, before: CodeGap) ->
    @take_if((token) -> spelling_of(token) == spelling, before)

  # The index of the next code token, which must be as `expected`, consumed, with the gap before it.
  private take_if := (expected: (Token) -> Bool, before: CodeGap) ->
    unhandled() if @skipped_from != nil or @at == @code.length or not expected(@code[@at])
    @gaps[@at] = @closing_gap(before)
    @at += 1
    @at - 1

  # The next token closes the bodies at `head` (see Closer).
  close := (head: Int, block: Bool) ->
    @closing = [@closing..., head]
    @closing_block = @closing_block or block

  # The gap before the next token, which starts a line if it closes a block.
  private closing_gap := (before: CodeGap) ->
    return before if @closing.is_empty()
    for head in @closing
      @closers[head] = { at: @at, flat: before }
    gap := @closing_block then LineStart(@depth) else before
    @closing = []
    @closing_block = false
    gap

  at_kind := (kind: TokenKind) -> @kind_at(@at) == kind

  kind_at := (index: Int) -> index < @code.length then @code[index].kind

# What a statement's walk sets aside while it walks one inside it.
struct WalkState
  shapes: Shape[]
  closing: Int[]
  closing_block: Bool
  breaks_operations: Bool
  in_brackets: Bool
  on_own_line: Bool

# A word, as `in`, is an identifier.
export spelling_of := (token: Token) ->
  token.kind == IDENTIFIER then token.text else token.kind.to_string()
