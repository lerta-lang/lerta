# The `\u{...}` and `\xHH` escapes of ASCII characters in a literal written as the characters, if
# visible, or as their short escapes or `\xHH` (see Escapes in docs/reference/style.md).
import find_interpolation_end, parse_byte, parse_char from '../lexer/string_literal'
import SourceLine from '../lexer/source_line'

# The spelling of a literal with escapes, `"..."` or `b"..."`, or a line of a `"""` literal, so
# written; the code of its interpolations stays as it is.
export with_ascii_escapes := (written: String) ->
  line := SourceLine(path: '', bytes: written.binary, number: 0, column_offset: 0)
  var escaped = ''
  var plain = 0
  var i = 0
  while i < line.length
    case
      when line.bytes[i] == b'\'
        if ascii := ascii_escape(line, i)
          escaped += line.text(plain, i) + ascii.text
          plain = ascii.end
          i = ascii.end
        else
          i += 2
      when line.bytes.occurs_at(i, b'#{') then i = find_interpolation_end(line, i + 2)! + 1
      else i += 1
  escaped + line.text(plain, line.length)

# The `\u{...}` or `\xHH` escape at `start` as Escapes writes it, and the index after it, if it is
# one of an ASCII character.
ascii_escape := (line: SourceLine, start: Int) ->
  escape := escaped_code(line, start) ? return nil
  code := escape.code
  return nil if code > 0x7F
  text := plain_char(code) ? short_escape(code) ? "\\x#{code.to_hex(2).to_upper()}"
  { text, end: escape.end }

# The code that the `\u{...}` or `\xHH` escape at `start` writes, and the index after it.
escaped_code := (line: SourceLine, start: Int) ->
  if line.bytes.occurs_at(start + 1, b'u{')
    close := line.index_of(b'}', start + 3)!
    return { code: parse_char(line.bytes[(start + 3)..close])!.to_int(), end: close + 1 }
  return nil if line.bytes.get(start + 1) != b'x'
  { code: parse_byte(line.bytes[(start + 2)..(start + 4)])!.to_int(), end: start + 4 }

# A visible character, as itself, unless the literal would read it otherwise. A space stays an
# escape, which shows it, and keeps it out of the indentation of the lines of a `"""` literal.
plain_char := (code: Int) ->
  is_visible := code in 0x21..=0x7E
  char := code.to_char()!
  is_visible and char not in ['"', '\', '#'] then char.to_string()

short_escape := (code: Int) ->
  case code
    when 0x0A then '\n'
    when 0x09 then '\t'
    when 0x0D then '\r'
    when 0x00 then '\0'
    when 0x22 then '\"'
    when 0x5C then '\\'
    when 0x23 then '\#'
    else nil
