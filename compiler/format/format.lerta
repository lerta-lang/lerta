# `lerta fmt`: prints each file again in the style (docs/reference/style.md), and reports where the
# file differs from that, by the rule that decides it there, or writes it with `--fix`.
import Expression, Import, Position, Statement from '../ast'
import dump_ast_without_positions from '../ast_dump'
import CompileError from '../errors'
import lex, Lexed from '../lexer/tokens'
import parse from '../parser/statement'
import Annotation, AnnotationKey, SharedArms from './annotated'
import left_out_candidates from './annotations'
import Hunk, hunks, kept_lines from './diff'
import join, lay_out, Layout, line_feed, RulePlace, text, WIDTH from './doc'
import StatementLines from './kept'
import rewrite_negated_conditions from './negated_conditions'
import write_binary_literals from './binary_literals'
import block_doc, is_left_out_import, left_out_import_mark from './print_statement'
import Context from './printing'
import
  BLANK_LINES, COMMENTS, LAYOUT, LINE_LENGTH, SEMICOLONS, SPACING, STRANDED_COMMENTS, StyleRule,
  UNBREAKABLE_LINES
from './rules'
import columns, source_text, SourceText from './source'

# A place where the source differs from the style, at its position in the source.
export struct Finding
  at: Position
  rule: StyleRule

export struct Formatted
  text: String
  findings: Finding[]

# The source in the style, without the annotations of `left_out` (see AnnotationKey), and
# where it differs from it. Throws a CompileError if the source does not parse, or if the text in
# the style would not parse to the same program, which would be a bug.
export format_source := (source: String, path: String, left_out: AnnotationKey[]) ->
  return Formatted(text: source, findings: []) if is_off_throughout(source)
  lexed := lex(source, path)
  text_source := source_text(source, lexed)
  first := printed(lexed, text_source, path, left_out, Set())
  # Which statements are kept as written shows once they are printed, and their annotations stay.
  kept_lines := first.lines.kept
  result :=
    if kept_lines.is_empty()
      first
    else
      printed lexed, text_source, path, outside(left_out, kept_lines, text_source), kept_lines
  check_same_program result.statements, result.layout.text, path
  found := findings(text_source, result.layout.text, result.layout.rules, kept_lines)
  in_order := found.sorted((a, b) -> a.at.compare(b.at))
  Formatted text: result.layout.text, findings: in_order

# Whether `# fmt: off` comes before the code, and no `# fmt: on` after it: the file is kept as it is
# written without being parsed, as one that does not parse may be. The lines are read as text, as
# such a file may not even lex: a line that ends with `# fmt: on` counts as one, which a comment or
# a string that merely ends so takes for it too, and the file is then parsed.
is_off_throughout := (source: String) ->
  lines := [line.trim() for line in source.split("\n")]
  is_code := (line: String) -> not line.is_empty() and not line.starts_with('#')
  code_start := lines.find_index(is_code) ? lines.length
  off := lines.index_of('# fmt: off') ? return false
  after := lines[(off + 1)..]
  off < code_start and not after.any((line) -> line.ends_with('# fmt: on'))

# The statements printed, those of them that are not left out, and the lines of those printed on
# lines of their own.
struct Printed
  statements: Statement[]
  layout: Layout
  lines: StatementLines

# The conditions on `kept_lines` keep their double negations, as the lines are written.
printed := (
  lexed: Lexed, source: SourceText, path: String, left_out: AnnotationKey[], kept_lines: Set<Int>
) ->
  statements := parse(lexed.tokens, path)
  reported: Map<Expression, StyleRule>
  rewrite_negated_conditions statements, reported, kept_lines
  write_binary_literals statements, reported, source, kept_lines
  for annotation in left_out_candidates(statements)
    continue if annotation.key not in left_out or holds_comments(annotation, source)
    annotation.remove()
    reported[found.written] = found.rule if found := annotation.reported
  lines := StatementLines()
  context := Context(left_out, source, lines, reported)
  body := block_doc(statements, context)
  ending := left_out_ending(statements, context)
  doc := statements.is_empty() then text('') else join([body, line_feed(), ending])
  kept := [statement for statement in statements when not is_left_out_import(statement, context)]
  Printed lines, statements: kept, layout: lay_out(doc, source)

# Whether a comment is among the arms that would be one, from the line of the `when` of the first
# up to what follows the last: one in the arms left out, after its last statement too, has no place
# in the arm kept, and one in the first, as one that ends its line, would be printed before the
# patterns that the others give it, which come after it in the source (see Shared arm bodies).
holds_comments := (annotation: Annotation, source: SourceText) ->
  shared := annotation.target as SharedArms ? return false
  run := shared.arms
  first_line := source.line_before(run[0].patterns[0].position)
  body_end := source.statement_last_line(run.last()!.body.last()!.position, nil)
  source.has_comment first_line, source.line_before_next(body_end)

# The annotations of `left_out` that are not on the lines kept as written, but for the names of
# imports that those lines use.
outside := (left_out: AnnotationKey[], kept_lines: Set<Int>, source: SourceText) ->
  used: Set<String>
  for token in source.tokens
    used.add source.spelling(token) if token.kind == IDENTIFIER and token.line in kept_lines
  leaves_out := (key: AnnotationKey) ->
    name := key.name
    key.at.line not in kept_lines and not (name != nil and name in used)
  [key for key in left_out when leaves_out(key)]

# The imports left out last are reported where they were (see left_out_import_mark).
left_out_ending := (statements: Statement[], context: Context) ->
  var first = statements.length
  first -= 1 while first > 0 and is_left_out_import(statements[first - 1], context)
  join [left_out_import_mark(statements[i] as Import!) for i in first..statements.length]

# Text that does not parse is the formatter's bug too, whose places in it would mislead about the
# source.
check_same_program := (statements: Statement[], formatted: String, path: String) ->
  reparsed :=
    try
      parse lex(formatted, path).tokens, path
    catch _: CompileError
      throw CompileError(
        "#{path}: the formatter would write a program that does not parse, which is a bug"
      )
  if dump_ast_without_positions(reparsed) != dump_ast_without_positions(statements)
    throw CompileError("#{path}: the formatter would change the program, which is a bug")

# Where the formatted text differs from the source: at the first difference of each run of lines
# that differ (see difference_finding), at the ends of lines that are not LF (see
# line_end_findings), at the lines that it keeps but that are too long (see
# long_line_findings), and at the comments that strand an operand.
findings := (source: SourceText, formatted: String, rules: RulePlace[], kept_lines: Set<Int>) ->
  # A copy, as a last line without LF gets an empty one after it, and the lines are compared
  # without it.
  old := [source.lines...]
  new := formatted.split("\n")
  result := line_end_findings(source)
  old.push '' unless old.last()!.is_empty()
  differing: Set<Int>
  for hunk in hunks(old, new)
    old_end := hunk.old_start + hunk.old_count
    differing.add line for line in hunk.old_start..old_end
    # A `;` that the lines hold is what they differ by first, as it breaks them up.
    held: Finding[]
    for line in hunk.old_start..old_end
      held.push { rule: SEMICOLONS, at } if at := source.separators[line + 1]
    if held.is_empty()
      for place in places_of(old, new, hunk)
        result.push difference_finding(old, new, place, rules, source)
    else
      result.append held
  stranded: Finding[] = [
    { rule: STRANDED_COMMENTS, at: { line: comment.line, column: comment.column } }
    for comment in source.stranded
  ]
  [result..., long_line_findings(old, differing, kept_lines)..., stranded...]

# Lines end with LF, and so does a file (see Layout): the first that ends with CRLF, and a last
# line without LF, are places of their own.
line_end_findings := (source: SourceText) ->
  lines := source.lines
  found: Finding[]
  if crlf := source.raw_lines.find_index((line) -> line.ends_with("\r"))
    found.push { rule: LAYOUT, at: { line: crlf + 1, column: columns(lines[crlf]) + 1 } }
  last := lines.last()!
  unless last.is_empty()
    found.push { rule: LAYOUT, at: { line: lines.length, column: columns(last) + 1 } }
  found

# The places of the hunk: where as many lines differ in each, and none has moved, each pair of
# lines is a place of its own.
places_of := (old: String[], new: String[], hunk: Hunk) ->
  paired := hunk.old_count == hunk.new_count and not moves(old, new, hunk)
  return [hunk] unless paired
  [
    Hunk(old_start: hunk.old_start + i, old_count: 1, new_start: hunk.new_start + i, new_count: 1)
    for i in 0..hunk.old_count
  ]

# The first difference of the place, with the innermost rule whose part holds that place in the
# formatted text, or else the rule that the kind of difference points to.
difference_finding := (
  old: String[], new: String[], place: Hunk, rules: RulePlace[], source: SourceText
): Finding ->
  old_lines := old[place.old_start..(place.old_start + place.old_count)]
  new_lines := new[place.new_start..(place.new_start + place.new_count)]
  new_line := new_lines.first() ? ''
  column := first_difference(old_lines.first() ? '', new_line)
  at := Position(column, line: place.old_start + 1)
  in_new := Position(column, line: place.new_start + 1)
  marks_from := Position(column: column - spaces_before(new_line, column), line: in_new.line)
  rule :=
    if only_blank_lines_differ(old_lines, new_lines)
      BLANK_LINES
    else if only_indentation_differs(old_lines, new_lines)
      LAYOUT
    else
      # A line whose spaces alone differ, those within it among them, holds that difference, which
      # a part on a later line is apart from; one whose other text differs may be joined or split
      # by such a part, and one whose indentation alone differs may be of a block that it holds.
      old_line := old_lines.first() ? ''
      spaced_within := old_line.trim_start() != new_line.trim_start()
      spaced_only := spaced_within and without_spaces(old_line) == without_spaces(new_line)
      last_line := in_new.line + (spaced_only then 1 else place.new_count)
      inner := innermost_rule(rules, in_new, marks_from)
      found := inner then inner else first_rule_from(rules, in_new, last_line)
      differing := (lines: String[]) -> spaced_only then lines[..1] else lines
      found ? kind_of_difference(differing(old_lines), differing(new_lines), source, at.line)
  # Lines that the formatter joins into one still too long are to be shortened by hand.
  joined := place.old_count > place.new_count
  still_long := rule == LINE_LENGTH and joined and columns(new_line) > WIDTH
  { at, rule: still_long then UNBREAKABLE_LINES else rule }

# The lines that the formatter keeps but that are too long, such as of a comment or a string, which
# it cannot break, but those kept as written.
long_line_findings := (old: String[], differing: Set<Int>, kept_lines: Set<Int>) ->
  found: Finding[]
  for line, i in old
    too_long := columns(line) > WIDTH and i not in differing and i + 1 not in kept_lines
    found.push { rule: UNBREAKABLE_LINES, at: { line: i + 1, column: WIDTH + 1 } } if too_long
  found

# Whether a line of the hunk, but for its indentation, is at another line of it in the other text,
# as the lines below a line that a body joins are, which shift up by one.
moves := (old: String[], new: String[], hunk: Hunk) ->
  old_lines := unindented(old[hunk.old_start..(hunk.old_start + hunk.old_count)])
  new_lines := unindented(new[hunk.new_start..(hunk.new_start + hunk.new_count)])
  kept := kept_lines(old_lines, new_lines)
  moved := [old_index for (old_index, new_index) in kept when old_index != new_index]
  not moved.is_empty()

# The column where the lines first differ, counted in code points from 1.
first_difference := (old: String, new: String) ->
  old_points := [point for point in old]
  new_points := [point for point in new]
  var i = 0
  i += 1 while i < old_points.length and i < new_points.length and old_points[i] == new_points[i]
  i + 1

# A part that holds no text, which marks where text was left out, holds its place, and the
# place after the spaces that the formatted line puts after it, such as those before a comment:
# the source has spaces there too, so the lines first differ after them.
innermost_rule := (rules: RulePlace[], at: Position, marks_from: Position) ->
  holds := (place: RulePlace) ->
    marks := place.start == place.end and marks_from <= place.start and place.start <= at
    marks or (place.start <= at and at < place.end)
  [place for place in rules when holds(place)].max_by((place) -> place.start)?.rule

# The rule of the first part that starts from the position up to the line, as one that the
# difference begins just before.
first_rule_from := (rules: RulePlace[], at: Position, last_line: Int) ->
  within := [place for place in rules when at <= place.start and place.start.line < last_line]
  within.min_by((place) -> place.start)?.rule

# The spaces just before the column, counted in code points from 1.
spaces_before := (line: String, column: Int) ->
  points := [point for point in line]
  var count = 0
  count += 1 while count < column - 1 and points[column - 2 - count] == ' '
  count

only_blank_lines_differ := (old: String[], new: String[]) ->
  not_blank := (lines: String[]) -> [line for line in lines when without_spaces(line) != '']
  not_blank(old) == not_blank(new)

only_indentation_differs := (old: String[], new: String[]) -> unindented(old) == unindented(new)

unindented := (lines: String[]) -> [line.trim_start() for line in lines]

# The spaces before a comment, spaces within the lines, or else the layout of the lines.
# `old` starts at the line `line` of the source.
kind_of_difference := (old: String[], new: String[], source: SourceText, line: Int) ->
  squeezed := (lines: String[]) -> without_spaces(lines.join(''))
  return LAYOUT if squeezed(old) != squeezed(new) or old.length != new.length
  # The place is at the first difference, which lies in the indentation.
  return LAYOUT if indentation(old[0]) != indentation(new[0])
  return SPACING if old.length != 1
  ending := source.comments.find((c) -> c.line == line and not c.own_line)
  comment := ending ? return SPACING
  # Where only the spaces before a comment that ends the line differ.
  text := source.comment_text(comment)
  code := (written: String) -> (written.without_suffix(text) ? written).trim_end()
  code(old[0]) == code(new[0]) then COMMENTS else SPACING

without_spaces := (text: String) -> text.replace(' ', '')

indentation := (line: String) -> columns(line) - columns(line.trim_start())
