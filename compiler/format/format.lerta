# `lerta fmt`, the formatter: rewrites the tokens of the source that the style writes otherwise
# (see rewrites.lerta), decides each gap between the text tokens of the source (see text.lerta),
# reports where the source differs from that by the rule of the rewrite or the decision, and writes
# the tokens with the gaps decided.
import scan from 'std:scanner'
import Position, Statement from '../ast'
import dump_ast_without_positions from '../dumps'
import CompileError from '../errors'
import lex, Lexed from '../lexer/tokens'
import parse from '../parser/statement'
import
  APPENDS, BINARY_LITERALS, BLANK_LINES, BYTE_LITERALS, CHAINED_VALUES, CHAR_CONCATENATIONS,
  COMMENT_BLANK_LINES, COMPREHENSION_FORMS, EMPTINESS_TESTS, MEMBERSHIP_TESTS, COMMENTS,
  DEFAULT_COMPARISONS, DEFAULT_SEPARATORS, DESTRUCTURED_VALUES, DOUBLE_NEGATIONS, ELSE_NIL,
  EMPTY_INITIAL_VALUES, EXPECTED_TYPES, FOUND_TESTS, ITERABLE_ARGUMENTS, LAST_ITEMS, LAYOUT,
  LONG_TWO_WAY_VALUES, MEMBERSHIP_LISTS, NIL_FIELDS, RANGE_ENDS, REDUNDANT_CASTS, RETURNED_BRANCHES,
  SEMICOLONS, SHORT_COMPREHENSIONS, SHORTHAND_ARGUMENTS, SINGLE_ARM_CASES, SORT_KEYS,
  STRANDED_COMMENTS, StyleRule, TWO_WAY_VALUES, TYPE_ANNOTATIONS, UNBREAKABLE_LINES, UNION_CASES,
  UNION_IS_TESTS, UNUSED_IMPORTS, VALUE_DOUBLE_NEGATIONS, VALUES_ALONE
from './rules'
import common_indentation, is_blank from '../lexer/string_literal'
import applicable, applied, Edit from './edits'
import is_off_throughout, kept_lines from './kept'
import break_lines, WIDTH from './lines'
import rewrites_of from './rewrites'
import CodeGap, LineStart, Spaces, StatementShape from './shapes'
import Gap, literal_lines, source_tokens, SourceTokens, TextToken from './text'
import Tokens from './tokens'
import declared_types from './annotations'
import possible_result_calls, result_calls, typed_program, Typed from './typed'
import walk, Walked from './walk'

# A place where the source differs from the style, at its position in the source.
export struct Finding
  at: Position
  rule: StyleRule

export struct Formatted
  text: String
  findings: Finding[]

# A program that the formatter would change, which is a fault of the formatter.
export struct ChangedProgram: Error
  message: String

# The text of a gap, and the rule that decides it.
struct Decision
  text: String
  rule: StyleRule

# The source lexed and parsed, and its text tokens.
export struct Parsed
  source: String
  lexed: Lexed
  statements: Statement[]
  text: SourceTokens

  # The tree as parsed, which the formatter compares. It is dumped before the statements are
  # checked, as the checker changes them: it gives an init the result void.
  tree: String

# The source laid out, what differs from it, but the stranded comments, the edits of the rewrites
# that its lines ask for, and the statements walked.
struct LaidOut
  text: String
  findings: Finding[]
  stranded: Finding[]
  edits: Edit[]
  statements: StatementShape[]
  skipped: Set<Int>

  # The lines kept as they are written, or marked so (see KeptLines).
  kept: Set<Int>

# Throws a CompileError if the source does not parse. The layout of a statement that holds a
# rewrite is reported once the rewrite is applied, as the rewrite may change it.
export format_source := (source: String, path: String) ->
  if is_off_throughout(source)
    return Formatted(text: source, findings: [])
  parsed := parsed_source(source, path)
  await format_parsed(parsed, path, await typed_program(path, source, parsed.statements))

# That of the source parsed, not off throughout, with its program checked (see typed_programs).
export format_parsed := (parsed: Parsed, path: String, typed: Typed?) ->
  { source } := parsed
  first := rewrites_with(parsed, typed)
  laid := laid_out(parsed, typed)

  # The types left out must keep the types of the program, or they all stay (see rewritten_text).
  with_types := await rewritten_text(parsed, laid, first, path, true)
  text := with_types else (await rewritten_text(parsed, laid, first, path, false))!
  kept_types := text.annotations_kept

  first_rewrites := [
    for edit in first.edits when not kept_types or edit.rule != TYPE_ANNOTATIONS
      edit
  ]
  edits := first_rewrites + laid.edits
  held := held_statements(parsed.text, laid, edits)
  is_held := (at: Position) -> held.any((head) -> head.holds(at))
  layout := [finding for finding in laid.findings when not is_held(finding.at)]
  rewritten := [
    for edit in edits
      Finding(at: edit.at, rule: edit.rule)
  ]

  # A `;` that a rewrite takes out is a gap that the layout decides too.
  # A line that a rewrite left to be done by hand may shorten is reported for that alone.
  by_hand := Set([edit.at.line for edit in edits when edit.change == nil])
  long := long_lines(source, text.text, laid.kept | by_hand)
  found := distinct(rewritten + layout + laid.stranded + long)
  sorted := found.sorted_by(Finding.at)
  Formatted(text: text.text, findings: sorted)

# The lines of the source that the formatted text holds, but for their indentation and the spaces
# that end them, over WIDTH columns there: of a comment, a string or a name that the formatter
# cannot break, to be shortened by hand, reported where the formatted line passes WIDTH. Not those
# `left`, as kept as written.
long_lines := (source: String, formatted: String, left: Set<Int>): Finding[] ->
  formatted_lines := Map([(line.trim(), line) for line in formatted.split("\n")])
  [
    for line at i in source.split("\n")
      continue if i + 1 in left
      written := formatted_lines[line.trim()] else continue
      continue if written.count() <= WIDTH

      # The source column of the formatted line's first past WIDTH, as its indentation changes.
      shift := leading_spaces(written) - leading_spaces(line)
      { rule: UNBREAKABLE_LINES, at: { line: i + 1, column: max(WIDTH + 1 - shift, 1) } }
  ]

leading_spaces := (line: String) -> line.count() - line.trim_start().count()

distinct := (findings: Finding[]) ->
  seen: Set<String>
  [
    for finding in findings
      { at, rule } := finding
      key := "#{at.line}:#{at.column} #{rule.label} #{rule.message}"
      continue if key in seen
      seen.add key
      finding
  ]

export parsed_source := (source: String, path: String) ->
  lexed := lex(source, path)
  statements := parse(lexed.tokens, path)
  tree := dump_ast_without_positions(statements)
  Parsed(source, lexed, statements, tree, text: source_tokens(source, lexed))

# The edits of the rewrites of a tree, and its checked program, whose facts are found by its nodes:
# each round parses anew.
struct Rewrites
  edits: Edit[]
  typed: Typed?

rewrites := (parsed: Parsed, path: String) ->
  rewrites_with(parsed, await typed_program(path, parsed.source, parsed.statements))

rewrites_with := (parsed: Parsed, typed: Typed?) ->
  { source, lexed, statements, text } := parsed
  Rewrites(
    typed
    edits: rewrites_of(statements, source, text, lexed, kept_lines(source, lexed), typed)
  )

# Where the program checks, the calls whose values are results keep their parentheses; where it
# does not, those that may be results keep them as written.
laid_out := (parsed: Parsed, typed: Typed?) ->
  { source, lexed, statements, text } := parsed
  kept := kept_lines(source, lexed)
  results := typed then result_calls(typed) else possible_result_calls(statements)
  walked := walk(statements, text, kept, results, typed != nil)

  # The walk skips the statements kept as they are written, which the lines leave alone.
  tokens := Tokens(source, text, comments: lexed.comments, kept: Set())

  edits := break_lines(walked, text, tokens)
  { decisions, texts } := lay_out(text, walked)
  stranded := [
    for index in walked.stranded
      stranded_finding(text, index)
  ]
  found := findings(text.gaps, decisions) + token_findings(text.tokens, texts)
  LaidOut(
    stranded
    edits
    text: render(texts, decisions)
    findings: found
    statements: walked.statements
    skipped: walked.skipped
    kept: kept.kept | kept.marked
  )

# The part of the innermost statement that holds an edit, from its start up to the end of the line
# `last`, where the edit ends, which leaves out the blocks below its head.
struct Held
  from: Position
  last: Int

  holds := (at: Position) -> @from.compare(at) != GREATER and at.line <= @last

# A statement that the walk skips keeps its gaps, which report nothing.
held_statements := (text: SourceTokens, laid: LaidOut, edits: Edit[]) ->
  held: Held[]
  for edit in edits
    # That of a `;` is the layout's (see rewritten_text).
    continue if edit.rule == SEMICOLONS
    change := edit.change else continue
    continue if text.starts[edit.at] else -1 in laid.skipped
    var innermost: StatementShape?
    for statement in laid.statements
      continue unless spans(text, statement, change.from)
      innermost = statement if innermost == nil or statement.start > innermost.start
    if innermost
      held.push { from: text.code[innermost.start].position(), last: change.to.line }
  held

spans := (text: SourceTokens, statement: StatementShape, at: Position) ->
  first := text.code[statement.start]
  last := text.code[statement.end - 1]
  ends_after := at.compare({ line: last.end_line, column: last.end_column }) == LESS
  first.position().compare(at) != GREATER and ends_after

# The rules whose rewrites change the syntax tree; the others give the same tree, which the
# formatter checks. A comparison of trees cannot check these, which change it by design;
# tests/format/rewritten_forms.lerta checks that each form means what its rewrite does.
TREE_CHANGES :=
  APPENDS, BINARY_LITERALS, BYTE_LITERALS, CHAINED_VALUES, CHAR_CONCATENATIONS, COMPREHENSION_FORMS,
  DEFAULT_COMPARISONS, DEFAULT_SEPARATORS, DESTRUCTURED_VALUES, DOUBLE_NEGATIONS, ELSE_NIL,
  EMPTINESS_TESTS, EMPTY_INITIAL_VALUES, EXPECTED_TYPES, FOUND_TESTS, ITERABLE_ARGUMENTS,
  LAST_ITEMS, LONG_TWO_WAY_VALUES, MEMBERSHIP_LISTS, MEMBERSHIP_TESTS, NIL_FIELDS, RANGE_ENDS,
  REDUNDANT_CASTS, RETURNED_BRANCHES, SHORT_COMPREHENSIONS, SHORTHAND_ARGUMENTS, SINGLE_ARM_CASES,
  SORT_KEYS, TWO_WAY_VALUES, TYPE_ANNOTATIONS, UNION_CASES, UNION_IS_TESTS, UNUSED_IMPORTS,
  VALUE_DOUBLE_NEGATIONS, VALUES_ALONE

# Only the rewrites of the source itself are reported: one that a round enables, as `b'...'` for the
# `b"..."` that `"...".binary` is written as, shows once the text written is formatted again.
# The source with the rewrites applied by `rounds`, and laid out. A `;` goes last, once the layout
# has kept no statement on a line that holds one (see Code kept as written): the layout puts the
# statement after it on a line of its own where it decides where the statement starts, and its
# rewrite elsewhere.
# Where `types` leaves out the types whose values have them of their own, and the program rewritten
# does not check or gives a declaration another type, nil: a value took its type from one left out
# after all, and none is left out then (`types` false).
rewritten_text := (
  parsed: Parsed, first_laid: LaidOut, first: Rewrites, path: String, types: Bool
): Promise<RewrittenText?> ->
  done := await rounds(parsed, first_laid, first, path, types)
  return nil unless kept_types(parsed, first, done)
  { current, found } := done

  # A comparison of trees cannot check the rewrites that change the tree (see TREE_CHANGES), but a
  # program that checked must still check.
  if first.typed != nil and found.typed == nil
    throw changed(path, 'its rewrites would make the program fail to check')
  annotations_kept := not types
  separators := applicable([edit for edit in found.edits when edit.rule == SEMICOLONS])
  return { annotations_kept, text: current.source } if separators.is_empty()
  separated := written_program(applied(current.source, separators), path, 'its rewrites')
  check_same separated, current, path, 'its rewrites'
  { annotations_kept, text: separated.source }

# The source rewritten and laid out by the rounds, the rewrites found in it, and whether a round
# left out a type whose value has it of its own.
struct Rounds
  current: Parsed
  found: Rewrites
  left_out_types: Bool

# The rewrites applied round after round, as one may find another in what an earlier one wrote, or
# in the lines that the layout between them decides. Each round checks that the rewrites that keep
# the syntax tree do, and the layout that it keeps the tree of the source rewritten.
rounds := (
  parsed: Parsed, first_laid: LaidOut, first: Rewrites, path: String, types: Bool
): Promise<Rounds> ->
  var current = parsed
  var last_rewrites = first
  var left_out_types = false
  for round in 0..MAX_ROUNDS
    if round > 0
      last_rewrites = await rewrites(current, path)
    laid :=
      if round == 0
        first_laid
      else
        laid_out current, last_rewrites.typed
    edits := last_rewrites.edits + laid.edits
    is_chosen := (edit: Edit) ->
      edit.rule != SEMICOLONS and (types or edit.rule != TYPE_ANNOTATIONS)
    chosen := applicable([edit for edit in edits when is_chosen(edit)])
    left_out_types = true if chosen.any((edit) -> edit.rule == TYPE_ANNOTATIONS)
    if not chosen.is_empty()
      changing := [edit for edit in chosen when edit.rule in TREE_CHANGES]
      expected := written_program(applied(current.source, changing), path, 'its rewrites')
      current = written_program(applied(current.source, chosen), path, 'its rewrites')
      check_same current, expected, path, 'its rewrites'
    else if laid.text != current.source
      current = checked_layout(laid.text, current, path)
    else
      # Nothing changed, so that `last_rewrites` are those of `current`.
      return { current, found: last_rewrites, left_out_types }
  { current, found: await rewrites(current, path), left_out_types }

# Whether the declarations of the program rewritten have the types of those of the source, where
# the rounds left out a type: false where one has another type, or the program does not check.
kept_types := (parsed: Parsed, first: Rewrites, done: Rounds) ->
  { current, found, left_out_types } := done
  return true unless left_out_types
  before := declared_types(parsed.statements, first.typed)
  after := declared_types(current.statements, found.typed) else return false
  before == after

struct RewrittenText
  text: String

  # Whether the types whose values have them of their own are kept, as the program would not check
  # the same without them.
  annotations_kept: Bool

# The rounds that the rewrites and the layouts between them take at most: one for each that another
# enables, as `"..."` of `"...".binary` is written `'...'` once it is `b"..."`, or that a layout
# does, as the arguments of a call that its parentheses no longer hold go in a block below it. What
# is left after the last is reported once the text written is formatted again.
MAX_ROUNDS := 32

# The program laid out, which must be that of the source.
checked_layout := (text: String, source: Parsed, path: String) ->
  laid := written_program(text, path, 'its layout')
  check_same laid, source, path, 'its layout'
  laid

written_program := (text: String, path: String, what: String) ->
  try
    parsed_source(text, path)
  catch error: CompileError
    throw changed(path, "#{what} would not parse: #{error.message}")

check_same := (written: Parsed, expected: Parsed, path: String, what: String) ->
  throw changed(path, "#{what} would change the program") unless written.tree == expected.tree

changed := (path: String, message: String) ->
  ChangedProgram("#{path}: #{message}, which is a fault of the formatter")

stranded_finding := (text: SourceTokens, index: Int) ->
  Finding(at: text.ending_comments[index]!.start, rule: STRANDED_COMMENTS)

lay_out := (text: SourceTokens, walked: Walked) ->
  layout := Layout
    text
    code_gaps: walked.gaps
    skipped: walked.skipped
    line_statements: walked.line_statements
  for gap at index in text.gaps
    layout.decide gap, index
    layout.decide_text text.tokens[index] if index < text.tokens.length
  layout

# The second pass: decides each gap between text tokens, in order, from the gaps between code
# tokens that the walk decides, and the lines laid out before it; and the text of each token.
class Layout
  args
    text: SourceTokens
    code_gaps: Map<Int, CodeGap>
    skipped: Set<Int>
    line_statements: Set<Int>
  private
    decisions: Decision[] = []
    texts: String[] = []

    # The depth of the last line start.
    var depth = 0

    # The columns that the last line start moves the indentation of its source line by, which the
    # lines after it that keep their source text move by too, so that their blocks stay as deep as
    # they are under it. A block that the source indents by other than two spaces thus keeps its
    # width there, unreported, until the walk handles the statement that holds it.
    var shift = 0

    decide := (gap: Gap, index: Int) ->
      { tokens } := @text
      decision: Decision =
        case
          when index == 0 then { text: '', rule: LAYOUT }
          when index == tokens.length then { text: "\n", rule: ending_rule(gap) }
          else @decide_before(tokens[index], gap, index)
      @decisions.push decision

    decide_before := (token: TextToken, gap: Gap, index: Int): Decision ->
      { code } := @text
      has_code := token.next_code < code.length
      code_gap := has_code then @code_gaps[token.next_code] else END
      return @kept(gap) unless code_gap
      comment := token.comment
      if comment and not comment.own_line
        # That of a statement that the walk skips keeps its place as written.
        return @kept(gap) if token.next_code - 1 in @skipped
        return { text: '  ', rule: COMMENTS }
      case code_gap
        when Spaces
          rule := "\n" in gap.text then code_gap.joined else code_gap.rule
          { rule, text: ' '.repeat(code_gap.count) }
        when LineStart
          next_column := has_code then code[token.next_code].column else 1
          opens_block := code_gap.depth > @depth

          # A comment before a dedent indented deeper than the line after it, as at the end of a
          # block, stays in the block that its column reads as in, moved as the line before it is,
          # two spaces a level, the deeper of two that it is between, from that of the line before
          # it out to that of the line after it.
          dedent := code_gap.depth < @depth
          if comment and dedent and comment.column > next_column
            read := (comment.column + @shift) / 2
            @depth = min(@depth, max(code_gap.depth, read))
          else
            @depth = code_gap.depth
          @shift = 2 * @depth - token.line_indentation
          decision := line_feed(gap, 2 * @depth, code_gap.rule)
          return decision if not comment or opens_block
          ends_block := @depth > code_gap.depth
          if @starts_paragraph(token, index, ends_block)
            blank_before(decision)
          else
            decision

    # Whether the own-line comment at `index` starts a paragraph (see Blank lines): not after
    # another, which it continues, but at the end of its block or of the source, or before a
    # statement or a member of a type, rather than an item, an arm or a clause.
    starts_paragraph := (token: TextToken, index: Int, ends_block: Bool) ->
      return false if @text.tokens[index - 1].comment?.own_line == true
      ends_block or token.next_code == @text.code.length or token.next_code in @line_statements

    # A gap that the walk does not decide keeps its source text, spaces at the ends of lines too,
    # unreported, as the walk vouches only for the statements that it handles; but the indentation
    # after it moves with the line start before it.
    kept := (gap: Gap): Decision ->
      { text } := gap
      return { text, rule: LAYOUT } unless "\n" in text
      head := text.binary[..(text.binary.length - indentation(text))].text()!
      { text: head + ' '.repeat(max(0, indentation(text) + @shift)), rule: LAYOUT }

    # The lines of a `"""` or `'''` literal after its first are one level deeper than the line that
    # it starts on (see Multi-line literals), or move with it in a statement that the walk skips.
    decide_text := (token: TextToken) ->
      text :=
        if token.comment != nil or "\n" not in token.text
          token.text
        else if token.next_code in @code_gaps
          indented token.text, 2 * (@depth + 1)
        else
          shifted_lines token.text, @shift
      @texts.push text

# The end of the source starts a line at depth 0, which a comment before it is indented by.
END := LineStart(0)

# The decision with a blank line before its line, as before a comment that starts a paragraph.
blank_before := (decision: Decision): Decision ->
  return decision if decision.text.starts_with("\n\n")
  { text: "\n" + decision.text, rule: COMMENT_BLANK_LINES }

ending_rule := (gap: Gap) ->
  if line_feeds(gap.text) > 1
    BLANK_LINES
  else
    LAYOUT

# A line feed, after a blank line where the source has one, and an indentation of `columns`; `rule`
# decides it where the source has none.
line_feed := (gap: Gap, columns: Int, break_rule: StyleRule) ->
  feeds := line_feeds(gap.text)
  blank := feeds > 1
  text := (blank then "\n\n" else "\n") + ' '.repeat(columns)
  rule :=
    case
      when ';' in gap.text then SEMICOLONS
      when feeds == 0 then break_rule
      # Spaces before the first line feed come before any extra line feed.
      when not gap.text.starts_with("\n") then LAYOUT
      when feeds > 2 then BLANK_LINES
      else LAYOUT
  Decision(text, rule)

line_feeds := (text: String) -> text.split("\n").length - 1

# The spaces after the last line feed of the text of a gap.
indentation := (text: String) -> text.split("\n").last()!.count()

# A `"""` or `'''` literal with its lines after the first indented by `columns`.
indented := (text: String, columns: Int) ->
  indentation := ' '.repeat(columns)
  lines := [
    for line in literal_lines(text)
      line.is_empty() then '' else indentation + line
  ]
  [text.split("\n")[0], lines...].join("\n")

# The text with its lines after the first moved by `shift` columns, those that are not blank.
shifted_lines := (text: String, shift: Int) ->
  lines := text.split("\n")

  # One shift for every line, no more to the left than the lines share, keeps the literal's value.
  moved := max(shift, -common_indentation(lines[1..]))
  rest := [
    for line in lines[1..]
      shifted(line, moved)
  ]
  [lines[0], rest...].join("\n")

# The line with `shift` spaces more at its start, or fewer; a blank line stays as it is.
shifted := (line: String, shift: Int) ->
  return line if is_blank(line)
  return ' '.repeat(shift) + line if shift >= 0
  line.binary[(-shift)..].text()!

render := (texts: String[], decisions: Decision[]) ->
  var text = decisions[0].text
  for token_text at index in texts
    text += token_text + decisions[index + 1].text
  text

# A finding for each gap whose decision differs from the source, at the first character that
# differs, once on each line for each rule.
findings := (gaps: Gap[], decisions: Decision[]) ->
  found: Finding[]
  reported: Set<String>
  for gap at index in gaps
    decision := decisions[index]
    at := first_difference(gap, decision.text) else continue
    { rule } := decision
    key := "#{at.line} #{rule.label} #{rule.message}"
    continue if key in reported
    reported.add key
    found.push { at, rule }
  found

# A finding for each token whose text differs from the source, as the lines of a literal moved.
token_findings := (tokens: TextToken[], texts: String[]): Finding[] ->
  [
    for token at index in tokens
      source := Gap(text: token.text, start: token.start)
      at := first_difference(source, texts[index]) else continue
      { at, rule: LAYOUT }
  ]

first_difference := (gap: Gap, decided: String) ->
  source := scan(gap.text)
  expected := scan(decided)
  var line = gap.start.line
  var column = gap.start.column
  while true
    c := source.next()
    return Position(line, column) if c != expected.next()
    if c == "\n"
      line += 1
      column = 1
    else if c
      column += 1
    else
      return nil
  nil
