# The command line of `lerta fmt [--fix] <path>...`: the files it takes, what it reports and what it
# writes.
import is_dir, is_file, list_dir, read_text, write_file from 'std:io'
import CompileError from '../errors'
import module_key from '../loader'
import removable_annotations from './annotations'
import format_source from './format'

export format_command := (paths: String[], fix: Bool) ->
  var status = 0
  for path in paths
    if not is_file(path) and not is_dir(path)
      print_error "'#{path}' is not a file or a directory"
      status = 1
  files := source_files(paths)
  removable := await removable_annotations(files)
  for file in files
    status = 1 if not await format_file(file, fix, removable[module_key(file)] ? [])
  status

source_files := (paths: String[]) ->
  files: String[]
  for path in paths
    if is_file(path)
      files.push path
    else if is_dir(path)
      add_sources files, path.without_suffix('/') ? path
  files

add_sources := (files: String[], dir: String): void ->
  for name in list_dir(dir)
    path := "#{dir}/#{name}"
    if is_dir(path)
      add_sources files, path if not name.starts_with('.')
    else if name.ends_with('.lerta')
      files.push path

# Whether the file is in the style, without the annotations of `removable`, or is written so with
# `fix`.
format_file := (path: String, fix: Bool, removable: String[]) ->
  source := await read_text(path) ? return failed("#{path}: the file is not valid UTF-8")
  formatted :=
    try
      format_source source, path, removable
    catch error: CompileError
      return failed(error.message)
  if fix
    await write_file(path, formatted.text.binary) if formatted.text != source
    return true
  for finding in formatted.findings
    { at, rule } := finding
    print_error "#{path}:#{at.line}:#{at.column}: #{rule.message} (#{rule.label})"
  formatted.findings.is_empty()

failed := (message: String) ->
  print_error message
  false
