# The command line of `lerta fmt [--fix] <path>...`: the files it takes, what it reports and what it
# writes.
import is_dir, is_file, list_dir, read_file, stderr, write_file from 'std:io'
import CompileError from '../errors'
import module_key from '../loader'
import removable_annotations from './annotations'
import format_source from './format'

# The exit code: 1 if a file is not in the style, or cannot be read or formatted, and 0 otherwise.
export const format_command = (paths: String[], fix: Bool) ->
  var status = 0
  for path in paths
    if not is_file(path) and not is_dir(path)
      stderr.write "'#{path}' is not a file or a directory\n"
      status = 1
  const files = source_files(paths)
  const removable = removable_annotations(files)
  for file in files
    status = 1 if not format_file(file, fix, removable[module_key(file)] ? [])
  status

# The files given, and the `.lerta` files in the directories given, in the order of their names,
# without those in directories whose names start with `.`.
const source_files = (paths: String[]) ->
  const files: String[] = []
  for path in paths
    if is_file(path)
      files.push path
    else if is_dir(path)
      add_sources files, path.without_suffix('/') ? path
  files

const add_sources = (files: String[], dir: String): void ->
  for name in list_dir(dir)
    const path = "#{dir}/#{name}"
    if is_dir(path)
      add_sources files, path if not name.starts_with('.')
    else if name.ends_with('.lerta')
      files.push path

# Whether the file is in the style, without the annotations of `removable`, or is written so with
# `fix`.
const format_file = (path: String, fix: Bool, removable: String[]) ->
  const source = read_file(path).text() ? return failed("#{path}: the file is not valid UTF-8")
  const formatted = try
    format_source source, path, removable
  catch error: CompileError
    return failed(error.message)
  if fix
    write_file path, formatted.text.binary if formatted.text != source
    return true
  for finding in formatted.findings
    const { at, rule } = finding
    stderr.write "#{path}:#{at.line}:#{at.column}: #{rule.message} (#{rule.label})\n"
  formatted.findings.length == 0

const failed = (message: String) ->
  stderr.write "#{message}\n"
  false
