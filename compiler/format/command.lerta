# The command line of `lerta fmt [--fix] <path>...`: the files it takes, what it reports and what it
# writes.
import is_dir, is_file, list_dir, read_text, write_file from 'std:io'
import CompileError from '../errors'
import is_off_throughout from './kept'
import EntryModule, module_key from '../loader'
import ChangedProgram, format_parsed, format_source, Parsed, parsed_source from './format'
import Typed, typed_programs from './typed'

export format_command := (paths: String[], fix: Bool) ->
  var status = 0
  for path in paths
    if not is_file(path) and not is_dir(path)
      print_error "'#{path}' is not a file or a directory"
      status = 1

  # A file given twice, by any paths, is taken once.
  keys: Set<String>
  files := [file for file in source_files(paths) when keys.add(module_key(file))]

  sources := [await source_of(file) for file in files]

  # Each program that holds some of the files is checked once for all of them, for their first
  # rewrites; a file that they rewrite is checked anew on its own (see rewritten_text).
  given: Map<String, EntryModule>
  for source in sources
    if parsed := source.parsed
      given[module_key(source.path)] = { source: parsed.source, program: parsed.statements }
  checked := [source.path for source in sources when source.parsed != nil]
  typed := await typed_programs(checked, given)
  for source in sources
    status = 1 unless await format_file(source, typed[module_key(source.path)], fix)
  status

# A file read, and parsed unless it is off throughout, which is left as it is; or why it cannot be:
# it is not UTF-8 or does not parse.
struct Source
  path: String
  text: String
  parsed: Parsed?
  failure: String?

source_of := (path: String): Promise<Source> ->
  text := await read_text(path) else return { path, text: '', parsed: nil, failure: not_utf8(path) }
  if is_off_throughout(text)
    return { path, text, parsed: nil, failure: nil }
  try
    { path, text, parsed: parsed_source(text, path), failure: nil }
  catch error: CompileError
    { path, text, parsed: nil, failure: error.message }

not_utf8 := (path: String) -> "#{path}: the file is not valid UTF-8"

# Whether the file is in the style, or is written so with `fix`.
format_file := (source: Source, typed: Typed?, fix: Bool) ->
  { path } := source
  return failed(failure) if failure := source.failure
  parsed := source.parsed else return true
  formatted :=
    try
      await format_parsed(parsed, path, typed)
    catch error: CompileError
      return failed(error.message)
    catch error: ChangedProgram
      return failed(error.message)
  findings :=
    if fix and formatted.text != source.text
      await write_file(path, formatted.text)
      (await format_source(formatted.text, path)).findings
    else
      formatted.findings
  for finding in findings
    { at, rule } := finding
    print_error "#{path}:#{at.line}:#{at.column}: #{rule.message} (#{rule.label})"
  findings.is_empty()

failed := (message: String) ->
  print_error message
  false

# The files of the paths: each that is a file, and the .lerta files of each directory and of those
# inside it, in order, but those whose names start with `.`.
source_files := (paths: String[]) ->
  files: String[]
  for path in paths
    if is_file(path)
      files.push path
    else if is_dir(path)
      add_sources files, path.without_suffix('/') else path
  files

add_sources := (files: String[], dir: String): void ->
  for name in list_dir(dir)
    path := "#{dir}/#{name}"
    if is_dir(path)
      add_sources files, path unless name.starts_with('.')
    else if name.ends_with('.lerta')
      files.push path
