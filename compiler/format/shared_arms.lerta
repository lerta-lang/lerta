# How the arms made one by Shared arm bodies (see docs/reference/style.md) are checked: the body
# kept has the types of the body of each arm.
import Identifier, Node, Position from '../ast'
import dump_annotated_without_positions from '../ast_dump'
import Annotation, Placed, SharedArms from './annotated'
import CheckResult from './check_result'

# Whether the node is in the body that the arms left out of the tree share with the arm kept, whose
# subject is narrowed to the union of their types then, which gives the nodes that use it other
# types, as the same code that each arm ran.
export in_shared_body := (left_out: Placed[], result: CheckResult, node: Node) ->
  module := result.node_modules[node] ? return false
  left_out.any (placed) -> placed.key == module and in_body(placed, node.position)

# Whether the body of the arms made one, as they are in `merged`, has the types of the body of each
# of them in `separate`, but for the subjects of the arms made one with them, which each arm
# narrows to the type of its own patterns and the arm made one to their union: a literal or an
# operation may take another type then, as `s == 1` compares a Float with a Float where s is a
# Float, and an Int where it is an Int | Float.
export shares_types := (
  annotation: Annotation, subjects: Set<String>, separate: CheckResult, merged: CheckResult
) ->
  shared := annotation.target as SharedArms ? return true
  run := shared.arms
  # Arms in an arm that others are made one with are left out with it: their patterns, which the
  # checker gives types as it does not each statement, had them before.
  first_pattern := run[0].patterns[0]
  return true if first_pattern in separate.node_types and first_pattern not in merged.node_types
  annotate := (result: CheckResult) ->
    (node: Node) ->
      written := result.node_types[node] ? return ''
      return written if node is not Identifier or node.name not in subjects
      (_, conversion) := written.split_once(' => ') ? return 'the subject'
      "the subject => #{conversion}"
  kept := dump_annotated_without_positions(run[0].body, annotate(merged))
  run.all (arm) -> dump_annotated_without_positions(arm.body, annotate(separate)) == kept

# Whether the position is in the body of the first of the arms that the annotation makes one, which
# holds the nodes that the source has from its first statement up to the next arm, as the checker
# makes its own nodes at the places of those it stands for.
export in_body := (placed: Placed, at: Position) ->
  shared := placed.annotation.target as SharedArms ? return false
  run := shared.arms
  start := run[0].body[0].position
  end := run[1].patterns[0].position
  start <= at and at < end
