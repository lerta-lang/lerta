# Whether the checking of a program shows that a written type can be inferred: that the checker
# would give what it is written for the same type without it. Only what tells so plainly counts: a
# value whose type does not come from where it is, which the written type has without a
# conversion. The rest is kept, though the checker might infer it too.
import
  ArrayLiteral, Await, BinaryOperation, BooleanLiteral, Call, Case, Cast, Coalesce, Conditional,
  Expression, FloatLiteral, FunctionLiteral, Identifier, If, Index, IntegerLiteral, Interpolation,
  IsTest, Jump, MapEntry, MapLiteral, Member, NilLiteral, Range, Return, Statement, StringLiteral,
  This, Throw, Try, TupleItem, TupleLiteral, UnaryOperation, Unwrap
from '../ast'
import enum_value_of, NodeFacts, ProgramWide from '../checker/shared'
import
  ArrayType, FunctionType, is_kind, MapType, ObjectType, PromiseType, TupleType, Type, TypeKind,
  unify
from '../types'

# The type of a variable or a field of the name, with its value.
export struct DeclaredType
  name: Identifier
  value: Expression
  # Whether the type of a variable moves to the type arguments of its Map() or Set(), which then
  # give the type.
  moves_to_type_arguments := default false

# Whether the return type of the function, whose last value is `last`, can be inferred.
export return_inferable := (
  function: FunctionLiteral, last: Expression?, facts: NodeFacts, program: ProgramWide
) -> not is_recursive(function, program) and gives_its_type(function, last, facts)

export declared_inferable := (target: DeclaredType, facts: NodeFacts, program: ProgramWide) ->
  { name, value } := target
  declared := facts.types[name] ? field_type(program, name) ? return false
  type := facts.types[value] ? return false
  # A type that moves to the type arguments of a Map() or Set() is given there.
  is_given := target.moves_to_type_arguments or given_as_is(value, facts)
  is_given and type == declared

# The type of the field of a class or struct that `name` declares.
field_type := (program: ProgramWide, name: Identifier) ->
  for info in program.infos.values()
    for field in info.fields
      return field.type if field.name == name
  nil

# Whether the function's body uses its own type, directly or through the functions it uses.
is_recursive := (function: FunctionLiteral, program: ProgramWide) ->
  reaches program.calls, function, function, Set()

# Whether `from` uses `target`, through the functions it uses that are not `seen` yet.
reaches := (
  calls: Map<FunctionLiteral, FunctionLiteral[]>, from: FunctionLiteral, target: FunctionLiteral,
  seen: Set<FunctionLiteral>
): Bool ->
  for callee in calls[from] ? []
    return true if callee == target
    continue unless seen.add(callee)
    return true if reaches(calls, callee, target, seen)
  false

# A return type that the results give together, as a mix of T and nil gives T?, in a Promise for a
# function that awaits; or `void`, where the function gives no result and ends with no value, or
# with one of type void.
gives_its_type := (function: FunctionLiteral, last: Expression?, facts: NodeFacts) ->
  return false if function.yields
  declared := facts.types[function] as FunctionType ? return false
  results := facts.results[function] ? return false
  result := function.awaits then (declared.result as PromiseType?)?.value else declared.result
  return false if result == nil
  unless is_kind(result, 'void')
    unified := unified_own_type(results, facts) ? return false
    return unified == result
  return false unless results.is_empty()
  value := last ? return true
  type := facts.types[value] ? return false
  is_kind type, 'void'

# The type that values of their own types give together, as the branches of a conditional do; nil
# if there are none, or one takes its type from where it is. Nil too if a value of another type,
# other than one that gives no value such as a throw, is not converted to it: the checking converts
# a member of a union, as `A` for `A | B`, where the values give the type but not where the type is
# written, so leaving the type out would change the checking.
unified_own_type := (values: Expression[], facts: NodeFacts) ->
  var unified: Type?
  for value in values
    type := facts.types[value] ? return nil
    return nil unless has_own_type(value, facts)
    before := unified
    unified = before then unify(before, type) else type
    return nil if unified == nil
  whole := unified ? return nil
  is_converted := (value: Expression) ->
    type := facts.types[value]!
    facts.conversions[value] != nil or type == whole or is_kind(type, 'never')
  values.all(is_converted) then whole

# A value whose type does not come from where it is, given where its own type is wanted.
given_as_is := (value: Expression, facts: NodeFacts) ->
  facts.conversions[value] == nil and has_own_type(value, facts)

# Whether the value's type does not come from the type wanted where it is: as a member of an enum,
# an empty array or map, a number that may be a Byte or a Float, a function literal whose
# parameters take their types from it, or the type arguments of a generic function or type do.
has_own_type := (value: Expression, facts: NodeFacts): Bool ->
  own := (part: Expression) -> given_as_is(part, facts)
  # A part may take the type of the whole without a conversion, as an Item where Item | Other is.
  own_as := (part: Expression, type: Type?) ->
    part_type := facts.types[part]
    own(part) and type != nil and part_type != nil and part_type == type
  type := facts.types[value]
  case value
    when StringLiteral then is_type(type, 'String')
    when Identifier, Member then enum_value_of(facts, value) == nil
    when IntegerLiteral then is_type(type, 'Int')
    # `b'a'` may be a Byte, as `'a'` may be a Char.
    when Interpolation then not value.binary or is_type(type, 'Binary')
    when
      Throw, Return, Jump, FloatLiteral, BooleanLiteral, NilLiteral, This, IsTest, Cast, TupleItem,
      Index, Range, Await, Unwrap, Coalesce
    then true
    when Call
      own_type := facts.instances[value] == nil and not has_type_arguments(facts.types[value])
      own_type or is_collection_call(value)
    when UnaryOperation then own(value.operand)
    when BinaryOperation then own(value.left) and own(value.right)
    when Conditional then unifies_to([value.then_value, value.else_value], type, facts)
    when Case, If, Try
      values := branch_values(value) ? return false
      unifies_to values, type, facts
    when ArrayLiteral
      element := (type as ArrayType?)?.element
      not value.elements.is_empty() and value.elements.all((part) -> own_as(part, element))
    when MapLiteral
      map := type as MapType ? return false
      own_entry := (entry: MapEntry) ->
        own_as(entry.key, map.key) and own_as(entry.value, map.value)
      not value.entries.is_empty() and value.entries.all(own_entry)
    when TupleLiteral
      items := (type as TupleType?)?.items ? return false
      [own_as(part, items[i]) for part at i in value.items].all((same) -> same)
    else false

# Whether values of their own types give the type together, as branches do.
unifies_to := (values: Expression[], type: Type?, facts: NodeFacts) ->
  unified := unified_own_type(values, facts)
  type != nil and unified != nil and unified == type

# The values that the branches of a case, an if or a try give, their last statements; nil for
# another value, or if a branch is empty or ends with a statement that is no expression.
branch_values := (value: Expression) ->
  bodies: Statement[][] =
    case value
      when Case
        arms := [arm.body for arm in value.arms]
        otherwise := value.otherwise
        rest: Statement[][] = otherwise then [otherwise] else []
        [arms..., rest...]
      when If then [value.then_body, value.else_body]
      when Try then [value.body, [clause.body for clause in value.catches]...]
      else return nil
  values: Expression[]
  for body in bodies
    last := body.last() ? return nil
    last_value := last as Expression ? return nil
    values.push last_value
  values

is_type := (type: Type?, kind: TypeKind) -> type != nil and is_kind(type, kind)

has_type_arguments := (type: Type?) ->
  case type
    when MapType then true
    when ObjectType then not type.args.is_empty()
    else false

# `Map<K, V>()` or `Set<T>()`, whose type arguments give its type; without them, it takes the type
# from where it is, as a variable's annotation that moves to them (see annotated). A local that
# takes the name passes too: this only picks the annotations to check without, and that checking
# keeps them (see removable_annotations).
is_collection_call := (call: Call) ->
  callee := call.callee as Identifier ? return false
  not call.type_args.is_empty() and (callee.name == 'Map' or callee.name == 'Set')
