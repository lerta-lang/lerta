# The walk of expressions (see walk.lerta).
import
  ArrayLiteral, ArrayTypeName, Await, BinaryOperation, Binding, BooleanLiteral, Call, Case, Cast,
  Coalesce, Comprehension, Conditional, Expression, FloatLiteral, FunctionLiteral, FunctionTypeName,
  Identifier, If, Index, IntegerLiteral, Interpolation, is_nested, IsTest, Jump, MapLiteral, Member,
  NamedType, NamedValue, NilLiteral, Parameter, Range, RecordLiteral, RecordTypeField,
  RecordTypeName, Return, Statement, StringLiteral, This, Throw, Try, TupleLiteral, TupleTypeName,
  TypeName, UnaryOperation, UnionTypeName, Unwrap, Yield
from '../ast'
import TokenKind from '../lexer/tokens'
import FUNCTION_BODIES from './rules'
import
  is_block_call, is_block_literal, is_simple, is_taken_apart, is_written_in_block,
  literal_under_members, starts_command
from './forms'
import binary_precedence, COMPARISON from './precedence'
import
  ChainShape, CodeGap, ComprehensionShape, ListShape, OperationShape, Shape, ValueKind, ValueShape
from './shapes'
import INSIDE, NONE, ONE, unhandled, Walker from './walk'
import ListItems from './walk_lists'
import './walk_statements'

extend Walker
  # The value after the token at `after`: after `=`, `:=`, a compound assignment or `return` if
  # `in_block`, and otherwise after a key, `then` or `else`, where it takes the next line only after
  # a comment (see ValueShape). That after `then` or `else` is an operand, which `breaks` tells.
  value := (after: Int, node: Expression, in_block: Bool, breaks = true) ->
    first := @at
    walk := (gap: CodeGap) ->
      if breaks
        @whole node, gap
      else
        @operand node, gap
    kind := @value_kind(after, node, in_block) ? return walk(ONE)
    outer := @shapes
    @shapes = []
    walk ONE
    shape := ValueShape(first, kind, last: @at - 1, shapes: @shapes)
    @shapes = outer
    @shapes.push shape

  value_kind := (after: Int, node: Expression, in_block: Bool): ValueKind? ->
    return BELOW_COMMENT if @comment_follows(after)
    return nil if @in_brackets or not in_block
    case node
      when Case, Try then BRANCH
      when If then node.nil_safe then OTHER else BRANCH
      when ArrayLiteral, RecordLiteral, MapLiteral
        # One written in a block is one, as a spread may start a record there.
        is_block_literal(node) or is_written_in_block(node) then LITERAL_BLOCK
      when FunctionLiteral then nil
      when BinaryOperation then OPERATION
      when Conditional then TWO_WAY
      else
        if literal := literal_under_members(node)
          return LITERAL_BLOCK if is_block_literal(literal)
        return BLOCK_CALL if is_block_call(node) and @on_own_line
        node is Member | Call | Index then CHAIN else OTHER

  # A type, on one line, in the parentheses that group it: those that the tree does not keep, as
  # around a union or a function type that `?` or `[]` follows. One whose items line ends separate,
  # which a line would need commas between, is left as written.
  # Its `?` is taken where `optional` is true.
  type := (type: TypeName, before: CodeGap, optional: Bool = type.optional): void ->
    if type is ArrayTypeName
      @type type.element, before
      @take '[', NONE
      @take ']', NONE
      @take '?', NONE if optional
      return
    var groups = 0
    var gap = before
    while @at_kind('(') and not @opens_type(type, @at)
      @take '(', gap
      gap = NONE
      groups += 1
    @ungrouped_type type, gap
    # The `?` of a named type follows its name, as in `(Int?)[]`, and that of another its brackets.
    named := type is NamedType
    @take '?', NONE if optional and named
    @take ')', NONE for _ in 0..groups
    @take '?', NONE if optional and not named

  # Whether the `(` at `open` is the type's own: that of the parameters of a function type, which
  # `->` follows, or of a tuple type, which holds a comma.
  opens_type := (type: TypeName, open: Int) ->
    close := @closing_bracket(open)
    case type
      when FunctionTypeName then @kind_at(close + 1) == '->'
      when TupleTypeName then @has_comma(open + 1, close)
      else false

  ungrouped_type := (type: TypeName, before: CodeGap): void ->
    case type
      when NamedType
        @take IDENTIFIER, before
        # `module.Name`, whose name holds the `.`.
        for _ in type.name.split('.')[1..]
          @take '.', NONE
          @take IDENTIFIER, NONE
        @type_arguments type.args
      when UnionTypeName
        for member at i in type.members
          @take '|', ONE if i > 0
          @type member, i == 0 then before else ONE
      when FunctionTypeName
        @types '(', before, type.params, ')'
        @take '->', ONE
        @type type.result, ONE
      when TupleTypeName then @types('(', before, type.items, ')')
      when RecordTypeName
        { fields } := type
        @take '{', before
        @list fields.length, INSIDE, (i, gap) -> @record_type_field(fields[i], gap), false
        @take '}', fields.is_empty() then NONE else INSIDE
      else unhandled()

  # Types in brackets, on one line.
  types := (open: TokenKind, before: CodeGap, types: TypeName[], close: TokenKind) ->
    @take open, before
    @list types.length, NONE, (i, gap) -> @type(types[i], gap), false
    @take(close, NONE)

  record_type_field := (field: RecordTypeField, before: CodeGap) ->
    @take IDENTIFIER, before
    @take ':', NONE
    @type field.type, ONE

  # A whole value, as an item or a value after `=`, whose operations may break.
  whole := (node: Expression, before: CodeGap) ->
    breaks := @breaks_operations
    @breaks_operations = true
    @expression node, before
    @breaks_operations = breaks

  # An operand, or a head, whose operations stay on its line.
  operand := (node: Expression, before: CodeGap) ->
    breaks := @breaks_operations
    @breaks_operations = false
    @expression node, before
    @breaks_operations = breaks

  # An expression, with the parentheses around it.
  expression := (node: Expression, before: CodeGap): void ->
    outer_groups := @open_groups
    @open_groups = 0
    # The expression's members are a chain of their own, not of one that it is part of.
    outer_dots := @chain_dots
    @chain_dots = nil
    @chain node, before
    @chain_dots = outer_dots
    unhandled() if @open_groups != 0
    @open_groups = outer_groups

  # The expression and those at its start, as the left operand of an operation, whose parentheses
  # an expression opens at its start: each that the chain closes after its end is around it.
  chain := (node: Expression, before: CodeGap): void ->
    @node_start = @at
    var first = before
    groups := @groups_at_start(node)
    for _ in 0..groups
      @take_before_operand '(', first
      first = NONE
      @open_groups += 1
    # An operation in parentheses stays on its line, which its `)` would end otherwise.
    breaks := @breaks_operations
    @node_breaks = breaks
    @breaks_operations = false if groups > 0
    @node node, first
    @breaks_operations = breaks
    while @open_groups > 0 and @at_kind(')')
      @take ')', NONE
      @open_groups -= 1

  # The parentheses at the start of the node that group it: all of those in a row, but the last of a
  # tuple, or of the parameters of a function literal, rather than one around `-> body`.
  node := (node: Expression, before: CodeGap): void ->
    case node
      # The name that `x?.rest` binds x to stands for no token, as `?` is written in its place.
      when Identifier then @take(IDENTIFIER, before) unless node.name.starts_with('?')
      when StringLiteral then @take(STRING, before)
      when Interpolation then @take(node.binary then BINARY else INTERPOLATED, before)
      when BooleanLiteral then @take(node.value then 'true' else 'false', before)
      when NilLiteral then @take('nil', before)
      when IntegerLiteral then @number(node.text, INTEGER, before)
      when FloatLiteral then @number(node.text, FLOAT, before)
      when This then @take('@', before)
      when Jump then @take(node.kind == 'break' then 'break' else 'continue', before)
      when Member, Call, Index then @link(node, before)
      when Unwrap
        @chain node.operand, before
        @take '!', NONE
      when UnaryOperation then @unary(node, before)
      when BinaryOperation then @binary(node, before)
      when Coalesce
        @chain node.value, before
        @take '?', ONE
        @operand node.fallback, ONE
      when Range then @range(node, before)
      when IsTest then @is_test(node, before, false)
      when Comprehension
        unhandled() if node.spread
        @comprehension node, before
      when Cast then @cast(node, before)
      when If then @if_statement(node, before)
      when Conditional
        # Its parts are operands, whose operations stay on their lines.
        breaks := @breaks_operations
        @breaks_operations = false
        @chain node.condition, before
        @breaks_operations = breaks
        @value @take('then', ONE), node.then_value, false, false
        @value @take('else', ONE), node.else_value, false, false unless node.without_else
      when ArrayLiteral then @literal(node, '[', before, ']', NONE, @element_items(node.elements))
      when MapLiteral then @map(node, before)
      when RecordLiteral then @record(node, before)
      when TupleLiteral
        { items } := node
        tuple_items := ListItems
          count: items.length
          walk: (i, gap) -> @expression(items[i], gap)
          simple: (i) -> is_simple(items[i])
        @bracketed '(', before, ')', NONE, tuple_items
      when FunctionLiteral then @function(node, before)
      when Case then @case_value(node, before)
      when Try then @try_value(node, before)
      when Return
        return_at := @take('return', before)
        @value return_at, value, true if value := node.value
      when Throw
        @take 'throw', before
        @expression node.message, ONE
      when Yield
        @take 'yield', before
        @expression node.value, ONE
      when Await
        @take 'await', before
        @operand node.operand, ONE
      else unhandled()

  # A member, a call or an index, which links a chain of members; the outermost, of a whole value,
  # is the chain, which breaks one member a line (see ChainShape), but one whose start is a literal
  # in a block, which has its members on the line after the block (see Multi-line literals).
  link := (node: Member | Call | Index, before: CodeGap): void ->
    return @walk_link(node, before) if @chain_dots != nil
    # Whether the chain is a whole value, as it was before the parentheses at its start, which may
    # close before its first `.`, as those of `(a + b).c()` do.
    breaks := @node_breaks
    first := @at
    outer := @shapes
    @shapes = []
    @chain_dots = []
    @chain_nil_safe = false
    @chain_in_group = false
    @walk_link node, before
    dots := @chain_dots!
    @chain_dots = nil
    inner := @shapes
    @shapes = outer
    # A call without parentheses, as `ir.module.declare` and its arguments in a block, takes them
    # after its last member, on its line.
    is_unbracketed := (shape: Shape) -> shape is ListShape and not shape.bracketed
    takes_unbracketed := inner.any(is_unbracketed)
    is_chain := breaks and
      dots.length >= 2 and
      not takes_unbracketed and
      not @chain_nil_safe and
      not @chain_in_group and
      literal_under_members(node) == nil
    # The shapes inside follow it: a call's arguments stay the last shapes of its statement.
    @shapes.push ChainShape(first, dots, last: @at - 1) if is_chain
    kept := [dot for dot in dots when dot in @line_starts]
    if takes_unbracketed and not kept.is_empty() and literal_under_members(node) == nil
      @shapes.push ChainShape(first, last: @at - 1, dots: kept, kept: true)
    @shapes.push shape for shape in inner

  walk_link := (node: Member | Call | Index, before: CodeGap): void ->
    case node
      when Member then @member(node, before)
      when Call then @call(node, before)
      when Index
        @chain node.object, before
        { index, default_value } := node
        # `xs[i, default: value]`: the index, then its default.
        walk := (i: Int, gap: CodeGap) ->
          if i == 0
            @expression index, gap
          else
            @take_spelled 'default', gap
            @value @take(':', NONE), default_value!, false
        last := default_value ? index
        items := ListItems
          walk
          count: default_value then 2 else 1
          simple: (_) -> false
          function_last: last is FunctionLiteral
        @bracketed '[', NONE, ']', NONE, items

  # A negative literal is the two tokens `-` and the number.
  number := (text: String, kind: TokenKind, before: CodeGap) ->
    if text.starts_with('-')
      @take '-', before
      @take(kind, NONE)
    else
      @take(kind, before)

  # `[element for x in xs when guard]`, with a `for` more for each nested comprehension, or the same
  # in parentheses, an Iter (see ComprehensionShape).
  comprehension := (node: Comprehension, before: CodeGap) ->
    lazy := node.lazy != nil
    open := @take(lazy then '(' else '[', before)
    outer := @save()
    @shapes = []
    @in_brackets = true
    @on_own_line = false
    @breaks_operations = true
    parts := [@at]
    chain := nested_chain(node)
    @expression chain.last()!.element, NONE
    for each in chain
      parts.push @take('for', ONE)
      @loop_names each.variable, each.index
      @take_spelled 'in', ONE
      @expression each.iterable, ONE
      if guard := each.guard
        parts.push @take_spelled('when', ONE)
        @expression guard, ONE
    close := @take(lazy then ')' else ']', NONE)
    shape := ComprehensionShape(open, close, parts, shapes: @shapes)
    @restore outer
    @shapes.push shape

  # The variable of a loop, or the names in parentheses that its item is taken apart into, as the
  # source has them, as the tree keeps none for a part that is `_`; and `at` and the name of its
  # index.
  loop_names := (variable: Identifier, index: Identifier?) ->
    if variable.name.starts_with('_tuple.')
      @names ONE
    else
      @take IDENTIFIER, ONE
    if index
      @take_spelled 'at', ONE
      @take IDENTIFIER, ONE

  # The names that a destructuring takes a value apart into, as the source has them, as the tree
  # keeps none for a part that is `_`: `(a, b)` for a tuple, or `{ a, b }` for fields.
  names := (before: CodeGap) ->
    braced := @at_kind('{')
    inside := braced then INSIDE else NONE
    open := @take(braced then '{' else '(', before)
    count := 1 + [i for i in open..@closing_bracket(open) when @code[i].kind == ','].length
    @list count, inside, (_, gap) -> @take(IDENTIFIER, gap), false
    @take(braced then '}' else ')', inside)

  # `x as T?` or `x as T!`, or the `x as T` of `x as T ? y`, whose `?`, after a space, is the
  # fallback's.
  cast := (node: Cast, before: CodeGap) ->
    @chain node.value, before
    @take_spelled 'as', ONE
    @type node.type, ONE, false
    if node.throws
      @take '!', NONE
    else if not @code[@at].spaced
      @take '?', NONE

  # `x?.rest`, which is read as an `if` that binds x to a name that rest starts with.
  nil_safe := (node: If, before: CodeGap) ->
    @chain (node.condition as Binding!).value, before
    @take '?', NONE
    @chain node.then_body[0] as Expression!, NONE

  member := (node: Member, before: CodeGap) ->
    if node.object is This and @at_kind('@')
      @take '@', before
    else
      @chain node.object, before
      object := node.object as Identifier?
      # Of `x?.y`, whose rest is in the `?.`, not after the value so far, as a member line would be.
      is_nil_safe := object != nil and object.name.starts_with('?')
      @chain_dots!.push(@at)
      @chain_nil_safe = true if is_nil_safe
      # Inside parentheses, as of `(a.b().c())`, where a member line would be an item.
      @chain_in_group = true if @open_groups > 0
      @take '.', NONE
    @take(IDENTIFIER, NONE)

  # `<T, U>`, where there are type arguments, on one line, as the grammar takes no line end between
  # them.
  type_arguments := (args: TypeName[]) ->
    return if args.is_empty()
    @take '<', NONE
    @list args.length, NONE, (i, gap) -> @type(args[i], gap), false
    @take '>', NONE

  # A call with parentheses, or without them, whose arguments follow a space on its line or are in a
  # block below it.
  call := (node: Call, before: CodeGap) ->
    @chain node.callee, before
    @type_arguments node.type_args
    { args, named_args } := node
    values := args + [named.value for named in named_args]
    items := ListItems
      count: values.length
      walk: (i, gap) ->
        if i < args.length
          @element args[i], gap
        else
          @named named_args[i - args.length], gap
      simple: (i) -> is_simple(values[i])
      function_last: values.last() is FunctionLiteral
    if @at_kind('(') and not @code[@at].spaced
      @bracketed '(', NONE, ')', NONE, items
    else
      @unbracketed items
    shape := @shapes.pop() as ListShape!
    takes_parentheses := node in @results
    unbracketable := shape.bracketed and
      not takes_parentheses and
      is_block_call(node) and
      starts_command(node) and
      @unbracketable(shape)
    @shapes.push ListShape(shape..., unbracketable, takes_parentheses)

  # Whether no comment is among the arguments in parentheses, none but the last spans lines, and
  # the first is not `- x`, which would be a subtraction from the callee without them.
  unbracketable := (args: ListShape) ->
    { items, open, close } := args
    leading := [i for i in 0..(items.length - 1)]
    on_one_line := leading.all((i) -> @code[items[i]].line == @code[items[i + 1] - 1].end_line)
    spaced_minus := @code[items[0]].kind == '-' and @code[items[0] + 1].spaced
    on_one_line and not spaced_minus and not @has_comments(open, close)

  # A literal in its brackets, or without them in a block below the head of a value (see Block
  # literals).
  literal := (
    node: Expression, open: TokenKind, before: CodeGap, close: TokenKind, inside: CodeGap,
    items: ListItems
  ) ->
    if is_written_in_block(node)
      @unbracketed items, open == '{'
    else
      @bracketed open, before, close, inside, items

  # A list without brackets (see ListShape), separated by line ends only in a block below the token
  # before it.
  unbracketed := (items: ListItems, braced = false) ->
    open := @at - 1
    outer := @shapes
    @shapes = []
    walked := @list(items.count, ONE, items.walk, @at in @line_starts)
    shape := ListShape
      open
      braced
      bracketed: false
      close: @at
      items: walked.starts
      simple: [i for i in 0..items.count].all(items.simple)
      commas: walked.commas
      function_last: items.function_last
      shapes: @shapes
    @shapes = outer
    @shapes.push shape

  named := (named: NamedValue, before: CodeGap) ->
    @take IDENTIFIER, before
    @value @take(':', NONE), named.value, false

  # An item of a list, which may be a spread, `xs...`.
  element := (node: Expression, before: CodeGap) ->
    if node is Comprehension and node.spread
      @expression node.iterable, before
      @take '...', NONE
    else
      @expression node, before

  unary := (node: UnaryOperation, before: CodeGap) ->
    if node.operator == '-'
      # `- 1`, which `-1` would make a literal.
      operand := @kind_at(@at + 1)
      unhandled() if operand == INTEGER or operand == FLOAT
      @take_before_operand '-', before
      @operand node.operand, NONE
    else if @at_kind('not')
      @take_before_operand 'not', before
      @operand node.operand, ONE
    else
      if test := node.operand as IsTest?
        @is_test test, before, true
        return
      # `x not in xs`, which is read as `not (x in xs)`.
      test := node.operand as BinaryOperation ? unhandled()
      unhandled() if test.operator != 'in'
      @chain test.left, before
      @take_before_operand 'not', ONE
      @take_spelled 'in', ONE
      @operand test.right, ONE

  # `x is T`, or `x is not T`, which is read as `not (x is T)`.
  is_test := (node: IsTest, before: CodeGap, negated: Bool) ->
    @chain node.value, before
    @take_spelled 'is', ONE
    @take 'not', ONE if negated
    @type node.type, ONE

  # A binary operation, and the chain of those of its level on its left, which breaks where it is a
  # whole value (see OperationShape).
  binary := (node: BinaryOperation, before: CodeGap) ->
    first := @node_start
    breaks := @breaks_operations
    outer := @shapes
    @shapes = [] if breaks
    @breaks_operations = false
    @chain node.left, before
    operator := @at
    @operator node.operator, ONE
    right := @at
    @expression node.right, ONE
    @operations[node] = { first, operator, right, end: @at }
    @breaks_operations = breaks
    return unless breaks
    operands := [@operations[operation]!.right for operation in @operation_chain(node)]
    shape := OperationShape(first, operands, last: @at - 1, shapes: @shapes)
    @shapes = outer
    @shapes.push shape

  # The operations of the chain from its first, innermost on the left, to `node`: those of its level
  # on its left, outside parentheses. A comparison takes no chain.
  operation_chain := (node: BinaryOperation) ->
    level := binary_precedence(node.operator)
    chain := [node]
    return chain if level == COMPARISON
    while left := chain.last()!.left as BinaryOperation?
      in_parentheses := @operations[left]!.end != @operations[chain.last()!]!.operator
      break if binary_precedence(left.operator) != level or in_parentheses
      chain.push left
    chain.reversed()

  range := (node: Range, before: CodeGap) ->
    operator: TokenKind = node.inclusive then '..=' else '..'
    if start := node.start
      @chain start, before
      @take operator, NONE
    else
      @take operator, before
    @operand end, NONE if end := node.end
    if step := node.step
      @take_spelled 'by', ONE
      @operand step, ONE
    @take_spelled 'reversed', ONE if node.reversed

  map := (node: MapLiteral, before: CodeGap) ->
    { entries } := node
    # A value in a block goes on the next line where it does not fit on its own, as after `=`.
    in_block := is_written_in_block(node)
    walk := (i: Int, gap: CodeGap) ->
      @expression entries[i].key, gap
      @value @take(':', NONE), entries[i].value, in_block
    items := ListItems
      walk
      count: entries.length
      simple: (i) -> is_simple(entries[i].key) and is_simple(entries[i].value)
      function_last: [entry.value for entry in entries].last() is FunctionLiteral
    @literal node, '{', before, '}', INSIDE, items

  record := (node: RecordLiteral, before: CodeGap) ->
    { spread, fields } := node
    spread_count := spread then 1 else 0
    in_block := is_written_in_block(node)
    walk := (i: Int, gap: CodeGap) ->
      if item := i == 0 then spread
        @element item, gap
      else
        field := fields[i - spread_count]
        @take IDENTIFIER, gap
        @value @take(':', NONE), field.value, in_block if @at_kind(':')
    items := ListItems
      walk
      count: spread_count + fields.length
      simple: (i) -> i >= spread_count and is_simple(fields[i - spread_count].value)
      function_last: [field.value for field in fields].last() is FunctionLiteral
    # `{}`, of no fields, has no space inside.
    @literal node, '{', before, '}', items.count == 0 then NONE else INSIDE, items

  function := (node: FunctionLiteral, before: CodeGap) ->
    var open_before = before
    var arrow_before = before
    if node.weak
      @take_spelled 'weak', before
      open_before = ONE
      arrow_before = ONE
    unless node.type_params.is_empty()
      @type_parameters node.type_params, open_before
      open_before = NONE
      arrow_before = ONE
    if @at_kind('(')
      { params } := node
      items := ListItems
        count: params.length
        walk: (i, gap) -> @parameter(params[i], gap)
        simple: (i) -> params[i].default == nil
      @bracketed '(', open_before, ')', NONE, items
      arrow_before = ONE
    if type := node.return_type
      @take ':', NONE
      @return_type type, node.body.find((statement) -> not is_taken_apart(statement))!
      arrow_before = ONE
    arrow := @take('->', arrow_before)
    @shapes.push @body(arrow, node.body, FUNCTION_BODIES)

  # The result type of a function literal, before the `->` of its body, whose first statement is
  # `first`. Parentheses that group all of it, as in `(): (() -> Int) ->`, look like those of a
  # function type's parameters, as that `->` follows them, so they are told by their `)`, which is
  # the last token before it; but a tuple type's own are no group.
  return_type := (type: TypeName, first: Statement) ->
    arrow := (@starts[first.position] ? unhandled()) - 1
    var groups = 0
    var gap = ONE
    groups_all := -> @at_kind('(') and @closing_bracket(@at) == arrow - 1
    own_tuple := -> type is TupleTypeName and @has_comma(@at + 1, arrow - 1)
    while groups_all() and not own_tuple()
      @take '(', gap
      gap = NONE
      groups += 1
    @type type, gap
    @take ')', NONE for _ in 0..groups

  parameter := (node: Parameter, before: CodeGap) ->
    if @at_kind(IDENTIFIER)
      @take IDENTIFIER, before
    else
      @names before
    if type := node.type
      @take ':', NONE
      @type type, ONE
    @take '...', NONE if node.variadic
    if default := node.default
      @take '=', ONE
      @expression default, ONE

  # An operator, which a shift writes as two tokens, `<` and `<`.
  operator := (operator: String, before: CodeGap) ->
    if operator in ['<<', '>>']
      half := operator == '<<' then '<' else '>'
      @take_spelled half, before
      @take_spelled(half, NONE)
    else
      @take_spelled(operator, before)

# The comprehension and those nested in it, each the element of the one before, in the order of
# their `for`s.
nested_chain := (comprehension: Comprehension) ->
  chain := [comprehension]
  chain.push chain.last()!.element as Comprehension! while is_nested(chain.last()!.element)
  chain
