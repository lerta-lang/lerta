# The statements that `# fmt: skip` and `# fmt: off` mark to keep as they are written (see
# lines_marked): each that holds a marked line on lines of its own, not on those of a statement
# inside it.
import scan from 'std:scanner'
import Position from '../ast'
import Comment, Lexed, Token, TokenKind, without_carriage_return from '../lexer/tokens'

export class KeptLines
  args
    tokens: Token[]
    marked: Set<Int>

  # The index in `tokens` of the token that starts at each position.
  private
    token_indexes := index_tokens(@tokens)

    # The lines that hold a `;`, which separates statements.
    separated := Set([token.line for token in @tokens when is_separator(token)])

    # The lines of the statements on lines of their own asked about so far, and of those kept.
    claimed := Set<Int>()
  kept := Set<Int>()

  # Whether the statement on lines of its own that starts at `start`, before `next`, where the
  # statement after it in its block starts, holds a marked line that no statement inside it,
  # asked about before it, claims, and no `;`, as the statements that it separates would each
  # keep the line. Its lines are claimed either way.
  keeps := (start: Position, next: Position?) ->
    last := @last_line(start, next)
    var marks = false
    var separated = false
    for line in start.line..=last
      marks = marks or (line in @marked and line not in @claimed)
      separated = separated or line in @separated
      @claimed.add line
    is_kept := marks and not separated
    if is_kept
      @kept.add line for line in start.line..=last
    is_kept

  # The last line that holds a token of the statement that starts at `start`, which ends at the
  # line end that ends it, at the end of its block, or before `next`, past the blocks of its own
  # and the clauses after them, as an `else`.
  private last_line := (start: Position, next: Position?) ->
    first := @token_indexes[start]!
    stop := (next then @token_indexes[next]) ? @tokens.length
    var depth = 0
    var last = first
    for index in first..stop
      kind := @tokens[index].kind
      if kind == INDENT
        depth += 1
      else if kind == DEDENT
        depth -= 1
        break if depth < 0
      else if kind == NEWLINE
        break if depth == 0 and @tokens[index + 1].kind != INDENT
      else if kind == EOF
        break
      else
        last = index
    @tokens[last].end_line

# The lines that the comments mark.
export kept_lines := (source: String, lexed: Lexed) ->
  lines := [without_carriage_return(line) for line in source.split("\n")]
  KeptLines(tokens: lexed.tokens, marked: lines_marked(lines, lexed.tokens, lexed.comments))

# Whether `# fmt: off` comes before the code, and no `# fmt: on` after it: the file is kept as it is
# written without being parsed, as one that does not parse may be. The lines are read as text, as
# such a file may not even lex: a line that ends with `# fmt: on` counts as one, which a comment or
# a string that merely ends so takes for it too, and the file is then parsed.
export is_off_throughout := (source: String) ->
  lines := [line.trim() for line in source.split("\n")]
  is_code := (line: String) -> not line.is_empty() and not line.starts_with('#')
  code_start := lines.find_index(is_code) ? lines.length
  off := lines.index_of('# fmt: off') ? return false
  after := lines[(off + 1)..]
  off < code_start and not after.any((line) -> line.ends_with('# fmt: on'))

# The lines that hold tokens that the comments mark: the line that `# fmt: skip` ends, or the next
# that holds a token after `# fmt: skip` on a line of its own, and those from `# fmt: off` up to
# `# fmt: on`, or to the end of the file.
lines_marked := (lines: String[], tokens: Token[], comments: Comment[]) ->
  token_lines := Set([token.line for token in tokens when token.kind not in LAYOUT_KINDS])
  marked: Set<Int>
  mark := (first: Int, last: Int) ->
    for line in first..=last
      marked.add line if line in token_lines
  var off_line: Int?
  for comment in comments
    text := text_of(comment, lines)
    if text == '# fmt: skip'
      if comment.own_line
        var line = comment.line + 1
        line += 1 while line <= lines.length and line not in token_lines
        marked.add line
      else
        marked.add comment.line
    else if text == '# fmt: off'
      off_line = comment.line if off_line == nil
    else if text == '# fmt: on'
      if off := off_line
        mark off + 1, comment.line - 1
        off_line = nil
  mark off + 1, lines.length if off := off_line
  marked

# A layout token, as an INDENT, can share the position of the token after it, which is the one
# that starts there.
index_tokens := (tokens: Token[]) ->
  indexes: Map<Position, Int>
  for token at index in tokens
    indexes[token.position()] = index unless token.kind in LAYOUT_KINDS
  indexes

# A `;`, a line end that is written.
is_separator := (token: Token) -> token.kind == NEWLINE and not token.text.is_empty()

LAYOUT_KINDS: TokenKind[] = [NEWLINE, INDENT, DEDENT, EOF]

# The text of the comment as written, without the spaces after it, counted in code points from its
# column.
text_of := (comment: Comment, lines: String[]) ->
  scanner := scan(lines[comment.line - 1])
  scanner.next() for _ in 1..comment.column
  scanner.rest().trim_end()
