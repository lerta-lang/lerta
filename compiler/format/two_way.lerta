# Two-way values too long for one line by their leaves (see Branches): `c then a else b` whose
# condition or a value has more leaves than TWO_WAY_LEAVES is written as an `if`, and a chain of
# them, `a then x else b then y else z`, as a `case`. Where the value is the whole value of a
# statement on one line, which a block can hold, the formatter writes it so; elsewhere it reports
# it.
import
  Assignment, Conditional, Declaration, Expression, Interpolation, operands_of, Position, Return,
  Statement
from '../ast'
import CodePart from '../lexer/string_literal'
import CLOSING_BRACKETS, depth_change, Token, tokenize_fragment, TokenKind from '../lexer/tokens'
import COMPARISON_WORDS from '../parser/expression'
import Change, Edit from './edits'
import leaves, Span, TWO_WAY_LEAVES from './leaves'
import CHAINED_VALUES, LONG_TWO_WAY_VALUES, StyleRule from './rules'
import is_layout from './text'
import Tokens from './tokens'

# The conditionals of a chain, the first and those of the `else`s after it.
chain_of := (conditional: Conditional) ->
  links := [conditional]
  links.push links.last()!.else_value as Conditional! while is_chained(links.last()!)
  links

is_chained := (conditional: Conditional) ->
  not conditional.without_else and conditional.else_value is Conditional

# A chain, or a value with a part of more leaves than TWO_WAY_LEAVES, reported at its start, unless
# a statement's rewrite or the chain around it takes it, which `taken` holds; it takes the
# conditionals of the chain after it.
export long_two_way_report := (tokens: Tokens, conditional: Conditional, taken: Set<Expression>) ->
  taken.add link for link in chain_of(conditional)[1..]
  return nil if conditional in taken
  return interpolated_report(tokens, conditional) if tokens.at(conditional.position) == nil
  parts := parts_of(tokens, conditional) else return nil
  rule := rule_of(tokens.code, parts) else return nil
  tokens.report(rule, tokens.start(parts.first))

# The two-way values in the interpolations of the literal, where no walk of the places of the
# syntax tree goes, as their code is kept as written.
export interpolated_values := (literal: Interpolation): Conditional[] ->
  found: Conditional[]
  add := (value: Expression): void ->
    found.push value if value is Conditional
    add part for part in operands_of(value)
  add literal
  found

# A chain, or a long value, in an interpolation, which has no code tokens of its own: found in the
# code of the interpolation, and only reported, as that code is kept as written.
interpolated_report := (tokens: Tokens, conditional: Conditional) ->
  { position } := conditional
  literal := tokens.code.find((token) -> holds(token, position)) else return nil
  code := fragment_at(literal, position) else return nil
  at := code.find_index((token) -> token.position() == position) else return nil
  parts := parts_in(code, conditional, at) else return nil
  rule := rule_of(code, parts) else return nil
  tokens.report(rule, code[parts.first].position())

# The code tokens of the interpolation of the literal that holds `position`, where they are in the
# source, or of a literal inside it that holds it.
fragment_at := (literal: Token, position: Position): Token[]? ->
  parts := literal.parts else return nil
  for part in parts
    source := part as CodePart else continue
    fragment := tokenize_fragment(source.source, '', source.line, source.column)
    code := [token for token in fragment when not is_layout(token)]
    return code if code.any((token) -> token.position() == position)
    inner := code.find((token) -> holds(token, position)) else continue
    return fragment_at(inner, position)
  nil

# Whether the position is inside the literal's token, as that of a value in its interpolation is.
holds := (token: Token, position: Position) ->
  return false if token.parts == nil
  after_start := token.position().compare(position) == LESS
  end := Position(line: token.end_line, column: token.end_column)
  after_start and position.compare(end) == LESS

# The rule that the value breaks, if it breaks one.
export rule_of := (code: Token[], parts: Parts): StyleRule? ->
  return CHAINED_VALUES if parts.conditions.length > 1
  if is_long_two_way(code, parts.first, parts.last)
    LONG_TWO_WAY_VALUES
  else
    nil

# The value of a statement that a block in its place can hold.
export whole_value := (statement: Statement): Expression? ->
  case statement
    when Declaration, Assignment then statement.value
    when Return then statement.value
    when Conditional then statement
    else nil

# The whole value of the statement written as an `if` or a `case` in its place, where the statement
# is on one line.
export long_two_way_edit := (tokens: Tokens, statement: Statement): Edit? ->
  conditional := whole_value(statement) as Conditional else return nil
  parts := parts_of(tokens, conditional) else return nil
  rule := rule_of(tokens.code, parts) else return nil
  at := tokens.start(parts.first)

  # Parentheses around the whole value, which the rewrite of Parentheses takes out, go first.
  return tokens.report(rule, at) if is_wrapped(tokens, parts.first)
  return tokens.report(rule, at) unless is_on_one_line(tokens, parts)
  last := tokens.line_end(parts.first) else return tokens.report(rule, at)

  # Only the brackets that close around a body on the line of `->` may follow the value.
  after := tokens.code[(parts.last + 1)..=last]
  return tokens.report(rule, at) unless after.all((token) -> token.kind in CLOSING_BRACKETS)

  # The block goes one level deeper than the line of the value, which the layout then indents as
  # its rules have it. After `return`, or for a statement on the line of `->` or of an arm's `then`
  # or `else`, where no `if` can start, it goes on the lines below, as a body that its line cannot
  # hold does.
  line_columns := tokens.line_indentation(at.line) else 0
  var from = at
  var lead = ''
  var columns = line_columns
  head := parts.first - 1
  on_head_line := head >= 0 and tokens.code[head].end_line == at.line
  if statement is Return
    from = tokens.end(head)
    columns = line_columns + 2
    lead = "\n" + ' '.repeat(columns)
  else if on_head_line and statement is Conditional
    return tokens.report(rule, at) unless tokens.code[head].kind in HEAD_ENDS
    after_arm := tokens.is_kind(head, 'then')
    from = tokens.end(after_arm then head - 1 else head)
    columns = line_columns + 2
    lead = "\n" + ' '.repeat(columns)
  written := lead + two_way_block(tokens, parts, rule, columns)

  # The brackets after it go back to the line's depth below the block.
  closing :=
    if last > parts.last
      "\n" + ' '.repeat(line_columns)
    else
      ''
  change := Change(from, to: tokens.end(parts.last), text: written + closing)
  tokens.edit_at(rule, at, [change])

# The value written as an `if` or a `case` on a line `columns` deep, its branches below.
export two_way_block := (tokens: Tokens, parts: Parts, rule: StyleRule, columns: Int) ->
  inner := "\n" + ' '.repeat(columns + 2)
  slice := (span: Span) -> tokens.slice(tokens.start(span.first), tokens.end(span.last))
  otherwise := parts.otherwise then slice(parts.otherwise) else 'nil'
  if rule == CHAINED_VALUES
    arms := [
      "#{inner}when #{slice(condition)} then #{slice(parts.values[i])}"
      for condition at i in parts.conditions
    ]
    "case#{arms.join()}#{inner}else #{otherwise}"
  else
    outer := "\n" + ' '.repeat(columns)
    condition := slice(parts.conditions[0])
    "if #{condition}#{inner}#{slice(parts.values[0])}#{outer}else#{inner}#{otherwise}"

# The code tokens of a chain, from `first` up to `last`: the conditions before its `then`s, the
# values between them and their `else`s, and the value after the last `else`, if it has one.
export struct Parts
  first: Int
  last: Int
  conditions: Span[]
  values: Span[]
  otherwise: Span?

# Those of the chain, found by its `then`s and `else`s outside brackets up to the end of its
# statement; nil where they are not one for each link, as where the value is parenthesized.
export parts_of := (tokens: Tokens, conditional: Conditional): Parts? ->
  position := tokens.at(conditional.position) else return nil
  parts_in(tokens.code, conditional, position)

# Those of the chain whose position is that of the code token at `position`.
parts_in := (code: Token[], conditional: Conditional, position: Int): Parts? ->
  links := chain_of(conditional)
  last := statement_end(code, position)

  # The value in parentheses has the position of the outer `(`, inside which its words are.
  var first = position
  while first < last and code[first].kind == '(' and words_of(code, first, last).is_empty()
    first += 1
  words := words_of(code, first, last)
  ends_with_else := not links.last()!.without_else
  return nil if words.length != 2 * links.length - (ends_with_else then 0 else 1)
  conditions: Span[]
  values: Span[]
  var start = first
  for word at i in words
    is_then := i % 2 == 0
    expected: TokenKind = is_then then 'then' else 'else'
    return nil unless code[word].kind == expected
    span: Span = { first: start, last: word - 1 }
    if is_then
      conditions.push span
    else
      values.push span
    start = word + 1
  value_end := find_value_end(code, start, last)
  if ends_with_else
    return {
      first
      last: value_end
      conditions
      values
      otherwise: { first: start, last: value_end }
    }
  values.push { first: start, last: value_end }
  { first, last: value_end, conditions, values }

# Whether the parts are on one line, which the rewrites of a long value can move into a block.
export is_on_one_line := (tokens: Tokens, parts: Parts) ->
  tokens.code[parts.first].line == tokens.code[parts.last].end_line

# The last code token of the statement that holds the one at `first`: the last on a line where no
# bracket opened from `first` on is still open, and which ends with no operator or word that takes
# an operand after it, which is then on the next line.
statement_end := (code: Token[], first: Int) ->
  var depth = 0
  var at = first
  while at + 1 < code.length
    token := code[at]
    depth += depth_change(token.kind)
    ends_line := code[at + 1].line > token.end_line
    return at if depth <= 0 and ends_line and not takes_operand(token)
    at += 1
  at

# Whether an operand or a body follows the token, as after a binary operator, `then`, `else`, `not`
# or `->` (see parser/expression.lerta). Not after `<` or `>`, which may also close the type
# arguments that end a statement, as in `x is Box<Int>`.
takes_operand := (token: Token) ->
  token.kind in OPERAND_TAKERS or token.kind == IDENTIFIER and token.text in COMPARISON_WORDS

OPERAND_TAKERS: TokenKind[] =
  '+', '-', '|', '^', '*', '/', '%', '&', '**', '==', '!=', '<=', '>=', '..', '..=', 'then', 'else',
  'and', 'or', 'not', '->'

# Whether the value at `first` is in parentheses of its own, rather than those of a call.
export is_wrapped := (tokens: Tokens, first: Int) ->
  return false unless tokens.is_kind(first - 1, '(')
  opening := tokens.code[first - 1]
  callee_end := first > 1 and tokens.code[first - 2].kind in [IDENTIFIER, ')', ']']
  not callee_end or opening.spaced

# Whether the two-way value of the code tokens from `first` up to `last` is a chain or has a part
# of more leaves than TWO_WAY_LEAVES, which the rewrite of the value writes as an `if` or a `case`
# where a block can take it, and reports elsewhere.
export is_long_two_way := (code: Token[], first: Int, last: Int) ->
  words := words_of(code, first, last)
  return true if words.filter((word) -> code[word].kind == 'then').count() > 1
  var start = first
  for end in [words..., last + 1]
    return true if leaves(code, { first: start, last: end - 1 }) > TWO_WAY_LEAVES
    start = end + 1
  false

# The `then`s and `else`s outside brackets from `first` up to `last`, or up to where the value ends
# before it (see find_value_end). Only an `else` right after a `then` is the value's own: as the
# value of a `then` holds a fallback only in parentheses, any other is a fallback's, in a condition
# or in the last value.
words_of := (code: Token[], first: Int, last: Int) ->
  found: Int[]
  var depth = 0
  for at in first..=last
    { kind } := code[at]
    depth += depth_change(kind)
    return found if depth < 0 or (depth == 0 and kind in VALUE_ENDS)
    continue if depth != 0 or kind not in ['then', 'else']
    after_then := not found.is_empty() and code[found.last()!].kind == 'then'
    found.push at if kind == 'then' or after_then
  found

# The last token of the value that starts at `start`, before a bracket that closes around it, a
# comma, or the keyword of a postfix form.
find_value_end := (code: Token[], start: Int, last: Int) ->
  var depth = 0
  for at in start..=last
    { kind } := code[at]
    depth += depth_change(kind)
    return at - 1 if depth < 0 or (depth == 0 and kind in VALUE_ENDS)
  last

# The tokens that end the head of a body on their line: `->`, and the `then`, which the block below
# takes the place of, or the `else` of an arm.
HEAD_ENDS: TokenKind[] = ['->', 'then', 'else']

VALUE_ENDS: TokenKind[] = [',', 'if', 'unless', 'while', 'until', 'for']
