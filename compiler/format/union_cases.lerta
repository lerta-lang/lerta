# `x is A | B` for a `case` of types that gives `true` in one arm and `false` otherwise (see Union
# cases).
import
  BooleanLiteral, Call, Case, Expression, Identifier, Index, Member, NilLiteral, Statement, This
from '../ast'
import depth_change from '../lexer/tokens'
import is_value_type from '../checker/case_patterns'
import NodeFacts from '../checker/shared'
import inner_of, UnionType from '../types'
import UNION_CASES from './rules'
import statement_last from './expression_tokens'
import whole_value from './two_way'
import Change, Edit from './edits'
import Tokens from './tokens'

# The case that is the statement or its whole value, as `x := case ...`; one whose arms each return
# is one of a `return` first (see Branches).
export union_case := (tokens: Tokens, statement: Statement, facts: NodeFacts): Edit? ->
  value := whole_value(statement) as Case else statement as Case else return nil
  given := given_by_arm(value, facts) else return nil
  keyword := tokens.at(value.position) else return nil
  first_pattern := tokens.at(value.arms[0].patterns[0].position) else return nil
  when_at := first_pattern - 1
  return nil if not tokens.is_kind(keyword, 'case') or not tokens.is_word(when_at, 'when')
  types := pattern_texts(tokens, when_at) else return nil
  subject := tokens.slice(tokens.start(keyword + 1), tokens.end(when_at - 1))
  last := statement_last(tokens, keyword, tokens.line_indentation(tokens.code[keyword].line) else 0)
  word := given then 'is' else 'is not'
  change := Change
    text: "#{subject} #{word} #{types.join(' | ')}"
    from: tokens.start(keyword)
    to: tokens.end(last)
  tokens.edit_at(UNION_CASES, value.position, [change])

# What the one arm of a case of types gives, where its `else` gives the other Bool.
given_by_arm := (value: Case, facts: NodeFacts) ->
  return nil if value.arms.length != 1 or not is_plain_subject(value.subject)
  arm := value.arms[0]
  is_type := (pattern: Expression) -> pattern is not NilLiteral
  return nil if not branches_on_types(value.subject!, facts) or not arm.patterns.all(is_type)
  given := given_bool(arm.body) else return nil
  otherwise_body := value.otherwise else return nil
  otherwise := given_bool(otherwise_body) else return nil
  given != otherwise then given

# A subject that `is` binds tighter than, as the subject of a case binds whole.
export is_plain_subject := (subject: Expression?) ->
  subject is Identifier | Member | Call | Index | This

# The Bool of the body that is the literal alone.
given_bool := (body: Statement[]) ->
  return nil unless body.length == 1
  (body[0] as BooleanLiteral?)?.value

# Whether the patterns of a case of the subject are types, as they are where it is of a union of
# types that are no values, which the checking tells from its type.
export branches_on_types := (subject: Expression, facts: NodeFacts) ->
  written := facts.types[subject] else return false
  type := inner_of(written)
  type is UnionType and not is_value_type(type)

# The index after the patterns of the arm whose `when` is at `when_at`: its `then`, or the first
# token of its body on the lines below.
export patterns_end := (tokens: Tokens, when_at: Int) ->
  line := tokens.code[when_at].line
  var depth = 0
  var at = when_at + 1
  while at < tokens.code.length and tokens.code[at].line == line
    break if depth == 0 and tokens.is_kind(at, 'then')
    depth += depth_change(tokens.code[at].kind)
    at += 1
  at

# The patterns of the arm whose `when` is at `when_at`, each as written.
export pattern_texts := (tokens: Tokens, when_at: Int) ->
  texts: String[]
  end := patterns_end(tokens, when_at)
  var first = when_at + 1
  var depth = 0
  for at in first..=end
    if at == end or depth == 0 and tokens.is_kind(at, ',')
      return nil if at == first
      texts.push tokens.slice(tokens.start(first), tokens.end(at - 1))
      first = at + 1
    if at < end
      depth += depth_change(tokens.code[at].kind)
  texts
