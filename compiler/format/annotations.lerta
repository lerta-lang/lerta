# The types written in modules that their checking shows the checker can infer (see Type
# annotations in docs/reference/style.md), the enums of members that it shows are expected (see
# Enum members there), and the imports of enums that these leave unused, which `lerta fmt` leaves
# out.
import EnumDeclaration, Identifier, Node, Statement from '../ast'
import Located from '../errors'
import all_warnings from '../checker/diagnostics'
import check_program from '../checker/modules'
import ProgramWide, Shared from '../checker/shared'
import ExportRef, ImportedName from '../checker/imports'
import CompileError from '../errors'
import module_location from '../source'
import imported_files, is_standard_module, load_modules, Module, module_key from '../loader'
import format_type from '../types'
import Annotation, annotations_of from './annotated'
import inferable from './inferable'
import import_names_of, qualified_members_of from './qualified'

# What the checking of a program gives that an annotation can change: the type of each node of the
# modules that are not standard, with the type it is converted to, if any; the types of the fields,
# which code that the program does not hold, such as a module that imports the entry module, can
# rely on; and the warnings.
struct CheckResult(node_types: Map<Node, String>, field_types: String[], warnings: Located[])

# The keys (see annotation_key) of the annotations that can be left out of each of the files at
# `paths`, by the key of its module (see module_key); none for a file whose program does not check.
export removable_annotations := (paths: String[]) ->
  wanted: Set<String>
  wanted.add module_key(path) for path in paths
  removable: Map<String, String[]>
  for entry in [await not_imported(paths)..., paths...]
    await add_removable(removable, entry, wanted) if not removable.has(module_key(entry))
  removable

# Those of the files that none of them imports; all of them that do not parse.
not_imported := (paths: String[]) ->
  imported: Set<String>
  for path in paths
    keys :=
      try
        await imported_files(path)
      catch _: CompileError
        continue
    imported.add key for key in keys
  [path for path in paths when not imported.has(module_key(path))]

# The written types and the enums of members that may be left out, in the order of the source.
export left_out_candidates := (program: Statement[]) ->
  [annotations_of(program)..., qualified_members_of(program)..., import_names_of(program)...]

# The imports are left out after the others, once these leave them unused (see unused_enum_imports).
can_leave_out := (annotation: Annotation, shared: Shared, program: ProgramWide) ->
  return false if annotation.imported
  return shared.facts.unqualifiable.has(member) if member := annotation.member
  inferable annotation, shared, program

# A written type, or the enum of a member, of the module of `key`.
struct Placed(key: String, annotation: Annotation)

# Adds the removable annotations of the modules `wanted` that the program of `entry` holds and that
# have none yet, or none for `entry` if the program does not check. Those that the checking shows
# can be inferred are checked without them, to be sure: a type that alone uses an import, for one,
# still uses it (the import would be warned about without it).
add_removable := (removable: Map<String, String[]>, entry: String, wanted: Set<String>) ->
  modules :=
    try
      await load_modules(entry)
    catch _: CompileError
      removable[module_key(entry)] = []
      return
  checked := quiet_program(entry, modules)
  if not checks(checked)
    removable[module_key(entry)] = []
    return
  held :=
    [module for module in modules when wanted.has(module.key) and not removable.has(module.key)]
  inferred: Placed[]
  for module in held
    { key } := module
    removable[key] = []
    shared := checked.shared[module.index]
    for annotation in left_out_candidates(module.program)
      inferred.push Placed(key, annotation) if can_leave_out(annotation, shared, checked)
  return if inferred.length == 0
  original := result_of(checked)
  checks_the_same := (left_out: Placed[]) ->
    placed.annotation.remove() for placed in left_out
    tried := quiet_program(entry, modules)
    same := checks(tried) and same_result(result_of(tried), original)
    placed.annotation.restore() for placed in left_out
    same
  accepted := removable_among([], inferred, checks_the_same)
  imports := unused_enum_imports(accepted, held, checked, -> quiet_program(entry, modules))
  for placed in [accepted..., imports...]
    keys := removable[placed.key]!
    keys.push placed.annotation.key

# The imports of enums that the program used, but that it does not once the annotations accepted
# are left out, as the members of enums written alone or the types: the checking that accepts them
# does not tell their warnings (see result_of).
unused_enum_imports := (
  accepted: Placed[], held: Module[], checked: ProgramWide, program: () -> ProgramWide
): Placed[] ->
  return [] if accepted.length == 0
  placed.annotation.remove() for placed in accepted
  tried := program()
  checks tried
  found: Placed[]
  for module in held
    before := checked.shared[module.index].imports.names
    after := tried.shared[module.index].imports.names
    left_unused := (imported: Identifier) ->
      name := imported.name
      not after[name]!.used and before[name]!.used and imports_enum(tried, after[name]!)
    for annotation in import_names_of(module.program)
      found.push Placed(annotation, key: module.key) if left_unused(annotation.imported!)
  placed.annotation.restore() for placed in accepted
  found

imports_enum := (program: ProgramWide, imported: ImportedName) ->
  source := imported.source as ExportRef ? return false
  program.shared[source.module_index].exported[source.name] is EnumDeclaration

# `accepted` and those of `trying` that can be left out with them: all at once, or else found by
# halving `trying` until the parts that cannot be left out are single annotations, so that a module
# checks once, and few times more for the few that cannot. Which of those that can be left out
# alone but not together are left out depends on their order; those found are checked together, so
# a second run finds no more.
removable_among := (
  accepted: Placed[], trying: Placed[], checks_the_same: (Placed[]) -> Bool
): Placed[] ->
  return accepted if trying.length == 0
  all := [accepted..., trying...]
  return all if checks_the_same(all)
  return accepted if trying.length == 1
  half := trying.length / 2
  first := [placed for placed, i in trying when i < half]
  second := [placed for placed, i in trying when i >= half]
  removable_among removable_among(accepted, first, checks_the_same), second, checks_the_same

quiet_program := (entry_path: String, modules: Module[]) ->
  ProgramWide entry_path, modules, finds_all_errors: false

checks := (program: ProgramWide) ->
  try
    check_program program
    true
  catch _: CompileError
    false

result_of := (program: ProgramWide) ->
  node_types: Map<Node, String>
  for shared in program.shared
    continue if is_standard_module(program.modules[shared.index])
    { facts } := shared
    for (node, type) in facts.types.entries()
      converted := facts.conversions[node]
      conversion := converted then " => #{format_type(converted)}" else ''
      node_types[node] = format_type(type) + conversion
  warnings := [each for each in all_warnings(program) when not is_unused_enum(each, program)]
  CheckResult node_types, warnings, field_types: field_types(program)

# A warning of an import of an enum that is not used, which the members of the enum written alone
# or the types left out may make, and which unused_enum_imports then leaves out: one at the name of such an import.
is_unused_enum := (warning: Located, program: ProgramWide) ->
  at_import := (shared: Shared, imported: ImportedName) ->
    { position } := imported.name
    location := module_location(program.entry_path, program.modules[shared.index].display_path)
    placed := location == warning.location and position.line == warning.line
    placed and position.column == warning.column and imports_enum(program, imported)
  unused := 'is imported but never used'
  return false if not warning.message.ends_with(unused)
  program.shared.any (shared) ->
    shared.imports.names.values().any((imported) -> at_import(shared, imported))

# Whether the nodes that both results have have the same types. The checking makes nodes of its own,
# such as the `iter()` call of a `for` over an object, new each time, so each result has some that
# the other lacks; their types show in those of the nodes of the syntax tree, which a program that
# checks gives types to.
same_result := (a: CheckResult, b: CheckResult) ->
  same_type := (node: Node) ->
    b_type := b.node_types[node] ? return true
    a.node_types[node] == b_type
  same_types := a.node_types.keys().all(same_type)
  same_types and a.field_types == b.field_types and a.warnings == b.warnings

field_types := (program: ProgramWide) ->
  lines: String[]
  for info in program.infos.values()
    for field in info.fields
      type := field.type then format_type(field.type!) else '-'
      lines.push "#{info.type.symbol}.#{field.name.name}: #{type}"
  lines
