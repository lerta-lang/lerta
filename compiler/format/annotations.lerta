# The types written in modules that their checking shows the checker can infer (see Type
# annotations in docs/reference/style.md), the enums of members and the names of the constructions
# of structs that it shows are expected (see Expected types there), and the imports of the enums and
# the structs that these leave unused, which `lerta fmt` leaves out.
import Identifier, Node, Statement from '../ast'
import ProgramWide, Shared from '../checker/shared'
import CompileError from '../errors'
import imported_files, load_modules, Module, module_key from '../loader'
import ArrayType, MapType, SimpleType, Type from '../types'
import Annotation, annotations_of, key_position, Placed from './annotated'
import
  CheckResult, checks, imports_type, quiet_program, result_of, same_result
from './check_result'
import inferable from './inferable'
import import_names_of from './left_out_imports'
import rewrites_of from './rewrites'
import in_body, in_shared_body, shares_types from './shared_arms'

# The keys (see annotation_key) of the annotations that can be left out of each of the files at
# `paths`, by the key of its module (see module_key); none for a file whose program does not check.
export removable_annotations := (paths: String[]) ->
  wanted: Set<String>
  wanted.add module_key(path) for path in paths
  removable: Map<String, String[]>
  for entry in [await not_imported(paths)..., paths...]
    await add_removable(removable, entry, wanted) if not removable.has(module_key(entry))
  removable

# Those of the files that none of them imports; all of them that do not parse.
not_imported := (paths: String[]) ->
  imported: Set<String>
  for path in paths
    keys :=
      try
        await imported_files(path)
      catch _: CompileError
        continue
    imported.add key for key in keys
  [path for path in paths when not imported.has(module_key(path))]

# The written types, the enums of members and the names of constructions that may be left out, in
# the order of the source.
export left_out_candidates := (program: Statement[]) ->
  [annotations_of(program)..., rewrites_of(program)..., import_names_of(program)...]

# The imports are left out after the others, once these leave them unused (see unused_type_imports).
can_leave_out := (annotation: Annotation, shared: Shared, program: ProgramWide) ->
  return false if annotation.imported
  return shared.facts.unqualifiable.has(member) if member := annotation.member
  return shared.facts.recordable.has(call) if call := annotation.construction
  if call := annotation.shorthand
    return false if not shared.facts.object_constructions.has(call)
    left_out_cast := annotation.shorthand_cast ? return true
    return shared.facts.redundant_casts.has(left_out_cast)
  return shared.facts.redundant_casts.has(cast) if cast := annotation.cast
  if call := annotation.spread_copy
    return false if not shared.facts.full_constructions.has(call)
    { types } := shared.facts
    source_type := types[annotation.spread_source!] ? return false
    constructed := types[call] ? return false
    return source_type == constructed
  return has_is_empty(shared.facts.types[emptied]) if emptied := annotation.emptied
  # Not in the body of a generic function, whose types are those of its instances.
  return shared.facts.types.has(run[0].patterns[0]) if run := annotation.shared_arms
  inferable annotation, shared, program

# Whether std gives the type `is_empty` (see EMPTINESS_TESTS). One test serves the tests of a length
# and the comparisons with '': a `String` has no `length`, and nothing else compares with ''.
has_is_empty := (type: Type?) ->
  case type
    when ArrayType, MapType then true
    when SimpleType then type.kind == 'String' or type.kind == 'Binary'
    else false

# Adds the removable annotations of the modules `wanted` that the program of `entry` holds and that
# have none yet, or none for `entry` if the program does not check.
add_removable := (removable: Map<String, String[]>, entry: String, wanted: Set<String>) ->
  modules :=
    try
      await load_modules(entry)
    catch _: CompileError
      removable[module_key(entry)] = []
      return
  checked := quiet_program(entry, modules)
  if not checks(checked)
    removable[module_key(entry)] = []
    return
  held :=
    [module for module in modules when wanted.has(module.key) and not removable.has(module.key)]
  removable[module.key] = [] for module in held
  candidates := candidates_of(held, checked)
  return if candidates.is_empty()
  program := -> quiet_program(entry, modules)
  accepted := accepted_among(candidates, checked, program)
  imports := unused_type_imports(accepted, held, checked, program)
  for placed in [accepted..., imports...]
    keys := removable[placed.key]!
    keys.push placed.annotation.key

# The annotations of the modules that the checking shows can be left out.
candidates_of := (held: Module[], checked: ProgramWide) ->
  found: Placed[]
  for module in held
    shared := checked.shared[module.index]
    for annotation in left_out_candidates(module.program)
      found.push { annotation, key: module.key } if can_leave_out(annotation, shared, checked)
  found

# The candidates that `program`, checked anew, checks the same without, to be sure: a type that
# alone uses an import, for one, still uses it (the import would be warned about without it). The
# names of constructions are left out first, so that a type that gives the type expected of them is
# kept, as they would no longer show it; an import of a struct that only they use does not count
# then.
accepted_among := (candidates: Placed[], checked: ProgramWide, program: () -> ProgramWide) ->
  # The result of the program without the annotations, if it checks (see is_unused_type), and
  # whether it is `alike` while they are left out of the tree.
  tried_without := (left_out: Placed[], structs: Bool, alike: (CheckResult) -> Bool) ->
    placed.annotation.remove() for placed in left_out
    tried := program()
    result := checks(tried) then result_of(tried, structs)
    is_alike := result then alike(result) else false
    placed.annotation.restore() for placed in left_out
    { result, is_alike }
  result_without := (left_out: Placed[], structs: Bool) ->
    tried_without(left_out, structs, (_) -> true).result
  # Where `merging`, the types in the bodies of the arms made one are compared apart (see
  # in_shared_body and shares_types).
  checks_the_same := (original: CheckResult, structs: Bool, merging: Bool) ->
    (left_out: Placed[]) ->
      subjects: Set<String>
      for placed in left_out
        subjects.add subject.name if subject := placed.annotation.shared_subject
      shares := (result: CheckResult) ->
        not merging or left_out.all((placed) ->
          shares_types placed.annotation, subjects, original, result
        )
      { result, is_alike } := tried_without(left_out, structs, shares)
      found := result ? return false
      excused := (node: Node) -> merging and in_shared_body(left_out, found, node)
      is_alike and same_result(found, original, excused)
  constructions := [placed for placed in candidates when placed.annotation.construction]
  arms := [placed for placed in candidates when placed.annotation.shared_arms]
  is_other := (placed: Placed) ->
    not placed.annotation.construction and not placed.annotation.shared_arms
  others := [placed for placed in candidates when is_other(placed)]
  original := result_of(checked, true)
  recorded := removable_among([], constructions, checks_the_same(original, true, false))
  with_records := result_without(recorded, false)!
  # Before the others, which are then checked against the program with the arms made one, as a cast
  # that only the first arm's narrowing makes redundant.
  merged := removable_among(recorded, arms, checks_the_same(with_records, false, true))
  with_arms := result_without(merged, false)!
  # Nor are those in the body of arms made one, which the checking decided with the narrowing of the
  # first arm alone, as a cast that only that narrowing makes redundant.
  is_outside := (placed: Placed) ->
    at := key_position(placed.annotation.key)
    not merged.any((arms) -> arms.key == placed.key and in_body(arms, at))
  outside := [placed for placed in others when is_outside(placed)]
  removable_among merged, outside, checks_the_same(with_arms, false, false)

# The imports of enums and structs that the program used, but that it does not once the annotations
# accepted are left out, as the members of enums written alone, the constructions written as records
# or the types: the checking that accepts them does not tell their warnings (see result_of).
unused_type_imports := (
  accepted: Placed[], held: Module[], checked: ProgramWide, program: () -> ProgramWide
): Placed[] ->
  return [] if accepted.is_empty()
  placed.annotation.remove() for placed in accepted
  tried := program()
  checks tried
  found: Placed[]
  for module in held
    before := checked.shared[module.index].imports.names
    after := tried.shared[module.index].imports.names
    left_unused := (imported: Identifier) ->
      name := imported.name
      not after[name]!.used and before[name]!.used and imports_type(tried, after[name]!, true)
    for annotation in import_names_of(module.program)
      found.push { annotation, key: module.key } if left_unused(annotation.imported!)
  placed.annotation.restore() for placed in accepted
  found

# `accepted` and those of `trying` that can be left out with them: all at once, or else found by
# halving `trying` until the parts that cannot be left out are single annotations, so that a module
# checks once, and few times more for the few that cannot. Which of those that can be left out
# alone but not together are left out depends on their order; those found are checked together, so
# a second run finds no more.
removable_among := (
  accepted: Placed[], trying: Placed[], checks_the_same: (Placed[]) -> Bool
): Placed[] ->
  return accepted if trying.is_empty()
  all := [accepted..., trying...]
  return all if checks_the_same(all)
  return accepted if trying.length == 1
  half := trying.length / 2
  first := trying.slice(0, half)
  second := trying.slice(half)
  removable_among removable_among(accepted, first, checks_the_same), second, checks_the_same
