# The declarations other than those of consts and `var`s: classes, structs, interfaces, enums, type
# aliases, externs, extends and imports.
import
  EnumDeclaration, Extend, Extern, Identifier, Import, ImportName, InterfaceDeclaration,
  MemberDeclaration, Position, Statement, StringLiteral, TypeAlias, TypeDeclaration, UnionTypeName
from '../ast'
import breaking, choice, Doc, indent, join, line_feed, rule, separated, text, token from './doc'
import named_type, type_doc, type_parameters from './print_type'
import EXPECTED_TYPES, LONG_LISTS, MULTI_LINE_LITERALS from './rules'
import expression_doc, string_doc from './print_expression'
import value_after from './print_literal'
import
  Context, has_left_out_names, Item, keyword, lines_of_items, optional_doc, removed_type
from './printing'

export declaration_doc := (statement: Statement, context: Context) ->
  case statement
    when TypeDeclaration
      word := statement.is_struct then 'struct ' else 'class '
      head :=
        join([declared_head(word, statement, context), type_parameters(statement.type_params)])
      interface_type := statement.satisfies
      satisfies := interface_type then join([text(': '), named_type(interface_type)]) else text('')
      join [head, satisfies, members_doc(statement.members, context)]
    when InterfaceDeclaration
      head := join
        [declared_head('interface ', statement, context), type_parameters(statement.type_params)]
      join [head, members_doc(statement.members, context)]
    when EnumDeclaration
      head := declared_head('enum ', statement, context)
      members := [enum_member(member, context) for member in statement.members]
      join [head, indent(join([line_feed(), separated(members, line_feed())]))]
    when TypeAlias
      head := join([declared_head('type ', statement, context), text(' =')])
      join [head, aliased_type(statement, context)]
    when Extern
      parts :=
        exported(statement.exported, statement.position, context)
        keyword('extern ', statement.position)
        name_doc(statement.symbol)
      # Without `as`, the name is the symbol itself.
      if statement.name != statement.symbol
        parts.push join([text(' as '), name_doc(statement.name)])
      parts.push join([text(': '), type_doc(statement.type)])
      join parts
    when Extend
      head := join
        [
          keyword('extend', statement.position)
          type_parameters(statement.type_params)
          text(' ')
          type_doc(statement.type)
        ]
      join [head, members_doc(statement.members, context)]
    when Import then import_doc(statement, context)
    else text('')

type NamedDeclaration = TypeDeclaration | InterfaceDeclaration | EnumDeclaration | TypeAlias

# The start of a declaration: `export ` if it has it, the keyword, and the name.
declared_head := (word: String, statement: NamedDeclaration, context: Context) ->
  { position, name } := statement
  join [exported(statement.exported, position, context), keyword(word, position), name_doc(name)]

# `export ` before a declaration that has it, at the position of the token before the declaration.
export exported := (is_exported: Bool, at: Position, context: Context) ->
  return text('') unless is_exported
  source := context.source
  if index := source.token_at(at)
    if index > 0
      word := source.tokens[index - 1]
      return token('export ', word.position())
  text 'export '

name_doc := (name: Identifier) -> token(name.name, name.position)

members_doc := (members: MemberDeclaration[], context: Context) ->
  return text('') if members.is_empty()
  docs := [member_doc(member, context) for member in members]
  indent join([line_feed(), separated(docs, line_feed())])

# A member as parse_member reads it.
member_doc := (member: MemberDeclaration, context: Context) ->
  { modifier, type } := member
  parts: Doc[]
  parts.push keyword("#{modifier} ", member.position) if modifier
  parts.push name_doc(member.name)
  parts.push removed_type(FIELD, member.name.position, context)
  parts.push join([text(': '), type_doc(type)]) if type
  parts.push text('!') if member.throws
  if value := member.value
    operator := modifier or type then ' =' else ' :='
    if member.has_default
      parts.push join([text("#{operator} default "), expression_doc(value, context)])
    else
      parts.push join([text(operator), value_after(value, context)])
  join parts

enum_member := (member: Identifier | StringLiteral, context: Context) ->
  case member
    when Identifier then name_doc(member)
    when StringLiteral then string_doc(member, context)

# A union on the line, or on the indented lines below with as many members on each as fit; below,
# after a comment that ends the line of `=` (see follows_comment).
aliased_type := (alias: TypeAlias, context: Context) ->
  type := alias.type
  members :=
    type is UnionTypeName then [type_doc(member) for member in type.members] else [type_doc(type)]
  parts: Doc[]
  for member, i in members
    parts.push
      i == 0 then member else choice(join([text(' | '), member]), join([line_feed(), member]))
  below := indent(join([line_feed(), join(parts)]))
  return below if context.source.comment_before(type.position)
  on_line := join([text(' '), type_doc(type)])
  type is UnionTypeName then breaking(LONG_LISTS, on_line, below) else on_line

# `import a, b as c from 'module'`, or `export` before them, with the names in an indented block
# when they do not fit on the line (see Multi-line literals). One that names were left out of is
# reported for them, as is the layout that they change.
import_doc := (import_node: Import, context: Context) ->
  left_out := has_left_out_names(import_node, context)
  reported := left_out then EXPECTED_TYPES else MULTI_LINE_LITERALS
  word := keyword(import_node.exported then 'export' else 'import', import_node.position)
  module := module_doc(import_node, context)
  if import_node.names.is_empty()
    as_name := optional_doc(import_node.alias, (alias) ->
      join [text(' as '), token(alias.name, alias.position)]
    )
    written := join([word, text(' '), module, as_name])
    return left_out then rule(EXPECTED_TYPES, written) else written
  item := (name: ImportName) ->
    after_comment := context.source.comment_before(name.name.position)
    Item after_comment, doc: import_name(name), simple: true
  items := [item(name) for name in import_node.names]
  names := separated([item.doc for item in items], text(', '))
  on_line := join([word, text(' '), names, text(' from '), module])
  block := join
    [word, indent(join([line_feed(), lines_of_items(items)])), line_feed(), text('from '), module]
  doc := breaking(reported, on_line, block)
  left_out then rule(EXPECTED_TYPES, doc) else doc

import_name := (name: ImportName) ->
  if alias := name.alias
    join [name_doc(name.name), text(' as '), name_doc(alias)]
  else
    name_doc name.name

# The module's name as the source spells it, the string after `from`, or after `import` alone.
module_doc := (import_node: Import, context: Context) ->
  source := context.source
  start := source.token_at(import_node.position) ? return text("'#{import_node.module}'")
  end := source.tokens.length
  index := source.find(STRING, start, end) ? return text("'#{import_node.module}'")
  module := source.tokens[index]
  literal := StringLiteral(value: import_node.module, position: module.position())
  string_doc literal, context
