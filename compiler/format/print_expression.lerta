# Expressions, with the parentheses that their precedence needs and the style asks for (see
# Parentheses).
import
  ArrayLiteral, Await, BinaryOperation, Binding, BooleanLiteral, Call, Case, Cast, Coalesce,
  Comprehension, Conditional, Expression, FloatLiteral, FunctionLiteral, Identifier, If, Index,
  IntegerLiteral, Interpolation, IsTest, Jump, MapLiteral, Member, NilLiteral, Position, Range,
  RecordLiteral, Return, StringLiteral, This, Throw, Try, TupleItem, TupleLiteral, UnaryOperation,
  Unwrap, Yield
from '../ast'
import breaking, choice, Doc, indent, join, line_feed, rule, separated, text, token from './doc'
import named_type, type_arguments from './print_type'
import if_doc from './print_statement'
import CAST_FALLBACKS, LINE_LENGTH, NEGATED_IS_TESTS, PARENTHESES, STRING_LITERALS from './rules'
import
  array_doc, closing_at, item, map_doc, named_item, record_doc, value_after
from './print_literal'
import case_doc, function_doc, try_doc from './print_block'
import bracketed, Context, is_layout, keyword, word_before from './printing'

# Precedence levels, weakest first (see Operators in docs/reference/syntax.md).
const CONDITIONAL = 1
export const COALESCE = 2
const OR = 3
const AND = 4
const NOT = 5
const COMPARISON = 6
const RANGE = 7
const ADDITIVE = 8
const MULTIPLICATIVE = 9
const PREFIX = 10
const POSTFIX = 11
const PRIMARY = 12

export const expression_doc = (expression: Expression, context: Context) ->
  operand expression, context, 0, true

# The expression where it must bind at least as tightly as `level`. One that runs to the end of
# what holds it, as `return x` and a function literal do, can do so only `last`.
export const operand = (expression: Expression, context: Context, level: Int, last: Bool) ->
  const runs_on = runs_to_end(expression) and not last
  in_parentheses expression, context, precedence(expression) < level or runs_on

# Parentheses that the style asks for although the precedence does not.
export const clarified = (expression: Expression, context: Context) ->
  in_parentheses expression, context, true

const in_parentheses = (expression: Expression, context: Context, needed: Bool) ->
  const bare = bare_doc(expression, context)
  const was_in_parentheses = written_in_parentheses(expression, context)
  if needed
    const open = was_in_parentheses then token('(', expression.position) else text('(')
    return
      rule(PARENTHESES, join([open, bare_doc(expression, context.inside_brackets()), text(')')]))
  was_in_parentheses then rule(PARENTHESES, bare) else bare

# A parenthesized expression takes the position of its `(`.
const written_in_parentheses = (expression: Expression, context: Context) ->
  if const index = context.source.token_at(expression.position)
    return context.source.tokens[index].kind == '(' and not starts_with_parenthesis(expression)
  false

# The expressions whose own first token is a `(`.
const starts_with_parenthesis = (expression: Expression) ->
  expression is TupleLiteral or expression is FunctionLiteral or is_lazy(expression)

const is_lazy = (expression: Expression) -> expression is Comprehension and expression.lazy != nil

const precedence = (expression: Expression) ->
  case expression
    when Conditional then CONDITIONAL
    when Coalesce then cast_of(expression) then COMPARISON else COALESCE
    when BinaryOperation then binary_precedence(expression.operator)
    when UnaryOperation then expression.operator == 'not' then NOT else PREFIX
    when IsTest, Cast then COMPARISON
    when Range then RANGE
    when Await then PREFIX
    when Unwrap, Call, Member, Index then POSTFIX
    when If then expression.nil_safe then POSTFIX else PRIMARY
    else PRIMARY

const binary_precedence = (operator: String) ->
  case operator
    when 'or' then OR
    when 'and' then AND
    when '+', '-' then ADDITIVE
    when '*', '/', '%' then MULTIPLICATIVE
    else COMPARISON

# Whether what follows it on its line would be taken into it.
const runs_to_end = (expression: Expression) ->
  case expression
    when Return then expression.value != nil
    when Throw, Yield, FunctionLiteral, Case, Try then true
    when If then not expression.nil_safe
    # Its fallback runs on as that of `?` does.
    when Coalesce then cast_of(expression) != nil
    else false

const bare_doc = (expression: Expression, context: Context): Doc ->
  case expression
    when Identifier then identifier(expression)
    when StringLiteral then string_doc(expression, context)
    when Interpolation then spelled(expression.position, context)
    when IntegerLiteral, FloatLiteral then spelled(expression.position, context)
    when BooleanLiteral then token(expression.value.to_string(), expression.position)
    when NilLiteral then token('nil', expression.position)
    when This then token('@', expression.position)
    when Member then member_doc(expression, context)
    when Index
      const object = operand(expression.object, context, POSTFIX, false)
      const index = expression_doc(expression.index, context.inside_brackets())
      join [object, text('['), index, text(']')]
    when Unwrap then join([operand(expression.operand, context, POSTFIX, false), text('!')])
    when Call then call_doc(expression, context)
    when UnaryOperation then unary_doc(expression, context)
    when BinaryOperation then binary_doc(expression, context)
    when Range
      const start = range_end(expression.start, context, false)
      join [start, text('...'), range_end(expression.end, context, true)]
    when IsTest then is_doc(expression, context, ' is ')
    when Cast then cast_doc(expression, context, expression.throws then '!' else '?')
    when Conditional then conditional_doc(expression, context)
    when Coalesce
      const fallback = operand(expression.fallback, context, COALESCE, true)
      if const cast = cast_of(expression)
        # The style's part starts where the old form differs: at the `(` around the cast, if any.
        const written_cast = cast_doc(cast, context, '')
        if written_in_parentheses(cast, context)
          return join([rule(CAST_FALLBACKS, join([written_cast, text(' ? ')])), fallback])
        return join([written_cast, rule(CAST_FALLBACKS, text(' ? ')), fallback])
      join [operand(expression.value, context, OR, false), text(' ? '), fallback]
    when Await
      join [
        keyword('await ', expression.position)
        operand(expression.operand, context, PREFIX, true)
      ]
    when Throw
      join [keyword('throw ', expression.position), expression_doc(expression.message, context)]
    when Yield
      join [keyword('yield ', expression.position), expression_doc(expression.value, context)]
    when Return
      const word = keyword('return', expression.position)
      if const value = expression.value
        join [word, value_after(value, context)]
      else
        word
    when Jump then token(expression.kind.to_string(), expression.position)
    when ArrayLiteral then array_doc(expression, context)
    when MapLiteral then map_doc(expression, context)
    when RecordLiteral then record_doc(expression, context)
    when TupleLiteral
      const items = [item(element, context.inside_brackets()) for element in expression.items]
      bracketed(
        token('(', expression.position)
        items
        ')'
        closing_at(expression.position, context)
      )
    when Comprehension then comprehension_doc(expression, context)
    when FunctionLiteral then function_doc(expression, context)
    when Case then case_doc(expression, context)
    when If
      expression.nil_safe then nil_safe_doc(expression, context) else if_doc(expression, context)
    when Try then try_doc(expression, context)
    when TupleItem then text('')

# A name that the parser makes for `x?.rest` stands for what is before `?.`, which is printed
# instead.
const identifier = (name: Identifier) ->
  name.name.starts_with('?') then text('') else token(name.name, name.position)

# The literal as written in the source; `-1` is two tokens there.
const spelled = (at: Position, context: Context) ->
  const source = context.source
  const index = literal_token(at, context) ? return text('')
  const first = source.tokens[index]
  return token("-#{source.spelling(source.tokens[index + 1])}", at) if first.kind == '-'
  token source.spelling(first), at

# The index of the literal's token at the position, past the parentheses that it was written in,
# which give it their position.
const literal_token = (at: Position, context: Context) ->
  const tokens = context.source.tokens
  var index = context.source.token_at(at) ? return nil
  index += 1 while tokens[index].kind == '('
  index

# A string as written, but with `'...'` where it can be (see String literals): where its text holds
# no `'` and no control character.
export const string_doc = (literal: StringLiteral, context: Context) ->
  const source = context.source
  const index = literal_token(literal.position, context) ? return text("'#{literal.value}'")
  const written = source.spelling(source.tokens[index])
  const is_double = written.starts_with('"')
  # A `\u{...}` escape writes a character that would not be seen, or told apart, as it is.
  const keeps_escapes = written.split('\u{').length > 1
  const fits = is_double and not keeps_escapes and fits_single_quotes(literal.value)
  return token(written, literal.position) if not fits
  rule STRING_LITERALS, token("'#{literal.value}'", literal.position)

const fits_single_quotes = (value: String) ->
  for byte in value.binary
    return false if byte == "'" or byte < 0x20 or byte == 0x7F
  true

const member_doc = (member: Member, context: Context) ->
  const name = token(member.name.name, member.name.position)
  return join([token('@', member.object.position), name]) if member.object is This
  join [operand(member.object, context, POSTFIX, false), text('.'), name]

const unary_doc = (unary: UnaryOperation, context: Context) ->
  if unary.operator == 'not'
    const test = unary.operand as IsTest?
    return is_not_doc(test, context) if test
    # `not x is not T` would read as two tests.
    const operand_doc =
      if is_negated_is_test(unary.operand)
        clarified unary.operand, context
      else
        operand unary.operand, context, NOT, true
    return join([keyword('not ', unary.position), operand_doc])
  # `-1` would be a literal of its own.
  const literal = unary.operand is IntegerLiteral or unary.operand is FloatLiteral
  const operand_doc =
    if literal
      clarified unary.operand, context
    else
      operand unary.operand, context, PREFIX, true
  join [token('-', unary.position), operand_doc]

const binary_doc = (binary: BinaryOperation, context: Context) ->
  const level = binary_precedence(binary.operator)
  const left_level = level == COMPARISON then RANGE else level
  const right_level = level == COMPARISON then RANGE else level + 1
  const side = (child: Expression, child_level: Int, last: Bool) ->
    # `and` mixed with `or` is clarified (see Parentheses).
    const mixes = binary.operator == 'or' and child is BinaryOperation and child.operator == 'and'
    mixes then clarified(child, context) else operand(child, context, child_level, last)
  const left = side(binary.left, left_level, false)
  join [left, text(" #{binary.operator} "), side(binary.right, right_level, true)]

# An end of a range that is an operation is in parentheses (see Ranges).
const range_end = (end: Expression, context: Context, last: Bool) ->
  const is_operation = end is BinaryOperation or end is UnaryOperation
  is_operation then clarified(end, context) else operand(end, context, ADDITIVE, last)

# A `then`/`else` inside the `then` value of another is in parentheses (see Parentheses).
const conditional_doc = (conditional: Conditional, context: Context) ->
  const condition = operand(conditional.condition, context, COALESCE, false)
  const then_value =
    if conditional.then_value is Conditional
      clarified conditional.then_value, context
    else
      operand conditional.then_value, context, CONDITIONAL, false
  const head = join([condition, text(' then '), then_value])
  return head if conditional.without_else
  join [head, text(' else '), operand(conditional.else_value, context, CONDITIONAL, true)]

# `x?.rest`, which the parser reads as an `if` that binds x (see parse_nil_safe).
const nil_safe_doc = (nil_safe: If, context: Context) ->
  const binding = nil_safe.condition as Binding!
  const object = operand(binding.value, context, POSTFIX, false)
  const rest = nil_safe.then_body[0] as Expression!
  join [object, text('?'), bare_doc(rest, context)]

export const call_doc = (call: Call, context: Context) ->
  const callee = operand(call.callee, context, POSTFIX, false)
  const inside = context.inside_brackets()
  const items = arguments(call, inside)
  const open = join([callee, type_arguments(call.type_args), text('(')])
  bracketed open, items, ')', arguments_closing_at(call, context)

# Where the parenthesis that closes the arguments is in the source: the one that closes the
# parenthesis before the first argument, if the source has the arguments in parentheses.
const arguments_closing_at = (call: Call, context: Context) ->
  const first =
    if call.args.length > 0
      call.args[0].position
    else if call.named_args.length > 0
      call.named_args[0].name.position
    else
      return nil
  const source = context.source
  var index = source.token_at(first) ? return nil
  index -= 1 while index > 0 and is_layout(source.tokens[index - 1].kind)
  index -= 1
  return nil if index < 0 or source.tokens[index].kind != '('
  const open = source.tokens[index]
  closing_at Position(line: open.line, column: open.column), context

export const arguments = (call: Call, context: Context) ->
  const positional = [item(arg, context) for arg in call.args]
  const named = [named_item(named, context) for named in call.named_args]
  [positional..., named...]

const comprehension_doc = (comprehension: Comprehension, context: Context) ->
  const inside = context.inside_brackets()
  if comprehension.spread
    return join([operand(comprehension.iterable, inside, ADDITIVE, false), text('...')])
  const forms = comprehension_forms(comprehension, context)
  breaking LINE_LENGTH, forms.flat, forms.broken

# A comprehension on one line, and broken: on a line of its own inside the brackets, and on a line
# for each part if it does not fit there either.
export const comprehension_forms = (comprehension: Comprehension, context: Context) ->
  const inside = context.inside_brackets()
  const element = expression_doc(comprehension.element, inside)
  const header =
    loop_header(comprehension.variable, comprehension.index, comprehension.iterable, inside)
  const parts = [element, header]
  if const guard = comprehension.guard
    parts.push join([text('when '), expression_doc(guard, inside)])
  const lazy = comprehension.lazy != nil
  const open = token(lazy then '(' else '[', comprehension.position)
  const close = lazy then ')' else ']'
  const one_line = separated(parts, text(' '))
  const flat = join([open, one_line, text(close)])
  const lines = choice(one_line, separated(parts, line_feed()))
  const broken = join([open, indent(join([line_feed(), lines])), line_feed(), text(close)])
  { flat, broken }

# `for x in xs`, `for x, i in xs` or `for (a, b) in xs`, whose names the source has, as the parser
# keeps none for a part that is `_`.
export const loop_header = (
  variable: Identifier, index: Identifier?, iterable: Expression, context: Context
) ->
  const names =
    if variable.name.starts_with('_tuple.')
      tuple_names variable.position, context
    else
      token variable.name, variable.position
  const parts = [names]
  parts.push join([text(', '), token(at.name, at.position)]) if const at = index
  const with_index = join(parts)
  const word = word_before(variable.position, 'for', context)
  join [word, text(' '), with_index, text(' in '), expression_doc(iterable, context)]

# The names in the parentheses at the position, as the source has them.
const tuple_names = (open_at: Position, context: Context) ->
  const source = context.source
  const open = source.token_at(open_at) ? return text('()')
  const close = source.closing(open)
  const names = [
    token(
      source.spelling(source.tokens[i])
      Position(line: source.tokens[i].line, column: source.tokens[i].column)
    )
    for i in (open + 1)...close
    when source.tokens[i].kind == IDENTIFIER
  ]
  join [token('(', open_at), separated(names, text(', ')), text(')')]

const is_doc = (test: IsTest, context: Context, word: String) ->
  join [operand(test.value, context, RANGE, false), text(word), named_type(test.type)]

# `not (x is T)` is written `x is not T` (see Negated is tests).
const is_not_doc = (test: IsTest, context: Context) ->
  rule NEGATED_IS_TESTS, is_doc(test, context, ' is not ')

const is_negated_is_test = (expression: Expression) ->
  const unary = expression as UnaryOperation? ? return false
  unary.operator == 'not' and unary.operand is IsTest

# `x as T`, then `form`. The `?` of `as T?` is read as the type's, so it is not printed with it.
const cast_doc = (cast: Cast, context: Context, form: String) ->
  const value = operand(cast.value, context, RANGE, false)
  const { name, args, position } = cast.type
  join [value, text(' as '), token(name, position), type_arguments(args), text(form)]

# `(x as T?) ? y`, written `x as T ? y` (see Cast fallbacks).
const cast_of = (coalesce: Coalesce) ->
  const cast = coalesce.value as Cast? ? return nil
  cast.throws then nil else cast
