# Expressions, with the parentheses that their precedence needs and the style asks for (see
# Parentheses).
import
  ArrayLiteral, Await, BinaryOperation, Binding, BooleanLiteral, Call, Case, Cast, Coalesce,
  Comprehension, Conditional, Expression, FloatLiteral, FunctionLiteral, Identifier, If, Index,
  IntegerLiteral, Interpolation, IsTest, Jump, MapLiteral, Member, NilLiteral, Position, Range,
  RecordLiteral, Return, StringLiteral, This, Throw, Try, TupleItem, TupleLiteral, UnaryOperation,
  Unwrap, Yield
from '../ast'
import Token from '../lexer/tokens'
import common_indentation, is_blank from '../lexer/string_literal'
import
  breaking, choice, closing, Doc, indent, join, line_feed, LiteralLines, rule, separated, text,
  token
from './doc'
import type_arguments from './print_type'
import if_doc, is_command_callee from './print_statement'
import annotation_key from './annotated'
import
  ADDITIVE, binary_doc, cast_doc, coalesce_doc, conditional_doc, is_doc, POSTFIX, precedence,
  PREFIX, range_doc, unary_doc
from './print_operation'
import EXPECTED_TYPES, LINE_LENGTH, PARENTHESES, SHORTHAND, STRING_LITERALS from './rules'
import
  array_doc, closing_at, item, map_doc, named_item, record_doc, value_after
from './print_literal'
import case_doc, function_doc, try_doc from './print_block'
import
  bracketed, bracketed_or, Context, is_layout, Item, keyword, lines_of_items, opened_list,
  optional_doc, word_before
from './printing'

export expression_doc := (expression: Expression, context: Context) ->
  operand expression, context, 0, true

# The expression where it must bind at least as tightly as `level`. One that runs to the end of
# what holds it, as `return x` and a function literal do, can do so only `last`. An operand of
# another expression, at a level above 0, breaks no operation outside brackets (see Context).
export operand := (expression: Expression, context: Context, level: Int, last: Bool) ->
  runs_on := runs_to_end(expression) and not last
  inner := level > 0 then context.unbroken() else context
  in_parentheses expression, inner, precedence(expression) < level or runs_on

# Parentheses that the style asks for although the precedence does not.
export clarified := (expression: Expression, context: Context) ->
  in_parentheses expression, context, true

in_parentheses := (expression: Expression, context: Context, needed: Bool) ->
  bare := reported_doc(expression, context, bare_doc(expression, context))
  was_in_parentheses := written_in_parentheses(expression, context)
  if needed
    open := was_in_parentheses then token('(', expression.position) else text('(')
    # Broken there, an operation would end its last line with the `)`, rather than put it on a
    # line of its own (see Layout).
    inside_parentheses := context.inside_brackets().unbroken()
    return rule(PARENTHESES, join([open, bare_doc(expression, inside_parentheses), text(')')]))
  was_in_parentheses then rule(PARENTHESES, bare) else bare

# An expression written in place of another, which reports its rule, and where the other ended.
reported_doc := (expression: Expression, context: Context, doc: Doc) ->
  reported := context.reported[expression] ? return doc
  join [rule(reported, doc), rule(reported, text(''))]

# A parenthesized expression takes the position of its `(`.
export written_in_parentheses := (expression: Expression, context: Context) ->
  if index := context.source.token_at(expression.position)
    return context.source.tokens[index].kind == '(' and not starts_with_parenthesis(expression)
  false

# The expressions whose own first token is a `(`.
starts_with_parenthesis := (expression: Expression) ->
  expression is TupleLiteral or expression is FunctionLiteral or is_lazy(expression)

is_lazy := (expression: Expression) -> expression is Comprehension and expression.lazy != nil

# Whether what follows it on its line would be taken into it.
runs_to_end := (expression: Expression): Bool ->
  case expression
    when Return then expression.value != nil
    when Throw, Yield, FunctionLiteral, Case, Try then true
    when If then not expression.nil_safe
    when Coalesce then runs_to_end(expression.fallback)
    else false

bare_doc := (expression: Expression, context: Context): Doc ->
  case expression
    when Identifier then identifier(expression, context)
    when StringLiteral then string_doc(expression, context)
    when Interpolation, IntegerLiteral, FloatLiteral then spelled(expression.position, context)
    when BooleanLiteral then token(expression.value.to_string(), expression.position)
    when NilLiteral then token('nil', expression.position)
    when This then token('@', expression.position)
    when Member then member_doc(expression, context)
    when Index
      object := operand(expression.object, context, POSTFIX, false)
      join [object, index_doc(expression, context)]
    when Unwrap then join([operand(expression.operand, context, POSTFIX, false), text('!')])
    when Call then call_doc(expression, context, false)
    when UnaryOperation then unary_doc(expression, context)
    when BinaryOperation then binary_doc(expression, context)
    when Range then range_doc(expression, context)
    when IsTest then is_doc(expression, context, ' is ')
    when Cast then cast_doc(expression, context, expression.throws then '!' else '?')
    when Conditional then conditional_doc(expression, context)
    when Coalesce then coalesce_doc(expression, context)
    when Await
      join [
        keyword('await ', expression.position)
        operand(expression.operand, context, PREFIX, true)
      ]
    when Throw
      join [keyword('throw ', expression.position), expression_doc(expression.message, context)]
    when Yield
      join [keyword('yield ', expression.position), expression_doc(expression.value, context)]
    when Return
      word := keyword('return', expression.position)
      join [word, optional_doc(expression.value, (value) -> value_after(value, context))]
    when Jump then token(expression.kind.to_string(), expression.position)
    when ArrayLiteral then array_doc(expression, context)
    when MapLiteral then map_doc(expression, context)
    when RecordLiteral then record_doc(expression, context)
    when TupleLiteral
      items := [item(element, context.inside_brackets()) for element in expression.items]
      bracketed
        token('(', expression.position)
        items
        ')'
        closing_at(expression.position, context)
    when Comprehension then comprehension_doc(expression, context)
    when FunctionLiteral then function_doc(expression, context)
    when Case then case_doc(expression, context)
    when If
      expression.nil_safe then nil_safe_doc(expression, context) else if_doc(expression, context)
    when Try then try_doc(expression, context)
    when TupleItem then text('')

# A name that the parser makes for `x?.rest` stands for what is before `?.`, which is printed
# instead.
# A member of an enum written alone in place of `E.MEMBER` (see rewrites_of) is reported
# there.
identifier := (name: Identifier, context: Context) ->
  return text('') if name.name.starts_with('?')
  written := token(name.name, name.position)
  key := annotation_key('member', name.position)
  key in context.left_out then rule(EXPECTED_TYPES, written) else written

# The literal as written in the source; `-1` is two tokens there.
spelled := (at: Position, context: Context) ->
  source := context.source
  index := literal_token(at, context) ? return text('')
  first := source.tokens[index]
  return token("-#{source.spelling(source.tokens[index + 1])}", at) if first.kind == '-'
  return multiline_string_doc(first, context) if first.end_line > first.line
  token source.spelling(first), at

# A `"""` or `'''` literal, whose lines go one level deeper than the line that it starts on,
# without the indentation that they share in the source, and a blank one empty.
multiline_string_doc := (literal: Token, context: Context) ->
  source := context.source
  lines := [source.lines[line - 1] for line in (literal.line + 1)...literal.end_line]
  quotes_column := literal.end_column - 3
  lines.push source.slice(literal.end_line, 1, quotes_column)
  quotes := source.slice(literal.end_line, quotes_column, literal.end_column)
  width := common_indentation(lines)
  dedented :=
    [is_blank(line) then '' else line.binary.text(width, line.binary.length)! for line in lines]
  dedented.push "#{dedented.pop()}#{quotes}"
  first := token(quotes, literal.position())
  join [first, LiteralLines(lines: dedented, end_line: literal.end_line)]

# The index of the literal's token at the position, past the parentheses that it was written in,
# which give it their position.
literal_token := (at: Position, context: Context) ->
  tokens := context.source.tokens
  var index = context.source.token_at(at) ? return nil
  index += 1 while tokens[index].kind == '('
  index

# `[i]` after what is indexed, or `[k, default: d]` of a map, whose key and default go on lines of
# their own where they do not fit on one, as a call's arguments do.
export index_doc := (index: Index, context: Context) ->
  inside := context.inside_brackets()
  default_value := index.default_value
  return join([text('['), expression_doc(index.index, inside), text(']')]) if default_value == nil
  named_default := join([text('default: '), expression_doc(default_value, inside)])
  items := [item(index.index, inside), Item(doc: named_default, simple: false)]
  bracketed text('['), items, ']', nil

# A string as written, but with `'...'` where it can be (see String literals): where its text holds
# no `'` and no control character.
export string_doc := (literal: StringLiteral, context: Context) ->
  source := context.source
  index := literal_token(literal.position, context) ? return text("'#{literal.value}'")
  first := source.tokens[index]
  return multiline_string_doc(first, context) if first.end_line > first.line
  written := source.spelling(first)
  is_double := written.starts_with('"')
  # A `\u{...}` escape writes a character that would not be seen, or told apart, as it is.
  keeps_escapes := written.split('\u{').length > 1
  fits := is_double and not keeps_escapes and fits_single_quotes(literal.value)
  return token(written, literal.position) if not fits
  rule STRING_LITERALS, token("'#{literal.value}'", literal.position)

fits_single_quotes := (value: String) ->
  for byte in value.binary
    return false if byte == "'" or byte < 0x20 or byte == 0x7F
  true

member_doc := (member: Member, context: Context) ->
  name := token(member.name.name, member.name.position)
  return join([token('@', member.object.position), name]) if member.object is This
  join [operand(member.object, context, POSTFIX, false), text('.'), name]

# `x?.rest`, which the parser reads as an `if` that binds x (see parse_nil_safe).
nil_safe_doc := (nil_safe: If, context: Context) ->
  binding := nil_safe.condition as Binding!
  object := operand(binding.value, context, POSTFIX, false)
  rest := nil_safe.then_body[0] as Expression!
  join [object, text('?'), bare_doc(rest, context)]

# `whole` tells that the call is a statement or a whole value, which may take its arguments in a
# block (see takes_block_arguments).
export call_doc := (call: Call, context: Context, whole: Bool) ->
  callee := operand(call.callee, context, POSTFIX, false)
  inside := context.inside_brackets()
  items := arguments(call, inside)
  open := join([callee, type_arguments(call.type_args), text('(')])
  closing_text := closing(')', arguments_closing_at(call, context))
  opened :=
    if whole and takes_block_arguments(call, context)
      indent join([callee, line_feed(), lines_of_items(items)])
    else
      opened_list open, items, closing_text
  bracketed_or open, items, closing_text, opened

# Whether a call whose arguments do not fit on its line can take them in a block below it, without
# parentheses (see Long lists): one on a line of its own, outside brackets, with arguments and the
# callee of a call without parentheses, which `f<T>`, `g(x)` or `fs[0]` is not.
export takes_block_arguments := (call: Call, context: Context) ->
  has_arguments := not call.args.is_empty() or not call.named_args.is_empty()
  plain_callee := call.type_args.is_empty() and is_command_callee(call.callee)
  context.on_own_line and not context.in_brackets and plain_callee and has_arguments

# Where the parenthesis that closes the arguments is in the source: the one that closes the
# parenthesis before the first argument, if the source has the arguments in parentheses.
arguments_closing_at := (call: Call, context: Context) ->
  first :=
    if not call.args.is_empty()
      call.args[0].position
    else if not call.named_args.is_empty()
      call.named_args[0].name.position
    else
      return nil
  source := context.source
  var index = source.token_at(first) ? return nil
  index -= 1 while index > 0 and is_layout(source.tokens[index - 1].kind)
  index -= 1
  return nil if index < 0 or source.tokens[index].kind != '('
  open := source.tokens[index]
  closing_at open.position(), context

export arguments := (call: Call, context: Context) ->
  positional := [positional_item(arg, context) for arg in call.args]
  named := [named_item(named, context) for named in call.named_args]
  [positional..., named...]

# A name alone for the argument of its name, which reports where its value was left out (see
# Shorthand).
positional_item := (arg: Expression, context: Context) ->
  written := item(arg, context)
  return written if not context.left_out.contains(annotation_key('shorthand', arg.position))
  doc := join([rule(SHORTHAND, written.doc), rule(SHORTHAND, text(''))])
  Item doc, simple: written.simple, after_comment: written.after_comment

comprehension_doc := (comprehension: Comprehension, context: Context) ->
  inside := context.inside_brackets()
  if comprehension.spread
    return join([operand(comprehension.iterable, inside, ADDITIVE, false), text('...')])
  forms := comprehension_forms(comprehension, context)
  breaking LINE_LENGTH, forms.flat, forms.broken

# A comprehension on one line, and broken: on a line of its own inside the brackets, and on a line
# for each part if it does not fit there either.
export comprehension_forms := (comprehension: Comprehension, context: Context) ->
  inside := context.inside_brackets()
  element := expression_doc(comprehension.element, inside)
  header := loop_header(comprehension.variable, comprehension.index, comprehension.iterable, inside)
  parts := [element, header]
  parts.push join([text('when '), expression_doc(guard, inside)]) if guard := comprehension.guard
  lazy := comprehension.lazy != nil
  open := token(lazy then '(' else '[', comprehension.position)
  close := lazy then ')' else ']'
  one_line := separated(parts, text(' '))
  flat := join([open, one_line, text(close)])
  lines := choice(one_line, separated(parts, line_feed()))
  broken := join([open, indent(join([line_feed(), lines])), line_feed(), text(close)])
  { flat, broken }

# `for x in xs`, `for x, i in xs` or `for (a, b) in xs`, whose names the source has, as the parser
# keeps none for a part that is `_`.
export loop_header := (
  variable: Identifier, index: Identifier?, iterable: Expression, context: Context
) ->
  names :=
    if variable.name.starts_with('_tuple.')
      tuple_names variable.position, context
    else
      token variable.name, variable.position
  parts := [names]
  parts.push join([text(', '), token(at.name, at.position)]) if at := index
  with_index := join(parts)
  word := word_before(variable.position, 'for', context)
  join [word, text(' '), with_index, text(' in '), expression_doc(iterable, context)]

# The names in the parentheses at the position, as the source has them.
tuple_names := (open_at: Position, context: Context) ->
  source := context.source
  open := source.token_at(open_at) ? return text('()')
  close := source.closing(open)
  names := [
    token(source.spelling(source.tokens[i]), source.tokens[i].position())
    for i in (open + 1)...close
    when source.tokens[i].kind == IDENTIFIER
  ]
  join [token('(', open_at), separated(names, text(', ')), text(')')]
