# What the formatter prints, before it is laid out in lines (see docs/internals.md#formatter).
import Position from '../ast'
import Comment from '../lexer/tokens'
import StyleRule from './rules'
import columns, SourceText from './source'

# Holds no line feed. `at` is where the token that it prints is in the source, if it is one.
export struct Text
  text: String
  at: Position? = default nil
  # A closing bracket, before which a comment that ends the line of the last item stays at the end
  # of the line, after the bracket, while one on a line of its own stays inside.
  closes = default false

# Line feeds, `count` of them, after which the next text is indented as deep as the Indents around
# it.
export struct Newline
  count: Int

export struct Indent
  doc: Doc

export struct Concat
  docs: Doc[]

# `flat` where its first line fits on the rest of the line, with what follows it up to the next
# line feed, and otherwise `broken`. A part such as the block of a `case` is laid out on lines of
# its own either way. `flat` fits nowhere if a comment of the source is between its texts on its
# first line.
export struct Choice
  flat: Doc
  broken: Doc
  # The rule that decides the part where it is broken, which a part that fits leaves to others.
  breaking_rule: StyleRule? = default nil
  # What must fit for `flat`, if not all of it: the start of `flat`, whose rest decides its own
  # breaks.
  measured: Doc? = default nil

# A part whose form the rule of the style decides.
export struct Rule
  rule: StyleRule
  doc: Doc

# The lines of the source from that of `at`, where the first token of a statement is, through
# `last_line`, as they are written, with the comments in them, but indented as deep as the first
# is printed, and the lines after it as much deeper or shallower as they were.
export struct Verbatim
  at: Position
  last_line: Int

# The lines of a `"""` or `'''` literal after its first, each one level deeper than the doc, the
# last ending with the closing quotes, after which what follows goes on. They are taken as written,
# never broken, and only the last is measured. `end_line` is where the literal ends in the source.
export struct LiteralLines
  lines: String[]
  end_line: Int

export type Doc = Text | Newline | Indent | Concat | Choice | Rule | Verbatim | LiteralLines

export WIDTH := 100
INDENT := '  '
INDENT_WIDTH := 2

# Where the part of a rule is in the output: from `start` up to `end`, which is exclusive.
export struct RulePlace
  rule: StyleRule
  start: Position
  end: Position

export struct Layout
  text: String
  rules: RulePlace[]

export lay_out := (doc: Doc, source: SourceText) ->
  printer := Printer(source)
  printer.run doc
  printer.finish()
  Layout text: printer.pieces.join(''), rules: printer.rules

# A part to print, as deep as `indent`.
struct Work
  doc: Doc
  indent: Int

# Where the part of a rule ends, once what it holds is printed. It starts at its first text, after
# the comments and the blank lines before that.
class RuleEnd
  rule: StyleRule
  start: Position? = nil

type Step = Work | RuleEnd

class Printer
  source: SourceText
  pieces: String[] = []
  rules: RulePlace[] = []
  # The parts of rules that no text has started yet.
  unstarted: RuleEnd[] = []
  line = 1
  column = 1
  # The depth of the line that the next text starts, which a line feed sets; nil once text is on it.
  pending_indent: Int? = 0
  # That of the last line that holds text.
  last_indent = 0
  # The line feeds before the next text, which a comment that ends the last line goes before.
  breaks = 0
  # The comments not printed yet start at this index.
  next_comment = 0
  # The last line of the source that the output has reached, by a token or a comment.
  source_line = 0
  # The lines of the source that hold a comment.
  comment_lines = lines_of(@source.comments)

  run = (doc: Doc) ->
    steps: Step[] = [Work(doc, indent: 0)]
    while not steps.is_empty()
      step := steps.pop()
      case step
        when RuleEnd
          end := @place()
          @rules.push { end, rule: step.rule, start: step.start ? end }
        when Work then @print(step, steps)

  # The comments after the last token, at the end of the file, and its last line feed.
  finish = ->
    @print_comments_before nil, 0
    @feed_lines()

  # Prints the step, or puts what it holds on `steps`, the first of them last.
  print = (work: Work, steps: Step[]) ->
    { doc, indent } := work
    inner := (part: Doc, depth: Int) -> Work(doc: part, indent: depth)
    case doc
      when Text then @print_text(doc, indent)
      when Newline then @new_lines(doc.count, indent)
      when Indent then steps.push(inner(doc.doc, indent + 1))
      when Concat then steps.push(inner(part, indent)) for part in doc.docs.reversed()
      when Choice
        room := WIDTH + 1 - @place().column
        # Mid-line, a comment not printed yet would end the line inside `flat`.
        from_line := @pending_indent then 0 else @source_line
        measured := doc.measured ? doc.flat
        fitting := fits(measured, room, indent, steps, @comment_lines, from_line)
        if not fitting
          @start_rule breaking_rule, steps if breaking_rule := doc.breaking_rule
        steps.push Work(indent, doc: fitting then doc.flat else doc.broken)
      when Rule
        @start_rule doc.rule, steps
        steps.push inner(doc.doc, indent)
      when Verbatim then @print_verbatim(doc, indent)
      when LiteralLines
        for line in doc.lines
          @new_lines 1, indent + 1
          @write line
        @source_line = doc.end_line

  # The part of the rule ends after what is on `steps` next, and starts at its first text.
  start_rule = (style_rule: StyleRule, steps: Step[]) ->
    rule_end := RuleEnd(style_rule)
    @unstarted.push rule_end
    steps.push rule_end

  # A text of a token comes after the comments before it, and after a blank line where the source
  # has one before it and the output starts a line with it.
  print_text = (text: Text, indent: Int) ->
    if at := text.at
      if not text.closes or @own_line_comment_before(at)
        @print_comments_before at, indent
        @keep_blank_line at.line
      @source_line = at.line if at.line > @source_line
    @write text.text

  # The lines after the first are written as they are, but for the indentation that the first
  # loses or gains.
  print_verbatim = (verbatim: Verbatim, indent: Int) ->
    { at, last_line } := verbatim
    @print_comments_before at, indent
    @keep_blank_line at.line
    lines := @source.lines
    @write lines[at.line - 1].trim_start()
    shift := indent * INDENT_WIDTH + 1 - at.column
    for line in (at.line + 1)...(last_line + 1)
      written := shifted(lines[line - 1], shift)
      @pieces.push "\n#{written}"
      @line += 1
      @column = columns(written) + 1
    comments := @source.comments
    while @next_comment < comments.length and comments[@next_comment].line <= last_line
      @next_comment += 1
    @source_line = last_line

  own_line_comment_before = (at: Position) ->
    comments := @source.comments
    for i in @next_comment...comments.length
      return false if comments[i].line >= at.line
      return true if comments[i].own_line
    false

  # The comments of the source before the position, or all that are left without one. One on a
  # line of its own goes on a line of its own, indented as the next text unless the source indents
  # it deeper, as at the end of a block. One that ends a line ends the output's line that holds
  # the last text of its line.
  print_comments_before = (at: Position?, indent: Int) ->
    comments := @source.comments
    while @next_comment < comments.length
      comment := comments[@next_comment]
      return if at and comment.line >= at.line
      @next_comment += 1
      text := @source.comment_text(comment)
      after_text := not @pieces.is_empty()
      if comment.own_line or not after_text
        # At the end of the file, the next line would start at the first column.
        next_column := at?.column ? 1
        deeper := comment.column > next_column
        @end_line indent if @pending_indent == nil
        @keep_blank_line comment.line
        @pending_indent = deeper then @last_indent else indent
        @write text
      else
        @pieces.push "  #{text}"
      @source_line = comment.line
      @end_line indent if @pending_indent == nil

  # A blank line before a line that the output starts at a line of the source, where the source
  # has one between that line and the last that the output has reached.
  keep_blank_line = (line: Int) ->
    return if @pending_indent == nil or @source_line == 0 or @breaks != 1
    for l in (@source_line + 1)...line
      if @source.is_blank(l)
        @breaks += 1
        return

  end_line = (indent: Int) -> @new_lines(1, indent)

  # An empty text, as a part that is left out, does not start a line.
  write = (text: String) ->
    return if text.is_empty()
    @feed_lines()
    if depth := @pending_indent
      @pieces.push INDENT for _ in 0...depth
      @column += depth * INDENT_WIDTH
      @last_indent = depth
      @pending_indent = nil
    rule_end.start = @place() for rule_end in @unstarted
    @unstarted = []
    @pieces.push text
    @column += columns(text)

  feed_lines = ->
    return if @breaks == 0
    @pieces.push "\n" for _ in 0...@breaks
    @line += @breaks
    @column = 1
    @breaks = 0

  # The next line is indented when its first text comes, so that a blank line holds no spaces.
  new_lines = (count: Int, indent: Int) ->
    @breaks += count
    @pending_indent = indent

  # Where the next text goes. A line that has no text yet starts after its indentation.
  place = ->
    if depth := @pending_indent
      return Position(line: @line + @breaks, column: depth * INDENT_WIDTH + 1)
    Position line: @line, column: @column

# The line with `shift` spaces more at its start, or fewer, as many as it has; a blank line stays
# empty.
shifted := (line: String, shift: Int) ->
  return line if line.trim_end().is_empty()
  return ' '.repeat(shift) + line if shift >= 0
  var removed = 0
  var rest = line
  while removed < -shift and rest.starts_with(' ')
    rest = rest.without_prefix(' ')!
    removed += 1
  rest

# Whether the comment on each line that holds one is on a line of its own.
lines_of := (comments: Comment[]) ->
  lines: Map<Int, Bool>
  lines[comment.line] = comment.own_line for comment in comments
  lines

# A part that `fits` measures, as deep as `depth`, and inside a choice of the flat form if `nested`.
struct Measured
  doc: Doc
  depth: Int
  nested: Bool

# Whether the first line of `flat`, at the depth `indent`, fits in `room` columns, with what
# follows it on `steps` up to the next line feed. A `flat` that starts with a line feed is measured
# on the line after it. The choices in `flat` are taken flat, and those after it broken, as each of
# those is laid out later in what is left of the line. A comment of the source between the first
# and the last texts of that line does not fit either, as it ends a line, unless a choice inside
# `flat` holds it, which breaks there itself; from `from_line` mid-line, as a comment not printed
# yet would go before the first text.
fits := (
  flat: Doc, room: Int, indent: Int, steps: Step[], comment_lines: Map<Int, Bool>, from_line: Int
) ->
  pending: Measured[] = [{ doc: flat, depth: indent, nested: false }]
  measurer := Measurer(steps, comment_lines, from_line, pending, left: room)
  measurer.fits()

# Measures the parts on `pending`, the last first, and then the works on `steps`, the last first,
# in what is `left` of the line (see fits).
class Measurer
  steps: Step[]
  comment_lines: Map<Int, Bool>
  from_line: Int
  pending: Measured[]
  left: Int
  # The next work on `steps` to measure, once those on `pending` are measured.
  next_step = @steps.length - 1
  # Whether the parts on `pending` are those of `flat`.
  in_flat = true
  has_text = false
  # The lines of the first and the last texts of `flat`, and of its last closing bracket.
  first_line = 0
  last_line = 0
  closing_line = 0

  fits = ->
    while true
      if @pending.is_empty()
        if @in_flat
          @in_flat = false
          return false if @comment_inside()
        return true if @next_step < 0
        step := @steps[@next_step]
        @next_step -= 1
        @pending.push { doc: step.doc, depth: step.indent, nested: false } if step is Work
      else if fit := @measure(@pending.pop())
        return fit
    true

  # Whether the line fits, if the part tells; nil if what follows it does.
  measure = (measured: Measured) ->
    { doc, depth, nested } := measured
    case doc
      when Text then return false if not @measure_text(doc, nested)
      when Newline
        return @fits_at_line_end() if @has_text or not @in_flat
        @left = WIDTH - depth * INDENT_WIDTH
      when Indent then @pending.push({ measured..., doc: doc.doc, depth: depth + 1 })
      when Concat then @pending.push({ measured..., doc: part }) for part in doc.docs.reversed()
      # What follows a choice on the line, if it breaks, is up to its first line feed.
      when Choice
        if @in_flat
          @pending.push { measured..., doc: doc.flat, nested: true }
        else
          @pending.push { measured..., doc: doc.broken }
      when Rule then @pending.push({ measured..., doc: doc.doc })
      # Its lines are those of a statement, which a line feed comes before.
      when Verbatim then return not @in_flat
      when LiteralLines
        @left = WIDTH - (depth + 1) * INDENT_WIDTH - columns(doc.lines.last()!)
        return false if @left < 0
    nil

  # Whether the text fits in what is left of the line, which it takes.
  measure_text = (text: Text, nested: Bool) ->
    @left -= columns(text.text)
    @has_text = @has_text or not text.text.is_empty()
    @mark_lines text if @in_flat and not nested
    @left >= 0

  mark_lines = (text: Text) ->
    at := text.at ? return
    if text.closes
      @closing_line = at.line if at.line > @closing_line
    else
      @first_line = at.line if @first_line == 0
      @last_line = at.line if at.line > @last_line

  fits_at_line_end = -> not @in_flat or not @comment_inside()

  # A comment between the texts, or one on a line of its own before a closing bracket after them.
  comment_inside = ->
    start := @from_line > 0 then @from_line else @first_line
    between := has_comment_line(@comment_lines, start, @last_line, own_line: false)
    between or has_comment_line(@comment_lines, @last_line, @closing_line, own_line: true)

# Whether a comment, or one on a line of its own if `own_line`, is from the line `first` up to
# `last`.
has_comment_line := (
  comment_lines: Map<Int, Bool>, first: Int, last: Int, flags: { own_line: Bool }
) ->
  for line in first...last
    if is_own_line := comment_lines[line]
      return true if is_own_line or not flags.own_line
  false

export text := (value: String): Doc -> Text(value)

# Whether the doc breaks its line in every form it may take, as a block does.
export has_line_feed := (doc: Doc): Bool ->
  case doc
    when Newline then true
    when Concat then doc.docs.any(has_line_feed)
    when Indent, Rule then has_line_feed(doc.doc)
    when LiteralLines then false
    when Choice then has_line_feed(doc.flat) and has_line_feed(doc.broken)
    when Text then false
    when Verbatim then doc.last_line > doc.at.line

export token := (value: String, at: Position): Doc -> Text(at, text: value)

# A closing bracket, at its position in the source if it is there (see Text.closes).
export closing := (value: String, at: Position?): Doc -> Text(at, text: value, closes: true)

export verbatim := (at: Position, last_line: Int): Doc -> Verbatim(at, last_line)

export join := (docs: Doc[]): Doc -> Concat(docs)

export line_feed := (): Doc -> Newline(count: 1)

export indent := (doc: Doc): Doc -> Indent(doc)

export choice := (flat: Doc, broken: Doc): Doc -> Choice(flat, broken)

# A choice whose broken form the rule decides: a part that fits on its line is left to the rules
# inside it.
export breaking := (style_rule: StyleRule, flat: Doc, broken: Doc): Doc ->
  Choice flat, broken, breaking_rule: style_rule

# A breaking choice whose flat form is `start` and then `rest`, where only `start` must fit, and
# `rest` decides its own breaks.
export breaking_after := (style_rule: StyleRule, start: Doc, rest: Doc, broken: Doc): Doc ->
  Choice broken, flat: join([start, rest]), breaking_rule: style_rule, measured: start

export rule := (style_rule: StyleRule, doc: Doc): Doc -> Rule(doc, rule: style_rule)

# The docs with `separator` between them.
export separated := (docs: Doc[], separator: Doc): Doc ->
  parts: Doc[]
  for doc, i in docs
    parts.push separator if i > 0
    parts.push doc
  Concat parts
