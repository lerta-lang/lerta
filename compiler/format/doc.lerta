# What the formatter prints, before it is laid out in lines (see docs/internals.md#formatter).
import Position from '../ast'
import Comment from '../lexer/tokens'
import StyleRule from './rules'
import columns, SourceText from './source'

# Holds no line feed. `at` is where the token that it prints is in the source, if it is one.
export struct Text
  text: String
  at: Position? = default nil
  # A closing bracket, before which a comment that ends the line of the last item stays at the end
  # of the line, after the bracket, while one on a line of its own stays inside.
  closes = default false

# Line feeds, `count` of them, after which the next text is indented as deep as the Indents around
# it.
export struct Newline(count: Int)

export struct Indent(doc: Doc)

export struct Concat(docs: Doc[])

# `flat` where its first line fits on the rest of the line, with what follows it up to the next
# line feed, and otherwise `broken`. A part such as the block of a `case` is laid out on lines of
# its own either way. `flat` fits nowhere if a comment of the source is between its texts on its
# first line.
export struct Choice
  flat: Doc
  broken: Doc
  # The rule that decides the part where it is broken, which a part that fits leaves to others.
  breaking_rule: StyleRule? = default nil
  # What must fit for `flat`, if not all of it: the start of `flat`, whose rest decides its own
  # breaks.
  measured: Doc? = default nil
  # Whether all of `flat` must fit on the line, for a form that cannot go on to the lines below.
  one_line = default false

# A part whose form the rule of the style decides.
export struct Rule(rule: StyleRule, doc: Doc)

export type Doc = Text | Newline | Indent | Concat | Choice | Rule

export const WIDTH = 100
const INDENT = '  '
const INDENT_WIDTH = 2

# Where the part of a rule is in the output: from `start` up to `end`, which is exclusive.
export struct RulePlace(rule: StyleRule, start: Position, end: Position)

export struct Layout(text: String, rules: RulePlace[])

export const lay_out = (doc: Doc, source: SourceText) ->
  const printer = Printer(source)
  printer.run doc
  printer.finish()
  Layout text: printer.pieces.join(''), rules: printer.rules

# A part to print, as deep as `indent`.
struct Work(doc: Doc, indent: Int)

# Where the part of a rule ends, once what it holds is printed. It starts at its first text, after
# the comments and the blank lines before that.
class RuleEnd
  rule: StyleRule
  start: Position? = nil

type Step = Work | RuleEnd

class Printer
  source: SourceText
  pieces: String[] = []
  rules: RulePlace[] = []
  # The parts of rules that no text has started yet.
  unstarted: RuleEnd[] = []
  line = 1
  column = 1
  # The depth of the line that the next text starts, which a line feed sets; nil once text is on it.
  pending_indent: Int? = 0
  # That of the last line that holds text.
  last_indent = 0
  # The line feeds before the next text, which a comment that ends the last line goes before.
  breaks = 0
  # The comments not printed yet start at this index.
  next_comment = 0
  # The last line of the source that the output has reached, by a token or a comment.
  source_line = 0
  # The lines of the source that hold a comment.
  comment_lines = lines_of(@source.comments)

  run = (doc: Doc) ->
    const steps: Step[] = [Work(doc, indent: 0)]
    while steps.length > 0
      const step = steps.pop()
      case step
        when RuleEnd
          const end = @place()
          @rules.push RulePlace(end, rule: step.rule, start: step.start ? end)
        when Work then @print(step, steps)

  # The comments after the last token, at the end of the file, and its last line feed.
  finish = ->
    @print_comments_before nil, 0
    @feed_lines()

  # Prints the step, or puts what it holds on `steps`, the first of them last.
  print = (work: Work, steps: Step[]) ->
    const { doc, indent } = work
    const inner = (part: Doc, depth: Int) -> Work(doc: part, indent: depth)
    case doc
      when Text then @print_text(doc, indent)
      when Newline then @new_lines(doc.count, indent)
      when Indent then steps.push(inner(doc.doc, indent + 1))
      when Concat
        steps.push inner(doc.docs[doc.docs.length - 1 - i], indent) for i in 0...doc.docs.length
      when Choice
        const room = WIDTH + 1 - @place().column
        # Mid-line, a comment not printed yet would end the line inside `flat`.
        const from_line = @pending_indent then 0 else @source_line
        const measured = doc.measured ? doc.flat
        const fitting = fits(measured, room, indent, steps, @comment_lines, from_line, doc.one_line)
        if not fitting
          @start_rule breaking_rule, steps if const breaking_rule = doc.breaking_rule
        steps.push Work(indent, doc: fitting then doc.flat else doc.broken)
      when Rule
        @start_rule doc.rule, steps
        steps.push inner(doc.doc, indent)

  # The part of the rule ends after what is on `steps` next, and starts at its first text.
  start_rule = (style_rule: StyleRule, steps: Step[]) ->
    const rule_end = RuleEnd(rule: style_rule)
    @unstarted.push rule_end
    steps.push rule_end

  # A text of a token comes after the comments before it, and after a blank line where the source
  # has one before it and the output starts a line with it.
  print_text = (text: Text, indent: Int) ->
    if const at = text.at
      if not text.closes or @own_line_comment_before(at)
        @print_comments_before at, indent
        @keep_blank_line at.line
      @source_line = at.line if at.line > @source_line
    @write text.text

  own_line_comment_before = (at: Position) ->
    const comments = @source.comments
    for i in @next_comment...comments.length
      return false if comments[i].line >= at.line
      return true if comments[i].own_line
    false

  # The comments of the source before the position, or all that are left without one. One on a
  # line of its own goes on a line of its own, indented as the next text unless the source indents
  # it deeper, as at the end of a block. One that ends a line ends the output's line that holds
  # the last text of its line.
  print_comments_before = (at: Position?, indent: Int) ->
    const comments = @source.comments
    while @next_comment < comments.length
      const comment = comments[@next_comment]
      return if at and comment.line >= at.line
      @next_comment += 1
      const text = @source.comment_text(comment)
      const after_text = @pieces.length > 0
      if comment.own_line or not after_text
        # At the end of the file, the next line would start at the first column.
        const next_column = at?.column ? 1
        const deeper = comment.column > next_column
        @end_line indent if @pending_indent == nil
        @keep_blank_line comment.line
        @pending_indent = deeper then @last_indent else indent
        @write text
      else
        @pieces.push "  #{text}"
      @source_line = comment.line
      @end_line indent if @pending_indent == nil

  # A blank line before a line that the output starts at a line of the source, where the source
  # has one between that line and the last that the output has reached.
  keep_blank_line = (line: Int) ->
    return if @pending_indent == nil or @source_line == 0 or @breaks != 1
    for l in (@source_line + 1)...line
      if @source.is_blank(l)
        @breaks += 1
        return

  end_line = (indent: Int) -> @new_lines(1, indent)

  # An empty text, as a part that is left out, does not start a line.
  write = (text: String) ->
    return if text == ''
    @feed_lines()
    if const depth = @pending_indent
      @pieces.push INDENT for _ in 0...depth
      @column += depth * INDENT_WIDTH
      @last_indent = depth
      @pending_indent = nil
    rule_end.start = @place() for rule_end in @unstarted
    @unstarted = []
    @pieces.push text
    @column += columns(text)

  feed_lines = ->
    return if @breaks == 0
    @pieces.push "\n" for _ in 0...@breaks
    @line += @breaks
    @column = 1
    @breaks = 0

  # The next line is indented when its first text comes, so that a blank line holds no spaces.
  new_lines = (count: Int, indent: Int) ->
    @breaks += count
    @pending_indent = indent

  # Where the next text goes. A line that has no text yet starts after its indentation.
  place = ->
    if const depth = @pending_indent
      return Position(line: @line + @breaks, column: depth * INDENT_WIDTH + 1)
    Position line: @line, column: @column

# Whether the comment on each line that holds one is on a line of its own.
const lines_of = (comments: Comment[]) ->
  const lines = Map<Int, Bool>()
  lines[comment.line] = comment.own_line for comment in comments
  lines

# Whether the first line of `flat` fits in `room` columns, with what follows it on `steps` up to
# the next line feed. The choices in `flat` are taken flat, and those after it broken, as each of
# those is laid out later in what is left of the line. A comment of the source between the first
# and the last texts of that line does not fit either, as it ends a line.
# A part that `fits` measures, as deep as `depth`, and inside a choice of the flat form if `nested`.
struct Measured(doc: Doc, depth: Int, nested: Bool)

# Whether the first line of `flat`, at the depth `indent`, fits in `room` columns, with what
# follows it on `steps` up to the next line feed. A `flat` that starts with a line feed is measured
# on the line after it. The choices in `flat` are taken flat, and those after it broken, as each of
# those is laid out later in what is left of the line. A comment of the source between the first
# and the last texts of that line does not fit either, as it ends a line, unless a choice inside
# `flat` holds it, which breaks there itself; from `from_line` mid-line, as a comment not printed
# yet would go before the first text.
const fits = (
  flat: Doc, room: Int, indent: Int, steps: Step[], comment_lines: Map<Int, Bool>, from_line: Int,
  one_line: Bool
) ->
  var left = room
  const pending = [Measured(doc: flat, depth: indent, nested: false)]
  var next_step = steps.length - 1
  var in_flat = true
  var has_text = false
  var first_line = 0
  var last_line = 0
  var closing_line = 0
  # A comment between the texts, or one on a line of its own before a closing bracket after them.
  const comment_inside = ->
    const start = from_line > 0 then from_line else first_line
    const between = has_comment_line(comment_lines, start, last_line, false)
    between or has_comment_line(comment_lines, last_line, closing_line, true)
  while true
    if pending.length == 0
      if in_flat
        in_flat = false
        return false if comment_inside()
      return true if next_step < 0
      const step = steps[next_step]
      next_step -= 1
      pending.push Measured(doc: step.doc, depth: step.indent, nested: false) if step is Work
      continue
    const measured = pending.pop()
    const { doc, depth, nested } = measured
    const inner = (part: Doc, part_depth: Int, part_nested: Bool) ->
      Measured doc: part, depth: part_depth, nested: part_nested
    case doc
      when Text
        left -= columns(doc.text)
        return false if left < 0
        has_text = has_text or doc.text != ''
        if in_flat and not nested
          if const at = doc.at
            if doc.closes
              closing_line = at.line if at.line > closing_line
            else
              first_line = at.line if first_line == 0
              last_line = at.line if at.line > last_line
      when Newline
        if in_flat and not has_text
          left = WIDTH - depth * INDENT_WIDTH
        else
          return false if in_flat and one_line
          return not in_flat or not comment_inside()
      when Indent then pending.push(inner(doc.doc, depth + 1, nested))
      when Concat
        for i in 0...doc.docs.length
          pending.push inner(doc.docs[doc.docs.length - 1 - i], depth, nested)
      # What follows a choice on the line, if it breaks, is up to its first line feed.
      when Choice
        if in_flat
          pending.push inner(doc.flat, depth, true)
        else
          pending.push inner(doc.broken, depth, nested)
      when Rule then pending.push(inner(doc.doc, depth, nested))
  true

# Whether a comment, or one on a line of its own if `own_line`, is from the line `first` up to
# `last`.
const has_comment_line = (comment_lines: Map<Int, Bool>, first: Int, last: Int, own_line: Bool) ->
  for line in first...last
    if const is_own_line = comment_lines[line]
      return true if is_own_line or not own_line
  false

export const text = (value: String): Doc -> Text(text: value)

export const token = (value: String, at: Position): Doc -> Text(at, text: value)

# A closing bracket, at its position in the source if it is there (see Text.closes).
export const closing = (value: String, at: Position?): Doc -> Text(at, text: value, closes: true)

export const join = (docs: Doc[]): Doc -> Concat(docs)

export const line_feed = (): Doc -> Newline(count: 1)

export const indent = (doc: Doc): Doc -> Indent(doc)

export const choice = (flat: Doc, broken: Doc): Doc -> Choice(flat, broken)

# A choice whose broken form the rule decides: a part that fits on its line is left to the rules
# inside it.
export const breaking = (style_rule: StyleRule, flat: Doc, broken: Doc): Doc ->
  Choice flat, broken, breaking_rule: style_rule

# A breaking choice whose flat form is `start` and then `rest`, where only `start` must fit, and
# `rest` decides its own breaks.
export const breaking_after = (style_rule: StyleRule, start: Doc, rest: Doc, broken: Doc): Doc ->
  Choice broken, flat: join([start, rest]), breaking_rule: style_rule, measured: start

# A choice whose flat form must fit on the line as a whole.
export const one_line = (flat: Doc, broken: Doc): Doc -> Choice(flat, broken, one_line: true)

export const rule = (style_rule: StyleRule, doc: Doc): Doc -> Rule(doc, rule: style_rule)

# The docs with `separator` between them.
export const separated = (docs: Doc[], separator: Doc): Doc ->
  const parts: Doc[] = []
  for doc, i in docs
    parts.push separator if i > 0
    parts.push doc
  Concat docs: parts
