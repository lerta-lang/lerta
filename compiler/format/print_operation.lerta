# Operations, with the precedence that decides where they need parentheses: the unary and binary
# operators, ranges, `then`/`else`, `?`, tests and casts.
import
  Await, BinaryOperation, Call, Cast, Coalesce, Conditional, Expression, FloatLiteral, If, Index,
  IntegerLiteral, IsTest, Member, NilLiteral, Range, UnaryOperation, Unwrap
from '../ast'
import breaking, Choice, indent, join, line_feed, rule, text, token from './doc'
import clarified, operand, written_in_parentheses from './print_expression'
import cast_type_doc, type_doc from './print_type'
import Context, keyword, spaced_value from './printing'
import CAST_FALLBACKS, ELSE_NIL, LINE_LENGTH, NEGATED_IN_TESTS, NEGATED_IS_TESTS from './rules'

# Precedence levels, weakest first (see Operators in docs/reference/syntax.md).
CONDITIONAL := 1
export OR := 2
AND := 3
NOT := 4
COMPARISON := 5
COALESCE := 6
RANGE := 7
export ADDITIVE := 8
MULTIPLICATIVE := 9
export PREFIX := 10
export POSTFIX := 11
PRIMARY := 12

export precedence := (expression: Expression) ->
  case expression
    when Conditional then CONDITIONAL
    when Coalesce then cast_of(expression) then COMPARISON else COALESCE
    when BinaryOperation then binary_precedence(expression.operator)
    when UnaryOperation then expression.operator == 'not' then NOT else PREFIX
    when IsTest, Cast then COMPARISON
    when Range then RANGE
    when Await then PREFIX
    when Unwrap, Call, Member, Index then POSTFIX
    when If then expression.nil_safe then POSTFIX else PRIMARY
    else PRIMARY

binary_precedence := (operator: String) ->
  case operator
    when 'or' then OR
    when 'and' then AND
    when '+', '-', '|', '^' then ADDITIVE
    when '*', '/', '%', '&', '<<', '>>' then MULTIPLICATIVE
    else COMPARISON

export range_doc := (range: Range, context: Context) ->
  start := range_end(range.start, context, last: false)
  join [start, text('...'), range_end(range.end, context, last: true)]

# `x ? y`, or `x as T ? y` (see Cast fallbacks).
export coalesce_doc := (coalesce: Coalesce, context: Context) ->
  cast := cast_of(coalesce)
  takes_cast := cast != nil and is_cast(coalesce.fallback)
  fallback_level := takes_cast then COMPARISON else COALESCE
  fallback := operand(coalesce.fallback, context, fallback_level, last: true)
  if cast
    # The style's part starts where the old form differs: at the `(` around the cast, if any.
    written_cast := cast_doc(cast, context, '')
    if written_in_parentheses(cast, context)
      return join([rule(CAST_FALLBACKS, join([written_cast, text(' ? ')])), fallback])
    return join([written_cast, rule(CAST_FALLBACKS, text(' ? ')), fallback])
  join [operand(coalesce.value, context, RANGE, last: false), text(' ? '), fallback]

export unary_doc := (unary: UnaryOperation, context: Context) ->
  if unary.operator == 'not'
    test := unary.operand as IsTest?
    return is_not_doc(test, context) if test
    in_test := unary.operand as BinaryOperation?
    return not_in_doc(in_test, context) if in_test and is_in_test(in_test)
    # `not x is not T` and `not x not in xs` would read as two tests.
    operand_doc :=
      if is_negated_test(unary.operand)
        clarified unary.operand, context
      else
        operand unary.operand, context, NOT, last: true
    return join([keyword('not ', unary.position), operand_doc])
  # `-1` would be a literal of its own.
  literal := unary.operand is IntegerLiteral or unary.operand is FloatLiteral
  operand_doc :=
    if literal
      clarified unary.operand, context
    else
      operand unary.operand, context, PREFIX, last: true
  join [token('-', unary.position), operand_doc]

# An operation on one line if it fits, and otherwise broken after each operator of its chain, the
# operations of its level on its left, with the operands after the first one level deeper, each on
# a line of its own (see Long operations), where the context breaks operations and the first line
# fits, as breaking it otherwise would only add lines that are as long.
export binary_doc := (binary: BinaryOperation, context: Context) ->
  level := binary_precedence(binary.operator)
  chain := operation_chain(binary, level, context)
  left_level := level == COMPARISON then COALESCE else level
  right_level := level == COMPARISON then COALESCE else level + 1
  first := operation_side(chain[0], chain[0].left, left_level, context, last: false)
  rights := [
    operation_side(operation, operation.right, right_level, context, last: i == chain.length - 1)
    for operation, i in chain
  ]
  on_line := [join([text(" #{chain[i].operator} "), right]) for right, i in rights]
  flat := join([first, on_line...])
  return flat unless context.breaks_operations
  continued := [join([text(" #{chain[i].operator}"), line_feed(), right]) for right, i in rights]
  broken := join([first, indent(join(continued))])
  start := join([first, text(" #{chain[0].operator}")])
  breaking LINE_LENGTH, flat, Choice(flat: broken, broken: flat, measured: start)

# The first line of the operation where it is broken: its first operand and operator.
export operation_start := (binary: BinaryOperation, context: Context) ->
  level := binary_precedence(binary.operator)
  first := operation_chain(binary, level, context)[0]
  left_level := level == COMPARISON then COALESCE else level
  join [
    operation_side(first, first.left, left_level, context, last: false)
    text(" #{first.operator}")
  ]

operation_side := (
  operation: BinaryOperation, child: Expression, level: Int, context: Context, flags: { last: Bool }
) ->
  # `and` mixed with `or` is clarified (see Parentheses).
  mixes := operation.operator == 'or' and child is BinaryOperation and child.operator == 'and'
  mixes then clarified(child, context) else operand(child, context, level, flags)

# The operations of a chain from its first, innermost on the left, to `binary`: those of the level
# on its left, whose parentheses the formatter leaves out (see Parentheses), so that it breaks the
# chain alike once they are. A comparison takes no chain.
operation_chain := (binary: BinaryOperation, level: Int, context: Context) ->
  chain := [binary]
  return chain if level == COMPARISON
  while left := chain.last()!.left as BinaryOperation?
    break if binary_precedence(left.operator) != level or left in context.reported
    chain.push left
  chain.reversed()

# An end of a range that is an operation is in parentheses (see Ranges).
range_end := (end: Expression, context: Context, flags: { last: Bool }) ->
  is_operation := end is BinaryOperation or end is UnaryOperation
  is_operation then clarified(end, context) else operand(end, context, ADDITIVE, flags)

# A `then`/`else` inside the `then` value of another is in parentheses (see Parentheses), and an
# `else nil` is left out, as `then` gives nil without `else` (see Else nil).
export conditional_doc := (conditional: Conditional, context: Context) ->
  condition := operand(conditional.condition, context, OR, last: false)
  then_value :=
    if conditional.then_value is Conditional
      clarified conditional.then_value, context
    else
      operand conditional.then_value, context, CONDITIONAL, last: false
  head :=
    join([condition, text(' then'), spaced_value(conditional.then_value, then_value, context)])
  return head if conditional.without_else
  return join([head, rule(ELSE_NIL, text(''))]) if conditional.else_value is NilLiteral
  else_value := operand(conditional.else_value, context, CONDITIONAL, last: true)
  join [head, text(' else'), spaced_value(conditional.else_value, else_value, context)]

export is_doc := (test: IsTest, context: Context, word: String) ->
  join [operand(test.value, context, COALESCE, last: false), text(word), type_doc(test.type)]

# `not (x is T)` is written `x is not T` (see Negated is tests).
is_not_doc := (test: IsTest, context: Context) ->
  rule NEGATED_IS_TESTS, is_doc(test, context, ' is not ')

# `not (x in xs)` is written `x not in xs` (see Negated in tests).
not_in_doc := (test: BinaryOperation, context: Context) ->
  left := operand(test.left, context, COALESCE, last: false)
  rule
    NEGATED_IN_TESTS
    join([left, text(' not in '), operand(test.right, context, COALESCE, last: true)])

is_in_test := (expression: Expression) ->
  expression is BinaryOperation and expression.operator == 'in'

is_negated_test := (expression: Expression) ->
  unary := expression as UnaryOperation ? return false
  unary.operator == 'not' and (unary.operand is IsTest or is_in_test(unary.operand))

# `x as T`, then `form`. The `?` of `as T?` is read as the type's, so it is not printed with it.
export cast_doc := (cast: Cast, context: Context, form: String) ->
  value := operand(cast.value, context, COALESCE, last: false)
  join [value, text(' as '), cast_type_doc(cast.type), text(form)]

# `(x as T?) ? y`, written `x as T ? y` (see Cast fallbacks).
cast_of := (coalesce: Coalesce) ->
  cast := coalesce.value as Cast ? return nil
  cast.throws then nil else cast

# A cast, or a cast with a fallback, which the fallback of a cast may be without parentheses (see
# parse_cast_fallback); that of `?` cannot.
is_cast := (expression: Expression) ->
  expression is Cast or (expression is Coalesce and cast_of(expression) != nil)
