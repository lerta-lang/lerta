# The rewrites that need the types of the checking, which reads the nodes that the formatter parsed,
# so the facts that it records of them are found by those nodes; those of the types written are in
# annotations.lerta.
import
  Assignment, BinaryOperation, Call, Case, CaseArm, Cast, Expression, For, FunctionLiteral,
  Identifier, Import, ImportName, Index, IntegerLiteral, Member, Range, Statement
from '../ast'
import is_file from 'std:io'
import check_program from '../checker/modules'
import ImportedName, ModuleAlias from '../checker/imports'
import NodeFacts, ProgramWide from '../checker/shared'
import CompileError from '../errors'
import arm_bodies from '../checker/statement'
import runs_no_code, runs_of_alike_arms from './expressions'
import ArrayType, FunctionType, is_one_of_kinds, OptionalType, PromiseType, Type from '../types'
import
  APPENDS, EXPECTED_TYPES, LAST_ITEMS, REDUNDANT_CASTS, SHARED_ARM_BODIES, UNUSED_IMPORTS
from './rules'
import dump_ast_without_positions from '../dumps'
import EntryModule, load_modules, module_key from '../loader'
import standard_module_of from '../source'
import Change, Edit from './edits'
import Tokens from './tokens'
import union_case from './union_cases'
import single_arm_case from './single_arm_cases'
import Place, places_of from './places'

import
  char_concatenation, default_comparison, default_separator, iterable_argument, recorded,
  shorthand_arguments, sort_key, spread, value_alone
from './typed_calls'
import
  byte_literal, emptiness_test, found_test, membership_lists, membership_test, range_test,
  tested_range
from './typed_tests'
import first_position, last_token, statement_last, text_of from './expression_tokens'

# What the checking records of the nodes of the source: the facts, and the names that its imports
# give that are never used.
export struct Typed
  program: ProgramWide
  facts: NodeFacts
  unused_imports: Set<Identifier>

  # The names that the module imports, or that alias its imported modules.
  imported: Set<String>

  # The junctions inside a chain of `or`s or of `and`s, which its root, met first, stands for (see
  # membership_lists).
  inner_junctions: Set<BinaryOperation> = Set()

# Nil where the program does not check, whose types are not known: its typed rewrites wait.
export typed_program := (path: String, source: String, statements: Statement[]) ->
  # A document that is no file yet, as an editor holds, is in no program.
  return nil unless is_file(path)
  key := module_key(path)
  typed := await typed_programs([path], Map([(key, { source, program: statements })]))
  typed[key]

# Those of the files of `paths`, by their keys, which `given` holds as parsed: each program that
# holds some is checked once for all of them (see load_modules). None for one whose program does not
# check, though it may check with another entry.
export typed_programs := (paths: String[], given: Map<String, EntryModule>) ->
  # A file of std declares what only std may, as an intrinsic, so it checks only as a standard
  # module: it is loaded by its name, and what is found is kept by its file's key.
  standard: Map<String, String>
  for path in paths
    if name := standard_module_of(path)
      standard[module_key(path)] = name
  file_keys := Map([(name, key) for (key, name) in standard])
  named_entries := [
    for (key, entry) in given
      (standard[key] else key, entry)
  ]
  modules_given := Map(named_entries)
  found: Map<String, Typed>
  tried: Set<String>
  for path in paths
    key := module_key(path)
    continue unless tried.add(key)
    entry_path := standard[key] else path
    try
      modules := await load_modules(entry_path, modules_given)
      program := ProgramWide(modules, entry_path, finds_all_errors: false)
      check_program program
      for module in modules
        continue unless module.key in modules_given
        file_key := file_keys[module.key] else module.key
        found[file_key] = typed_of(program, module.index)
        tried.add file_key
    catch _: CompileError
      continue
  found

typed_of := (program: ProgramWide, index: Int): Typed ->
  shared := program.shared[index]
  { imports } := shared
  all_imported: (ImportedName | ModuleAlias)[] = [
    imports.names.values()...
    imports.modules.values()...
  ]
  unused_imports := Set([each.name for each in all_imported when not each.used])
  imported := Set([each.name.name for each in all_imported])
  { program, imported, facts: shared.facts, unused_imports }

# The calls whose values the functions give as their results, in the last statements of their
# bodies or of the arms of those, which keep their parentheses (see Calls without parentheses);
# not those of a function of no value, whose last statement's value is dropped.
export result_calls := (typed: Typed): Set<Call> ->
  { facts } := typed
  found: Set<Call>
  for (literal, results) in facts.results
    known := facts.types[literal] else continue
    type := known as FunctionType else continue
    continue if literal.yields or gives_no_value(literal, type.result, facts)
    add_result_calls found, result for result in results
  found

# The calls that may be results where the program does not check, whose types do not tell which
# are: those in the last statements of the bodies of functions or of the arms of those, which keep
# their parentheses as written.
export possible_result_calls := (statements: Statement[]): Set<Call> ->
  found: Set<Call>
  at_function := (value: Expression, _: Place) ->
    literal := value as FunctionLiteral else return
    add_result_calls found, last if last := literal.body.last() as Expression?
  places_of statements, {
    before: at_function, after: nil, condition: nil, statement: nil, statements: nil
  }
  found

gives_no_value := (literal: FunctionLiteral, result: Type, facts: NodeFacts) ->
  awaited := literal.awaits or literal in facts.settling
  promised := awaited then (result as PromiseType?)?.value
  value := promised else result
  is_one_of_kinds(value, ['void', 'never'])

# The calls that give the value: it, or the last values of its arms, in turn.
export add_result_calls := (found: Set<Call>, value: Expression): void ->
  if value is Call
    found.add value
    return
  for arm in arm_bodies(value) else []
    add_result_calls found, last if last := arm.last() as Expression?

export typed_edits := (tokens: Tokens, value: Expression, typed: Typed): Edit?[] ->
  case value
    when Cast then [redundant_cast(tokens, value, typed.facts)]
    when Member then [unqualified(tokens, value, typed.facts)]
    when BinaryOperation
      { facts } := typed
      concatenation :=
        if value.operator == '+'
          char_concatenation tokens, value.left, value.right, facts
        else
          nil
      [
        emptiness_test(tokens, value, facts)
        tested_range(tokens, value, facts)
        range_test(tokens, value, facts)
        concatenation
        found_test(tokens, value, facts)
        byte_literal(tokens, value, facts)
        membership_lists(tokens, value, facts, typed.inner_junctions)...
      ]
    when Case then shared_arm_bodies(tokens, value, typed.facts)
    when Call
      { facts } := typed
      [
        recorded(tokens, value, facts)
        membership_test(tokens, value, facts)
        shorthand_arguments(tokens, value, facts)...
        spread(tokens, value, facts)
        value_alone(tokens, value, facts)
        default_comparison(tokens, value, facts)
        sort_key(tokens, value, facts)
        default_separator(tokens, value, facts)
        iterable_argument(tokens, value, facts)
      ]
    when Index then [last_item(tokens, value, typed.facts)]
    else []

export typed_statement_edits := (tokens: Tokens, statement: Statement, typed: Typed): Edit?[] ->
  [case_edit(tokens, statement, typed.facts), kind_edits(tokens, statement, typed)...]

# A case of one arm as a test of a union where it gives a Bool, and otherwise as an `if`.
case_edit := (tokens: Tokens, statement: Statement, facts: NodeFacts) ->
  union := union_case(tokens, statement, facts)
  if union
    union
  else
    single_arm_case(tokens, statement, facts)

kind_edits := (tokens: Tokens, statement: Statement, typed: Typed): Edit?[] ->
  case statement
    when Import then [unused_imports(tokens, statement, typed.unused_imports)]
    when Assignment
      { operator, target, value } := statement
      concatenation :=
        if operator == '+='
          char_concatenation tokens, target, value, typed.facts
        else
          nil
      [concatenation]
    when For then [append_loop(tokens, statement, typed.facts)]
    else []

# The import without the names that are never used (see Unused names); only reported where it gives
# none that is, as an import runs the module's top-level code and brings its extends, which leaving
# it out would lose. One that exports its names is used by the modules that import it.
unused_imports := (tokens: Tokens, statement: Import, unused: Set<Identifier>) ->
  return nil if statement.exported
  if alias := statement.alias
    return
      if alias in unused
        tokens.report(UNUSED_IMPORTS, statement.position)
      else
        nil
  { names } := statement
  is_unused := (name: ImportName) -> name.alias else name.name in unused
  return nil unless names.any(is_unused)
  return tokens.report(UNUSED_IMPORTS, statement.position) if names.all(is_unused)
  spans: Span[] = [
    for name in names
      first := tokens.at(name.name.position) else return nil
      last := tokens.at((name.alias else name.name).position) else return nil
      { first, last, unused: is_unused(name) }
  ]

  # At the first name left out, not at the comma before it.
  first_unused := spans.find(Span.unused)!

  # A comment after the last name, left out, would stay after a name kept.
  last_line := tokens.code[spans.last()!.last].end_line
  if spans.last()!.unused and tokens.comments.any((comment) -> comment.line == last_line)
    return tokens.report(UNUSED_IMPORTS, tokens.start(first_unused.first))

  tokens.edit_at(UNUSED_IMPORTS, tokens.start(first_unused.first), left_out_names(tokens, spans))

# The tokens of a name of an import, from its name through its alias.
struct Span
  first: Int
  last: Int
  unused: Bool

# Each unused name left out with the comma and the spaces after it, but those after the last kept
# name left out from the end of that name, with the commas before them.
left_out_names := (tokens: Tokens, spans: Span[]) ->
  var kept_last = spans.length - 1
  kept_last -= 1 while spans[kept_last].unused
  changes: Change[]
  for span at index in spans[..kept_last]
    next := spans[index + 1].first
    if span.unused
      changes.push { from: tokens.start(span.first), to: tokens.start(next), text: '' }
  if kept_last < spans.length - 1
    changes.push {
      from: tokens.end(spans[kept_last].last)
      to: tokens.end(spans.last()!.last)
      text: ''
    }
  changes

# `MEMBER` for `E.MEMBER` where E is expected (see Expected types).
unqualified := (tokens: Tokens, member: Member, facts: NodeFacts) ->
  return nil unless member in facts.unqualifiable
  first := tokens.at(member.position) else return nil
  name := tokens.at(member.name.position) else return nil
  return nil unless tokens.is_kind(name - 1, '.')
  change := Change(from: tokens.start(first), to: tokens.start(name), text: '')
  tokens.edit_at(EXPECTED_TYPES, member.position, [change])

# `xs.last()!` for `xs[xs.length - 1]`, and `xs.all_but_last()` for `xs[..(xs.length - 1)]`, of an
# array that runs no code, but not the last item of one whose items are optional (see Last items).
last_item := (tokens: Tokens, index: Index, facts: NodeFacts) ->
  return nil if index.default_value != nil
  { object } := index
  array := facts.types[object] as ArrayType else return nil
  return nil unless runs_no_code(object)
  name := text_of(tokens, object) else return nil
  text :=
    if is_all_but_last(index.index, object)
      'all_but_last()'
    # `!` would take the nil out of an optional item too, as `last` gives `T?`, which is T then.
    else if is_before_length(index.index, object) and array.element is not OptionalType
      'last()!'
    else
      return nil
  first := tokens.at(first_position(object)) else return nil
  object_last := last_token(tokens, object) else return nil
  open := object_last + 1
  return nil unless tokens.is_kind(open, '[')
  close := tokens.matching(open) else return nil
  change := Change(from: tokens.start(first), to: tokens.end(close), text: "#{name}.#{text}")
  tokens.edit_at(LAST_ITEMS, index.position, [change])

is_all_but_last := (value: Expression, object: Expression) ->
  range := value as Range else return false
  end := range.end else return false
  range.start == nil and not range.inclusive and is_before_length(end, object)

# Whether the value is `xs.length - 1` of the object.
is_before_length := (value: Expression, object: Expression) ->
  difference := value as BinaryOperation else return false
  length := difference.left as Member else return false
  one := difference.right as IntegerLiteral else return false
  same := dump_ast_without_positions([length.object]) == dump_ast_without_positions([object])
  difference.operator == '-' and length.name.name == 'length' and one.value == 1 and same

# `xs.append ys` for `xs.push y for y in ys`, of arrays of the same items, where xs runs no code
# and is not ys (see Appends).
append_loop := (tokens: Tokens, loop: For, facts: NodeFacts) ->
  return nil if loop.index != nil or loop.body.length != 1
  call := loop.body[0] as Call else return nil
  push := call.callee as Member else return nil
  return nil if push.name.name != 'push' or call.args.length != 1 or not call.named_args.is_empty()
  item := call.args[0] as Identifier else return nil
  return nil if item.name != loop.variable.name or not runs_no_code(push.object)
  pushed := facts.types[push.object] as ArrayType else return nil
  iterated := facts.types[loop.iterable] as ArrayType else return nil
  return nil if pushed.element != iterated.element

  # A push of each item of the array onto itself never ends, which the append would.
  same := dump_ast_without_positions([push.object]) == dump_ast_without_positions([loop.iterable])
  return nil if same
  first := tokens.at(first_position(push.object)) else return nil
  keyword := tokens.at(loop.position) else return nil
  return nil if first > keyword
  object := text_of(tokens, push.object) else return nil
  iterable_first := tokens.at(first_position(loop.iterable)) else return nil
  last := statement_last(tokens, first, tokens.line_indentation(tokens.code[first].line) else 0)
  iterable := tokens.slice(tokens.start(iterable_first), tokens.end(last))
  change :=
    Change(from: tokens.start(first), to: tokens.end(last), text: "#{object}.append #{iterable}")
  tokens.edit_at(APPENDS, push.name.position, [change])

# One arm for arms next to each other with one body (see Shared arm bodies), only reported: but not
# where a comment is among them, which would have no place in one, nor where a body may read the
# subject, which each arm narrows to the types of its patterns, and one arm of them all to their
# union, which may not check the same.
shared_arm_bodies := (tokens: Tokens, value: Case, facts: NodeFacts): Edit?[] ->
  runs := [
    for run in runs_of_alike_arms(value) when facts.types.contains(run[0].patterns[0])
      run
  ]
  is_reported := (run: CaseArm[]) ->
    not holds_comment(tokens, run) and not may_read(run[0].body, value.subject)
  [
    tokens.report(SHARED_ARM_BODIES, run[0].patterns[0].position)
    for run in runs
    when is_reported(run)
  ]

# Whether the body may read the subject narrowed: the name at the root of a subject that is a path
# of fields, `@` at its root, which a method may read through, or any subject but a call, which no
# arm narrows. The name is found in the dump of the body, which interpolations hold too; a field of
# that name counts too, which only leaves a run unreported.
may_read := (body: Statement[], subject: Expression?) ->
  var root = subject else return false
  root = root.object while root is Member
  case root
    when Identifier then "name: \"#{root.name}\"" in dump_ast_without_positions(body)
    when Call then false
    else true

# Whether a comment is on the lines of the arms, from the `when` of the first up to the line before
# the next code that is no deeper than it, as the next arm or `else`: one above that next arm too,
# which only leaves the run unreported.
holds_comment := (tokens: Tokens, run: CaseArm[]) ->
  first_pattern := tokens.at(run[0].patterns[0].position) else return true
  { line, column } := tokens.code[first_pattern - 1]
  var next = tokens.at(run.last()!.patterns[0].position) else return true
  continues := (at: Int) ->
    at < tokens.code.length and
      (tokens.code[at].line == tokens.code[at - 1].line or tokens.code[at].column > column)
  next += 1 while continues(next)
  last :=
    if next < tokens.code.length
      tokens.code[next].line - 1
    else
      tokens.code.last()!.end_line
  tokens.comments.any((comment) -> comment.line in line..=last)

# `x` for `x as T!` where x is a T already (see Redundant casts). The parentheses that held the cast
# are left to Parentheses.
redundant_cast := (tokens: Tokens, cast: Cast, facts: NodeFacts) ->
  return nil unless cast in facts.redundant_casts
  type_at := tokens.at(cast.type.position) else return nil
  as_at := type_at - 1
  return nil unless tokens.is_word(as_at, 'as')
  bang := cast_end(tokens, type_at) else return nil
  change := Change(from: tokens.end(as_at - 1), to: tokens.end(bang), text: '')
  tokens.edit_at(REDUNDANT_CASTS, cast.position, [change])

# The `!` after the type of a cast that starts at `at`; a type holds none.
cast_end := (tokens: Tokens, at: Int) ->
  var index = at
  index += 1 while index < tokens.code.length and not tokens.is_kind(index, '!')
  index < tokens.code.length then index
