# The rewrites that need the types of the checking, which reads the nodes that the formatter parsed,
# so the facts that it records of them are found by those nodes; those of the types written are in
# annotations.lerta.
import
  Assignment, binary_literal_bytes, BinaryOperation, Call, Case, CaseArm, Cast, Expression, For,
  FunctionLiteral, Identifier, Import, ImportName, Index, IntegerLiteral, Member, NamedValue,
  NilLiteral, Position, Range, Statement, StringLiteral, This, UnaryOperation
from '../ast'
import is_file from 'std:io'
import check_program from '../checker/modules'
import ImportedName, ModuleAlias from '../checker/imports'
import CollectionMaker from '../checker/references'
import is_fixed, is_plainly_compared, NodeFacts, ProgramWide from '../checker/shared'
import CompileError from '../errors'
import arm_bodies from '../checker/statement'
import
  copied_source, counted_end, range_test as comparisons_of_range, runs_no_code, runs_of_alike_arms
from './expressions'
import
  ArrayType, bool_type, byte_type, char_type, FunctionType, INTEGER_KINDS, is_one_of_kinds,
  IterType, MapType, NUMBER_KINDS, OptionalType, PromiseType, SimpleType, string_type, Type
from '../types'
import depth_change from '../lexer/tokens'
import
  APPENDS, BYTE_LITERALS, CHAR_CONCATENATIONS, DEFAULT_COMPARISONS, DEFAULT_SEPARATORS,
  EMPTINESS_TESTS, EXPECTED_TYPES, FOUND_TESTS, ITERABLE_ARGUMENTS, LAST_ITEMS, MEMBERSHIP_LISTS,
  MEMBERSHIP_TESTS, RANGE_TESTS, REDUNDANT_CASTS, SHARED_ARM_BODIES, SORT_KEYS, SPREADS,
  SHORTHAND_ARGUMENTS, UNUSED_IMPORTS, VALUES_ALONE
from './rules'
import dump_ast_without_positions from '../dumps'
import EntryModule, load_modules, module_key from '../loader'
import standard_module_of from '../source'
import Change, Edit from './edits'
import counted_range, is_zero from './ranges'
import Tokens from './tokens'

# What the checking records of the nodes of the source: the facts, and the names that its imports
# give that are never used.
export struct Typed
  program: ProgramWide
  facts: NodeFacts
  unused_imports: Set<Identifier>

  # The names that the module imports, or that alias its imported modules.
  imported: Set<String>

  # The junctions inside a chain of `or`s or of `and`s, which its root, met first, stands for (see
  # membership_lists).
  inner_junctions: Set<BinaryOperation> = Set()

# Nil where the program does not check, whose types are not known: its typed rewrites wait.
export typed_program := (path: String, source: String, statements: Statement[]) ->
  # A document that is no file yet, as an editor holds, is in no program.
  return nil unless is_file(path)
  key := module_key(path)
  typed := await typed_programs([path], Map([(key, { source, program: statements })]))
  typed[key]

# Those of the files of `paths`, by their keys, which `given` holds as parsed: each program that
# holds some is checked once for all of them (see load_modules). None for one whose program does not
# check, though it may check with another entry.
export typed_programs := (paths: String[], given: Map<String, EntryModule>) ->
  # A file of std declares what only std may, as an intrinsic, so it checks only as a standard
  # module: it is loaded by its name, and what is found is kept by its file's key.
  standard: Map<String, String>
  for path in paths
    if name := standard_module_of(path)
      standard[module_key(path)] = name
  file_keys := Map([(name, key) for (key, name) in standard])
  named_entries := [
    for (key, entry) in given
      (standard[key] else key, entry)
  ]
  modules_given := Map(named_entries)
  found: Map<String, Typed>
  tried: Set<String>
  for path in paths
    key := module_key(path)
    continue unless tried.add(key)
    entry_path := standard[key] else path
    try
      modules := await load_modules(entry_path, modules_given)
      program := ProgramWide(modules, entry_path, finds_all_errors: false)
      check_program program
      for module in modules
        continue unless module.key in modules_given
        file_key := file_keys[module.key] else module.key
        found[file_key] = typed_of(program, module.index)
        tried.add file_key
    catch _: CompileError
      continue
  found

typed_of := (program: ProgramWide, index: Int): Typed ->
  shared := program.shared[index]
  { imports } := shared
  all_imported: (ImportedName | ModuleAlias)[] = [
    imports.names.values()...
    imports.modules.values()...
  ]
  unused_imports := Set([each.name for each in all_imported when not each.used])
  imported := Set([each.name.name for each in all_imported])
  { program, imported, facts: shared.facts, unused_imports }

# The calls whose values the functions give as their results, in the last statements of their
# bodies or of the arms of those, which keep their parentheses (see Calls without parentheses);
# not those of a function of no value, whose last statement's value is dropped.
export result_calls := (typed: Typed): Set<Call> ->
  { facts } := typed
  found: Set<Call>
  for (literal, results) in facts.results
    known := facts.types[literal] else continue
    type := known as FunctionType else continue
    continue if literal.yields or gives_no_value(literal, type.result, facts)
    add_result_calls found, result for result in results
  found

gives_no_value := (literal: FunctionLiteral, result: Type, facts: NodeFacts) ->
  awaited := literal.awaits or literal in facts.settling
  promised := awaited then (result as PromiseType?)?.value
  value := promised else result
  is_one_of_kinds(value, ['void', 'never'])

add_result_calls := (found: Set<Call>, value: Expression): void ->
  if value is Call
    found.add value
    return
  for arm in arm_bodies(value) else []
    add_result_calls found, last if last := arm.last() as Expression?

export typed_edits := (tokens: Tokens, value: Expression, typed: Typed): Edit?[] ->
  case value
    when Cast then [redundant_cast(tokens, value, typed.facts)]
    when Member then [unqualified(tokens, value, typed.facts)]
    when BinaryOperation
      { facts } := typed
      concatenation :=
        if value.operator == '+'
          char_concatenation tokens, value.left, value.right, facts
        else
          nil
      [
        emptiness_test(tokens, value, facts)
        tested_range(tokens, value, facts)
        range_test(tokens, value, facts)
        concatenation
        found_test(tokens, value, facts)
        byte_literal(tokens, value, facts)
        membership_lists(tokens, value, typed)...
      ]
    when Case then shared_arm_bodies(tokens, value, typed.facts)
    when Call
      { facts } := typed
      [
        recorded(tokens, value, facts)
        membership_test(tokens, value, facts)
        shorthand_arguments(tokens, value, facts)...
        spread(tokens, value, facts)
        value_alone(tokens, value, facts)
        default_comparison(tokens, value, facts)
        sort_key(tokens, value, facts)
        default_separator(tokens, value, facts)
        iterable_argument(tokens, value, facts)
      ]
    when Index then [last_item(tokens, value, typed.facts)]
    else []

export typed_statement_edits := (tokens: Tokens, statement: Statement, typed: Typed): Edit?[] ->
  case statement
    when Import then [unused_imports(tokens, statement, typed.unused_imports)]
    when Assignment
      { operator, target, value } := statement
      concatenation :=
        if operator == '+='
          char_concatenation tokens, target, value, typed.facts
        else
          nil
      [concatenation]
    when For then [append_loop(tokens, statement, typed.facts)]
    else []

# The import without the names that are never used (see Unused names); only reported where it gives
# none that is, as an import runs the module's top-level code and brings its extends, which leaving
# it out would lose. One that exports its names is used by the modules that import it.
unused_imports := (tokens: Tokens, statement: Import, unused: Set<Identifier>) ->
  return nil if statement.exported
  if alias := statement.alias
    return
      if alias in unused
        tokens.report(UNUSED_IMPORTS, statement.position)
      else
        nil
  { names } := statement
  is_unused := (name: ImportName) -> name.alias else name.name in unused
  return nil unless names.any(is_unused)
  return tokens.report(UNUSED_IMPORTS, statement.position) if names.all(is_unused)
  spans: Span[] = [
    for name in names
      first := tokens.at(name.name.position) else return nil
      last := tokens.at((name.alias else name.name).position) else return nil
      { first, last, unused: is_unused(name) }
  ]

  # At the first name left out, not at the comma before it.
  first_unused := spans.find(Span.unused)!

  # A comment after the last name, left out, would stay after a name kept.
  last_line := tokens.code[spans.last()!.last].end_line
  if spans.last()!.unused and tokens.comments.any((comment) -> comment.line == last_line)
    return tokens.report(UNUSED_IMPORTS, tokens.start(first_unused.first))

  tokens.edit_at(UNUSED_IMPORTS, tokens.start(first_unused.first), left_out_names(tokens, spans))

# The tokens of a name of an import, from its name through its alias.
struct Span
  first: Int
  last: Int
  unused: Bool

# Each unused name left out with the comma and the spaces after it, but those after the last kept
# name left out from the end of that name, with the commas before them.
left_out_names := (tokens: Tokens, spans: Span[]) ->
  var kept_last = spans.length - 1
  kept_last -= 1 while spans[kept_last].unused
  changes: Change[]
  for span at index in spans[..kept_last]
    next := spans[index + 1].first
    if span.unused
      changes.push { from: tokens.start(span.first), to: tokens.start(next), text: '' }
  if kept_last < spans.length - 1
    changes.push {
      from: tokens.end(spans[kept_last].last)
      to: tokens.end(spans.last()!.last)
      text: ''
    }
  changes

# `MEMBER` for `E.MEMBER` where E is expected (see Expected types).
unqualified := (tokens: Tokens, member: Member, facts: NodeFacts) ->
  return nil unless member in facts.unqualifiable
  first := tokens.at(member.position) else return nil
  name := tokens.at(member.name.position) else return nil
  return nil unless tokens.is_kind(name - 1, '.')
  change := Change(from: tokens.start(first), to: tokens.start(name), text: '')
  tokens.edit_at(EXPECTED_TYPES, member.position, [change])

# `{ x: 1 }` for `S(x: 1)` where S is expected (see Expected types). A construction without
# parentheses is only reported (see record_changes).
recorded := (tokens: Tokens, call: Call, facts: NodeFacts) ->
  return nil unless call in facts.recordable
  changes := record_changes(tokens, call) else return tokens.report(EXPECTED_TYPES, call.position)
  tokens.edit_at(EXPECTED_TYPES, call.position, changes)

# The arguments of the construction as they are written, between braces for the parentheses, or
# for the callee and after the arguments of one without them; nil for one of type arguments.
export record_changes := (tokens: Tokens, call: Call) ->
  callee := tokens.at(call.callee.position) else return nil
  open := after_callee(tokens, call) else return nil
  return nil if tokens.is_kind(open, '<')
  unless tokens.is_kind(open, '(')
    return unparenthesized_record(tokens, callee, open)
  close := tokens.matching(open) else return nil

  # A space inside each brace that has the arguments on its line.
  opening :=
    if tokens.code[open + 1].line == tokens.code[open].line
      '{ '
    else
      '{'
  closing :=
    if tokens.code[close - 1].end_line == tokens.code[close].line
      ' }'
    else
      '}'
  [
    Change(from: tokens.start(callee), to: tokens.end(open), text: opening)
    tokens.replaced(close, closing)
  ]

# `{ x: 1 }` for `S x: 1`, and for `S` with the arguments in a block below it, the `}` on a line of
# its own then. The arguments of a call without parentheses run to the end of its line, or of the
# block below it.
unparenthesized_record := (tokens: Tokens, callee: Int, first_argument: Int) ->
  indentation := tokens.line_indentation(tokens.code[callee].line) else return nil
  last := statement_last(tokens, callee, indentation)
  return nil if last < first_argument
  on_one_line := tokens.code[last].end_line == tokens.code[callee].line
  closing := on_one_line then ' }' else "\n#{' '.repeat(indentation)}}"
  [
    tokens.replaced(callee, '{')
    Change(from: tokens.end(last), to: tokens.end(last), text: closing)
  ]

# The last token of the statement that starts on the line of the one at `first`, with the spaces
# of `indentation`: before the next line, outside brackets, indented no deeper.
statement_last := (tokens: Tokens, first: Int, indentation: Int) ->
  var depth = 0
  var last = first
  while last + 1 < tokens.code.length
    token := tokens.code[last]
    depth += depth_change(token.kind)
    next := tokens.code[last + 1]
    starts_line := next.line > token.end_line
    next_indentation := tokens.line_indentation(next.line) else 0
    break if depth <= 0 and starts_line and next_indentation <= indentation
    last += 1
  last

# The token after the callee of the construction, its last name, as `Point` of `geo.Point`.
export after_callee := (tokens: Tokens, call: Call) ->
  { callee } := call
  name := callee is Member then callee.name else callee
  last := tokens.at(name.position) else return nil
  last + 1

# `S(x, y: 1)` for `S(x: x, y: 1)` in a construction (see Shorthand): the named arguments that are
# variables of their names, from the first, up to one that is not or whose name and value are not
# written alone, as `x: (x)`, in one edit, as each would leave a named argument before those after
# it; the others, which would move before others, only reported.
shorthand_arguments := (tokens: Tokens, call: Call, facts: NodeFacts): Edit?[] ->
  return [] unless call in facts.object_constructions
  is_shorthand := (named: NamedValue) ->
    named.value is Identifier and named.value.name == named.name.name
  changes: Change[]
  reports: Edit?[]
  var stays = true
  for named in call.named_args
    shorthand := is_shorthand(named)
    change :=
      if shorthand and stays
        alone tokens, named
      else
        nil
    stays = change != nil
    if change
      changes.push change
    else if shorthand
      reports.push tokens.report(SHORTHAND_ARGUMENTS, named.name.position)
  return reports if changes.is_empty()
  [tokens.edit_at(SHORTHAND_ARGUMENTS, changes[0].from, changes), reports...]

# The name alone for the named argument, where both are single tokens.
alone := (tokens: Tokens, named: NamedValue) ->
  name_at := tokens.at(named.name.position) else return nil
  value_at := tokens.at(named.value.position) else return nil
  return nil if value_at != name_at + 2 or not tokens.is_kind(value_at, IDENTIFIER)
  Change(from: tokens.start(name_at), to: tokens.end(value_at), text: named.name.name)

# `T(v)` for `T(name: v)`, a construction of only the one argument that it must give (see Values
# alone); not a record, `{ name: v }`, which constructs a struct too, nor a copy of the field of
# another value.
value_alone := (tokens: Tokens, call: Call, facts: NodeFacts) ->
  # A copy of the field of another value is a spread (see Spreads).
  return nil if call not in facts.alone_constructions or is_copy(call, facts)
  named := call.named_args[0]
  name_at := tokens.at(named.name.position) else return nil
  value_at := tokens.at(named.value.position) else return nil
  return nil if not tokens.is_kind(name_at - 1, '(') or not tokens.is_kind(name_at + 1, ':')
  change := Change(from: tokens.start(name_at), to: tokens.start(value_at), text: '')
  tokens.edit_at(VALUES_ALONE, named.name.position, [change])

# `xs.sorted()` for `xs.sorted((a, b) -> a.compare(b))` of an array, and so for `sort` (see Default
# comparisons).
default_comparison := (tokens: Tokens, call: Call, facts: NodeFacts) ->
  member := call.callee as Member else return nil
  if member.name.name not in ['sorted', 'sort'] or facts.types[member.object] is not ArrayType
    return nil
  return nil if call.args.length != 1 or not call.named_args.is_empty()
  return nil unless is_natural_order(call.args[0])
  name := tokens.at(member.name.position) else return nil
  comparison := tokens.at(call.args[0].position) else return nil
  without_parentheses := comparison == name + 1
  within :=
    if without_parentheses
      arguments_after tokens, name
    else
      arguments_within tokens, name + 1
  change := within else return nil
  tokens.edit_at(DEFAULT_COMPARISONS, call.args[0].position, [change])

# `()` for the arguments of a call without parentheses, which run from its name at `name` to the end
# of its statement, as such a call starts one.
arguments_after := (tokens: Tokens, name: Int) ->
  indentation := tokens.line_indentation(tokens.code[name].line) else 0
  last := statement_last(tokens, name, indentation)
  Change(from: tokens.end(name), to: tokens.end(last), text: '()')

# Nothing for the arguments within the parentheses that open at `open`.
arguments_within := (tokens: Tokens, open: Int) ->
  return nil unless tokens.is_kind(open, '(')
  close := tokens.matching(open) else return nil
  Change(from: tokens.end(open), to: tokens.start(close), text: '')

# Whether the value is `(a, b) -> a.compare(b)`, the comparison that `sorted` takes by default.
is_natural_order := (value: Expression) ->
  literal := value as FunctionLiteral else return false
  return false if literal.params.length != 2 or literal.body.length != 1
  call := literal.body[0] as Call else return false
  member := call.callee as Member else return false
  object := member.object as Identifier else return false
  return false if call.args.length != 1 or not call.named_args.is_empty()
  argument := call.args[0] as Identifier else return false
  { params } := literal
  is_ordered := object.name == params[0].name.name and argument.name == params[1].name.name
  member.name.name == 'compare' and is_ordered

# `xs.sorted_by((a) -> a.k)` for `xs.sorted((a, b) -> a.k.compare(b.k))` of an array, of a path of
# fields of each, and so for `sort` (see Sort keys).
sort_key := (tokens: Tokens, call: Call, facts: NodeFacts) ->
  member := call.callee as Member else return nil
  if member.name.name not in ['sorted', 'sort'] or facts.types[member.object] is not ArrayType
    return nil
  return nil if call.args.length != 1 or not call.named_args.is_empty()
  literal := call.args[0] as FunctionLiteral else return nil
  key := compared_key(literal) else return nil
  name := tokens.at(member.name.position) else return nil
  return nil unless tokens.is_kind(name + 1, '(')
  close := tokens.matching(name + 1) else return nil
  parameter := literal.params[0].name.name
  changes: Change[] =
    tokens.replaced(name, "#{member.name.name}_by")
    { from: tokens.end(name + 1), to: tokens.start(close), text: "(#{parameter}) -> #{key}" }
  tokens.edit_at(SORT_KEYS, member.name.position, changes)

# The key that the literal compares, `a.k` of `(a, b) -> a.k.compare(b.k)`, where `k` is a path of
# fields; nil for any other literal.
compared_key := (literal: FunctionLiteral) ->
  return nil if literal.params.length != 2 or literal.body.length != 1
  call := literal.body[0] as Call else return nil
  compare := call.callee as Member else return nil
  return nil if compare.name.name != 'compare' or call.args.length != 1
  left := field_path(compare.object, literal.params[0].name.name) else return nil
  right := field_path(call.args[0], literal.params[1].name.name) else return nil
  left == right then "#{literal.params[0].name.name}.#{left}"

# The names of the fields, joined by `.`, of a path of one or more of them from the name; nil for
# any other value.
field_path := (value: Expression, name: String): String? ->
  member := value as Member else return nil
  object := member.object
  return member.name.name if object is Identifier and object.name == name
  above := field_path(object, name) else return nil
  "#{above}.#{member.name.name}"

# `xs.join()` for `xs.join('')` of strings or chars (see Default separators).
default_separator := (tokens: Tokens, call: Call, facts: NodeFacts) ->
  member := call.callee as Member else return nil
  return nil if member.name.name != 'join' or call.args.length != 1
  separator := call.args[0] as StringLiteral else return nil
  return nil if not separator.value.is_empty() or not joins_text(facts.types[member.object])
  at := tokens.at(separator.position) else return nil
  return nil if not tokens.is_kind(at - 1, '(') or not tokens.is_kind(at + 1, ')')
  change := Change(from: tokens.start(at), to: tokens.end(at), text: '')
  tokens.edit_at(DEFAULT_SEPARATORS, separator.position, [change])

# Whether the type is an array or an Iter of strings or chars, whose `join` takes `''` by default.
joins_text := (type: Type?) ->
  item :=
    case type
      when ArrayType then type.element
      when IterType then type.item
      else return false
  item == string_type or item == char_type

# `xs.last()!` for `xs[xs.length - 1]`, and `xs.all_but_last()` for `xs[..(xs.length - 1)]`, of an
# array that runs no code, but not the last item of one whose items are optional (see Last items).
last_item := (tokens: Tokens, index: Index, facts: NodeFacts) ->
  return nil if index.default_value != nil
  { object } := index
  array := facts.types[object] as ArrayType else return nil
  return nil unless runs_no_code(object)
  name := text_of(tokens, object) else return nil
  text :=
    if is_all_but_last(index.index, object)
      'all_but_last()'
    # `!` would take the nil out of an optional item too, as `last` gives `T?`, which is T then.
    else if is_before_length(index.index, object) and array.element is not OptionalType
      'last()!'
    else
      return nil
  first := tokens.at(first_position(object)) else return nil
  object_last := last_token(tokens, object) else return nil
  open := object_last + 1
  return nil unless tokens.is_kind(open, '[')
  close := tokens.matching(open) else return nil
  change := Change(from: tokens.start(first), to: tokens.end(close), text: "#{name}.#{text}")
  tokens.edit_at(LAST_ITEMS, index.position, [change])

is_all_but_last := (value: Expression, object: Expression) ->
  range := value as Range else return false
  end := range.end else return false
  range.start == nil and not range.inclusive and is_before_length(end, object)

# Whether the value is `xs.length - 1` of the object.
is_before_length := (value: Expression, object: Expression) ->
  difference := value as BinaryOperation else return false
  length := difference.left as Member else return false
  one := difference.right as IntegerLiteral else return false
  same := dump_ast_without_positions([length.object]) == dump_ast_without_positions([object])
  difference.operator == '-' and length.name.name == 'length' and one.value == 1 and same

# `xs.append ys` for `xs.push y for y in ys`, of arrays of the same items, where xs runs no code
# and is not ys (see Appends).
append_loop := (tokens: Tokens, loop: For, facts: NodeFacts) ->
  return nil if loop.index != nil or loop.body.length != 1
  call := loop.body[0] as Call else return nil
  push := call.callee as Member else return nil
  return nil if push.name.name != 'push' or call.args.length != 1 or not call.named_args.is_empty()
  item := call.args[0] as Identifier else return nil
  return nil if item.name != loop.variable.name or not runs_no_code(push.object)
  pushed := facts.types[push.object] as ArrayType else return nil
  iterated := facts.types[loop.iterable] as ArrayType else return nil
  return nil if pushed.element != iterated.element

  # A push of each item of the array onto itself never ends, which the append would.
  same := dump_ast_without_positions([push.object]) == dump_ast_without_positions([loop.iterable])
  return nil if same
  first := tokens.at(first_position(push.object)) else return nil
  keyword := tokens.at(loop.position) else return nil
  return nil if first > keyword
  object := text_of(tokens, push.object) else return nil
  iterable_first := tokens.at(first_position(loop.iterable)) else return nil
  last := statement_last(tokens, first, tokens.line_indentation(tokens.code[first].line) else 0)
  iterable := tokens.slice(tokens.start(iterable_first), tokens.end(last))
  change :=
    Change(from: tokens.start(first), to: tokens.end(last), text: "#{object}.append #{iterable}")
  tokens.edit_at(APPENDS, push.name.position, [change])

# `b'x'` for `b'x'[0]` compared with a byte, where the literal is one (see Binary literals).
byte_literal := (tokens: Tokens, test: BinaryOperation, facts: NodeFacts) ->
  return nil unless test.operator in ['==', '!=']
  for (indexed, other) in [(test.left, test.right), (test.right, test.left)]
    index := indexed as Index else continue
    zero := index.index as IntegerLiteral else continue
    bytes := binary_literal_bytes(index.object) else continue
    continue if zero.value != 0 or bytes.length != 1 or facts.types[other] != byte_type
    literal := tokens.at(index.object.position) else return nil
    close := tokens.matching(literal + 1) else return nil
    change := Change(from: tokens.end(literal), to: tokens.end(close), text: '')
    return tokens.edit_at(BYTE_LITERALS, index.position, [change])
  nil

# `Set(xs)` for `Set(xs.to_array())` of an array, an Iter, a map or a set, as `Map()` and `Set()`
# take any Iterable (see Iterable arguments).
iterable_argument := (tokens: Tokens, call: Call, facts: NodeFacts) ->
  callee := call.callee as Identifier else return nil
  maker := facts.references[callee] as CollectionMaker else return nil
  return nil if maker.type is not MapType or call.args.length != 1
  argument := call.args[0] as Call else return nil
  member := argument.callee as Member else return nil
  return nil if member.name.name != 'to_array' or not argument.args.is_empty()
  return nil unless is_iterable(facts.types[member.object])
  name := tokens.at(member.name.position) else return nil
  is_written := tokens.is_kind(name - 1, '.') and tokens.is_kind(name + 1, '(')
  return nil if not is_written or not tokens.is_kind(name + 2, ')')
  change := Change(from: tokens.start(name - 1), to: tokens.end(name + 2), text: '')
  tokens.edit_at(ITERABLE_ARGUMENTS, member.name.position, [change])

is_iterable := (type: Type?) -> type is ArrayType | IterType | MapType

# `x.is_empty()` for a test of the length of x against 0, or of x against '', and `not x.is_empty()`
# for one that x is not empty (see Emptiness tests), where std gives the type of x `is_empty`; the
# test as written, `0 == x.length` and `'' == x` too, but the latter of a name alone, whose end is
# known.
emptiness_test := (tokens: Tokens, test: BinaryOperation, facts: NodeFacts) ->
  { operator, left, right } := test
  return nil unless operator in ['==', '!=', '>']
  written := tested_value(tokens, left, right) else return nil
  { value, first, last, start, end } := written
  return nil if operator == '>' and not written.length_first
  return nil if not has_is_empty(facts.types[value]) or not is_balanced(tokens, first, last)
  negation := operator == '==' then '' else 'not '
  text := "#{negation}#{tokens.slice(tokens.start(first), tokens.end(last))}.is_empty()"
  at := tokens.start(start)
  tokens.edit_at(EMPTINESS_TESTS, at, [{ from: at, to: tokens.end(end), text }])

# The value that a comparison tests the emptiness of, the tokens from `first` through `last`, and
# those of the comparison, from `start` through `end`.
struct TestedValue
  value: Expression
  first: Int
  last: Int
  start: Int
  end: Int

  # Whether it is `x.length` before the operator, which `>` may compare.
  length_first: Bool

tested_value := (tokens: Tokens, left: Expression, right: Expression): TestedValue? ->
  if is_zero(right) and left is Member and left.name.name == 'length'
    name := tokens.at(left.name.position) else return nil
    zero := tokens.at(right.position) else return nil
    first := tokens.at(left.object.position) else return nil
    return nil if not tokens.is_kind(name - 1, '.') or zero != name + 2
    return {
      value: left.object
      first
      last: name - 2
      start: first
      end: zero
      length_first: true
    }
  if is_zero(left) and right is Member and right.name.name == 'length'
    zero := tokens.at(left.position) else return nil
    name := tokens.at(right.name.position) else return nil
    first := tokens.at(right.object.position) else return nil
    return nil if not tokens.is_kind(name - 1, '.') or first != zero + 2
    return {
      value: right.object
      first
      last: name - 2
      start: zero
      end: name
      length_first: false
    }
  if is_empty_string(right)
    empty := tokens.at(right.position) else return nil
    first := tokens.at(left.position) else return nil
    last := empty - 2
    return nil unless is_postfix(tokens, left, first, last)
    return { value: left, first, last, start: first, end: empty, length_first: false }
  if is_empty_string(left) and right is Identifier
    empty := tokens.at(left.position) else return nil
    name := tokens.at(right.position) else return nil
    return nil if name != empty + 2
    return { value: right, first: name, last: name, start: empty, end: name, length_first: false }
  nil

# Whether the value from `first` through `last` takes `.is_empty()` as written: a name, a member,
# a call, an index or `@`, or a value in parentheses, not an operation, which would give it to its
# last operand.
is_postfix := (tokens: Tokens, value: Expression, first: Int, last: Int) ->
  case value
    when Identifier, Member, Call, Index, This then true
    else tokens.is_kind(first, '(') and tokens.matching(first) == last

is_empty_string := (value: Expression) -> value is StringLiteral and value.value.is_empty()

# Whether the brackets that the tokens open they close, so that they are an expression whole.
is_balanced := (tokens: Tokens, first: Int, last: Int) ->
  return false if first > last
  var depth = 0
  for token in tokens.code[first..=last]
    depth += depth_change(token.kind)
    return false if depth < 0
  depth == 0

# `(x in xs)` for `xs.contains(x)` (see Membership tests), where neither runs code, as `x in xs`
# evaluates x first; the parentheses are left to Parentheses, and `not` before it to Negated in
# tests.
membership_test := (tokens: Tokens, call: Call, facts: NodeFacts) ->
  member := call.callee as Member else return nil
  has_one := call.args.length == 1 and call.named_args.is_empty() and call.type_args.is_empty()
  return nil if member.name.name != 'contains' or not has_one or facts.types[call] != bool_type
  item := call.args[0]
  return nil if not runs_no_code(member.object) or not runs_no_code(item)
  first := tokens.at(member.object.position) else return nil
  name := tokens.at(member.name.position) else return nil

  # `@contains(x)` has no `.`.
  last :=
    if tokens.is_kind(name - 1, '.')
      name - 2
    else
      name - 1

  open := name + 1
  return nil if not tokens.is_kind(open, '(') or not is_balanced(tokens, first, last)
  close := tokens.matching(open) else return nil
  collection := tokens.slice(tokens.start(first), tokens.end(last))
  text := "(#{tokens.slice(tokens.start(open + 1), tokens.end(close - 1))} in #{collection})"
  tokens.edit_at(
    MEMBERSHIP_TESTS
    member.name.position
    [{ from: tokens.start(first), to: tokens.end(close), text }]
  )

# `x in a..=b` for `x in a..(b + 1)` where b is an integer (see Ranges).
tested_range := (tokens: Tokens, test: BinaryOperation, facts: NodeFacts) ->
  return nil if test.operator != 'in'
  range := test.right as Range else return nil
  counted := counted_end(range.end) else return nil
  type := facts.types[counted] else return nil
  if is_one_of_kinds(type, INTEGER_KINDS)
    counted_range(tokens, range)
  else
    nil

# `s + c` for `s + c.to_string()` of a String `s` and a Char `c`, and so for `+=` (see Char
# concatenations): `+` of a String appends a Char.
char_concatenation := (tokens: Tokens, left: Expression, right: Expression, facts: NodeFacts) ->
  return nil if facts.types[left] != string_type
  call := right as Call else return nil
  member := call.callee as Member else return nil
  is_call := member.name.name == 'to_string' and call.args.is_empty() and call.named_args.is_empty()
  return nil if not is_call or facts.types[member.object] != char_type
  name := tokens.at(member.name.position) else return nil
  is_written := tokens.is_kind(name - 1, '.') and tokens.is_kind(name + 1, '(')
  return nil if not is_written or not tokens.is_kind(name + 2, ')')
  change := Change(from: tokens.start(name - 1), to: tokens.end(name + 2), text: '')
  tokens.edit_at(CHAR_CONCATENATIONS, member.name.position, [change])

# `xs.any(f)` for `xs.find(f) != nil`, and `not xs.any(f)` for `xs.find(f) == nil` (see Found
# tests), of an array, an Iter or a map, whose items cannot be optional for `find`, as nil would be
# ambiguous then.
found_test := (tokens: Tokens, test: BinaryOperation, facts: NodeFacts) ->
  return nil if test.operator not in ['==', '!='] or test.right is not NilLiteral
  call := test.left as Call else return nil
  member := call.callee as Member else return nil
  has_one := call.args.length == 1 and call.named_args.is_empty() and call.type_args.is_empty()
  return nil if member.name.name != 'find' or not has_one
  return nil unless is_iterable(facts.types[member.object])
  first := tokens.at(member.object.position) else return nil
  name := tokens.at(member.name.position) else return nil
  nil_at := tokens.at(test.right.position) else return nil
  close := nil_at - 2
  return nil if not tokens.is_kind(name + 1, '(') or tokens.matching(name + 1) != close
  return nil unless is_balanced(tokens, first, close)
  negated := test.operator == '=='
  changes: Change[] =
    { from: tokens.start(first), to: tokens.start(first), text: negated then 'not ' else '' }
    tokens.replaced(name, 'any')
    { from: tokens.end(close), to: tokens.end(nil_at), text: '' }
  tokens.edit_at(FOUND_TESTS, member.name.position, changes)

# `x in [A, B]` for `x == A or x == B`, and `x not in [A, B]` for `x != A and x != B`, of each run
# of two or more such tests of one `x` in a chain of `or`s or of `and`s (see Membership lists),
# which makes no array then (see compared_items). Found from the root of the chain's tree, its last
# junction, which is met before the others and marks them.
membership_lists := (tokens: Tokens, test: BinaryOperation, typed: Typed): Edit?[] ->
  junction := test.operator
  return [] if junction not in ['or', 'and'] or test in typed.inner_junctions
  terms: Expression[]
  var node: Expression = test
  while node is BinaryOperation and node.operator == junction
    typed.inner_junctions.add node
    terms.insert 0, node.right
    node = node.left
  terms.insert 0, node
  comparison := junction == 'or' then '==' else '!='
  edits: Edit?[]
  var start = 0
  while start < terms.length
    var end = start
    if tested := tested_word(terms[start], comparison, typed.facts)
      while end + 1 < terms.length and tests_same(terms[end + 1], tested, comparison, typed.facts)
        end += 1
    if end > start
      edits.push membership_list(tokens, terms[start..=end], junction)
    start = end + 1
  edits

# The `x` of `x == A`, of the comparison, where `x` runs no code and is of a type that `==` compares
# by itself, and `A` is a literal, a member of an enum or a constant (see compared_items).
tested_word := (term: Expression, comparison: String, facts: NodeFacts) ->
  test := term as BinaryOperation else return nil
  return nil if test.operator != comparison or not runs_no_code(test.left)
  type := facts.types[test.left] else return nil
  if is_plainly_compared(type) and is_fixed(facts, test.right)
    test.left
  else
    nil

tests_same := (term: Expression, tested: Expression, comparison: String, facts: NodeFacts) ->
  other := tested_word(term, comparison, facts) else return false
  dump_ast_without_positions([other]) == dump_ast_without_positions([tested])

membership_list := (tokens: Tokens, terms: Expression[], junction: String) ->
  tests := [term as BinaryOperation! for term in terms]
  first := tokens.at(first_position(tests[0].left)) else return nil
  last := last_token(tokens, tests.last()!.right) else return nil
  return nil unless is_balanced(tokens, first, last)
  tested := text_of(tokens, tests[0].left) else return nil
  items := [
    for test in tests
      item := text_of(tokens, test.right) else return nil
      item
  ]
  operator := junction == 'and' then 'not in' else 'in'
  text := "#{tested} #{operator} [#{items.join(', ')}]"
  change := Change(text, from: tokens.start(first), to: tokens.end(last))
  tokens.edit_at(MEMBERSHIP_LISTS, tests[0].position, [change])

# The text of a name, `@`, a literal, a path of fields from one or a constant, `-1` or `K + 1`, as
# written; nil where parentheses hold part of it, which the text would leave unbalanced.
text_of := (tokens: Tokens, value: Expression) ->
  first := tokens.at(first_position(value)) else return nil
  last := last_token(tokens, value) else return nil
  if is_balanced(tokens, first, last)
    tokens.slice(tokens.start(first), tokens.end(last))
  else
    nil

last_token := (tokens: Tokens, value: Expression) ->
  at := tokens.at(last_position(value)) else return nil

  # `-1` is one literal of two tokens, found by the first.
  if tokens.is_kind(at, '-')
    at + 1
  else
    at

first_position := (value: Expression): Position ->
  case value
    when Member then first_position(value.object)
    when BinaryOperation then first_position(value.left)
    else value.position

last_position := (value: Expression): Position ->
  case value
    when Member then value.name.position
    when UnaryOperation then last_position(value.operand)
    when BinaryOperation then last_position(value.right)
    else value.position

# `x in a..=b` for `x >= a and x <= b`, and `x not in a..=b` for `x < a or x > b`, of a number or a
# Char (see Range tests), only reported.
range_test := (tokens: Tokens, test: BinaryOperation, facts: NodeFacts) ->
  comparison := comparisons_of_range(test) else return nil
  type := facts.types[comparison.value] else return nil
  return nil unless is_one_of_kinds(type, [NUMBER_KINDS..., 'Char'])
  tokens.report(RANGE_TESTS, comparison.value.position)

# One arm for arms next to each other with one body (see Shared arm bodies), only reported: but not
# where a comment is among them, which would have no place in one, nor where a body may read the
# subject, which each arm narrows to the types of its patterns, and one arm of them all to their
# union, which may not check the same.
shared_arm_bodies := (tokens: Tokens, value: Case, facts: NodeFacts): Edit?[] ->
  runs := [
    for run in runs_of_alike_arms(value) when facts.types.contains(run[0].patterns[0])
      run
  ]
  is_reported := (run: CaseArm[]) ->
    not holds_comment(tokens, run) and not may_read(run[0].body, value.subject)
  [
    tokens.report(SHARED_ARM_BODIES, run[0].patterns[0].position)
    for run in runs
    when is_reported(run)
  ]

# Whether the body may read the subject narrowed: the name at the root of a subject that is a path
# of fields, `@` at its root, which a method may read through, or any subject but a call, which no
# arm narrows. The name is found in the dump of the body, which interpolations hold too; a field of
# that name counts too, which only leaves a run unreported.
may_read := (body: Statement[], subject: Expression?) ->
  var root = subject else return false
  root = root.object while root is Member
  case root
    when Identifier then "name: \"#{root.name}\"" in dump_ast_without_positions(body)
    when Call then false
    else true

# Whether a comment is on the lines of the arms, from the `when` of the first up to the line before
# the next code that is no deeper than it, as the next arm or `else`: one above that next arm too,
# which only leaves the run unreported.
holds_comment := (tokens: Tokens, run: CaseArm[]) ->
  first_pattern := tokens.at(run[0].patterns[0].position) else return true
  { line, column } := tokens.code[first_pattern - 1]
  var next = tokens.at(run.last()!.patterns[0].position) else return true
  continues := (at: Int) ->
    at < tokens.code.length and
      (tokens.code[at].line == tokens.code[at - 1].line or tokens.code[at].column > column)
  next += 1 while continues(next)
  last :=
    if next < tokens.code.length
      tokens.code[next].line - 1
    else
      tokens.code.last()!.end_line
  tokens.comments.any((comment) -> comment.line in line..=last)

# A spread of the value whose fields a construction copies, where it gives every argument, of the
# type constructed (see Spreads), only reported.
spread := (tokens: Tokens, call: Call, facts: NodeFacts) ->
  if is_copy(call, facts)
    tokens.report(SPREADS, call.position)
  else
    nil

# Whether the construction gives every argument from the fields of a value of its type.
is_copy := (call: Call, facts: NodeFacts) ->
  source := copied_source(call) else return false
  return false unless call in facts.full_constructions
  source_type := facts.types[source] else return false
  source_type == facts.types[call]

# `x` for `x as T!` where x is a T already (see Redundant casts). The parentheses that held the cast
# are left to Parentheses.
redundant_cast := (tokens: Tokens, cast: Cast, facts: NodeFacts) ->
  return nil unless cast in facts.redundant_casts
  type_at := tokens.at(cast.type.position) else return nil
  as_at := type_at - 1
  return nil unless tokens.is_word(as_at, 'as')
  bang := cast_end(tokens, type_at) else return nil
  change := Change(from: tokens.end(as_at - 1), to: tokens.end(bang), text: '')
  tokens.edit_at(REDUNDANT_CASTS, cast.position, [change])

# The `!` after the type of a cast that starts at `at`; a type holds none.
cast_end := (tokens: Tokens, at: Int) ->
  var index = at
  index += 1 while index < tokens.code.length and not tokens.is_kind(index, '!')
  index < tokens.code.length then index

# Whether std gives the type `is_empty` (see EMPTINESS_TESTS). One test serves the tests of a length
# and the comparisons with '': a `String` has no `length`, and nothing else compares with ''.
has_is_empty := (type: Type?) ->
  case type
    when ArrayType, MapType then true
    when SimpleType then type.kind in ['String', 'Binary']
    else false
