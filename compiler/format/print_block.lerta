# The expressions that hold blocks: function literals, `case` and `try`.
import
  Case, CaseArm, Expression, FunctionLiteral, Identifier, Parameter, Position, Statement, Try
from '../ast'
import
  breaking_after, choice, Doc, indent, join, line_feed, rule, separated, text, token
from './doc'
import result_type_doc, type_doc, type_parameters from './print_type'
import block_doc, inline_statement, is_inline from './print_statement'
import BRANCHES, FUNCTION_BODIES, FUNCTIONS_WITHOUT_PARAMETERS, LONG_LISTS from './rules'
import expression_doc, operand from './print_expression'
import OR from './print_operation'
import
  bracketed, Context, Item, keyword, lines_of_items, optional_doc, position_before, removed_type,
  word_before
from './printing'

export function_doc := (function: FunctionLiteral, context: Context) ->
  weak := function.weak then text('weak ') else text('')
  head := join([weak, function_head(function, context)])
  body := function.body
  # A block that holds a comment stays one, so that the comment stays in it.
  has_comments := context.source.block_has_comments(function.position)
  fits_line := body.length == 1 and is_inline(body[0], context) and not has_comments
  # The body goes on the line where the head ends, which its parameters may have broken.
  on_line := fits_line then join([text(' '), inline_statement(body[0], context)])
  # One statement that a line cannot hold, a declaration or one that holds a block, goes below: the
  # break is the rule's.
  is_one_below := body.length == 1 and not is_inline(body[0], context) and not has_comments
  block_break := is_one_below then rule(FUNCTION_BODIES, line_feed()) else line_feed()
  block := indent(join([block_break, block_doc(body, context.in_block())]))
  # Inside brackets, a body that does not go on the line is a block all the same (see Layout). A
  # single statement that would but for a comment of the source after it stays on the line of `->`
  # if it is there, as a block would take the comment from the line it ends.
  if context.in_brackets
    return join([head, choice(line, block)]) if line := on_line
    arrow := position_before(body[0].position, '->', context)
    on_arrow_line := arrow != nil and arrow.line == body[0].position.line
    stays := body.length == 1 and is_inline(body[0], context) and on_arrow_line
    return join([head, text(' '), block_doc(body, context)]) if stays
    return join([head, block])
  if line := on_line
    join [head, rule(FUNCTION_BODIES, choice(line, block))]
  else
    join [head, block]

# The function with its body as a block, below its head.
export function_block_doc := (function: FunctionLiteral, context: Context): Doc ->
  weak := function.weak then text('weak ') else text('')
  block := indent(join([line_feed(), block_doc(function.body, context.in_block())]))
  join [weak, function_head(function, context), block]

# What comes before `->`: `-> body` has no parentheses where it needs none (see Functions without
# parameters).
function_head := (function: FunctionLiteral, context: Context) ->
  has_signature := not function.params.is_empty() or function.return_type != nil
  removed_result := removed_type(RETURN, function.position, context)
  if not has_signature and function.type_params.is_empty()
    return join([removed_result, rule(FUNCTIONS_WITHOUT_PARAMETERS, text('->'))])
  inside := context.inside_brackets()
  params := [parameter(param, inside) for param in function.params]
  type_params := type_parameters(function.type_params)
  result := optional_doc(function.return_type, (type) -> join([text(': '), result_type_doc(type)]))
  list := bracketed(join([type_params, text('(')]), params, ')', nil)
  join [list, removed_result, result, text(' ->')]

parameter := (param: Parameter, context: Context) ->
  parts := [token(param.name.name, param.name.position)]
  parts.push removed_type(PARAMETER, param.name.position, context)
  parts.push join([text(': '), type_doc(type)]) if type := param.type
  parts.push text('...') if param.variadic
  parts.push join([text(' = '), expression_doc(value, context)]) if value := param.default
  after_comment := context.source.comment_before(param.name.position)
  Item after_comment, doc: join(parts), simple: param.default == nil

export case_doc := (case_value: Case, context: Context) ->
  head :=
    if subject := case_value.subject
      join [keyword('case ', case_value.position), expression_doc(subject, context.unbroken())]
    else
      keyword 'case', case_value.position
  has_subject := case_value.subject != nil
  arms := [arm_doc(arm, has_subject, context) for arm in case_value.arms]
  if otherwise := case_value.otherwise
    at := otherwise[0].position
    head := position_before(at, 'else', context) ? at
    arms.push join([word_before(at, 'else', context), arm_body(otherwise, head, context, ' ')])
  join [head, indent(join([line_feed(), separated(arms, line_feed())]))]

# The patterns on the line of `when` if they fit there, and otherwise on lines of their own below
# it, with `then` on the line after them (see Long lists). A condition, without a subject, stays on
# the line of `when`.
arm_doc := (arm: CaseArm, has_subject: Bool, context: Context) ->
  patterns := [pattern_item(pattern, context.unbroken()) for pattern in arm.patterns]
  at := arm.patterns[0].position
  # The body's block starts after `then` where `then` is on a line of its own, after the patterns.
  then_at := position_before(arm.body[0].position, 'then', context)
  head := then_at ? position_before(at, 'when', context) ? at
  when_word := word_before(at, 'when', context)
  on_line := separated([pattern.doc for pattern in patterns], text(', '))
  when_line := join([when_word, text(' '), on_line])
  return join([when_line, arm_body(arm.body, head, context, ' then ')]) if not has_subject
  below := indent(join([line_feed(), lines_of_items(patterns)]))
  then_word := word_before(arm.body[0].position, 'then', context)
  then_body := join([then_word, arm_body(arm.body, head, context, ' ')])
  broken := join([when_word, below, line_feed(), then_body])
  breaking_after LONG_LISTS, when_line, arm_body(arm.body, head, context, ' then '), broken

pattern_item := (pattern: Expression, context: Context) ->
  after_comment := context.source.comment_before(pattern.position)
  Item after_comment, doc: operand(pattern, context, OR, last: false), simple: true

# An arm's body on its line where it is one statement that fits there, and otherwise in a block
# (see Branches).
# `head` is where the arm starts, whose block, if it holds a comment, stays one.
arm_body := (body: Statement[], head: Position, context: Context, joint: String) ->
  block := indent(join([line_feed(), block_doc(body, context)]))
  has_comments := context.source.block_has_comments(head)
  stays_block := body.length != 1 or not is_inline(body[0], context) or has_comments
  return block if stays_block or is_name_pass(body[0])
  on_line := join([text(joint), inline_statement(body[0], context)])
  rule BRANCHES, choice(on_line, block)

# The name `pass` alone, which on the line of the arm would be the arm that does nothing.
is_name_pass := (statement: Statement) -> statement is Identifier and statement.name == 'pass'

export try_doc := (try_value: Try, context: Context) ->
  block := (body: Statement[]) -> indent(join([line_feed(), block_doc(body, context)]))
  parts := [keyword('try', try_value.position), block(try_value.body)]
  for clause in try_value.catches
    name := token(clause.name.name, clause.name.position)
    type := optional_doc(clause.type, (t) -> join([text(': '), type_doc(t)]))
    parts.push
      join([line_feed(), keyword('catch ', clause.position), name, type, block(clause.body)])
  if body := try_value.finally_body
    parts.push join([line_feed(), word_before(body[0].position, 'finally', context), block(body)])
  join parts
