# What the formatter reads from the source by position, as the AST does not keep it: the spelling
# of tokens, the text of comments, which lines are blank and which the comments mark to keep as
# they are written.
import scan from 'std:scanner'
import Position from '../ast'
import
  CLOSING_BRACKETS, Comment, Lexed, OPENING_BRACKETS, Token, TokenKind, without_carriage_return
from '../lexer/tokens'

export class SourceText
  # The lines as the source has them, and without the CR of a CRLF.
  raw_lines: String[]
  lines: String[]
  tokens: Token[]
  comments: Comment[]
  # The index in `tokens` of the token that starts at each position.
  token_indexes := index_tokens(@tokens)
  # Whether the comment on each line that holds one is on a line of its own.
  comment_lines := lines_of(@comments)
  # The place of the first `;` on each line that holds one, by the line.
  separators := separator_places(@tokens)
  # The comments that the formatter cannot place (see stranded_comments).
  stranded := stranded_comments(@lines, @tokens, @comments)
  # The lines that hold tokens that `# fmt: skip` and `# fmt: off` mark (see lines_marked), and
  # those of the stranded comments, which are kept as written.
  marked_lines := lines_marked(@lines, @tokens, @comments, @stranded)

  # The text of the token as written.
  spelling := (token: Token) -> @slice(token.line, token.column, token.end_column)

  # The text of the comment as written, without the spaces after it.
  comment_text := (comment: Comment) -> text_of(comment, @lines)

  is_blank := (line: Int) -> @lines[line - 1].trim_end().is_empty()

  # Whether a comment is on a line from `first` through `last`.
  has_comment := (first: Int, last: Int) ->
    for line in first..=last
      return true if line in @comment_lines
    false

  # Whether a comment is in the indented block that follows the head that starts with the token at
  # the position, deeper than the head's first line, or ends the head's last line, as one that the
  # postfix form of the block, or the block on that line, would move. The head ends at the first
  # line end outside its brackets.
  block_has_comments := (at: Position) ->
    start := @token_at(at) ? return false
    head_end_index := @head_end(start)
    head_end := @tokens[head_end_index].line
    return false if @tokens[head_end_index + 1].kind != INDENT
    end_line := @tokens[@block_end(head_end_index + 1)].line
    indentation := @indentation(at.line)
    for comment in @comments
      # One that ends the line of the head would go before the statement of the block.
      return true if comment.line == head_end
      inside := comment.line > head_end and comment.line < end_line
      return true if inside and comment.column > indentation
    false

  # The column of the first token on the line.
  indentation := (line: Int) ->
    text := @lines[line - 1]
    columns(text) - columns(text.trim_start()) + 1

  # Whether a comment is between the token that starts at the position and the token before it,
  # or on the line of that one.
  comment_before := (at: Position) ->
    index := @token_at(at) ? return false
    var previous = index - 1
    previous -= 1 while previous > 0 and LAYOUT_KINDS.contains(@tokens[previous].kind)
    previous >= 0 and @has_comment(@tokens[previous].line, at.line - 1)

  # Whether the token at the position starts a line of a block, as a statement on lines of its own
  # does.
  starts_line := (at: Position) ->
    index := @token_at(at) ? return false
    index == 0 or LINE_STARTS_AFTER.contains(@tokens[index - 1].kind)

  # The last line that holds a token of the statement that starts at `start`, which ends at the
  # line end that ends it, at the end of its block, or before `next`, where the statement after it
  # in its block starts, past the blocks of its own and the clauses after them, as an `else`.
  statement_last_line := (start: Position, next: Position?) ->
    first := @token_at(start)!
    stop := (next then @token_at(next)) ? @tokens.length
    var depth = 0
    var last = first
    for index in first...stop
      kind := @tokens[index].kind
      if kind == INDENT
        depth += 1
      else if kind == DEDENT
        depth -= 1
        break if depth < 0
      else if kind == NEWLINE
        break if depth == 0 and @tokens[index + 1].kind != INDENT
      else if kind == EOF
        break
      else
        last = index
    @tokens[last].end_line

  # The line of the token before the one at the position, past the layout between them.
  line_before := (at: Position) ->
    var index = @token_at(at)! - 1
    index -= 1 while index > 0 and LAYOUT_KINDS.contains(@tokens[index].kind)
    @tokens[index].line

  # The line before that of the first token after the line, or the last line.
  line_before_next := (line: Int) ->
    for token in @tokens
      continue if token.line <= line or token.kind in LAYOUT_KINDS
      return token.line - 1
    @lines.length

  # The index of the token that starts at the position, if one does.
  token_at := (position: Position) -> @token_indexes[position]

  # The index of the line end that ends the line of the token at `start`, past the brackets that
  # are open there, or of the EOF.
  head_end := (start: Int) ->
    var index = start
    while @tokens[index].kind != EOF and @tokens[index].kind != NEWLINE
      index = @closing(index) if is_opening(@tokens[index].kind)
      index += 1
    index

  # The index of the DEDENT that ends the block that the INDENT at `indent` starts, or of the EOF.
  block_end := (indent: Int) ->
    var depth = 0
    var index = indent
    while true
      kind := @tokens[index].kind
      depth += 1 if kind == INDENT
      depth -= 1 if kind == DEDENT
      return index if depth == 0 or kind == EOF
      index += 1
    indent

  # The index of the bracket that closes the one at `open`, past the pairs nested in it.
  closing := (open: Int) -> @matching(open, 1)

  # The index of the bracket that opens the one at `close`, past the pairs nested in it.
  opening := (close: Int) -> @matching(close, -1)

  matching := (start: Int, step: Int) -> matching_in(@tokens, start, step)

  # The index of the first token of the kind from `start` up to `end`, if there is one.
  find := (kind: TokenKind, start: Int, end: Int) ->
    for index in start...end
      return index if @tokens[index].kind == kind
    nil

  slice := (line: Int, start: Int, end: Int) -> slice_columns(@lines[line - 1], start, end)

export source_text := (source: String, lexed: Lexed) ->
  raw_lines := source.split("\n")
  lines := [without_carriage_return(line) for line in raw_lines]
  SourceText raw_lines, lines, tokens: lexed.tokens, comments: lexed.comments

separator_places := (tokens: Token[]) ->
  places: Map<Int, Position>
  for token in tokens
    if token.kind == NEWLINE and not token.text.is_empty() and token.line not in places
      places[token.line] = token.position()
  places

lines_of := (comments: Comment[]) ->
  lines: Map<Int, Bool>
  lines[comment.line] = comment.own_line for comment in comments
  lines

# A layout token, as an INDENT, can share the position of the token after it, which is the one
# that starts there.
index_tokens := (tokens: Token[]) ->
  indexes: Map<Position, Int>
  for token, index in tokens
    position := token.position()
    indexes[position] = index unless token.kind in LAYOUT_KINDS
  indexes

LAYOUT_KINDS: TokenKind[] = [NEWLINE, INDENT, DEDENT, EOF]
LINE_STARTS_AFTER: TokenKind[] = [NEWLINE, INDENT, DEDENT]

# The text of the comment as written, without the spaces after it.
text_of := (comment: Comment, lines: String[]) ->
  line := lines[comment.line - 1]
  slice_columns(line, comment.column, columns(line) + 1).trim_end()

# The lines that hold tokens that the comments mark: the line that `# fmt: skip` ends, or the next
# that holds a token after `# fmt: skip` on a line of its own, and those from `# fmt: off` up to
# `# fmt: on`, or to the end of the file.
lines_marked := (lines: String[], tokens: Token[], comments: Comment[], stranded: Comment[]) ->
  token_lines: Set<Int>
  for token in tokens
    token_lines.add token.line unless token.kind in LAYOUT_KINDS
  marked: Set<Int>
  marked.add comment.line for comment in stranded
  mark := (first: Int, last: Int) ->
    for line in first..=last
      marked.add line if line in token_lines
  var off_line: Int?
  for comment in comments
    text := text_of(comment, lines)
    if text == '# fmt: skip'
      if comment.own_line
        var line = comment.line + 1
        line += 1 while line <= lines.length and line not in token_lines
        marked.add line
      else
        marked.add comment.line
    else if text == '# fmt: off'
      off_line = comment.line if off_line == nil
    else if text == '# fmt: on'
      if off := off_line
        mark off + 1, comment.line - 1
        off_line = nil
  mark off + 1, lines.length if off := off_line
  marked

# The comments that the formatter cannot place, as it flushes a comment before the next token. A
# `# fmt:` comment is left out, as lines_marked keeps its line anyway.
stranded_comments := (lines: String[], tokens: Token[], comments: Comment[]) ->
  code := [token for token in tokens when token.kind not in LAYOUT_KINDS]
  # The index in `code` of the first token after the comment, which comes after those before it.
  var next = 0
  is_stranded := (comment: Comment) ->
    next += 1 while next < code.length and code[next].line <= comment.line
    return false if text_of(comment, lines).starts_with('# fmt: ')
    before_literal(code, next) or (not comment.own_line and ends_opening_line(code, next))
  [comment for comment in comments when is_stranded(comment)]

# A comment before `code[next]` that starts a function literal: its `weak`, as the comment would
# go between the `weak` and the literal, or, were the `weak` placed, before it on the line of a
# callee that the literal follows; the `->` of one without parameters, as flushing it there
# leaves the literal written where it does not parse, as an argument, an item or a value in
# parentheses (no other `->` follows a comment in a program that parses); or its type parameters
# or its parameters (see starts_parameters).
before_literal := (code: Token[], next: Int) ->
  return false if next >= code.length
  weak := next + 1 < code.length and starts_weak_literal(code[next], code[next + 1])
  weak or code[next].kind == '->' or starts_parameters(code, next)

# Whether `code[next]` starts the type parameters or the parameters of a function literal, as the
# parser tells them (see looks_like_parameters): flushed before the first parameter, the comment
# would break the parameters apart from their brackets. A function type in parentheses is taken
# for them too, as the comment would break its parameter types apart likewise.
starts_parameters := (code: Token[], next: Int) ->
  case code[next].kind
    when '<' then true
    when '(' then opens_parameters(code, next)
    else false

opens_parameters := (code: Token[], open: Int) ->
  kind_at := (index: Int) -> index < code.length then code[index].kind else TokenKind.EOF
  second := kind_at(open + 1)
  third := kind_at(open + 2)
  return third == ':' or third == '->' if second == ')'
  return true if second == IDENTIFIER and (third == ':' or third == '=')
  kind_at(matching_in(code, open, 1) + 1) == '->'

# The index of the bracket that pairs with the one at `start`, going from it by `step`, or the index
# just outside the tokens that way where none does, as in a source that does not parse, which
# stranded_comments reads before the parser does.
matching_in := (tokens: Token[], start: Int, step: Int) ->
  var depth = 0
  var index = start
  while index in 0...tokens.length
    kind := tokens[index].kind
    depth += 1 if is_opening(kind)
    depth -= 1 if is_closing(kind)
    return index if depth == 0
    index += step
  index

# A comment that ends a line whose last token, `code[next - 1]`, is `not`, `not in`, or a `(` or a
# `-` that does not follow an operand, as the `(` of a call, written without a space, and an
# operator between operands do, which would leave the operand at the start of a line of its own,
# where it does not parse.
ends_opening_line := (code: Token[], next: Int) ->
  return false if next < 1
  last := code[next - 1]
  before := next >= 2 then code[next - 2].kind else TokenKind.NEWLINE
  follows_operand := before in OPERAND_ENDS
  call := last.kind == '(' and not last.spaced and follows_operand
  opens := (last.kind == '(' and not call) or (last.kind == '-' and not follows_operand)
  not_in := before == 'not' and is_word(last, 'in')
  opens or last.kind == 'not' or not_in

# A `weak` before the type parameters, the parameters or the `->` of a function literal, after a
# space, rather than the name of a weak declaration or of a function named `weak` called with
# parentheses. A call of one without them, `weak (2) + 1`, is taken for a literal too, which only
# keeps its statement as written.
starts_weak_literal := (token: Token, after: Token) ->
  is_word(token, 'weak') and after.spaced and after.kind in WEAK_LITERAL_STARTS

WEAK_LITERAL_STARTS: TokenKind[] = ['<', '(', '->']

is_word := (token: Token, word: String) -> token.kind == IDENTIFIER and token.text == word

# The kinds of the tokens that end an operand, after which a `-` is the operator between two, and a
# `(` without a space before it opens the arguments of a call.
OPERAND_ENDS: TokenKind[] =
  IDENTIFIER, INTEGER, FLOAT, STRING, INTERPOLATED, BINARY, 'true', 'false', 'nil', '@', '!', ')',
  ']', '}'

is_opening := (kind: TokenKind) -> kind in OPENING_BRACKETS
is_closing := (kind: TokenKind) -> kind in CLOSING_BRACKETS

# The part of the line from the column `start` up to `end`, which is exclusive, counted in code
# points from 1; columns past the end of the line add nothing.
slice_columns := (line: String, start: Int, end: Int) ->
  scanner := scan(line)
  scanner.next() for _ in 1...start
  taken := scanner.mark()
  scanner.next() for _ in start...end
  taken()

# The columns that the text takes, one for each code point.
export columns := (text: String) -> text.count()
