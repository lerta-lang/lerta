# The walk of comprehensions (see walk.lerta).
import Comprehension, is_nested from '../ast'
import CodeGap, ComprehensionShape, ForFirstShape, LineStart from './shapes'
import NONE, ONE, unhandled, Walker from './walk'
import add_result_calls from './typed'
import './walk_expressions'
import './walk_statements'

extend Walker
  # `[element for x in xs when guard]`, with a `for` more for each nested comprehension, or the same
  # in parentheses, an Iter (see ComprehensionShape).
  comprehension := (node: Comprehension, before: CodeGap) ->
    lazy := node.lazy != nil
    open := @take(lazy then '(' else '[', before)
    outer := @save()
    @shapes = []
    @in_brackets = true
    @on_own_line = false
    @breaks_operations = true
    parts := [@at]
    chain := nested_chain(node)
    @expression chain.last()!.element, NONE
    for each in chain
      parts.push @take('for', ONE)
      @loop_names each.variable, each.index
      @take_spelled 'in', ONE
      @expression each.iterable, ONE
      if guard := each.guard
        parts.push @take_spelled('when', ONE)
        @expression guard, ONE
    close := @take(lazy then ')' else ']', NONE)
    shape := ComprehensionShape(open, close, parts, shapes: @shapes)
    @restore outer
    @shapes.push shape

  # A comprehension with its `for` first, laid out as a `for` statement in its brackets: its header
  # on the line after the opening one, its block below it, and the closing bracket on a line of its
  # own (see ForFirstShape). One whose block ends with a `for`, which the tree holds as a
  # comprehension nested in its element, is laid out as it is written, so far. Its element is a
  # value, whose calls keep their parentheses.
  prefix_comprehension := (node: Comprehension, before: CodeGap) ->
    unhandled() if node.element is Comprehension
    lazy := node.lazy != nil
    open := @take(lazy then '(' else '[', before)
    outer := @save()
    @shapes = []
    @in_brackets = false
    @on_own_line = true
    head := @take('for', LineStart(@depth + 1))
    @loop_names node.variable, node.index
    @take_spelled 'in', ONE
    @operand node.iterable, ONE
    if guard := node.guard
      @take_spelled 'when', ONE
      @operand guard, ONE
    header := @shapes
    add_result_calls @elements, node.element
    block := @block(node.body + [node.element], @depth + 2, head)
    @restore outer
    @shapes.push ForFirstShape(open, head, block, shapes: header)
    @close head, true
    @take(lazy then ')' else ']', NONE)

# The comprehension and those nested in it, each the element of the one before, in the order of
# their `for`s.
nested_chain := (comprehension: Comprehension) ->
  chain := [comprehension]
  chain.push chain.last()!.element as Comprehension! while is_nested(chain.last()!.element)
  chain
