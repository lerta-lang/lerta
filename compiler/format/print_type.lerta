# Types as written: named types, unions, function types, anonymous structs, tuples and arrays, and
# type parameters.
import
  ArrayTypeName, FunctionTypeName, NamedType, RecordTypeName, TupleTypeName, TypeName,
  TypeParameter, UnionTypeName
from '../ast'
import Doc, join, rule, separated, text, token from './doc'
import PARENTHESES from './rules'

export type_doc := (type: TypeName): Doc ->
  case type
    when NamedType then named_type(type)
    when UnionTypeName then separated([type_doc(member) for member in type.members], text(' | '))
    when FunctionTypeName
      params := separated([type_doc(param) for param in type.params], text(', '))
      result := type_doc(type.result)
      function := join([token('(', type.position), params, text(') -> '), result])
      type.optional then join([text('('), function, text(')?')]) else function
    when RecordTypeName
      field_docs := [
        join([token(field.name.name, field.name.position), text(': '), type_doc(field.type)])
        for field in type.fields
      ]
      fields := separated(field_docs, text(', '))
      join [token('{ ', type.position), fields, text(' }'), optional_mark(type.optional)]
    when TupleTypeName
      items := separated([type_doc(item) for item in type.items], text(', '))
      join [token('(', type.position), items, text(')'), optional_mark(type.optional)]
    when ArrayTypeName then join([element_doc(type), text('[]'), optional_mark(type.optional)])

# A function type returned by a function literal, which its `->` would end, is in parentheses.
export result_type_doc := (type: TypeName) ->
  function := type is FunctionTypeName and not type.optional
  function then join([text('('), type_doc(type), text(')')]) else type_doc(type)

export named_type := (type: NamedType) ->
  name := token(type.name, type.position)
  args := type_arguments(type.args)
  join [name, args, optional_mark(type.optional)]

export type_arguments := (args: TypeName[]) ->
  return text('') if args.is_empty()
  join [text('<'), separated([type_doc(arg) for arg in args], text(', ')), text('>')]

export type_parameters := (params: TypeParameter[]) ->
  return text('') if params.is_empty()
  docs := [type_parameter(param) for param in params]
  join [text('<'), separated(docs, text(', ')), text('>')]

type_parameter := (param: TypeParameter) ->
  name := token(param.name.name, param.name.position)
  if bound := param.bound
    join [name, text(': '), named_type(bound)]
  else
    name

# An array's element, in parentheses if `[]` would otherwise apply to a part of it. An array
# written with its element in parentheses takes the position of their `(`.
element_doc := (array: ArrayTypeName) ->
  element := array.element
  bare := type_doc(element)
  was_in_parentheses := array.position != element.position
  is_function := element is FunctionTypeName and not element.optional
  if is_function or element is UnionTypeName
    open := was_in_parentheses then token('(', array.position) else text('(')
    return join([open, bare, text(')')])
  was_in_parentheses then rule(PARENTHESES, bare) else bare

optional_mark := (optional: Bool) -> text(optional then '?' else '')
