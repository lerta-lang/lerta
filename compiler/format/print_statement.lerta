# Statements and blocks: declarations, assignments, `if`, `while` and `for` in their block and
# postfix forms (see Postfix forms), and calls without parentheses (see Calls without parentheses).
import
  ArrayLiteral, ArrayTypeName, Assignment, Await, BinaryOperation, Binding, BooleanLiteral, Call,
  Case, Coalesce, Comprehension, Condition, Conditional, Declaration, EnumDeclaration, Expression,
  Extend, Extern, FloatLiteral, For, FunctionLiteral, Identifier, If, Import, IntegerLiteral,
  InterfaceDeclaration, Interpolation, IsTest, Cast, MapLiteral, Member, NamedType, NilLiteral,
  Pass, Position, Range, RecordLiteral, Return, Statement, StringLiteral, This, Throw, Try,
  TupleLiteral, TupleItem, TypeAlias, TypeDeclaration, TypeName, UnaryOperation, UnionTypeName,
  Unwrap, While, Yield, Index
from '../ast'
import
  choice, Doc, has_line_feed, indent, join, line_feed, rule, separated, text, token
from './doc'
import declaration_doc, exported from './print_declaration'
import SourceText from './source'
import type_doc from './print_type'
import
  BRANCHES, CALLS_WITHOUT_PARENTHESES, EMPTY_INITIAL_VALUES, ENUM_MEMBERS, NIL_INITIAL_VALUES,
  POSTFIX_FORMS
from './rules'
import arguments, call_doc, expression_doc, loop_header from './print_expression'
import value_after from './print_literal'
import function_doc from './print_block'
import kept_or_printed from './kept'
import Context, has_left_out_names, keyword, removed_type, word_before from './printing'

# The statements, one on each line, or as they are written where they are kept (see
# kept_or_printed).
export block_doc := (statements: Statement[], context: Context) ->
  lines: Doc[]
  # An import that all its names are left out of is left out, and reported where it was.
  var left_out: Doc[] = []
  written := written_statements(statements)
  starts := [start_of(statement, context) for statement in written]
  for statement, i in written
    next := i + 1 < starts.length then starts[i + 1]
    printed := -> written_doc(statement, context)
    if doc := kept_or_printed(starts[i], next, context.source, context.lines, printed)
      lines.push join([left_out..., doc])
      left_out = []
    else
      left_out.push left_out_import_mark(statement as Import!)
  separated lines, line_feed()

# The statements as the source writes them: the parts of a destructuring, which the parser declares
# one by one after the declaration that holds the value, are the one statement of that.
written_statements := (statements: Statement[]) ->
  written: Statement[]
  var i = 0
  while i < statements.length
    statement := statements[i]
    written.push statement
    i += 1
    if holder := destructuring_holder(statement)
      i += 1 while i < statements.length and takes_apart(statements[i], holder.name.name)
  written

# Nothing for an import that is left out.
written_doc := (statement: Statement, context: Context): Doc? ->
  return nil if is_left_out_import(statement, context)
  if holder := destructuring_holder(statement)
    destructuring_doc holder, context
  else
    statement_doc statement, context

# Where the first token of the statement is in the source, which may come before its position, as
# `export` and the word of a destructuring.
start_of := (statement: Statement, context: Context) ->
  source := context.source
  var index = source.token_at(statement.position) ? return statement.position
  if holder := destructuring_holder(statement)
    open := destructuring_open(holder, context) ? return statement.position
    index = var_before(source, open) then open - 1 else open
  index -= 1 if index > 0 and source.spelling(source.tokens[index - 1]) == 'export'
  first := source.tokens[index]
  Position line: first.line, column: first.column

# Where an import was left out, after the comments before it, which an empty text at its position
# prints: the place that reports it, which holds no text.
export left_out_import_mark := (import_node: Import) ->
  join [token('', import_node.position), rule(ENUM_MEMBERS, text(''))]

export is_left_out_import := (statement: Statement, context: Context) ->
  import_node := statement as Import ? return false
  takes_none := import_node.names.length == 0 and import_node.alias == nil
  takes_none and has_left_out_names(import_node, context)

# The declaration that holds the value of a destructuring, whose name no source can write.
destructuring_holder := (statement: Statement) ->
  return nil if statement is not Declaration
  name := statement.name.name
  name.starts_with('_tuple.') or name.starts_with('destructured.') then statement

# Whether the statement declares a part of what the holder named `holder` holds.
takes_apart := (statement: Statement, holder: String) ->
  return false if statement is not Declaration
  value := statement.value
  object :=
    case value
      when Member then value.object
      when TupleItem then value.tuple
      else return false
  object is Identifier and object.name == holder

# `(a, b) := value` or `var { a, b } = value`, as the source names them.
destructuring_doc := (holder: Declaration, context: Context) ->
  source := context.source
  open := destructuring_open(holder, context) ? return text('')
  close := source.closing(open)
  names := [
    text(source.spelling(source.tokens[i]))
    for i in (open + 1)...close
    when source.tokens[i].kind == IDENTIFIER
  ]
  open_token := source.tokens[open]
  is_tuple := open_token.kind == '('
  at_open := at_token(open_token.line, open_token.column)
  pattern :=
    if is_tuple
      join [token('(', at_open), separated(names, text(', ')), text(')')]
    else
      join [token('{ ', at_open), separated(names, text(', ')), text(' }')]
  value := value_after(holder.value, context)
  if word := var_before(source, open)
    join [token('var ', at_token(word.line, word.column)), pattern, text(' ='), value]
  else
    join [pattern, text(' :='), value]

# The `var` before the names of a destructuring, which `:=` does without.
var_before := (source: SourceText, open: Int) ->
  return nil if open == 0
  before := source.tokens[open - 1]
  before.kind == 'var' then before

at_token := (line: Int, column: Int) -> Position(line, column)

# The index of the bracket that the names of the destructuring are in.
destructuring_open := (holder: Declaration, context: Context) ->
  source := context.source
  value_index := source.token_at(holder.value.position) ? return nil
  # The value may start on a line below the `=`.
  var equals = value_index - 1
  equals -= 1 while source.tokens[equals].kind != '=' and source.tokens[equals].kind != ':='
  var open = equals - 1
  var depth = 0
  while true
    kind := source.tokens[open].kind
    depth += 1 if kind == ')' or kind == '}'
    depth -= 1 if kind == '(' or kind == '{'
    break if depth == 0
    open -= 1
  open

export statement_doc := (statement: Statement, context: Context): Doc ->
  case statement
    when Declaration then variable_doc(statement, context)
    when Assignment then assignment_doc(statement, context)
    when If
      if statement.nil_safe
        expression_doc statement, context
      else if body := statement_if_postfix(statement, context)
        condition := condition_doc(statement.condition, context)
        postfix := join([statement_doc(body, context), text(' if '), condition])
        rule POSTFIX_FORMS, choice(postfix, if_doc(statement, context))
      else
        if_doc statement, context
    when While then while_doc(statement, context)
    when For then for_doc(statement, context)
    when Pass then token('pass', statement.position)
    when TypeDeclaration, EnumDeclaration, InterfaceDeclaration, TypeAlias, Extern, Extend, Import
      declaration_doc statement, context
    when Call then call_statement(statement, context)
    else expression_doc(statement, context)

# A statement that an arm or a function literal can hold on its line.
export is_inline := (statement: Statement, context: Context) ->
  is_simple_statement(statement) or (not context.in_brackets and has_postfix_form(
    statement, context
  ))

# A statement that holds no block and has no postfix form.
is_simple_statement := (statement: Statement) ->
  case statement
    when Declaration, While, For, TypeDeclaration, EnumDeclaration, InterfaceDeclaration then false
    when TypeAlias, Extern, Extend, Import, Case, Try then false
    when If then statement.nil_safe
    else true

# An `if`, a `while` or a `for` that can be written in its postfix form, which a line holds.
has_postfix_form := (statement: Statement, context: Context) ->
  case statement
    when If then not statement.nil_safe and statement_if_postfix(statement, context) != nil
    when While then while_postfix(statement, context) != nil
    when For then for_postfix(statement, context) != nil
    else false

# The statement on the line of an arm or a function literal.
export inline_statement := (statement: Statement, context: Context) ->
  statement_doc statement, context.after_head()

variable_doc := (declaration: Declaration, context: Context) ->
  { mutable, position, weak, name } := declaration
  parts := [exported(declaration.exported, position, context)]
  parts.push text('weak ') if weak
  parts.push keyword('var ', position) if mutable
  parts.push token(name.name, name.position)
  parts.push removed_type('variable', name.position, context)
  # A const of an array, Map or Set type is empty at first without its value (see Empty initial
  # values), and the type of an empty Map or Set moves from its type arguments.
  if empty_type := starts_empty(declaration)
    written := join([text(': '), type_doc(empty_type), rule(EMPTY_INITIAL_VALUES, text(''))])
    return join([parts..., rule(EMPTY_INITIAL_VALUES, written)])
  parts.push join([text(': '), type_doc(type)]) if type := declaration.type
  # `var x: T?` is nil at first without `= nil` (see Nil initial values).
  return join([parts..., rule(NIL_INITIAL_VALUES, text(''))]) if starts_nil(declaration)
  parts.push text(mutable or declaration.type then ' =' else ' :=')
  parts.push value_after(declaration.value, context)
  join parts

# The type is written with `?`, or the value is left out already: one that an alias makes optional
# keeps `= nil` where it is written, which is still right.
starts_nil := (declaration: Declaration) ->
  return true if declaration.omits_value
  { mutable, type, value } := declaration
  written := type ? return false
  optional := written is not UnionTypeName and written.optional
  mutable and optional and value is NilLiteral

# The type that a const of `[]`, or of `Map<K, V>()` or `Set<T>()`, is written with alone: the type
# of the array, or that of the type arguments.
starts_empty := (declaration: Declaration): TypeName? ->
  return nil if declaration.mutable
  { type, value } := declaration
  if value is ArrayLiteral
    array := type as ArrayTypeName ? return nil
    return value.elements.length == 0 and not array.optional then array
  call := value as Call ? return nil
  callee := call.callee as Identifier ? return nil
  is_collection := callee.name == 'Map' or callee.name == 'Set'
  empty := call.args.length == 0 and call.named_args.length == 0
  return nil if type or not is_collection or not empty or call.type_args.length == 0
  NamedType name: callee.name, args: call.type_args, position: callee.position

assignment_doc := (assignment: Assignment, context: Context) ->
  target := expression_doc(assignment.target, context)
  join [target, text(" #{assignment.operator}"), value_after(assignment.value, context)]

condition_doc := (condition: Condition, context: Context) ->
  case condition
    when Binding
      name := token(condition.name.name, condition.name.position)
      join [name, text(' := '), expression_doc(condition.value, context)]
    else expression_doc(condition, context)

# `if` and its block, and `else if` or `else` and its block (see Branches).
export if_doc := (if_node: If, context: Context): Doc ->
  head := join([keyword('if ', if_node.position), condition_doc(if_node.condition, context)])
  parts := [head, block_below(if_node.then_body, context)]
  else_body := if_node.else_body
  if is_else_if(else_body, context)
    word := word_before(else_body[0].position, 'else', context)
    else_if := join([line_feed(), word, text(' '), if_doc(else_body[0] as If!, context)])
    parts.push rule(BRANCHES, else_if)
  else if else_body.length > 0
    word := word_before(else_body[0].position, 'else', context)
    parts.push join([line_feed(), word, block_below(else_body, context)])
  join parts

# Whether an `else` is written `else if`: not when a comment comes before its `if`, which `else if`
# would move above it.
is_else_if := (else_body: Statement[], context: Context) ->
  return false if else_body.length != 1 or else_body[0] is not If
  not (else_body[0] as If!).nil_safe and not context.source.comment_before(else_body[0].position)

block_below := (body: Statement[], context: Context) ->
  indent join([line_feed(), block_doc(body, context)])

# `statement if c`, for an `if` without `else` whose block holds one statement that can have it.
statement_if_postfix := (if_node: If, context: Context) ->
  return nil if if_node.else_body.length > 0 or if_node.then_body.length != 1
  return nil if context.source.block_has_comments(if_node.position)
  statement := if_node.then_body[0]
  takes_postfix(statement) then statement

# A statement that a postfix `if`, `while` or `for` can follow: one that no block, no postfix form
# of its own and nothing that would take the postfix condition, as a function literal at its end,
# is part of.
takes_postfix := (statement: Statement) ->
  is_simple_statement(statement) and not ends_open(statement)

ends_open := (statement: Statement): Bool ->
  case statement
    when Assignment then ends_open(statement.value)
    when Return
      if value := statement.value
        ends_open value
      else
        false
    when Throw then ends_open(statement.message)
    when Yield then ends_open(statement.value)
    when Await then ends_open(statement.operand)
    when BinaryOperation then ends_open(statement.right)
    when UnaryOperation then ends_open(statement.operand)
    when Coalesce then ends_open(statement.fallback)
    when Conditional then ends_open(statement.else_value)
    when Range then ends_open(statement.end)
    when Call
      args := statement.args
      args.length > 0 and ends_open(args[args.length - 1])
    when FunctionLiteral, Case, Try then true
    when If then not statement.nil_safe
    else false

while_doc := (while_node: While, context: Context) ->
  condition := condition_doc(while_node.condition, context)
  word := keyword('while ', while_node.position)
  block := join([word, condition, block_below(while_node.body, context)])
  body := while_postfix(while_node, context) ? return block
  postfix := join([statement_doc(body, context), text(' while '), condition])
  rule POSTFIX_FORMS, choice(postfix, block)

# The one statement of the block, if the `while` can be written in its postfix form.
while_postfix := (while_node: While, context: Context) ->
  body := while_node.body
  has_comments := context.source.block_has_comments(while_node.position)
  body.length == 1 and takes_postfix(body[0]) and not has_comments then body[0]

# A `for`, whose block starts with the declarations that take its item apart, as the parser makes
# them for `for (a, b) in xs`.
for_doc := (for_node: For, context: Context) ->
  body := [statement for statement in for_node.body when not is_loop_part(statement)]
  header := loop_header(for_node.variable, for_node.index, for_node.iterable, context)
  block := join([header, block_below(body, context)])
  only := for_postfix(for_node, context) ? return block
  postfix := join([statement_doc(only, context), text(' '), header])
  rule POSTFIX_FORMS, choice(postfix, block)

# The one statement of the block, if the `for` can be written in its postfix form.
for_postfix := (for_node: For, context: Context) ->
  body := [statement for statement in for_node.body when not is_loop_part(statement)]
  has_comments := context.source.block_has_comments(for_node.position)
  body.length == 1 and takes_postfix(body[0]) and not has_comments then body[0]

is_loop_part := (statement: Statement) -> statement is Declaration and statement.of_loop

# A call at the start of a statement, without parentheses where it can be: its callee is a name, or
# names joined by `.`, and its first argument starts as an argument of such a call can (see
# starts_spaced_operand). One that does not fit on its line takes them back to break inside them.
call_statement := (call: Call, context: Context) ->
  with_parentheses := call_doc(call, context, true)
  could := call.type_args.length == 0 and is_command_callee(call.callee) and starts_command(call)
  return with_parentheses if not could
  # On the line of an arm or of a function literal, a call keeps its parentheses.
  return rule(CALLS_WITHOUT_PARENTHESES, with_parentheses) if not context.on_own_line
  inside := context.inside_brackets()
  items := arguments(call, inside)
  # The rule decides the space after the callee, which stands for the parentheses.
  head := rule(CALLS_WITHOUT_PARENTHESES, join([expression_doc(call.callee, context), text(' ')]))
  command_of := (docs: Doc[]) -> join([head, separated(docs, text(', '))])
  leading := [item.doc for item, i in items when i < items.length - 1]
  # A block before the last argument ends its line, which the comma after it cannot follow.
  return with_parentheses if leading.any(has_line_feed)
  # A function literal last takes the lines below for its body, which parentheses could not hold.
  last_arg := call.named_args.length == 0 then call.args.last()
  if last_arg is FunctionLiteral
    return command_of([leading..., function_doc(last_arg, context.after_head())])
  command := command_of([item.doc for item in items])
  fallback :=
    if opened := items[items.length - 1].opened
      choice command_of([leading..., opened]), with_parentheses
    else
      with_parentheses
  choice command, fallback

export is_command_callee := (callee: Expression): Bool ->
  case callee
    when Identifier then not callee.name.starts_with('?')
    when Member then callee.object is This or is_command_callee(callee.object)
    else false

# Whether the call has arguments and the first starts as an argument of a call without
# parentheses can, rather than continuing an expression with the callee.
starts_command := (call: Call) ->
  return true if call.args.length == 0 and call.named_args.length > 0
  return false if call.args.length == 0
  starts_argument leftmost(call.args[0])

leftmost := (expression: Expression): Expression ->
  case expression
    when BinaryOperation then leftmost(expression.left)
    when Range then leftmost(expression.start)
    when IsTest then leftmost(expression.value)
    when Cast then leftmost(expression.value)
    when Coalesce then leftmost(expression.value)
    when Conditional then leftmost(expression.condition)
    when Member
      expression.object is This then expression.object else leftmost(expression.object)
    when Call then leftmost(expression.callee)
    when Index then leftmost(expression.object)
    when Unwrap then leftmost(expression.operand)
    when If
      if expression.nil_safe
        leftmost (expression.condition as Binding!).value
      else
        expression
    else expression

starts_argument := (expression: Expression) ->
  case expression
    when Identifier, StringLiteral, Interpolation, IntegerLiteral, FloatLiteral then true
    when BooleanLiteral, NilLiteral, This, ArrayLiteral, MapLiteral, RecordLiteral then true
    when TupleLiteral, Case, Throw, Await, UnaryOperation then true
    when Comprehension then not expression.spread
    when FunctionLiteral then expression.type_params.length == 0
    else false
