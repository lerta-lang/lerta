# The rewrites that the lines of a statement ask for (see lines.lerta), each the edit of the changes
# to its tokens that lay it out.
import Position from '../ast'
import
  BRANCHES, CALLS_WITHOUT_PARENTHESES, JOINED_LITERALS, LONG_LISTS, MULTI_LINE_LITERALS,
  POSTFIX_FORMS, StyleRule, UNION_LINES
from './rules'
import Change from './edits'
import Breaker, WIDTH from './lines'
import ArmShape, BodyShape, ListShape, PostfixShape, Spaces, UnionShape from './shapes'

extend Breaker
  # The statement keeps its gaps as written, as a rewrite of its tokens lays it out: the edit of the
  # changes, or a report of the rule where they would take out a comment. Only the first edit of a
  # statement applies in a round, as the source that another is to change may be laid out otherwise
  # once the first applies, and they are found again then; the others are reported.
  rewrite := (rule: StyleRule, changes: Change[]) ->
    return if changes.is_empty()
    @keeps = true
    edit :=
      if not @rewritten
        @tokens.edit rule, changes
      else
        nil
    @rewritten = @rewritten or edit != nil
    if edit
      @edits.push edit
    else if report := @tokens.report(rule, changes[0].from)
      @edits.push report

  # A comma between each two items that a line end separates, as on one line, or on lines that they
  # share: a rewrite where it is not.
  with_commas := (items: Int[]) -> @rewrite(LONG_LISTS, @missing_commas(items))

  missing_commas := (items: Int[]) ->
    [
      Change(from: @tokens.end(item - 1), to: @tokens.end(item - 1), text: ',')
      for item in items[1..]
      when @code[item - 1].kind != ','
    ]

  # Each item on a line of its own, without commas, before `close` on a line of its own if it closes
  # them, as line ends separate items only so: a rewrite where they are not (see line_start).
  on_own_lines := (items: Int[], item_last: (Int) -> Int, close: Int?) ->
    first := items[0]
    indentation := @source_indentation(first - 1)
    columns := indentation + 2
    changes: Change[]
    for item at i in items
      has_comma := i > 0 and @code[item - 1].kind == ','
      continue if i > 0 and not has_comma
      if item in @line_starts
        continue if i == 0

        # The comma alone, as a comment may end its line, and the item indented as the others.
        changes.push { from: @tokens.end(item - 2), to: @tokens.end(item - 1), text: '' }
        line := Position(line: @code[item].line, column: 1)
        changes.push { from: line, to: @tokens.start(item), text: ' '.repeat(columns) }
      else
        changes.push @line_start(i == 0 then item - 1 else item - 2, item, columns)
      shift := columns - @source_indentation(item)
      changes.append @shifted_lines(item, item_last(i), shift)
    if close != nil and close not in @line_starts
      changes.push @line_start(close - 1, close, indentation)
    @rewrite LONG_LISTS, changes

  # The lines of the code tokens from `first` up to `last` after the first line, moved by `shift`
  # columns, as the line of `first` is, so that they stay as deep under it; but blank lines.
  shifted_lines := (first: Int, last: Int, shift: Int) ->
    changes: Change[]
    return changes if shift == 0
    for line in (@code[first].line + 1)..=@code[last].end_line
      indentation := @tokens.line_indentation(line) else continue
      start := Position(line, column: 1)
      if shift > 0
        changes.push { from: start, to: start, text: ' '.repeat(shift) }
      else
        to := Position(line, column: 1 + min(-shift, indentation))
        changes.push { from: start, to, text: '' }
    changes

  # A line start indented by `columns` in the place of the source after the code token at `last`
  # and before that at `next`. The layout indents it once the rewrite is applied; until then, it is
  # indented from the line of the source that holds the tokens before it, which a line start that
  # the layout decides may not have moved yet.
  line_start := (last: Int, next: Int, columns: Int) ->
    Change(from: @tokens.end(last), to: @tokens.start(next), text: "\n" + ' '.repeat(columns))

  # A union whose line does not fit, with the comment that ends it, breaks before the first member
  # that does not fit on it, on the lines below `=`, one level deeper than the `type`, as it keeps
  # them once they are lines: a rewrite, as the `|` before that member goes. A member that alone
  # does not fit is left to be shortened by hand.
  union := (union: UnionShape) ->
    { members } := union
    line_column := 2 * (@line_depth(@start) + 1) + 1
    starts := (i: Int) -> i == 0 or members[i] in @line_starts
    last_of := (i: Int) ->
      return union.last if i == members.length - 1
      if starts(i + 1)
        members[i + 1] - 1
      else
        members[i + 1] - 2
    var end = 0
    for member at i in members
      width := @end_column(last_of(i)) - @column_of(member)
      end =
        if starts(i)
          line_column + width
        else
          end + 3 + width
      fits := end - 1 <= WIDTH and @fits_comment(last_of(i), end)
      continue if starts(i) or fits
      columns := @source_indentation(@start) + 2
      changes: Change[]
      unless members[0] in @line_starts
        changes.push @line_start(members[0] - 1, members[0], columns)
      changes.push @line_start(member - 2, member, columns)
      @rewrite UNION_LINES, changes
      return

  # The columns that the source indents the line that holds the code token by.
  source_indentation := (index: Int) ->
    var at = index
    at -= 1 while at > 0 and at not in @line_starts
    @code[at].column - 1

  # The arguments without parentheses in them, with commas.
  parenthesize := (args: ListShape) ->
    return if args.bracketed
    { open, close, items } := args
    last := close - 1

    # A member line in them would be an item in the parentheses: they take them once the layout has
    # joined it, in a later round.
    return if @has_member_line(items[0], last)

    # Arguments in a block below the callee stay there, and they, or a function's body below its
    # `->`, end before a `)` on a line of its own.
    in_block := items[0] in @line_starts
    opening_end :=
      if in_block
        @tokens.end open
      else
        @tokens.start items[0]
    spans_lines := @code[last].end_line != @code[open].line
    closing := spans_lines then "\n#{' '.repeat(@source_indentation(open))})" else ')'

    # A `)` on a line of its own goes after the comment that ends the line before it.
    after_comment := spans_lines and last in @ending_comments
    closed_at :=
      if after_comment
        @tokens.end_of_line @code[last].end_line
      else
        @tokens.end last
    @rewrite CALLS_WITHOUT_PARENTHESES, [
      { from: @tokens.end(open), to: opening_end, text: '(' }
      @missing_commas(items)...
      { from: closed_at, to: closed_at, text: closing }
    ]

  # Whether a code token from `first` through `last` starts a member line, as `.map(f)` does.
  has_member_line := (first: Int, last: Int) ->
    for at in first..=last
      return true if at in @line_starts and @code[at].kind == '.'
    false

  # The arguments in parentheses without them, where they can go so: `opening` for the `(`, a space
  # before them on the line of the callee, or a line start before them in a block below it.
  unparenthesize := (args: ListShape, opening: String) ->
    return unless args.unbracketable
    { open, close, items } := args
    @rewrite CALLS_WITHOUT_PARENTHESES, [
      { from: @tokens.start(open), to: @tokens.start(items[0]), text: opening }
      @tokens.removed_with_spaces_before(close)
    ]

  # The arguments on the line of the callee, separated by commas: a rewrite where they are in a
  # block below it, or lack commas.
  join_arguments := (list: ListShape) -> @rewrite(LONG_LISTS, @on_one_line(list.items, ' '))

  # The changes that put the items on the line of the token before them, the first after `opening`,
  # separated by commas.
  on_one_line := (items: Int[], opening: String): Change[] ->
    [
      for item at i in items
        has_comma := i > 0 and @code[item - 1].kind == ','
        written := item not in @line_starts and (has_comma or (i == 0 and opening == ' '))
        continue if written
        before := has_comma then item - 2 else item - 1
        separator := i == 0 then opening else ', '
        { from: @tokens.end(before), to: @tokens.start(item), text: separator }
    ]

  # The block literal in its brackets on the line of the head of its value, as `[` and `]`, or as
  # `{ ` and ` }`, before the members after it.
  bracket := (literal: ListShape, opening: String, closing: String, members: Bool) ->
    last := literal.close - 1
    to := members then @tokens.start(literal.close) else @tokens.end(last)
    @rewrite JOINED_LITERALS, [
      @on_one_line(literal.items, ' ' + opening)...
      { from: @tokens.end(last), to, text: closing }
    ]

  # The literal without its brackets, in a block below the head of its value, and the members after
  # it on the line after the block, as deep as the line of the head: whether its items are where a
  # block can take them, on lines of their own, which they then keep, or on the line of its opening
  # bracket, none spanning lines; and no comment ends the line of that bracket.
  unbracket := (literal: ListShape, members: Bool) ->
    { open, close, items } := literal
    first := items[0]
    on_lines := first in @line_starts
    column := @code[first].column

    # A comment after the opening bracket would go on the line of the head, where no block follows.
    return false if open in @ending_comments

    return false if not on_lines and @spans_any(literal)
    indentation :=
      if on_lines
        column - 1
      else
        @source_indentation(open) + 2
    opening :=
      if on_lines
        Change from: @tokens.end(open - 1), to: @tokens.end(open), text: ''
      else
        @line_start open - 1, first, indentation
    closing :=
      case
        when members then @line_start(close - 1, close + 1, @source_indentation(open))
        when close in @line_starts then @line_left_out(close)
        else @tokens.removed_with_spaces_before(close)
    @rewrite MULTI_LINE_LITERALS, [opening, closing]
    true

  # The line of the code token, which holds it alone, left out, as a comment may end the line before
  # it.
  line_left_out := (index: Int): Change ->
    start := Position(line: @code[index].line, column: 1)
    unless index + 1 < @code.length
      return { from: start, to: @tokens.end(index), text: '' }
    { from: start, to: @tokens.start(index + 1), text: ' '.repeat(@code[index + 1].column - 1) }

  # The statement keeps its gaps as written, and the rule is reported at the code token, as a
  # rewrite left to be done by hand would lay it out.
  report_only := (rule: StyleRule, index: Int) ->
    @keeps = true
    report := @tokens.report(rule, @tokens.start(index)) else return
    @edits.push report

  # `then` after the patterns that end at `last`.
  add_then := (last: Int) ->
    @rewrite BRANCHES, [{ from: @tokens.end(last), to: @tokens.end(last), text: ' then' }]

  # The patterns of the arm, which end at `last`, on lines of their own below `when`, with `then` on
  # the line after them, as they take where they do not fit on the line of `when`.
  patterns_below := (arm: ArmShape, last: Int) ->
    indentation := @source_indentation(arm.start)
    @rewrite LONG_LISTS, [
      @line_start(arm.start, arm.patterns[0], indentation + 2)
      {
        from: @tokens.end(last)
        to: @tokens.end(last)
        text: "\n" + ' '.repeat(indentation) + 'then'
      }
    ]

  # The arm without `then`, its body in a block below it: the patterns on the line of `when`, where
  # `then` is on a line of its own, which would read the block as more of them otherwise; and a body
  # on the line of `then` on the next, its lines after the first, as the blocks of a `try` there, as
  # much deeper.
  remove_then := (arm: ArmShape, then_at: Int, body: BodyShape) ->
    patterns: Change[] =
      if then_at in @line_starts
        @on_one_line arm.patterns, ' '
      else
        []
    start := body.block.starts[0]
    if start in @line_starts
      removed := Change(from: @tokens.end(then_at - 1), to: @tokens.end(then_at), text: '')
      return @rewrite(BRANCHES, [patterns..., removed])
    last := body.block.statements.last()!.end - 1
    @rewrite BRANCHES, [
      patterns...
      @line_start(then_at - 1, start, @source_indentation(arm.start) + 2)
      @shifted_lines(start, last, 2)...
      @shifted_comments(last, @source_indentation(arm.start))...
    ]

  # The lines of comments after the code token at `last`, up to the next, deeper than `columns`,
  # which end the block that the token ends, moved two columns deeper with it.
  shifted_comments := (last: Int, columns: Int) ->
    changes: Change[]
    next_line :=
      if last + 1 < @code.length
        @code[last + 1].line
      else
        @code[last].end_line + 1
    for line in (@code[last].end_line + 1)..next_line
      indentation := @tokens.line_indentation(line) else continue
      continue if indentation <= columns
      start := Position(line, column: 1)
      changes.push { from: start, to: start, text: '  ' }
    changes

  # The statement in its postfix form: its body where its head starts, and the head after it.
  to_postfix := (shape: PostfixShape) ->
    { keyword, body } := shape
    body_last := body.end - 1
    head := @flat_text(keyword, shape.head_last)
    @rewrite POSTFIX_FORMS, [
      { from: @tokens.start(keyword), to: @tokens.start(body.start), text: '' }
      { from: @tokens.end(body_last), to: @tokens.end(body_last), text: ' ' + head }
    ]

  # The statement in its block form: its head where its body starts, and the body in the block
  # below it, `s if g` for that of a `for` with a guard.
  to_block := (shape: PostfixShape) ->
    { body, last } := shape
    body_last := body.end - 1
    line_start := "\n" + ' '.repeat(@source_indentation(body.start) + 2)
    head := @flat_text(shape.keyword, shape.head_last)
    end := shape.guard else last
    rest := shape.guard != nil then ' if' else ''

    # The lines of the guard after its first, which follow the body.
    guard_lines: Change[] =
      if shape.guard != nil
        @shifted_lines shape.guard, last, 2
      else
        []

    @rewrite POSTFIX_FORMS, [
      { from: @tokens.start(body.start), to: @tokens.start(body.start), text: head + line_start }
      @shifted_lines(body.start, body_last, 2)...
      { from: @tokens.end(body_last), to: @tokens.end(end), text: rest }
      guard_lines...
    ]

  # The code tokens from `first` up to `last` on one line, with the gaps between them flat.
  flat_text := (first: Int, last: Int) ->
    var text = ''
    for at in first..=last
      text += @tokens.spelling(at)
      continue if at == last
      gap := @gaps[at + 1] as Spaces!
      comma :=
        if at + 1 in @without_commas
          ','
        else
          ''
      text += comma + ' '.repeat(gap.count)
    text
