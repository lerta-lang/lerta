# What the printers of the AST share: where they print, how they lay out lists, and the helpers for
# the tokens that they place at their positions in the source.
import Expression, Import, Position from '../ast'
import TokenKind from '../lexer/tokens'
import annotation_key, import_prefix from './annotated'
import
  breaking, choice, closing, Doc, has_line_feed, indent, join, line_feed, rule, separated, text,
  token
from './doc'
import StatementLines from './kept'
import LONG_LISTS, TYPE_ANNOTATIONS from './rules'
import SourceText from './source'

# Where a part is printed. Inside brackets, a call without parentheses would take the items after
# it, and no block can be written; on the line of an arm or of a function literal, a call keeps
# its parentheses (see Calls without parentheses).
export struct Context
  source: SourceText
  # The keys of the annotations left out of the syntax tree (see annotation_key), which are reported
  # where they were.
  left_out: String[]
  lines: StatementLines
  # The values of the casts left out, at which they are reported (see Redundant casts).
  uncast: Set<Expression>
  in_brackets = default false
  on_own_line = default true

  inside_brackets = -> @with(true, false)

  # In a block, on lines of its own, as a function's body is inside brackets too.
  in_block = -> @with(false, true)

  # On the line of an arm or a function literal.
  after_head = -> @with(@in_brackets, false)

  with = (in_brackets: Bool, on_own_line: Bool) ->
    Context
      in_brackets
      on_own_line
      source: @source
      left_out: @left_out
      lines: @lines
      uncast: @uncast

# The item of a list, and whether it is simple: a name, a literal, or `name: value` or a parameter
# `name: Type` of such, which share a line with others when the list does not fit on one.
export struct Item
  doc: Doc
  simple: Bool
  # The item broken after its opening bracket, which a call can end its line with when the item is
  # last (`f a, [` and the items below), if it is a list.
  opened: Doc? = default nil
  # Whether a comment of the source comes before it in the list, which ends the line there.
  after_comment = default false
  # The item with its body as a block, if it is a function whose body may go on its line, which a
  # list can end its line with when the item is last (see bracketed).
  as_block: Doc? = default nil

# A list in brackets: on one line if it fits, and otherwise on lines of their own inside the
# brackets, as many on a line as fit if every item is simple, and one on each line otherwise (see
# Long lists). `close_at` is where the closing bracket is in the source, if it is there.
# An item that holds a block, a function's body, ends its line inside the brackets, which a comma
# cannot then follow: only the last item may, and the closing bracket goes on a line of its own
# (see Layout in the lexer); otherwise each item is on a line of its own.
export bracketed := (open: Doc, items: Item[], close: String, close_at: Position?) ->
  closing_text := closing(close, close_at)
  bracketed_or open, items, closing_text, opened_list(open, items, closing_text)

# The list in brackets as `bracketed` lays it out, with `opened` where its items would go on lines
# of their own inside the brackets, and `flat` where they would go on its line, if that is not the
# brackets and the items alone, as with the spaces inside `{}`.
export bracketed_or := (
  open: Doc
  items: Item[]
  closing_text: Doc
  opened: Doc
  flat: Doc? = nil
) ->
  return join([open, closing_text]) if items.length == 0
  docs := [item.doc for item in items]
  holds_block := (item: Item) -> has_line_feed(item.doc)
  blocks := items.find_index(holds_block)
  ending_with := (last: Doc) ->
    leading := [doc for doc, i in docs when i < docs.length - 1]
    join [open, separated([leading..., last], text(', ')), line_feed(), closing_text]
  if first_block := blocks
    return opened if first_block < items.length - 1
    return breaking(LONG_LISTS, ending_with(docs.last()!), opened)
  on_line := flat ? join([open, separated(docs, text(', ')), closing_text])
  # A function last whose body does not fit on its line takes the lines below for it.
  block := items.last()!.as_block ? return breaking(LONG_LISTS, on_line, opened)
  breaking LONG_LISTS, on_line, breaking(LONG_LISTS, ending_with(block), opened)

# The list broken after its opening bracket, with its items on the lines below.
export opened_list := (open: Doc, items: Item[], closing: Doc) ->
  inside := indent(join([line_feed(), lines_of_items(items)]))
  join [open, inside, line_feed(), closing]

# The items on lines of their own: as many on a line as fit if all are simple, with a comma ending
# each line but the last, and otherwise one on each line, without commas.
export lines_of_items := (items: Item[]) ->
  # Lines that a comment ends would hold one item, which no comma ends.
  shares_lines := (item: Item) ->
    item.simple and not item.after_comment and not has_line_feed(item.doc)
  all_simple := items.find_index((item) -> not shares_lines(item)) == nil
  return separated([item.doc for item in items], line_feed()) if not all_simple
  parts: Doc[]
  for item, i in items
    if i > 0
      next_line := join([text(','), line_feed(), item.doc])
      parts.push choice(join([text(', '), item.doc]), next_line)
    else
      parts.push item.doc
  join parts

# Where an annotation was left out of the syntax tree (see `kind` in annotation_key), the place
# that reports it, which holds no text.
export removed_type := (kind: String, at: Position, context: Context) ->
  removed := context.left_out.contains(annotation_key(kind, at))
  removed then rule(TYPE_ANNOTATIONS, text('')) else text('')

# Whether names were left out of the import (see import_names_of): all of them, if it has none left
# and is not `import 'module' as name`, which takes none.
export has_left_out_names := (import_node: Import, context: Context) ->
  prefix := import_prefix(import_node)
  context.left_out.any (key) -> key.starts_with(prefix)

# A keyword at the position, where the source has it there.
export keyword := (word: String, at: Position) -> token(word, at)

# What `doc` makes of the value, or nothing.
export optional_doc := <T>(value: T?, doc: (T) -> Doc): Doc ->
  if present := value
    doc present
  else
    text ''

# A keyword before the token at the position, past line ends and indentation, at its position in the
# source if it is there, so that the comments before it go before it.
export word_before := (at: Position, word: String, context: Context) ->
  if position := position_before(at, word, context)
    token word, position
  else
    text word

# Where the keyword before the token at the position is, past line ends and indentation, if it is
# there.
export position_before := (at: Position, word: String, context: Context) ->
  source := context.source
  at_index := source.token_at(at) ? return nil
  var index = at_index - 1
  index -= 1 while index > 0 and is_layout(source.tokens[index].kind)
  return nil if index < 0
  found := source.tokens[index]
  source.spelling(found) == word then found.position()

export is_layout := (kind: TokenKind) ->
  kind == NEWLINE or kind == LINE_BREAK or kind == INDENT or kind == DEDENT
