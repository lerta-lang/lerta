# What the printers of the AST share: where they print, and how they lay out lists.
import Position from '../ast'
import annotation_key from './annotated'
import breaking, choice, closing, Doc, indent, join, line_feed, rule, separated, text from './doc'
import LONG_LISTS, TYPE_ANNOTATIONS from './rules'
import SourceText from './source'

# Where a part is printed. Inside brackets, a call without parentheses would take the items after
# it, and no block can be written; on the line of an arm or of a function literal, a call keeps
# its parentheses (see Calls without parentheses).
export struct Context
  source: SourceText
  # The keys of the annotations left out of the syntax tree (see annotation_key), which are reported
  # where they were.
  removed_types: String[]
  in_brackets = default false
  on_own_line = default true

  inside_brackets = ->
    Context source: @source, removed_types: @removed_types, in_brackets: true, on_own_line: false

  # On the line of an arm or a function literal.
  after_head = ->
    Context(
      source: @source
      removed_types: @removed_types
      in_brackets: @in_brackets
      on_own_line: false
    )

# The item of a list, and whether it is simple: a name, a literal, or `name: value` or a parameter
# `name: Type` of such, which share a line with others when the list does not fit on one.
export struct Item
  doc: Doc
  simple: Bool
  # The item broken after its opening bracket, which a call can end its line with when the item is
  # last (`f a, [` and the items below), if it is a list.
  opened: Doc? = default nil
  # Whether a comment of the source comes before it in the list, which ends the line there.
  after_comment = default false

# A list in brackets: on one line if it fits, and otherwise on lines of their own inside the
# brackets, as many on a line as fit if every item is simple, and one on each line otherwise (see
# Long lists). `close_at` is where the closing bracket is in the source, if it is there.
export const bracketed = (open: Doc, items: Item[], close: String, close_at: Position?) ->
  const closing_text = closing(close, close_at)
  return join([open, closing_text]) if items.length == 0
  const flat = join([open, separated([item.doc for item in items], text(', ')), closing_text])
  breaking LONG_LISTS, flat, opened_list(open, items, closing_text)

# The list broken after its opening bracket, with its items on the lines below.
export const opened_list = (open: Doc, items: Item[], closing: Doc) ->
  const inside = indent(join([line_feed(), lines_of_items(items)]))
  join [open, inside, line_feed(), closing]

# The items on lines of their own: as many on a line as fit if all are simple, with a comma ending
# each line but the last, and otherwise one on each line, without commas.
export const lines_of_items = (items: Item[]) ->
  # Lines that a comment ends would hold one item, which no comma ends.
  const shares_lines = (item: Item) -> item.simple and not item.after_comment
  const all_simple = items.find_index((item) -> not shares_lines(item)) == nil
  return separated([item.doc for item in items], line_feed()) if not all_simple
  const parts: Doc[] = []
  for item, i in items
    if i > 0
      const next_line = join([text(','), line_feed(), item.doc])
      parts.push choice(join([text(', '), item.doc]), next_line)
    else
      parts.push item.doc
  join parts

# Where an annotation was left out of the syntax tree (see `kind` in annotation_key), the place
# that reports it, which holds no text.
export const removed_type = (kind: String, at: Position, context: Context) ->
  const removed = context.removed_types.contains(annotation_key(kind, at))
  removed then rule(TYPE_ANNOTATIONS, text('')) else text('')
