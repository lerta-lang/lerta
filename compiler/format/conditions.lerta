# The negations that the rewrites write otherwise: those of the conditions of `if` and `while` (see
# Negated conditions), and `x is not T` and `x not in xs` (see Negated is tests and Negated in
# tests).
import BinaryOperation, Expression, is_nil_test, IsTest, UnaryOperation from '../ast'
import
  DOUBLE_NEGATIONS, NEGATED_CONDITIONS, NEGATED_IN_TESTS, NEGATED_IS_TESTS, NEGATED_JUNCTIONS,
  VALUE_DOUBLE_NEGATIONS
from './rules'
import Change from './edits'
import Tokens from './tokens'

# The condition after `if`, `unless`, `while` or `until`, without a double negation, and with
# `unless` or `until` for `not` where the statement takes it: where it has no `else`, `negatable`,
# and follows none. `not` of an `and` or an `or` is only reported, as giving `not` to each operand
# is not done yet. The negations that it rewrites are `claimed`.
export condition_edit := (
  tokens: Tokens, condition: Expression, negatable: Bool, claimed: Set<UnaryOperation>
) ->
  start := tokens.at(condition.position) else return nil
  word := start - 1
  return nil if word < 0 or tokens.code[word].kind not in ['if', 'unless', 'while', 'until']
  is_positive := tokens.code[word].kind in ['if', 'while']
  takes_negation := negatable and not tokens.is_kind(word - 1, 'else')

  # That of `unless` or `until` is `not` of what is written.
  negation := condition as UnaryOperation else return nil
  written := is_positive then condition else negation.operand

  if is_positive
    not_at := not_of(tokens, negation) else return nil
    edit :=
      positive_condition(tokens, word, negation, not_at, takes_negation, claimed) else return nil
    claimed.add negation
    return edit
  if is_junction(written)
    return tokens.report(NEGATED_JUNCTIONS, tokens.start(word))
  is_unless := tokens.code[word].kind == 'unless'
  opposite := tokens.replaced(word, is_unless then 'if' else 'while')
  if inner := written as UnaryOperation?
    not_at := not_of(tokens, inner) else return nil
    claimed.add inner
    return tokens.edit(DOUBLE_NEGATIONS, [opposite, not_removed(tokens, not_at)])
  inverse := inverse_equality(tokens, written) else return nil
  tokens.edit(DOUBLE_NEGATIONS, [opposite, inverse])

# `if x` for `if not not x`, `if a == b` for `if not (a != b)`, or `unless x` for `if not x`.
positive_condition := (
  tokens: Tokens, word: Int, negation: UnaryOperation, not_at: Int, takes_negation: Bool,
  claimed: Set<UnaryOperation>
) ->
  { operand } := negation
  if is_junction(operand)
    return tokens.report(NEGATED_JUNCTIONS, tokens.start(word))
  without_not := not_removed(tokens, not_at)
  if inner := operand as UnaryOperation?
    if inner_not := not_of(tokens, inner)
      claimed.add inner
      return tokens.edit(DOUBLE_NEGATIONS, [without_not, not_removed(tokens, inner_not)])
  if inverse := inverse_equality(tokens, operand)
    return tokens.edit(DOUBLE_NEGATIONS, [without_not, inverse])
  return nil unless takes_negation
  opposite :=
    if tokens.code[word].kind == 'if'
      'unless'
    else
      'until'
  tokens.edit(NEGATED_CONDITIONS, [tokens.replaced(word, opposite), without_not])

# `a == b` for `a != b`, and `x != nil` for `x == nil`, as the opposite of a test.
inverse_equality := (tokens: Tokens, test: Expression) ->
  equality := test as BinaryOperation else return nil
  inverse :=
    case equality.operator
      when '!=' then '=='
      when '==' then is_nil_test(equality) then '!='
      else nil
  right := tokens.at(equality.right.position) else return nil
  operator := right - 1
  return nil if not inverse or tokens.spelling(operator) != equality.operator
  tokens.replaced(operator, inverse)

# `x` for `not not x` in a value (see Negated conditions), and `x is T` for `not x is not T`; the
# parentheses that held the inner negation are left to Parentheses.
export double_negation := (tokens: Tokens, negation: UnaryOperation) ->
  inner := negation.operand as UnaryOperation else return nil
  outer_not := not_of(tokens, negation) else return nil
  inner_not := not_of(tokens, inner) else return nil
  tokens.edit(VALUE_DOUBLE_NEGATIONS, [tokens.removed(outer_not), not_removed(tokens, inner_not)])

# `x is not T` for `not (x is T)`, and `x not in xs` for `not (x in xs)`, without the parentheses
# around the test.
export negated_test := (tokens: Tokens, negation: UnaryOperation) ->
  not_at := not_of(tokens, negation) else return nil
  return nil if tokens.is_word(not_at - 1, 'is') or tokens.is_word(not_at + 1, 'in')
  { operand } := negation
  word := test_word(tokens, operand) else return nil
  is_test := operand is IsTest
  rule := is_test then NEGATED_IS_TESTS else NEGATED_IN_TESTS
  without_not := tokens.removed(not_at)
  written := tokens.replaced(word, is_test then 'is not' else 'not in')
  open := not_at + 1
  close := closing_around(tokens, open, word) else return tokens.edit(rule, [without_not, written])
  return nil if tokens.code[open].line != tokens.code[close].line

  # `not (` goes as one, as the words around it are apart.
  opening := Change(from: tokens.start(not_at), to: tokens.start(open + 1), text: '')
  tokens.edit(rule, [opening, written, tokens.removed_with_spaces_before(close)])

# The `)` of parentheses at `open` around the token at `inside`.
closing_around := (tokens: Tokens, open: Int, inside: Int) ->
  return nil unless tokens.is_kind(open, '(')
  close := tokens.matching(open) else return nil
  close > inside then close

# The index of the `not` of the negation: that of `x is not T` or `x not in xs`, or the `not`
# before its operand.
not_of := (tokens: Tokens, negation: UnaryOperation) ->
  return nil if negation.operator != 'not'
  if word := test_word(tokens, negation.operand)
    return word + 1 if tokens.is_word(word, 'is') and tokens.is_kind(word + 1, 'not')
    return word - 1 if tokens.is_word(word, 'in') and tokens.is_kind(word - 1, 'not')
  var at = tokens.at(negation.position) else return nil
  at += 1 while tokens.is_kind(at, '(')
  if tokens.is_kind(at, 'not')
    at
  else
    nil

# The `is` of `x is T` or `x is not T`, or the `in` of `x in xs`.
test_word := (tokens: Tokens, test: Expression) ->
  case test
    when IsTest
      type := tokens.at(test.type.position) else return nil
      case
        when tokens.is_word(type - 1, 'is') then type - 1
        when tokens.is_word(type - 2, 'is') then type - 2
        else nil
    when BinaryOperation
      return nil if test.operator != 'in'
      right := tokens.at(test.right.position) else return nil
      if tokens.is_word(right - 1, 'in')
        right - 1
      else
        nil
    else nil

# The `not` at the index left out, with the space before it after `is`, and with that after it
# otherwise.
not_removed := (tokens: Tokens, at: Int) ->
  if tokens.is_word(at - 1, 'is')
    tokens.removed_with_spaces_before(at)
  else
    tokens.removed(at)

# An `and` or an `or`.
is_junction := (expression: Expression) ->
  expression is BinaryOperation and expression.operator in ['and', 'or']
