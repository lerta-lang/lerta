# The rules of the style (docs/reference/style.md) that the formatter applies, named by their bold
# labels there, with the message that it reports where code breaks one.
export struct StyleRule
  label: String
  message: String

export const STRING_LITERALS =
  StyleRule(label: 'String literals', message: "write the string with '...'")
export const INSIDE_BRACES = StyleRule(label: 'Inside {}', message: 'put spaces inside {}')
export const SPACING = StyleRule(label: 'Spacing', message: 'put one space here, or none')
export const COMMENTS = StyleRule(label: 'Comments', message: 'put two spaces before the comment')
export const MULTI_LINE_LITERALS =
  StyleRule(label: 'Multi-line literals', message: 'write the literal in a block without brackets')
export const LAYOUT = StyleRule(
  label: 'Layout'
  message: 'indent by two spaces for each level, and end the lines with LF'
)
export const LINE_LENGTH =
  StyleRule(label: 'Line length', message: 'break the line within 100 columns')
export const BLANK_LINES = StyleRule(label: 'Blank lines', message: 'leave at most one blank line')
export const LONG_LISTS = StyleRule(
  label: 'Long lists'
  message: 'put the items of a list that does not fit on lines of their own'
)
export const CALLS_WITHOUT_PARENTHESES = StyleRule(
  label: 'Calls without parentheses'
  message: 'call without parentheses at the start of a statement, with them after `then` or `->`'
)
export const SHORTHAND = StyleRule(label: 'Shorthand', message: 'write the name alone')
export const PARENTHESES = StyleRule(
  label: 'Parentheses'
  message: 'drop the parentheses that change nothing, or add those that clarify'
)
export const CAST_FALLBACKS = StyleRule(label: 'Cast fallbacks', message: 'write `x as T ? y`')
export const NIL_INITIAL_VALUES = StyleRule(
  label: 'Nil initial values'
  message: 'leave out `= nil` of a `var` of an optional type'
)
export const NEGATED_IS_TESTS = StyleRule(label: 'Negated is tests', message: 'write `x is not T`')
export const POSTFIX_FORMS = StyleRule(
  label: 'Postfix forms'
  message: 'write one statement in the postfix form if it fits, and otherwise in a block'
)
export const BRANCHES = StyleRule(
  label: 'Branches'
  message: 'write an arm of one statement on its line, and `else if` for an `else` of one `if`'
)
export const FUNCTION_BODIES = StyleRule(
  label: 'Function bodies'
  message: 'put a body of one statement on the line of `->` if it fits'
)
export const FUNCTIONS_WITHOUT_PARAMETERS =
  StyleRule(label: 'Functions without parameters', message: 'write `-> body` without `()`')
export const TYPE_ANNOTATIONS =
  StyleRule(label: 'Type annotations', message: 'leave out the type, which can be inferred')
