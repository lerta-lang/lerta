# The rules of the style (docs/reference/style.md) that the formatter applies, named by the text
# of their headings there, with the message that it reports where code breaks one.
export struct StyleRule
  label: String
  message: String

export STRING_LITERALS :=
  StyleRule(label: 'String literals', message: "write the string with '...'")
export BINARY_LITERALS :=
  StyleRule(label: 'Binary literals', message: "write `b'...'`, not `'...'.binary`")
export ESCAPES := StyleRule
  label: 'Escapes'
  message: 'write a visible ASCII character as it is, and others as a short escape or `\xHH`'
export INSIDE_BRACES := StyleRule(label: 'Inside {}', message: 'put spaces inside {}')
export SPACING := StyleRule(label: 'Spacing', message: 'put one space here, or none')
export COMMENTS := StyleRule(label: 'Comments', message: 'put two spaces before the comment')
export STRANDED_COMMENTS :=
  StyleRule(label: 'Comments', message: 'move the comment, which the formatter cannot place there')
export MULTI_LINE_LITERALS :=
  StyleRule(label: 'Multi-line literals', message: 'write the literal in a block without brackets')
export JOINED_LITERALS :=
  StyleRule(label: 'Multi-line literals', message: 'write the literal on its line, which it fits')
export LAYOUT := StyleRule
  label: 'Layout'
  message: 'indent by two spaces for each level, and end the lines with LF'
export LINE_LENGTH := StyleRule(label: 'Line length', message: 'break the line within 100 columns')
export UNBREAKABLE_LINES := StyleRule
  label: 'Line length'
  message: 'shorten the line by hand, which the formatter cannot break'
export BLANK_LINES := StyleRule(label: 'Blank lines', message: 'leave at most one blank line')
export LONG_LISTS := StyleRule
  label: 'Long lists'
  message: 'put the items of a list that does not fit on lines of their own'
export LONG_OPERATIONS := StyleRule
  label: 'Long operations'
  message: 'break an operation that does not fit after each operator of its chain'
export CALLS_WITHOUT_PARENTHESES := StyleRule
  label: 'Calls without parentheses'
  message: 'call without parentheses at the start of a statement, with them after `then` or `->`'
export SHORTHAND := StyleRule(label: 'Shorthand', message: 'write the name alone')
# That of a named argument, which changes the syntax tree, as the name alone is a positional one.
export SHORTHAND_ARGUMENTS := StyleRule(label: 'Shorthand', message: 'write the name alone')
export PARENTHESES := StyleRule
  label: 'Parentheses'
  message: 'drop the parentheses that change nothing, or add those that clarify'
export CAST_FALLBACKS := StyleRule(label: 'Cast fallbacks', message: 'write `x as T ? y`')
export MEMBERSHIP_TESTS := StyleRule(label: 'Membership tests', message: 'write `x in xs`')
export RANGE_TESTS := StyleRule(label: 'Range tests', message: 'write `x in a..=b`')
export RANGE_ENDS := StyleRule
  label: 'Ranges'
  message: 'write `a..=b`, not `a..(b + 1)`, and leave out the ends 0 and the length of an index'
export EMPTINESS_TESTS := StyleRule
  label: 'Emptiness tests'
  message: "write `x.is_empty()`, not a test of its length or of `== ''`"
export SHARED_ARM_BODIES := StyleRule
  label: 'Shared arm bodies'
  message: 'write arms next to each other with one body as one arm of their patterns'
export SPREADS :=
  StyleRule(label: 'Spreads', message: 'spread the value whose fields the construction copies')
export REDUNDANT_CASTS :=
  StyleRule(label: 'Redundant casts', message: 'leave out the cast to the type the value has')
export ELSE_NIL := StyleRule(label: 'Else nil', message: 'leave out `else nil` of a `then`')
export NIL_INITIAL_VALUES := StyleRule
  label: 'Nil initial values'
  message: 'leave out `= nil` of a `var` of an optional type'
export NIL_DEFAULTS := StyleRule
  label: 'Nil initial values'
  message: 'leave out `= default nil` of a field of an optional type'
export EMPTY_INITIAL_VALUES := StyleRule
  label: 'Empty initial values'
  message: 'leave out `= []`, `= Map()` or `= Set()` of a `const`, writing its type'
export NEGATED_IS_TESTS := StyleRule(label: 'Negated is tests', message: 'write `x is not T`')
export NEGATED_IN_TESTS := StyleRule(label: 'Negated in tests', message: 'write `x not in xs`')
export NEGATED_CONDITIONS :=
  StyleRule(label: 'Negated conditions', message: 'write `unless x` and `until x` for `not x`')
export NEGATED_JUNCTIONS := StyleRule
  label: 'Negated conditions'
  message: 'write `not a or not b` for `not (a and b)`, and `not a and not b` for `not (a or b)`'
export DOUBLE_NEGATIONS :=
  StyleRule(label: 'Negated conditions', message: 'write the condition without its double negation')
export SEMICOLONS :=
  StyleRule(label: 'Semicolons', message: "put each statement on a line of its own, not after ';'")
export POSTFIX_FORMS := StyleRule
  label: 'Postfix forms'
  message: 'write one statement in the postfix form if it fits, and otherwise in a block'
export BRANCHES := StyleRule
  label: 'Branches'
  message: 'write an arm of one statement on its line, and `else if` for an `else` of one `if`'
export TWO_WAY_VALUES := StyleRule
  label: 'Branches'
  message: 'write a two-way value as `c then a else b` if it fits on one line, else as an `if`'
export FUNCTION_BODIES := StyleRule
  label: 'Function bodies'
  message: 'put a body on the line of `->` if it is one statement that fits there, else below'
export FUNCTIONS_WITHOUT_PARAMETERS :=
  StyleRule(label: 'Functions without parameters', message: 'write `-> body` without `()`')
export UNUSED_IMPORTS := StyleRule
  label: 'Unused names'
  message: "leave out the names that are never used, or write `import 'module'` for its code alone"
export TYPE_ANNOTATIONS :=
  StyleRule(label: 'Type annotations', message: 'leave out the type, which can be inferred')
export EXPECTED_TYPES := StyleRule
  label: 'Expected types'
  message: 'write the member alone, or the struct as `{ ... }`, where its type is expected'
