# The rules of the style (docs/reference/style.md) that the formatter applies, named by their bold
# labels there, with the message that it reports where code breaks one.
export struct StyleRule(label: String, message: String)

export STRING_LITERALS :=
  StyleRule(label: 'String literals', message: "write the string with '...'")
export INSIDE_BRACES := StyleRule(label: 'Inside {}', message: 'put spaces inside {}')
export SPACING := StyleRule(label: 'Spacing', message: 'put one space here, or none')
export COMMENTS := StyleRule(label: 'Comments', message: 'put two spaces before the comment')
export MULTI_LINE_LITERALS :=
  StyleRule(label: 'Multi-line literals', message: 'write the literal in a block without brackets')
export LAYOUT := StyleRule
  label: 'Layout'
  message: 'indent by two spaces for each level, and end the lines with LF'
export LINE_LENGTH := StyleRule(label: 'Line length', message: 'break the line within 100 columns')
export BLANK_LINES := StyleRule(label: 'Blank lines', message: 'leave at most one blank line')
export LONG_LISTS := StyleRule
  label: 'Long lists'
  message: 'put the items of a list that does not fit on lines of their own'
export CALLS_WITHOUT_PARENTHESES := StyleRule
  label: 'Calls without parentheses'
  message: 'call without parentheses at the start of a statement, with them after `then` or `->`'
export SHORTHAND := StyleRule(label: 'Shorthand', message: 'write the name alone')
export PARENTHESES := StyleRule
  label: 'Parentheses'
  message: 'drop the parentheses that change nothing, or add those that clarify'
export CAST_FALLBACKS := StyleRule(label: 'Cast fallbacks', message: 'write `x as T ? y`')
export NIL_INITIAL_VALUES := StyleRule
  label: 'Nil initial values'
  message: 'leave out `= nil` of a `var` of an optional type'
export EMPTY_INITIAL_VALUES := StyleRule
  label: 'Empty initial values'
  message: 'leave out `= []`, `= Map()` or `= Set()` of a `const`, writing its type'
export NEGATED_IS_TESTS := StyleRule(label: 'Negated is tests', message: 'write `x is not T`')
export POSTFIX_FORMS := StyleRule
  label: 'Postfix forms'
  message: 'write one statement in the postfix form if it fits, and otherwise in a block'
export BRANCHES := StyleRule
  label: 'Branches'
  message: 'write an arm of one statement on its line, and `else if` for an `else` of one `if`'
export FUNCTION_BODIES := StyleRule
  label: 'Function bodies'
  message: 'put a body on the line of `->` if it is one statement that fits there, else below'
export FUNCTIONS_WITHOUT_PARAMETERS :=
  StyleRule(label: 'Functions without parameters', message: 'write `-> body` without `()`')
export CONSTRUCTOR_ARGUMENTS := StyleRule
  label: 'Constructor arguments'
  message: 'write members that are all constructor arguments in () if they fit, else in a block'
export TYPE_ANNOTATIONS :=
  StyleRule(label: 'Type annotations', message: 'leave out the type, which can be inferred')
export ENUM_MEMBERS :=
  StyleRule(label: 'Enum members', message: 'write the member alone, where its enum is expected')
