# The expressions that `lerta fmt` may write otherwise, which the checking decides (see
# can_leave_out): the members of enums written with their enums, `E.MEMBER`, written alone, and the
# constructions of structs, `S(x: 1)`, written as records, `{ x: 1 }` (see Expected types in
# docs/reference/style.md); the named arguments of constructions written as names alone (see
# Shorthand there); the casts left out (see Redundant casts); and the tests of emptiness written
# with `is_empty()` (see Emptiness tests); the calls of `contains` written with `in` (see Membership
# tests); and how to write them so in the syntax tree.
import
  BinaryOperation, BooleanLiteral, Call, Case, CaseArm, Cast, construction_arguments,
  construction_spread, Expression, FloatLiteral, Identifier, IntegerLiteral, is_spread, Member,
  NamedValue, NilLiteral, Position, RecordLiteral, spread_of_value, Statement, StringLiteral, This,
  UnaryOperation
from '../ast'
import dump_ast_without_positions from '../ast_dump'
import Annotation, annotation_key from './annotated'
import EMPTINESS_TESTS, MEMBERSHIP_TESTS, REDUNDANT_CASTS, SHARED_ARM_BODIES, SPREADS from './rules'
import Place, places_of from './places'

# In the order of the source, but for a cast and a construction after those inside them, and the
# named arguments of a construction before it: a record takes the arguments of its construction as
# the rewrites inside them leave them (see recorded).
export rewrites_of := (program: Statement[]) ->
  found: Annotation[]
  before := (value: Expression, place: Place) ->
    found.push unqualified(value, place) if value is Member
  after := (value: Expression, place: Place) ->
    found.push uncast(value, place) if value is Cast and value.throws
    found.push emptied(value, test, place) if test := emptiness_test(value)
    if value is Case
      found.push shared_arms(value, run) for run in runs_of_alike_arms(value)
    if value is Call
      found.push spread_copy(value, source) if source := copied_source(value)
      found.push membership(value, place) if is_membership_call(value)
      for named, i in value.named_args
        found.push shorthand(value, named) if is_shorthand(value, i)
      found.push recorded(value, place)
  places_of program, { before, after }
  found

# The member written alone, as a name at its place.
unqualified := (member: Member, place: Place) ->
  alone := Identifier(name: member.name.name, position: member.position)
  Annotation
    member
    key: annotation_key('member', member.position)
    remove: -> place(alone)
    restore: -> place(member)

# The cast left out, as its value at its place.
uncast := (cast: Cast, place: Place) ->
  Annotation
    cast
    reported: { written: cast.value, rule: REDUNDANT_CASTS }
    key: annotation_key('cast', cast.type.position)
    remove: -> place(cast.value)
    restore: -> place(cast)

# A test that a value is empty, or that it is not, by its length or by comparing it with '': at the
# `length` or the '', which the `is_empty()` written for it takes, as the position of the test may
# be that of a `(` before the value, which would make it look written in parentheses.
struct EmptinessTest
  value: Expression
  negated: Bool
  at: Position

# `x.length == 0` and `0 == x.length`, `x.length != 0` and `x.length > 0`, and `s == ''`, `'' == s`
# and `s != ''`.
emptiness_test := (expression: Expression): EmptinessTest? ->
  if expression is UnaryOperation and expression.operator == 'not'
    # `not (xs.length != 0)` is `xs.is_empty()`, not `not not xs.is_empty()`.
    inner := emptiness_test(expression.operand) ? return nil
    return { value: inner.value, negated: not inner.negated, at: inner.at }
  test := expression as BinaryOperation ? return nil
  { operator, left, right } := test
  return measured(left, right, true) if operator == '>'
  return nil if operator != '==' and operator != '!='
  negated := operator == '!='
  either_way := (test: (Expression, Expression, Bool) -> EmptinessTest?) ->
    return found if found := test(left, right, negated)
    test right, left, negated
  return found if found := either_way(measured)
  either_way compared

measured := (length: Expression, zero: Expression, negated: Bool) ->
  return nil if zero is not IntegerLiteral or zero.value != 0
  member := length as Member ? return nil
  member.name.name == 'length' then EmptinessTest(
    negated
    value: member.object
    at: member.name.position
  )

compared := (value: Expression, empty: Expression, negated: Bool) ->
  empty is StringLiteral and empty.value.is_empty() then EmptinessTest(
    value
    negated
    at: empty.position
  )

# The test written as `is_empty()`, `not` before it if it is negated, at its place.
emptied := (expression: Expression, test: EmptinessTest, place: Place) ->
  { value, negated } := test
  position := test.at
  name := Identifier(position, name: 'is_empty')
  call := Call
    position
    callee: Member(name, position, object: value)
    args: []
    named_args: []
    type_args: []
  written: Expression =
    negated then UnaryOperation(position, operator: 'not', operand: call) else call
  Annotation
    emptied: value
    reported: { written, rule: EMPTINESS_TESTS }
    key: annotation_key('empty', expression.position)
    remove: -> place(written)
    restore: -> place(expression)

# `xs.contains(x)`, of operands that run no code, as `x in xs` evaluates `x` first: names, `@`,
# fields of them and literals.
is_membership_call := (call: Call) ->
  member := call.callee as Member ? return false
  is_one_argument := call.args.length == 1 and call.named_args.is_empty()
  return false if member.name.name != 'contains' or not is_one_argument
  return false if not call.type_args.is_empty()
  runs_no_code(member.object) and runs_no_code(call.args[0])

runs_no_code := (expression: Expression): Bool ->
  case expression
    # Not the name that `x?.contains(y)` gives the value of `x`, which is no name written.
    when Identifier then not expression.name.starts_with('?')
    when This, StringLiteral, IntegerLiteral, FloatLiteral, BooleanLiteral then true
    when Member then runs_no_code(expression.object)
    else false

# The call written as `x in xs`, at its place.
membership := (call: Call, place: Place) ->
  member := call.callee as Member!
  written := BinaryOperation
    operator: 'in'
    left: call.args[0]
    right: member.object
    position: call.args[0].position
  Annotation
    membership: call
    reported: { written, rule: MEMBERSHIP_TESTS }
    key: annotation_key('in', member.name.position)
    remove: -> place(written)
    restore: -> place(call)

# The runs of two or more arms next to each other whose bodies are written alike, which may be one
# arm of all their patterns (see Shared arm bodies); an arm of nil is in none, as nil must be the
# only pattern of its arm, and so is an arm of a case without a subject, whose arms have one
# condition each.
runs_of_alike_arms := (case_value: Case) ->
  runs: CaseArm[][]
  return runs if case_value.subject == nil
  arms := case_value.arms
  bodies := [is_nil_arm(arm) then '' else dump_ast_without_positions(arm.body) for arm in arms]
  var start = 0
  while start < arms.length
    var end = start + 1
    while end < arms.length and not bodies[start].is_empty() and bodies[end] == bodies[start]
      end += 1
    runs.push arms.slice(start, end) if end - start > 1
    start = end
  runs

is_nil_arm := (arm: CaseArm) -> arm.patterns.any((pattern) -> pattern is NilLiteral)

# The run of arms written as its first arm with the patterns of all of them, in their order,
# reported at the first pattern that the others give it. The arms are replaced by their identity,
# so that the runs of one case are written so apart.
shared_arms := (case_value: Case, run: CaseArm[]) ->
  first := run[0]
  patterns: Expression[]
  patterns.append arm.patterns for arm in run
  arm := CaseArm(first..., patterns)
  others := [each for each in run when each != first]
  Annotation
    shared_arms: run
    shared_subject: case_value.subject as Identifier?
    reported: { written: patterns[first.patterns.length], rule: SHARED_ARM_BODIES }
    key: annotation_key('arms', first.patterns[0].position)
    remove: ->
      kept := [each for each in case_value.arms when each not in others]
      case_value.arms = [each == first then arm else each for each in kept]
    restore: ->
      restored: CaseArm[]
      restored.append each == arm then run else [each] for each in case_value.arms
      case_value.arms = restored

# Whether the named argument is a variable of its name that may be written alone, which comes before
# the named arguments (see Construction in docs/reference/objects.md): those it then goes before
# give values that it cannot change.
is_shorthand := (call: Call, i: Int) ->
  named := call.named_args[i]
  variable := variable_of(named.value) ? return false
  names_itself := variable.name == named.name.name
  names_itself and call.named_args.take(i).all((other) -> has_no_effects(other.value))

# The variable that the value is, or that a cast which throws casts, which the shorthand leaves out
# with it if the checking shows that it may be (see Redundant casts), so that one run of `lerta fmt`
# writes both.
variable_of := (value: Expression) ->
  case value
    when Identifier then value
    when Cast then value.throws then value.value as Identifier?
    else nil

# A name, a literal or a member of one, whose evaluation changes nothing that a value evaluated
# after it reads. A member of an enum written with its enum is one, as it is once written alone.
has_no_effects := (value: Expression): Bool ->
  value is Member then has_no_effects(value.object) else value is Inert

type Inert =
  Identifier | This | NilLiteral | BooleanLiteral | StringLiteral | IntegerLiteral | FloatLiteral

# The value whose fields of the same names the named arguments of a construction copy, `y: p.y`,
# which a spread of it may give (see Spreads): a name, `@` or a path of fields from one, which
# the spread reads before the arguments written, so those before a copy must have no effects.
copied_source := (call: Call) ->
  return nil if call.args.any(is_spread)
  copies := [named for named in call.named_args when copied_field(named) != nil]
  first := copies.first() ? return nil
  source := copied_field(first)!.object
  is_path := source is Identifier or source is This or source is Member
  return nil if not is_path or not has_no_effects(source)
  key := dump_ast_without_positions([source])
  if not copies.all((named) -> dump_ast_without_positions([copied_field(named)!.object]) == key)
    return nil
  last_copy := call.named_args.index_of(copies.last()!)!
  before := [named for named, i in call.named_args when i < last_copy and named not in copies]
  before.all((named) -> has_no_effects(named.value)) then source

# The field that the named argument copies: of its own name.
copied_field := (named: NamedValue) ->
  member := named.value as Member ? return nil
  member.name.name == named.name.name then member

# The construction with a spread of the value whose fields it copies, first, and the arguments
# that it does not copy, reported at the spread.
spread_copy := (call: Call, source: Expression) ->
  { args, named_args } := call
  spread := spread_of_value(source)
  kept := [named for named in named_args when copied_field(named) == nil]
  Annotation
    spread_copy: call
    spread_source: source
    reported: { written: spread, rule: SPREADS }
    key: annotation_key('spread', call.position)
    remove: ->
      call.args = [spread, call.args...]
      call.named_args = kept
    restore: ->
      call.args = args
      call.named_args = named_args

# The named argument written as the name alone, after the arguments written so. The arguments of
# the call are replaced rather than changed, and put back as they were: the places of the others
# in them (see visit_named_at in ./places) change those that are put back.
shorthand := (call: Call, named: NamedValue) ->
  { args, named_args } := call
  alone := Identifier(named.name...)
  Annotation
    shorthand: call
    shorthand_cast: named.value as Cast?
    key: annotation_key('shorthand', named.name.position)
    # By its name, as leaving out its cast puts another argument in its place.
    remove: ->
      call.named_args = [each for each in call.named_args when each.name.name != alone.name]
      call.args = [call.args..., alone]
    restore: ->
      call.args = args
      call.named_args = named_args

# The construction written as a record of its arguments as they are then: those inside it, which
# come before it (see rewrites_of), are written so by then, in their places among them.
recorded := (call: Call, place: Place) -> Annotation(
  construction: call
  key: annotation_key('record', call.position)
  remove: ->
    fields := construction_arguments(call)
    place RecordLiteral(fields, position: call.position, spread: construction_spread(call))
  restore: -> place(call)
)
