# The rewrites that change the tokens of the source, not its layout, each found as an edit of the
# source by the rule that asks for it (see docs/reference/style.md); those that need the types of
# the checking, where the program checks, by typed.lerta.
import
  ArrayLiteral, ArrayTypeName, Assignment, BinaryOperation, Binding, Call, Coalesce, Comprehension,
  Condition, Conditional, Declaration, Expression, For, FunctionLiteral, Identifier, If, Index,
  Interpolation, Member, MemberDeclaration, NamedType, NilLiteral, Pass, RecordLiteral, Statement,
  StringLiteral, TypeDeclaration, UnaryOperation, UnionTypeName
from '../ast'
import TextPart from '../lexer/string_literal'
import Lexed, Token, TokenKind from '../lexer/tokens'
import bool_type from '../types'
import Place, places_of from './places'
import cast_of from './precedence'
import
  BINARY_LITERALS, CAST_FALLBACKS, ELSE_NIL, EMPTY_INITIAL_VALUES, ESCAPES,
  FUNCTIONS_WITHOUT_PARAMETERS, LAYOUT, NIL_DEFAULTS, NIL_INITIAL_VALUES, SEMICOLONS, SHORTHAND,
  STRING_LITERALS, TWO_WAY_VALUES
from './rules'
import with_ascii_escapes from './escapes'
import condition_edit, double_negation, negated_test from './conditions'
import Change, Edit from './edits'
import is_inline, is_pass_body from './forms'
import KeptLines from './kept'
import WIDTH from './lines'
import parentheses_of, unvisited_parts from './parentheses'
import is_layout, SourceTokens from './text'
import counted_range, index_ranges from './ranges'
import Tokens from './tokens'
import annotating_of, annotation_edits, annotation_statement_edits from './annotations'
import typed_edits, typed_statement_edits, Typed from './typed'
import union_test_edits from './union_tests'
import written_return, written_type_edits from './written_types'

export rewrites_of := (
  program: Statement[], source: String, text: SourceTokens, lexed: Lexed, kept: KeptLines,
  typed: Typed?
) ->
  tokens := Tokens(source, text, comments: lexed.comments, kept: kept_lines(program, text, kept))
  parentheses := parentheses_of(program, tokens)
  found: Edit[]
  add := (edit: Edit?) -> found.push(edit) if edit
  # The negations that the rewrite of a condition takes, which no other rewrites.
  claimed: Set<UnaryOperation>
  # The junctions inside a chain of them, whose tests the rewrite of the chain takes.
  junctions: Set<BinaryOperation>
  with_else: Set<Condition>
  places_of program, {
    before: (value, _) ->
      with_else.add value.condition if value is If and not value.else_body.is_empty()
    condition: (condition, _) ->
      add condition_edit(tokens, condition, condition not in with_else, claimed)
  }
  annotated := annotating_of(program, typed)
  places_of program, {
    before: (value, _: Place) ->
      add edit for edit in edits_within(tokens, value, claimed, junctions, parentheses.tight, typed)
      if annotating := annotated
        add edit for edit in annotation_edits(tokens, value, annotating)
        add written_return(tokens, value, annotating) if value is FunctionLiteral
    statement: (statement, _) ->
      add edit for edit in statement_edits(tokens, statement)
      if known := typed
        add edit for edit in typed_statement_edits(tokens, statement, known)
      if annotating := annotated
        add edit for edit in annotation_statement_edits(tokens, statement, annotating)
        add edit for edit in written_type_edits(tokens, statement, annotating)
  }
  add edit for edit in parentheses.edits
  add literal_edit(tokens, index) for index in 0..text.code.length
  add semicolon_edit(tokens, lexed, index) for index in 0..lexed.tokens.length
  found

# The lines of the statements on lines of their own that the comments mark to keep as they are
# written, each asked about after those inside it (see KeptLines).
kept_lines := (program: Statement[], text: SourceTokens, kept: KeptLines) ->
  places_of program, { statement: (statement, next) ->
    start := text.statement_start(statement) ? return
    kept.keeps text.code[start].position(), next then text.first_position(next)
  }
  kept.kept

# Those of the expression, and of its parts that are no places (see Visit), which places_of visits
# the places inside of.
edits_within := (
  tokens: Tokens, value: Expression, claimed: Set<UnaryOperation>, junctions: Set<BinaryOperation>,
  tight: Set<Expression>, typed: Typed?
): Edit?[] ->
  found := expression_edits(tokens, value, claimed, junctions, tight, typed)
  found.append typed_edits(tokens, value, known) if known := typed
  for part in unvisited_parts(value)
    found.push edit for edit in edits_within(tokens, part, claimed, junctions, tight, typed)
  found

expression_edits := (
  tokens: Tokens, value: Expression, claimed: Set<UnaryOperation>, junctions: Set<BinaryOperation>,
  tight: Set<Expression>, typed: Typed?
): Edit?[] ->
  case value
    when BinaryOperation then union_test_edits(tokens, value, junctions)
    when Member then [binary_literal(tokens, value)]
    when Coalesce then [cast_fallback(tokens, value, tight)]
    when Conditional then [else_nil(tokens, value)]
    when FunctionLiteral then [without_parameters(tokens, value)]
    when UnaryOperation
      value in claimed then [] else [negation_edit(tokens, value, claimed, typed)]
    when RecordLiteral then [shorthand(tokens, field.name, field.value) for field in value.fields]
    when Comprehension then [counted_range(tokens, value.iterable)]
    when Index then index_ranges(tokens, value)
    else []

# A double negation of a Bool taken out, whose inner negation it claims, so that a third goes with a
# fourth; otherwise `x is not T` or `x not in xs` for `not` of the test. `not not x` of another
# type, as an optional, is a Bool, which `x` is not; that of a program that does not check waits.
negation_edit := (
  tokens: Tokens, negation: UnaryOperation, claimed: Set<UnaryOperation>, typed: Typed?
) ->
  inner := negation.operand as UnaryOperation ? return negated_test(tokens, negation)
  return negated_test(tokens, negation) if typed?.facts.types[inner.operand] != bool_type
  edit := double_negation(tokens, negation) ? return negated_test(tokens, negation)
  claimed.add inner
  edit

# A field keeps its value (see Empty initial values), as a member of a class or a struct is no
# Declaration.
statement_edits := (tokens: Tokens, statement: Statement): Edit?[] ->
  case statement
    when Declaration
      [
        nil_initial_value(tokens, statement)
        empty_initial_value(tokens, statement)
        two_way_value(tokens, statement.value)
      ]
    when Assignment then [two_way_value(tokens, statement.value)]
    when TypeDeclaration
      [unneeded_pass(tokens, statement), [nil_default(tokens, m) for m in statement.members]...]
    when For then [counted_range(tokens, statement.iterable)]
    else []

# The head alone of a type that satisfies an interface for one whose body is `pass` alone, as such a
# type may leave out the body (see pass in docs/reference/syntax.md).
unneeded_pass := (tokens: Tokens, node: TypeDeclaration) ->
  return nil if node.satisfies == nil or not node.members.is_empty()
  head := tokens.at(node.position) ? return nil
  last := tokens.line_end(head) ? return nil
  pass_at := last + 1
  return nil unless is_pass_body(tokens.code, head, pass_at)
  # A comment between them would go with `pass`, which then stays; one after `pass` moves to the
  # head's line.
  (first, line) := (tokens.code[last].line, tokens.code[pass_at].line)
  return nil if tokens.comments.any((comment) -> comment.line in first..line)
  change := Change(from: tokens.end(last), to: tokens.end(pass_at), text: '')
  tokens.edit_at LAYOUT, tokens.start(pass_at), [change]

# A report of an `if` that gives a value, of two branches of one expression each, that would fit on
# its line as `c then a else b`, with its head (see Branches), where each part is on a line of its
# own without a comment.
two_way_value := (tokens: Tokens, value: Expression) ->
  branch := value as If ? return nil
  { then_body, else_body } := branch
  # A condition that binds a name is no operand.
  return nil if branch.nil_safe or branch.condition is Binding
  return nil if then_body.length != 1 or else_body.length != 1
  return nil if not then_body.all(is_value) or not else_body.all(is_value)
  if_at := tokens.at(branch.position) ? return nil
  then_at := tokens.at(then_body[0].position) ? return nil
  else_at := tokens.at(else_body[0].position) ? return nil
  return nil unless tokens.is_kind(else_at - 1, 'else')
  first_line := tokens.code[if_at].line
  last_line := tokens.code[else_at].end_line
  return nil if tokens.comments.any((comment) -> comment.line in first_line..=last_line)
  # Each part ends its line, as the next part, `else`, or a line no deeper than `else` follows.
  condition_end := tokens.line_end(if_at + 1) ? return nil
  then_end := tokens.line_end(then_at) ? return nil
  else_end := tokens.line_end(else_at) ? return nil
  after := else_end + 1
  ends_block :=
    after == tokens.code.length or tokens.code[after].column <= tokens.code[else_at - 1].column
  return nil if condition_end + 1 != then_at or then_end + 2 != else_at or not ends_block
  part := (first: Int, last: Int) -> tokens.slice(tokens.start(first), tokens.end(last))
  condition := part(if_at + 1, condition_end)
  written := "#{condition} then #{part(then_at, then_end)} else #{part(else_at, else_end)}"
  parentheses := added_parentheses(tokens, then_body[0]) + added_parentheses(tokens, else_body[0])
  # After the head, `x :=` and a space.
  return nil if tokens.end(if_at - 1).column + written.count() + parentheses > WIDTH
  tokens.report TWO_WAY_VALUES, tokens.start(if_at)

# The column that a call without parentheses takes for them as a part of an operation: one, as its
# `(` takes the place of the space after its callee.
added_parentheses := (tokens: Tokens, statement: Statement) ->
  call := statement as Call ? return 0
  first := call.args.first()?.position ? call.named_args.first()?.name.position ? return 0
  at := tokens.at(first) ? return 0
  tokens.is_kind(at - 1, '(') then 0 else 1

# A statement that is one expression, which a two-way value can hold.
is_value := (statement: Statement) ->
  is_inline(statement) and statement is not Assignment and statement is not Pass

# `'...'` for `"..."`, and `b'...'` for `b"..."`, where they write the same (see String literals);
# otherwise the escapes of ASCII characters as Escapes writes them.
literal_edit := (tokens: Tokens, index: Int) ->
  token := tokens.code[index]
  written := tokens.spelling(index)
  if value := single_quoted_text(token, written)
    if fits_single_quotes(written, value)
      quoted := token.kind == BINARY then "b'#{value}'" else "'#{value}'"
      return tokens.edit(STRING_LITERALS, [tokens.replaced(index, quoted)])
  return nil if not written.starts_with('"') and not written.starts_with('b"')
  escaped := with_ascii_escapes(written)
  escaped != written then tokens.edit(ESCAPES, [tokens.replaced(index, escaped)])

# The text of a literal written `"..."` or `b"..."` on one line, which interpolates nothing.
single_quoted_text := (token: Token, written: String) ->
  return nil if token.end_line > token.line
  case token.kind
    when STRING then written.starts_with('"') then token.text
    when BINARY
      return nil unless written.starts_with('b"')
      parts := token.parts ? return nil
      return '' if parts.is_empty()
      part := parts[0] as TextPart ? return nil
      parts.length == 1 then part.bytes.text()
    else nil

# `b'...'` for the bytes of a string literal, `'...'.binary` (see Binary literals), on one line.
binary_literal := (tokens: Tokens, member: Member) ->
  return nil if member.name.name != 'binary'
  { object } := member
  is_string := object is StringLiteral or (object is Interpolation and not object.binary)
  return nil unless is_string
  start := tokens.at(object.position) ? return nil
  var literal = start
  literal += 1 while tokens.is_kind(literal, '(')
  return nil if tokens.code[literal].end_line > tokens.code[literal].line
  name := tokens.at(member.name.position) ? return nil
  change :=
    Change(from: tokens.start(start), to: tokens.end(name), text: 'b' + tokens.spelling(literal))
  tokens.edit BINARY_LITERALS, [change]

# `x as T ? y` for `(x as T?) ? y` (see Cast fallbacks): the parentheses and the `?` inside them
# left out; but not where the place of the fallback, written without parentheses, binds more tightly
# than a comparison, as `x as T ? y` binds as one: `(x as T?) ? y as U` is `((x as T?) ? y) as U`.
cast_fallback := (tokens: Tokens, coalesce: Coalesce, tight: Set<Expression>) ->
  cast := cast_of(coalesce) ? return nil
  return nil if coalesce in tight and coalesce.position == cast.position
  open := tokens.at(cast.position) ? return nil
  return nil unless tokens.is_kind(open, '(')
  close := tokens.matching(open) ? return nil
  type := tokens.at(cast.type.position) ? return nil
  # Parentheses around the cast alone, not around what it casts, on one line.
  around := close > type and tokens.is_kind(close - 1, '?')
  return nil if not around or tokens.code[open].line != tokens.code[close].line
  question := Change(from: tokens.start(close - 1), to: tokens.end(close), text: '')
  tokens.edit CAST_FALLBACKS, [tokens.removed(open), question]

# `c then x` for `c then x else nil` (see Else nil).
else_nil := (tokens: Tokens, conditional: Conditional) ->
  return nil if conditional.without_else or conditional.else_value is not NilLiteral
  value := tokens.at(conditional.else_value.position) ? return nil
  word := value - 1
  return nil unless tokens.is_kind(word, 'else')
  last := tokens.is_kind(value, '(') then (tokens.matching(value) ? return nil) else value
  tokens.edit ELSE_NIL, [{ from: tokens.end(word - 1), to: tokens.end(last), text: '' }]

# `var x: T?` for `var x: T? = nil` (see Nil initial values), where `?` makes the type optional:
# one that an alias or a union makes optional keeps its value.
nil_initial_value := (tokens: Tokens, declaration: Declaration) ->
  { mutable, type, value } := declaration
  written := type ? return nil
  optional := written is not UnionTypeName and written.optional
  return nil if not mutable or not optional or value is not NilLiteral or declaration.omits_value
  nil_at := tokens.at(value.position) ? return nil
  return nil if not tokens.is_kind(nil_at, 'nil') or not tokens.is_kind(nil_at - 1, '=')
  change := Change(from: tokens.end(nil_at - 2), to: tokens.end(nil_at), text: '')
  tokens.edit NIL_INITIAL_VALUES, [change]

# `x: T?` for `x: T? = default nil` of a field (see Nil initial values), which takes nil where
# its argument is left out; but not where the `?` is not written on the type itself, as `A | B?`
# or an alias of an optional type: the formatter cannot tell it optional.
nil_default := (tokens: Tokens, member: MemberDeclaration) ->
  { type, value, has_default } := member
  written := type ? return nil
  return nil if not written.optional or not has_default or value is not NilLiteral
  nil_at := tokens.at(value.position) ? return nil
  is_written := tokens.is_kind(nil_at, 'nil') and tokens.is_word(nil_at - 1, 'default')
  return nil if not is_written or not tokens.is_kind(nil_at - 2, '=')
  change := Change(from: tokens.end(nil_at - 3), to: tokens.end(nil_at), text: '')
  tokens.edit NIL_DEFAULTS, [change]

# `xs: T[]` for `xs: T[] = []`, and `m: Map<K, V>` for `m: Map<K, V> = Map()` or `m := Map<K, V>()`
# of a const, or `var m = Map<K, V>()` of a `var`, and so for a Set (see Empty initial values).
empty_initial_value := (tokens: Tokens, declaration: Declaration) ->
  return nil if declaration.weak
  { type, value } := declaration
  start := tokens.at(value.position) ? return nil
  name := tokens.at(declaration.name.position) ? return nil
  case value
    when ArrayLiteral
      array := type as ArrayTypeName ? return nil
      return nil if array.optional or not value.elements.is_empty()
      return nil if not tokens.is_kind(start, '[') or not tokens.is_kind(start + 1, ']')
      left_out tokens, start - 1, start + 1
    when Call
      return nil unless is_empty_collection(value)
      close := empty_arguments_end(tokens, start) ? return nil
      if written := type
        named := written as NamedType ? return nil
        assign := start - 1
        type_at := tokens.at(named.position) ? return nil
        # A value of another type would not be the same.
        value_type := tokens.joined(start, close - 2)
        same_type := value.type_args.is_empty() or value_type == tokens.joined(type_at, assign - 1)
        same_kind := named.name == (value.callee as Identifier!).name and not named.optional
        return nil if not same_kind or not same_type or not tokens.is_kind(assign, '=')
        left_out tokens, assign, close
      else
        assign: TokenKind = declaration.mutable then '=' else ':='
        return nil if value.type_args.is_empty() or not tokens.is_kind(start - 1, assign)
        typed := ': ' + tokens.slice(tokens.start(start), tokens.end(close - 2))
        change := Change(from: tokens.end(name), to: tokens.end(close), text: typed)
        tokens.edit EMPTY_INITIAL_VALUES, [change]
    else nil

# The value of a declaration left out, from its `=` at `assign` up to `last`.
left_out := (tokens: Tokens, assign: Int, last: Int) ->
  change := Change(from: tokens.end(assign - 1), to: tokens.end(last), text: '')
  tokens.edit EMPTY_INITIAL_VALUES, [change]

is_empty_collection := (call: Call) ->
  callee := call.callee as Identifier ? return false
  is_collection := callee.name == 'Map' or callee.name == 'Set'
  is_collection and call.args.is_empty() and call.named_args.is_empty()

# The `)` of `Map<K, V>()` or `Map()` from its callee at `callee`: of the first `()` after the
# callee or a `>`.
empty_arguments_end := (tokens: Tokens, callee: Int) ->
  var at = callee + 1
  while at + 1 < tokens.code.length
    after_type := at == callee + 1 or tokens.is_kind(at - 1, '>')
    return at + 1 if after_type and tokens.is_kind(at, '(') and tokens.is_kind(at + 1, ')')
    return nil if tokens.is_kind(at, '(')
    at += 1
  nil

# `-> body` for `() -> body` (see Functions without parameters).
without_parameters := (tokens: Tokens, function: FunctionLiteral) ->
  has_signature := not function.params.is_empty() or function.return_type != nil
  return nil if has_signature or not function.type_params.is_empty()
  var at = tokens.at(function.position) ? return nil
  # The parentheses that the literal is written in come before its `weak` and its own.
  at += 1 while tokens.is_kind(at, '(') and not tokens.is_kind(at + 1, ')')
  at += 1 if tokens.is_word(at, 'weak')
  is_empty := tokens.is_kind(at, '(') and tokens.is_kind(at + 1, ')')
  return nil if not is_empty or not tokens.is_kind(at + 2, '->')
  change := Change(from: tokens.start(at), to: tokens.start(at + 2), text: '')
  tokens.edit FUNCTIONS_WITHOUT_PARAMETERS, [change]

# `{ x }` for `{ x: x }` (see Shorthand).
shorthand := (tokens: Tokens, name: Identifier, value: Expression) ->
  return nil if value is not Identifier or value.name != name.name
  name_at := tokens.at(name.position) ? return nil
  value_at := tokens.at(value.position) ? return nil
  return nil if value_at == name_at or not tokens.is_kind(value_at, IDENTIFIER)
  change := Change(from: tokens.start(name_at), to: tokens.end(value_at), text: name.name)
  tokens.edit SHORTHAND, [change]

# A line of its own for the statement after a `;` (see Semicolons), as deep as the line that the
# statement before it starts.
semicolon_edit := (tokens: Tokens, lexed: Lexed, index: Int) ->
  all := lexed.tokens
  separator := all[index]
  return nil if separator.kind != NEWLINE or separator.text != ';'
  var start = index - 1
  start -= 1 while start > 0 and not ends_line(all[start - 1])
  indentation := ' '.repeat(all[start].column - 1)
  before := all[index - 1]
  after := all[index + 1]
  change := Change
    from: { line: before.end_line, column: before.end_column }
    to: after.position()
    text: "\n" + indentation
  tokens.edit SEMICOLONS, [change]

ends_line := (token: Token) -> is_layout(token) and token.text != ';'

# Whether the literal with escapes, as written, can be written with `'...'` instead: where its text
# holds no `'` and no control character, and no `\u{...}` or `\xHH` escape writes a character that
# would not be seen, or told apart, as it is, once Escapes writes the others as the characters.
fits_single_quotes := (written: String, value: String) ->
  escaped := with_ascii_escapes(written)
  keeps_escapes := '\u{' in escaped or '\x' in escaped
  plain := value.binary.all((byte) -> byte != b"'" and byte >= 0x20 and byte != 0x7F)
  plain and not keeps_escapes
