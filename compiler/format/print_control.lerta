# `if`, `while` and `for` in their block and postfix forms (see Postfix forms), with their
# conditions (see Negated conditions).
import
  Assignment, Await, BinaryOperation, Binding, Call, Case, Coalesce, Condition, Conditional,
  Declaration, EnumDeclaration, Expression, Extend, Extern, For, FunctionLiteral, If, Import,
  InterfaceDeclaration, Position, Range, Return, Statement, Throw, Try, TypeAlias, TypeDeclaration,
  UnaryOperation, While, Yield
from '../ast'
import choice, Doc, indent, join, line_feed, rule, text, token from './doc'
import BRANCHES, NEGATED_CONDITIONS, POSTFIX_FORMS from './rules'
import negated_head from './negated_conditions'
import expression_doc, loop_header from './print_expression'
import block_doc, statement_doc from './print_statement'
import Context, keyword, word_before from './printing'

# An `if` that is a statement, in its postfix form where it has one (see Postfix forms), or the `if`
# of `x?.rest`.
export if_statement_doc := (statement: If, context: Context) ->
  return expression_doc(statement, context) if statement.nil_safe
  body := statement_if_postfix(statement, context) ? return if_doc(statement, context)
  head := head_doc('if', statement.condition, true, text, context)
  postfix := join([statement_doc(body, context), text(' '), head])
  rule POSTFIX_FORMS, choice(postfix, if_doc(statement, context))

# A statement that an arm or a function literal can hold on its line.
export is_inline := (statement: Statement, context: Context) ->
  is_simple_statement(statement) or
    (not context.in_brackets and has_postfix_form(statement, context))

# A statement that holds no block and has no postfix form.
is_simple_statement := (statement: Statement) ->
  case statement
    when
      Declaration, While, For, TypeDeclaration, EnumDeclaration, InterfaceDeclaration, TypeAlias,
      Extern, Extend, Import, Case, Try
    then false
    when If then statement.nil_safe
    else true

# An `if`, a `while` or a `for` that can be written in its postfix form, which a line holds.
has_postfix_form := (statement: Statement, context: Context) ->
  case statement
    when If then not statement.nil_safe and statement_if_postfix(statement, context) != nil
    when While then while_postfix(statement, context) != nil
    when For then for_postfix(statement, context) != nil
    else false

condition_doc := (condition: Condition, context: Context) ->
  case condition
    when Binding
      name := token(condition.name.name, condition.name.position)
      join [name, text(' := '), expression_doc(condition.value, context)]
    else expression_doc(condition, context)

# The word and the condition of an `if` or a `while`, the word as `spelled` makes it: `unless` or
# `until` for a `not` where the statement takes it, `negatable` (see Negated conditions). The rule
# covers a word that the source may have written otherwise: before a `not`, or before a condition
# without its double negation, which `unless` or `until` may have had in the source.
head_doc := (
  word: String, condition: Condition, negatable: Bool, spelled: (String) -> Doc, context: Context
) ->
  if negated := negated_head(word, condition, negatable)
    written := join([spelled("#{negated.word} "), expression_doc(negated.operand, context)])
    return rule(NEGATED_CONDITIONS, written)
  written := join([spelled("#{word} "), condition_doc(condition, context)])
  return written if condition is Binding
  negated_in_source := is_not(condition) or condition in context.reported
  negated_in_source then rule(NEGATED_CONDITIONS, written) else written

is_not := (expression: Expression) -> expression is UnaryOperation and expression.operator == 'not'

# `if` and its block, and `else if` or `else` and its block (see Branches); `unless` for an `if`
# without `else` that is not one of `else if`, `chained`.
export if_doc := (if_node: If, context: Context, chained = false): Doc ->
  negatable := if_node.else_body.is_empty() and not chained
  spelled := (word: String) -> keyword(word, if_node.position)
  head := head_doc('if', if_node.condition, negatable, spelled, context.unbroken())
  parts := [head, block_below(if_node.then_body, context)]
  else_body := if_node.else_body
  if is_else_if(else_body, context)
    word := word_before(else_body[0].position, 'else', context)
    else_if := join([line_feed(), word, text(' '), if_doc(else_body[0] as If!, context, true)])
    parts.push rule(BRANCHES, else_if)
  else if not else_body.is_empty()
    word := word_before(else_body[0].position, 'else', context)
    parts.push join([line_feed(), word, block_below(else_body, context)])
  join parts

# Whether an `else` is written `else if`: not when a comment comes before its `if`, which `else if`
# would move above it.
is_else_if := (else_body: Statement[], context: Context) ->
  return false if else_body.length != 1 or else_body[0] is not If
  not (else_body[0] as If!).nil_safe and not context.source.comment_before(else_body[0].position)

block_below := (body: Statement[], context: Context) ->
  indent join([line_feed(), block_doc(body, context)])

# `statement if c`, for an `if` without `else` whose block holds one statement that can have it.
statement_if_postfix := (if_node: If, context: Context) ->
  return nil if not if_node.else_body.is_empty() or if_node.then_body.length != 1
  return nil if context.source.block_has_comments(if_node.position)
  statement := if_node.then_body[0]
  takes_postfix(statement) then statement

# A statement that a postfix `if`, `while` or `for` can follow: one that no block, no postfix form
# of its own and nothing that would take the postfix condition, as a function literal at its end,
# is part of.
takes_postfix := (statement: Statement) ->
  is_simple_statement(statement) and not ends_open(statement)

ends_open := (statement: Statement): Bool ->
  case statement
    when Assignment then ends_open(statement.value)
    when Return
      if value := statement.value
        ends_open value
      else
        false
    when Throw then ends_open(statement.message)
    when Yield then ends_open(statement.value)
    when Await then ends_open(statement.operand)
    when BinaryOperation then ends_open(statement.right)
    when UnaryOperation then ends_open(statement.operand)
    when Coalesce then ends_open(statement.fallback)
    when Conditional then ends_open(statement.else_value)
    when Range then ends_open(statement.end)
    when Call
      args := statement.args
      not args.is_empty() and ends_open(args.last()!)
    when FunctionLiteral, Case, Try then true
    when If then not statement.nil_safe
    else false

export while_doc := (while_node: While, context: Context) ->
  { condition, position } := while_node
  spelled := (word: String) -> keyword(word, position)
  head := head_doc('while', condition, true, spelled, context.unbroken())
  block := join([head, block_below(while_node.body, context)])
  body := while_postfix(while_node, context) ? return block
  postfix := join
    [statement_doc(body, context), text(' '), head_doc('while', condition, true, text, context)]
  rule POSTFIX_FORMS, choice(postfix, block)

# The one statement of the `while`'s block, if it can be written in its postfix form.
while_postfix := (while_node: While, context: Context) ->
  postfix_statement while_node.body, while_node.position, context

# The one statement of a loop's block, if the loop can be written in its postfix form: the statement
# takes it, and the block of the loop at the position has no comments.
postfix_statement := (body: Statement[], at: Position, context: Context) ->
  has_comments := context.source.block_has_comments(at)
  body.length == 1 and takes_postfix(body[0]) and not has_comments then body[0]

# A `for`, whose block starts with the declarations that take its item apart, as the parser makes
# them for `for (a, b) in xs`.
export for_doc := (for_node: For, context: Context) ->
  body := loop_body(for_node)
  header := loop_header(for_node.variable, for_node.index, for_node.iterable, context.unbroken())
  block := join([header, block_below(body, context)])
  only := for_postfix(for_node, context) ? return block
  postfix := join([statement_doc(only, context), text(' '), header])
  rule POSTFIX_FORMS, choice(postfix, block)

# The one statement of the `for`'s block, if it can be written in its postfix form.
for_postfix := (for_node: For, context: Context) ->
  postfix_statement loop_body(for_node), for_node.position, context

loop_body := (for_node: For) ->
  [statement for statement in for_node.body when not is_loop_part(statement)]

is_loop_part := (statement: Statement) -> statement is Declaration and statement.of_loop
