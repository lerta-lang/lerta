# What the rewrites ask about expressions: which run no code, and the forms that a rewrite takes,
# found apart from where it is made.
import
  binary_literal_bytes, BinaryOperation, BooleanLiteral, Call, Case, CaseArm, Expression,
  FloatLiteral, Identifier, IntegerLiteral, is_spread, Member, NamedValue, NilLiteral, Position,
  StringLiteral, This
from '../ast'
import dump_ast_without_positions from '../dumps'

export runs_no_code := (expression: Expression): Bool ->
  case expression
    # Not the name that `x?.contains(y)` gives the value of `x`, which is no name written.
    when Identifier then not expression.name.starts_with('?')
    when This, StringLiteral, IntegerLiteral, FloatLiteral, BooleanLiteral then true
    when Member then runs_no_code(expression.object)
    else binary_literal_bytes(expression) != nil

# Two comparisons of one value joined by `and`, `x >= a and x <= b` or `a <= x and x < b`, which may
# end a chain of `and`s, as the tree of `p and x >= a and x <= b` is `(p and x >= a) and x <= b`; or
# joined by `or`, `x < a or x > b`, which test that it is outside, and so for a chain of `or`s.
export struct RangeComparison
  # The `and` of the `and`s before the comparisons and the first, if any, which keeps the `and`s
  # where a rewrite inside them places theirs.
  chain: BinaryOperation?
  lower: BinaryOperation
  value: Expression
  start: Expression
  end: Expression
  inclusive: Bool
  # The second comparison, which the rewrite is found by.
  at: Position

# Of a value that runs no code, written the same in both comparisons, and an end that runs none,
# which `and` evaluates only after the first comparison holds, and `or` only after it fails, as `in`
# does not.
export range_test := (expression: Expression): RangeComparison? ->
  test := expression as BinaryOperation ? return nil
  return nil unless test.operator in ['and', 'or']
  outside := test.operator == 'or'
  upper := test.right as BinaryOperation ? return nil
  chain := test.left as BinaryOperation ? return nil
  is_chain := chain.operator == test.operator
  lower := (is_chain then chain.right else chain) as BinaryOperation ? return nil
  value := lower_value(lower, outside) ? return nil
  return nil unless runs_no_code(value)
  # `x <= b` and `b >= x` test within `..=b`, `x > b` and `b < x` outside it; `x < b` and `x >= b`
  # likewise for `..b`.
  value_on_left := upper.operator in (outside then ['>', '>='] else ['<=', '<'])
  value_on_right := upper.operator in (outside then ['<', '<='] else ['>=', '>'])
  return nil if not value_on_left and not value_on_right
  inclusive := upper.operator in (outside then ['>', '<'] else ['<=', '>='])
  written_value := value_on_left then upper.left else upper.right
  end := value_on_left then upper.right else upper.left
  return nil if not runs_no_code(end) or not same(value, written_value)
  start := same(lower.left, value) then lower.right else lower.left
  { chain: is_chain then chain, lower, value, start, end, inclusive, at: upper.position }

# The value that `x >= a` or `a <= x` compares with its start, or `x < a` or `a > x` outside.
lower_value := (comparison: BinaryOperation, outside: Bool) ->
  { operator, left, right } := comparison
  return left if operator == (outside then '<' else '>=')
  operator == (outside then '>' else '<=') then right

same := (a: Expression, b: Expression) ->
  dump_ast_without_positions([a]) == dump_ast_without_positions([b])

# The `b` of an end `b + 1`.
export counted_end := (end: Expression?) ->
  sum := end as BinaryOperation ? return nil
  sum.operator == '+' and is_one(sum.right) then sum.left

is_one := (expression: Expression) -> expression is IntegerLiteral and expression.value == 1

# The runs of two or more arms next to each other whose bodies are written alike, which may be one
# arm of all their patterns (see Shared arm bodies); an arm of nil is in none, as nil must be the
# only pattern of its arm, and so is an arm of a case without a subject, whose arms have one
# condition each.
export runs_of_alike_arms := (case_value: Case) ->
  runs: CaseArm[][]
  return runs if case_value.subject == nil
  arms := case_value.arms
  bodies := [is_nil_arm(arm) then '' else dump_ast_without_positions(arm.body) for arm in arms]
  var start = 0
  while start < arms.length
    var end = start + 1
    while end < arms.length and not bodies[start].is_empty() and bodies[end] == bodies[start]
      end += 1
    runs.push arms[start..end] if end - start > 1
    start = end
  runs

is_nil_arm := (arm: CaseArm) -> arm.patterns.any((pattern) -> pattern is NilLiteral)

# The value whose fields of the same names the named arguments of a construction copy, `y: p.y`,
# which a spread of it may give (see Spreads): a name, `@` or a path of fields from one, which
# the spread reads before the arguments written, so those before a copy must have no effects.
export copied_source := (call: Call) ->
  return nil if call.args.any(is_spread)
  copies := [named for named in call.named_args when copied_field(named) != nil]
  first := copies.first() ? return nil
  source := copied_field(first)!.object
  is_path := source is Identifier | This | Member
  return nil if not is_path or not has_no_effects(source)
  key := dump_ast_without_positions([source])
  unless copies.all((named) -> dump_ast_without_positions([copied_field(named)!.object]) == key)
    return nil
  last_copy := call.named_args.index_of(copies.last()!)!
  before := [named for named at i in call.named_args when i < last_copy and named not in copies]
  before.all((named) -> has_no_effects(named.value)) then source

# The field that the named argument copies: of its own name.
copied_field := (named: NamedValue) ->
  member := named.value as Member ? return nil
  member.name.name == named.name.name then member

# A name, a literal or a member of one, whose evaluation changes nothing that a value evaluated
# after it reads. A member of an enum written with its enum is one, as it is once written alone.
has_no_effects := (value: Expression): Bool ->
  value is Member then has_no_effects(value.object) else value is Inert

type Inert =
  Identifier | This | NilLiteral | BooleanLiteral | StringLiteral | IntegerLiteral | FloatLiteral
