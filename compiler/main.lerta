# The command line of the compiler. So far it only prints tokens or syntax trees, as stage0's
# `dump-tokens` and `dump-ast` do.
import { read_file, stderr, stdout } from 'std:io'
import { argv, exit } from 'std:process'
import { dump_ast } from './ast_dump'
import { tokenize } from './lexer/tokens'
import { parse } from './parser/statement'
import { dump_tokens } from './token_dump'

const USAGE = "usage: lerta dump-tokens <source>\n       lerta dump-ast <source>\n"

const COMMANDS = ['dump-tokens', 'dump-ast']

const is_known_command = argv.length > 0 and COMMANDS.any((command) -> command == argv[0])
if argv.length != 2 or not is_known_command or argv[1].binary.occurs_at(0, '-'.binary)
  stderr.write(USAGE)
  exit(2)

const command = argv[0]
const path = argv[1]
const source = read_file(path).decode_utf8() ? throw "'#{path}' is not valid UTF-8"
const tokens = tokenize(source, path)
stdout.write(command == 'dump-tokens' then dump_tokens(tokens) else dump_ast(parse(tokens, path)))
