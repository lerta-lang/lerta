# The command line of the compiler. So far it only prints tokens, as stage0's `dump-tokens` does.
import { read_file, stderr, stdout } from 'std:io'
import { argv, exit } from 'std:process'
import { tokenize } from './syntax/lexer'
import { dump_tokens } from './token_dump'

const USAGE = "usage: lerta dump-tokens <source>\n"

if argv.length != 2 or argv[0] != 'dump-tokens' or argv[1].binary.occurs_at(0, '-'.binary)
  stderr.write(USAGE)
  exit(2)

const path = argv[1]
const source = read_file(path).decode_utf8() ? throw "'#{path}' is not valid UTF-8"
stdout.write(dump_tokens(tokenize(source, path)))
