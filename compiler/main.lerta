# The command line of the compiler (see docs/reference/compiler.md#commands).
import stdout from 'std:io'
import argv, exit from 'std:process'
import dump_ast from './ast_dump'
import build, build_and_run, BuildRequest from './build'
import dump_checked from './checked_dump'
import executable_suffix from './clang_flags'
import check_program, generate_ir from './compile'
import CompileError from './errors'
import format_command from './format/command'
import lsp_command from './lsp/server'
import tokenize from './lexer/tokens'
import parse from './parser/statement'
import basename from './paths'
import read_entry_source, SOURCE_EXTENSION from './source'
import dump_tokens from './token_dump'

const USAGE =
  "usage: lerta build <source> [<file>...] [-o <output>] [-O] [--memory-checks] [-Werror]\n"
  "                   [--no-trace] [--source-lines] [--target <triple>]\n"
  "       lerta run <source> [<file>...] [-O] [--memory-checks] [-Werror] [--no-trace]\n"
  "                 [--source-lines] [-- <arg>...]\n"
  "       lerta fmt [--fix] <path>...\n"
  "       lerta lsp\n"
  "       lerta dump-tokens <source>\n"
  "       lerta dump-ast <source>\n"
  "       lerta dump-checked <source>\n"
  '       lerta dump-llvm <source>'
.join('')

const is_value = (arg: String) -> not arg.starts_with('-')

const fail_usage = ->
  print_error USAGE
  exit 2

# Prints what `dump` makes of the source file.
const run_dump = (args: String[], dump: (String) -> Promise<String>) ->
  fail_usage() if args.length != 1 or not is_value(args[0])
  await stdout.write(await dump(args[0]))

# The files that clang links with the program, as it takes them.
const LINKED_EXTENSIONS = ['.c', '.o', '.ll', '.a', '.obj', '.lib']

const is_linked_file = (path: String) ->
  LINKED_EXTENSIONS.any (extension) -> path.ends_with(extension)

const parse_build_arguments = (args: String[]) ->
  var source: String?
  const linked_files: String[] = []
  var output: String?
  var target: String?
  var optimize = false
  var memory_checks = false
  var warnings_as_errors = false
  var traces = true
  var source_lines = false
  var program_args: String[]?
  var i = 0
  # The value is the next argument, even one that starts with `-`, as `-o -out` gives `-out`.
  const take_value = (previous: String?) ->
    i += 1
    fail_usage() if previous != nil or i >= args.length
    args[i]
  while i < args.length
    const arg = args[i]
    case arg
      when '-O'
        fail_usage() if optimize
        optimize = true
      when '--memory-checks'
        fail_usage() if memory_checks
        memory_checks = true
      when '-Werror'
        fail_usage() if warnings_as_errors
        warnings_as_errors = true
      when '--no-trace'
        fail_usage() if not traces
        traces = false
      when '--source-lines'
        fail_usage() if source_lines
        source_lines = true
      when '-o' then output = take_value(output)
      when '--target' then target = take_value(target)
      when '--'
        program_args = [args[rest] for rest in (i + 1)...args.length]
        break
      else
        fail_usage() if not is_value(arg)
        if source == nil
          source = arg
        else
          fail_usage() if not is_linked_file(arg)
          linked_files.push arg
    i += 1
  const given_source = source ? fail_usage()
  {
    source: given_source
    linked_files
    output
    target
    optimize
    memory_checks: memory_checks or not optimize
    warnings_as_errors
    traces
    source_lines
    program_args
  }

const build_command = (args: String[]) ->
  const parsed = parse_build_arguments(args)
  const { source, linked_files, output, target, optimize, memory_checks } = parsed
  const { warnings_as_errors, traces } = parsed
  fail_usage() if parsed.program_args != nil
  const executable = output ? default_output(source, target)
  const request = BuildRequest(
    source
    linked_files
    optimize
    memory_checks
    target
    warnings_as_errors
    traces
    output: executable
    source_lines: parsed.source_lines
  )
  build request

# The program is built in the temporary directory, for the host.
const run_command = (args: String[]) ->
  const parsed = parse_build_arguments(args)
  const { source, linked_files, output, target, optimize, memory_checks } = parsed
  const { warnings_as_errors, traces } = parsed
  fail_usage() if output != nil or target != nil
  const request = BuildRequest(
    source
    linked_files
    optimize
    memory_checks
    target
    output
    warnings_as_errors
    traces
    source_lines: parsed.source_lines
  )
  build_and_run request, parsed.program_args ? []

const default_output = (source: String, target: String?) ->
  const name = basename(source)
  const stem = name.without_suffix(SOURCE_EXTENSION) ? fail_usage()
  fail_usage() if stem == ''
  "#{stem}#{executable_suffix(target)}"

# `--fix` may come before the paths, of which there is at least one.
const fmt_command = (args: String[]) ->
  const fix = args.length > 0 and args[0] == '--fix'
  const paths = [arg for arg, i in args when i > 0 or not fix]
  fail_usage() if paths.length == 0 or paths.any((path) -> not is_value(path))
  exit await format_command(paths, fix)

# The dumps of one module read no module that it imports.
const dump_file_tokens = (path: String) ->
  dump_tokens tokenize(await read_entry_source(path), path)

const dump_file_ast = (path: String) ->
  dump_ast parse(tokenize(await read_entry_source(path), path), path)

const dump_program_checked = (path: String) -> dump_checked(await check_program(path, false))

const command = argv.first() ? ''
const args = [argv[i] for i in 1...argv.length]
# A compile error is the user's, so it is reported without the compiler's trace.
try
  case command
    when 'build' then await build_command(args)
    when 'run' then await run_command(args)
    when 'fmt' then await fmt_command(args)
    when 'lsp' then await lsp_command(args)
    when 'dump-tokens' then await run_dump(args, dump_file_tokens)
    when 'dump-ast' then await run_dump(args, dump_file_ast)
    when 'dump-checked' then await run_dump(args, dump_program_checked)
    when 'dump-llvm' then await run_dump(args, (path) -> generate_ir(path, false))
    else fail_usage()
catch error: CompileError
  print_error error.message
  exit 1
