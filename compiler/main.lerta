# The command line of the compiler: `build`, and `dump-tokens`, `dump-ast` and `dump-checked`,
# which print what the lexer, the parser and the checker make of the source, for debugging.
import { stderr, stdout } from 'std:io'
import { argv, exit } from 'std:process'
import { dump_ast } from './ast_dump'
import { build, BuildRequest } from './build'
import { dump_checked } from './checked_dump'
import { all_warnings } from './checker/diagnostics'
import { check_modules } from './checker/modules'
import { tokenize } from './lexer/tokens'
import { load_modules } from './loader'
import { parse } from './parser/statement'
import { read_source } from './source'
import { dump_tokens } from './token_dump'

const USAGE = [
  "usage: lerta build <source> -o <output> [-O] [--target <triple>] [--emit-llvm <path>]\n"
  "                   --root <dir>\n"
  "       lerta build <source> --emit-llvm <path> --root <dir>\n"
  "       lerta dump-tokens <source>\n"
  "       lerta dump-ast <source>\n"
  "       lerta dump-checked <source> --root <dir>\n"
].join('')

const is_value = (arg: String) -> not arg.binary.occurs_at(0, '-'.binary)

const fail_usage = (): never ->
  stderr.write(USAGE)
  exit(2)

# Prints what `dump` makes of one file, without reading the modules it imports.
const run_dump = (args: Array<String>, dump: (String, String) -> String) ->
  fail_usage() if args.length != 1 or not is_value(args[0])
  const path = args[0]
  stdout.write(dump(read_source(path), path))

# Prints the checked syntax trees of the program. `--root` names the directory that holds std/,
# the standard modules, which the compiler cannot find on its own yet.
const run_dump_checked = (args: Array<String>) ->
  const is_valid = args.length == 3 and args[1] == '--root'
  fail_usage() if not is_valid or not is_value(args[0]) or not is_value(args[2])
  const path = args[0]
  const program = check_modules(path, load_modules(path, args[2]))
  stderr.write("#{warning}\n") for warning in all_warnings(program)
  stdout.write(dump_checked(program))

# Each option may be given once, and `--root` names the directory that holds std/ and runtime/
# (see run_dump_checked). Without `-o`, only the IR is written, so `-O` and `--target`, which
# concern the executable, need `-o`.
const parse_build_arguments = (args: Array<String>) ->
  var source: String? = nil
  var output: String? = nil
  var llvm_path: String? = nil
  var root: String? = nil
  var target: String? = nil
  var optimize = false
  var i = 0
  const take_value = (previous: String?) ->
    i += 1
    fail_usage() if previous != nil or i >= args.length or not is_value(args[i])
    args[i]
  while i < args.length
    const arg = args[i]
    case arg
      when '-O'
        fail_usage() if optimize
        optimize = true
      when '-o'
        output = take_value(output)
      when '--emit-llvm'
        llvm_path = take_value(llvm_path)
      when '--root'
        root = take_value(root)
      when '--target'
        target = take_value(target)
      else
        fail_usage() if source != nil or not is_value(arg)
        source = arg
    i += 1
  const executable = output
  fail_usage() if (optimize or target != nil) and executable == nil
  # Without --emit-llvm, the IR is left beside the executable, as the compiler cannot remove a
  # file or make a temporary directory yet.
  const ir_path = llvm_path ? (executable then "#{executable}.ll" else fail_usage())
  const given_source = source ? fail_usage()
  const given_root = root ? fail_usage()
  BuildRequest(
    ir_path, optimize, target, output: executable, source: given_source, root: given_root
  )

const dump_file_tokens = (source: String, path: String) ->
  dump_tokens(tokenize(source, path))

const dump_file_ast = (source: String, path: String) ->
  dump_ast(parse(tokenize(source, path), path))

const command = argv.length > 0 then argv[0] else ''
const args = [argv[i] for i in 1...argv.length]
case command
  when 'build' then build(parse_build_arguments(args))
  when 'dump-tokens' then run_dump(args, dump_file_tokens)
  when 'dump-ast' then run_dump(args, dump_file_ast)
  when 'dump-checked' then run_dump_checked(args)
  else fail_usage()
