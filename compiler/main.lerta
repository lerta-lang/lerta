# The command line of the compiler (see docs/reference/compiler.md#commands).
import parse_args, parse_command, usage from 'std:args'
import stdin, stdout from 'std:io'
import argv, exit, program from 'std:process'
import build, build_and_run, BuildRequest from './build'
import executable_suffix, target_triple from './clang'
import check_program, generate_ir, write_ir from './compile'
import dump_ast, dump_checked, dump_tokens from './dumps'
import CompileError from './errors'
import format_command from './format/command'
import format2_command from './format2/command'
import tokenize from './lexer/tokens'
import lsp_command from './lsp/server'
import parse from './parser/statement'
import basename from './paths'
import cached_include_dir, clean_cache from './runtime_cache'
import given_sources, read_entry_source, SOURCE_EXTENSION, STDIN_NAME from './source'

enum Command
  build
  run
  fmt
  lsp
  cflags
  clean
  dump_tokens
  dump_ast
  dump_checked
  dump_llvm

COMMAND_SPEC :=
  build: { help: 'build an executable of the source' }
  run: { help: 'build the source and run it' }
  fmt: { help: 'check the style of the files, or fix it' }
  lsp: { help: 'serve the language server protocol on standard input and output' }
  cflags: { help: 'print the flags that C code of externs is compiled with' }
  clean: { help: 'remove the cache' }
  dump_tokens: { help: 'print the tokens of the source' }
  dump_ast: { help: 'print the syntax tree of the source' }
  dump_checked: { help: 'print the checked program of the source' }
  dump_llvm: { help: 'print the LLVM IR of the source' }

# The options of build and run, which say how the program is built.
OPTIONS_SPEC :=
  optimize: { short: 'O', help: 'optimize, without the memory checks unless asked for' }
  memory_checks: { help: 'check memory as the program runs' }
  werror: { help: 'treat warnings as errors' }
  no_trace: { help: 'print no trace of an uncaught exception' }
  source_lines: { help: 'show the lines of the source in traces' }
  eager_nan_checks: { help: 'check for NaN where each operation gives it' }
  linker_flag: { value: 'flag', help: 'pass the flag to the linker' }

struct Build
  source: String
  linked_files: String[] = default []
  output: String?
  target: String?
  optimize: Bool
  memory_checks: Bool
  werror: Bool
  no_trace: Bool
  source_lines: Bool
  eager_nan_checks: Bool
  linker_flag: String[] = default []

BUILD_SPEC :=
  OPTIONS_SPEC...
  source: { positional: true }
  linked_files: { positional: true, value: 'file' }
  output: { short: 'o', value: 'output', help: 'write the executable here' }
  target: { value: 'target', help: 'build for the target' }

struct Run
  source: String
  linked_files: String[] = default []
  optimize: Bool
  memory_checks: Bool
  werror: Bool
  no_trace: Bool
  source_lines: Bool
  eager_nan_checks: Bool
  linker_flag: String[] = default []
  program_args: String[]

RUN_SPEC :=
  OPTIONS_SPEC...
  source: { positional: true }
  linked_files: { positional: true, value: 'file' }
  program_args: { after_dashes: true, value: 'argument' }

struct Fmt
  fix: Bool
  paths: String[]

FMT_SPEC :=
  fix: { help: 'rewrite the files in the style' }
  paths: { positional: true, value: 'path' }

struct Dump
  source: String

DUMP_SPEC := { source: { positional: true } }

# The name of the entry source of the argument (see given_sources): standard input, read whole,
# for `-`.
entry_name := (arg: String) ->
  return arg unless arg == STDIN_NAME_ARG
  text := (await stdin.read_all()).text() ? throw CompileError("#{STDIN_NAME} is not valid UTF-8")
  given_sources[STDIN_NAME] = text
  STDIN_NAME

STDIN_NAME_ARG := '-'

# Prints the error and the usage message of the command, as std:args does, and exits with 2, for
# arguments that std:args takes but the command does not.
fail_usage := (message: String, usage_text: String) ->
  print_error "#{program}: #{message}"
  print_error usage_text
  exit 2

# Prints the IR of the source file, line by line, as it is too large to make one String of.
run_dump_ir := (source: String) ->
  await write_ir(await generate_ir(await entry_name(source), false), stdout)

# Prints what `dump` makes of the source file.
run_dump := (source: String, dump: (String) -> Promise<String>) ->
  await stdout.write(await dump(await entry_name(source)))

# The files that clang links with the program, as it takes them.
LINKED_EXTENSIONS := ['.c', '.m', '.o', '.ll', '.a', '.obj', '.lib']

is_linked_file := (path: String) -> LINKED_EXTENSIONS.any(path.ends_with)

# The request of the arguments that build and run share, for the target, with no output. Its source
# is still `-` for standard input, read once the arguments are known to be right (see entry_name).
build_request := (args: Build | Run, target: String?, usage_text: String) ->
  if file := args.linked_files.find((file) -> not is_linked_file(file))
    fail_usage "not a file that clang links: #{file}", usage_text
  memory_checks := args.memory_checks or not args.optimize
  BuildRequest
    linked_files: args.linked_files
    linker_flags: args.linker_flag
    output: nil
    source: args.source
    kind: { optimize: args.optimize, memory_checks, target }
    warnings_as_errors: args.werror
    traces: not args.no_trace
    source_lines: args.source_lines
    eager_nan_checks: args.eager_nan_checks

build_command := (args: String[]) ->
  usage_text := usage<Build>(BUILD_SPEC, 'build')
  arguments := parse_args<Build>(args, BUILD_SPEC, 'build')
  target := arguments.target then target_triple(arguments.target)
  request := build_request(arguments, target, usage_text)
  output := arguments.output ? default_output(request.source, target, usage_text)
  await build({ request..., output, source: await entry_name(request.source) })

# The program is built in the temporary directory, for the host.
run_command := (args: String[]) ->
  arguments := parse_args<Run>(args, RUN_SPEC, 'run')
  request := build_request(arguments, nil, usage<Run>(RUN_SPEC, 'run'))
  await build_and_run(
    { request..., source: await entry_name(request.source) }
    arguments.program_args
  )

# The executable named after the source, which must have a name to take.
default_output := (source: String, target: String?, usage_text: String) ->
  no_name := -> fail_usage("no name of an executable in #{source}: give -o", usage_text)
  stem := basename(source).without_suffix(SOURCE_EXTENSION) ? no_name()
  no_name() if stem.is_empty()
  "#{stem}#{executable_suffix(target)}"

fmt_command := (args: String[]) ->
  { paths, fix } := parse_args<Fmt>(args, FMT_SPEC, 'fmt')
  exit await format_command(paths, fix)

# Not in the usage: it runs the formatter that is to replace that of `fmt`, for its tests.
fmt2_command := (args: String[]) ->
  { paths, fix } := parse_args<Fmt>(args, FMT_SPEC, 'fmt2')
  exit await format2_command(paths, fix)

cflags_command := -> print("-I#{await cached_include_dir()}")

clean_command := -> print("removed #{path}") for path in await clean_cache()

# The dumps of one module read no module that it imports.
dump_file_tokens := (path: String) -> dump_tokens(tokenize(await read_entry_source(path), path))

dump_file_ast := (path: String) ->
  dump_ast parse(tokenize(await read_entry_source(path), path), path)

dump_program_checked := (path: String) -> dump_checked(await check_program(path, false))

# A compile error is the user's, so it is reported without the compiler's trace.
try
  if argv.first() == 'fmt2'
    await fmt2_command(argv[1..])
  else
    (command, args) := parse_command<Command>(argv, COMMAND_SPEC)
    name := command.to_string().replace('_', '-')
    # Rejects any argument, for the commands that take none.
    no_arguments := -> parse_args<{}>(args, {}, name)
    source := -> parse_args<Dump>(args, DUMP_SPEC, name).source
    case command
      when Command.build then await build_command(args)
      when run then await run_command(args)
      when fmt then await fmt_command(args)
      when lsp
        no_arguments()
        await lsp_command()
      when cflags
        no_arguments()
        await cflags_command()
      when clean
        no_arguments()
        await clean_command()
      when Command.dump_tokens then await run_dump(source(), dump_file_tokens)
      when Command.dump_ast then await run_dump(source(), dump_file_ast)
      when Command.dump_checked then await run_dump(source(), dump_program_checked)
      when dump_llvm then await run_dump_ir(source())
catch error: CompileError
  print_error error.message
  exit 1
