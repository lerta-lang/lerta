# The command line of the compiler (see docs/reference/compiler.md#commands).
import stdin, stdout from 'std:io'
import argv, exit from 'std:process'
import dump_ast from './ast_dump'
import build, build_and_run, BuildRequest from './build'
import dump_checked from './checked_dump'
import executable_suffix, target_triple from './clang_flags'
import check_program, generate_ir, write_ir from './compile'
import CompileError from './errors'
import format_command from './format/command'
import tokenize from './lexer/tokens'
import lsp_command from './lsp/server'
import parse from './parser/statement'
import basename from './paths'
import cached_include_dir, clean_cache from './runtime_cache'
import
  COMMAND_LINE_NAME, given_sources, read_entry_source, SOURCE_EXTENSION, STDIN_NAME
from './source'
import dump_tokens from './token_dump'

USAGE := """
  usage: lerta build <source> [<file>...] [-o <output>] [-O] [--memory-checks] [-Werror]
                     [--no-trace] [--source-lines] [--eager-nan-checks] [--target <target>]
                     [--linker-flag <flag>...]
         lerta run (<source> | -e <code>) [<file>...] [-O] [--memory-checks] [-Werror]
                   [--no-trace] [--source-lines] [--eager-nan-checks] [--linker-flag <flag>...]
                   [-- <arg>...]
         lerta fmt [--fix] <path>...
         lerta lsp
         lerta cflags
         lerta clean
         lerta dump-tokens <source>
         lerta dump-ast <source>
         lerta dump-checked <source>
         lerta dump-llvm <source>"""

is_value := (arg: String) -> not arg.starts_with('-')

# A source is a value, or `-` for standard input.
is_source := (arg: String) -> is_value(arg) or arg == STDIN_ARG

STDIN_ARG := '-'

# The name of the entry source of the argument (see given_sources): standard input, read whole,
# for `-`.
entry_name := (arg: String) ->
  return arg unless arg == STDIN_ARG
  text := (await stdin.read_all()).text() ? throw CompileError("#{STDIN_NAME} is not valid UTF-8")
  given_sources[STDIN_NAME] = text
  STDIN_NAME

# The name of the entry source of the code of `-e` (see given_sources).
code_name := (code: String) ->
  given_sources[COMMAND_LINE_NAME] = code
  COMMAND_LINE_NAME

fail_usage := ->
  print_error USAGE
  exit 2

# Prints the IR of the source file, line by line, as it is too large to make one String of.
run_dump_ir := (args: String[]) ->
  fail_usage() if args.length != 1 or not is_source(args[0])
  await write_ir(await generate_ir(await entry_name(args[0]), false), stdout)

# Prints what `dump` makes of the source file.
run_dump := (args: String[], dump: (String) -> Promise<String>) ->
  fail_usage() if args.length != 1 or not is_source(args[0])
  await stdout.write(await dump(await entry_name(args[0])))

# The files that clang links with the program, as it takes them.
LINKED_EXTENSIONS := ['.c', '.m', '.o', '.ll', '.a', '.obj', '.lib']

is_linked_file := (path: String) -> LINKED_EXTENSIONS.any(path.ends_with)

# The options that each turn one thing on or off.
SWITCHES :=
  '-O'
  '--memory-checks'
  '-Werror'
  '--no-trace'
  '--source-lines'
  '--eager-nan-checks'

# The request, with no output and no target unless given, and the program's arguments after `--`.
# Its source is still `-` for standard input.
parse_build_arguments := (args: String[]) ->
  values: String[]
  var code: String?
  linker_flags: String[]
  var output: String?
  var target: String?
  switches: Set<String>
  var program_args: String[]?
  var i = 0
  # The value is the next argument, even one that starts with `-`, as `-o -out` gives `-out`.
  take_value := (previous: String?) ->
    i += 1
    fail_usage() if previous != nil or i >= args.length
    args[i]
  while i < args.length
    arg := args[i]
    case arg
      when '-e' then code = take_value(code)
      when '-o' then output = take_value(output)
      when '--target' then target = target_triple(take_value(target))
      when '--linker-flag' then linker_flags.push(take_value(nil))
      when '--'
        program_args = args[(i + 1)..]
        break
      else
        if arg in SWITCHES
          fail_usage() unless switches.add(arg)
        else
          fail_usage() unless is_source(arg)
          values.push arg
    i += 1
  # The first value is the source, unless `-e` gives it.
  fail_usage() if code == nil and values.is_empty()
  linked_files := code != nil then values else values[1..]
  fail_usage() unless linked_files.all(is_linked_file)
  # `-` is read once the usage is known to be right, by the command (see entry_name).
  source := code then code_name(code) else values[0]
  optimize := '-O' in switches
  memory_checks := '--memory-checks' in switches or not optimize
  request := BuildRequest
    linked_files
    linker_flags
    output
    source
    kind: { optimize, memory_checks, target }
    warnings_as_errors: '-Werror' in switches
    traces: '--no-trace' not in switches
    source_lines: '--source-lines' in switches
    eager_nan_checks: '--eager-nan-checks' in switches
  { request, program_args }

build_command := (args: String[]) ->
  { request, program_args } := parse_build_arguments(args)
  fail_usage() if program_args != nil or request.source == COMMAND_LINE_NAME
  output := request.output ? default_output(request.source, request.kind.target)
  await build({ request..., output, source: await entry_name(request.source) })

# The program is built in the temporary directory, for the host.
run_command := (args: String[]) ->
  { request, program_args } := parse_build_arguments(args)
  fail_usage() if request.output != nil or request.kind.target != nil
  await build_and_run({ request..., source: await entry_name(request.source) }, program_args ? [])

default_output := (source: String, target: String?) ->
  name := basename(source)
  stem := name.without_suffix(SOURCE_EXTENSION) ? fail_usage()
  fail_usage() if stem.is_empty()
  "#{stem}#{executable_suffix(target)}"

# `--fix` may come before the paths, of which there is at least one.
fmt_command := (args: String[]) ->
  fix := not args.is_empty() and args[0] == '--fix'
  paths := fix then args[1..] else args
  fail_usage() if paths.is_empty() or paths.any((path) -> not is_value(path))
  exit await format_command(paths, fix)

cflags_command := (args: String[]) ->
  fail_usage() unless args.is_empty()
  print "-I#{await cached_include_dir()}"

clean_command := (args: String[]) ->
  fail_usage() unless args.is_empty()
  print "removed #{path}" for path in await clean_cache()

# The dumps of one module read no module that it imports.
dump_file_tokens := (path: String) -> dump_tokens(tokenize(await read_entry_source(path), path))

dump_file_ast := (path: String) ->
  dump_ast parse(tokenize(await read_entry_source(path), path), path)

dump_program_checked := (path: String) -> dump_checked(await check_program(path, false))

command := argv.first() ? ''
args := argv[min(1, argv.length)..]
# A compile error is the user's, so it is reported without the compiler's trace.
try
  case command
    when 'build' then await build_command(args)
    when 'run' then await run_command(args)
    when 'fmt' then await fmt_command(args)
    when 'lsp' then await lsp_command(args)
    when 'cflags' then await cflags_command(args)
    when 'clean' then await clean_command(args)
    when 'dump-tokens' then await run_dump(args, dump_file_tokens)
    when 'dump-ast' then await run_dump(args, dump_file_ast)
    when 'dump-checked' then await run_dump(args, dump_program_checked)
    when 'dump-llvm' then await run_dump_ir(args)
    else fail_usage()
catch error: CompileError
  print_error error.message
  exit 1
