# Reads the entry module and the modules it imports, directly or not, including std:builtins, which
# the others import (see builtins_import).
import { is_file, real_path } from 'std:io'
import { Import, Position, Statement } from './ast'
import { EMBEDDED_PATHS } from './embedded'
import { compile_error, CompileError, module_location } from './errors'
import { tokenize } from './lexer/tokens'
import { parse } from './parser/statement'
import { dirname, join, relative } from './paths'
import { is_standard_name, read_entry_source, read_source, standard_source } from './source'

export class Module
  # Its position in the list of modules, which keeps its symbols apart from the others', and is
  # the order in which their top-level code runs.
  index: Int
  # For diagnostics: relative to the entry module's directory, or `std:name` for a standard
  # module; nil for the entry module.
  display_path: String?
  program: Array<Statement>
  # The indexes of the modules that its imports refer to.
  imported: Map<Import, Int>
  # The indexes of the modules of the import cycle it is in, itself included; empty if it is in
  # none.
  cycle: Array<Int>

# Every module imports std:builtins, as `import 'std:builtins'`, for the builtin functions and the
# methods of the builtin types that it gives; all but std:builtins itself and the standard modules
# that it imports, directly or not, which cannot use them.
export const BUILTINS_MODULE = 'std:builtins'

# std:builtins and the standard modules it imports, which cannot import it back.
const BUILTINS_AND_DEPENDENCIES = [BUILTINS_MODULE, 'std:io']

# A module as it is loaded: its imports refer to the modules by their places in the loading order,
# since a module's index is known only once its imports are loaded.
class LoadingModule
  display_path: String?
  program: Array<Statement>
  imported: Map<Import, Int> = Map()
  # The places of the modules of its import cycle, if it is in one.
  cycle: Array<Int> = []
  # Its index, once its imports are loaded.
  index = -1

class Loader
  entry_path: String
  # The directory that relative paths start from.
  cwd: String
  loaded: Array<LoadingModule> = []
  # The places of the modules by their keys (see load).
  by_key: Map<String, Int> = Map()
  # The modules in the order of their indexes.
  order: Array<Int> = []

# The modules, each after those it imports unless they import it back, so the entry module comes
# last. The standard modules are those embedded in the compiler.
export const load_modules = (entry_path: String) ->
  const loader = Loader(entry_path, cwd: real_path_text('.'))
  const source = read_entry_source(entry_path)
  const key = is_standard_name(entry_path) then entry_path else real_path_text(entry_path)
  load loader, key, source, nil
  [finished_module(loader, id) for id in loader.order]

# A module is known by its key: a standard module by its name, `std:name`, and a file by its real
# path, so that one file reached by different paths loads once, and its imports are relative to
# where it really is. Diagnostics name a file by a path from the entry module's directory as
# given. Returns the module's place in the loading order.
const load = (loader: Loader, key: String, source: String, display_path: String?) ->
  const location = module_location(loader.entry_path, display_path)
  const program = parse(tokenize(source, location), location)
  const is_builtins_dependency = BUILTINS_AND_DEPENDENCIES.contains(key)
  const with_builtins = is_builtins_dependency then program else prepend(builtins_import(), program)
  const id = loader.loaded.length
  const module = LoadingModule(display_path, program: with_builtins)
  loader.loaded.push module
  loader.by_key[key] = id
  for statement in with_builtins
    if statement is Import
      check_standard_import statement, key, location
      module.imported[statement] = visit(loader, statement, dirname(key), location)
  module.index = loader.order.length
  loader.order.push id
  id

# A standard module has no directory for a relative import to start from.
const check_standard_import = (statement: Import, key: String, location: String) ->
  return if not is_standard_name(key) or is_standard_name(statement.module)
  import_error statement, location, "a standard module imports only standard modules"

const builtins_import = () ->
  Import names: [], module: BUILTINS_MODULE, position: Position(line: 1, column: 1)

const prepend = (first: Statement, rest: Array<Statement>) ->
  const statements = [first]
  statements.append rest
  statements

# The module that an import names, loaded if it is not yet: `std:name` is a standard module, and a
# path that starts with `./` or `../` is a file relative to `from`, the directory of the importing
# file. Other names are reserved. `location` names the importing module in diagnostics.
const visit = (loader: Loader, statement: Import, from: String, location: String): Int ->
  const module = statement.module
  if is_standard_name(module)
    const source = imported_standard_source(statement, location)
    return loaded(loader, module) ? load(loader, module, source, module)
  const path = imported_file(statement, from, location)
  const real = real_path_text(path)
  const display_path = relative(loader.cwd, dirname(loader.entry_path), path)
  loaded(loader, real) ? load(loader, real, read_source(path), display_path)

# The place of the module of `key` if it is loaded. An import of a module whose imports are being
# loaded closes a cycle (see close_cycle).
const loaded = (loader: Loader, key: String) ->
  const id = loader.by_key[key] ? return nil
  close_cycle loader, id if loader.loaded[id].index == -1
  id

# An import of a module whose imports are being loaded closes a cycle: that module and those that
# started loading after it and are still loading, which import each other in turn. Cycles that
# share a module are one.
const close_cycle = (loader: Loader, back: Int) ->
  const members: Array<Int> = []
  for id in back...loader.loaded.length
    const module = loader.loaded[id]
    continue if module.index != -1
    const ids = module.cycle.length > 0 then module.cycle else [id]
    members.push each for each in ids when not members.contains(each)
  loader.loaded[id].cycle = members for id in members

const STD_DIR = 'std/'

# The embedded paths of the standard modules, std/<name>.lerta.
const standard_paths = () -> [path for path in EMBEDDED_PATHS when path.starts_with(STD_DIR)]

# The name of a standard module, `std:name`, from its embedded path.
const standard_name = (path: String) ->
  const bytes = path.binary
  "std:#{bytes.text(STD_DIR.binary.length, bytes.length - '.lerta'.binary.length)!}"

const imported_standard_source = (statement: Import, location: String) ->
  return source if const source = standard_source(statement.module)
  const list = [standard_name(path) for path in standard_paths()].join(', ')
  const message = "unknown module '#{statement.module}'; the standard modules are #{list}"
  import_error statement, location, message

const imported_file = (statement: Import, from: String, location: String) ->
  const module = statement.module
  if not module.starts_with('./') and not module.starts_with('../')
    const rule = 'a file is imported by a path that starts with ./ or ../'
    import_error statement, location, "unknown module '#{module}'; #{rule}"
  const path = join(from, "#{module}.lerta")
  import_error statement, location, "cannot find module '#{module}'" if not is_file(path)
  path

const import_error = (statement: Import, location: String, message: String) ->
  const { line, column } = statement.position
  compile_error location, line, column, message

const finished_module = (loader: Loader, id: Int) ->
  const loading = loader.loaded[id]
  const index_of = (place: Int) -> loader.loaded[place].index
  const imported: Map<Import, Int> = Map()
  for statement in loading.imported.keys()
    imported[statement] = index_of(loading.imported[statement]!)
  const { index, display_path, program } = loading
  const cycle = [index_of(place) for place in loading.cycle]
  Module index, display_path, program, imported, cycle

export const is_standard_module = (module: Module) ->
  return path.starts_with('std:') if const path = module.display_path
  false

# Paths are compared as text, so a real path must be UTF-8.
const real_path_text = (path: String) ->
  const message = "the real path of '#{path}' is not valid UTF-8"
  real_path(path).text() ? throw CompileError(message)
