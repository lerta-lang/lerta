# Reads the entry module and the modules it imports, directly or not, including std:builtins, which
# the others import (see builtins_import).
import is_file, real_path from 'std:io'
import Import, Statement from './ast'
import compile_error, Located from './errors'
import Token, tokenize from './lexer/tokens'
import parse, parse_partially from './parser/statement'
import base_name, dir_name, join, relative from 'std:path'
import
  given_sources, is_standard_name, module_location, read_entry_source, read_source, standard_import,
  standard_names, standard_source
from './source'

export class Module
  # Its position in the list of modules: the order in which their top-level code runs.
  index: Int
  # For diagnostics: relative to the entry module's directory, or `std:name` for a standard
  # module; nil for the entry module.
  display_path: String?
  # Names it in symbols: its display path, or `./` and its file name for the entry module, which no
  # display path starts with. Unlike its index, it does not change as modules are added or removed.
  symbol_name: String
  # Its key (see load): `std:name`, or the real path of its file.
  key: String
  # Its text, from which a compile-time intrinsic quotes the code it is given (see
  # compiler/checker/intrinsics.lerta).
  source: String
  program: Statement[]
  # The indexes of the modules that its imports refer to.
  imported: Map<Import, Int>
  # The indexes of the modules of the import cycle it is in, itself included; empty if it is in
  # none.
  cycle: Int[]

# Every module but std:builtins itself imports it, as `import 'std:builtins'`, for the builtin
# functions and the methods of the builtin types that it gives.
export BUILTINS_MODULE := 'std:builtins'

# A module as it is loaded: its imports refer to the modules by their places in the loading order,
# since a module's index is known only once its imports are loaded.
class LoadingModule
  key: String
  display_path: String?
  source: String
  program: Statement[]
  imported: Map<Import, Int> = Map()
  # The places of the modules of its import cycle, if it is in one.
  var cycle: Int[] = []
  # Its index, once its imports are loaded.
  var index = -1

class Loader
  entry_path: String
  # The modules that the caller has parsed already, by their keys (see EntryModule).
  given: Map<String, EntryModule>
  # The directory that relative paths start from.
  cwd: String
  # Where a module whose top-level statements do not all parse keeps their errors, as it is loaded
  # with those that do; nil if it ends the loading.
  parse_errors: Located[]?
  loaded: LoadingModule[] = []
  # The places of the modules by their keys (see load).
  by_key := Map<String, Int>()
  # The modules in the order of their indexes.
  order: Int[] = []

# A module as its caller has it already, for `lerta fmt`, whose edits find the facts that the
# checking records by the nodes that it parsed; the checking leaves the nodes as they are.
export struct EntryModule
  source: String
  program: Statement[]

# The modules, each after those it imports unless they import it back, so the entry module comes
# last: each file as `given` by its key (see module_key), if it is, else read. The standard modules
# are those embedded in the compiler.
export load_modules := (entry_path: String, given: Map<String, EntryModule> = Map()) ->
  await load_all(Loader(entry_path, given, cwd: real_path('.'), parse_errors: nil))

# The modules as load_modules gives them, but each with the statements that parse, for an
# editor, which checks the code that is being written; the errors of those that do not go into
# `parse_errors`, those found before an error that ends the loading too.
export load_modules_partially := (entry_path: String, parse_errors: Located[]) ->
  await load_all(Loader(entry_path, parse_errors, given: Map(), cwd: real_path('.')))

load_all := (loader: Loader) ->
  { entry_path, given } := loader
  # A key resolves the path, which a missing file does not: one that is not given is read first,
  # which reports it as missing.
  entry := given.is_empty() then nil else given[module_key(entry_path)]
  source := entry?.source ? await read_entry_source(entry_path)
  await load(loader, module_key(entry_path), source, nil, entry?.program)
  [finished_module(loader, id) for id in loader.order]

# A module is known by its key: a standard module by its name, `std:name`, a source that the
# command line gives by its name (see given_sources), and a file by its real path, so that one file
# reached by different paths loads once, and its imports are relative to where it really is.
# Diagnostics name a file by a path from the entry module's directory as given. Returns the
# module's place in the loading order.
load := (
  loader: Loader
  key: String
  source: String
  display_path: String?
  parsed: Statement[]? = nil
): Promise<Int> ->
  location := module_location(loader.entry_path, display_path)
  program := parsed ? parsed_program(loader, tokenize(source, location), location)
  with_builtins := key == BUILTINS_MODULE then program else [builtins_import(), program...]
  id := loader.loaded.length
  module := LoadingModule(key, display_path, source, program: with_builtins)
  loader.loaded.push module
  loader.by_key[key] = id
  for statement in with_builtins
    if statement is Import
      module.imported[statement] = await visit(loader, statement, key, location)
  module.index = loader.order.length
  loader.order.push id
  id

parsed_program := (loader: Loader, tokens: Token[], location: String) ->
  errors := loader.parse_errors ? return parse(tokens, location)
  parsed := parse_partially(tokens, location)
  errors.append parsed.errors
  parsed.statements

builtins_import := (): Statement ->
  Import(names: [], module: BUILTINS_MODULE, position: { line: 1, column: 1 })

# The module that an import names, loaded if it is not yet: `std:name` is a standard module, and a
# path that starts with `./` or `../` is a file relative to the importing one, `from` by its key:
# for a module of std, a file of std (see standard_import). Other names are reserved. `location`
# names the importing module in diagnostics.
visit := (loader: Loader, statement: Import, from: String, location: String): Promise<Int> ->
  module := statement.module
  if is_standard_name(module)
    source := imported_standard_source(statement, location)
    return loaded(loader, module) ? await load_standard(loader, module, source)
  return await visit_standard_file(loader, statement, from, location) if is_standard_name(from)
  path := imported_file(statement, dir_name(from), location)
  real := real_path(path)
  display_path := relative(dir_name(loader.entry_path), path, loader.cwd)
  return id if id := loaded(loader, real)
  if given := loader.given[real]
    return await load(loader, real, given.source, display_path, given.program)
  await load(loader, real, await read_source(path), display_path)

# A file of std that a standard module imports by a relative path.
visit_standard_file := (
  loader: Loader, statement: Import, from: String, location: String
): Promise<Int> ->
  missing := -> import_error(statement, location, "cannot find module '#{statement.module}' in std")
  { module, source } := standard_import(from, statement.module) ? missing()
  loaded(loader, module) ? await load_standard(loader, module, source)

# A module of std, as `given` holds it if it does, as `lerta fmt` gives the files of std that it
# formats, or else as the compiler carries it.
load_standard := (loader: Loader, module: String, source: String): Promise<Int> ->
  given := loader.given[module]
  await load(loader, module, given?.source ? source, module, given?.program)

# The place of the module of `key` if it is loaded. An import of a module whose imports are being
# loaded closes a cycle (see close_cycle).
loaded := (loader: Loader, key: String) ->
  id := loader.by_key[key] ? return nil
  close_cycle loader, id if loader.loaded[id].index == -1
  id

# An import of a module whose imports are being loaded closes a cycle: that module and those that
# started loading after it and are still loading, which import each other in turn. Cycles that
# share a module are one.
close_cycle := (loader: Loader, back: Int) ->
  members: Int[]
  seen: Set<Int>
  for id in back..loader.loaded.length
    module := loader.loaded[id]
    continue if module.index != -1
    ids := not module.cycle.is_empty() then module.cycle else [id]
    for each in ids
      members.push each if seen.add(each)
  loader.loaded[id].cycle = members for id in members

imported_standard_source := (statement: Import, location: String) ->
  return source if source := standard_source(statement.module)
  list := standard_names().join(', ')
  message := "unknown module '#{statement.module}'; the standard modules are #{list}"
  import_error(statement, location, message)

imported_file := (statement: Import, from: String, location: String) ->
  module := statement.module
  if not module.starts_with('./') and not module.starts_with('../')
    rule := 'a file is imported by a path that starts with ./ or ../'
    import_error statement, location, "unknown module '#{module}'; #{rule}"
  path := join(from, "#{module}.lerta")
  import_error statement, location, "cannot find module '#{module}'" unless is_file(path)
  path

import_error := (statement: Import, location: String, message: String) ->
  { line, column } := statement.position
  compile_error location, line, column, message

finished_module := (loader: Loader, id: Int) ->
  loading := loader.loaded[id]
  index_of := (place: Int) -> loader.loaded[place].index
  imported: Map<Import, Int>
  imported[statement] = index_of(place) for (statement, place) in loading.imported
  { index, key, display_path, source, program } := loading
  symbol_name := display_path ? "./#{base_name(loader.entry_path)}"
  cycle := [index_of(place) for place in loading.cycle]
  Module(index, display_path, symbol_name, key, source, program, imported, cycle)

export is_standard_module := (module: Module) ->
  return is_standard_name(path) if path := module.display_path
  false

# The key of the module at the path (see load).
export module_key := (path: String) ->
  is_standard_name(path) or path in given_sources then path else real_path(path)

# The keys of the files that the file at the path imports, read without loading them.
export imported_files := (path: String) ->
  location := module_location(path, nil)
  program := parse(tokenize(await read_source(path), location), location)
  from := dir_name(module_key(path))
  imports := [s for s in program when s is Import and not is_standard_name(s.module)]
  [real_path(imported_file(s, from, location)) for s in imports]
