import IntegerLiteral from './ast'

# The double that a float literal's text rounds to, as the runtime's C converts it.
extern lerta_float_literal_bits: (String) -> Int

# The bits of the double, as an Int, or nil if the text is too large for a finite one.
export const float_bits = (text: String) ->
  const bits = lerta_float_literal_bits(text)
  bits != -1 then bits

# An integer literal's text as a float literal's, in decimal: `-0` is -0.0.
export const integer_float_text = (literal: IntegerLiteral) ->
  const value = literal.value ? return literal.text
  value == 0 and literal.text.starts_with('-') then '-0' else "#{value}"
