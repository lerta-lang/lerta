import IntegerLiteral from './ast'
import is_kind, Type from './types'

# The double, or the float, that a float literal's text rounds to, as the runtime's C converts it.
extern lerta_float_literal_bits: (String) -> Int
extern lerta_float32_literal_bits: (String) -> Int

# The bits of the double that the text rounds to as the type, a Float or a Float32, as an Int, or
# nil if the text is too large for a finite one. A Float32's double is the same value, as the IR
# writes a float constant.
export float_bits := (text: String, type: Type) ->
  is_float32 := is_kind(type, 'Float32')
  bits := is_float32 then lerta_float32_literal_bits(text) else lerta_float_literal_bits(text)
  bits != -1 then bits

# An integer literal's text as a float literal's, in decimal: `-0` is -0.0.
export integer_float_text := (literal: IntegerLiteral) ->
  value := literal.value else return literal.text
  if value == 0 and literal.text.starts_with('-')
    '-0'
  else
    "#{value}"
