# Type names: named types, unions, function types and anonymous structs.
import {
  FunctionTypeName, NamedType, RecordTypeField, RecordTypeName, TypeName
  UnionMember, UnionTypeName
} from '../ast'
import { parse_identifier, parse_list } from './expression'
import { is_one_of, token_position, TokenStream } from './token_stream'

# The tokens that a type name is made of.
const TYPE_TOKEN_KINDS = ['identifier', '<', '>', ',', '?', '|', '(', ')', '->', '{', '}', ':']

# A named type, or a union of them: `A | B`.
export const parse_type_name = (tokens: TokenStream): TypeName ->
  return parse_parenthesized_type(tokens) if tokens.peek().kind == '('
  const first = parse_union_member(tokens)
  return first if tokens.peek().kind != '|'
  const members = [first]
  members.push(parse_union_member(tokens)) while tokens.accept('|')
  UnionTypeName(members, position: first.position)

# `(A, B) -> R`, or a function type in parentheses, `((A) -> R)?`, to make it optional.
const parse_parenthesized_type = (tokens: TokenStream): TypeName ->
  const position = token_position(tokens.next())
  const types = parse_list(tokens, ')', () -> parse_type_name(tokens))
  if tokens.accept('->')
    const result = parse_type_name(tokens)
    return FunctionTypeName(result, position, params: types, optional: false)
  const fail = (): never -> tokens.fail_expecting(tokens.peek(), "'->'")
  fail() if types.length != 1
  const inner = types[0]
  case inner
    when FunctionTypeName
      const { params, result } = inner
      FunctionTypeName(params, result, position, optional: tokens.accept('?'))
    else fail()

# A type that `|` can join: a named type or an anonymous struct, which the checker rejects as a
# member so far.
const parse_union_member = (tokens: TokenStream): UnionMember ->
  tokens.peek().kind == '{' then parse_record_type(tokens) else parse_named_type(tokens)

# `{ x: Int, y: String }`, with `?` after it if it may be nil.
const parse_record_type = (tokens: TokenStream): RecordTypeName ->
  const position = token_position(tokens.next())
  const fields = parse_list(tokens, '}', () -> parse_record_type_field(tokens))
  RecordTypeName(fields, position, optional: tokens.accept('?'))

const parse_record_type_field = (tokens: TokenStream): RecordTypeField ->
  const name = parse_identifier(tokens)
  tokens.expect(':', "':'")
  RecordTypeField(name, type: parse_type_name(tokens))

export const parse_named_type = (tokens: TokenStream): NamedType ->
  const { name, position } = parse_identifier(tokens)
  const args: Array<TypeName> = tokens.peek().kind == '<' then parse_type_arguments(tokens) else []
  NamedType(name, args, position, optional: tokens.accept('?'))

# `<A, B>`.
export const parse_type_arguments = (tokens: TokenStream): Array<TypeName> ->
  tokens.expect('<', "'<'")
  const args = [parse_type_name(tokens)]
  args.push(parse_type_name(tokens)) while tokens.accept(',')
  tokens.expect('>', "'>'")
  args

# Whether type arguments follow, written without a space and followed by `(`, as in `f<Int>(x)`.
# Comparisons do not chain, so `a<b>(c)` cannot be read otherwise.
export const starts_type_arguments = (tokens: TokenStream): Bool ->
  const open = tokens.peek()
  return false if open.kind != '<' or open.spaced
  var depth = 0
  var offset = 0
  while true
    const kind = tokens.peek_at(offset).kind
    return false if not is_one_of(kind, TYPE_TOKEN_KINDS)
    depth += 1 if kind == '<'
    depth -= 1 if kind == '>'
    break if depth == 0
    offset += 1
  const next = tokens.peek_at(offset + 1)
  next.kind == '(' and not next.spaced
