# Type syntax: type names (named types, unions, function types, anonymous structs, tuples and
# arrays), type annotations and type parameters.
import
  ArrayTypeName, CastTypeName, FunctionTypeName, NamedType, Position, RecordTypeField,
  RecordTypeName, TupleTypeName, TypeName, TypeParameter, UnionMember, UnionTypeName
from '../ast'
import TokenKind from '../lexer/tokens'
import parse_identifier from './expression'
import TokenStream from './token_stream'

# The tokens that a type name is made of.
TYPE_TOKEN_KINDS: TokenKind[] =
  IDENTIFIER, '.', '<', '>', ',', '?', '|', '(', ')', '->', '{', '}', ':', '[', ']'

# Any type: a union, `A | B`, or a type that may be one of its members, or a function type. As a
# function literal's return type, `is_result`, the `->` after a type in parentheses starts the body
# (see parse_parenthesized_type).
export parse_type_name := (tokens: TokenStream, is_result = false): TypeName ->
  tokens.nested(-> parse_any_type(tokens, is_result))

parse_any_type := (tokens: TokenStream, is_result: Bool) ->
  if tokens.peek().kind != '('
    return union_of(parse_union_members(tokens, is_result))
  position := tokens.peek().position()
  first := parse_parenthesized_type(tokens, is_result)
  return first if tokens.peek().kind != '|'
  tokens.next()
  member := first as UnionMember ? fail_member(tokens, position, first)
  union_of([member, parse_union_members(tokens, is_result)...])

# A function type, or a union in parentheses, `(A | B)?`, whose members are written in the union
# that holds it: `A | B? | C`.
fail_member := (tokens: TokenStream, at: Position, type: TypeName) ->
  in_union := 'a union in another is written without parentheses: `A | B? | C`'
  tokens.fail at, type is UnionTypeName then in_union else 'a union cannot hold a function type'

# The type of `type Name =`: a type on the same line, or a union whose members are on the indented
# lines below, one or more on each line.
export parse_aliased_type := (tokens: TokenStream) ->
  return parse_type_name(tokens) if tokens.peek().kind != NEWLINE
  lines := tokens.parse_lines('indented union members', -> parse_union_members(tokens))
  members: UnionMember[]
  members.append line for line in lines
  union_of(members)

# `A | B | ...`, or one member alone.
parse_union_members := (tokens: TokenStream, is_result = false) ->
  tokens.parse_separated('|', -> parse_union_member(tokens, is_result))

# The union of the members, or the member alone.
union_of := (members: UnionMember[]): TypeName ->
  return members[0] if members.length == 1
  UnionTypeName(members, position: members[0].position)

# `(A, B) -> R`, a tuple, `(A, B)`, or a function type or a union in parentheses, `((A) -> R)?` or
# `(A | B)?`, to make it optional. Any type in parentheses may be the items of an array:
# `((A) -> R)[]`, `(A | B)[]`. As a function literal's return type, the `->` after it starts the
# body, so a function type there is written in parentheses.
parse_parenthesized_type := (tokens: TokenStream, is_result: Bool): TypeName ->
  position := tokens.next().position()
  types := tokens.parse_list(')', -> parse_type_name(tokens))
  is_tuple := types.length > 1 and (is_result or tokens.peek().kind != '->')
  if is_tuple
    tuple := TupleTypeName(position, items: types, optional: tokens.accept('?'))
    return parse_array_suffix(tokens, tuple, position)
  if not is_result and tokens.accept('->')
    result := parse_type_name(tokens)
    return FunctionTypeName(result, position, params: types)
  is_array := types.length == 1 and tokens.peek().kind == '['
  if is_array
    return parse_array_type(tokens, types[0], position)
  inner := types.length == 1 then types[0]
  if inner is UnionTypeName and tokens.accept('?')
    union := UnionTypeName(inner..., position, optional: true)
    return parse_array_suffix(tokens, union, position)
  if inner is FunctionTypeName
    { params, result } := inner
    function := FunctionTypeName(params, result, position, optional: tokens.accept('?'))
    return parse_array_suffix(tokens, function, position)
  if is_result
    tokens.fail position, 'a function type returned is written in parentheses: `((Int) -> Int)`'
  tokens.fail_expecting(tokens.peek(), "'->'")

# A type that `|` can join, as a type test tests: a named type, an anonymous struct, a tuple or an
# array.
export parse_union_member := (tokens: TokenStream, is_result = false): UnionMember ->
  return parse_parenthesized_member(tokens, is_result) if tokens.peek().kind == '('
  member: UnionMember =
    tokens.peek().kind == '{' then parse_record_type(tokens) else parse_named_type(tokens)
  return member if tokens.peek().kind != '['
  parse_array_type(tokens, member, member.position)

parse_parenthesized_member := (tokens: TokenStream, is_result: Bool): UnionMember ->
  position := tokens.peek().position()
  type := parse_parenthesized_type(tokens, is_result)
  type as UnionMember ? fail_member(tokens, position, type)

# The type, made the items of an array if `[]` follows.
parse_array_suffix := (tokens: TokenStream, type: TypeName, position: Position): TypeName ->
  if tokens.peek().kind == '['
    parse_array_type(tokens, type, position)
  else
    type

# `T[]`, any number of times, each with `?` after it if the array may be nil: `Int[]?` is an
# optional array, and `Int[]?[]` an array of them.
parse_array_type := (tokens: TokenStream, element: TypeName, position: Position): ArrayTypeName ->
  tokens.next()
  tokens.expect ']'
  array := ArrayTypeName(element, position, optional: tokens.accept('?'))
  return array if tokens.peek().kind != '['
  tokens.nested(-> parse_array_type(tokens, array, position))

# A named type, or an array of them, without the `?` after it, which is the cast's.
export parse_cast_type := (tokens: TokenStream) ->
  if tokens.peek().kind in ['(', '{']
    message := 'a cast is to a named type or an array of one so far; narrow the others with `is`'
    tokens.fail_here message
  named := parse_named_type_alone(tokens)
  var type: CastTypeName = named
  nesting := tokens.nesting
  while tokens.peek().kind == '[' and tokens.peek_at(1).kind == ']'
    tokens.deepen()
    tokens.next()
    tokens.next()
    type = ArrayTypeName(element: type, position: named.position)
  tokens.nesting = nesting
  type

# `{ x: Int, y: String }`, with `?` after it if it may be nil.
parse_record_type := (tokens: TokenStream) ->
  position := tokens.next().position()
  fields := tokens.parse_list('}', -> parse_record_type_field(tokens))
  RecordTypeName(fields, position, optional: tokens.accept('?'))

parse_record_type_field := (tokens: TokenStream) ->
  name := parse_identifier(tokens)
  tokens.expect ':'
  RecordTypeField(name, type: parse_type_name(tokens))

export parse_named_type := (tokens: TokenStream) ->
  type := parse_named_type_alone(tokens)
  type.optional = tokens.accept('?')
  type

# A named type without the `?` that may follow it.
# A name that a module imported as a name qualifies, `mod.Point`, is one name.
export parse_named_type_alone := (tokens: TokenStream) ->
  { name, position } := parse_identifier(tokens)
  qualifies := tokens.peek().kind == '.' and tokens.peek_at(1).kind == IDENTIFIER
  full_name := qualifies then "#{name}.#{parse_qualified_rest(tokens)}" else name
  args: TypeName[] = tokens.peek().kind == '<' then parse_type_arguments(tokens) else []
  NamedType(args, position, name: full_name)

parse_qualified_rest := (tokens: TokenStream) ->
  tokens.next()
  parse_identifier(tokens).name

# `<A, B>`.
export parse_type_arguments := (tokens: TokenStream) ->
  tokens.expect '<'
  args := tokens.parse_separated(',', -> parse_type_name(tokens))
  tokens.expect '>'
  args

# Whether type arguments follow, written without a space and followed by `(`, as in `f<Int>(x)`.
# Comparisons do not chain, so `a<b>(c)` cannot be read otherwise; `a<<b>>(c)` is two shifts, as
# no type argument starts with `<`.
export at_type_arguments := (tokens: TokenStream) ->
  open := tokens.peek()
  return false if open.kind != '<' or open.spaced
  second := tokens.peek_at(1)
  return false if second.kind == '<' and not second.spaced
  is_type_token := (kind: TokenKind) -> kind in TYPE_TOKEN_KINDS
  close := tokens.closing_offset('<', '>', is_type_token) ? return false
  next := tokens.peek_at(close + 1)
  next.kind == '(' and not next.spaced

# `: Type`, if it follows.
export parse_type_annotation := (tokens: TokenStream) ->
  tokens.accept(':') then parse_type_name(tokens)

# `: Type` as a function literal's return type (see parse_parenthesized_type), if it follows.
export parse_result_annotation := (tokens: TokenStream) ->
  if tokens.accept(':')
    parse_type_name(tokens, true)
  else
    nil

# `<T, U: Stringable, X: Iterable<T>>`, if it follows.
export parse_type_parameters := (tokens: TokenStream): TypeParameter[] ->
  return [] unless tokens.accept('<')
  type_params := tokens.parse_separated(',', -> parse_type_parameter(tokens))
  tokens.expect '>'
  type_params

parse_type_parameter := (tokens: TokenStream) ->
  name := parse_identifier(tokens)
  bound := tokens.accept(':') then parse_named_type(tokens)
  TypeParameter(name, bound)

# The type of `x is T`: a member, or a union of members written in place, `x is A | B`.
export parse_tested_type := (tokens: TokenStream) -> union_of(parse_union_members(tokens))
