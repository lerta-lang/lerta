# Declarations other than those of consts and `var`s: type aliases, classes, structs, enums,
# interfaces, extends, imports, externs and exports.
import parse from 'std:enums'
import
  as_exportable, Declaration, EnumDeclaration, Extend, Extern, Identifier, Import, Intrinsic,
  ImportName, InterfaceDeclaration, MemberDeclaration, MemberModifier, Position, Statement,
  StringLiteral, TypeAlias, TypeDeclaration
from '../ast'
import accept_pass_block from './compound'
import parse_identifier, parse_value from './expression'
import at_destructuring, parse_destructuring_statement, parse_statement from './statement'
import Token from '../lexer/tokens'
import TokenStream from './token_stream'
import ENUM_BITS from '../types'
import
  parse_aliased_type, parse_named_type, parse_type_annotation, parse_type_name,
  parse_type_parameters
from './type'

export at_type_alias := (tokens: TokenStream) ->
  name_follows := tokens.peek_at(1).kind == IDENTIFIER
  tokens.at_word('type') and name_follows and tokens.peek_at(2).kind == '='

export parse_type_alias := (tokens: TokenStream) ->
  position := tokens.next().position()
  name := parse_identifier(tokens)
  tokens.expect '='
  TypeAlias(name, position, type: parse_aliased_type(tokens))

# `export` before a `const` (a function or a value) or a type, or before the names of a module or
# the module alone; the checker tells whether it is at the top level.
export parse_export := (tokens: TokenStream): Statement ->
  token := tokens.next()
  return parse_reexport(tokens, token.position()) if at_reexport(tokens)
  fail := ->
    message := 'only a const, a class, a struct, an enum, an interface, a type alias or an ' +
      'extern can be exported'
    tokens.fail token.position(), message
  if at_destructuring(tokens)
    parse_destructuring_statement tokens
    fail()
  statement := parse_statement(tokens)
  declaration := as_exportable(statement) else fail()
  fail() if declaration is Declaration and declaration.mutable
  declaration.exported = true
  statement

# `extern symbol as name: (A) -> R`.
export parse_extern := (tokens: TokenStream) ->
  position := tokens.next().position()
  symbol := parse_identifier(tokens)
  has_name := tokens.accept_word('as')
  name := has_name then parse_identifier(tokens) else symbol
  tokens.expect ':'
  Extern(symbol, name, position, type: parse_type_name(tokens))

# `intrinsic name`, or `intrinsic name: Type`.
export parse_intrinsic := (tokens: TokenStream) ->
  position := tokens.next().position()
  name := parse_identifier(tokens)
  type := tokens.accept(':') then parse_type_name(tokens)
  Intrinsic(position, name, type)

at_reexport := (tokens: TokenStream) ->
  case tokens.peek().kind
    when STRING then true
    when NEWLINE then tokens.peek_at(1).kind == INDENT
    when IDENTIFIER then follows_exported_name(tokens.peek_at(1))
    else false

# Whether the token can follow the first of the names that `export` takes from a module, which
# tells them from a declaration such as `export type Name = ...`.
follows_exported_name := (token: Token) ->
  token.kind == ',' or token.is_word('as') or token.is_word('from')

parse_reexport := (tokens: TokenStream, position: Position) ->
  statement := parse_import_after(tokens, position)
  alias := statement.alias
  if alias != nil and statement.type == nil
    tokens.fail alias.position, 'a module is exported by its names, or alone, not as a name'
  statement.exported = true
  statement

export parse_import := (tokens: TokenStream) -> parse_import_after(tokens, tokens.next().position())

# What follows `import`, or `export` before a module's names.
parse_import_after := (tokens: TokenStream, position: Position) ->
  if tokens.peek().kind == STRING
    module := parse_module_name(tokens)
    unless tokens.accept_word('as')
      return Import(position, module, names: [])
    expect_name tokens, "a name after 'as'"
    alias := parse_identifier(tokens)
    type := tokens.accept(':') then parse_type_name(tokens)
    return Import(position, module, alias, type, names: [])
  ends_line := tokens.peek().kind == NEWLINE
  names := ends_line then parse_name_block(tokens) else parse_name_line(tokens)
  tokens.expect_word 'from'
  Import(names, position, module: parse_module_name(tokens))

# The names on the line, separated by commas; `from` follows the last one, which no comma does.
parse_name_line := (tokens: TokenStream) ->
  expect_name tokens, 'a name, end of line or module name'
  names := [parse_import_name(tokens)]
  while tokens.accept(',')
    expect_name tokens, "a name after ','"
    names.push parse_import_name(tokens)
  names

# `from` may be a name, unless the module follows it.
expect_name := (tokens: TokenStream, expected: String) ->
  at_module := tokens.at_word('from') and tokens.peek_at(1).kind == STRING
  at_name := tokens.peek().kind == IDENTIFIER and not at_module
  tokens.fail_expecting tokens.peek(), expected unless at_name

# The names on the indented lines below `import`; `from` follows on the line after them.
parse_name_block := (tokens: TokenStream) ->
  names: ImportName[]
  tokens.read_block_items -> names.push(parse_import_name(tokens))
  names

parse_module_name := (tokens: TokenStream) ->
  module := tokens.peek()
  tokens.fail_expecting module, 'module name' if module.kind != STRING
  tokens.next()
  module.text

parse_import_name := (tokens: TokenStream): ImportName ->
  name := parse_identifier(tokens)
  return { name } unless tokens.accept_word('as')
  expect_name tokens, "a name after 'as'"
  { name, alias: parse_identifier(tokens) }

# `class Name` or `struct Name`, or `class Name<T>` with type parameters, then `: Interface` for an
# interface it satisfies, and an indented block of members, one per line, which may be left out
# after an interface.
export parse_type_declaration := (tokens: TokenStream) ->
  token := tokens.next()
  name := parse_identifier(tokens)
  type_params := parse_type_parameters(tokens)
  satisfies := tokens.accept(':') then parse_named_type(tokens)
  has_body := satisfies == nil or tokens.peek_at(1).kind == INDENT
  is_empty := has_body and accept_pass_block(tokens) != nil
  { members, args_position } :=
    has_body and not is_empty then parse_type_body(tokens) else TypeBody([])
  is_struct := token.kind == 'struct'
  if is_struct and args_position
    tokens.fail args_position, "a struct has no 'args': its fields are its constructor's arguments"
  position := token.position()
  TypeDeclaration(name, type_params, members, is_struct, position, satisfies, args_position)

struct TypeBody
  members: MemberDeclaration[]
  args_position: Position?

# The members of a type, one per line, the first line `args` and an indented block of the
# constructor's arguments where it takes any.
parse_type_body := (tokens: TokenStream) ->
  members: MemberDeclaration[]
  var args_position: Position?
  tokens.expect NEWLINE, 'end of line'
  tokens.expect INDENT, 'indented members'
  if at_args_block(tokens)
    args_position = tokens.next().position()
    for member in parse_members(tokens)
      members.push { member..., in_args: true }
    tokens.expect_line_end()
  while tokens.peek().kind != DEDENT
    if at_args_block(tokens)
      tokens.fail tokens.peek().position(), "'args' must be the first line of the type's body"
    read_member_line tokens, members
    tokens.expect_line_end()
  tokens.next()
  TypeBody(members, args_position)

# `args` alone on its line, before an indented block: a field may be named `args` too.
at_args_block := (tokens: TokenStream) ->
  tokens.at_word('args') and tokens.peek_at(1).kind == NEWLINE and tokens.peek_at(2).kind == INDENT

# `interface Name`, or `interface Name<T>`, followed by an indented block of members, one per line,
# written as a class's; the checker tells which an interface can have, and whether it can have
# none, without the block.
export parse_interface := (tokens: TokenStream) ->
  position := tokens.next().position()
  name := parse_identifier(tokens)
  type_params := parse_type_parameters(tokens)
  has_members := tokens.peek_at(1).kind == INDENT
  InterfaceDeclaration(
    name
    type_params
    position
    members: has_members then parse_members(tokens) else []
  )

MAX_ENUM_MEMBERS := 1 << ENUM_BITS

# `enum Name` followed by an indented block of its members, one per line.
export parse_enum := (tokens: TokenStream) ->
  position := tokens.next().position()
  name := parse_identifier(tokens)
  has_members := tokens.peek().kind != NEWLINE or tokens.peek_at(1).kind == INDENT
  tokens.fail position, 'an enum needs at least one member' unless has_members
  members := tokens.parse_lines('indented members', -> parse_enum_member(tokens))
  message := "an enum has at most #{MAX_ENUM_MEMBERS} members"
  tokens.fail position, message if members.length > MAX_ENUM_MEMBERS
  EnumDeclaration(name, members, position)

# A name, or a string literal, whose text must be known without running the program.
parse_enum_member := (tokens: TokenStream): Identifier | StringLiteral ->
  token := tokens.peek()
  position := token.position()
  case token.kind
    when STRING
      tokens.next()
      StringLiteral(position, value: token.text)
    when INTERPOLATED then tokens.fail(position, 'an enum member cannot be interpolated')
    else parse_identifier(tokens)

# `extend Type`, or `extend<T> T[]` for a generic one, followed by an indented block of
# methods, one per line.
export parse_extend := (tokens: TokenStream) ->
  position := tokens.next().position()
  type_params := parse_type_parameters(tokens)
  type := parse_type_name(tokens)
  Extend(type_params, type, position, members: parse_members(tokens))

parse_members := (tokens: TokenStream) ->
  members: MemberDeclaration[]
  tokens.expect NEWLINE, 'end of line'
  tokens.expect INDENT, 'indented members'
  while tokens.peek().kind != DEDENT
    read_member_line tokens, members
    tokens.expect_line_end()
  tokens.next()
  members

# A member, or `private` and an indented block of members, each private.
read_member_line := (tokens: TokenStream, members: MemberDeclaration[]) ->
  unless at_private_block(tokens)
    members.push parse_member(tokens)
    return
  block := tokens.next().position()
  for member in tokens.parse_lines('indented members', -> parse_member(tokens))
    if member.private
      tokens.fail member.position, "a member in a 'private' block is private already"
    members.push { member..., private: true, private_block: block }

# `private` alone on its line, before an indented block: a field may be named `private` too.
at_private_block := (tokens: TokenStream) ->
  is_alone := tokens.peek_at(1).kind == NEWLINE and tokens.peek_at(2).kind == INDENT
  tokens.at_word('private') and is_alone

parse_member_modifier := (tokens: TokenStream) ->
  token := tokens.peek()
  next := tokens.peek_at(1)
  at_weak := tokens.at_word('weak')
  is_weak := at_weak and next.kind == IDENTIFIER
  is_weak_var := at_weak and next.kind == 'var'
  text :=
    case
      when is_weak then 'weak'
      when is_weak_var then 'weak var'
      else token.kind.to_string()
  modifier := parse<MemberModifier>(text)
  tokens.next() if modifier
  tokens.next() if is_weak_var
  modifier

# `[modifier] name: Type[ = value]`, `modifier name = value` or `name := value`, as a local is
# declared, the modifier `var`, `weak` or `weak var`. A weak field's type may be `Type!`, as a
# cast's is.
parse_member := (tokens: TokenStream) ->
  token := tokens.peek()
  private := at_private(tokens) and tokens.accept_word('private')
  modifier := parse_member_modifier(tokens)
  name := parse_identifier(tokens)
  type := parse_type_annotation(tokens)
  bang := tokens.peek()
  throws := type != nil and bang.kind == '!' and not bang.spaced
  tokens.next() if throws
  is_plain := modifier == nil and type == nil

  # It would read as an assignment, which a type body cannot hold.
  if is_plain and tokens.peek().kind == '='
    tokens.fail tokens.peek().position(), "write 'name := value' to declare a member"

  is_const := is_plain and tokens.accept(':=')
  has_value := is_const or type == nil or tokens.peek().kind in ['=', ':=']
  expected :=
    case
      when is_plain then "':' or ':='"
      when type == nil then "':' or '='"
      else "'='"
  tokens.expect '=', expected if has_value and not is_const
  value := has_value then parse_value(tokens)
  MemberDeclaration(name, modifier, type, value, throws, private, position: token.position())

# `private` marks a member when a name, `var` or `weak` follows it, as a field may be named
# `private` too.
at_private := (tokens: TokenStream) ->
  tokens.at_word('private') and tokens.peek_at(1).kind in [IDENTIFIER, 'var']
