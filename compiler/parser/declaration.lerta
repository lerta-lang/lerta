# Declarations other than `const` and `var`: type aliases, classes, structs, enums, extends,
# imports, externs and exports.
import {
  as_exportable, Declaration, EnumDeclaration, Extend, Extern, Identifier, Import, ImportName
  MemberDeclaration, MemberModifier, Statement, StringLiteral, TypeAlias, TypeDeclaration, TypeName
  TypeParameter
} from '../ast'
import { parse_type_parameters } from './compound'
import { parse_identifier, parse_value } from './expression'
import { at_destructuring, parse_destructuring_statement, parse_statement } from './statement'
import { token_position, TokenStream } from './token_stream'
import { parse_aliased_type, parse_type_name } from './type'

# `type Name = ...`; `type` is not a keyword, so that it stays usable as a name.
export const starts_type_alias = (tokens: TokenStream) ->
  const name_follows = tokens.peek_at(1).kind == IDENTIFIER
  tokens.at_word('type') and name_follows and tokens.peek_at(2).kind == '='

export const parse_type_alias = (tokens: TokenStream) ->
  const position = token_position(tokens.next())
  const name = parse_identifier(tokens)
  tokens.expect '=', "'='"
  TypeAlias name, position, type: parse_aliased_type(tokens)

# `export` before a `const` (a function or a value) or a type; the checker tells whether it is at
# the top level.
export const parse_export = (tokens: TokenStream): Statement ->
  const token = tokens.next()
  const fail = () ->
    const exportable = 'a const, a class, a struct, an enum, a type alias or an extern'
    tokens.fail token_position(token), "only #{exportable} can be exported"
  if at_destructuring(tokens)
    parse_destructuring_statement tokens
    fail()
  const statement = parse_statement(tokens)
  const declaration = as_exportable(statement) ? fail()
  fail() if declaration is Declaration and declaration.mutable
  declaration.exported = true
  statement

# `extern symbol as name: (A) -> R`.
export const parse_extern = (tokens: TokenStream) ->
  const position = token_position(tokens.next())
  const symbol = parse_identifier(tokens)
  const has_name = tokens.at_word('as')
  tokens.next() if has_name
  const name = has_name then parse_identifier(tokens) else symbol
  tokens.expect ':', "':'"
  Extern symbol, name, position, type: parse_type_name(tokens)

# `import { a, b } from 'module'`, or `import 'module'` for its effects alone. `from` is not a
# keyword, so that it stays usable as a name.
export const parse_import = (tokens: TokenStream) ->
  const position = token_position(tokens.next())
  if tokens.peek().kind == STRING
    return Import(position, names: [], module: parse_module_name(tokens))
  tokens.expect '{', "'{' or module name"
  const first = tokens.peek()
  const names = tokens.parse_list('}', () -> parse_import_name(tokens))
  tokens.fail_expecting first, 'a name to import' if names.length == 0
  tokens.fail_expecting tokens.peek(), "'from'" if not tokens.at_word('from')
  tokens.next()
  Import names, position, module: parse_module_name(tokens)

const parse_module_name = (tokens: TokenStream) ->
  const module = tokens.peek()
  tokens.fail_expecting module, 'module name' if module.kind != STRING
  tokens.next()
  module.text

# `name` or `name as alias`. `as` is not a keyword, so that it stays usable as a name.
const parse_import_name = (tokens: TokenStream) ->
  const name = parse_identifier(tokens)
  return ImportName(name) if not tokens.at_word('as')
  tokens.next()
  ImportName name, alias: parse_identifier(tokens)

# `class Name` or `struct Name` followed by an indented block of members, one per line.
export const parse_type_declaration = (tokens: TokenStream) ->
  const token = tokens.next()
  const name = parse_identifier(tokens)
  const members = parse_members(tokens)
  TypeDeclaration name, members, is_struct: token.kind == 'struct', position: token_position(token)

# `enum Name` followed by an indented block of its members, one per line.
export const parse_enum = (tokens: TokenStream) ->
  const position = token_position(tokens.next())
  const name = parse_identifier(tokens)
  const has_members = tokens.peek().kind != NEWLINE or tokens.peek_at(1).kind == INDENT
  tokens.fail position, 'an enum needs at least one member' if not has_members
  const members = parse_member_lines(tokens, () -> parse_enum_member(tokens))
  EnumDeclaration name, members, position

# A name, or a string literal, whose text must be known without running the program.
const parse_enum_member = (tokens: TokenStream): Identifier | StringLiteral ->
  const token = tokens.peek()
  const position = token_position(token)
  case token.kind
    when STRING
      tokens.next()
      StringLiteral position, value: token.text
    when INTERPOLATED then tokens.fail(position, 'an enum member cannot be interpolated')
    else parse_identifier(tokens)

# `extend Type`, or `extend<T> Array<T>` for a generic one, followed by an indented block of
# methods, one per line.
export const parse_extend = (tokens: TokenStream) ->
  const position = token_position(tokens.next())
  const is_generic = tokens.peek().kind == '<'
  const type_params: Array<TypeParameter> = is_generic then parse_type_parameters(tokens) else []
  const type = parse_type_name(tokens)
  Extend type_params, type, position, members: parse_members(tokens)

const parse_members = (tokens: TokenStream) ->
  parse_member_lines tokens, () -> parse_member(tokens)

# A newline and an indented block of members, one per line.
const parse_member_lines = <T>(tokens: TokenStream, parse_line: () -> T) ->
  tokens.expect NEWLINE, 'end of line'
  tokens.expect INDENT, 'indented members'
  const members: Array<T> = []
  while tokens.peek().kind != DEDENT
    members.push parse_line()
    tokens.expect_line_end()
  tokens.next()
  members

# `[const | var] name[: Type][ = value]`, with a type, a value or both.
const parse_member = (tokens: TokenStream) ->
  const token = tokens.peek()
  const modifier = MemberModifier.parse(token.kind.to_string())
  tokens.next() if modifier
  const name = parse_identifier(tokens)
  const type: TypeName? = tokens.accept(':') then parse_type_name(tokens) else nil
  const has_value = type == nil or tokens.peek().kind == '='
  tokens.expect '=', type == nil then "':' or '='" else "'='" if has_value
  const value = has_value then parse_value(tokens) else nil
  MemberDeclaration name, modifier, type, value, position: token_position(token)
