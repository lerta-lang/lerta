# A cursor over the tokens, shared by the modules of the parser.
import compile_error from '../errors'
import Position from '../ast'
import Token, TokenKind from '../lexer/tokens'

# How line breaks are read inside the brackets being parsed: as separators of a list's items, or
# skipped, as in a grouping.
export enum LineBreaks
  SEPARATE
  SKIP

# Whether a function literal has a `yield` of its own, outside the literals in it, and where its
# first `await` is.
export class FunctionMarks
  yields = false
  await_at: Position? = nil

export class TokenStream
  tokens: Token[]
  # Names the source in diagnostics.
  path: String
  # Where the interpolated code that the tokens are made of starts, if they are; a function literal
  # cannot be written there (see parse_function_literal).
  interpolation: Position?
  index = 0
  # Where the last `xs...` after a value is, which no array item may have taken (see at_spread).
  spread: Position? = nil
  # How line breaks are read inside each of the brackets being parsed; outside brackets there are
  # none.
  line_breaks: LineBreaks[] = []
  # What each function literal being parsed, innermost last, has of its own.
  functions: FunctionMarks[] = []

  # The kind of the next token if it continues the current expression. After an indented block
  # (such as a `case`) the line has ended, so `-1` on the next line is not a subtraction.
  peek_continuation = (): TokenKind -> @ended_with_block() then NEWLINE else @peek().kind

  # As at_word, but a word after a line that ends with a block does not continue the expression.
  continues_with_word = (word: String) -> not @ended_with_block() and @at_word(word)

  ended_with_block = -> @index > 0 and @tokens[@index - 1].kind == DEDENT

  # A line that ends with an indented block (such as a `case`) has already consumed its line end.
  expect_line_end = -> @expect(NEWLINE, 'end of line') if not @ended_with_block()

  peek = -> @peek_at(0)

  peek_at = (offset: Int) -> @tokens[@index_at(offset)]

  next = ->
    const index = @index_at(0)
    const token = @tokens[index]
    @index = index + 1 if token.kind != EOF
    token

  # The index of the token `offset` tokens ahead, past the line breaks that are skipped.
  index_at = (offset: Int) ->
    const last = @tokens.length - 1
    var index = @index
    var remaining = offset
    while index < last and (remaining > 0 or @is_skipped(index))
      remaining -= 1 if not @is_skipped(index)
      index += 1
    index

  is_skipped = (index: Int) ->
    const skips = @line_breaks.last() != SEPARATE
    skips and @tokens[index].kind == LINE_BREAK

  # Whether the next token is the identifier `word`, which is not a keyword, so that it stays
  # usable as a name.
  at_word = (word: String) ->
    const token = @peek()
    token.kind == IDENTIFIER and token.text == word

  accept_word = (word: String) ->
    return false if not @at_word(word)
    @next()
    true

  expect_word = (word: String) -> @fail_expecting(@peek(), "'#{word}'") if not @accept_word(word)

  accept = (kind: TokenKind) ->
    return false if @peek().kind != kind
    @next()
    true

  expect = (kind: TokenKind, description: String) ->
    @fail_expecting @peek(), description if not @accept(kind)

  fail_expecting = (token: Token, expected: String) ->
    const at = token_position(token)
    @fail at, 'a spread `xs...` can only be an item of an array' if at == @spread
    @fail at, "expected #{expected}, found #{describe_token(token)}"

  in_brackets = -> @line_breaks.length > 0

  # Runs `parse` on the contents of brackets, whose line breaks it reads as `mode` says. A compile
  # error ends the statement, after which skip_to_next_statement leaves the brackets, so the mode
  # needs no restoring on one.
  inside = <T>(mode: LineBreaks, parse: () -> T): T ->
    @line_breaks.push mode
    const result = parse()
    @line_breaks.pop()
    result

  # Items separated by `separator`, at least one.
  parse_separated = <T>(separator: TokenKind, parse_item: () -> T): T[] ->
    const items = [parse_item()]
    items.push parse_item() while @accept(separator)
    items

  # A newline and an indented block of lines, each of which `parse_line` parses.
  parse_lines = <T>(description: String, parse_line: () -> T): T[] ->
    @expect NEWLINE, 'end of line'
    @expect INDENT, description
    const lines: T[] = []
    while @peek().kind != DEDENT
      lines.push parse_line()
      @expect_line_end()
    @next()
    lines

  # The offset of the token that closes the next one, an `open`, past the pairs nested in it; nil
  # if a token that `allowed` rejects comes first.
  closing_offset = (open: TokenKind, close: TokenKind, allowed: (TokenKind) -> Bool) ->
    var depth = 0
    var offset = 0
    while allowed(@peek_at(offset).kind)
      const kind = @peek_at(offset).kind
      depth += 1 if kind == open
      depth -= 1 if kind == close
      return offset if depth == 0
      offset += 1
    nil

  # The items of a list after its opening bracket, through `close`. Items are separated by a
  # comma, by a line end, or by both, a comma ending a line.
  parse_list = <T>(close: TokenKind, parse_item: () -> T): T[] ->
    const parse_items = ->
      @accept LINE_BREAK
      @parse_list_rest close, parse_item, []
    @inside SEPARATE, parse_items

  # The rest of a list whose first items are `items`, through `close`.
  parse_list_rest = <T>(close: TokenKind, parse_item: () -> T, items: T[]): T[] ->
    return items if items.length > 0 and not @ends_item(close)
    while not @accept(close)
      items.push parse_item()
      break if not @ends_item(close)
    items

  # Reads the items of an indented block on the next lines, through its end, with `read_item`.
  # Items are separated as in a list, with a line end, a comma, or both.
  read_block_items = (read_item: () -> void) ->
    @expect NEWLINE, 'end of line'
    @expect INDENT, 'indented block'
    while @peek().kind != DEDENT
      read_item()
      read_item() while @accept_block_comma()
      @expect_line_end()
    @next()

  # Whether a comma follows, consumed with the line end after it; an item must follow at the same
  # indentation.
  accept_block_comma = ->
    return false if not @accept(',')
    @accept NEWLINE
    const next = @peek()
    const changes_indentation = next.kind == DEDENT or next.kind == INDENT
    @fail_expecting next, "an item after ','" if changes_indentation
    true

  # After an item: whether a separator, which is consumed, follows it; otherwise the closing
  # bracket must, and is consumed.
  ends_item = (close: TokenKind) ->
    if @accept(',')
      @accept LINE_BREAK
      const next = @peek()
      @fail_expecting next, "an item after ','" if next.kind == close
      return true
    return true if @accept(LINE_BREAK)
    @expect close, "'#{close}'"
    false

  # The body that `parse` reads is a function literal's: the result, and what it has of its own.
  in_function = <T>(parse: () -> T) ->
    const marks = FunctionMarks()
    @functions.push marks
    const body = parse()
    @functions.pop()
    { body, marks }

  # A `yield` or `await` outside every function literal marks none; the checker rejects it.
  innermost_function = -> @functions.last()

  fail = (position: Position, message: String) ->
    compile_error @path, position.line, position.column, message

  # Skips the rest of the top-level statement that an error was found in, in whatever brackets and
  # blocks it was found, up to the next top-level line that does not continue the statement as
  # `else`, `catch` and `finally` do. The statement started at `start`; it is skipped past at least
  # one token, so that parsing goes on.
  skip_to_next_statement = (start: Int) ->
    @line_breaks = []
    @functions = []
    @spread = nil
    var depth = 0
    depth += indentation_change(@tokens[i].kind) for i in start...@index
    # The error may be at the first token of the next statement, after the line that ends this one.
    return if @index > start and @ends_statement(@tokens[@index - 1].kind, depth)
    while @tokens[@index].kind != EOF
      const kind = @tokens[@index].kind
      @index += 1
      depth += indentation_change(kind)
      return if @ends_statement(kind, depth)

  # Whether the token of `kind`, just read at the indentation `depth`, ends the top-level statement:
  # the next token starts another.
  ends_statement = (kind: TokenKind, depth: Int) ->
    const ends_line = kind == NEWLINE or kind == DEDENT
    const continues = is_one_of(@tokens[@index].kind, [INDENT, 'else', 'catch', 'finally'])
    depth == 0 and ends_line and not continues

const indentation_change = (kind: TokenKind) ->
  case kind
    when INDENT then 1
    when DEDENT then -1
    else 0

export const token_position = (token: Token) -> Position(line: token.line, column: token.column)

export const is_one_of = (kind: TokenKind, kinds: TokenKind[]) -> kinds.contains(kind)

const describe_token = (token: Token) ->
  case token.kind
    when INTEGER then 'integer literal'
    when FLOAT then 'float literal'
    when STRING, INTERPOLATED then 'string literal'
    when NEWLINE then 'end of line'
    when LINE_BREAK then 'end of line inside brackets'
    when INDENT then 'indentation'
    when DEDENT then 'end of block'
    when EOF then 'end of file'
    else "'#{token.text}'"
