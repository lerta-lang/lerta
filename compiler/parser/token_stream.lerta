# A cursor over the tokens, shared by the modules of the parser.
import compile_error, Located from '../errors'
import Position from '../ast'
import Token, TokenKind from '../lexer/tokens'

# Whether a function literal has a `yield` of its own, outside the literals in it, and where its
# first `await` is.
export class FunctionMarks
  var yields = false
  var await_at: Position? = nil

# Where a statement starts, and the state of the stream there, to which skip_to_next_statement
# brings it back.
export struct StreamMark
  index: Int
  spread: Position?
  brackets: Int
  functions: Int
  # What the innermost function literal had of its own, which the statement may have marked.
  yields: Bool
  await_at: Position?
  nesting: Int

export class TokenStream
  tokens: Token[]
  # Names the source in diagnostics.
  path: String
  # Where the interpolated code that the tokens are made of starts, if they are; a function literal
  # cannot be written there (see parse_function_literal).
  interpolation: Position?
  var index = 0
  # Where the last `xs...` after a value is, which no array item may have taken (see at_spread).
  var spread: Position? = nil
  # The opening brackets that the expression being parsed is in, innermost last.
  brackets: Token[] = []
  # The tokens that continue_line has skipped: the line ends, indentations and block ends around the
  # lines that continue a line.
  skipped := Set<Int>()
  # The index of the INDENT of each block of lines that continue a line.
  continued_blocks := Set<Int>()
  # What find_block_starts found, once it has.
  var block_starts: Int[]? = nil
  # What each function literal being parsed, innermost last, has of its own.
  var functions: FunctionMarks[] = []
  # How deep the expression being parsed is in the tree it makes, which is limited (see deepen).
  var nesting = 0
  # Where the errors of the statements of blocks go, if an error ends the parsing of its statement
  # alone in a block too, as at the top level (see parse_partially); nil if it ends that of the
  # top-level statement.
  var block_errors: Located[]? = nil

  # The kind of the next token if it continues the current expression. After an indented block
  # (such as a `case`) the line has ended, so `-1` on the next line is not a subtraction.
  peek_continuation := (): TokenKind -> @ended_with_block() then NEWLINE else @peek().kind

  # As at_word, but a word after a line that ends with a block does not continue the expression.
  continues_with_word := (word: String) -> not @ended_with_block() and @at_word(word)

  ended_with_block := -> @index > 0 and @tokens[@index - 1].kind == DEDENT

  # A line that ends with an indented block (such as a `case`) has already consumed its line end.
  expect_line_end := -> @expect(NEWLINE, 'end of line') unless @ended_with_block()

  peek := -> @peek_at(0)

  peek_at := (offset: Int) -> @tokens[@index_at(offset)]

  next := ->
    index := @index_at(0)
    token := @tokens[index]
    @index = index + 1 if token.kind != EOF
    token

  # The index of the token `offset` tokens ahead, past the tokens that are skipped.
  index_at := (offset: Int) ->
    var index = @unskipped_from(@index)
    index = @index_after(index) for _ in 0..offset
    index

  # The index of the token after the one at `index`, past the tokens that are skipped; none follows
  # the end of the file, the last token.
  index_after := (index: Int) ->
    index == @tokens.length - 1 then index else @unskipped_from(index + 1)

  # The index of the first token from `index` on that is not skipped.
  unskipped_from := (index: Int) ->
    last := @tokens.length - 1
    var unskipped = index
    unskipped += 1 while unskipped < last and unskipped in @skipped
    unskipped

  # Where an operand or an item starts, a line end continues the line: one before a line indented
  # deeper is skipped, with the indentation and the end of that block, whose lines continue the
  # line; one inside such a block, before its next line, is skipped too.
  continue_line := ->
    return if @peek().kind != NEWLINE
    line_end := @index_at(0)
    indent := line_end + 1
    if @tokens[indent].kind == INDENT
      @skipped.add index for index in [line_end, indent, @block_end(indent)]
      @continued_blocks.add indent
    else if @continues_block(line_end)
      @index = indent

  # Whether the line end at `line_end` is inside a block of lines that continue a line, and the
  # line after it is too, which it continues then, though it may leave a block inside that one.
  continues_block := (line_end: Int) ->
    var next_line = line_end + 1
    next_line += 1 while @tokens[next_line].kind == DEDENT
    @in_continued_block(line_end) and @in_continued_block(next_line)

  in_continued_block := (index: Int) ->
    start := @block_start(index) ? return false
    start in @continued_blocks

  # The index of the DEDENT that ends the block that the INDENT at `start` starts.
  block_end := (start: Int) ->
    var depth = 1
    var index = start
    while depth > 0
      index += 1
      depth += indentation_change(@tokens[index].kind)
    index

  # The index of the INDENT that starts the innermost block around the token at `index`, if any.
  block_start := (index: Int) ->
    starts := @block_starts ? @find_block_starts()
    start := starts[index]
    start >= 0 then start

  # The block_start of each token, -1 for none, found once, as each line end inside brackets asks.
  find_block_starts := ->
    starts: Int[]
    open: Int[]
    for token at index in @tokens
      starts.push open.last() ? -1
      open.pop() if token.kind == DEDENT
      open.push index if token.kind == INDENT
    @block_starts = starts
    starts

  # Inside brackets, skips a line end before `word`, a keyword or a name, whose line continues the
  # one before it, as the `for` and the `when` of a comprehension do, and returns whether it skipped
  # one.
  continue_line_before := (word: String) ->
    return false if not @in_brackets() or @peek().kind != NEWLINE
    deeper := @peek_at(1).kind == INDENT
    return false if @peek_at(deeper then 2 else 1).text != word
    if deeper
      @continue_line()
    else
      @next()
    true

  at_word := (word: String) -> @peek().is_word(word)

  accept_word := (word: String) ->
    return false unless @at_word(word)
    @next()
    true

  expect_word := (word: String) -> @fail_expecting(@peek(), "'#{word}'") unless @accept_word(word)

  accept := (kind: TokenKind) ->
    return false if @peek().kind != kind
    @next()
    true

  expect := (kind: TokenKind, description: String = "'#{kind}'") ->
    @fail_expecting @peek(), description unless @accept(kind)

  # Where only the ends of blocks are left, an open bracket is never closed.
  fail_expecting := (token: Token, expected: String) ->
    is_layout := token.kind in [NEWLINE, DEDENT, EOF]
    if open := @brackets.last()
      @fail open.position(), "'#{open.kind}' is never closed" if is_layout and @at_file_end()
    at := token.position()
    if at == @spread
      @fail
        at
        'a spread `xs...` can only be an item of an array or an argument of a variadic parameter'
    # The token is the next one, or the one just read, as by parse_primary.
    index := [@index_at(0), @index - 1].find((i) -> i >= 0 and @tokens[i] == token)
    hint := index != nil then @foreign_hint(index)
    instead := hint then ": #{hint}" else ''
    @fail at, "expected #{expected}, found #{describe_token(token)}#{instead}"

  # What to write for the token at the index where it starts a form of another language, which Lerta
  # spells otherwise, as `&&` for `and`.
  foreign_hint := (index: Int) ->
    previous := index > 0 then @tokens[index - 1].kind
    case @tokens[index].kind
      when '&' then previous == '&' then 'write `and` for `&&`'
      when '|' then previous == '|' then 'write `or` for `||`'
      # Not that of a value, `x !` or `?!`, which no name follows at once.
      when '!' then not @tokens[index + 1].spaced then 'write `not x` for `!x`'
      when '?' then previous == '?' then 'write `x ? default` for `x ?? default`'
      when ':' then @line_has_coalesce(index) then 'write `c then a else b` for `c ? a : b`'
      when '='
        is_let := @tokens[@line_start(index)].is_word('let')
        is_let then 'write `x := value` for `let x = value`, or `var x = value` to assign it again'
      else nil

  # The index of the first token of the line of the token at the index.
  line_start := (index: Int) ->
    var start = index
    start -= 1 while start > 0 and @tokens[start - 1].kind not in [NEWLINE, INDENT, DEDENT]
    start

  # Whether a `?` of a value, `x ? d`, comes before the index on its line: spaced, unlike that of
  # an optional type, `Int?`.
  line_has_coalesce := (index: Int) ->
    for i in @line_start(index)..index
      token := @tokens[i]
      return true if token.kind == '?' and token.spaced
    false

  at_file_end := ->
    var index = @index_at(0)
    index += 1 while @tokens[index].kind == NEWLINE or @tokens[index].kind == DEDENT
    @tokens[index].kind == EOF

  in_brackets := -> not @brackets.is_empty()

  # Runs `parse` on the contents of the brackets that the token before opens, from a line end after
  # it, which continues the line. A compile error ends the statement, after which
  # skip_to_next_statement restores the brackets, so they need no restoring on one.
  inside := <T>(parse: () -> T): T ->
    @brackets.push @tokens[@index - 1]
    @continue_line()
    result := parse()
    @brackets.pop()
    result

  # The closing bracket `close`, which may start the line after the contents.
  expect_close := (close: TokenKind) ->
    if @peek().kind == NEWLINE
      if @peek_at(1).kind == close
        @next()
      else
        @fail_unless_continued()
    @expect close

  # A line end inside brackets that no block of continued lines holds leaves them unclosed, as the
  # next line is not deeper than the one that opened them.
  fail_unless_continued := ->
    return if @continues_block(@index_at(0))
    open := @brackets.last()!
    @fail open.position(), "'#{open.kind}' is never closed"

  # Items separated by `separator`, at least one.
  parse_separated := <T>(separator: TokenKind, parse_item: () -> T): T[] ->
    items := [parse_item()]
    items.push parse_item() while @accept(separator)
    items

  # A newline and an indented block of lines, each of which `parse_line` parses.
  parse_lines := <T>(description: String, parse_line: () -> T): T[] ->
    @expect NEWLINE, 'end of line'
    @expect INDENT, description
    lines: T[]
    while @peek().kind != DEDENT
      lines.push parse_line()
      @expect_line_end()
    @next()
    lines

  # The offset of the token that closes the one at `start`, an `open`, past the pairs nested in it;
  # nil if a token that `allowed` rejects comes first.
  closing_offset := (open: TokenKind, close: TokenKind, allowed: (TokenKind) -> Bool, start = 0) ->
    var depth = 0
    var offset = start
    var index = @index_at(start)
    while allowed(@tokens[index].kind)
      kind := @tokens[index].kind
      depth += 1 if kind == open
      depth -= 1 if kind == close
      return offset if depth == 0
      offset += 1
      index = @index_after(index)
    nil

  # The items of a list after its opening bracket, through `close`. Items are separated by a
  # comma, by a line end, or by both, a comma ending a line.
  parse_list := <T>(close: TokenKind, parse_item: () -> T): T[] ->
    @inside -> @parse_list_rest(close, parse_item, [])

  # The rest of a list whose first items are `items`, through `close`.
  parse_list_rest := <T>(close: TokenKind, parse_item: () -> T, items: T[]): T[] ->
    return items if not items.is_empty() and not @ends_item(close)
    until @accept(close)
      items.push parse_item()
      break unless @ends_item(close)
    items

  # Reads the items of an indented block on the next lines, through its end, with `read_item`.
  # Items are separated as in a list, with a line end, a comma, or both.
  read_block_items := (read_item: () -> void) ->
    @expect NEWLINE, 'end of line'
    @expect INDENT, 'indented block'
    while @peek().kind != DEDENT
      read_item()
      read_item() while @accept_block_comma()
      @expect_line_end()
    @next()

  # Whether a comma follows, consumed with the line end after it; an item must follow at the same
  # indentation.
  accept_block_comma := ->
    return false unless @accept(',')
    @accept NEWLINE
    next := @peek()
    changes_indentation := next.kind in [DEDENT, INDENT]
    @fail_expecting next, "an item after ','" if changes_indentation
    true

  # After an item: whether a separator, which is consumed, follows it; otherwise the closing
  # bracket must, and is consumed. An item that ends with a block, a function's body, has ended its
  # line.
  ends_item := (close: TokenKind) ->
    if @accept(',')
      @continue_line()
      # A closing bracket after the block reports the comma before it.
      @next() if @peek().kind == NEWLINE and @peek_at(1).kind == close
      next := @peek()
      @fail_expecting next, "an item after ','" if next.kind == close
      return true
    if @peek().kind == NEWLINE and @peek_at(1).kind != close
      @fail_unless_continued()
      @next()
      return true
    return true if @ended_with_block() and @peek().kind != close
    @expect_close close
    false

  # The body that `parse` reads is a function literal's: the result, and what it has of its own.
  in_function := <T>(parse: () -> T) ->
    marks := FunctionMarks()
    @functions.push marks
    body := parse()
    @functions.pop()
    { body, marks }

  # A `yield` or `await` outside every function literal marks none; the checker rejects it.
  innermost_function := -> @functions.last()

  # Runs `parse`, which reads a part of an expression, one level deeper (see deepen).
  nested := <T>(parse: () -> T): T ->
    @deepen()
    part := parse()
    @nesting -= 1
    part

  # Goes one level deeper, as a loop does for each part it adds to an expression, which it then
  # gives back by restoring `nesting`; the tree's depth is limited, as the passes after the parser
  # walk it by recursion, which would overflow the stack.
  deepen := ->
    @nesting += 1
    @fail_here "nesting deeper than #{MAX_NESTING}" if @nesting > MAX_NESTING

  fail := (position: Position, message: String) ->
    compile_error @path, position.line, position.column, message

  fail_here := (message: String) -> @fail(@peek().position(), message)

  mark := ->
    StreamMark
      index: @index
      spread: @spread
      brackets: @brackets.length
      functions: @functions.length
      yields: @functions.last()?.yields ? false
      await_at: @functions.last()?.await_at
      nesting: @nesting

  # Skips the rest of the statement that an error was found in, in whatever brackets and blocks it
  # was found, up to the next line at its indentation that does not continue it as `else`, `catch`
  # and `finally` do, or the end of the block it is in. The statement started at `start`; it is
  # skipped past at least one token, so that parsing goes on.
  skip_to_next_statement := (start: StreamMark) ->
    @spread = start.spread
    @brackets.truncate start.brackets
    @functions.truncate start.functions
    if marks := @functions.last()
      marks.yields = start.yields
      marks.await_at = start.await_at
    @nesting = start.nesting
    depth := StatementDepth()
    depth.add @tokens[i].kind for i in start.index..@index
    # The error may be at the first token of the next statement, after the line that ends this one.
    return if @index > start.index and @ends_statement(@tokens[@index - 1].kind, depth)
    while @tokens[@index].kind != EOF
      kind := @tokens[@index].kind
      return if kind == DEDENT and depth.blocks == 0 and @index > start.index
      @index += 1
      depth.add kind
      return if @ends_statement(kind, depth)

  # Whether the token of `kind`, just read at `depth` from the statement's, ends the statement: the
  # next token starts another. A line end outside the blocks ends it inside brackets too, which are
  # then never closed; the end of a block inside brackets does not, as the closing bracket comes
  # after it.
  ends_statement := (kind: TokenKind, depth: StatementDepth) ->
    ends_line := kind == NEWLINE or (kind == DEDENT and depth.brackets == 0)
    continues := @tokens[@index].kind in [INDENT, 'else', 'catch', 'finally']
    depth.blocks == 0 and ends_line and not continues

# How deep skip_to_next_statement is in the blocks and the brackets of the statement that it skips.
# An extra closing bracket closes none.
class StatementDepth
  var blocks = 0
  var brackets = 0

  add := (kind: TokenKind) ->
    @blocks += indentation_change(kind)
    case kind
      when '(', '[', '{' then @brackets += 1
      when ')', ']', '}' then @brackets = max(@brackets - 1, 0)
      else pass

MAX_NESTING := 500

indentation_change := (kind: TokenKind) ->
  case kind
    when INDENT then 1
    when DEDENT then -1
    else 0

describe_token := (token: Token) ->
  case token.kind
    when INTEGER then 'integer literal'
    when FLOAT then 'float literal'
    when STRING, INTERPOLATED then 'string literal'
    when BINARY then 'binary literal'
    # A `;` stands for a line end (see LineScanner.run).
    when NEWLINE then token.text.is_empty() then 'end of line' else "';'"
    when INDENT then 'indentation'
    when DEDENT then 'end of block'
    when EOF then 'end of file'
    else "'#{token.text}'"
