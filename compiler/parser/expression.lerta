# Expressions, from the weakest operators down to primaries, which `primary` reads, as `compound`
# reads compound expressions.
import
  Await, BinaryOperation, Binding, Call, Cast, Conditional, Coalesce, copy_identifier, Declaration,
  Expression, FloatLiteral, Identifier, If, Index, IsTest, Member, NamedValue, NilLiteral, Position,
  Range, Statement, TupleItem, TypeName, UnaryOperation, Unwrap
from '../ast'
import TokenKind from '../lexer/tokens'
import at_block, parse_block_literal, starts_member from './block_literal'
import integer_literal, parse_primary from './primary'
import parse_element, spread_of from './compound'
import TokenStream from './token_stream'
import at_type_arguments, parse_cast_type, parse_tested_type, parse_type_arguments from './type'

# Arithmetic and bitwise operators by precedence, weakest first. Comparisons are weaker than all of
# them. `<<` and `>>` bind as `*` does, each two tokens (see shift_at). `**` binds more tightly
# still (see parse_power).
ARITHMETIC_PRECEDENCE: TokenKind[][] = [['+', '-', '|', '^'], ['*', '/', '%', '&']]

POSTFIX_OPERATORS: TokenKind[] = ['(', '[', '.', '!']

COMPARISON_OPERATORS: TokenKind[] = ['==', '!=', '<', '<=', '>', '>=']

# Not keywords, but `x is T` is a test, `x as T?` a cast and `x in xs` and `x not in xs` tests.
export COMPARISON_WORDS := ['is', 'as', 'in']

export struct Arguments
  args: Expression[]
  named_args: NamedValue[]

# `for x in xs`, or `for x at i in xs` with the item's place, with `when guard` after it if there is
# one. `for (a, b) in xs` takes the item, a tuple, apart into `parts`, which the loop declares
# from `variable` (see take_apart).
export struct LoopHeader
  variable: Identifier
  index: Identifier?
  iterable: Expression
  guard: Expression?
  parts: Identifier[]

export parse_expression := (tokens: TokenStream) -> tokens.nested(-> parse_conditional(tokens))

# A value that may take lines: a block literal or an expression.
export parse_value := (tokens: TokenStream): Expression ->
  value := at_block(tokens) then parse_block_literal(tokens) else parse_call_value(tokens)
  continue_with_members(tokens, value)

# An expression, which is a call when it is a callee followed by its arguments in an indented block;
# the operand of `return`, `throw` or `yield` is one too.
export parse_call_value := (tokens: TokenStream): Expression ->
  expression := parse_expression(tokens)
  return expression unless at_block_arguments(tokens, expression)
  parse_block_arguments(tokens, expression)

# The value of `return`, `throw` or `yield`, or an argument in a block, which takes the member
# lines after it, as a value does, rather than leaving them to the statement.
export parse_continued_value := (tokens: TokenStream) ->
  continue_with_members(tokens, parse_call_value(tokens))

# The value with the members that the lines after it take, those that start with `.` or `?.`, so
# that a member applies to the whole value, however many lines it took: lines one level deeper than
# its first, or at its indentation, as after a value that ends with a block, which the deeper lines
# would be part of.
export continue_with_members := (tokens: TokenStream, value: Expression) ->
  nesting := tokens.nesting
  var continued = value
  if at_member_block(tokens)
    continued = parse_member_block(tokens, continued)
  while at_member_line(tokens)
    tokens.deepen()
    tokens.accept NEWLINE
    continued = parse_member_line(tokens, continued)
  tokens.nesting = nesting
  continued

# An indented block of member lines after a value that does not end with a block.
at_member_block := (tokens: TokenStream) ->
  is_block := tokens.peek().kind == NEWLINE and tokens.peek_at(1).kind == INDENT
  is_block and not tokens.ended_with_block() and starts_member(tokens, 2)

# Its lines, and its end, after which the statement ends as after any block.
parse_member_block := (tokens: TokenStream, value: Expression) ->
  tokens.next()
  tokens.next()
  var continued = value
  while true
    tokens.deepen()
    continued = parse_member_line(tokens, continued)
    break if tokens.peek().kind != NEWLINE or not starts_member(tokens, 1)
    tokens.next()
  tokens.expect NEWLINE, 'end of line'
  tokens.expect DEDENT, 'the end of the member lines'
  continued

# After a block, its NEWLINE is consumed already, so the line's first token is next; otherwise it
# follows the NEWLINE. A line at another indentation starts with an INDENT or a DEDENT instead.
at_member_line := (tokens: TokenStream) ->
  after_block := tokens.ended_with_block()
  at_line_end := tokens.peek().kind == NEWLINE
  line_start := after_block then 0 else 1
  (after_block or at_line_end) and starts_member(tokens, line_start)

# A line's `.` or `?.` follows the space of its indentation, which parse_postfix would not take.
parse_member_line := (tokens: TokenStream, object: Expression): Expression ->
  return parse_nil_safe(tokens, object) if tokens.peek().kind == '?'
  tokens.next()
  position := object.position
  parse_postfix(tokens, Member(position, object, name: parse_identifier(tokens)))

# `f`, `f x` or `f(x)`, followed by an indented block of the arguments after those on the line.
export parse_block_arguments := (tokens: TokenStream, callee: Expression) ->
  no_arguments := Arguments(args: [], named_args: [])
  call :=
    if callee is Call
      callee
    else
      call_of callee, no_arguments, []
  items: Argument[]
  tokens.read_block_items -> items.push(parse_block_argument(tokens))
  { args, named_args } := to_arguments(tokens, items)
  if not call.named_args.is_empty() and not named_args.is_empty()
    message := 'named arguments are all on the line or all in the indented block'
    tokens.fail named_args[0].name.position, message
  if not call.named_args.is_empty() and not args.is_empty()
    tokens.fail args[0].position, POSITIONAL_AFTER_NAMED
  call.args.push arg for arg in args
  call.named_args.push named for named in named_args
  call

# An argument as on the line, but a positional one may take its own block of arguments and the
# member lines after it, as a named one's value may; a key, as of a map's entry, is not taken for a
# name.
parse_block_argument := (tokens: TokenStream) ->
  return parse_argument(tokens) if at_named_argument(tokens)
  value := spread_of(tokens, parse_continued_value(tokens))
  message := 'an argument is named by a name, not by a key'
  tokens.fail value.position, message if tokens.peek().kind == ':'
  Argument(value)

export at_block_arguments := (tokens: TokenStream, expression: Expression) ->
  is_callee := expression is Call | Identifier | Member
  is_callee and at_block(tokens)

export call_of := (callee: Expression, arguments: Arguments, type_args: TypeName[]) ->
  { args, named_args } := arguments
  Call(callee, args, named_args, type_args, position: callee.position)

parse_conditional := (tokens: TokenStream): Expression ->
  condition := parse_or(tokens)
  return condition if tokens.peek_continuation() != 'then'
  tokens.next()
  then_value := parse_expression(tokens)
  position := condition.position
  without_else := not tokens.accept('else')
  else_value: Expression = without_else then NilLiteral(position) else parse_expression(tokens)
  Conditional(condition, then_value, else_value, position, without_else)

export parse_or := (tokens: TokenStream): Expression ->
  parse_left_associative(tokens, ['or'], -> parse_and(tokens))

parse_and := (tokens: TokenStream) -> parse_left_associative(tokens, ['and'], -> parse_not(tokens))

# Operands that `parse_operand` reads, joined by any of `operators`, from left to right.
parse_left_associative := (
  tokens: TokenStream, operators: TokenKind[], parse_operand: () -> Expression
) ->
  nesting := tokens.nesting
  var left = parse_operand()
  while tokens.peek_continuation() in operators
    tokens.deepen()
    operator := tokens.next().kind.to_string()
    left = BinaryOperation(operator, left, right: parse_operand(), position: left.position)
  tokens.nesting = nesting
  left

parse_not := (tokens: TokenStream): Expression ->
  tokens.continue_line()
  token := tokens.peek()
  return parse_comparison(tokens) if token.kind != 'not'
  tokens.next()
  UnaryOperation(
    operator: 'not'
    operand: tokens.nested(-> parse_not(tokens))
    position: token.position()
  )

at_comparison_start := (tokens: TokenStream) ->
  at_word := COMPARISON_WORDS.any(tokens.continues_with_word)
  at_word or at_not_in(tokens) or at_comparison(tokens)

at_not_in := (tokens: TokenStream) ->
  tokens.peek_continuation() == 'not' and tokens.peek_at(1).is_word('in')

parse_comparison := (tokens: TokenStream) ->
  left := parse_coalesce(tokens)
  return left unless at_comparison_start(tokens)
  comparison :=
    case
      when tokens.continues_with_word('is') then parse_is(tokens, left)
      when tokens.continues_with_word('as') then parse_cast(tokens, left)
      when tokens.continues_with_word('in') or at_not_in(tokens) then parse_in(tokens, left)
      else parse_binary_comparison(tokens, left)
  if at_comparison_start(tokens)
    message := 'comparisons, is tests, in tests and casts cannot be chained'
    tokens.fail_here message
  comparison

# `x is not T` is read as `not (x is T)`.
parse_is := (tokens: TokenStream, value: Expression): Expression ->
  tokens.next()
  negated := tokens.peek().kind == 'not'
  tokens.next() if negated
  test := IsTest(value, type: parse_tested_type(tokens), position: value.position)
  if negated
    UnaryOperation(operator: 'not', operand: test, position: value.position)
  else
    test

# `x not in xs` is read as `not (x in xs)`.
parse_in := (tokens: TokenStream, item: Expression): Expression ->
  negated := tokens.accept('not')
  tokens.next()
  container := parse_coalesce(tokens)
  test := BinaryOperation(operator: 'in', left: item, right: container, position: item.position)
  if negated
    UnaryOperation(operator: 'not', operand: test, position: item.position)
  else
    test

# The `?` is read as the type's, which the checker takes as the form instead. `x as T ? y`, with a
# space before `?`, is read as `(x as T?) ? y`.
parse_cast := (tokens: TokenStream, value: Expression): Expression ->
  as_token := tokens.next()
  type := parse_cast_type(tokens)
  next := tokens.peek()
  optional := next.kind == '?' and not next.spaced
  throws := next.kind == '!' and not next.spaced
  falls_back := next.kind == '?' and next.spaced
  if not optional and not throws and not falls_back
    forms := "'as T?' for nil where it is no T, 'as T ? y' for y, or 'as T!' to throw"
    tokens.fail as_token.position(), "write #{forms}"
  tokens.next()
  type.optional = not throws
  cast := Cast(value, type, throws, position: value.position)
  return cast unless falls_back
  Coalesce(value: cast, fallback: parse_cast_fallback(tokens), position: value.position)

# The fallback of `x as T ? y`, which may itself be one, as `a ? b ? c` is `a ? (b ? c)`.
parse_cast_fallback := (tokens: TokenStream) ->
  fallback := tokens.nested(-> parse_coalesce(tokens))
  if tokens.continues_with_word('as')
    parse_cast(tokens, fallback)
  else
    fallback

parse_binary_comparison := (tokens: TokenStream, left: Expression): Expression ->
  operator := tokens.next().kind.to_string()
  BinaryOperation(operator, left, right: parse_coalesce(tokens), position: left.position)

# `a ? b ? c` is `a ? (b ? c)`.
parse_coalesce := (tokens: TokenStream): Expression ->
  value := parse_range(tokens)
  return value if tokens.peek_continuation() != '?'
  tokens.next()
  fallback := tokens.nested(-> parse_coalesce(tokens))
  Coalesce(value, fallback, position: value.position)

parse_range := (tokens: TokenStream): Expression ->
  return parse_range_without_start(tokens) if tokens.peek().kind in RANGE_OPERATORS
  start := parse_arithmetic(tokens, 0)
  return start unless tokens.peek_continuation() in RANGE_OPERATORS
  if at_spread(tokens)
    tokens.spread = tokens.peek().position()
    return start
  reject_old_range tokens
  operator := tokens.next().kind

  # `a..`, which has no end: whether it includes it would mean nothing, and `a...` is a spread.
  if at_range_end(tokens)
    tokens.fail_here "a range with '..=' takes an end" if operator == '..='
    return Range(start, inclusive: false, end: nil, position: start.position)

  inclusive := operator == '..='
  end := parse_arithmetic(tokens, 0)
  reject_chained_range tokens
  step :=
    if tokens.accept_word('by')
      parse_arithmetic tokens, 0
    else
      nil
  reversed := tokens.accept_word('reversed')
  Range(start, end, inclusive, step, reversed, position: start.position)

# `..b` or `..=b`.
parse_range_without_start := (tokens: TokenStream) ->
  reject_old_range tokens
  operator := tokens.next()
  end := parse_arithmetic(tokens, 0)
  reject_chained_range tokens
  Range(end, start: nil, inclusive: operator.kind == '..=', position: operator.position())

reject_chained_range := (tokens: TokenStream) ->
  tokens.fail_here 'ranges cannot be chained' if tokens.peek_continuation() in RANGE_OPERATORS

# `a...b` or `...b`, which were ranges before `..`; `...` is left to spreads.
reject_old_range := (tokens: TokenStream) ->
  is_old_range := tokens.peek().kind == '...' and not at_spread(tokens)
  tokens.fail_here "write a range with '..', or '..=' to include its end" if is_old_range

at_range_end := (tokens: TokenStream) -> tokens.peek().kind in SPREAD_FOLLOWERS

RANGE_OPERATORS: TokenKind[] = ['...', '..', '..=']

# `xs...` with nothing after it that could end a range, which spreads it rather than a range. An
# array's item takes it (see parse_array_literal); where nothing does, it is rejected as found
# (see TokenStream.fail_expecting).
export at_spread := (tokens: TokenStream) ->
  tokens.peek().kind == '...' and tokens.peek_at(1).kind in SPREAD_FOLLOWERS

export SPREAD_FOLLOWERS: TokenKind[] = [',', ']', ')', '}', 'for', NEWLINE, INDENT, DEDENT, EOF]

# Not at `<<=` or `>>=`, which starts an assignment.
at_comparison := (tokens: TokenStream) ->
  tokens.peek_continuation() in COMPARISON_OPERATORS and shift_ahead(tokens, '=') == nil

parse_arithmetic := (tokens: TokenStream, level: Int): Expression ->
  return parse_power(tokens) if level == ARITHMETIC_PRECEDENCE.length
  operators := ARITHMETIC_PRECEDENCE[level]
  takes_shifts := level == ARITHMETIC_PRECEDENCE.length - 1
  nesting := tokens.nesting
  var left = parse_arithmetic(tokens, level + 1)
  while true
    operator := operator_at(tokens, operators, takes_shifts then '') ? break
    tokens.deepen()
    right := parse_arithmetic(tokens, level + 1)
    left = BinaryOperation(operator, left, right, position: left.position)
  tokens.nesting = nesting
  left

# The operator that follows, consumed: one of `kinds`, or a shift and `shift_rest` if that is given,
# as `=` for `<<=` (see shift_at).
export operator_at := (tokens: TokenStream, kinds: TokenKind[], shift_rest: String?) ->
  if rest := shift_rest
    return shift if shift := shift_at(tokens, rest)
  return nil unless tokens.peek_continuation() in kinds
  tokens.next().kind.to_string()

# `<<` or `>>`, consumed, and then `rest`, as `=` of `<<=`: two tokens with no space between them,
# so that the `>>` that ends `Map<String, Set<Int>>` stays two closing brackets.
shift_at := (tokens: TokenStream, rest: String) ->
  shift := shift_ahead(tokens, rest) ? return nil
  tokens.next()
  tokens.next()
  shift

# The shift and `rest` that the next two tokens make, not consumed, as shift_at reads them.
shift_ahead := (tokens: TokenStream, rest: String) ->
  first := tokens.peek_continuation()
  return nil unless first in ['<', '>']
  second := tokens.peek_at(1)
  return nil if second.spaced or second.kind.to_string() != "#{first}#{rest}"
  "#{first}#{second.kind}"

# `x ** n`, which groups to the right, as `2 ** 3 ** 2` is `2 ** 9`. A prefix operator before it
# needs parentheses, as `-x ** 2` would read as `(-x) ** 2` in some languages and as `-(x ** 2)` in
# others, and `-2 ** 2` as the first, of the literal `-2`, while `-x ** 2` would read as the second.
parse_power := (tokens: TokenStream): Expression ->
  tokens.continue_line()
  start := tokens.peek()
  base := parse_unary(tokens)
  return base unless tokens.peek_continuation() == '**'
  if start.kind in PREFIX_OPERATORS
    prefix := start.kind == 'await' then 'await ' else start.text
    message := "write `(#{prefix}x) ** n` or `#{prefix}(x ** n)` for `#{prefix}x ** n`"
    tokens.fail start.position(), message
  nesting := tokens.nesting
  tokens.next()
  tokens.deepen()
  exponent := parse_power(tokens)
  tokens.nesting = nesting
  BinaryOperation(operator: '**', left: base, right: exponent, position: base.position)

PREFIX_OPERATORS: TokenKind[] = ['-', '~', 'await']

parse_unary := (tokens: TokenStream): Expression ->
  tokens.continue_line()
  token := tokens.peek()
  if token.kind == 'await'
    tokens.next()
    position := token.position()
    marks := tokens.innermost_function()
    marks.await_at = position if marks and marks.await_at == nil
    return Await(position, operand: tokens.nested(-> parse_unary(tokens)))
  position := token.position()
  if token.kind == '~'
    tokens.next()
    return UnaryOperation(position, operator: '~', operand: tokens.nested(-> parse_unary(tokens)))
  if token.kind != '-'
    return parse_postfix(tokens, parse_primary(tokens))
  tokens.next()

  # `-1` with no space is a negative literal, so that the minimum Int can be written; `-1.5` is one
  # too, so that a member applies to it as it does to `-1`.
  literal := tokens.peek()
  if literal.kind == INTEGER and not literal.spaced
    tokens.next()
    return parse_postfix(tokens, integer_literal("-#{literal.text}", position))
  if literal.kind == FLOAT and not literal.spaced
    tokens.next()
    return parse_postfix(tokens, FloatLiteral(position, text: "-#{literal.text}"))

  UnaryOperation(position, operator: '-', operand: tokens.nested(-> parse_unary(tokens)))

export parse_identifier := (tokens: TokenStream) ->
  token := tokens.peek()
  tokens.fail_expecting token, 'name' if token.kind != IDENTIFIER
  tokens.next()
  Identifier(name: token.text, position: token.position())

parse_postfix := (tokens: TokenStream, primary: Expression): Expression ->
  nesting := tokens.nesting
  var expression = primary
  while extended := extend_by_postfix(tokens, expression)
    tokens.deepen()
    expression = extended
  tokens.nesting = nesting
  if at_nil_safe(tokens)
    tokens.nested(-> parse_nil_safe(tokens, expression))
  else
    expression

at_nil_safe := (tokens: TokenStream) ->
  question := tokens.peek()
  dot := tokens.peek_at(1)
  question.kind == '?' and not question.spaced and dot.kind == '.' and not dot.spaced

# `x?.rest`, nil if x is nil and otherwise x with the rest of the postfix chain: an `if` that binds
# x to a name of its position, which no source can write.
parse_nil_safe := (tokens: TokenStream, object: Expression) ->
  position := tokens.next().position()
  name := Identifier(position, name: "?#{position.line}:#{position.column}")
  rest := parse_postfix(tokens, copy_identifier(name))
  condition := Binding(name, position, value: object)
  nil_safe := If(condition, position, then_body: [rest], else_body: [NilLiteral(position)])
  nil_safe.nil_safe = true
  nil_safe

# The expression with the call `f(x)`, indexing `xs[i]`, member access `x.name` or unwrapping `x!`
# that follows it, written without a space before `(`, `[`, `.` or `!`, or the call with type
# arguments, `f<Int>(x)` or `x.f<Int>(y)`; nil if none follows.
extend_by_postfix := (tokens: TokenStream, expression: Expression): Expression? ->
  is_name := expression is Identifier | Member
  if is_name and at_type_arguments(tokens)
    type_args := parse_type_arguments(tokens)
    tokens.next()
    return call_of(expression, parse_parenthesized_arguments(tokens), type_args)
  token := tokens.peek()
  return nil if token.spaced or token.kind not in POSTFIX_OPERATORS
  tokens.next()
  position := expression.position
  case token.kind
    when '!' then Unwrap(position, operand: expression)
    when '(' then call_of(expression, parse_parenthesized_arguments(tokens), [])
    when '[' then parse_index(tokens, expression, position)
    else Member(position, object: expression, name: parse_identifier(tokens))

# The index after `[`, and the default of a map's value after it, `m[k, default: d]`, through `]`;
# a line end before `default` separates the two as a comma does, as a list's items are.
parse_index := (tokens: TokenStream, object: Expression, position: Position) ->
  parse_contents := ->
    index := parse_expression(tokens)

    # `xs[a...]`, which reads as a spread.
    if tokens.spread == tokens.peek().position()
      tokens.fail_here 'a range without an end is written `a..`'

    default_value := parse_index_default(tokens)
    tokens.expect_close ']'
    Index(position, object, index, default_value)
  tokens.inside(parse_contents)

parse_index_default := (tokens: TokenStream): Expression? ->
  if tokens.accept(',')
    tokens.continue_line()
  else if not tokens.continue_line_before('default')
    return nil
  tokens.expect_word 'default'
  tokens.expect ':'
  parse_expression(tokens)

# `at`, `in` and `when` are not keywords, so that they stay usable as names.
export parse_loop_header := (tokens: TokenStream) ->
  tokens.expect 'for'
  position := tokens.peek().position()
  parts: Identifier[] = tokens.peek().kind == '(' then parse_tuple_names(tokens) else []
  variable := not parts.is_empty() then tuple_holder(position) else parse_identifier(tokens)
  comma := tokens.peek()
  if comma.kind == ','
    tokens.fail comma.position(), 'write the index after `at`: `for x at i in xs`'
  index := tokens.accept_word('at') then parse_identifier(tokens)
  tokens.expect_word 'in'
  iterable := parse_expression(tokens)
  tokens.continue_line_before 'when'
  guard := tokens.accept_word('when') then parse_expression(tokens)
  LoopHeader(variable, index, iterable, guard, parts)

# `(a, b)`, the names that a tuple is taken apart into.
export parse_tuple_names := (tokens: TokenStream) ->
  open := tokens.next()
  names := tokens.parse_list(')', -> parse_identifier(tokens))
  tokens.fail open.position(), 'a tuple has two or more items' if names.length < 2
  names

# The name of what holds a tuple while it is taken apart: it cannot be written (`.` is not allowed
# in names), and it starts with `_` as it may not be read, when every part is `_`.
export tuple_holder := (position: Position) ->
  Identifier(position, name: "_tuple.#{position.line}.#{position.column}")

# The declarations of the names from the items of the tuple that `holder` names; `_` discards its
# item.
export take_apart := (holder: Identifier, names: Identifier[], mutable: Bool, of_loop: Bool) ->
  count := names.length
  declaration := (name: Identifier, index: Int): Statement ->
    { position } := name
    value := TupleItem(index, count, position, tuple: copy_identifier(holder))
    Declaration(mutable, name, value, position, of_loop)
  [declaration(name, i) for name at i in names when name.name != '_']

# `{ a, b }`, the names of the fields that a struct is taken apart into, or `(a, b)`, those of the
# items of a tuple.
export struct Destructuring
  names: Identifier[]
  of_tuple: Bool

export at_destructuring_names := (tokens: TokenStream) -> tokens.peek().kind in ['{', '(']

export parse_destructuring_names := (tokens: TokenStream): Destructuring ->
  if tokens.peek().kind == '('
    return { names: parse_tuple_names(tokens), of_tuple: true }
  tokens.expect '{'
  names := tokens.parse_list('}', -> parse_identifier(tokens))
  tokens.fail_expecting tokens.peek(), 'a name' if names.is_empty()
  { names, of_tuple: false }

# What holds the value that the destructuring takes apart, named after `at`, where an error about
# the value is reported.
export destructured_holder := (destructuring: Destructuring, at: Position) ->
  return tuple_holder(at) if destructuring.of_tuple
  Identifier(position: at, name: "destructured.#{at.line}.#{at.column}")

# The declarations of the names, each from the field of its name, or from the item at its place, of
# what `holder` holds.
export take_apart_held := (destructuring: Destructuring, holder: Identifier, mutable: Bool) ->
  { names } := destructuring
  if destructuring.of_tuple
    return take_apart(holder, names, mutable, false)
  field_of := (name: Identifier) ->
    Member(object: copy_identifier(holder), name: copy_identifier(name), position: name.position)
  declare := (name: Identifier): Statement ->
    Declaration(mutable, name, value: field_of(name), position: name.position)
  [declare(name) for name in names]

# The declarations of the parts of a loop's item (see LoopHeader).
export take_apart_item := (header: LoopHeader) ->
  take_apart(header.variable, header.parts, false, true)

# The arguments after an opening parenthesis, through the closing one.
parse_parenthesized_arguments := (tokens: TokenStream) ->
  to_arguments(tokens, tokens.parse_list(')', -> parse_argument(tokens)))

# Arguments separated by commas, to the end of the line, as a call without parentheses has.
export parse_arguments := (tokens: TokenStream) ->
  items := [parse_argument(tokens)]
  while tokens.peek_continuation() == ','
    tokens.next()
    tokens.continue_line()
    next := tokens.peek()
    tokens.fail_expecting next, "an item after ','" if next.kind == NEWLINE
    items.push parse_argument(tokens)
  to_arguments(tokens, items)

struct Argument
  name: Identifier?
  value: Expression

at_named_argument := (tokens: TokenStream) ->
  tokens.peek().kind == IDENTIFIER and tokens.peek_at(1).kind == ':'

POSITIONAL_AFTER_NAMED := 'a positional argument cannot follow a named one'

parse_argument := (tokens: TokenStream) ->
  # A spread, `xs...`, gives its items to a variadic parameter (see packed_arguments).
  return Argument(parse_element(tokens)) unless at_named_argument(tokens)
  name := parse_identifier(tokens)
  tokens.next()
  Argument(name, value: parse_value(tokens))

# Named arguments come last.
to_arguments := (tokens: TokenStream, items: Argument[]) ->
  args: Expression[]
  named_args: NamedValue[]
  for item in items
    if name := item.name
      named_args.push { name, value: item.value }
    else if not named_args.is_empty()
      tokens.fail item.value.position, POSITIONAL_AFTER_NAMED
    else
      args.push item.value
  Arguments(args, named_args)
