# Compound expressions, made of other expressions or of blocks: arrays and comprehensions, maps and
# anonymous structs, function literals, and `case`.
import
  ArrayLiteral, BooleanLiteral, Case, CaseArm, Catch, Comprehension, Conditional, copy_identifier,
  Expression, FunctionLiteral, Identifier, is_spread, LazyFunctions, MapEntry, MapLiteral,
  NamedValue, Parameter, Pass, Position, RecordLiteral, spread_of_value, Statement, Try,
  TupleLiteral
from '../ast'
import TokenKind from '../lexer/tokens'
import starts_block from './block_literal'
import
  at_spread, parse_expression, parse_identifier, parse_loop_header, parse_or, SPREAD_FOLLOWERS,
  take_apart_item
from './expression'
import at_declaration, parse_block, parse_line_statement, parse_simple_statement from './statement'
import is_one_of, TokenStream from './token_stream'
import parse_result_annotation, parse_type_annotation, parse_type_parameters from './type'

# `(` starts a function literal when it opens typed parameters, `(a: Int`, or when its closing
# `)` is followed by `->`, or by `:` after `()`. A parenthesized expression followed by `:` is a
# map key: `{ (k): v }`. `<` starts the type parameters of a generic one.
# The parameters may start on the line after the `(`.
export starts_function_literal := (tokens: TokenStream) ->
  first := tokens.peek().kind
  return true if first == '->' or first == '<'
  return false if first != '('
  starts_block := tokens.peek_at(1).kind == NEWLINE and tokens.peek_at(2).kind == INDENT
  looks_like_parameters tokens, starts_block then 3 else 1

export starts_weak_function_literal := (tokens: TokenStream) ->
  return false if not tokens.at_word('weak')
  start := tokens.index
  tokens.next()
  starts := starts_function_literal(tokens)
  tokens.index = start
  starts

# Whether the `(` next starts parameters, the first of which is `offset` tokens ahead.
looks_like_parameters := (tokens: TokenStream, offset: Int) ->
  second := tokens.peek_at(offset).kind
  third := tokens.peek_at(offset + 1).kind
  return third == ':' or third == '->' if second == ')'
  # `(x = 1)` is no expression, as an assignment is a statement.
  return true if second == IDENTIFIER and (third == ':' or third == '=')
  close := tokens.closing_offset('(', ')', (kind) -> kind != EOF) ? return false
  tokens.peek_at(close + 1).kind == '->'

# `(a: Int, b: Int): Int -> body`; the parameters and the return type may be omitted, and so may
# the parameters' types, `(a, b) -> body`, where a function type is expected. Type parameters,
# `<T, U: Stringable>`, come first.
export parse_function_literal := (tokens: TokenStream, weak = false) ->
  token := tokens.peek()
  type_params := parse_type_parameters(tokens)
  parse_params := (): Parameter[] ->
    return [] if not tokens.accept('(')
    tokens.parse_list ')', -> parse_parameter(tokens)
  # A default is computed before the body runs (see generate_default_entry), so it cannot wait.
  parsed_params := tokens.in_function(parse_params)
  params := parsed_params.body
  tokens.fail at, "'await' cannot be in a default" if at := parsed_params.marks.await_at
  return_type := parse_result_annotation(tokens)
  tokens.expect '->'
  is_block := tokens.peek().kind == NEWLINE
  # Interpolated code is one expression; a function literal, whose body is made of statements,
  # cannot be written there.
  if start := tokens.interpolation
    tokens.fail start, 'a function cannot be written in an interpolation'
  parse_body := ->
    case
      when is_block then parse_block(tokens)
      # Inside brackets, a postfix `for` or `if` after the body belongs to them, as in
      # `[(x) -> x for x in xs]`.
      when tokens.in_brackets() then [parse_simple_statement(tokens)]
      else [parse_line_statement(tokens)]
  { body, marks } := tokens.in_function(parse_body)
  yields := marks.yields
  awaits := marks.await_at != nil
  position := token.position()
  FunctionLiteral type_params, params, return_type, body, yields, awaits, position, weak

# `name[: Type][ = default]`, or `name: Type...`.
parse_parameter := (tokens: TokenStream) ->
  name := parse_identifier(tokens)
  type := parse_type_annotation(tokens)
  if tokens.accept('...')
    if type == nil
      tokens.fail name.position, 'a variadic parameter must have a type, as in `rest: Int...`'
    return Parameter(name, type, default: nil, variadic: true)
  Parameter name, type, default: tokens.accept('=') then parse_expression(tokens)

# `[a, b, c]`; `[]` is empty. A first element followed by `for` makes a comprehension. An element
# `xs...` gives the items of `xs` in its place.
export parse_array_literal := (tokens: TokenStream, position: Position) ->
  parse_contents := ->
    return ArrayLiteral(position, elements: []) if tokens.accept(']')
    first := parse_element(tokens)
    tokens.continue_line_before 'for'
    if tokens.peek().kind == 'for'
      if is_spread(first)
        tokens.fail first.position, 'a spread cannot be the element of a comprehension'
      return parse_comprehension(tokens, first, position, ']')
    elements := tokens.parse_list_rest(']', -> parse_element(tokens), [first])
    ArrayLiteral elements, position
  tokens.inside parse_contents

# An item, which a spread `xs...` may be (see spread_of_value).
export parse_element := (tokens: TokenStream) -> spread_of(tokens, parse_expression(tokens))

# `value`, or `value...` when a spread follows it.
export spread_of := (tokens: TokenStream, value: Expression) ->
  return value if not at_spread(tokens)
  tokens.next()
  spread_of_value value

# `(a)`, a tuple, `(a, b)`, or `(f(x) for x in xs when g(x))`, an Iter comprehension.
export parse_parenthesized := (tokens: TokenStream, position: Position) ->
  parse_contents := ->
    first := parse_expression(tokens)
    tokens.continue_line_before 'for'
    return parse_comprehension(tokens, first, position, ')') if tokens.peek().kind == 'for'
    if tokens.peek().kind == ','
      items := tokens.parse_list_rest(')', -> parse_expression(tokens), [first])
      return TupleLiteral(items, position)
    tokens.expect_close ')'
    # Diagnostics about the group point at its opening parenthesis.
    first.position = position
    first
  tokens.inside parse_contents

# `for x in xs when guard]`, after the element, or `... guard)` for an Iter.
parse_comprehension := (
  tokens: TokenStream, element: Expression, position: Position, close: TokenKind
): Expression ->
  header := parse_loop_header(tokens)
  tokens.expect_close close
  { variable, index, iterable, guard } := header
  is_lazy := close == ')'
  if is_lazy and index != nil
    tokens.fail index.position, 'an Iter comprehension takes no index so far'
  # Each place that reads the parts declares them anew, as each is its own function or scope.
  bindings := -> take_apart_item(header)
  lazy := is_lazy then lazy_functions(element, variable, guard, bindings)
  Comprehension element, variable, iterable, guard, lazy, position, index, bindings: bindings()

export parse_map_literal := (tokens: TokenStream, position: Position) ->
  tokens.inside -> parse_map_contents(tokens, position)

parse_map_contents := (tokens: TokenStream, position: Position): Expression ->
  if starts_record_field(tokens) or starts_spread(tokens)
    return parse_record_literal(tokens, position)
  entries := tokens.parse_list_rest<MapEntry>('}', -> parse_map_entry(tokens), [])
  if entries.is_empty()
    tokens.fail position, 'the empty map is written `Map()`, and the empty set `Set()`'
  MapLiteral entries, position

parse_map_entry := (tokens: TokenStream) ->
  if starts_record_field(tokens)
    token := tokens.peek()
    name := token.text
    message := "a map's keys are values: for the value of '#{name}', write (#{name})"
    tokens.fail token.position(), message
  key := parse_expression(tokens)
  tokens.expect ':'
  MapEntry key, value: parse_expression(tokens)

# A name followed by `:`, `,`, `}` or the end of its line starts a field of an anonymous struct; a
# map's keys are other expressions.
starts_record_field := (tokens: TokenStream) ->
  follows_name := is_one_of(tokens.peek_at(1).kind, [':', ',', '}', NEWLINE])
  tokens.peek().kind == IDENTIFIER and follows_name

# An item that ends with `...`, which spreads the fields of a struct into a construction or an
# anonymous struct (see the checker's spread_argument), before a `,`, `}`, `:` or the end of its
# line outside brackets of its own, which end a field or a map's key.
export starts_spread := (tokens: TokenStream) ->
  var depth = 0
  var index = tokens.index_at(0)
  while true
    kind := tokens.tokens[index].kind
    return false if kind == EOF
    if kind == '(' or kind == '[' or kind == '{'
      depth += 1
    else if kind == ')' or kind == ']' or kind == '}'
      return false if depth == 0
      depth -= 1
    else if depth == 0
      return false if is_one_of(kind, [',', ':', NEWLINE])
      return true if kind == '...' and tokens.tokens[index + 1].kind in SPREAD_FOLLOWERS
    index += 1
  false

# `{ x: 1, y }`; a field without a value takes that of the name. A spread comes first, alone.
parse_record_literal := (tokens: TokenStream, position: Position) ->
  items := tokens.parse_list_rest<RecordItem>('}', -> parse_record_item(tokens), [])
  record_of tokens, items, position

type RecordItem = NamedValue | Comprehension

parse_record_item := (tokens: TokenStream): RecordItem ->
  starts_spread(tokens) then parse_element(tokens) as Comprehension! else parse_record_field(tokens)

export record_of := (tokens: TokenStream, items: RecordItem[], position: Position) ->
  if misplaced := [item for item in items.slice(1) when item is Comprehension].first()
    tokens.fail misplaced.position, 'a spread comes first in an anonymous struct, once'
  fields := [item for item in items when item is NamedValue]
  first := items.first()
  spread := first is Comprehension then first
  RecordLiteral fields, position, spread

parse_record_field := (tokens: TokenStream) ->
  if not starts_record_field(tokens)
    message := 'an anonymous struct and a map cannot be mixed'
    tokens.fail_here message
  name := parse_identifier(tokens)
  has_value := tokens.accept(':')
  value: Expression = has_value then parse_expression(tokens) else copy_identifier(name)
  NamedValue name, value

# With a subject, the `else` arm may be left out; whether it may is checked later.
export parse_case := (tokens: TokenStream, position: Position) ->
  subject := tokens.peek().kind == NEWLINE then nil else parse_expression(tokens)
  tokens.expect NEWLINE, 'end of line'
  tokens.expect INDENT, "indented 'when' arms"
  has_subject := subject != nil
  arms := [parse_case_arm(tokens, has_subject)]
  arms.push parse_case_arm(tokens, has_subject) while tokens.at_word('when')
  has_else := not has_subject or tokens.peek().kind == 'else'
  tokens.expect 'else', "'when' or 'else'" if has_else
  otherwise := has_else then parse_arm_body(tokens, 'else')
  tokens.expect DEDENT, 'end of block'
  Case subject, arms, otherwise, position

# `try` and an indented block, then `catch` clauses and a `finally` clause, each with its block.
export parse_try := (tokens: TokenStream, position: Position) ->
  body := parse_block(tokens)
  catches: Catch[]
  catches.push parse_catch(tokens) while tokens.peek().kind == 'catch'
  has_finally := tokens.accept('finally')
  finally_body := has_finally then parse_block(tokens)
  if catches.is_empty() and finally_body == nil
    tokens.fail_expecting tokens.peek(), "'catch' or 'finally'"
  Try body, catches, finally_body, position

parse_catch := (tokens: TokenStream) ->
  position := tokens.next().position()
  name := parse_identifier(tokens)
  type := parse_type_annotation(tokens)
  Catch name, type, position, body: parse_block(tokens)

parse_case_arm := (tokens: TokenStream, has_subject: Bool) ->
  tokens.expect_word 'when'
  # A pattern stops before `then`, which begins the arm's value.
  parse_pattern := -> parse_or(tokens)
  if has_subject and starts_block(tokens)
    patterns := parse_pattern_block(tokens, parse_pattern)
    return CaseArm(patterns, body: parse_arm_body(tokens, 'else'))
  patterns :=
    if has_subject
      tokens.parse_separated ',', parse_pattern
    else
      [parse_pattern()]
  CaseArm patterns, body: parse_arm_body(tokens, 'then')

# Patterns in an indented block, as the items of a literal are, and `then` at the indentation of
# `when`, which the body follows as it follows `else`: `when` and then `'a', 'b'` and `'c'` on the
# lines below, and `then 1`.
parse_pattern_block := (tokens: TokenStream, parse_pattern: () -> Expression) ->
  patterns: Expression[]
  tokens.read_block_items -> patterns.push(parse_pattern())
  tokens.expect 'then'
  patterns

# A simple statement on the same line (`when c then x`, `else i += 1`), or an indented block.
# `arm` is 'then', which comes first, or 'else', which is read already, as `then` is after a block
# of patterns.
parse_arm_body := (tokens: TokenStream, arm: TokenKind) ->
  is_inline := arm == 'then' then tokens.accept('then') else tokens.peek().kind != NEWLINE
  if is_inline
    statement := parse_pass(tokens) ? parse_inline_arm(tokens)
    tokens.expect_line_end()
    return [statement]
  next := tokens.peek()
  tokens.fail_expecting next, "'then' or end of line" if next.kind != NEWLINE
  parse_block tokens

# `pass` is not a keyword: a name alone after `then` or `else` would be an unused value, so it can
# mean nothing else there.
parse_pass := (tokens: TokenStream): Statement? ->
  return nil if not tokens.at_word('pass') or tokens.peek_at(1).kind != NEWLINE
  Pass tokens.next().position()

# A declaration's scope would end with the line, so none may follow `then` or `else`.
parse_inline_arm := (tokens: TokenStream) ->
  message := 'a declaration in an arm must be in an indented block'
  tokens.fail_here message if at_declaration(tokens)
  parse_line_statement tokens

# The guard and the element of an Iter comprehension as functions of the loop variable (see
# Comprehension). The guard's function tests its condition as an `if` would:
# `guard then true else false`.
lazy_functions := (
  element: Expression, variable: Identifier, guard: Expression?, bindings: () -> Statement[]
) ->
  function_of := (value: Expression) ->
    params := [Parameter(copy_identifier(variable))]
    body := [bindings()..., value]
    FunctionLiteral
      params
      body
      type_params: []
      position: value.position
      yields: false
      awaits: false
      weak: false
  guard_function := guard then function_of(as_test(guard))
  LazyFunctions guard: guard_function, element: function_of(element)

as_test := (guard: Expression) ->
  position := guard.position
  then_value := BooleanLiteral(position, value: true)
  else_value := BooleanLiteral(position, value: false)
  Conditional then_value, else_value, position, condition: guard
