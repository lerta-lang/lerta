# Compound expressions, made of other expressions or of blocks: arrays and comprehensions, maps and
# anonymous structs, function literals, and `case`.
import {
  ArrayLiteral, BooleanLiteral, Case, CaseArm, Comprehension, Conditional, copy_identifier
  Expression, FunctionLiteral, Identifier, LazyFunctions, MapEntry, MapLiteral
  NamedValue, Parameter, Position, RecordLiteral, Statement, TypeParameter
} from '../ast'
import {
  parse_coalesce, parse_expression, parse_identifier, parse_list, parse_list_rest
  parse_loop_header
} from './expression'
import { parse_block, parse_simple_statement } from './statement'
import { inside, is_one_of, token_position, TokenStream } from './token_stream'
import { parse_type_name } from './type'

# `(` starts a function literal when it opens typed parameters, `(a: Int`, or when its closing
# `)` is followed by `->`, or by `:` after `()`. A parenthesized expression followed by `:` is a
# map key: `{ (k): v }`. `<` starts the type parameters of a generic one.
# The lookahead skips line breaks, which may separate the parameters.
export const starts_function_literal = (tokens: TokenStream) ->
  inside(tokens, 'skip', () -> looks_like_function_literal(tokens))

const looks_like_function_literal = (tokens: TokenStream) ->
  const first = tokens.peek().kind
  const second = tokens.peek_at(1).kind
  const third = tokens.peek_at(2).kind
  return true if first == '->' or first == '<'
  return false if first != '('
  return third == ':' or third == '->' if second == ')'
  return true if second == 'identifier' and third == ':'
  var depth = 0
  var offset = 0
  while true
    const kind = tokens.peek_at(offset).kind
    depth += 1 if kind == '('
    depth -= 1 if kind == ')'
    break if depth == 0 or kind == 'newline' or kind == 'eof'
    offset += 1
  depth == 0 and tokens.peek_at(offset + 1).kind == '->'

# `(a: Int, b: Int): Int -> body`; the parameters and the return type may be omitted, and so may
# the parameters' types, `(a, b) -> body`, where a function type is expected. Type parameters,
# `<T, U: Stringable>`, come first.
export const parse_function_literal = (tokens: TokenStream) ->
  const token = tokens.peek()
  const is_generic = token.kind == '<'
  const type_params: Array<TypeParameter> = is_generic then parse_type_parameters(tokens) else []
  const params: Array<Parameter> = case
    when tokens.accept('(') then parse_list(tokens, ')', () -> parse_parameter(tokens))
    else []
  const return_type = parse_type_annotation(tokens)
  tokens.expect('->', "'->'")
  const is_block = tokens.peek().kind == 'newline'
  # Interpolated code is one expression; a function literal, whose body is made of statements,
  # cannot be written there.
  if const start = tokens.interpolation
    tokens.fail(start, 'a function cannot be written in an interpolation')
  const body = is_block then parse_block(tokens) else [parse_simple_statement(tokens)]
  FunctionLiteral(type_params, params, return_type, body, position: token_position(token))

const parse_parameter = (tokens: TokenStream) ->
  const name = parse_identifier(tokens)
  Parameter(name, type: parse_type_annotation(tokens))

# `: Type`, if it follows.
const parse_type_annotation = (tokens: TokenStream) ->
  tokens.accept(':') then parse_type_name(tokens) else nil

# `<T, U: Stringable>`.
export const parse_type_parameters = (tokens: TokenStream) ->
  tokens.expect('<', "'<'")
  const type_params = [parse_type_parameter(tokens)]
  type_params.push(parse_type_parameter(tokens)) while tokens.accept(',')
  tokens.expect('>', "'>'")
  type_params

const parse_type_parameter = (tokens: TokenStream) ->
  const name = parse_identifier(tokens)
  const bound = tokens.accept(':') then parse_identifier(tokens) else nil
  TypeParameter(name, bound)

# `[a, b, c]`; `[]` is empty. A first element followed by `for` makes a comprehension.
export const parse_array_literal = (tokens: TokenStream, position: Position) ->
  const parse_contents = (): Expression ->
    tokens.accept('line_break')
    return ArrayLiteral(position, elements: []) if tokens.accept(']')
    const first = parse_expression(tokens)
    tokens.next() if tokens.peek().kind == 'line_break' and tokens.peek_at(1).kind == 'for'
    return parse_comprehension(tokens, first, position, ']') if tokens.peek().kind == 'for'
    const elements = parse_list_rest(tokens, ']', () -> parse_expression(tokens), [first])
    ArrayLiteral(elements, position)
  inside(tokens, 'separate', parse_contents)

# `(a)`, or `(f(x) for x in xs when g(x))`, an Iter comprehension; line ends inside are skipped.
export const parse_parenthesized = (tokens: TokenStream, position: Position) ->
  const parse_contents = () ->
    const first = parse_expression(tokens)
    return parse_comprehension(tokens, first, position, ')') if tokens.peek().kind == 'for'
    tokens.expect(')', "')'")
    # Diagnostics about the group point at its opening parenthesis.
    first.position = position
    first
  inside(tokens, 'skip', parse_contents)

# `for x in xs when guard]`, after the element, or `... guard)` for an Iter; line ends inside
# are skipped.
const parse_comprehension = (
  tokens: TokenStream
  element: Expression
  position: Position
  close: String
): Expression ->
  const parse_header = () ->
    const header = parse_loop_header(tokens)
    tokens.expect(close, "'#{close}'")
    header
  const { variable, iterable, guard } = inside(tokens, 'skip', parse_header)
  const lazy = close == ')' then lazy_functions(element, variable, guard) else nil
  Comprehension(element, variable, iterable, guard, lazy, position)

# `{ k: v, ... }`. A key that is a name would make an anonymous struct, so a name's value is
# written as a key in parentheses: `{ (k): v }`.
export const parse_map_literal = (tokens: TokenStream, position: Position): Expression ->
  return parse_record_literal(tokens, position) if starts_record_field(tokens)
  const entries = parse_list(tokens, '}', () -> parse_map_entry(tokens))
  tokens.fail(position, 'the empty map is written `Map()`') if entries.length == 0
  MapLiteral(entries, position)

const parse_map_entry = (tokens: TokenStream) ->
  if starts_record_field(tokens)
    const token = tokens.peek()
    const name = token.text
    const message = "a map's keys are values: for the value of '#{name}', write (#{name})"
    tokens.fail(token_position(token), message)
  const key = parse_expression(tokens)
  tokens.expect(':', "':'")
  MapEntry(key, value: parse_expression(tokens))

# A name followed by `:`, `,` or `}` starts a field of an anonymous struct; a map's keys are
# other expressions.
const starts_record_field = (tokens: TokenStream) ->
  const follows_name = is_one_of(tokens.peek_at(1).kind, [':', ',', '}', 'line_break'])
  tokens.peek().kind == 'identifier' and follows_name

# `{ x: 1, y }`; a field without a value takes that of the name.
const parse_record_literal = (tokens: TokenStream, position: Position) ->
  RecordLiteral(position, fields: parse_list(tokens, '}', () -> parse_record_field(tokens)))

const parse_record_field = (tokens: TokenStream) ->
  if not starts_record_field(tokens)
    const message = 'an anonymous struct and a map cannot be mixed'
    tokens.fail(token_position(tokens.peek()), message)
  const name = parse_identifier(tokens)
  const has_value = tokens.accept(':')
  const value: Expression = has_value then parse_expression(tokens) else copy_identifier(name)
  NamedValue(name, value)

# `case` followed by an indented block of `when` arms and a final `else` arm.
# With a subject, an arm may list several patterns, and the `else` arm may be left out (whether
# it may is checked later).
export const parse_case = (tokens: TokenStream, position: Position) ->
  const subject = tokens.peek().kind == 'newline' then nil else parse_expression(tokens)
  tokens.expect('newline', 'end of line')
  tokens.expect('indent', "indented 'when' arms")
  const has_subject = subject != nil
  const arms = [parse_case_arm(tokens, has_subject)]
  arms.push(parse_case_arm(tokens, has_subject)) while tokens.peek().kind == 'when'
  const has_else = not has_subject or tokens.peek().kind == 'else'
  tokens.expect('else', "'when' or 'else'") if has_else
  const otherwise = has_else then parse_arm_body(tokens, 'else') else nil
  tokens.expect('dedent', 'end of block')
  Case(subject, arms, otherwise, position)

const parse_case_arm = (tokens: TokenStream, has_subject: Bool) ->
  tokens.expect('when', "'when'")
  # A pattern stops before `then`, which begins the arm's value.
  const patterns = [parse_coalesce(tokens)]
  patterns.push(parse_coalesce(tokens)) while has_subject and tokens.accept(',')
  CaseArm(patterns, body: parse_arm_body(tokens, 'then'))

# The expression on the same line (`when c then x`, `else x`), or alone in an indented block.
# `arm` is 'then' or 'else'.
const parse_arm_body = (tokens: TokenStream, arm: String): Array<Statement> ->
  const is_inline = arm == 'then' then tokens.accept('then') else tokens.peek().kind != 'newline'
  if is_inline
    const value = parse_expression(tokens)
    tokens.expect_line_end()
    return [value]
  const next = tokens.peek()
  tokens.fail_expecting(next, "'then' or end of line") if next.kind != 'newline'
  parse_block(tokens)

# The guard and the element of an Iter comprehension as functions of the loop variable (see
# Comprehension). The guard's function tests its condition as an `if` would:
# `guard then true else false`.
const lazy_functions = (element: Expression, variable: Identifier, guard: Expression?) ->
  const guard_function = guard then function_of(as_test(guard), variable) else nil
  LazyFunctions(guard: guard_function, element: function_of(element, variable))

const function_of = (body: Expression, variable: Identifier) ->
  const params = [Parameter(name: copy_identifier(variable))]
  FunctionLiteral(params, type_params: [], body: [body], position: body.position)

const as_test = (guard: Expression) ->
  const position = guard.position
  const then_value = BooleanLiteral(position, value: true)
  const else_value = BooleanLiteral(position, value: false)
  Conditional(then_value, else_value, position, condition: guard)
