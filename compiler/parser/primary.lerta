# Primary expressions: names, literals, `@`, jumps, and the compound expressions that `compound`
# reads.
import { hex_digit_value } from '../hex'
import {
  BooleanLiteral, Call, Expression, Identifier, IntegerLiteral, Interpolation, InterpolationPart
  Jump, Member, NilLiteral, Position, Return, StringLiteral, This, Throw
} from '../ast'
import {
  parse_array_literal, parse_case, parse_function_literal, parse_map_literal, parse_parenthesized
  starts_function_literal
} from './compound'
import { parse_expression, parse_identifier } from './expression'
import { Token, tokenize_fragment } from '../lexer/tokens'
import { CodePart, TemplatePart, TextPart } from '../lexer/string_literal'
import { is_one_of, token_position, TokenStream } from './token_stream'

const INT_MIN = -9223372036854775808

const EXPRESSION_ENDS = [
  'newline', 'dedent', 'eof', 'line_break'
  'if', 'while', 'then', 'else', ')', ']', '}', ','
]

export const parse_primary = (tokens: TokenStream): Expression ->
  return parse_function_literal(tokens) if starts_function_literal(tokens)
  const token = tokens.next()
  const position = token_position(token)
  case token.kind
    when 'identifier' then Identifier(position, name: token.text)
    when 'string' then StringLiteral(position, value: token.text)
    when 'interpolated' then parse_interpolation(tokens, token)
    when 'nil' then NilLiteral(position)
    when 'break', 'continue' then Jump(position, kind: token.kind)
    when 'return'
      const value = ends_expression(tokens) then nil else parse_expression(tokens)
      Return value, position
    when 'throw' then Throw(position, message: parse_expression(tokens))
    when '@' then parse_this(tokens, position)
    when 'true', 'false' then BooleanLiteral(position, value: token.kind == 'true')
    when 'case' then parse_case(tokens, position)
    when '[' then parse_array_literal(tokens, position)
    when '{' then parse_map_literal(tokens, position)
    when 'integer'
      IntegerLiteral position, value: integer_value(tokens, token.text, false, position)
    when '(' then parse_parenthesized(tokens, position)
    else tokens.fail_expecting(token, 'expression')

# `@` is the object; `@x`, written without a space, is its member x. `@.x` would be a second
# way to write it for no gain, so it is an error.
const parse_this = (tokens: TokenStream, position: Position): Expression ->
  const object = This(position)
  const next = tokens.peek()
  tokens.fail token_position(next), 'write @x, not @.x' if next.kind == '.'
  return object if next.kind != 'identifier' or next.spaced
  Member object, position, name: parse_identifier(tokens)

# Whether the next token ends the expression, so that `return` there has no value.
const ends_expression = (tokens: TokenStream) ->
  is_one_of tokens.peek_continuation(), EXPRESSION_ENDS

# The value of an integer literal's text, negated if `is_negative`.
export const integer_value = (
  tokens: TokenStream
  text: String
  is_negative: Bool
  position: Position
) ->
  const fail = () -> tokens.fail(position, 'integer literal does not fit in Int')
  const negated = negated_value(text) ? fail()
  return negated if is_negative
  fail() if negated == INT_MIN
  -negated

# The value of a literal's text, decimal or hexadecimal, negated, or nil if that is below the
# minimum Int. It is computed negated since the minimum Int has no positive counterpart.
const negated_value = (text: String) ->
  const is_hex = text.binary.occurs_at(0, '0x'.binary)
  const base = is_hex then 16 else 10
  const digits = is_hex then text.binary.slice(2, text.binary.length) else text.binary
  var value = 0
  for digit in digits
    const digit_value = hex_digit_value(digit)!
    # Division truncates toward zero, so this is the least value that does not overflow.
    return nil if value < (INT_MIN + digit_value) / base
    value = value * base - digit_value
  value

const parse_interpolation = (tokens: TokenStream, token: Token) ->
  const parts = [interpolation_part(tokens.path, part, token.line) for part in token.parts!]
  Interpolation parts, position: token_position(token)

const interpolation_part = (path: String, part: TemplatePart, line: Int): InterpolationPart ->
  case part
    when TextPart then part
    when CodePart then to_string_call(parse_interpolated_code(path, part.source, line, part.column))

const to_string_call = (value: Expression) ->
  const position = value.position
  const callee = Member(position, object: value, name: Identifier(position, name: 'to_string'))
  Call callee, position, args: [], named_args: [], type_args: []

const parse_interpolated_code = (path: String, source: String, line: Int, column: Int) ->
  const fragment = tokenize_fragment(source, path, line, column)
  const tokens = TokenStream(path, tokens: fragment, interpolation: Position(line, column))
  const expression = parse_expression(tokens)
  tokens.expect 'newline', 'end of interpolation'
  expression
