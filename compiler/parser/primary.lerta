# Primary expressions: names, literals, `@`, jumps, and the compound expressions that `compound`
# reads.
import
  BooleanLiteral, Call, Expression, FloatLiteral, Identifier, IntegerLiteral, Interpolation,
  InterpolationPart, Jump, Member, NilLiteral, Position, Return, StringLiteral, This, Throw, Yield
from '../ast'
import at_block from './block_literal'
import
  at_function_literal, at_weak_function_literal, parse_array_literal, parse_case,
  parse_function_literal, parse_map_literal, parse_parenthesized, parse_try
from './compound'
import parse_continued_value, parse_expression, parse_identifier, parse_value from './expression'
import Token, tokenize_fragment, TokenKind from '../lexer/tokens'
import CodePart, TemplatePart, TextPart from '../lexer/string_literal'
import TokenStream from './token_stream'

EXPRESSION_ENDS: TokenKind[] =
  NEWLINE, DEDENT, EOF, 'if', 'unless', 'while', 'until', 'then', 'else', ')', ']', '}', ','

export parse_primary := (tokens: TokenStream): Expression ->
  return parse_function_literal(tokens) if at_function_literal(tokens)
  if at_weak_function_literal(tokens)
    tokens.next()
    return parse_function_literal(tokens, true)
  token := tokens.next()
  position := token.position()
  case token.kind
    when IDENTIFIER then Identifier(position, name: token.text)
    when STRING then StringLiteral(position, value: token.text)
    when INTERPOLATED, BINARY then parse_interpolation(tokens, token)
    when 'nil' then NilLiteral(position)
    when 'break' then Jump(position, kind: 'break')
    when 'continue' then Jump(position, kind: 'continue')
    when 'return'
      value :=
        case
          when at_block(tokens) then parse_value(tokens)
          when ends_expression(tokens) then nil
          else parse_continued_value(tokens)
      Return value, position
    when 'throw' then Throw(position, message: parse_continued_value(tokens))
    when 'yield'
      marks.yields = true if marks := tokens.innermost_function()
      Yield position, value: parse_continued_value(tokens)
    when '@' then parse_this(tokens, position)
    when 'true', 'false' then BooleanLiteral(position, value: token.kind == 'true')
    when 'case' then parse_case(tokens, position)
    when 'try' then parse_try(tokens, position)
    when '[' then parse_array_literal(tokens, position)
    when '{' then parse_map_literal(tokens, position)
    when INTEGER then integer_literal(token.text, position)
    when FLOAT then FloatLiteral(position, text: token.text)
    when '(' then parse_parenthesized(tokens, position)
    else tokens.fail_expecting(token, 'expression')

# `@.x` would be a second way to write `@x` for no gain, so it is an error.
parse_this := (tokens: TokenStream, position: Position): Expression ->
  object := This(position)
  next := tokens.peek()
  tokens.fail next.position(), 'write @x, not @.x' if next.kind == '.'
  return object if next.kind != IDENTIFIER or next.spaced
  Member object, position, name: parse_identifier(tokens)

# Whether the next token ends the expression, so that `return` there has no value.
ends_expression := (tokens: TokenStream) -> tokens.peek_continuation() in EXPRESSION_ENDS

export integer_literal := (text: String, position: Position) ->
  IntegerLiteral position, text, value: integer_value(text)

# The value of an integer literal's text, with its minus, or nil if it is beyond Int, which the
# checker rejects but where a Float is expected.
integer_value := (text: String) ->
  digits := text.without_prefix('-')
  negated := negated_value(digits ? text) ? return nil
  return negated if digits
  negated != INT_MIN then -negated

# The value of a literal's text, decimal or hexadecimal, negated, or nil if that is below the
# minimum Int. It is computed negated since the minimum Int has no positive counterpart.
negated_value := (text: String) ->
  hex_digits := text.without_prefix('0x')
  base := hex_digits then 16 else 10
  digits := (hex_digits ? text).binary
  var value = 0
  for digit in digits
    digit_value := digit.hex_value()!
    # Division truncates toward zero, so this is the least value that does not overflow.
    return nil if value < (INT_MIN + digit_value) / base
    value = value * base - digit_value
  value

parse_interpolation := (tokens: TokenStream, token: Token) ->
  parts := [interpolation_part(tokens, part) for part in token.parts!]
  Interpolation parts, binary: token.kind == BINARY, position: token.position()

interpolation_part := (tokens: TokenStream, part: TemplatePart): InterpolationPart ->
  case part
    when TextPart then part
    when CodePart
      to_string_call parse_interpolated_code(tokens, part.source, part.line, part.column)

to_string_call := (value: Expression) ->
  position := value.position
  callee := Member(position, object: value, name: Identifier(position, name: 'to_string'))
  Call callee, position, args: [], named_args: [], type_args: []

# The code belongs to the function literal around the string, which an `await` in it marks.
parse_interpolated_code := (outer: TokenStream, source: String, line: Int, column: Int) ->
  path := outer.path
  fragment := tokenize_fragment(source, path, line, column)
  tokens := TokenStream(path, tokens: fragment, interpolation: { line, column })
  tokens.functions = outer.functions
  tokens.nesting = outer.nesting
  expression := parse_expression(tokens)
  tokens.expect NEWLINE, 'end of interpolation'
  expression
