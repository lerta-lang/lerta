# Statements: the program, blocks, `const` and `var` declarations, assignments, control flow and
# calls without parentheses; `declaration` reads the other declarations.
import
  Assignment, AssignmentTarget, Binding, Call, Condition, copy_identifier, Declaration, Expression,
  For, Identifier, If, Index, Jump, Member, Return, Statement, Throw, While, Yield
from '../ast'
import starts_weak_function_literal from './compound'
import
  parse_enum, parse_export, parse_extend, parse_extern, parse_import, parse_interface,
  parse_type_alias, parse_type_declaration, starts_type_alias
from './declaration'
import
  call_of, continue_with_members, parse_arguments, parse_block_arguments, parse_expression,
  parse_identifier, parse_loop_header, parse_tuple_names, parse_value, starts_block_arguments,
  take_apart, take_apart_item, tuple_holder
from './expression'
import Token, TokenKind from '../lexer/tokens'
import parse_primary from './primary'
import is_one_of, token_position, TokenStream from './token_stream'
import parse_type_annotation from './type'

const ASSIGNMENT_OPERATORS: TokenKind[] = ['=', '+=', '-=', '*=', '/=', '%=']

const COMMAND_ARGUMENT_STARTS: TokenKind[] =
  '(', '[', '{', IDENTIFIER, INTEGER, FLOAT, STRING, INTERPOLATED, 'true', 'false', 'nil', 'not',
  'case', '->', '@', 'throw', 'await'

# `path` names the source in diagnostics.
export const parse = (tokens: Token[], path: String) ->
  parse_statements TokenStream(tokens, path), EOF

# Statements, one per line, up to the token that ends the block.
const parse_statements = (tokens: TokenStream, end: TokenKind) ->
  const statements: Statement[] = []
  while tokens.peek().kind != end and tokens.peek().kind != EOF
    if at_destructuring(tokens)
      statements.append parse_destructuring_statement(tokens)
    else
      statements.push parse_statement(tokens)
    tokens.expect_line_end()
  statements

# A newline and an indented block of statements.
export const parse_block = (tokens: TokenStream) ->
  tokens.expect NEWLINE, 'end of line'
  tokens.expect INDENT, 'indented block'
  const statements = parse_statements(tokens, DEDENT)
  tokens.expect DEDENT, 'end of block'
  statements

# A statement other than a destructuring declaration (see parse_destructuring_statement).
export const parse_statement = (tokens: TokenStream): Statement ->
  case tokens.peek().kind
    when 'for' then parse_for(tokens)
    when 'while' then parse_while(tokens)
    when 'if' then parse_if(tokens)
    when 'class', 'struct' then parse_type_declaration(tokens)
    when 'enum' then parse_enum(tokens)
    when 'interface' then parse_interface(tokens)
    when 'import' then parse_import(tokens)
    when 'export' then parse_export(tokens)
    when 'extern' then parse_extern(tokens)
    when 'extend' then parse_extend(tokens)
    else
      case
        when starts_type_alias(tokens) then parse_type_alias(tokens)
        when at_declaration(tokens)
          const declaration = parse_declaration(tokens)
          reject_postfix tokens
          declaration
        else parse_postfix_conditions(tokens, parse_simple_statement(tokens))

export const at_declaration = (tokens: TokenStream) ->
  is_one_of(tokens.peek().kind, ['const', 'var']) or at_weak_declaration(tokens)

# `weak` is not a keyword, so that it stays usable as a name.
const at_weak_declaration = (tokens: TokenStream) ->
  tokens.at_word('weak') and is_one_of(tokens.peek_at(1).kind, ['const', 'var'])

export const at_destructuring = (tokens: TokenStream) ->
  at_declaration(tokens) and is_one_of(tokens.peek_at(1).kind, ['{', '('])

# A statement that fits on one line, which postfix `if` and `while` can follow, unless it is a
# declaration.
export const parse_simple_statement = (tokens: TokenStream): Statement ->
  if at_destructuring(tokens)
    const position = token_position(tokens.peek())
    parse_destructuring tokens
    tokens.fail position, 'a destructuring declaration must be on a line of its own'
  return parse_declaration(tokens) if at_declaration(tokens)
  const is_command_call = starts_command_argument(tokens)
  const line_expression: Expression =
    if is_command_call
      parse_command_call tokens
    else
      parse_expression tokens
  const expression =
    if takes_no_member_lines(line_expression)
      line_expression
    else
      continue_with_members tokens, line_expression
  const is_callee = expression is Identifier or expression is Member
  const takes_block_arguments = expression is Call or is_callee
  if takes_block_arguments and starts_block_arguments(tokens)
    return parse_block_arguments(tokens, expression)
  return expression if is_command_call
  const operator = tokens.peek_continuation()
  return expression if not is_one_of(operator, ASSIGNMENT_OPERATORS)
  parse_assignment tokens, expression, operator

# The operand of `return`, `throw` or `yield` has taken the member lines after it already, and a
# jump has no value to continue.
const takes_no_member_lines = (expression: Expression) ->
  const takes_operand = expression is Return or expression is Throw or expression is Yield
  takes_operand or expression is Jump

# A simple statement with the postfix `if`, `while` and `for` that follow it, as on a line of its
# own; a declaration can have none.
export const parse_line_statement = (tokens: TokenStream): Statement ->
  const statement = parse_simple_statement(tokens)
  return parse_postfix_conditions(tokens, statement) if not (statement is Declaration)
  reject_postfix tokens
  statement

# A declaration declares its names for the rest of the block, so no postfix `if` or `while` can
# apply to it.
const reject_postfix = (tokens: TokenStream) ->
  const kind = tokens.peek_continuation()
  return if kind != 'if' and kind != 'while'
  tokens.fail token_position(tokens.peek()), "a declaration cannot have a postfix '#{kind}'"

# `statement if condition`, `statement while condition` and `statement for x in xs when guard`,
# applied from left to right.
const parse_postfix_conditions = (tokens: TokenStream, statement: Statement) ->
  var result = statement
  result = wrapped while const wrapped = wrap_in_postfix_condition(tokens, result)
  result

# The statement in the postfix `if`, `while` or `for` that follows it, or nil if none does.
const wrap_in_postfix_condition = (tokens: TokenStream, statement: Statement): Statement? ->
  const kind = tokens.peek_continuation()
  return wrap_in_for(tokens, statement) if kind == 'for'
  return nil if kind != 'if' and kind != 'while'
  tokens.next()
  const condition = parse_condition(tokens)
  const position = statement.position
  if kind == 'if'
    If condition, position, then_body: [statement], else_body: []
  else
    While condition, position, body: [statement]

const wrap_in_for = (tokens: TokenStream, statement: Statement) ->
  const header = parse_loop_header(tokens)
  const { variable, index, iterable, guard } = header
  const position = statement.position
  const guarded: Statement =
    if guard
      If position, condition: guard, then_body: [statement], else_body: []
    else
      statement
  const body = [take_apart_item(header)..., guarded]
  For variable, iterable, body, position, index

# `[weak] const name[: Type] = value`, or `var`.
const parse_declaration = (tokens: TokenStream) ->
  const position = token_position(tokens.peek())
  const weak = tokens.accept_word('weak')
  const mutable = tokens.next().kind == 'var'
  if weak and is_one_of(tokens.peek().kind, ['{', '('])
    tokens.fail position, 'a destructuring declaration cannot be weak'
  const name = parse_identifier(tokens)
  const type = parse_type_annotation(tokens)
  tokens.expect '=', "'='"
  const value = parse_value(tokens)
  Declaration name, type, value, mutable, position, weak

# `const { a, b } = value`, as the declarations it stands for.
export const parse_destructuring_statement = (tokens: TokenStream) ->
  const declarations = parse_destructuring(tokens)
  reject_postfix tokens
  declarations

# `const { a, b } = value` declares a const that cannot be named (`.` is not allowed in names),
# holding the value, then `a` and `b`, each from the field of its name. `const (a, b) = value`
# takes a tuple apart likewise, by position.
const parse_destructuring = (tokens: TokenStream) ->
  const token = tokens.next()
  const position = token_position(token)
  const mutable = token.kind == 'var'
  if tokens.peek().kind == '('
    const names = parse_tuple_names(tokens)
    const value = parse_held_value(tokens)
    # Where the value is, for the message when it is no tuple of as many items.
    const holder = tuple_holder(value.position)
    return [holding(holder, value), take_apart(holder, names, mutable, false)...]
  tokens.next()
  const names = tokens.parse_list('}', -> parse_identifier(tokens))
  tokens.fail_expecting tokens.peek(), 'a name' if names.length == 0
  const value = parse_held_value(tokens)
  const holder = Identifier(position, name: "destructured.#{position.line}.#{position.column}")
  const field_of = (name: Identifier) ->
    const object = copy_identifier(holder)
    Member object, name: copy_identifier(name), position: name.position
  const declare = (name: Identifier): Statement ->
    Declaration mutable, name, value: field_of(name), position: name.position
  const declarations = [declare(name) for name in names]
  [holding(holder, value), declarations...]

# `= value`, after the names of a destructuring.
const parse_held_value = (tokens: TokenStream) ->
  tokens.expect '=', "'='"
  parse_expression tokens

const holding = (holder: Identifier, value: Expression): Statement ->
  Declaration value, mutable: false, name: holder, position: holder.position

const parse_assignment = (tokens: TokenStream, target: Expression, operator: TokenKind) ->
  const message = 'only a name, an indexed item or a field can be assigned to'
  const assigned = assignment_target(target) ? tokens.fail(target.position, message)
  tokens.next()
  const value = parse_value(tokens)
  Assignment value, operator: operator.to_string(), target: assigned, position: target.position

const assignment_target = (expression: Expression): AssignmentTarget? ->
  case expression
    when Identifier then expression
    when Index then expression
    when Member then expression
    else nil

# A call without parentheses, allowed only at the start of a statement: `f x`, `xs.push x`.
# `f -1` is `f(-1)`, but `f - 1` is a subtraction.
# `weak ->` starts a weak function literal, not a call of `weak`.
const starts_command_argument = (tokens: TokenStream) ->
  return false if starts_weak_function_literal(tokens)
  const callee_length = command_callee_length(tokens)
  callee_length > 0 and starts_spaced_operand(tokens, callee_length)

# Whether the token at the offset, after a word, starts an operand of it rather than continuing an
# expression with the word: spaced from it, and no binary operator.
export const starts_spaced_operand = (tokens: TokenStream, offset: Int) ->
  const token = tokens.peek_at(offset)
  return false if not token.spaced
  return not tokens.peek_at(offset + 1).spaced if token.kind == '-'
  # `is` and `as` are not keywords, but `x is T` is a test and `x as T?` a cast, not calls of x.
  return false if token.kind == IDENTIFIER and (token.text == 'is' or token.text == 'as')
  is_one_of token.kind, COMMAND_ARGUMENT_STARTS

# The number of tokens of the callee of a call without parentheses at the next token: a name or
# `@name`, followed by any number of `.name`, all without spaces; 0 if there is none.
const command_callee_length = (tokens: TokenStream) ->
  const first = tokens.peek().kind
  var length =
    case
      when first == IDENTIFIER then 1
      when first == '@' and is_attached_name(tokens.peek_at(1)) then 2
      else 0
  return 0 if length == 0
  while tokens.peek_at(length).kind == '.' and not tokens.peek_at(length).spaced
    return 0 if not is_attached_name(tokens.peek_at(length + 1))
    length += 2
  length

const is_attached_name = (token: Token) -> token.kind == IDENTIFIER and not token.spaced

# `f x, y`: the arguments run to the end of the line.
const parse_command_call = (tokens: TokenStream) ->
  var callee = parse_primary(tokens)
  const position = callee.position
  callee = Member(position, object: callee, name: parse_identifier(tokens)) while tokens.accept('.')
  call_of callee, parse_arguments(tokens), []

# `for <name>[, <index>] in <expression>` followed by an indented block.
const parse_for = (tokens: TokenStream) ->
  const position = token_position(tokens.peek())
  const header = parse_loop_header(tokens)
  const { variable, index, iterable, guard } = header
  if guard
    const message = "a for loop with a block has no 'when'; write an if in the block"
    tokens.fail guard.position, message
  const body = [take_apart_item(header)..., parse_block(tokens)...]
  For variable, iterable, position, index, body

# A condition, or `const name = value`, which holds when the value is not nil.
const parse_condition = (tokens: TokenStream): Condition ->
  const token = tokens.peek()
  return parse_expression(tokens) if token.kind != 'const'
  tokens.next()
  const name = parse_identifier(tokens)
  tokens.expect '=', "'='"
  Binding name, value: parse_expression(tokens), position: token_position(token)

const parse_while = (tokens: TokenStream) ->
  const position = token_position(tokens.next())
  const condition = parse_condition(tokens)
  While condition, position, body: parse_block(tokens)

# `if` with an optional `else` block; `else if` chains further.
export const parse_if = (tokens: TokenStream): If ->
  const position = token_position(tokens.next())
  const condition = parse_condition(tokens)
  const then_body = parse_block(tokens)
  return If(condition, then_body, position, else_body: []) if tokens.peek().kind != 'else'
  tokens.next()
  const else_body: Statement[] =
    if tokens.peek().kind == 'if'
      [parse_if(tokens)]
    else
      parse_block tokens
  If condition, then_body, else_body, position
