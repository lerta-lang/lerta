# Statements: the program, blocks, the declarations of consts and `var`s, assignments, control flow
# and calls without parentheses; `declaration` reads the other declarations.
import
  ArrayLiteral, ArrayTypeName, Assignment, AssignmentTarget, Binding, Call, Condition, Conditional,
  Declaration, Expression, For, Identifier, If, Index, Jump, Member, NamedType, NilLiteral,
  OMITTED_VALUES, Return, Statement, Throw, TypeName, UnaryOperation, While, Yield
from '../ast'
import accept_pass_block, at_weak_function_literal from './compound'
import
  at_type_alias, parse_enum, parse_export, parse_extend, parse_extern, parse_import,
  parse_intrinsic, parse_interface, parse_type_alias, parse_type_declaration
from './declaration'
import
  at_block_arguments, call_of, COMPARISON_WORDS, continue_with_members, operator_at,
  parse_arguments, parse_block_arguments, parse_expression, parse_identifier, parse_loop_header,
  at_destructuring_names, destructured_holder, parse_destructuring_names, parse_value,
  take_apart_held, take_apart_item
from './expression'
import compile_errors, CompileError, Located from '../errors'
import Token, TokenKind from '../lexer/tokens'
import parse_primary from './primary'
import TokenStream from './token_stream'
import parse_type_annotation from './type'

ASSIGNMENT_OPERATORS: TokenKind[] = ['=', '+=', '-=', '*=', '/=', '%=', '&=', '|=', '^=', '**=']

COMMAND_ARGUMENT_STARTS: TokenKind[] =
  '(', '[', '{', IDENTIFIER, INTEGER, FLOAT, STRING, INTERPOLATED, BINARY, 'true', 'false', 'nil',
  'not', 'case', '->', '@', 'throw', 'await', '~'

# `path` names the source in diagnostics. An error ends the parsing of its top-level statement
# alone, so that those after it are parsed for their errors too; the errors are thrown together.
export parse := (tokens: Token[], path: String) ->
  parsed := parse_program(tokens, path, false)
  throw compile_errors(parsed.errors) unless parsed.errors.is_empty()
  parsed.statements

# The statements that parse, and the errors of those that do not.
export struct Parsed
  statements: Statement[]
  errors: Located[]

# Parses as parse does, but gives the statements that parse along with the errors, for an editor:
# an error ends the parsing of its statement alone in a block too, so that the rest of the block is
# checked while the statement is being written.
export parse_partially := (tokens: Token[], path: String) -> parse_program(tokens, path, true)

parse_program := (tokens: Token[], path: String, in_blocks: Bool) ->
  stream := TokenStream(tokens, path)
  statements: Statement[]
  errors: Located[]
  stream.block_errors = errors if in_blocks
  while stream.peek().kind != EOF
    parse_line_or_skip stream, statements, errors
  Parsed(statements, errors)

# Statements, one per line, up to the token that ends the block.
parse_statements := (tokens: TokenStream, end: TokenKind) ->
  statements: Statement[]
  errors := tokens.block_errors
  before := errors?.length else 0
  at_end := -> tokens.peek().kind in [end, EOF]
  until at_end()
    if errors
      parse_line_or_skip tokens, statements, errors
    else
      parse_line tokens, statements

  # The checker takes a block to have a statement: one whose statements all fail fails itself, and
  # so does the statement that holds it.
  if errors and statements.is_empty() and errors.length > before
    own := errors[before..]
    errors.truncate before
    throw compile_errors(own)
  statements

# Parses the line into `statements`, or, on an error found where it is, keeps it in `errors` and
# skips the statement.
parse_line_or_skip := (tokens: TokenStream, statements: Statement[], errors: Located[]) ->
  start := tokens.mark()
  try
    parse_line tokens, statements
  catch error: CompileError
    # The lexer and the parser throw only errors where they are found (see compile_error); one of
    # no module, if anything below threw it, ends the parsing as it ends the build, rather than
    # being lost among them.
    throw error if error.errors.is_empty()
    errors.append error.errors
    tokens.skip_to_next_statement start

# The statements of a line, into `statements`: one, or the declarations of a destructuring.
parse_line := (tokens: TokenStream, statements: Statement[]) ->
  if at_destructuring(tokens)
    statements.append parse_destructuring_statement(tokens)
  else
    statements.push parse_statement(tokens)
  tokens.expect_line_end()

# A newline and an indented block of statements.
export parse_block := (tokens: TokenStream): Statement[] ->
  return [pass] if pass := accept_pass_block(tokens)
  tokens.expect NEWLINE, 'end of line'
  tokens.expect INDENT, 'indented block'
  statements := tokens.outside_then_value(-> parse_statements(tokens, DEDENT))
  tokens.expect DEDENT, 'end of block'
  statements

# A statement other than a destructuring declaration (see parse_destructuring_statement).
export parse_statement := (tokens: TokenStream): Statement ->
  case tokens.peek().kind
    when 'for' then parse_for(tokens)
    when 'while', 'until' then parse_while(tokens)
    when 'if' then parse_if(tokens)
    when 'unless' then parse_unless(tokens)
    when 'class', 'struct' then parse_type_declaration(tokens)
    when 'enum' then parse_enum(tokens)
    when 'interface' then parse_interface(tokens)
    when 'import' then parse_import(tokens)
    when 'export' then parse_export(tokens)
    when 'extern' then parse_extern(tokens)
    when 'intrinsic' then parse_intrinsic(tokens)
    when 'extend' then parse_extend(tokens)
    else
      case
        when at_type_alias(tokens) then parse_type_alias(tokens)
        when at_declaration(tokens)
          declaration := parse_declaration(tokens)
          reject_postfix tokens
          declaration
        else parse_postfix_conditions(tokens, parse_simple_statement(tokens))

export at_declaration := (tokens: TokenStream) ->
  at_bare := at_named_declaration(tokens, 0) or at_bare_destructuring(tokens, 0)
  tokens.peek().kind == 'var' or at_weak_declaration(tokens) or at_bare

# `weak` before a declaration, or before a destructuring, which parse_declaration rejects.
at_weak_declaration := (tokens: TokenStream) ->
  at_bare := at_named_declaration(tokens, 1) or at_bare_destructuring(tokens, 1)
  tokens.at_word('weak') and (tokens.peek_at(1).kind == 'var' or at_bare)

# `name := value`, `name: Type = value` or `name: Type`, at `offset`.
at_named_declaration := (tokens: TokenStream, offset: Int) ->
  name_follows := tokens.peek_at(offset).kind == IDENTIFIER
  name_follows and tokens.peek_at(offset + 1).kind in [':=', ':']

export at_destructuring := (tokens: TokenStream) ->
  after_var := tokens.peek().kind == 'var' and tokens.peek_at(1).kind in ['{', '(']
  after_var or at_bare_destructuring(tokens, 0)

# `{ a, b } := value` or `(a, b) := value`, which only `:=` after the names tells from an
# expression.
at_bare_destructuring := (tokens: TokenStream, offset: Int) ->
  closing := names_closing_offset(tokens, offset) else return false
  tokens.peek_at(closing + 1).kind == ':='

# The offset of the `}` or `)` that closes names to take apart, `{ a, b }` or `(a, b)`, at the
# offset; nil if no such names are there.
export names_closing_offset := (tokens: TokenStream, offset: Int) ->
  open := tokens.peek_at(offset).kind
  return nil unless open in ['{', '(']
  close: TokenKind = open == '{' then '}' else ')'
  tokens.closing_offset(open, close, is_name_list_token, offset)

is_name_list_token := (kind: TokenKind) ->
  kind in [IDENTIFIER, ',', NEWLINE, INDENT, DEDENT, '{', '}', '(', ')']

# A statement that fits on one line, which postfix `if` and `while` can follow, unless it is a
# declaration.
export parse_simple_statement := (tokens: TokenStream): Statement ->
  if at_destructuring(tokens)
    position := tokens.peek().position()
    parse_destructuring tokens
    tokens.fail position, 'a destructuring declaration must be on a line of its own'
  return parse_declaration(tokens) if at_declaration(tokens)
  is_command_call := at_command_argument(tokens)
  line_expression: Expression =
    if is_command_call
      parse_command_call tokens
    else
      parse_expression tokens
  expression :=
    if takes_no_member_lines(line_expression)
      line_expression
    else
      continue_with_members tokens, line_expression
  return parse_block_arguments(tokens, expression) if at_block_arguments(tokens, expression)
  return expression if is_command_call
  operator := operator_at(tokens, ASSIGNMENT_OPERATORS, '=') else return expression
  parse_assignment(tokens, expression, operator)

# The operand of `return`, `throw` or `yield` has taken the member lines after it already, and a
# jump has no value to continue.
takes_no_member_lines := (expression: Expression) ->
  takes_operand := expression is Return | Throw | Yield
  takes_operand or expression is Jump

# A simple statement with the postfix `if`, `while` and `for` that follow it, as on a line of its
# own; a declaration can have none.
export parse_line_statement := (tokens: TokenStream): Statement ->
  statement := parse_simple_statement(tokens)
  return parse_postfix_conditions(tokens, statement) unless statement is Declaration
  reject_postfix tokens
  statement

POSTFIX_CONDITIONS: TokenKind[] = ['if', 'unless', 'while', 'until']

# A declaration declares its names for the rest of the block, so no postfix `if` or `while` can
# apply to it.
reject_postfix := (tokens: TokenStream) ->
  kind := tokens.peek_continuation()
  return unless kind in POSTFIX_CONDITIONS
  tokens.fail_here "a declaration cannot have a postfix '#{kind}'"

# `statement if condition`, `statement while condition` and `statement for x in xs when guard`,
# applied from left to right.
parse_postfix_conditions := (tokens: TokenStream, statement: Statement) ->
  nesting := tokens.nesting
  var result = statement
  while wrapped := wrap_in_postfix_condition(tokens, result)
    tokens.deepen()
    result = wrapped
  tokens.nesting = nesting
  result

# The statement in the postfix `if`, `while` or `for` that follows it, or nil if none does.
wrap_in_postfix_condition := (tokens: TokenStream, statement: Statement): Statement? ->
  kind := tokens.peek_continuation()
  return wrap_in_for(tokens, statement) if kind == 'for'
  return nil unless kind in POSTFIX_CONDITIONS
  tokens.next()
  (written, parts) := parse_written_condition(tokens, kind)
  condition := condition_of(written, kind)
  position := statement.position
  body := [parts..., statement]
  if kind in ['if', 'unless']
    If(condition, position, then_body: body, else_body: [])
  else
    While(condition, body, position)

wrap_in_for := (tokens: TokenStream, statement: Statement) ->
  header := parse_loop_header(tokens)
  { variable, index, iterable, guard } := header
  position := statement.position
  guarded: Statement =
    if guard
      If position, condition: guard, then_body: [statement], else_body: []
    else
      statement
  body := [take_apart_item(header)..., guarded]
  For(variable, iterable, body, position, index)

# `[weak] name := value` or `[weak] name: Type = value`, or `var` before a name, which takes `=`.
parse_declaration := (tokens: TokenStream) ->
  position := tokens.peek().position()
  weak := at_weak_declaration(tokens) and tokens.accept_word('weak')
  mutable := tokens.accept('var')
  if weak and tokens.peek().kind in ['{', '(']
    tokens.fail position, 'a destructuring declaration cannot be weak'
  name := parse_identifier(tokens)
  type := parse_type_annotation(tokens)
  tokens.fail_expecting tokens.peek(), "'='" if mutable and tokens.peek().kind == ':='

  # Without a value, one whose type is written as `T[]`, `Map<K, V>` or `Set<T>` starts empty, and
  # a `var` of another type at nil, which the checker rejects for a type that nil does not fit.
  omits_value := mutable and tokens.peek().kind != '='
  if omits_value or (type and tokens.peek().kind == NEWLINE)
    tokens.fail_here "a var without a type needs an initial value: #{OMITTED_VALUES}" if type == nil
    message := "expected '=': only a const whose type is written as T[], Map<K, V> or Set<T> " +
      'starts empty'
    empty := empty_value(type)
    value := empty else (omits_value then NilLiteral(name.position) else tokens.fail_here(message))

    # The type of an empty Map or Set goes to its type arguments, as the formatter writes it.
    written := value is Call then nil else type
    return Declaration(name, value, mutable, position, weak, omits_value, type: written)

  # A type, as `var` does, tells a declaration from an assignment; `:=` does without.
  operator: TokenKind = mutable or type then '=' else ':='
  tokens.expect operator

  value := parse_value(tokens)
  Declaration(name, type, value, mutable, position, weak)

# `[]`, or `Map<K, V>()` or `Set<T>()`, for a const or a `var` of the type that is written without a
# value.
empty_value := (type: TypeName): Expression? ->
  at := type.position
  if type is ArrayTypeName and not type.optional
    return ArrayLiteral(position: at, elements: [])
  named := type as NamedType else return nil
  return nil if named.optional or named.name not in ['Map', 'Set']
  callee := Identifier(position: at, name: named.name)
  Call(callee, position: at, args: [], named_args: [], type_args: named.args, makes_builtin: true)

# `{ a, b } := value`, as the declarations it stands for.
export parse_destructuring_statement := (tokens: TokenStream) ->
  declarations := parse_destructuring(tokens)
  reject_postfix tokens
  declarations

# `{ a, b } := value` declares a const that cannot be named (`.` is not allowed in names), holding
# the value, then `a` and `b`, each from the field of its name. `(a, b) := value` takes a tuple
# apart likewise, by position. `var` before the names declares them so, and takes `=`.
parse_destructuring := (tokens: TokenStream) ->
  position := tokens.peek().position()
  mutable := tokens.accept('var')
  operator: TokenKind = mutable then '=' else ':='
  destructuring := parse_destructuring_names(tokens)
  value := parse_held_value(tokens, operator)

  # A tuple's is where the value is, for the message when it is no tuple of as many items.
  holder :=
    destructured_holder(destructuring, destructuring.of_tuple then value.position else position)
  [holding(holder, value), take_apart_held(destructuring, holder, mutable)...]

# `= value` or `:= value`, after the names of a destructuring, which may take lines as that of a
# declaration.
parse_held_value := (tokens: TokenStream, operator: TokenKind) ->
  tokens.expect operator
  parse_value(tokens)

holding := (holder: Identifier, value: Expression): Statement ->
  Declaration(value, mutable: false, name: holder, position: holder.position)

parse_assignment := (tokens: TokenStream, target: Expression, operator: String) ->
  message := 'only a name, an indexed item or a field can be assigned to'
  assigned := assignment_target(target) else tokens.fail(target.position, message)
  value := parse_value(tokens)
  Assignment(value, operator, target: assigned, position: target.position)

assignment_target := (expression: Expression): AssignmentTarget? ->
  case expression
    when Identifier, Index, Member then expression
    else nil

# `weak ->` starts a weak function literal, not a call of `weak`.
at_command_argument := (tokens: TokenStream) ->
  return false if at_weak_function_literal(tokens)
  callee_length := command_callee_length(tokens)
  callee_length > 0 and at_spaced_operand(tokens, callee_length)

# Whether the token at the offset, after a word, starts an operand of it rather than continuing an
# expression with the word: spaced from it, and no binary operator.
export at_spaced_operand := (tokens: TokenStream, offset: Int) ->
  token := tokens.peek_at(offset)
  return false unless token.spaced
  return not tokens.peek_at(offset + 1).spaced if token.kind == '-'

  # A comparison, not a call of the word.
  return false if COMPARISON_WORDS.any(token.is_word)
  return false if token.kind == 'not' and tokens.peek_at(offset + 1).is_word('in')

  token.kind in COMMAND_ARGUMENT_STARTS

# The number of tokens of the callee of a call without parentheses at the next token: a name or
# `@name`, followed by any number of `.name`, all without spaces; 0 if there is none. The tokens
# are walked by their index, as a peek at each offset would walk from the start each time.
command_callee_length := (tokens: TokenStream) ->
  var index = tokens.index_at(0)
  token := -> tokens.tokens[index]
  advance := -> index = tokens.index_after(index)
  var length = 1
  if token().kind == '@'
    advance()
    return 0 unless is_attached_name(token())
    length = 2
  else if token().kind != IDENTIFIER
    return 0
  advance()
  while token().kind == '.' and not token().spaced
    advance()
    return 0 unless is_attached_name(token())
    advance()
    length += 2
  length

is_attached_name := (token: Token) -> token.kind == IDENTIFIER and not token.spaced

# `f x, y`: the arguments run to the end of the line.
parse_command_call := (tokens: TokenStream) ->
  var callee = parse_primary(tokens)
  position := callee.position
  nesting := tokens.nesting
  while tokens.accept('.')
    tokens.deepen()
    callee = Member(position, object: callee, name: parse_identifier(tokens))
  tokens.nesting = nesting
  call_of(callee, parse_arguments(tokens), [])

# `for` and its loop header (see LoopHeader), followed by an indented block.
parse_for := (tokens: TokenStream) ->
  position := tokens.peek().position()
  header := parse_loop_header(tokens)
  { variable, index, iterable, guard } := header
  if guard
    message := "a for loop with a block has no 'when'; write an if in the block"
    tokens.fail guard.position, message
  body := take_apart_item(header) + parse_block(tokens)
  For(variable, iterable, position, index, body)

# A condition, or `name := value`, which holds when the value is not nil, with no parts; or
# `{ a, b } := value` or `(a, b) := value`, which binds a holder (see destructured_holder) and
# whose parts, the declarations of the names, start the body.
parse_condition := (tokens: TokenStream): (Condition, Statement[]) ->
  token := tokens.peek()
  position := token.position()
  if at_destructuring_names(tokens) and at_destructuring(tokens)
    destructuring := parse_destructuring_names(tokens)
    tokens.next()
    value := parse_expression(tokens)
    holder :=
      destructured_holder(destructuring, destructuring.of_tuple then value.position else position)
    return (Binding(value, position, name: holder), take_apart_held(destructuring, holder, false))
  return (parse_expression(tokens), []) unless at_binding(tokens)
  name := parse_identifier(tokens)
  tokens.next()
  (Binding(name, position, value: parse_expression(tokens)), [])

at_binding := (tokens: TokenStream) ->
  tokens.peek().kind == IDENTIFIER and tokens.peek_at(1).kind == ':='

# The condition as written after the keyword, which binds no name after `unless` or `until`, and
# the parts of a destructuring one (see parse_condition).
parse_written_condition := (tokens: TokenStream, kind: TokenKind): (Condition, Statement[]) ->
  return parse_condition(tokens) if kind in ['if', 'while']
  tokens.fail_here "'#{kind}' cannot bind a name" if at_binding(tokens) or at_destructuring(tokens)
  (parse_expression(tokens), [])

condition_of := (written: Condition, kind: TokenKind) ->
  return written if kind in ['if', 'while']

  # No name is bound after `unless` or `until` (see parse_written_condition).
  assert written is Expression
  UnaryOperation(operand: written, operator: 'not', position: written.position)

# The condition after the keyword of a statement with a block, and the block. `if c then a else b`
# takes `c then a else b` for the condition of a block that is missing, which the error says.
parse_head_and_block := (tokens: TokenStream, keyword: Token) ->
  (written, parts) := parse_written_condition(tokens, keyword.kind)
  value := written is Binding then written.value else written
  has_block := tokens.peek().kind == NEWLINE and tokens.peek_at(1).kind == INDENT
  if value is Conditional and not has_block
    word := keyword.kind.to_string()
    message :=
      "'#{word}' takes a block below it; write a value as 'c then a else b', without '#{word}'"
    tokens.fail keyword.position(), message
  (condition_of(written, keyword.kind), parts + parse_block(tokens))

parse_while := (tokens: TokenStream) ->
  token := tokens.next()
  (condition, body) := parse_head_and_block(tokens, token)
  While(condition, body, position: token.position())

# `unless`, which takes no `else`: `if` reads better with one.
parse_unless := (tokens: TokenStream) ->
  keyword := tokens.next()
  position := keyword.position()
  (condition, then_body) := parse_head_and_block(tokens, keyword)
  tokens.fail_here "an 'unless' cannot have an 'else'" if tokens.peek().kind == 'else'
  If(condition, then_body, position, else_body: [])

# `if` with an optional `else` block; `else if` chains further.
export parse_if := (tokens: TokenStream): If ->
  keyword := tokens.next()
  position := keyword.position()
  (condition, then_body) := parse_head_and_block(tokens, keyword)
  if tokens.peek().kind != 'else'
    return If(condition, then_body, position, else_body: [])
  tokens.next()
  tokens.fail_here "an 'unless' cannot follow 'else'" if tokens.peek().kind == 'unless'
  else_body: Statement[] =
    if tokens.peek().kind == 'if'
      [tokens.nested(-> parse_if(tokens))]
    else
      parse_block tokens
  If(condition, then_body, else_body, position)
