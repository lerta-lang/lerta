# Runs clang once for each list of arguments in `jobs`, as many at once as there are CPUs; false if
# it fails for any, after which no more are started.
import cpu_count, run from 'std:process'

export run_clang_jobs := (jobs: String[][]) ->
  var next = 0
  var failed = false
  # Each runs the next job until none is left, or one has failed.
  worker := ->
    while not failed and next < jobs.length
      args := jobs[next]
      next += 1
      failed = true if (await run('clang', args...)).code != 0
  workers := [worker() for _ in 0..cpu_count]
  # Each is waited for, even after one has thrown, so that none still writes into a
  # directory that the caller removes afterwards.
  var error: Error?
  for each in workers
    try
      await each
    catch thrown
      error = thrown
  throw thrown if thrown := error
  not failed
