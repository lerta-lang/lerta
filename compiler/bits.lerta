# The bits of an Int as 16 upper-case hex digits, a negative one's too, which to_hex throws for:
# its two halves, each of which fits in a non-negative Int.
export bits_hex := (bits: Int) ->
  high := bits >> 32 & 0xFFFFFFFF
  low := bits & 0xFFFFFFFF
  "#{high.to_hex(8)}#{low.to_hex(8)}".to_upper()
