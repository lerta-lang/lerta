# Checks how a function gives its result: its last statement and its `return`s.
import Await, Expression, FunctionLiteral, If, Position, Return, Statement, Yield from '../ast'
import fail from './diagnostics'
import type_of from './expression'
import converts_through_itab from './interface_values'
import Body, FunctionContext, NodeFacts, ProgramWide from './shared'
import check_discarded, check_statement from './statement'
import
  format_type, FunctionType, is_assignable, is_kind, IterType, nil_type, PromiseType, settles_into,
  Type, unify, void_type
from '../types'

# The context of a function's body, whose written return type, if any, is `annotated`. That of a
# function that yields must be an Iter, whose items the yielded values must fit, and that of a
# function that awaits a Promise, whose value the returned values must fit.
export function_context := (program: ProgramWide, literal: FunctionLiteral, annotated: Type?) ->
  { yields, awaits } := literal
  fail_here := (message: String) -> fail(program, literal.position, message)
  fail_here 'a function cannot both yield and await yet' if yields and awaits
  if yields
    if annotated and annotated is not IterType
      fail_here 'a function that yields returns an Iter, as in `(): Iter<Int> ->`'
    return FunctionContext(literal, yields, awaits, annotated: (annotated as IterType?)?.item)
  if awaits
    if annotated and annotated is not PromiseType
      fail_here 'a function that awaits returns a Promise, as in `(): Promise<Int> ->`'
    return FunctionContext(literal, yields, awaits, annotated: (annotated as PromiseType?)?.value)
  FunctionContext(literal, annotated, yields, awaits)

export check_last_statement := (body: Body, statement: Statement) ->
  context := body.context!
  if context.yields
    check_statement body, statement
    return
  if promise := undecided_promise(context)
    if is_kind(promise.value, 'void') and statement is not Return
      check_last_of_void_promise body, statement, promise
      return
  annotated := context.annotated
  expects_value := annotated != nil and not is_kind(annotated, 'void')

  # Written, or told by a `return` alone before it, the result is void: the last statement's value,
  # if any, is not used.
  gives_none := annotated == void_type or (annotated == nil and context.inferred == void_type)

  var gives_value = false
  value := value_of(statement)
  if value and expects_value
    record_result body, type_of_result(body, value), value
    gives_value = true
  else if value and not gives_none
    type := type_of(body, value)
    gives_value = not is_kind(type, 'void')
    if gives_value
      record_result body, type, value
    else
      check_discarded body, value, type
  else
    check_statement body, statement
  result := context.annotated ? context.inferred ? void_type
  if not is_kind(result, 'void') and not gives_value and statement is not Return
    reject_missing_result body, statement, result

reject_missing_result := (body: Body, statement: Statement, result: Type) ->
  value := "its return value of type #{format_type(result)}"
  message := "the function must end with #{value} or a return"
  fail body.program, statement.position, message

# The last statement of a function that returns a Promise of no value without awaiting: a value
# that is a Promise, or never ends, is its result, and another settles the Promise, as a statement
# that gives no value does unless a `return` in it has told that the function returns Promises.
check_last_of_void_promise := (body: Body, statement: Statement, promise: PromiseType) ->
  context := body.context!
  if value := value_of(statement)
    type := type_of(body, value)
    if type is PromiseType or is_kind(type, 'never')
      record_result body, type, value
      return
    decide_settling context, true, promise
    check_discarded body, value, type
    return
  check_statement body, statement
  if undecided_promise(context)
    decide_settling context, true, promise
  else if context.settles == false
    reject_missing_result body, statement, promise

# The Promise that a function returns without awaiting, while its results have not told whether it
# settles that Promise with them or returns the Promises they are. The first result that is no
# Promise and does not end the function tells that it settles it; one that is a Promise, that it
# returns them; a function whose results all end it, as throws, settles it.
export undecided_promise := (context: FunctionContext) ->
  return nil if context.awaits or context.yields or context.settles != nil
  context.annotated as PromiseType?

# Decides whether the function settles its Promise: its results must then fit the Promise's value.
decide_settling := (context: FunctionContext, settles: Bool, promise: PromiseType) ->
  context.settles = settles
  context.annotated = promise.value if settles

# The statement as a value: an `if` without an `else` gives none, so it ends a function as a
# statement does.
value_of := (statement: Statement) ->
  return nil if statement is If and statement.else_body.is_empty()
  statement as Expression?

# Values are converted to the return type when the function is done.
record_result := (body: Body, type: Type, at: Expression) ->
  context := body.context!
  unless at is Return
    context.results.push { type, value: at }
  if promise := undecided_promise(context)
    unless is_kind(type, 'never')
      decide_settling context, type is not PromiseType, promise
  if annotated := context.annotated
    return if is_assignable(type, annotated) or settles_into(type, annotated)
    return if converts_through_itab(body, at, type, annotated)
    reject_result body, annotated, type, at.position
  inferred := context.inferred
  if inferred == nil
    context.inferred = type
    return
  context.inferred = unify(inferred, type) ? reject_result(body, inferred, type, at.position)

reject_result := (body: Body, expected: Type, type: Type, at: Position) ->
  kind := body.context!.yields then 'a yielded value' else 'a return value'
  value := "#{kind} of type #{format_type(expected)}"
  message := "expected #{value}, got #{format_type(type)}"
  fail body.program, at, message

export check_return := (body: Body, return_expression: Return) ->
  outside := -> fail(body.program, return_expression.position, "'return' outside a function")
  context := body.context ? outside()
  value := return_expression.value
  if context.yields
    return if value == nil
    fail body.program, value.position, 'a function that yields returns no value'
  type: Type =
    if value
      type_of_result body, value
    else
      void_type
  record_result body, type, value ? return_expression

# A promise's value, once it is settled. What waits for it is the top-level code, which the module
# records, or a function that awaits, which its parser marks as such unless the `await` runs
# elsewhere, as in a lazy comprehension.
export type_of_await := (body: Body, await_expression: Await) ->
  program := body.program
  at := await_expression.position
  if context := body.context
    unless context.awaits
      fail program, at, "'await' cannot be in a lazy comprehension"
  else
    # A field's value is computed by the constructor, which does not wait.
    if body.self
      fail program, at, "'await' cannot be in a field's value"
    body.shared.top_level_awaits = true
  operand := await_expression.operand
  type := type_of(body, operand)
  body.awaits += 1
  body.scopes.forget_outer_var_views()
  return type.value if type is PromiseType
  return type if is_kind(type, 'never')
  fail(program, operand.position, "expected a Promise, got #{format_type(type)}")

# A yielded value must fit the item type, as a return value fits the return type.
VOID_ELEMENT := 'an Iter cannot hold values of type void'

export check_yield := (body: Body, yield_expression: Yield) ->
  if body.context == nil
    fail body.program, yield_expression.position, "'yield' outside a function"
  value := yield_expression.value
  type := type_of_result(body, value)
  if is_kind(type, 'void')
    message :=
      yield_expression.of_element then VOID_ELEMENT else 'cannot yield a value of type void'
    fail body.program, value.position, message
  record_result body, type, value

# A written return type is a hint for the value's type, which can type `[]` and literals; the
# value is then checked as a return value, for a message that says so. Until a function that returns
# a Promise without awaiting is known to return Promises, the hint is the Promise's value, which
# a result that settles it may need, as `[]` or the arms of `then` do, while a Promise is mostly
# what a call gives, which needs none.
type_of_result := (body: Body, value: Expression) ->
  context := body.context!
  promise := undecided_promise(context)
  annotated := promise then promise.value else context.annotated
  hint :=
    if annotated
      if not is_kind(annotated, 'void')
        annotated
      else
        nil
    else
      nil
  type_of(body, value, hint)

# The type of a function once its body is checked: its return type is the written one, or the one
# its results give, to which they are converted; that of a function that yields is an Iter of its
# item type, decided so, and that of one that awaits, or settles its Promise, a Promise of its
# result. Its result may be nil
# alone, which gives no type, as may its items, if it yields nothing else: see reject_nil_result.
export finish_function_type := (context: FunctionContext, params: Type[], facts: NodeFacts) ->
  # No result told, as none ends without a throw: a throw then rejects the Promise.
  if promise := undecided_promise(context)
    decide_settling context, true, promise
  unknown := context.yields then nil_type else void_type
  result := context.annotated ? context.inferred ? unknown
  for each in context.results
    is_converted := not is_kind(each.type, 'never') and each.type != result
    facts.conversions[each.value] = result if is_converted
  facts.results[context.literal] = [each.value for each in context.results]
  wrapped: Type =
    case
      when context.yields then IterType(result)
      when context.awaits then PromiseType(result)
      when context.settles == true
        facts.settling.add context.literal
        PromiseType result
      else result
  FunctionType(params, result: wrapped)

# A function of an item leaves rejecting results of only nil to its caller, which tells what would
# hold its results (see check_value_type).
export reject_nil_result := (program: ProgramWide, type: FunctionType, literal: FunctionLiteral) ->
  if is_kind(type.result, 'nil')
    message := 'nil alone does not give the return type; write it, as in `(): String? ->`'
    fail program, literal.position, message
  result := type.result
  if result is PromiseType and literal.awaits and is_kind(result.value, 'nil')
    example := '`(): Promise<String?> ->`'
    message := "nil alone does not give the return type; write it, as in #{example}"
    fail program, literal.position, message
  if result is IterType and literal.yields and is_kind(result.item, 'nil')
    example := '`(): Iter<Int> ->`'
    message := "the yielded values do not give the item type; write it, as in #{example}"
    fail program, literal.position, message
  type
