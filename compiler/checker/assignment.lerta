# Checks assignments: to a name, to an indexed item and to a field.
import { Assignment, Identifier, Index, Member } from '../ast'
import { fail } from './diagnostics'
import { expect_type, type_of } from './expression'
import { lookup } from './name'
import { field_target } from './object'
import { Body } from './shared'
import { reject_pending } from './top_level_values'
import { format_type, is_kind, is_one_of_kinds, MapType, Type } from '../types'

# Compound assignments such as `+=` apply to an Int or a Byte, and `+=` to a String too.
export const check_assignment = (body: Body, assignment: Assignment): void ->
  const { target, operator } = assignment
  const target_type = case target
    when Index then check_item_target(body, target, operator)
    when Member then field_target(body, target)
    when Identifier then check_variable_target(body, target)
  const is_append = operator == '+='
  const kinds = is_append then ['Int', 'Byte', 'String'] else ['Int', 'Byte']
  if operator != '=' and not is_one_of_kinds(target_type, kinds)
    const expected = is_append then 'Int, Byte or String' else 'Int or Byte'
    const message = "expected #{expected}, got #{format_type(target_type)}"
    fail(body.program, target.position, message)
  expect_type(body, assignment.value, target_type)

# Array items and map values can be replaced; a Binary is immutable. A map's key may be missing,
# so its value cannot be combined with `+=` and so on.
const check_item_target = (body: Body, target: Index, operator: String): Type ->
  const type = type_of(body, target, nil)
  const object_type = body.shared.types[target.object]!
  if object_type is MapType
    if operator != '='
      const combined = operator.binary.slice(0, operator.binary.length - 1).decode_utf8()!
      const advice = "write m[k] = (m[k] ? 0) #{combined} x"
      const message = "a map value cannot be updated with '#{operator}'; #{advice}"
      fail(body.program, target.position, message)
    return object_type.value
  if is_kind(object_type, 'Binary')
    fail(body.program, target.position, 'a Binary cannot be changed')
  type

const check_variable_target = (body: Body, target: Identifier): Type ->
  const local = lookup(body, target.name)
  reject_pending(body.program, body.shared.top_level, target) if body.sees_top_level
  const reject = (reason: String): never ->
    fail(body.program, target.position, "'#{target.name}' #{reason}")
  const variable = local ? reject('is not a variable')
  reject('is not a var') if not variable.mutable
  # A write is not a use: the target's type is found without reading it.
  body.shared.types[target] = variable.type
  variable.type
