# Checks assignments: to a name, to an indexed item and to a field.
import
  Assignment, BinaryOperation, combining_operator, Expression, Identifier, Index, IntegerLiteral,
  Member, StringLiteral, This, UnaryOperation
from '../ast'
import warn_if_cycle from './cycles'
import fail from './diagnostics'
import require_type, type_of from './expression'
import field_target from './fields'
import local_reference, lookup, record_reference from './name'
import
  describe_kinds, is_numeric_operator, operand_kinds, OPERATOR_METHODS, reject_text_and_bytes,
  type_of_operator_call
from './operator'
import Body from './shared'
import abort_if_failed, reject_pending from './top_level_values'
import format_type, is_float, is_integer, is_kind, is_one_of_kinds, MapType, Type from '../types'

# A compound assignment such as `+=` applies to the types that its operator does, and to the others
# through the method that its operator calls (see check_operator_assignment).
export const check_assignment = (body: Body, assignment: Assignment) ->
  const { target, operator } = assignment
  const target_type =
    case target
      when Index then check_item_target(body, target, operator)
      when Member then field_target(body, target)
      when Identifier then check_variable_target(body, target)
  if operator != '='
    const kinds = operand_kinds(combining_operator(operator))
    if not is_one_of_kinds(target_type, kinds)
      if check_operator_assignment(body, assignment, target_type)
        forget_narrowing body, target if target is Identifier
        return
      const message = "expected #{describe_kinds(kinds)}, got #{format_type(target_type)}"
      fail body.program, target.position, message
  const value_type = type_of(body, assignment.value, target_type)
  reject_text_and_bytes body, assignment.value, target_type, value_type if operator == '+='
  require_type body, assignment.value, value_type, target_type
  # The value is read where the variable is still narrowed, as it is evaluated first.
  forget_narrowing body, target if target is Identifier
  warn_if_cycle body, target, assignment.value

# `a += b` on a value of a type that `+` applies to by its method assigns `a.add(b)`, which reads
# the target; false if the type has no such method. As the target is then evaluated twice, once to
# read and once to assign, it may not call anything.
const check_operator_assignment = (body: Body, assignment: Assignment, target_type: Type) ->
  const { target, operator } = assignment
  const name = OPERATOR_METHODS[combining_operator(operator)]!
  const args = [assignment.value]
  const call_method = ->
    type_of_operator_call body, assignment, operator, target, target_type, name, args
  const result = call_method() ? return false
  const call = body.facts.operator_calls[assignment]!
  if not is_plain_place(body, target)
    const reads = "the target of '#{operator}' through '#{name}' is read and then assigned"
    const message = "#{reads}, so it may only be a name, a field, an index or arithmetic"
    fail body.program, target.position, message
  require_type body, call, result, target_type
  warn_if_cycle body, target, call
  true

# A place that names, indexes and fields reach, and arithmetic that no method gives, whose
# evaluation calls nothing.
const is_plain_place = (body: Body, expression: Expression): Bool ->
  const plain = (part: Expression) -> is_plain_place(body, part)
  const by_method = body.facts.operator_calls.has(expression)
  case expression
    when Identifier, This, IntegerLiteral, StringLiteral then true
    when Member then plain(expression.object)
    when Index then plain(expression.object) and plain(expression.index)
    when UnaryOperation
      expression.operator == '-' and not by_method and plain(expression.operand)
    when BinaryOperation
      const { operator, left, right } = expression
      is_numeric_operator(operator) and not by_method and plain(left) and plain(right)
    else false

const check_item_target = (body: Body, target: Index, operator: String) ->
  const type = type_of(body, target)
  const object_type = body.facts.types[target.object]!
  if object_type is MapType
    if operator != '='
      const combined = combining_operator(operator)
      # A number may default to 0; other values to what the program chooses.
      const value = object_type.value
      const fallback = is_integer(value) or is_float(value) then '0' else 'y'
      const advice = "write m[k] = (m[k] ? #{fallback}) #{combined} x"
      const message = "a map value cannot be updated with '#{operator}'; #{advice}"
      fail body.program, target.position, message
    return object_type.value
  fail body.program, target.position, 'a Binary cannot be changed' if is_kind(object_type, 'Binary')
  type

const check_variable_target = (body: Body, target: Identifier) ->
  const reject = (reason: String) ->
    fail body.program, target.position, "'#{target.name}' #{reason}"
  const not_a_variable = ->
    abort_if_failed body.shared.top_level, target.name
    reject_pending body.program, body.shared.top_level, target if body.sees_top_level
    reject 'is not a variable'
  const variable = lookup(body, target.name) ? not_a_variable()
  reject 'is not a var' if not variable.mutable
  record_reference body, target, local_reference(body, target.name, variable)
  # A write is not a use: the target's type is found without reading it. It is the declared one,
  # which the value may take whether or not the variable is narrowed where it is.
  const declared = (variable.origin ? variable).type
  body.facts.types[target] = declared
  declared

# An assigned `var` is no longer narrowed where it is. A function literal that assigns one it
# captures may run at any later point, so it is not narrowed from there on, around the literal too.
const forget_narrowing = (body: Body, target: Identifier) ->
  const variable = lookup(body, target.name)!
  const origin = variable.origin ? variable
  body.scopes.forget_views origin
  return if not variable.captured
  origin.assigned_by_literal = true
  var enclosing = body.enclosing
  while const around = enclosing
    # A round of a loop around the literal may run it before a narrowed read earlier in the loop.
    if around.loops.any((loop) -> origin.narrowed_in_loops.contains(loop))
      const when = 'a later round may run this function literal first'
      fail(
        body.program
        target.position
        "'#{target.name}' is narrowed earlier in the loop, and #{when}"
      )
    around.scopes.forget_views origin
    enclosing = around.enclosing
