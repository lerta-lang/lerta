# Checks assignments: to a name, to an indexed item and to a field.
import
  Assignment, BinaryOperation, combining_operator, Expression, Identifier, Index, IntegerLiteral,
  Member, StringLiteral, This, UnaryOperation
from '../ast'
import warn_if_cycle from './cycles'
import fail from './diagnostics'
import require_type, type_of from './expression'
import field_target from './fields'
import local_reference, lookup, qualified_name, record_reference from './name'
import
  appends_unit, describe_kinds, is_numeric_operator, operand_kinds, OPERATOR_METHODS,
  reject_text_and_bytes, type_of_operator_call
from './operator'
import Body from './shared'
import record_taken_items from './taken_items'
import abort_if_failed, reject_pending from './top_level_values'
import ArrayType, format_type, is_kind, is_number, is_one_of_kinds, MapType, Type from '../types'

# A compound assignment such as `+=` applies to the types that its operator does, and to the others
# through the method that its operator calls (see check_operator_assignment).
export check_assignment := (body: Body, assignment: Assignment) ->
  { target, operator } := assignment
  target_type :=
    case target
      when Index then check_item_target(body, target, operator)
      when Member
        # An export of a module imported as a name is no var, as an imported name is not.
        qualified := qualified_name(body, target)
        qualified then check_variable_target(body, qualified) else field_target(body, target)
      when Identifier then check_variable_target(body, target)
  if operator != '='
    kinds := operand_kinds(combining_operator(operator))
    if not is_one_of_kinds(target_type, kinds)
      if check_operator_assignment(body, assignment, target_type)
        forget_narrowing body, target if target is Identifier
        return
      message := "expected #{describe_kinds(kinds)}, got #{format_type(target_type)}"
      fail body.program, target.position, message
  value_type := type_of(body, assignment.value, target_type)
  is_unit := operator == '+=' and appends_unit(body, assignment.value, target_type, value_type)
  if not is_unit
    reject_text_and_bytes body, assignment.value, target_type, value_type if operator == '+='
    require_type body, assignment.value, value_type, target_type
  # The value is read where the variable is still narrowed, as it is evaluated first.
  forget_narrowing body, target if target is Identifier
  warn_if_cycle body, target, assignment.value

# `a += b` on a value of a type that `+` applies to by its method assigns `a.add(b)`, which reads
# the target; false if the type has no such method. As the target is then evaluated twice, once to
# read and once to assign, it may not call anything.
check_operator_assignment := (body: Body, assignment: Assignment, target_type: Type) ->
  { target, operator } := assignment
  name := OPERATOR_METHODS[combining_operator(operator)]!
  args := [assignment.value]
  call_method := ->
    type_of_operator_call body, assignment, operator, target, target_type, name, args
  result := call_method() ? return false
  call := body.facts.operator_calls[assignment]!
  if not is_plain_place(body, target)
    reads := "the target of '#{operator}' through '#{name}' is read and then assigned"
    message := "#{reads}, so it may only be a name, a field, an index or arithmetic"
    fail body.program, target.position, message
  require_type body, call, result, target_type
  warn_if_cycle body, target, call
  true

# A place that names, indexes and fields reach, and arithmetic that no method gives, whose
# evaluation calls nothing.
is_plain_place := (body: Body, expression: Expression): Bool ->
  plain := (part: Expression) -> is_plain_place(body, part)
  by_method := expression in body.facts.operator_calls
  case expression
    when Identifier, This, IntegerLiteral, StringLiteral then true
    when Member then plain(expression.object)
    # The default is not checked: `+=` on `m[k, default: d]` evaluates the place once, through a
    # method too (see update_with_default in codegen), so that `d` runs at most once.
    when Index then plain(expression.object) and plain(expression.index)
    when UnaryOperation
      expression.operator == '-' and not by_method and plain(expression.operand)
    when BinaryOperation
      { operator, left, right } := expression
      is_numeric_operator(operator) and not by_method and plain(left) and plain(right)
    else false

check_item_target := (body: Body, target: Index, operator: String) ->
  type := type_of(body, target)
  object_type := body.facts.types[target.object]!
  if object_type is MapType
    if target.default_value and operator == '='
      message := 'a default is for reading the value; write m[k] = x to assign it'
      fail body.program, target.position, message
    if operator != '=' and target.default_value == nil
      # A number may default to 0; other values to what the program chooses.
      value := object_type.value
      fallback := is_number(value) then '0' else 'y'
      advice := "write m[k, default: #{fallback}] #{operator} x"
      message := "a map value cannot be updated with '#{operator}' without a default; #{advice}"
      fail body.program, target.position, message
    return object_type.value
  fail body.program, target.position, 'a Binary cannot be changed' if is_kind(object_type, 'Binary')
  record_taken_items body.program, object_type if object_type is ArrayType
  type

check_variable_target := (body: Body, target: Identifier) ->
  reject := (reason: String) -> fail(body.program, target.position, "'#{target.name}' #{reason}")
  not_a_variable := ->
    abort_if_failed body.shared.top_level, target.name
    reject_pending body.program, body.shared.top_level, target if body.sees_top_level
    reject 'is not a variable'
  variable := lookup(body, target.name) ? not_a_variable()
  reject 'is not a var' if not variable.mutable
  body.facts.local_declarations[target] = variable.original().identifier
  record_reference body, target, local_reference(body, target.name, variable)
  # A write is not a use: the target's type is found without reading it. It is the declared one,
  # which the value may take whether or not the variable is narrowed where it is.
  declared := variable.original().type
  body.facts.types[target] = declared
  declared

# An assigned `var` is no longer narrowed where it is.
forget_narrowing := (body: Body, target: Identifier) ->
  body.scopes.forget_views lookup(body, target.name)!.original()
