# Externs: the C functions a module declares, whose types all the modules must agree on.
import Extern, Position, Statement from '../ast'
import fail from './diagnostics'
import add_extern from './imports'
import ProgramWide, Shared from './shared'
import module_resolver, resolve_result from './type_names'
import
  format_type, FunctionType, inner_of, is_kind, is_reference_type, kind_of, OptionalType, Type
from '../types'

export declare_externs := (shared: Shared, statements: Statement[]) ->
  for statement in statements
    declare_extern shared, statement if statement is Extern

declare_extern := (shared: Shared, statement: Extern) ->
  program := shared.program
  type := resolve_result(program, module_resolver(shared.index), statement.type)
  unless type is FunctionType
    fail program, statement.type.position, 'an extern is a C function, of a function type'
  reject_types_without_c_type program, type, statement.type.position
  { symbol } := statement
  if declared := program.extern_types[symbol.name]
    if c_signature(declared.type) != c_signature(type)
      declared_as := "#{format_type(declared.type)} in #{declared.module_name}"
      message := "the C function '#{symbol.name}' is declared as #{declared_as}"
      fail program, symbol.position, message
  else
    program.extern_types[symbol.name] = { type, module_name: shared.name }
  add_extern shared, statement.name, type, symbol.name

reject_types_without_c_type := (program: ProgramWide, type: FunctionType, at: Position) ->
  for value_type in value_types(type)
    if is_kind(inner_of(value_type), INTERFACE)
      message := "a C function cannot take or return the type #{format_type(value_type)}"
      fail program, at, "#{message}: an interface value has no C type"
    if value_type is OptionalType and not is_reference_type(value_type)
      message := "a C function cannot take or return the type #{format_type(value_type)}; " +
        'of the optional values, only references have a C type'
      fail program, at, message

value_types := (type: FunctionType) -> [type.params..., type.result]

c_type := (type: Type) -> is_reference_type(type) then 'pointer' else kind_of(type).to_string()

c_signature := (type: Type) ->
  if type is FunctionType
    "(#{[c_type(param) for param in type.params].join(', ')}) -> #{c_type(type.result)}"
  else
    panic('an extern has a function type')
