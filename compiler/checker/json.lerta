# The types that std:json converts, which satisfy Jsonable by their parts, and the calls in it of
# the code that the compiler generates for each (see codegen/json).
import Call, Expression, Identifier, Position from '../ast'
import fail from './diagnostics'
import type_of from './expression'
import has_function from './functions'
import lookup, record_reference from './name'
import JsonConversion, JsonDirection from './references'
import Body, ProgramWide, Shared from './shared'
import names_type_or_import, resolve from './type_names'
import field_type, info_of from './object_types'
import
  ArrayType, EnumType, format_type, InterfaceType, is_kind, is_one_of_kinds, MapType, ObjectType,
  OptionalType, RecordType, TupleType, Type, type_key, TypeKind, void_type
from '../types'

const JSON_MODULE = 'std:json'

export const is_jsonable_bound = (bound: InterfaceType) ->
  bound.module == JSON_MODULE and bound.name == 'Jsonable'

# Whether the interface of the name, declared in the module, is std:json's Jsonable.
export const is_jsonable_declaration = (shared: Shared, name: String) ->
  is_json_module(shared) and name == 'Jsonable'

# std:json, also when it is the entry module, as when it is built on its own.
const is_json_module = (shared: Shared) ->
  shared.name == JSON_MODULE or (shared.path == nil and shared.program.entry_path == JSON_MODULE)

# Rejects a type that has a part std:json does not convert, naming the part by its path, as
# JsonError does in std:json: `$[]` is an item of an array, `$.*` a value of a map, and `$[0]` and
# `$.name` an item of a tuple and a field.
export const reject_unjsonable = (program: ProgramWide, type: Type, at: Position) ->
  const finder = PartFinder(program, at)
  const part = finder.unjsonable_part(type, '$') ? return
  const where = part.path == '$' then 'it' else part.path
  const reason = "#{where} #{part.problem}, which std:json does not convert"
  fail program, at, "#{format_type(type)} does not satisfy Jsonable: #{reason}"

# A part of a type, by its path from it, and what std:json does not convert in it.
struct Part(path: String, problem: String)

class PartFinder
  program: ProgramWide
  at: Position
  # The classes and structs whose parts are being looked through, which a part of them that is
  # of their own type does not look through again.
  visited: Set<String> = Set()

  unjsonable_part = (type: Type, path: String): Part? ->
    case
      when is_one_of_kinds(type, JSON_SCALAR_KINDS) or type is EnumType then nil
      when type is OptionalType then @unjsonable_part(type.inner, path)
      when type is ArrayType then @unjsonable_part(type.element, "#{path}[]")
      when type is TupleType then @first_part([(item, "#{path}[#{i}]") for item, i in type.items])
      when type is RecordType
        @first_part [(field.type, "#{path}.#{field.name}") for field in type.fields]
      when type is MapType
        if not is_kind(type.key, 'String')
          return Part(path, problem: "has keys of type #{format_type(type.key)}")
        @unjsonable_part type.value, "#{path}.*"
      when type is ObjectType then @object_part(type, path)
      else Part(path, problem: "is of type #{format_type(type)}")

  first_part = (parts: (Type, String)[]): Part? ->
    for (type, path) in parts
      return part if const part = @unjsonable_part(type, path)
    nil

  object_part = (type: ObjectType, path: String): Part? ->
    const key = type_key(type)
    return nil if @visited.has(key)
    @visited.add key
    const info = info_of(@program, type)
    for field in info.fields
      const field_path = "#{path}.#{field.name.name}"
      return Part(path: field_path, problem: 'is weak') if field.weak
      if const part = @unjsonable_part(field_type(@program, info, field, @at), field_path)
        return part
    nil

const JSON_SCALAR_KINDS: TypeKind[] = ['Int', 'Float', 'Bool', 'String']

# A call in std:json of the builtin `write_json` or `read_json`, unless the name is taken there.
export const json_direction = (body: Body, callee: Expression): JsonDirection? ->
  return nil if callee is not Identifier or not is_json_module(body.shared)
  const name = callee.name
  const direction =
    case name
      when 'write_json' then JsonDirection.WRITE
      when 'read_json' then JsonDirection.READ
      else nil
  return nil if lookup(body, name) != nil or has_function(body.shared, name)
  not names_type_or_import(body.shared, name) then direction

# `write_json(writer, value)` writes the value, of a Jsonable type, and `read_json<T>(reader)`
# reads a T.
export const type_of_json_call = (body: Body, call: Call, direction: JsonDirection) ->
  const program = body.program
  const callee = call.callee as Identifier!
  const arity = direction == JsonDirection.WRITE then 2 else 1
  if call.args.length != arity or call.named_args.length > 0
    fail program, call.position, "#{callee.name} takes #{arity} arguments"
  const arg_types = [type_of(body, arg) for arg in call.args]
  const coder = direction == JsonDirection.WRITE then 'JsonWriter' else 'JsonReader'
  const takes_coder = arg_types[0] is ObjectType and (arg_types[0] as ObjectType!).name == coder
  fail program, call.args[0].position, "#{callee.name} takes a #{coder} first" if not takes_coder
  const type =
    case direction
      when JsonDirection.WRITE then arg_types[1]
      when JsonDirection.READ
        const written =
          call.type_args.first() ? fail(program, call.position, 'read_json<T> needs T')
        resolve program, body.resolver, written
  reject_unjsonable program, type, call.position
  record_reference body, callee, JsonConversion(direction, type)
  direction == JsonDirection.WRITE then void_type else type
