# Types with type parameters, as patterns: `Array<T>` stands for any array. Generic functions and
# extends match, substitute and infer their type parameters with these.
import { TypeParameter } from '../ast'
import {
  ArrayType, FunctionType, inner_of, InterfaceType, IterType, MapType, ObjectType, optional_type
  OptionalType, record_type, RecordField, RecordType, same_type, TupleType, Type, type_key
  TypeParameterType, union_type, UnionType
} from '../types'

# The type parameters standing for themselves, for resolving the types written with them.
export const placeholders = (type_params: Array<TypeParameter>) ->
  const types: Map<String, Type> = Map()
  types[param.name.name] = TypeParameterType(name: param.name.name) for param in type_params
  types

# The type with each type it is made of replaced by `replace` of it.
const map_parts = (type: Type, replace: (Type) -> Type): Type ->
  case type
    when ArrayType then ArrayType(element: replace(type.element))
    when IterType then IterType(item: replace(type.item))
    when MapType then MapType(key: replace(type.key), value: replace(type.value))
    when OptionalType then optional_type(replace(type.inner))
    when RecordType
      const replace_field = (field: RecordField) ->
        RecordField name: field.name, type: replace(field.type)
      record_type [replace_field(field) for field in type.fields]
    when TupleType then TupleType(items: [replace(item) for item in type.items])
    when UnionType then union_type([replace(member) for member in type.members])
    when InterfaceType
      const args = [replace(arg) for arg in type.args]
      InterfaceType args, name: type.name, symbol: type.symbol, module: type.module
    when ObjectType
      return type if type.args.length == 0
      const args = [replace(arg) for arg in type.args]
      const { name, symbol, module, is_struct } = type
      ObjectType name, symbol, module, is_struct, args
    when FunctionType
      FunctionType params: [replace(param) for param in type.params], result: replace(type.result)
    else type

# The type with the type parameters that `bindings` has replaced by their types.
export const substitute = (type: Type, bindings: Map<String, Type>): Type ->
  if type is TypeParameterType
    return bindings[type.name] ? type
  map_parts type, (part) -> substitute(part, bindings)

# The types that the type is made of, such as the items of an array.
export const parts_of = (type: Type) ->
  const parts: Array<Type> = []
  const collect = (part: Type) ->
    parts.push part
    part
  map_parts type, collect
  parts

export const type_depth = (type: Type): Int ->
  var deepest = 0
  for part in parts_of(type)
    const depth = type_depth(part)
    deepest = depth if depth > deepest
  1 + deepest

# Whether the type is the pattern with its type parameters replaced, as Array<Int> is Array<T>.
export const matches = (pattern: Type, type: Type) ->
  const bindings: Map<String, Type> = Map()
  const bind = (name: String, bound: Type) -> bindings[name] = bound if not bindings.has(name)
  infer pattern, type, bind
  same_type substitute(pattern, bindings), type

# Whether some type matches both patterns, as Array<Int> matches Array<T> and Array<Int>. A type
# parameter stands for any type on either side, even where it is repeated, as in Map<T, T>.
export const overlaps = (a: Type, b: Type): Bool ->
  return true if a is TypeParameterType or b is TypeParameterType
  const a_parts = parts_of(a)
  const b_parts = parts_of(b)
  return false if shape_key(a) != shape_key(b) or a_parts.length != b_parts.length
  for (a_part, b_part) in a_parts.zip(b_parts)
    return false if not overlaps(a_part, b_part)
  true

# The type without the types it is made of: Array<_> for any array.
const shape_key = (type: Type) ->
  type_key map_parts(type, (_) -> TypeParameterType(name: '_'))

export const has_type_parameters = (type: Type): Bool ->
  type is TypeParameterType or parts_of(type).any(has_type_parameters)

# Binds the type parameters in `pattern` to the types they have in `type`, where its shape
# matches: `Array<T>` and an `Array<Int>` bind T to Int. A type parameter bound already is kept;
# the caller then checks that the type fits.
export const infer = (pattern: Type, type: Type, bind: (String, Type) -> void): void ->
  const match = (part: Type, type_part: Type?) -> infer part, type_part, bind if type_part
  case pattern
    when TypeParameterType then bind(pattern.name, type)
    when OptionalType then match(pattern.inner, inner_of(type))
    when ArrayType then match(pattern.element, type is ArrayType then type.element else nil)
    when IterType then match(pattern.item, type is IterType then type.item else nil)
    when MapType
      if type is MapType
        match pattern.key, type.key
        match pattern.value, type.value
    when RecordType
      if type is RecordType
        for field in pattern.fields
          const found = type.fields.find((each) -> each.name == field.name)
          match field.type, found?.type
    when TupleType
      if type is TupleType and type.items.length == pattern.items.length
        match item, written for (item, written) in pattern.items.zip(type.items)
    when FunctionType
      if type is FunctionType
        return if type.params.length != pattern.params.length
        match param, written for (param, written) in pattern.params.zip(type.params)
        match pattern.result, type.result
    when InterfaceType
      if type is InterfaceType and type.symbol == pattern.symbol
        match arg, written for (arg, written) in pattern.args.zip(type.args)
    when ObjectType
      if type is ObjectType and type.symbol == pattern.symbol
        match arg, written for (arg, written) in pattern.args.zip(type.args)
    else pass
