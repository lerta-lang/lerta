# Types with type parameters, as patterns: `T[]` stands for any array. Generic functions and
# extends match, substitute and infer their type parameters with these.
import TypeParameter from '../ast'
import
  ArrayType, FunctionType, inner_of, InterfaceType, is_set, IterType, kind_of, MapType, ObjectType,
  optional_type, OptionalType, PromiseType, record_type, RecordField, RecordType, TupleType, Type,
  type_key, TypeParameterType, union_type, UnionType
from '../types'

# The type parameters as patterns, for resolving the types written with them; or, `standing`,
# standing for themselves, as types that no pattern binds.
export placeholders := (type_params: TypeParameter[], standing = false) ->
  types: Map<String, Type>
  for param in type_params
    types[param.name.name] = TypeParameterType(standing, name: param.name.name)
  types

# The type with each type it is made of replaced by `replace` of it.
map_parts := (type: Type, replace: (Type) -> Type): Type ->
  case type
    when ArrayType then ArrayType(replace(type.element))
    when IterType then IterType(replace(type.item))
    when PromiseType then PromiseType(replace(type.value))
    when MapType then MapType(key: replace(type.key), value: replace(type.value))
    when OptionalType then optional_type(replace(type.inner))
    when RecordType
      replace_field := (field: RecordField) -> RecordField(field..., type: replace(field.type))
      record_type([replace_field(field) for field in type.fields])
    when TupleType then TupleType([replace(item) for item in type.items])
    when UnionType then union_type([replace(member) for member in type.members])
    when InterfaceType
      args := [replace(arg) for arg in type.args]
      InterfaceType(type..., args)
    when ObjectType
      return type if type.args.is_empty()
      args := [replace(arg) for arg in type.args]
      ObjectType(type..., args)
    when FunctionType
      FunctionType(params: [replace(param) for param in type.params], result: replace(type.result))
    else type

# The type with the type parameters that `bindings` has replaced by their types.
export substitute := (type: Type, bindings: Map<String, Type>): Type ->
  return bindings[type.name] else type if type is TypeParameterType and not type.standing
  map_parts(type, (part) -> substitute(part, bindings))

# The type with the type parameters standing for themselves that `bindings` has replaced by their
# types, as the type of a generic function from its definition, for the type arguments of a call.
export substitute_standing := (type: Type, bindings: Map<String, Type>): Type ->
  return bindings[type.name] else type if type is TypeParameterType and type.standing
  map_parts(type, (part) -> substitute_standing(part, bindings))

# Whether the type has type parameters, as `T[]` has, which make it a pattern of other types.
export is_pattern := (type: Type): Bool -> is_variable(type) or parts_of(type).any(is_pattern)

# Whether the type is a type parameter that a pattern binds, rather than one standing for itself.
is_variable := (type: Type) -> type is TypeParameterType and not type.standing

# Whether the type names a type parameter standing for itself.
export has_standing := (type: Type): Bool ->
  return type.standing if type is TypeParameterType
  parts_of(type).any(has_standing)

# The types that the type is made of, such as the items of an array.
export parts_of := (type: Type) ->
  parts: Type[]
  collect := (part: Type) ->
    parts.push part
    part
  map_parts type, collect
  parts

export type_depth := (type: Type): Int -> 1 + (parts_of(type).map(type_depth).max() else 0)

# Whether the type is the pattern with its type parameters replaced, as Int[] is T[].
export matches := (pattern: Type, type: Type) ->
  return false unless has_same_outer_shape(pattern, type)
  bindings: Map<String, Type>
  bind := (name: String, bound: Type) -> bindings[name] = bound unless name in bindings
  infer pattern, type, bind
  substitute(pattern, bindings) == type

# Whether the type may match the pattern by what they are outside the types they are made of. It
# rules out most types cheaply, before inferring and comparing the whole of them.
# Substituting keeps what a pattern is outside, except a type parameter's and a union's, whose
# members may merge.
has_same_outer_shape := (pattern: Type, type: Type) ->
  return true if is_variable(pattern) or pattern is UnionType or type is UnionType
  case pattern
    when ObjectType then type is ObjectType and type.symbol == pattern.symbol
    when InterfaceType then type is InterfaceType and type.symbol == pattern.symbol
    else kind_of(pattern) == kind_of(type)

# Whether some type matches both patterns, as Int[] matches T[] and Int[]. A type
# parameter stands for any type on either side, even where it is repeated, as in Map<T, T>.
export overlaps := (a: Type, b: Type): Bool ->
  return true if is_variable(a) or is_variable(b)

  # A set overlaps only a set, as only a set matches one (see infer).
  return false if is_set(a) != is_set(b)

  a_parts := parts_of(a)
  b_parts := parts_of(b)
  return false if shape_key(a) != shape_key(b) or a_parts.length != b_parts.length
  for (a_part, b_part) in a_parts.zip(b_parts)
    return false unless overlaps(a_part, b_part)
  true

# The type without the types it is made of: _[] for any array.
shape_key := (type: Type) -> type_key(map_parts(type, (_) -> TypeParameterType('_')))

export type_parameter_names := (type: Type): String[] ->
  return [type.name] if type is TypeParameterType and not type.standing
  names: String[]
  names.append type_parameter_names(part) for part in parts_of(type)
  names

# Binds the type parameters in `pattern` to the types they have in `type`, where its shape
# matches: `T[]` and an `Int[]` bind T to Int. A type parameter bound already is kept;
# the caller then checks that the type fits.
export infer := (pattern: Type, type: Type, bind: (String, Type) -> void): void ->
  match := (part: Type, type_part: Type?) ->
    if type_part
      infer part, type_part, bind
  case pattern
    when TypeParameterType then bind(pattern.name, type) unless pattern.standing
    when OptionalType then match(pattern.inner, inner_of(type))
    when ArrayType then match(pattern.element, type is ArrayType then type.element)
    when IterType then match(pattern.item, type is IterType then type.item)
    when PromiseType then match(pattern.value, type is PromiseType then type.value)
    when MapType
      # A set matches only a set: a map's value type cannot be void.
      if type is MapType and is_set(type) == is_set(pattern)
        match pattern.key, type.key
        match pattern.value, type.value
    when RecordType
      if type is RecordType
        for field in pattern.fields
          found := type.fields.find((each) -> each.name == field.name)
          match field.type, found?.type
    when TupleType
      if type is TupleType and type.items.length == pattern.items.length
        match item, written for (item, written) in pattern.items.zip(type.items)
    when FunctionType
      if type is FunctionType
        return if type.params.length != pattern.params.length
        match param, written for (param, written) in pattern.params.zip(type.params)
        match pattern.result, type.result
    when InterfaceType
      if type is InterfaceType and type.symbol == pattern.symbol
        match arg, written for (arg, written) in pattern.args.zip(type.args)
    when ObjectType
      if type is ObjectType and type.symbol == pattern.symbol
        match arg, written for (arg, written) in pattern.args.zip(type.args)
    else pass
