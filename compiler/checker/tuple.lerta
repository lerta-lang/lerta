# Types tuples: their literals, and the items that taking one apart reads.
import Expression, TupleItem, TupleLiteral from '../ast'
import check_value_type from './collection'
import fail from './diagnostics'
import expect_type, type_of from './expression'
import Body from './shared'
import format_type, inner_of_expected, TupleType, Type from '../types'

export type_of_tuple := (body: Body, tuple: TupleLiteral, expected: Type?) ->
  expected_items := expected_tuple_items(expected, tuple.items.length)
  type_of_item := (item: Expression, i: Int) ->
    if expected_items
      expect_type body, item, expected_items[i]
      return expected_items[i]
    check_value_type(body.program, type_of(body, item), item.position, 'a tuple')
  TupleType([type_of_item(item, i) for item at i in tuple.items])

expected_tuple_items := (expected: Type?, count: Int) ->
  tuple := inner_of_expected(expected) else return nil
  if tuple is TupleType and tuple.items.length == count
    tuple.items
  else
    nil

export type_of_tuple_item := (body: Body, item: TupleItem) ->
  type := type_of(body, item.tuple)
  if type is TupleType
    return type.items[item.index] if type.items.length == item.count
  message := "expected a tuple of #{item.count} items to take apart, got #{format_type(type)}"
  fail(body.program, item.tuple.position, message)
