# The classes and structs of the program: their fields and methods. Like functions, they can be
# used anywhere in the module, so the types of fields given by an initializer alone are found on
# demand.
import {
  Expression, FunctionLiteral, Identifier, MemberDeclaration, Position, TypeDeclaration
} from '../ast'
import { check_object } from './bodies'
import { fail } from './diagnostics'
import { add_function, add_generic, CheckState, method_key } from './functions'
import { GenericRef, make_generic_function, Receiver } from './generics'
import { imported_type } from './imports'
import { ProgramWide, Shared } from './shared'
import { is_builtin_type_name, module_resolver, resolve } from './type_names'
import { ObjectType, Type } from '../types'

export class FieldInfo
  name: Identifier
  # Nil until found, for a field given by an initializer alone.
  type: Type?
  mutable: Bool
  # A field without an initializer is a constructor argument.
  value: Expression?
  # A `weak!` field holds its object without keeping it alive (see codegen weak).
  weak: Bool

export class ObjectInfo
  declaration: TypeDeclaration
  type: ObjectType
  # The declaring module, whose functions hold the methods' types.
  module_index: Int
  fields: Array<FieldInfo> = []
  methods: Map<String, FunctionLiteral> = Map()
  # The generic methods, those with type parameters, which have instances instead of a function.
  generics: Map<String, GenericRef> = Map()
  has_init = false
  # `deinit`, which runs when the object is released (see runtime lerta_run_deinit).
  has_deinit = false
  state: CheckState = UNCHECKED

# The function literal of a member that is a method.
export const method_literal = (member: MemberDeclaration) ->
  return nil if member.modifier == 'var'
  member.value as FunctionLiteral?

# Registers the names first, so that the members can refer to any of the types.
export const add_objects = (shared: Shared, declarations: Array<TypeDeclaration>) ->
  const program = shared.program
  for declaration in declarations
    const { name, position } = declaration.name
    if shared.objects.has(name) or is_builtin_type_name(name)
      fail program, position, "'#{name}' is already defined"
    const symbol = "#{shared.index}.#{name}"
    const is_struct = declaration.is_struct
    const type = ObjectType(name, symbol, is_struct, module: shared.name)
    const info = ObjectInfo(declaration, type, module_index: shared.index)
    shared.objects[name] = info
    program.infos[symbol] = info

# Resolves the written field types and adds the methods to the module's functions.
export const add_members = (shared: Shared) ->
  const program = shared.program
  for type_name in shared.objects.keys()
    const info = shared.objects[type_name]!
    const seen: Map<String, Bool> = Map()
    for member in info.declaration.members
      const { name, position } = member.name
      if seen.has(name)
        const message = "'#{name}' is already a member of #{info.declaration.name.name}"
        fail program, position, message
      seen.add name
      if const literal = method_literal(member)
        add_method shared, info, member, literal
      else
        info.fields.push field_of_member(shared, info, member)

const add_method = (
  shared: Shared, info: ObjectInfo, member: MemberDeclaration, literal: FunctionLiteral
) ->
  const program = shared.program
  const type_name = info.declaration.name.name
  const { name } = member.name
  const runs_alone = name == 'init' or name == 'deinit'
  if runs_alone and literal.params.length > 0
    fail program, literal.position, "#{name} takes no parameters"
  if runs_alone and literal.type_params.length > 0
    fail program, literal.position, "#{name} takes no type parameters"
  info.has_init = true if name == 'init'
  if name == 'deinit' and info.declaration.is_struct
    fail program, member.position, 'a struct has no deinit'
  info.has_deinit = true if name == 'deinit'
  info.methods[name] = literal
  if literal.type_params.length == 0
    add_function shared, method_key(type_name, name), member.name, literal, info.type
    return
  const receiver = Receiver(type: info.type, type_params: [])
  const generic = make_generic_function(shared, member.name, literal, receiver)
  info.generics[name] = add_generic(shared, generic)

const field_of_member = (shared: Shared, info: ObjectInfo, member: MemberDeclaration) ->
  const program = shared.program
  const is_struct = info.declaration.is_struct
  const value = member.value
  if value is FunctionLiteral
    const message = 'a function field is not supported yet; a method is written without var'
    fail program, member.position, message
  if is_struct and member.modifier == 'var'
    fail program, member.position, 'a struct field cannot be var'
  const type_name = member.type
  const type = type_name then resolve(program, module_resolver(shared.index), type_name) else nil
  const weak = member.modifier == 'weak!'
  reject_invalid_weak program, member, is_struct, type if weak
  const mutable = not is_struct and member.modifier != 'const' and not weak
  FieldInfo type, mutable, value, weak, name: member.name

# A `weak!` field is a constructor argument of a class, which holds an object of a class.
const reject_invalid_weak = (
  program: ProgramWide, member: MemberDeclaration, is_struct: Bool, type: Type?
) ->
  const fail_weak = (message: String) -> fail(program, member.position, message)
  fail_weak 'a struct field cannot be weak' if is_struct
  fail_weak 'a weak field is a constructor argument, without an initializer' if member.value
  const object = type as ObjectType?
  fail_weak 'a weak field holds an object of a class' if not object or object.is_struct

# The class or struct of the name, of the module or imported.
export const object_type = (shared: Shared, name: String) ->
  return info.type if const info = shared.objects[name]
  const exported = imported_type(shared, name) ? return nil
  const info = exported.info ? return nil
  info.type

export const info_of = (program: ProgramWide, type: ObjectType) ->
  program.infos[type.symbol]!

# The field's type, checking the initializers first if it is given by one alone.
export const field_type = (
  program: ProgramWide, info: ObjectInfo, field: FieldInfo, at: Position
) ->
  return type if const type = field.type
  if info.state == CHECKING
    fail program, at, "the type of '#{field.name.name}' is not known yet; write it"
  check_info program, info
  field.type!

export const check_all_objects = (shared: Shared) ->
  check_info shared.program, shared.objects[name]! for name in shared.objects.keys()

# Checks the initializers of the fields with the declaring module's checker, setting the types
# that they give.
const check_info = (program: ProgramWide, info: ObjectInfo) ->
  return if info.state != UNCHECKED
  info.state = CHECKING
  check_object program, info
  info.state = CHECKED
