# The classes and structs of the program: their fields and methods. The types of fields given by
# an initializer alone are found on demand, and so are the instances of a generic class or struct
# (see info_of).
import
  Expression, FunctionLiteral, Identifier, MemberDeclaration, Position, TypeDeclaration, TypeName,
  TypeParameter
from '../ast'
import check_equality_methods, check_object, check_satisfies from './bodies'
import
  abort_part, check_part, enter_module, fail, fail_already_defined, fail_in_context
from './diagnostics'
import add_function, add_generic, CheckState, method_key from './functions'
import
  GenericRef, Instance, instantiate, make_generic_function, MAX_INSTANCES, MAX_TYPE_DEPTH, Receiver,
  reject_bad_type_parameters
from './generics'
import builtin_type, imported_type from './imports'
import bound_interface, has_declared_type, InterfaceMember, members_for from './interfaces'
import module_symbol_name, NodeFacts, ProgramWide, Shared from './shared'
import module_resolver, resolve, Resolver, with_type_parameters from './type_names'
import has_type_parameters, placeholders, substitute, type_depth from './type_patterns'
import
  format_type, inner_of, InterfaceType, ObjectType, OptionalType, same_type, Type
from '../types'

export class FieldInfo
  name: Identifier
  # Nil until found, for a field given by an initializer alone.
  type: Type?
  mutable: Bool
  # The initializer, or the default of a constructor argument (see is_argument).
  value: Expression?
  has_default: Bool
  # A `weak!` field holds its object without keeping it alive (see codegen weak).
  weak: Bool

export class ObjectInfo
  declaration: TypeDeclaration
  # A generic one's type parameters stand for themselves as its type arguments.
  type: ObjectType
  # The declaring module, whose functions hold the methods' types.
  module_index: Int
  # Resolves the fields' types and checks the initializers: the module's, with the type parameters
  # standing for themselves, or for an instance's type arguments.
  resolver: Resolver
  # What is found of the initializers' nodes: the module's, or an instance's own.
  facts: NodeFacts
  # Of an instance: the generic class or struct, which holds it among its instances, and so only
  # refers to it back, and the instances of its init and deinit.
  weak generic: ObjectInfo?
  init: Instance?
  deinit: Instance?
  # The instances of its own equals, compare and hash, of an instance of a generic class or struct
  # (see check_equality_methods).
  comparison_instances: Map<String, Instance> = Map()
  fields: FieldInfo[] = []
  # The interface that the declaration says it satisfies, with the type arguments of an instance.
  satisfies: InterfaceType? = nil
  methods: Map<String, FunctionLiteral> = Map()
  # The generic methods, those with type parameters, which have instances instead of a function.
  generics: Map<String, GenericRef> = Map()
  has_init = false
  # `deinit`, which runs when the object is released (see runtime lerta_run_deinit).
  has_deinit = false
  state: CheckState = UNCHECKED
  # Of a generic class or struct, whose type arguments make them.
  instances: ObjectInfo[] = []
  # Of an instance: whether its written field types are checked (see reject_invalid_type).
  fields_checked = false

# A field without an initializer, or with a default, is a constructor argument.
export const is_argument = (field: FieldInfo) -> field.value == nil or field.has_default

export const is_generic_object = (info: ObjectInfo) -> info.declaration.type_params.length > 0

# The function literal of a member that is a method.
export const method_literal = (member: MemberDeclaration) ->
  return nil if member.modifier == 'var'
  member.value as FunctionLiteral?

# Registers the names first, so that the members can refer to any of the types.
export const add_objects = (shared: Shared, declarations: TypeDeclaration[]) ->
  const program = shared.program
  for declaration in declarations
    const { name } = declaration.name
    fail_already_defined program, declaration.name if has_declared_type(shared, name)
    const symbol = "#{module_symbol_name(program, shared.index)}.#{name}"
    const is_struct = declaration.is_struct
    const { type_params } = declaration
    reject_bounds program, type_params
    const own = placeholders(type_params)
    const args = [own[param.name.name]! for param in type_params]
    const type = ObjectType(name, symbol, is_struct, args, module: shared.name)
    const resolver = with_type_parameters(module_resolver(shared.index), own)
    const info =
      ObjectInfo(declaration, type, resolver, facts: shared.facts, module_index: shared.index)
    shared.objects[name] = info
    program.infos[symbol] = info

const reject_bounds = (program: ProgramWide, type_params: TypeParameter[]) ->
  for param in type_params
    if const bound = param.bound
      fail program, bound.position, "a class's or struct's type parameter takes no bound so far"

# Resolves the written field types and adds the methods to the module's functions.
export const add_members = (shared: Shared) ->
  const program = shared.program
  for info in shared.objects.values()
    reject_bad_type_parameters program, module_resolver(shared.index), info.declaration.type_params
    const seen = Set<String>()
    for member in info.declaration.members
      const { name, position } = member.name
      if seen.has(name)
        const message = "'#{name}' is already a member of #{info.declaration.name.name}"
        fail program, position, message
      seen.add name
      if const literal = method_literal(member)
        add_method shared, info, member, literal
      else
        info.fields.push field_of_member(shared, info, member)
    add_interface_fields shared, info, seen if info.declaration.satisfies != nil

# The types written in a member: a field's, or a method's parameters' and result's.
export const written_types = (member: MemberDeclaration) ->
  const literal = method_literal(member) ? return [member.type]
  const types: TypeName?[] = [param.type for param in literal.params]
  types.push literal.return_type
  types

const add_interface_fields = (shared: Shared, info: ObjectInfo, declared: Set<String>) ->
  const program = shared.program
  const written = info.declaration.satisfies!
  # As a bound, an interface whose members name Self can be named.
  const interface_type = bound_interface(program, info.resolver, written)
  info.satisfies = interface_type
  const is_struct = info.declaration.is_struct
  const field_of = (member: InterfaceMember) ->
    const name = Identifier(name: member.name, position: written.position)
    FieldInfo(
      name
      type: member.type
      mutable: not is_struct
      value: nil
      has_default: false
      weak: false
    )
  const members = members_for(program, interface_type, info.type)
  const from_interface = [field_of(member) for member in members when not declared.has(member.name)]
  info.fields = [from_interface..., info.fields...]

const add_method = (
  shared: Shared, info: ObjectInfo, member: MemberDeclaration, literal: FunctionLiteral
) ->
  const program = shared.program
  const type_name = info.declaration.name.name
  const { name } = member.name
  const runs_alone = name == 'init' or name == 'deinit'
  if runs_alone and literal.params.length > 0
    fail program, literal.position, "#{name} takes no parameters"
  if runs_alone and literal.type_params.length > 0
    fail program, literal.position, "#{name} takes no type parameters"
  fail program, literal.position, "#{name} cannot yield" if runs_alone and literal.yields
  fail program, literal.position, "#{name} cannot await" if runs_alone and literal.awaits
  info.has_init = true if name == 'init'
  if name == 'deinit' and info.declaration.is_struct
    fail program, member.position, 'a struct has no deinit'
  info.has_deinit = true if name == 'deinit'
  info.methods[name] = literal
  # Those of a generic class or struct are generic, as those of an extend of a generic type are.
  if literal.type_params.length == 0 and not is_generic_object(info)
    add_function shared, method_key(type_name, name), member.name, literal, info.type
    return
  const receiver = Receiver(type: info.type, type_params: info.declaration.type_params)
  const generic = make_generic_function(shared, member.name, literal, receiver)
  info.generics[name] = add_generic(shared, generic)

const field_of_member = (shared: Shared, info: ObjectInfo, member: MemberDeclaration) ->
  const program = shared.program
  const is_struct = info.declaration.is_struct
  const value = member.value
  if value is FunctionLiteral
    const message = 'a function field is not supported yet; a method is written without var'
    fail program, member.position, message
  if is_struct and member.modifier == 'var'
    fail program, member.position, 'a struct field cannot be var'
  const type_name = member.type
  const type = type_name then resolve(program, info.resolver, type_name)
  const modifier = member.modifier
  const weak = modifier == 'weak' or modifier == 'weak!'
  reject_invalid_weak program, member, is_struct, type if weak
  const mutable = not is_struct and modifier != 'const' and modifier != 'weak!'
  FieldInfo type, mutable, value, weak, name: member.name, has_default: member.has_default

const reject_invalid_weak = (
  program: ProgramWide, member: MemberDeclaration, is_struct: Bool, type: Type?
) ->
  const fail_weak = (message: String) -> fail(program, member.position, message)
  fail_weak 'a struct field cannot be weak' if is_struct
  const is_bang = member.modifier == 'weak!'
  if is_bang
    fail_weak 'a weak! field is a constructor argument, without an initializer' if member.value
  const written = type ? fail_weak('the type of a weak field must be written')
  if not is_bang and written is not OptionalType
    const optional = "#{format_type(written)}?"
    fail_weak "a weak field may hold nil: write its type as #{optional}, or use weak!"
  const object = (is_bang then written else inner_of(written)) as ObjectType?
  fail_weak 'a weak field holds an object of a class' if object?.is_struct != false

# The class or struct of the name, of the module or imported.
export const object_type = (shared: Shared, name: String) ->
  return info.type if const info = shared.objects[name]
  const exported = imported_type(shared, name) ? builtin_type(shared, name) ? return nil
  const info = exported.info ? return nil
  info.type

# The class or struct of the type: an instance of a generic one for its type arguments, made on
# demand, once the generic one's members are known.
export const info_of = (program: ProgramWide, type: ObjectType) ->
  const declared = program.infos[type.symbol]!
  # A pattern, as the receiver of `extend<T> Stack<T>`, stands for any instance.
  return declared if same_type(type, declared.type) or type.args.any(has_type_parameters)
  const is_same = (instance: ObjectInfo) -> same_type(instance.type, type)
  declared.instances.find(is_same) ? add_instance(declared, type)

const add_instance = (generic: ObjectInfo, type: ObjectType) ->
  const { declaration, module_index } = generic
  const type_bindings = Map<String, Type>()
  const type_params = declaration.type_params
  type_bindings[param.name.name] = arg for (param, arg) in type_params.zip(type.args)
  const resolver = with_type_parameters(module_resolver(module_index), type_bindings)
  const info = ObjectInfo(declaration, type, module_index, resolver, generic, facts: NodeFacts())
  const instance_field = (field: FieldInfo) ->
    const { name, mutable, value, has_default, weak } = field
    const field_type = field.type
    const type = field_type then substitute(field_type, type_bindings)
    FieldInfo name, type, mutable, value, has_default, weak
  info.fields = [instance_field(field) for field in generic.fields]
  if const satisfies = generic.satisfies
    info.satisfies = substitute(satisfies, type_bindings) as InterfaceType!
  info.methods = generic.methods
  info.generics = generic.generics
  info.has_init = generic.has_init
  info.has_deinit = generic.has_deinit
  generic.instances.push info
  info

# The field's type, checking the initializers first if it is given by one alone.
export const field_type = (
  program: ProgramWide, info: ObjectInfo, field: FieldInfo, at: Position
) ->
  return type if const type = field.type
  abort_part() if info.state == FAILED
  if info.state == CHECKING
    fail program, at, "the type of '#{field.name.name}' is not known yet; write it"
  check_info program, info
  field.type ? abort_part()

# A generic class or struct is checked by its instances (see check_pending_objects). Whether a
# type satisfies the interface it names is checked once all are, as its methods may need the
# fields of any.
export const check_all_objects = (shared: Shared) ->
  const checked: ObjectInfo[] = []
  for info in shared.objects.values()
    continue if is_generic_object(info)
    check_info shared.program, info
    checked.push info
  check_all_satisfy shared.program, checked

# Checks the instances of the module's generic classes and structs left unchecked, which checking
# others may make; returns whether there were any.
export const check_pending_objects = (shared: Shared) ->
  const pending: ObjectInfo[] = []
  for info in shared.objects.values()
    pending.append [each for each in info.instances when each.state == UNCHECKED]
  check_info shared.program, info for info in pending
  check_all_satisfy shared.program, pending
  pending.length > 0

# Those with an error are left out, as their fields' types may be unknown. Each satisfies the
# interface it names, and its equals, compare and hash are of their types.
const check_all_satisfy = (program: ProgramWide, infos: ObjectInfo[]) ->
  for info in infos
    continue if info.state != CHECKED
    check_satisfies program, info
    check_equality_methods program, info

# Checks the initializers of the fields with the declaring module's checker, setting the types
# that they give. An instance gets the instances of its generic's init and deinit.
const check_info = (program: ProgramWide, info: ObjectInfo) ->
  return if info.state != UNCHECKED
  info.state = CHECKING
  const check = (): void ->
    reject_endless_instance program, info
    check_object program, info
  const checked = check_part(program, check)
  info.state = checked then CHECKED else FAILED
  return if not checked
  const generic = info.generic ? return
  const at = info.declaration.name.position
  const instance_of = (name: String) ->
    instantiate program, generic.generics[name]!, info.type.args, [], at
  info.init = instance_of('init') if info.has_init
  info.deinit = instance_of('deinit') if info.has_deinit

# An instance whose members make ever larger ones, as `A<T>` does with a field of `A<T[]>`, which
# its type alone may not tell, is stopped at the depth or the number that ends a generic
# function's.
const reject_endless_instance = (program: ProgramWide, info: ObjectInfo): void ->
  const generic = info.generic ? return
  const too_deep = info.type.args.any((type) -> type_depth(type) > MAX_TYPE_DEPTH)
  # The instance is counted already, as a generic function's is not before it is added.
  const too_many = generic.instances.length > MAX_INSTANCES
  return if not too_deep and not too_many
  const shared = program.shared[info.module_index]
  enter_module shared
  const { name, position } = info.declaration.name
  const endless = "'#{name}' needs instances without end, each with type arguments nested deeper"
  const message = too_deep then endless else "'#{name}' needs more than #{MAX_INSTANCES} instances"
  fail_in_context program, position, message, "from #{format_type(generic.instances[0].type)}"
