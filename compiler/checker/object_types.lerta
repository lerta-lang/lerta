# The classes and structs of the program: their fields and methods. The types of fields given by
# an initializer alone are found on demand, and so are the instances of a generic class or struct
# (see info_of).
import
  Expression, FunctionLiteral, Identifier, MemberDeclaration, Position, TypeDeclaration, TypeName
from '../ast'
import check_equality_methods, check_object, check_satisfies from './bodies'
import
  abort_part, check_part, enter_module, fail, fail_already_defined, fail_already_member,
  fail_in_context
from './diagnostics'
import add_function, add_generic, CheckState, method_key from './functions'
import
  bounds_of, endless_instances, GenericRef, Instance, instantiate, make_generic_function,
  MAX_INSTANCES, MAX_TYPE_DEPTH, Receiver, reject_bad_type_parameters
from './generics'
import builtin_type, imported_type from './imports'
import bound_interface, InterfaceMember, members_for from './interfaces'
import declared_symbol, has_declared_type, NodeFacts, ProgramWide, Shared from './shared'
import module_resolver, resolve, Resolver, with_type_parameters from './type_names'
import has_standing, is_pattern, placeholders, substitute, type_depth from './type_patterns'
import format_type, inner_of, InterfaceType, ObjectType, OptionalType, Type from '../types'

export class FieldInfo
  name: Identifier
  # Nil until found, for a field given by an initializer alone.
  var type: Type?
  mutable: Bool
  # The initializer, or the default of a constructor argument (see is_argument).
  value: Expression?
  has_default: Bool
  # A weak field of a type with `!` holds its object without keeping it alive (see codegen weak).
  weak: Bool

export class ObjectInfo
  declaration: TypeDeclaration
  # A generic one's type parameters stand for themselves as its type arguments.
  type: ObjectType
  # The declaring module, whose functions hold the methods' types.
  module_index: Int
  # Resolves the fields' types and checks the initializers: the module's, with the type parameters
  # standing for themselves, or for an instance's type arguments.
  resolver: Resolver
  # What is found of the initializers' nodes: the module's, or an instance's own.
  facts: NodeFacts
  # Of an instance: the generic class or struct, which holds it among its instances, and so only
  # refers to it back, and the instances of its init and deinit.
  weak generic: ObjectInfo?
  var init: Instance?
  var deinit: Instance?
  # The instances of its own equals, compare and hash, of an instance of a generic class or struct
  # (see check_equality_methods).
  comparison_instances: Map<String, Instance> = Map()
  var fields: FieldInfo[] = []
  # The interface that the declaration says it satisfies, with the type arguments of an instance.
  var satisfies: InterfaceType? = nil
  # Of a generic class or struct: the interface types that bound its type parameters (see
  # object_bounds).
  var bounds: InterfaceType?[] = []
  var methods: Map<String, FunctionLiteral> = Map()
  # The generic methods, those with type parameters, which have instances instead of a function.
  var generics: Map<String, GenericRef> = Map()
  var has_init = false
  # `deinit`, which runs when the object is released (see runtime lerta_run_deinit).
  var has_deinit = false
  var state: CheckState = UNCHECKED
  # Of a generic class or struct, whose type arguments make them.
  instances: ObjectInfo[] = []
  # Of a generic class or struct: those of type arguments that stand for themselves, which bodies
  # checked at their definitions read, and codegen never sees. The first, its definition, is of
  # its own type parameters, whose initializers it checks once; the others' fields have the types
  # that its fields have.
  standing: ObjectInfo[] = []
  # Of an instance: whether its written field types are checked (see reject_invalid_type).
  var fields_checked = false

  field_named := (name: String) -> @fields.find((each) -> each.name.name == name)

# A field without an initializer, or with a default, is a constructor argument.
export is_argument := (field: FieldInfo) -> field.value == nil or field.has_default

export is_generic_object := (info: ObjectInfo) -> not info.declaration.type_params.is_empty()

# The function literal of a member that is a method.
export method_literal := (member: MemberDeclaration) ->
  return nil if member.modifier == 'var'
  member.value as FunctionLiteral?

# Registers the names first, so that the members can refer to any of the types.
export add_objects := (shared: Shared, declarations: TypeDeclaration[]) ->
  program := shared.program
  for declaration in declarations
    { name } := declaration.name
    fail_already_defined program, declaration.name if has_declared_type(shared, name)
    symbol := declared_symbol(shared, name)
    is_struct := declaration.is_struct
    { type_params } := declaration
    own := placeholders(type_params)
    args := [own[param.name.name]! for param in type_params]
    type := ObjectType(name, symbol, is_struct, args, module: shared.name)
    resolver := with_type_parameters(module_resolver(shared.index), own)
    info := ObjectInfo(declaration, type, resolver, facts: shared.facts, module_index: shared.index)
    shared.objects[name] = info
    program.infos[symbol] = info

# Resolves the written field types and adds the methods to the module's functions.
export add_members := (shared: Shared) ->
  program := shared.program
  for info in shared.objects.values()
    { type_params } := info.declaration
    reject_bad_type_parameters program, module_resolver(shared.index), type_params
    info.bounds = bounds_of(program, info.resolver, type_params)
    seen: Set<String>
    for member in info.declaration.members
      { name, position } := member.name
      fail_already_member program, position, name, info.declaration.name.name unless seen.add(name)
      if literal := method_literal(member)
        add_method shared, info, member, literal
      else
        info.fields.push field_of_member(shared, info, member)
    add_interface_fields shared, info, seen if info.declaration.satisfies != nil

# The types written in a member: a field's, or a method's parameters' and result's.
export written_types := (member: MemberDeclaration) ->
  literal := method_literal(member) ? return [member.type]
  types: TypeName?[] = [param.type for param in literal.params]
  types.push literal.return_type
  types

add_interface_fields := (shared: Shared, info: ObjectInfo, declared: Set<String>) ->
  program := shared.program
  written := info.declaration.satisfies!
  # As a bound, an interface whose members name Self can be named.
  interface_type := bound_interface(program, info.resolver, written)
  info.satisfies = interface_type
  field_of := (member: InterfaceMember) ->
    name := Identifier(name: member.name, position: written.position)
    FieldInfo name, type: member.type, mutable: false, value: nil, has_default: false, weak: false
  members := members_for(program, interface_type, info.type)
  from_interface := [field_of(member) for member in members when member.name not in declared]
  info.fields = [from_interface..., info.fields...]

add_method := (
  shared: Shared, info: ObjectInfo, member: MemberDeclaration, literal: FunctionLiteral
) ->
  program := shared.program
  type_name := info.declaration.name.name
  { name } := member.name
  runs_alone := name == 'init' or name == 'deinit'
  if runs_alone and not literal.params.is_empty()
    fail program, literal.position, "#{name} takes no parameters"
  if runs_alone and not literal.type_params.is_empty()
    fail program, literal.position, "#{name} takes no type parameters"
  fail program, literal.position, "#{name} cannot yield" if runs_alone and literal.yields
  fail program, literal.position, "#{name} cannot await" if runs_alone and literal.awaits
  info.has_init = true if name == 'init'
  if name == 'deinit' and info.declaration.is_struct
    fail program, member.position, 'a struct has no deinit'
  info.has_deinit = true if name == 'deinit'
  info.methods[name] = literal
  # Those of a generic class or struct are generic, as those of an extend of a generic type are.
  if literal.type_params.is_empty() and not is_generic_object(info)
    add_function shared, method_key(type_name, name), member.name, literal, info.type
    return
  receiver := Receiver(type: info.type, type_params: info.declaration.type_params)
  generic := make_generic_function(shared, member.name, literal, receiver)
  info.generics[name] = add_generic(shared, generic)

field_of_member := (shared: Shared, info: ObjectInfo, member: MemberDeclaration) ->
  program := shared.program
  is_struct := info.declaration.is_struct
  value := member.value
  if value is FunctionLiteral
    message := 'a function field is not supported yet; a method is written without var'
    fail program, member.position, message
  if is_struct and member.modifier == 'var'
    fail program, member.position, 'a struct field cannot be var'
  type_name := member.type
  type := type_name then resolve(program, info.resolver, type_name)
  modifier := member.modifier
  weak := modifier == 'weak' or modifier == 'weak var'
  if member.throws and not weak
    fail program, member.position, "only a weak field's type is written with '!'"
  reject_invalid_weak program, member, is_struct, type if weak
  mutable := modifier == 'var' or modifier == 'weak var'
  FieldInfo type, mutable, value, weak, name: member.name, has_default: member.has_default

reject_invalid_weak := (
  program: ProgramWide, member: MemberDeclaration, is_struct: Bool, type: Type?
) ->
  fail_weak := (message: String) -> fail(program, member.position, message)
  fail_weak 'a struct field cannot be weak' if is_struct
  written := type ? fail_weak('the type of a weak field must be written')
  object := (written is OptionalType then inner_of(written) else written) as ObjectType?
  fail_weak 'a weak field holds an object of a class' if object?.is_struct != false
  if member.throws
    plain := format_type(written)
    if member.value
      fail_weak "a weak field of type #{plain}! is a constructor argument, without an initializer"
    if written is OptionalType
      fail_weak "write a weak field's type as #{plain} or as #{format_type(inner_of(written))}!"
  else if written is not OptionalType
    plain := format_type(written)
    fail_weak "a weak field may hold nil: write its type as #{plain}?, or as #{plain}! to throw"

# The class or struct of the name, of the module or imported.
export object_type := (shared: Shared, name: String) ->
  return info.type if info := shared.objects[name]
  exported := imported_type(shared, name) ? builtin_type(shared, name) ? return nil
  info := exported.info ? return nil
  info.type

# The class or struct of the type: an instance of a generic one for its type arguments, made on
# demand, once the generic one's members are known.
export info_of := (program: ProgramWide, type: ObjectType) ->
  declared := program.infos[type.symbol]!
  # A pattern, as the receiver of `extend<T> Stack<T>`, stands for any instance.
  return declared if type == declared.type or type.args.any(is_pattern)
  is_same := (instance: ObjectInfo) -> instance.type == type
  if type.args.any(has_standing)
    # The definition is the first view.
    definition_of declared
    return found if found := declared.standing.find(is_same)
    view := make_instance(declared, type, Map())
    declared.standing.push view
    return view
  declared.instances.find(is_same) ? add_instance(declared, type)

# The view of the generic class or struct with its type parameters standing for themselves, with
# their bounds, where its initializers are checked at its definition.
definition_of := (generic: ObjectInfo) ->
  return found if found := generic.standing.first()
  { type_params } := generic.declaration
  standing := placeholders(type_params, true)
  bounds: Map<String, InterfaceType>
  for (param, bound) in type_params.zip(generic.bounds)
    bounds[param.name.name] = substitute(bound, standing) as InterfaceType! if bound
  args := [standing[param.name.name]! for param in type_params]
  view := make_instance(generic, { generic.type..., args }, bounds)
  generic.standing.push view
  view

add_instance := (generic: ObjectInfo, type: ObjectType) ->
  info := make_instance(generic, type, Map())
  generic.instances.push info
  info

make_instance := (generic: ObjectInfo, type: ObjectType, bounds: Map<String, InterfaceType>) ->
  { declaration, module_index, methods, generics, has_init, has_deinit } := generic
  type_bindings := bindings_of(generic, type)
  with_arguments := with_type_parameters(module_resolver(module_index), type_bindings)
  resolver: Resolver = { with_arguments..., bounds }
  info := ObjectInfo(declaration, type, module_index, resolver, generic, facts: NodeFacts())
  instance_field := (field: FieldInfo) ->
    field_type := field.type
    FieldInfo(field..., type: field_type then substitute(field_type, type_bindings))
  info.fields = [instance_field(field) for field in generic.fields]
  if satisfies := generic.satisfies
    info.satisfies = substitute(satisfies, type_bindings) as InterfaceType!
  info.methods = methods
  info.generics = generics
  info.has_init = has_init
  info.has_deinit = has_deinit
  info

# The type arguments of the instance by the names of its generic's type parameters.
bindings_of := (generic: ObjectInfo, type: ObjectType) ->
  type_bindings: Map<String, Type>
  type_params := generic.declaration.type_params
  type_bindings[param.name.name] = arg for (param, arg) in type_params.zip(type.args)
  type_bindings

# The field's type, checking the initializers first if it is given by one alone; of a view other
# than its generic's definition, the type that the definition's initializer gives.
export field_type := (
  program: ProgramWide, info: ObjectInfo, field: FieldInfo, at: Position
): Type ->
  return type if type := field.type
  if generic := info.generic
    definition := generic.standing.first()
    if definition and info in generic.standing and info != definition
      own := definition.field_named(field.name.name)!
      return substitute(field_type(program, definition, own, at), bindings_of(generic, info.type))
  abort_part() if info.state == FAILED
  if info.state == CHECKING
    fail program, at, "the type of '#{field.name.name}' is not known yet; write it"
  check_info program, info
  field.type ? abort_part()

# A generic class or struct is checked by its instances (see check_pending_objects). Whether a
# type satisfies the interface it names is checked once all are, as its methods may need the
# fields of any.
export check_all_objects := (shared: Shared) ->
  checked: ObjectInfo[]
  for info in shared.objects.values()
    continue if is_generic_object(info)
    check_info shared.program, info
    checked.push info
  check_all_satisfy shared.program, checked

# Checks the instances of the module's generic classes and structs left unchecked, which checking
# others may make; returns whether there were any.
export check_pending_objects := (shared: Shared) ->
  pending: ObjectInfo[]
  for info in shared.objects.values()
    pending.append [each for each in info.instances when each.state == UNCHECKED]
  check_info shared.program, info for info in pending
  check_all_satisfy shared.program, pending
  not pending.is_empty()

# Checks the initializers of the generic class or struct at its definition, once; returns how it
# went.
export check_definition_of := (program: ProgramWide, generic: ObjectInfo) ->
  definition := definition_of(generic)
  check_info program, definition
  definition.state

# Those with an error are left out, as their fields' types may be unknown. Each satisfies the
# interface it names, and its equals, compare and hash are of their types.
check_all_satisfy := (program: ProgramWide, infos: ObjectInfo[]) ->
  for info in infos
    continue if info.state != CHECKED
    check_satisfies program, info
    check_equality_methods program, info

# Checks the initializers of the fields with the declaring module's checker, setting the types
# that they give. An instance gets the instances of its generic's init and deinit.
check_info := (program: ProgramWide, info: ObjectInfo): void ->
  return if info.state != UNCHECKED
  # As a generic function's, an instance of one whose definition has an error is not checked.
  if generic := info.generic
    if info not in generic.standing and check_definition_of(program, generic) == FAILED
      info.state = FAILED
      return
  info.state = CHECKING
  check := (): void ->
    reject_endless_instance program, info
    check_object program, info
  checked := check_part(program, check)
  info.state = checked then CHECKED else FAILED
  return unless checked
  generic := info.generic ? return
  at := info.declaration.name.position
  instance_of := (name: String) ->
    instantiate program, generic.generics[name]!, info.type.args, [], at
  info.init = instance_of('init') if info.has_init
  info.deinit = instance_of('deinit') if info.has_deinit

# An instance whose members make ever larger ones, as `A<T>` does with a field of `A<T[]>`, which
# its type alone may not tell, is stopped at the depth or the number that ends a generic
# function's.
reject_endless_instance := (program: ProgramWide, info: ObjectInfo): void ->
  generic := info.generic ? return
  too_deep := info.type.args.any((type) -> type_depth(type) > MAX_TYPE_DEPTH)
  # The instance is counted already, as a generic function's is not before it is added.
  too_many := generic.instances.length > MAX_INSTANCES
  return if not too_deep and not too_many
  shared := program.shared[info.module_index]
  enter_module shared
  { name, position } := info.declaration.name
  fail_in_context
    program
    position
    endless_instances(name, too_deep)
    "from #{format_type(generic.instances[0].type)}"
