# Whether a type satisfies an interface: it must have each member of the interface type, with the
# type arguments and the type itself, which Self stands for, in the members' types (see
# members_for). The type arguments of a generic interface may be inferred from how a type
# satisfies it.
import Call, Identifier, Member, Position from '../ast'
import fail from './diagnostics'
import set_type, type_of from './expression'
import ExtensionMethod from './extensions'
import common_field_problem from './fields'
import
  interface_members, interface_of, InterfaceMember, members_for, SELF, std_interface
from './interfaces'
import
  compares_by_bounds, find_member, member_type_by_name, record_member, union_method_problem
from './member'
import is_codable_bound, reject_uncodable from './codable'
import is_enum_bound, reject_non_enum from './enums'
import find_method from './methods'
import Body from './shared'
import infer, substitute, type_parameter_names from './type_patterns'
import
  binary_type, format_type, InterfaceType, is_kind, string_type, Type, UnionType
from '../types'

# Rejects a type that does not satisfy the interface type.
export reject_unsatisfied := (body: Body, type: Type, bound: InterfaceType, at: Position) ->
  return reject_uncodable(body, type, at) if is_codable_bound(body.program, bound)
  return reject_non_enum(body, type, at) if is_enum_bound(body.program, bound)
  for member in members_for(body.program, bound, type)
    satisfying_member body, type, bound, member, Identifier(position: at, name: member.name), nil

# Whether the type satisfies the interface type, which reject_unsatisfied would not reject. A bound
# that it checks in its own way, as Codable or Enum, only bounds type parameters, so it is not asked
# here.
export satisfies := (body: Body, type: Type, bound: InterfaceType, at: Position) ->
  satisfied := (member: InterfaceMember) ->
    name := Identifier(position: at, name: member.name)
    found := find_member(body, type, name, nil)
    unsatisfied_reason(body, type, member, name, found?.type) == nil
  members_for(body.program, bound, type).all(satisfied)

# The type's member that satisfies the interface's member.
satisfying_member := (
  body: Body, type: Type, bound: InterfaceType, member: InterfaceMember, name: Identifier,
  call: Call?
) ->
  found := find_member(body, type, name, call)
  reason := unsatisfied_reason(body, type, member, name, found?.type) ? return found!
  bound_name := format_type(bound)
  fail body.program, name.position, "#{format_type(type)} does not satisfy #{bound_name}: #{reason}"

# Why the type's member, of the type found, does not satisfy the interface's member, or nil if it
# does: it must be of exactly the member's type. Not merely of a type assignable to it: the
# generic code is checked with the type it has.
unsatisfied_reason := (
  body: Body, type: Type, member: InterfaceMember, name: Identifier, found: Type?
): String? ->
  return nil if found == member.type
  expected := format_type(member.type)
  case
    when found then "its #{member.name} is of type #{format_type(found)}, not #{expected}"
    when name.name == 'equals' and not compares_by_bounds(body, type, name.position)
      "it has no #{member.name} of type #{expected}"
    # Only a generic method has no type without a call.
    when find_method(body.program, type, name.name, body.extensions)
      "its #{member.name} has type parameters of its own"
    when type is UnionType
      union_method_problem(body, type, name) ? common_field_problem(body, type, name)!
    else "it has no #{member.name} of type #{expected}"

# Binds the type parameters in the type arguments of `pattern`, an interface type, to the types
# that the type's members give them, as Int[], whose iter gives an Iter<Int>, binds T of
# Iterable<T> to Int.
export infer_through_members := (
  body: Body, pattern: InterfaceType, type: Type, at: Position, bind: (String, Type) -> void
) ->
  info := interface_of(body.program, pattern)
  bindings: Map<String, Type>
  bindings[name] = arg for (name, arg) in info.type_params.zip(pattern.args)
  bindings[SELF] = type
  for member in interface_members(body.program, info)
    name := Identifier(position: at, name: member.name)
    found := member_type_by_name(body, type, name) ? continue
    infer substitute(member.type, bindings), found, bind

# `"#{x}"` calls `x.to_string()` (see Interpolation), which it records as typed here, so that x
# is typed once. x must be Stringable, or a Binary in a Binary literal, which takes it as it is.
export check_interpolated := (body: Body, part: Call, into_binary: Bool) ->
  member := part.callee
  panic 'an interpolated value is read by a call of its to_string()' unless member is Member
  type := type_of(body, member.object)
  return set_type(body, part, binary_type) if into_binary and is_kind(type, 'Binary')
  bound := std_interface(body.shared, 'Stringable', member.object.position).type
  to_string := members_for(body.program, bound, type)[0]
  name := Identifier(position: member.object.position, name: member.name.name)
  found := satisfying_member(body, type, bound, to_string, name, part)
  record_member body, member, found.target
  set_type body, member, found.type
  set_type body, part, string_type

# The method of the name that an extend of an interface in effect gives the type, by an interface
# that the type satisfies; the methods of such extends do not count for satisfying one.
export find_interface_extension := (body: Body, type: Type, name: Identifier) ->
  is_found := (method: ExtensionMethod) ->
    bound := method.bound ? return false
    method.name.name == name.name and satisfied_bindings(body, type, bound, name.position) != nil
  body.extensions.in_effect.find is_found

# The type arguments that the type gives the type parameters in the interface type if it
# satisfies it, or nil.
satisfied_bindings := (body: Body, type: Type, pattern: InterfaceType, at: Position) ->
  bindings: Map<String, Type>
  bind := (name: String, bound: Type) -> bindings[name] = bound unless name in bindings
  infer_through_members body, pattern, type, at, bind
  return nil unless type_parameter_names(pattern).all((name) -> name in bindings)
  bound := substitute(pattern, bindings)
  satisfies_member := (member: InterfaceMember) ->
    name := Identifier(position: at, name: member.name)
    unsatisfied_reason(body, type, member, name, member_type_by_name(body, type, name)) == nil
  members := members_for(body.program, bound as InterfaceType!, type)
  members.all(satisfies_member) then bindings

# The type of the items of a type that satisfies Iterable, which its iter gives.
export iterable_item_of := (body: Body, type: Type, at: Position) ->
  iterable := std_interface(body.shared, 'Iterable', at)
  bindings := satisfied_bindings(body, type, iterable.type, at) ? return nil
  bindings[iterable.type_params[0]]

# Fails with the message, or, for a type that has a member `iter` of another type, with why it is
# not Iterable.
export reject_not_iterable := (body: Body, type: Type, at: Position, message: String) ->
  name := Identifier(position: at, name: 'iter')
  found := member_type_by_name(body, type, name)
  fail body.program, at, message if found == nil
  iterable := std_interface(body.shared, 'Iterable', at)
  member := interface_members(body.program, iterable)[0]
  reason := unsatisfied_reason(body, type, member, name, found)!
  unsatisfied := "#{format_type(type)} does not satisfy #{format_type(iterable.type)}"
  fail body.program, at, "#{unsatisfied}: #{reason}"
