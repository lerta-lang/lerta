# What a name, an Identifier, refers to, which the checker records where it resolves the name (see
# NodeFacts.references), and codegen generates by.
import FunctionLiteral from '../ast'
import EnumValue from './member_targets'
import ArrayType, MapType, ObjectType, Type from '../types'

# A local of a scope of the function, or one that a function literal captures, which codegen finds
# in its own scopes by the name.
export struct ScopedLocal
  name: String

# A local function before its declaration, whose closure, not made yet, the reference makes with
# what it captures (see predeclare_local_functions).
export struct LocalFunction
  literal: FunctionLiteral

# A top-level value of the module of the index, as a function sees one of its module, or one that
# the module imports, by its name there.
export struct TopLevelValue
  module_index: Int
  name: String

# A function written in Lerta, of the module of the index: of the module, imported or a builtin.
export struct FunctionReference
  module_index: Int
  name: String

# A C function, which can only be called, and the extern that declares it, by its module's index
# and its name there.
export struct ExternReference
  symbol: String
  module_index: Int
  name: String

# A class or struct, which a call constructs.
export struct Constructor
  type: ObjectType

# The builtin Map, Set or Array, which a call makes, of the type.
export struct CollectionMaker
  type: MapType | ArrayType

# A builtin that encodes or decodes a value of the type (see checker/codable).
export struct CodableConversion
  direction: CodableDirection
  type: Type

export enum CodableDirection
  ENCODE
  DECODE

# A call of std:enums' `parse<E>(text)` or `members<E>()` of the enum E, a type parameter where the
# generic is checked as it stands (see checker/enums).
export struct EnumQuery
  kind: EnumQueryKind
  type: Type

export enum EnumQueryKind
  PARSE
  MEMBERS

export type Reference =
  ScopedLocal | TopLevelValue | FunctionReference | ExternReference | Constructor | CollectionMaker
  CodableConversion | EnumQuery | EnumValue | LocalFunction
