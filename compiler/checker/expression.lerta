# Types expressions; `name` types names, `member` members, `arguments` the arguments of calls,
# `object` classes and structs, `operator` the operators, `case` case, and `collection` arrays and
# maps. An expected type, where one is known, is passed down so that it can give literals their
# type.
import
  ArrayLiteral, Await, binary_literal_bytes, BinaryOperation, BooleanLiteral, Call, Case, Cast,
  Coalesce, Comprehension, Conditional, Expression, FloatLiteral, FunctionLiteral, Identifier, If,
  Index, IntegerLiteral, Interpolation, IsTest, Jump, MapLiteral, Member, NilLiteral, Node, Range,
  RecordLiteral, Return, StringLiteral, This, Throw, Try, TupleItem, TupleLiteral, TypeName,
  UnaryOperation, Unwrap, Yield
from '../ast'
import check_arguments from './arguments'
import type_of_case, type_of_conditional, type_of_if, type_of_try from './case'
import type_of_function_literal from './closure'
import
  made_collection, makes_builtin, type_of_array, type_of_new_map, type_of_filled_array,
  type_of_index, type_of_map, type_of_new_set
from './collection'
import record_constant from './constants'
import fail from './diagnostics'
import
  enum_parse_type, type_of_elided_member, type_of_literal_member, type_of_qualified_member
from './enums'
import type_of_generic_call from './generic_call'
import converts_through_itab from './interface_values'
import std_interface from './interfaces'
import float_literal, int_literal, integer_literal from './literals'
import check_loop_jump, type_of_comprehension from './loop'
import type_of_function_reference from './function_references'
import type_of_method_call, type_of_property from './member'
import json_direction, type_of_json_call from './json'
import generic_callee, named_function_literal, qualified_name, type_of_identifier from './name'
import narrowable from './narrowable'
import
  constructed_type, expected_struct, positional_value, type_of_construction, type_of_record,
  type_of_this
from './object'
import char_as_text, type_of_binary, type_of_coalesce, type_of_unary from './operator'
import check_return, check_yield, type_of_await from './result'
import check_interpolated from './satisfaction'
import Body from './shared'
import type_of_tuple, type_of_tuple_item from './tuple'
import resolve from './type_names'
import
  binary_type, bool_type, boxes_into, float_type, format_type, format_types, inner_of,
  inner_of_expected, is_assignable, is_float, is_integer, is_kind, is_one_of_kinds, never_type,
  nil_type, optional_type, OptionalType, settles_into, string_type, Type, UnionType, void_type
from '../types'

export type_of := (body: Body, expression: Expression, expected: Type? = nil) ->
  type := set_type(body, expression, compute_type(body, expression, expected))
  record_constant body, expression, type
  type

# The type that a literal takes where the type is expected, as an Int8 where an `Int8 | String` is:
# the union's one integer member, or one float member, if it has only one.
literal_hint := (expression: Expression, expected: Type?) ->
  type := inner_of_expected(expected) ? return nil
  return type unless type is UnionType
  of_kind := (is_kind_of: (Type) -> Bool) ->
    members := [member for member in type.members when is_kind_of(member)]
    members.length == 1 then members[0]
  case expression
    # An integer literal is a float where a float alone is expected.
    when IntegerLiteral
      return integer if integer := of_kind(is_integer)
      of_kind is_float
    when FloatLiteral then of_kind(is_float)
    else type

# `expected` is a hint: the caller still checks that the type fits. A literal where a `T?` is
# expected is a T, as where a T is, and where a union is, of its one member of the literal's kind.
compute_type := (body: Body, expression: Expression, expected: Type?): Type ->
  literal_kind := literal_hint(expression, expected)
  # A string literal of one character is a byte where a Byte is expected, a Char where a Char is.
  wants_character := literal_kind != nil and is_one_of_kinds(literal_kind, ['Byte', 'Char'])
  # A Binary literal of one byte is a byte where a Byte is expected.
  wants_byte := literal_kind != nil and is_kind(literal_kind, 'Byte')
  # An integer literal is an Int unless another integer type is expected.
  wants_integer :=
    literal_kind != nil and is_integer(literal_kind) and not is_kind(literal_kind, 'Int')
  wants_float := literal_kind != nil and is_float(literal_kind)
  program := body.program
  case expression
    when StringLiteral
      return integer_literal(program, expression, literal_kind!) if wants_character
      type_of_literal_member(body, expression, expected) ? string_type
    when Interpolation
      byte_literal := wants_byte and binary_literal_bytes(expression) != nil
      return integer_literal(program, expression, literal_kind!) if byte_literal
      for part in expression.parts
        check_interpolated body, part, expression.binary if part is Call
      expression.binary then binary_type else string_type
    when IntegerLiteral
      case
        when wants_integer then integer_literal(program, expression, literal_kind!)
        when wants_float then float_literal(program, expression, literal_kind!)
        else int_literal(program, expression)
    when FloatLiteral
      float_literal program, expression, wants_float then literal_kind! else float_type
    when NilLiteral then nil_type
    when Throw
      check_throw body, expression
      never_type
    when Jump
      check_loop_jump body, expression
      never_type
    when Return
      check_return body, expression
      never_type
    when Yield
      check_yield body, expression
      void_type
    when Await then type_of_await(body, expression)
    when IsTest then type_of_is_test(body, expression)
    when Cast then type_of_cast(body, expression)
    when This then type_of_this(body, expression)
    when Unwrap then expect_optional(body, expression.operand)
    when Coalesce then type_of_coalesce(body, expression)
    when BooleanLiteral then bool_type
    when Identifier
      return member if member := type_of_elided_member(body, expression, expected)
      return reference if reference := type_of_function_reference(body, expression, expected)
      type_of_identifier body, expression, false
    when Call then type_of_call(body, expression, expected)
    when UnaryOperation then type_of_unary(body, expression, expected)
    when BinaryOperation then type_of_binary(body, expression, expected)
    when Case then type_of_case(body, expression, expected)
    when Try then type_of_try(body, expression, expected)
    when If then type_of_if(body, expression, expected)
    when Conditional then type_of_conditional(body, expression, expected)
    when Member
      return type_of(body, name, expected) if name := qualified_name(body, expression)
      return member if member := type_of_qualified_member(body, expression, expected)
      return reference if reference := type_of_function_reference(body, expression, expected)
      type_of_property body, expression, expected
    when ArrayLiteral
      in_test := body.in_test_arrays[expression]
      type_of_array body, expression, in_test then in_test else expected
    when MapLiteral then type_of_map(body, expression, expected)
    when Comprehension then type_of_comprehension(body, expression, expected)
    when RecordLiteral then type_of_record(body, expression, expected)
    when TupleLiteral then type_of_tuple(body, expression, expected)
    when TupleItem then type_of_tuple_item(body, expression)
    when Index then type_of_index(body, expression)
    when FunctionLiteral then type_of_function_literal(body, expression, expected)
    when Range
      places := "after 'in', or as the index of an array or a Binary"
      message := "a range can only be used #{places}"
      fail program, expression.position, message

type_of_call := (body: Body, call: Call, expected: Type?): Type ->
  callee := call.callee
  # A call of `name.export` is the call of the name that the export is imported by.
  if callee is Member
    if name := qualified_name(body, callee)
      { args, named_args, type_args, position } := call
      qualified_call := Call(args, named_args, type_args, position, callee: name)
      body.facts.replacements[call] = qualified_call
      type := type_of(body, qualified_call, expected)
      { object_constructions, full_constructions } := body.facts
      for constructions in [object_constructions, full_constructions]
        constructions.add call if qualified_call in constructions
      return type
  if makes_builtin(body, call, 'Map')
    return made_collection(body, call, type_of_new_map(body, call, expected))
  if makes_builtin(body, call, 'Set')
    return made_collection(body, call, type_of_new_set(body, call, expected))
  if makes_builtin(body, call, 'Array')
    return made_collection(body, call, type_of_filled_array(body, call, expected))
  if generic := generic_callee(body, callee)
    return type_of_generic_call(body, call, generic, expected)
  if object_type := constructed_type(body, callee)
    type := type_of_construction(body, call, object_type, expected)
    body.facts.object_constructions.add call
    struct_type := expected_struct(expected) ? return type
    # `{}` is no record but an empty map.
    has_arguments := not call.args.is_empty() or not call.named_args.is_empty()
    # A value alone names no argument for a record to take.
    is_positional := positional_value(body, call, object_type) != nil
    body.facts.recordable.add call if has_arguments and type == struct_type and not is_positional
    return type
  return type_of_json_call(body, call, direction) if direction := json_direction(body, callee)
  if callee is Member
    if text_call := contains_of_char(body, call, callee)
      body.facts.replacements[call] = text_call
      return type_of(body, text_call, expected)
    if parse := enum_parse_type(body, callee)
      reject_type_arguments body, call
      return check_arguments(body, call, set_type(body, callee, parse), nil)
    return type_of_method_call(body, call, callee, expected)
  reject_type_arguments body, call
  callee_type :=
    if callee is Identifier
      set_type body, callee, type_of_identifier(body, callee, true)
    else
      type_of body, callee
  check_arguments body, call, callee_type, named_function_literal(body, callee)

# `s.contains(c)` of a String and a Char, as `s.contains(c.to_string())` (see char_as_text).
contains_of_char := (body: Body, call: Call, callee: Member): Call? ->
  return nil if callee.name.name != 'contains' or call.args.length != 1
  return nil unless call.named_args.is_empty()
  container := type_of(body, callee.object)
  return nil unless is_kind(container, 'String')
  part := call.args[0]
  text := char_as_text(container, type_of(body, part), part) ? return nil
  Call(call..., args: [text])

export reject_type_arguments := (body: Body, call: Call) ->
  return if call.type_args.is_empty()
  generics := 'a generic function, method, class or struct'
  fail body.program, call.callee.position, "only #{generics} takes type arguments"

export expect_type := (body: Body, expression: Expression, expected: Type) ->
  require_type body, expression, type_of(body, expression, expected), expected

type_of_is_test := (body: Body, test: IsTest) ->
  check_member_type body, test.value, test.type, resolve(body.program, body.resolver, test.type)
  bool_type

type_of_cast := (body: Body, cast: Cast) ->
  written := resolve(body.program, body.resolver, cast.type)
  type := check_member_type(body, cast.value, cast.type, inner_of(written))
  narrowed := body.facts.types[cast.value]!
  body.facts.redundant_casts.add cast if cast.throws and narrowed == type
  cast.throws then type else optional_type(type)

check_member_type := (body: Body, value: Expression, type_name: TypeName, type: Type) ->
  program := body.program
  value_type := unnarrowed_type(body, value, type_of(body, value))
  union := inner_of(value_type)
  unless union is UnionType
    message := "expected a value of a union type, got #{format_type(value_type)}"
    fail program, value.position, message
  body.facts.types[type_name] = type
  unless is_assignable(type, union)
    types := "the types #{format_type(union)} or a union of them"
    message := "#{format_type(type)} is not one of #{types}"
    fail program, type_name.position, message
  type

# The type that a local or a path of fields that the value names was declared with, before
# narrowing (see narrowing), so that it can be tested for any member of it.
export unnarrowed_type := (body: Body, value: Expression, type: Type) ->
  narrowable(body, value)?.declared ? type

# Records the type of a node, which type_of may not compute, such as a type pattern.
export set_type := (body: Body, node: Node, type: Type) ->
  body.facts.types[node] = type
  type

check_throw := (body: Body, throw_expression: Throw) ->
  value := throw_expression.message
  type := type_of(body, value)
  require_type body, value, type, std_interface(body.shared, 'Error', value.position).type

# A T or nil where a T? is expected is converted, and so is a value where an interface or an Iter
# is expected (see interface_values), a function where one that returns a Promise of its result is
# (see settles_into), or a union holds it in a box (see boxes_into), which codegen does where it
# generates it.
export require_type := (body: Body, expression: Expression, type: Type, expected: Type) ->
  assignable := is_assignable(type, expected)
  settles := not assignable and settles_into(type, expected)
  through_itab :=
    not assignable and not settles and converts_through_itab(body, expression, type, expected)
  if not assignable and not settles and not through_itab
    { first, second } := format_types(expected, type)
    fail body.program, expression.position, "expected #{first}, got #{second}"
  is_converted := not is_kind(type, 'never') and type != expected
  to_optional := expected is OptionalType and is_converted
  to_box := is_converted and boxes_into(type, expected)
  is_recorded := to_optional or settles or through_itab or to_box
  body.facts.conversions[expression] = expected if is_recorded

export expect_condition := (body: Body, expression: Expression) ->
  type := type_of(body, expression)
  unless is_one_of_kinds(type, ['Bool', OPTIONAL, 'never'])
    message := "expected Bool or an optional value, got #{format_type(type)}"
    fail body.program, expression.position, message
  if type is OptionalType and is_kind(type.inner, 'Bool')
    message := 'a Bool? cannot be a condition: compare it with true, false or nil'
    fail body.program, expression.position, message
  type

# The type of an optional value without nil.
export expect_optional := (body: Body, expression: Expression) ->
  type := type_of(body, expression)
  unless type is OptionalType
    fail body.program, expression.position, "expected an optional value, got #{format_type(type)}"
  type.inner
