# Types expressions; `name` types names, `member` members, `object` classes and structs,
# `operator` the operators, `case` case, and `collection` arrays and maps. An expected type, where
# one is known, is passed down so that it can give literals their type.
import {
  ArrayLiteral, BinaryOperation, BooleanLiteral, Call, Case, Cast, Coalesce, Comprehension
  Conditional, Expression, FunctionLiteral, Identifier, If, Index, IntegerLiteral, Interpolation
  IsTest, Jump, MapLiteral, Member, NamedType, NamedValue, NilLiteral, Node, Range, RecordLiteral
  Return, StringLiteral, This, Throw, Try, UnaryOperation, Unwrap
} from '../ast'
import { type_of_case, type_of_conditional, type_of_if, type_of_try } from './case'
import { type_of_function_literal } from './closure'
import {
  is_empty_map, type_of_array, type_of_empty_map, type_of_index, type_of_map
} from './collection'
import { fail } from './diagnostics'
import { required_params } from './functions'
import {
  enum_parse_type, type_of_elided_member, type_of_literal_member, type_of_qualified_member
} from './enums'
import { type_of_generic_call } from './generic_call'
import { converts_through_itab } from './interface_values'
import { std_interface } from './interfaces'
import { byte_literal } from './literals'
import { check_loop_jump, type_of_comprehension } from './loop'
import { type_of_method_call, type_of_property } from './member'
import { generic_callee, named_function_literal, type_of_identifier } from './name'
import { constructed_type, type_of_construction, type_of_record, type_of_this } from './object'
import { type_of_binary, type_of_coalesce, type_of_unary } from './operator'
import { check_return } from './result'
import { check_interpolated } from './satisfaction'
import { Body } from './shared'
import { resolve } from './type_names'
import {
  bool_type, format_type, format_types, FunctionType, inner_of, int_type, is_assignable, is_kind
  is_one_of_kinds, never_type, nil_type, optional_type, OptionalType, RecordType, same_type
  string_type, Type, UnionType
} from '../types'

export const type_of = (body: Body, expression: Expression, expected: Type? = nil) ->
  set_type body, expression, compute_type(body, expression, expected)

# `expected` is a hint: the caller still checks that the type fits.
const compute_type = (body: Body, expression: Expression, expected: Type?): Type ->
  const wants_byte = expected != nil and is_kind(expected, 'Byte')
  const program = body.program
  case expression
    when StringLiteral
      return byte_literal(program, expression) if wants_byte
      type_of_literal_member(body, expression, expected) ? string_type
    when Interpolation
      for part in expression.parts
        check_interpolated body, part if part is Call
      string_type
    when IntegerLiteral then wants_byte then byte_literal(program, expression) else int_type
    when NilLiteral then nil_type
    when Throw
      check_throw body, expression
      never_type
    when Jump
      check_loop_jump body, expression
      never_type
    when Return
      check_return body, expression
      never_type
    when IsTest then type_of_is_test(body, expression)
    when Cast then type_of_cast(body, expression)
    when This then type_of_this(body, expression)
    when Unwrap then expect_optional(body, expression.operand)
    when Coalesce then type_of_coalesce(body, expression)
    when BooleanLiteral then bool_type
    when Identifier
      const member = type_of_elided_member(body, expression, expected)
      member ? type_of_identifier(body, expression, false)
    when Call then type_of_call(body, expression, expected)
    when UnaryOperation then type_of_unary(body, expression, expected)
    when BinaryOperation then type_of_binary(body, expression, expected)
    when Case then type_of_case(body, expression, expected)
    when Try then type_of_try(body, expression, expected)
    when If then type_of_if(body, expression, expected)
    when Conditional then type_of_conditional(body, expression, expected)
    when Member then type_of_qualified_member(body, expression) ? type_of_property(body, expression)
    when ArrayLiteral then type_of_array(body, expression, expected)
    when MapLiteral then type_of_map(body, expression, expected)
    when Comprehension then type_of_comprehension(body, expression, expected)
    when RecordLiteral then type_of_record(body, expression, expected)
    when Index then type_of_index(body, expression)
    when FunctionLiteral then type_of_function_literal(body, expression, expected)
    when Range
      fail program, expression.position, "a range can only be used after 'in' of a 'for'"

const type_of_call = (body: Body, call: Call, expected: Type?): Type ->
  const callee = call.callee
  if const generic = generic_callee(body, callee)
    return type_of_generic_call(body, call, generic, expected)
  if const object_type = constructed_type(body, callee)
    return type_of_construction(body, call, object_type, expected)
  reject_type_arguments body, call if not (callee is Member)
  return type_of_empty_map(body, call, expected) if is_empty_map(body, callee)
  if callee is Member
    if const parse = enum_parse_type(body, callee)
      reject_type_arguments body, call
      return check_arguments(body, call, set_type(body, callee, parse), nil)
    return type_of_method_call(body, call, callee, expected)
  const callee_type =
    if callee is Identifier
      set_type(body, callee, type_of_identifier(body, callee, true))
    else
      type_of(body, callee)
  check_arguments body, call, callee_type, named_function_literal(body, callee)

export const reject_type_arguments = (body: Body, call: Call) ->
  return if call.type_args.length == 0
  const generics = 'a generic function, method, class or struct'
  fail body.program, call.callee.position, "only #{generics} takes type arguments"

# The result of a call of a function of the type, once its arguments are checked. `declaration`,
# the function's literal if the call knows it, tells the parameters that may be left out.
export const check_arguments = (
  body: Body, call: Call, callee_type: Type, declaration: FunctionLiteral?
) ->
  const program = body.program
  if not (callee_type is FunctionType)
    fail program, call.position, "cannot call a value of type #{format_type(callee_type)}"
  const params = callee_type.params
  if call.named_args.length > 0
    gather_named_args body, call, params.length > 0 then params.last() else nil
  check_argument_count body, call, params.length, declaration
  expect_type body, arg, params[i] for arg, i in call.args
  callee_type.result

# A call gives every parameter, or leaves out some of those with defaults, from the last.
export const check_argument_count = (
  body: Body, call: Call, param_count: Int, declaration: FunctionLiteral?
) ->
  const required = declaration then required_params(declaration) else param_count
  const count = call.args.length
  return if count >= required and count <= param_count
  const range = required == param_count then '' else "#{required} to "
  const expected = "#{range}#{param_count}"
  fail body.program, call.position, "expected #{expected} argument(s), got #{count}"

# Named arguments are the fields of an anonymous struct for the last parameter: `draw(x: 1, y: 2)`
# is `draw({ x: 1, y: 2 })`. The call is rewritten into that form so that codegen, which reads
# named arguments only as a construction, generates it as any other call. Every pass reading the
# arguments (jump_positions, codegen) visits the same values in either form. The instances of a
# generic function share its literal, so later ones see the rewritten form, which checks as the
# named one does.
const gather_named_args = (body: Body, call: Call, last_param: Type?) ->
  const name = call.named_args[0].name
  if not is_record_parameter(last_param)
    const uses = 'construct a class or struct, or give a last parameter of an anonymous struct type'
    fail body.program, name.position, "named arguments #{uses}"
  const fields = [NamedValue(name: arg.name, value: arg.value) for arg in call.named_args]
  call.args.push RecordLiteral(fields, position: name.position)
  call.named_args = []

const is_record_parameter = (param: Type?) ->
  const type = param ? return false
  inner_of(type) is RecordType

export const expect_type = (body: Body, expression: Expression, expected: Type) ->
  require_type body, expression, type_of(body, expression, expected), expected

# `x is T`: x has a union type, or an optional one, and T is one of its types.
const type_of_is_test = (body: Body, test: IsTest) ->
  check_member_type body, test.value, test.type, resolve(body.program, body.resolver, test.type)
  bool_type

# `x as T?` or `x as T!`: as for `x is T`, with the type written without its `?`.
const type_of_cast = (body: Body, cast: Cast) ->
  const written = resolve(body.program, body.resolver, cast.type)
  const type = check_member_type(body, cast.value, cast.type, inner_of(written))
  cast.throws then type else optional_type(type)

# The type, which must be a member of the value's union type, optional or not, or a union of
# some of its members.
const check_member_type = (body: Body, value: Expression, type_name: NamedType, type: Type) ->
  const program = body.program
  const value_type = type_of(body, value)
  const union = inner_of(value_type)
  if not (union is UnionType)
    const message = "expected a value of a union type, got #{format_type(value_type)}"
    fail program, value.position, message
  body.facts.types[type_name] = type
  if not is_assignable(type, union)
    const types = "the types #{format_type(union)} or a union of them"
    const message = "#{format_type(type)} is not one of #{types}"
    fail program, type_name.position, message
  type

# Records the type of a node, which type_of may not compute, such as a type pattern.
export const set_type = (body: Body, node: Node, type: Type) ->
  body.facts.types[node] = type
  type

# A throw takes a value of a type that satisfies Error, which it converts to an Error.
const check_throw = (body: Body, throw_expression: Throw) ->
  const value = throw_expression.message
  const type = type_of(body, value)
  require_type body, value, type, std_interface(body.shared, 'Error', value.position).type

# A T or nil where a T? is expected is converted, and so is a value where an interface or an Iter
# is expected (see interface_values), which codegen does where it generates it.
export const require_type = (body: Body, expression: Expression, type: Type, expected: Type) ->
  const assignable = is_assignable(type, expected)
  const through_itab = not assignable and converts_through_itab(body, expression, type, expected)
  if not assignable and not through_itab
    const { first, second } = format_types(expected, type)
    fail body.program, expression.position, "expected #{first}, got #{second}"
  const is_converted = not is_kind(type, 'never') and not same_type(type, expected)
  const to_optional = expected is OptionalType and is_converted
  body.facts.conversions[expression] = expected if to_optional or through_itab

# A condition is a Bool, or an optional value that holds when it is not nil.
export const expect_condition = (body: Body, expression: Expression) ->
  const type = type_of(body, expression)
  if not is_one_of_kinds(type, ['Bool', OPTIONAL, 'never'])
    const message = "expected Bool or an optional value, got #{format_type(type)}"
    fail body.program, expression.position, message
  type

# The type of an optional value without nil.
export const expect_optional = (body: Body, expression: Expression) ->
  const type = type_of(body, expression)
  if not (type is OptionalType)
    fail body.program, expression.position, "expected an optional value, got #{format_type(type)}"
  type.inner
