# Where `break`, `continue` and `return` may be written as expressions: where nothing evaluated
# before them is still held, so that jumping away leaves nothing to release. That is a statement,
# the value of a declaration or of an assignment to a variable, and, within those, the fallback of
# `?` and the values of `then`/`else` and of case arms. `yield`, which jumps away for good if its
# Iter is dropped there, gives no value, so it may only be a statement where `return` may be.
import
  ArrayLiteral, Assignment, Await, BinaryOperation, Binding, BooleanLiteral, Call, Case, Cast,
  Coalesce, Comprehension, Condition, Conditional, Declaration, EnumDeclaration, Expression, Extend,
  Extern, For, FunctionLiteral, Identifier, If, Import, Index, IntegerLiteral, InterfaceDeclaration,
  Interpolation, IsTest, Jump, MapLiteral, Member, MemberDeclaration, NilLiteral, Pass, Position,
  Range, RecordLiteral, Return, Statement, StringLiteral, This, Throw, Try, TupleItem, TupleLiteral,
  TypeAlias, TypeDeclaration, UnaryOperation, Unwrap, While, Yield
from '../ast'
import { fail } from './diagnostics'
import { ProgramWide } from './shared'

# Which jumps the statements of a block may make. Inside an expression that holds values, such as
# `'a' + case ...`, the statements of an arm may not return, and may only leave or continue a loop
# that starts among them.
struct Jumps
  # Why the jumps that are not allowed are not, if not for the held values.
  reason: String?
  may_return = default false
  may_leave_loop = default false
  # Why a `yield` is not allowed, where it is not for its own reason.
  yield_reason: String? = default nil

const all_jumps = Jumps(may_return: true, may_leave_loop: true)
const no_jumps = Jumps()

# Leaving a try that has a finally would have to run the finally on the way, which is not
# supported yet.
const within_finally = Jumps(
  reason: 'cannot leave a try that has a finally yet'
  yield_reason: 'cannot be in a try that has a finally yet'
)

# A default is computed by an entry of its own (see generate_default_entry), before the body.
const in_default = Jumps(reason: 'cannot be in a default')

export const reject_misplaced_jumps = (program: ProgramWide, statements: Array<Statement>) ->
  visit_statements program, statements, all_jumps

const visit_statements = (program: ProgramWide, statements: Array<Statement>, jumps: Jumps) ->
  visit_statement program, statement, jumps for statement in statements

const visit_statement = (program: ProgramWide, statement: Statement, jumps: Jumps): void ->
  const { may_return, reason, yield_reason } = jumps
  const in_loop = Jumps(may_return, reason, yield_reason, may_leave_loop: true)
  case statement
    when Declaration then visit program, statement.value, jumps
    when Assignment
      const target = statement.target
      visit program, target, no_jumps
      visit program, statement.value, target is Identifier then jumps else no_jumps
    when While
      visit_condition program, statement.condition
      visit_statements program, statement.body, in_loop
    when For
      visit program, statement.iterable, no_jumps
      visit_statements program, statement.body, in_loop
    when Yield
      const own_reason = jumps.yield_reason
      const held = 'cannot be here: only where nothing evaluated before it is still held'
      const message = "'yield' #{own_reason ? jumps.reason ? held}"
      fail program, statement.position, message if not jumps.may_return
      visit program, statement.value, no_jumps
    when TypeDeclaration then visit_members program, statement.members
    when Extend then visit_members program, statement.members
    when Import, Pass, EnumDeclaration, InterfaceDeclaration, TypeAlias, Extern then pass
    else visit program, statement as Expression!, jumps

const visit_members = (program: ProgramWide, members: Array<MemberDeclaration>) ->
  for member in members
    visit program, value, all_jumps if const value = member.value

const visit_condition = (program: ProgramWide, condition: Condition) ->
  if condition is Binding
    visit program, condition.value, no_jumps
  else
    visit program, condition as Expression!, no_jumps

# `jumps` says which jumps the expression itself may be; its operands, which are evaluated while
# others are held, may make none.
const visit = (program: ProgramWide, expression: Expression, jumps: Jumps): void ->
  const operand = (child: Expression) -> visit(program, child, no_jumps)
  case expression
    when Jump
      const kind = expression.kind.to_string()
      check_jump program, kind, jumps.may_leave_loop, jumps.reason, expression.position
    when Return
      check_jump program, 'return', jumps.may_return, jumps.reason, expression.position
      visit program, value, jumps if const value = expression.value
    when Yield then fail(program, expression.position, "'yield' can only be a statement")
    when Coalesce
      operand expression.value
      visit program, expression.fallback, jumps
    when Conditional
      operand expression.condition
      visit program, expression.then_value, jumps
      visit program, expression.else_value, jumps
    when If
      visit_condition program, expression.condition
      visit_statements program, expression.then_body, jumps
      visit_statements program, expression.else_body, jumps
    when Case
      operand subject if const subject = expression.subject
      for arm in expression.arms
        operand pattern for pattern in arm.patterns
        visit_statements program, arm.body, jumps
      visit_statements program, otherwise, jumps if const otherwise = expression.otherwise
    when Try
      const inside = expression.finally_body then within_finally else jumps
      visit_statements program, expression.body, inside
      visit_statements program, clause.body, inside for clause in expression.catches
      if const finally_body = expression.finally_body
        visit_statements program, finally_body, within_finally
    # No loop is outside a function; a jump out of none is an error of its own.
    when FunctionLiteral
      for param in expression.params
        visit program, default, in_default if const default = param.default
      visit_statements program, expression.body, all_jumps
    when Interpolation
      for part in expression.parts
        operand part if part is Call
    when ArrayLiteral
      operand element for element in expression.elements
    when Comprehension
      operand expression.element
      operand expression.iterable
      operand guard if const guard = expression.guard
    when RecordLiteral
      operand field.value for field in expression.fields
    when TupleLiteral
      operand item for item in expression.items
    when TupleItem then operand expression.tuple
    when MapLiteral
      for entry in expression.entries
        operand entry.key
        operand entry.value
    when Call
      operand expression.callee
      operand arg for arg in expression.args
      operand arg.value for arg in expression.named_args
    when Index
      operand expression.object
      operand expression.index
    when Member then operand expression.object
    when UnaryOperation then operand expression.operand
    when Unwrap then operand expression.operand
    when BinaryOperation
      operand expression.left
      operand expression.right
    when Range
      operand expression.start
      operand expression.end
    when Throw then operand expression.message
    when Await then operand expression.operand
    when IsTest then operand expression.value
    when Cast then operand expression.value
    when StringLiteral, IntegerLiteral, BooleanLiteral, NilLiteral, Identifier, This then pass

const check_jump = (
  program: ProgramWide, keyword: String, allowed: Bool, reason: String?, at: Position
) ->
  return if allowed
  fail program, at, "'#{keyword}' #{reason}" if reason
  const statement = 'a statement or as the value of a declaration or of an assignment to a variable'
  const through = "directly or through '?', then/else or case arms"
  fail program, at, "'#{keyword}' cannot be used here: only as #{statement}, #{through}"
