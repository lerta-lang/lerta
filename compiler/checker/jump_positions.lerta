# Where `break`, `continue`, `return` and `yield` may be written (see
# docs/reference/control-flow.md#if-and-while and docs/reference/functions.md#functions-that-yield):
# where nothing evaluated before them is still held, so that jumping away leaves nothing to
# release. A `yield` jumps away for good if its Iter is dropped there.
import
  Assignment, Binding, Case, Coalesce, Condition, Conditional, Declaration, EnumDeclaration,
  Expression, Extend, Extern, Intrinsic, For, FunctionLiteral, Identifier, If, Import,
  InterfaceDeclaration, Jump, MemberDeclaration, operands_of, Pass, Position, Return, Statement,
  Try, TypeAlias, TypeDeclaration, While, Yield
from '../ast'
import fail from './diagnostics'
import ProgramWide from './shared'

# Which jumps the statements of a block may make. Inside an expression that holds values, such as
# `'a' + case ...`, the statements of an arm may not return, and may only leave or continue a loop
# that starts among them.
struct Jumps
  # Why the jumps that are not allowed are not, if not for the held values.
  reason: String?
  may_return := false
  may_leave_loop := false

  # Why a `yield` is not allowed, where it is not for its own reason.
  yield_reason: String?

all_jumps := Jumps(may_return: true, may_leave_loop: true)
no_jumps := Jumps()

FINALLY_YIELD_REASON := 'cannot be in a try that has a finally yet'

within_finally := Jumps(reason: 'cannot leave a finally', yield_reason: FINALLY_YIELD_REASON)

# A default is computed by an entry of its own (see generate_default_entry), before the body.
in_default := Jumps(reason: 'cannot be in a default')

export reject_misplaced_jumps := (program: ProgramWide, statements: Statement[]) ->
  visit_statements program, statements, all_jumps

visit_statements := (program: ProgramWide, statements: Statement[], jumps: Jumps) ->
  for statement in statements
    visit_statement program, statement, jumps

visit_statement := (program: ProgramWide, statement: Statement, jumps: Jumps): void ->
  in_loop := Jumps(jumps..., may_leave_loop: true)
  case statement
    when Declaration then visit(program, statement.value, jumps)
    when Assignment
      target := statement.target
      visit program, target, no_jumps
      visit program, statement.value, target is Identifier then jumps else no_jumps
    when While
      visit_condition program, statement.condition
      visit_statements program, statement.body, in_loop
    when For
      visit program, statement.iterable, no_jumps
      visit_statements program, statement.body, in_loop
    when Yield
      own_reason := jumps.yield_reason
      held := 'cannot be here: only where nothing evaluated before it is still held'
      message := "'yield' #{own_reason ? jumps.reason ? held}"
      if own_reason or not jumps.may_return
        fail program, statement.position, message
      visit program, statement.value, no_jumps
    when TypeDeclaration, Extend then visit_members(program, statement.members)
    when Import, Pass, EnumDeclaration, InterfaceDeclaration, TypeAlias, Extern, Intrinsic then pass
    else visit(program, statement, jumps)

visit_members := (program: ProgramWide, members: MemberDeclaration[]) ->
  for member in members
    if value := member.value
      visit program, value, all_jumps

visit_condition := (program: ProgramWide, condition: Condition) ->
  if condition is Binding
    visit program, condition.value, no_jumps
  else
    visit program, condition, no_jumps

# `jumps` says which jumps the expression itself may be; its operands, which are evaluated while
# others are held, may make none.
visit := (program: ProgramWide, expression: Expression, jumps: Jumps): void ->
  operand := (child: Expression) -> visit(program, child, no_jumps)
  case expression
    when Jump
      kind := expression.kind.to_string()
      check_jump program, kind, jumps.may_leave_loop, jumps.reason, expression.position
    when Return
      check_jump program, 'return', jumps.may_return, jumps.reason, expression.position
      operand value if value := expression.value
    when Yield then fail(program, expression.position, "'yield' can only be a statement")
    when Coalesce
      operand expression.value
      visit program, expression.fallback, jumps
    when Conditional
      operand expression.condition
      visit program, expression.then_value, jumps
      visit program, expression.else_value, jumps
    when If
      visit_condition program, expression.condition
      visit_statements program, expression.then_body, jumps
      visit_statements program, expression.else_body, jumps
    when Case
      operand subject if subject := expression.subject
      for arm in expression.arms
        operand pattern for pattern in arm.patterns
        visit_statements program, arm.body, jumps
      if otherwise := expression.otherwise
        visit_statements program, otherwise, jumps
    when Try
      finally_inside := Jumps(jumps..., yield_reason: FINALLY_YIELD_REASON)
      inside := expression.finally_body then finally_inside else jumps
      visit_statements program, expression.body, inside
      for clause in expression.catches
        visit_statements program, clause.body, inside
      if finally_body := expression.finally_body
        visit_statements program, finally_body, within_finally
    # No loop is outside a function; a jump out of none is an error of its own.
    when FunctionLiteral
      for param in expression.params
        if default := param.default
          visit program, default, in_default
      visit_statements program, expression.body, all_jumps
    else operand(each) for each in operands_of(expression)

check_jump := (
  program: ProgramWide, keyword: String, allowed: Bool, reason: String?, at: Position
) ->
  return if allowed
  if reason
    fail program, at, "'#{keyword}' #{reason}"
  statement := 'a statement or as the value of a declaration or of an assignment to a variable'
  through := "directly or through '?', then/else or case arms"
  fail program, at, "'#{keyword}' cannot be used here: only as #{statement}, #{through}"
