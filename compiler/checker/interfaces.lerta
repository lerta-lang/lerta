# Interfaces, `interface Shape` with members such as `area: () -> Int`, or generic ones,
# `interface Iterable<T>`: their declarations, their types and their members. A type satisfies an
# interface by its members (see satisfaction); an interface bounds type parameters, and is the
# type of values that hold a value of a type that satisfies it (see interface_values).
import {
  FunctionTypeName, InterfaceDeclaration, NamedType, Position, RecordTypeName, TupleTypeName
  TypeName, UnionTypeName
} from '../ast'
import { fail, fail_already_defined } from './diagnostics'
import { reject_bad_type_parameters } from './generics'
import { builtin_export, has_import, imported_export, InterfaceExport } from './imports'
import { ProgramWide, Shared } from './shared'
import { has_type, module_resolver, resolve, Resolver, with_type_parameters } from './type_names'
import { placeholders, substitute } from './type_patterns'
import { bool_type, FunctionType, InterfaceType, Type, TypeParameterType } from '../types'

# A type satisfies the member if it has a method, field or property of the name and the type.
export struct InterfaceMember
  name: String
  type: Type

# In an interface's members, `Self` stands for the type that satisfies it.
export const SELF = 'Self'

export class InterfaceInfo
  name: String
  # The type parameters standing for themselves as its type arguments.
  type: InterfaceType
  type_params: Array<String>
  # Whether a member names Self, which a value of the interface type could not tell.
  names_self: Bool
  # In which the type parameters and Self stand for themselves; nil until resolved (see
  # interface_members), as the types may name those declared later.
  members: Array<InterfaceMember>?
  # The declaring module, which resolves the members' types; nil for a builtin interface.
  module_index: Int?
  declaration: InterfaceDeclaration?

const iter_item = TypeParameterType(name: 'T')
const gives_bool = FunctionType(params: [], result: bool_type)
const has_next = InterfaceMember(name: 'has_next', type: gives_bool)
const next = InterfaceMember(name: 'next', type: FunctionType(params: [], result: iter_item))

# What a value must have to convert to an Iter<T>, as an `Iter<T>` in messages (see
# converts_to_iter); the compiler declares it, and it cannot be named.
const iter_source = InterfaceInfo(
  name: 'Iter', type_params: [iter_item.name], names_self: false, module_index: nil
  declaration: nil, members: [has_next, next]
  type: InterfaceType(name: 'Iter', symbol: 'IterSource', module: 'std:builtins', args: [iter_item])
)

# The interface type that a value must satisfy to convert to an Iter of the items.
export const iter_source_type = (item: Type) ->
  const { name, symbol, module } = iter_source.type
  InterfaceType name, symbol, module, args: [item]

# The interface of the name that std:builtins declares, as Stringable, which interpolation
# requires, or Iterable, which `for` goes through, whatever the module's own names. std:io, which
# does not import std:builtins, cannot use them (see docs/reference/modules.md).
export const std_interface = (shared: Shared, name: String, at: Position): InterfaceInfo ->
  const fail_missing = ->
    const where = 'std:builtins, which this module does not import'
    fail shared.program, at, "#{name} is declared in #{where}"
  # std:builtins does not import itself.
  return shared.interfaces[name] ? fail_missing() if shared.imports.builtins == nil
  const exported = builtin_export(shared, name)
  exported is InterfaceExport then exported.info else fail_missing()

# Registers the module's interfaces, after its classes, structs and enums (see add_enums).
export const add_interfaces = (shared: Shared, declarations: Array<InterfaceDeclaration>) ->
  const program = shared.program
  for declaration in declarations
    const { name } = declaration.name
    fail_already_defined program, declaration.name if has_declared_type(shared, name)
    reject_invalid_members program, declaration
    const module_index = shared.index
    const type_params = [param.name.name for param in declaration.type_params]
    const args: Array<Type> = [TypeParameterType(name: param) for param in type_params]
    const symbol = "#{module_index}.#{name}"
    const type = InterfaceType(name, symbol, args, module: shared.name)
    const names_self = declaration.members.any((member) -> names_type(member.type, SELF))
    const info = InterfaceInfo(
      name, type, type_params, names_self, declaration, module_index, members: nil
    )
    shared.interfaces[name] = info
    program.interfaces[symbol] = info

# A member is `name: Type`.
const reject_invalid_members = (program: ProgramWide, declaration: InterfaceDeclaration) ->
  const seen: Map<String, Bool> = Map()
  for member in declaration.members
    const { name, position } = member.name
    if seen.has(name)
      fail program, position, "'#{name}' is already a member of #{declaration.name.name}"
    seen.add name
    if const modifier = member.modifier
      fail program, member.position, "an interface member cannot be #{modifier}"
    if member.value != nil
      fail program, member.position, 'an interface member has a type and no value'

# As a generic function's (see reject_bad_type_parameters), besides Self, and without bounds.
const reject_invalid_type_parameters = (program: ProgramWide, info: InterfaceInfo) ->
  const type_params = info.declaration!.type_params
  reject_bad_type_parameters program, module_resolver(info.module_index!), type_params
  for param in type_params
    const { name } = param.name
    fail_already_defined program, param.name if name == SELF
    if const bound = param.bound
      fail program, bound.position, "an interface's type parameter takes no bound"

# Whether the written type names the type of the name, in any of its parts.
const names_type = (type_name: TypeName?, name: String): Bool ->
  const written = type_name ? return false
  case written
    when NamedType then written.name == name or written.args.any((arg) -> names_type(arg, name))
    when FunctionTypeName
      written.params.any((param) -> names_type(param, name)) or names_type(written.result, name)
    when RecordTypeName then written.fields.any((field) -> names_type(field.type, name))
    when TupleTypeName then written.items.any((item) -> names_type(item, name))
    when UnionTypeName then written.members.any((member) -> names_type(member, name))

# Whether the module declares a class, struct, enum or interface of the name.
export const has_declared_type = (shared: Shared, name: String) ->
  shared.objects.has(name) or shared.enums.has(name) or shared.interfaces.has(name)

# The interface that the module imports by the name, marking its import as used.
export const imported_interface = (shared: Shared, name: String) ->
  const imported = shared.imports.names[name] ? return nil
  const exported = imported_export(shared.program, imported) as InterfaceExport? ? return nil
  imported.used = true
  exported.info

# The interface of the name where the resolver resolves names: one of the module, an imported one,
# or one that std:builtins exports, unless another type takes its name.
export const named_interface = (program: ProgramWide, resolver: Resolver, name: String) ->
  const shared = program.shared[resolver.module_index]
  return own if const own = shared.interfaces[name]
  return imported if const imported = imported_interface(shared, name)
  const is_other_name = has_type(program, resolver, name) or has_import(shared, name)
  return nil if is_other_name
  const exported = builtin_export(shared, name)
  exported is InterfaceExport then exported.info else nil

export const interface_of = (program: ProgramWide, type: InterfaceType) ->
  return iter_source if type.symbol == iter_source.type.symbol
  program.interfaces[type.symbol] ? panic("no interface #{type.symbol}")

# The written interface type, with its type arguments, as a type of values: one whose members name
# Self can only bound a type parameter.
export const value_interface_type = (
  program: ProgramWide, resolver: Resolver, info: InterfaceInfo, type_name: NamedType
) ->
  if info.names_self
    const reason = "its members name #{SELF}, which its values could not tell"
    fail program, type_name.position, "'#{info.name}' can only bound a type parameter: #{reason}"
  instantiate program, resolver, info, type_name

# The interface that bounds a type parameter, or that a class or struct says it satisfies, with its
# type arguments.
export const bound_interface = (
  program: ProgramWide, resolver: Resolver, bound: NamedType
): InterfaceType ->
  const { name, position } = bound
  if const info = named_interface(program, resolver, name)
    fail program, position, 'a bound cannot be optional' if bound.optional
    return instantiate(program, resolver, info, bound)
  const shared = program.shared[resolver.module_index]
  const is_other_name = has_type(program, resolver, name) or has_import(shared, name)
  const message =
    if is_other_name
      "'#{name}' is not an interface"
    else
      "unknown interface '#{name}'"
  fail program, position, message

const instantiate = (
  program: ProgramWide, resolver: Resolver, info: InterfaceInfo, type_name: NamedType
) ->
  const { args, position } = type_name
  const count = info.type_params.length
  if args.length != count
    fail program, position, "'#{info.name}' takes #{count} type argument(s), got #{args.length}"
  const generic = info.type
  const resolved = [resolve(program, resolver, arg) for arg in args]
  InterfaceType args: resolved, name: generic.name, symbol: generic.symbol, module: generic.module

# Checks the type parameters and resolves the members of every interface of the module, so that
# one that is never used is checked too.
export const resolve_interfaces = (shared: Shared) ->
  const program = shared.program
  for info in shared.interfaces.values()
    # Once the module's names are declared, which the type parameters cannot take.
    reject_invalid_type_parameters program, info
    interface_members program, info

# The members, in which the type parameters and Self stand for themselves.
export const interface_members = (program: ProgramWide, info: InterfaceInfo) ->
  return members if const members = info.members
  const declaration = info.declaration!
  const own = placeholders(declaration.type_params)
  own[SELF] = TypeParameterType(name: SELF)
  const resolver = with_type_parameters(module_resolver(info.module_index!), own)
  const members = [
    InterfaceMember(name: member.name.name, type: resolve(program, resolver, member.type!))
    for member in declaration.members
  ]
  info.members = members
  members

# The members of the interface type, with its type arguments, for the type that satisfies it, which
# Self stands for.
export const members_for = (program: ProgramWide, type: InterfaceType, satisfying: Type) ->
  const info = interface_of(program, type)
  const bindings: Map<String, Type> = Map()
  bindings[name] = arg for (name, arg) in info.type_params.zip(type.args)
  bindings[SELF] = satisfying
  const substituted = (member: InterfaceMember) ->
    InterfaceMember name: member.name, type: substitute(member.type, bindings)
  [substituted(member) for member in interface_members(program, info)]

# The member of a value of the interface type by the name, and its place among the members, which
# is its place in an itab.
export const interface_member = (program: ProgramWide, type: InterfaceType, name: String) ->
  const members = members_for(program, type, type)
  const index = members.find_index((member) -> member.name == name) ? return nil
  IndexedMember index, member: members[index]

export struct IndexedMember
  index: Int
  member: InterfaceMember

# The type of a member of the interface type that is no method, which is read as a property.
export const interface_property = (program: ProgramWide, type: Type, name: String): Type? ->
  return nil if not (type is InterfaceType)
  const found = interface_member(program, type, name) ? return nil
  const member_type = found.member.type
  member_type is FunctionType then nil else member_type
