# Interfaces, `interface Shape` with members such as `area: () -> Int`, or generic ones,
# `interface Iterable<T>`: their declarations, their types and their members. A type satisfies an
# interface by its members (see satisfaction); an interface bounds type parameters, and is the
# type of values that hold a value of a type that satisfies it (see interface_values).
import InterfaceDeclaration, NamedType, Position, TypeName from '../ast'
import fail, fail_already_defined, fail_already_member from './diagnostics'
import reject_bad_type_parameters from './generics'
import
  builtin_export, has_import, import_qualified_type, imported_export, InterfaceExport
from './imports'
import is_jsonable_bound, is_jsonable_declaration from './json'
import declared_symbol, ProgramWide, record_type_name, Shared from './shared'
import
  has_type, module_resolver, named_in, resolve, Resolver, resolver_shared, with_type_parameters
from './type_names'
import placeholders, substitute from './type_patterns'
import reject_invalid_instance from './type_validity'
import bool_type, FunctionType, InterfaceType, Type, TypeParameterType from '../types'

export struct InterfaceMember
  name: String
  type: Type

export SELF := 'Self'

export class InterfaceInfo
  name: String
  # The type parameters standing for themselves as its type arguments.
  type: InterfaceType
  type_params: String[]
  # Whether a member names Self, which a value of the interface type could not tell.
  names_self: Bool
  # In which the type parameters and Self stand for themselves; nil until resolved (see
  # interface_members), as the types may name those declared later.
  var members: InterfaceMember[]?
  # The declaring module, which resolves the members' types; nil for a builtin interface.
  module_index: Int?
  declaration: InterfaceDeclaration?

iter_item := TypeParameterType('T')
gives_bool := FunctionType(params: [], result: bool_type)
has_next := InterfaceMember(name: 'has_next', type: gives_bool)
next := InterfaceMember(name: 'next', type: FunctionType(params: [], result: iter_item))

# What a value must have to convert to an Iter<T>, as an `Iter<T>` in messages (see
# converts_to_iter); the compiler declares it, and it cannot be named.
iter_source := InterfaceInfo
  name: 'Iter'
  type_params: [iter_item.name]
  names_self: false
  module_index: nil
  declaration: nil
  members: [has_next, next]
  type: { name: 'Iter', symbol: 'IterSource', module: 'std:builtins', args: [iter_item] }

# The interface type that a value must satisfy to convert to an Iter of the items.
export iter_source_type := (item: Type) -> InterfaceType(iter_source.type..., args: [item])

# The interface of the name that std:builtins declares, as Stringable, which interpolation
# requires, or Iterable, which `for` goes through, whatever the module's own names.
export std_interface := (shared: Shared, name: String, at: Position) ->
  fail_missing := ->
    where := 'std:builtins, which this module does not import'
    fail shared.program, at, "#{name} is declared in #{where}"
  # std:builtins does not import itself.
  return shared.interfaces[name] ? fail_missing() if shared.imports.builtins == nil
  exported := builtin_export(shared, name)
  exported is InterfaceExport then exported.info else fail_missing()

# Registers the module's interfaces, after its classes, structs and enums (see add_enums).
export add_interfaces := (shared: Shared, declarations: InterfaceDeclaration[]) ->
  program := shared.program
  for declaration in declarations
    { name } := declaration.name
    fail_already_defined program, declaration.name if has_declared_type(shared, name)
    reject_invalid_members shared, declaration
    type_params := [param.name.name for param in declaration.type_params]
    args: Type[] = [TypeParameterType(name: param) for param in type_params]
    symbol := declared_symbol(shared, name)
    type := InterfaceType(name, symbol, args, module: shared.name)
    names_self := declaration.members.any((member) -> names_type(member.type, SELF))
    info := InterfaceInfo
      name
      type
      type_params
      names_self
      declaration
      module_index: shared.index
      members: nil
    shared.interfaces[name] = info
    program.interfaces[symbol] = info

# A member is `name: Type`.
reject_invalid_members := (shared: Shared, declaration: InterfaceDeclaration) ->
  program := shared.program
  # std:json's Jsonable has none: the compiler tells the types that satisfy it.
  if declaration.members.is_empty() and not is_jsonable_declaration(shared, declaration.name.name)
    fail program, declaration.position, 'an interface needs at least one member'
  seen: Set<String>
  for member in declaration.members
    { name, position } := member.name
    fail_already_member program, position, name, declaration.name.name unless seen.add(name)
    if modifier := member.modifier
      fail program, member.position, "an interface member cannot be #{modifier}"
    if member.value != nil
      fail program, member.position, 'an interface member has a type and no value'

# As a generic function's (see reject_bad_type_parameters), besides Self, and without bounds.
reject_invalid_type_parameters := (program: ProgramWide, info: InterfaceInfo) ->
  type_params := info.declaration!.type_params
  reject_bad_type_parameters program, module_resolver(info.module_index!), type_params
  for param in type_params
    { name } := param.name
    fail_already_defined program, param.name if name == SELF
    if bound := param.bound
      fail program, bound.position, "an interface's type parameter takes no bound"

# Whether the written type names the type of the name, in any of its parts.
names_type := (type_name: TypeName?, name: String) -> not named_in(type_name, name).is_empty()

# Whether the module declares a class, struct, enum or interface of the name.
export has_declared_type := (shared: Shared, name: String) ->
  name in shared.objects or name in shared.enums or name in shared.interfaces

# The interface that the module imports by the name, marking its import as used.
export imported_interface := (shared: Shared, name: String) ->
  imported := shared.imports.names[name] ? return nil
  exported := imported_export(shared.program, imported) as InterfaceExport ? return nil
  imported.used = true
  exported.info

# The interface of the name where the resolver resolves names: one of the module, an imported one,
# or one that std:builtins exports, unless another type takes its name.
export named_interface := (program: ProgramWide, resolver: Resolver, name: String) ->
  shared := resolver_shared(program, resolver)
  return own if own := shared.interfaces[name]
  return imported if imported := imported_interface(shared, name)
  is_other_name := has_type(program, resolver, name) or has_import(shared, name)
  return nil if is_other_name
  exported := builtin_export(shared, name)
  exported is InterfaceExport then exported.info

export interface_of := (program: ProgramWide, type: InterfaceType) ->
  return iter_source if type.symbol == iter_source.type.symbol
  program.interfaces[type.symbol] ? panic("no interface #{type.symbol}")

export value_interface_type := (
  program: ProgramWide, resolver: Resolver, info: InterfaceInfo, type_name: NamedType
) ->
  reason :=
    case
      when info.names_self then "its members name #{SELF}, which its values could not tell"
      # std:json writes and reads a value by the type that the code gives it where it is called.
      when is_jsonable_bound(info.type) then 'std:json converts a value by its type'
      else nil
  if reason
    fail program, type_name.position, "'#{info.name}' can only bound a type parameter: #{reason}"
  instantiate program, resolver, info, type_name

# The interface that bounds a type parameter, or that a class or struct says it satisfies, with its
# type arguments.
export bound_interface := (program: ProgramWide, resolver: Resolver, bound: NamedType) ->
  { name, position } := bound
  shared := resolver_shared(program, resolver)
  import_qualified_type shared, bound
  if info := named_interface(program, resolver, name)
    fail program, position, 'a bound cannot be optional' if bound.optional
    type := instantiate(program, resolver, info, bound)
    record_type_name shared, bound, type
    return type
  is_other_name := has_type(program, resolver, name) or has_import(shared, name)
  message :=
    if is_other_name
      "'#{name}' is not an interface"
    else
      "unknown interface '#{name}'"
  fail program, position, message

instantiate := (
  program: ProgramWide, resolver: Resolver, info: InterfaceInfo, type_name: NamedType
) ->
  { args, position } := type_name
  count := info.type_params.length
  if args.length != count
    fail program, position, "'#{info.name}' takes #{count} type argument(s), got #{args.length}"
  generic := info.type
  resolved := [resolve(program, resolver, arg) for arg in args]
  type := InterfaceType(generic..., args: resolved)
  reject_invalid_instance program, resolver.module_index, type, position
  type

# Checks the type parameters and resolves the members of every interface of the module, so that
# one that is never used is checked too.
export resolve_interfaces := (shared: Shared) ->
  program := shared.program
  for info in shared.interfaces.values()
    # Once the module's names are declared, which the type parameters cannot take.
    reject_invalid_type_parameters program, info
    interface_members program, info

# The members, in which the type parameters and Self stand for themselves.
export interface_members := (program: ProgramWide, info: InterfaceInfo) ->
  return members if members := info.members
  declaration := info.declaration!
  own := placeholders(declaration.type_params)
  own[SELF] = TypeParameterType(SELF)
  resolver := with_type_parameters(module_resolver(info.module_index!), own)
  members := [
    InterfaceMember(name: member.name.name, type: resolve(program, resolver, member.type!))
    for member in declaration.members
  ]
  info.members = members
  members

# The members of the interface type, with its type arguments, for the type that satisfies it, which
# Self stands for.
export members_for := (program: ProgramWide, type: InterfaceType, satisfying: Type) ->
  info := interface_of(program, type)
  bindings: Map<String, Type>
  bindings[name] = arg for (name, arg) in info.type_params.zip(type.args)
  bindings[SELF] = satisfying
  substituted := (member: InterfaceMember) ->
    InterfaceMember(member..., type: substitute(member.type, bindings))
  [substituted(member) for member in interface_members(program, info)]

# The member of a value of the interface type by the name, and its place among the members, which
# is its place in an itab.
export interface_member := (program: ProgramWide, type: InterfaceType, name: String) ->
  members := members_for(program, type, type)
  index := members.find_index((member) -> member.name == name) ? return nil
  IndexedMember index, member: members[index]

export struct IndexedMember
  index: Int
  member: InterfaceMember
