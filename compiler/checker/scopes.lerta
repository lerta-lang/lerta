# Nested scopes of local names, innermost last.
import Identifier from '../ast'
import Constant from './constants'
import Type from '../types'

export class Local
  identifier: Identifier
  type: Type
  # For a narrowed view of a local (see Scopes.narrow), or one that a function literal captures,
  # the local itself.
  origin: Local?
  mutable := default false
  # Declared with `const` or `var`, as opposed to a parameter or a loop variable.
  declared := default false
  weak := default false
  # The value of a top-level `const` of a constant expression (see constants).
  constant: Constant?
  # A `const` of `@`, which a function literal that captures it holds as it would `@` (see cycles).
  is_this := default false
  var used = default false
  # Seen from a function literal that captures it (see captured).
  var captured = false
  # A `var` that a function literal or a method assigns, which may run at any point after it is
  # written, so that it is not narrowed (see names_literals_assign).
  assigned_by_literal := default false
  # How many scopes are around where a declared local is, and its reads (see record_only_read),
  # one for each time the checker types a name that reads it, which may be more than once for a
  # name, so that such a name never counts as the only read.
  scope_depth := default 0
  reads: Identifier[] = []
  var read_in_inner_scope = false
  # The reads from a block inside the local's scope or from a function literal, which may run
  # any number of times, or not at all (see warn_if_consumed_twice).
  inner_reads: Set<Identifier> = Set()

  # The local itself, of which this may be a view.
  original := -> @origin ? @

# The narrower type of a path of fields (see narrowable FieldPath), from the local it starts from,
# or from `@` if nil.
export struct PathView
  root: Local?
  type: Type

# The names of one scope, and its narrowed views of names, such as a const `x: Int?` known to be an
# Int, and of paths of fields, by `x.a.b`, which end with it. The views are separate from the
# definitions, which they do not redefine.
class Scope
  locals := Map<String, Local>()
  overlays := Map<String, Local>()
  paths := Map<String, PathView>()

export class Scopes
  scopes: Scope[] = []

  depth := -> @scopes.length

  push := -> @scopes.push(Scope())

  # The innermost scope ends; returns its locals.
  pop := -> @scopes.pop().locals

  # Until the innermost scope ends, the name is seen as `local`.
  narrow := (name: String, local: Local) -> @scopes.last()!.overlays[name] = local

  # Until the innermost scope ends, the `var`s narrowed outside it are seen as declared, as a loop's
  # condition and body see them: a round may assign one before the next.
  hide_var_views := ->
    hidden := @scopes.last()!.overlays
    for scope in @scopes
      for name in scope.overlays.keys()
        current := @lookup_local(name) ? continue
        origin := current.original()
        hidden[name] = origin if current != origin and origin.mutable

  # The local is assigned: its narrowed views end, in every scope.
  forget_views := (local: Local) ->
    for scope in @scopes
      overlays := scope.overlays
      names := [name for (name, view) in overlays.entries() when view.original() == local]
      overlays.remove name for name in names

  narrow_path := (key: String, view: PathView) -> @scopes.last()!.paths[key] = view

  lookup_path := (key: String) ->
    for scope in @scopes.reversed()
      return view if view := scope.paths[key]
    nil

  # Returns false, without defining the name, if the innermost scope already has it.
  define := (name: String, local: Local) ->
    innermost := @scopes.last()!
    return false if name in innermost.locals
    innermost.locals[name] = local
    # The new name replaces a narrowed view of the outer one in this scope.
    innermost.overlays.remove name
    true

  # The name in the scopes, not outside them.
  lookup_local := (name: String) ->
    for scope in @scopes.reversed()
      return overlay if overlay := scope.overlays[name]
      return local if local := scope.locals[name]
    nil
