# Nested scopes of local names, innermost last.
import Identifier from '../ast'
import Type from '../types'

export class Local
  identifier: Identifier
  type: Type
  # For a narrowed view of a local (see Scopes.narrow), or one that a function literal captures,
  # the local itself.
  origin: Local?
  mutable = default false
  # Declared with `const` or `var`, as opposed to a parameter or a loop variable.
  declared = default false
  weak = default false
  # A `const` of `@`, which a function literal that captures it holds as it would `@` (see cycles).
  is_this = default false
  used = default false
  # Seen from a function literal that captures it (see captured).
  captured = false

# The narrower type of a path of fields (see narrowing FieldPath), from the local it starts from, or
# from `@` if nil.
export struct PathView
  root: Local?
  type: Type

export class Scopes
  scopes: Map<String, Local>[] = []
  # Narrowed views of names, such as a `const x: Int?` known to be an Int; per scope, so that
  # they end with it. They are separate from the definitions, which they do not redefine.
  overlays: Map<String, Local>[] = []
  # Narrowed types of paths of fields, by `x.a.b`, per scope as the overlays.
  paths: Map<String, PathView>[] = []

  depth = -> @scopes.length

  push = ->
    @scopes.push Map()
    @overlays.push Map()
    @paths.push Map()

  pop = ->
    @paths.pop()
    @overlays.pop()
    @scopes.pop()

  # Until the innermost scope ends, the name is seen as `local`.
  narrow = (name: String, local: Local) -> @overlays.last()![name] = local

  narrow_path = (key: String, view: PathView) -> @paths.last()![key] = view

  lookup_path = (key: String) ->
    var depth = @paths.length - 1
    while depth >= 0
      return view if const view = @paths[depth][key]
      depth -= 1
    nil

  # Returns false, without defining the name, if the innermost scope already has it.
  define = (name: String, local: Local) ->
    const innermost = @scopes.last()!
    return false if innermost.has(name)
    innermost[name] = local
    # The new name replaces a narrowed view of the outer one in this scope.
    @overlays.last()!.remove(name)
    true

  # The name in the scopes, not outside them.
  lookup_local = (name: String) ->
    var depth = @scopes.length - 1
    while depth >= 0
      const overlay = @overlays[depth][name]
      return overlay if overlay
      const local = @scopes[depth][name]
      return local if local
      depth -= 1
    nil
