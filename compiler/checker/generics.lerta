# Generic functions and methods: see docs/reference/functions.md#generic-functions.
import FunctionLiteral, Identifier, Position, TypeParameter from '../ast'
import check_instance, check_instance_defaults from './bodies'
import
  abort_part, check_part, error_module_path, fail, fail_already_defined, fail_in_context
from './diagnostics'
import ExtensionMethod, Extensions, with_methods from './extensions'
import annotated_type, FunctionEntry, parameter_types from './functions'
import bound_interface from './interfaces'
import NodeFacts, ProgramWide, Shared from './shared'
import has_type, module_resolver, resolve_result, Resolver, with_type_parameters from './type_names'
import placeholders, substitute, type_depth from './type_patterns'
import format_type, InterfaceType, Type, type_key from '../types'

# How a generic function is referred to: by its module and its place in the module's generics.
export struct GenericRef
  module_index: Int
  index: Int

# The receiver of a generic method: its class or struct, or the extended type, in which the
# extend's type parameters stand for themselves, as `T[]`.
export struct Receiver
  type: Type
  type_params: TypeParameter[]

export class Instance
  entry: FunctionEntry
  generic: GenericRef
  type_arguments: Type[]
  # The extends of the type arguments in effect where it is first called: the body sees them, as
  # the caller does, before the declaring module's own.
  methods: ExtensionMethod[]
  extensions: Extensions
  resolver: Resolver
  # Tells apart the instances of the same type arguments with different extends.
  variant: Int
  # What is found of the nodes of its body, which it shares with the other instances.
  facts = NodeFacts()
  # Whether its defaults are checked, which only a call that leaves arguments out asks for (see
  # check_instance_defaults), so that a default need not fit every type argument.
  var defaults_checked = false

# See docs/reference/functions.md#generic-functions.
export MAX_TYPE_DEPTH := 32
# Instances that each call more than one of deeper type arguments would number exponentially many
# before any reached MAX_TYPE_DEPTH.
export MAX_INSTANCES := 1000

# Why the generic `name` is stopped: its type arguments nest past MAX_TYPE_DEPTH, or its instances
# number past MAX_INSTANCES.
export endless_instances := (name: String, too_deep: Bool) ->
  return "'#{name}' needs instances without end, each with type arguments nested deeper" if too_deep
  "'#{name}' needs more than #{MAX_INSTANCES} instances"

export class GenericFunction
  name: Identifier
  literal: FunctionLiteral
  module_index: Int
  # A method's receiver, whose type parameters come first.
  receiver: Receiver?
  type_params: TypeParameter[]
  # The interface types that bound the type parameters, in their order, in which the type
  # parameters stand for themselves.
  bounds: InterfaceType?[]
  # The parameters' types, and the result's if it is written, in which the type parameters stand
  # for themselves.
  params: Type[]
  result: Type?
  instances: Instance[] = []

export make_generic_function := (
  shared: Shared, name: Identifier, literal: FunctionLiteral, receiver: Receiver?
) ->
  program := shared.program
  type_params: TypeParameter[]
  type_params.append receiver.type_params if receiver
  type_params.append literal.type_params
  resolver := module_resolver(shared.index)
  reject_bad_type_parameters program, resolver, type_params
  generic_resolver := with_type_parameters(resolver, placeholders(type_params))
  bounds := bounds_of(program, generic_resolver, type_params)
  params := parameter_types(program, generic_resolver, literal)
  return_type := literal.return_type
  result := return_type then resolve_result(program, generic_resolver, return_type)
  GenericFunction
    name
    literal
    receiver
    type_params
    bounds
    params
    result
    module_index: shared.index

# The interface types that bound the type parameters, which a bound may name, as in
# `X: Iterable<T>`; the resolver has them stand for themselves.
export bounds_of := (program: ProgramWide, resolver: Resolver, type_params: TypeParameter[]) ->
  bound_of := (param: TypeParameter) ->
    bound := param.bound ? return nil
    bound_interface program, resolver, bound
  [bound_of(param) for param in type_params]

export reject_bad_type_parameters := (
  program: ProgramWide, resolver: Resolver, type_params: TypeParameter[]
) ->
  seen: Set<String>
  for param in type_params
    { name } := param.name
    fail_already_defined program, param.name if name in seen or has_type(program, resolver, name)
    seen.add name

export generic_of := (program: ProgramWide, ref: GenericRef) ->
  program.shared[ref.module_index].generics[ref.index]

# The instance of the type arguments, whose extends in effect are `methods`, checked if new.
export instantiate := (
  program: ProgramWide, ref: GenericRef, type_arguments: Type[], methods: ExtensionMethod[],
  at: Position
) ->
  generic := generic_of(program, ref)
  key := arguments_key(type_arguments)
  same_arguments :=
    [instance for instance in generic.instances when arguments_key(instance.type_arguments) == key]
  found := same_arguments.find((instance) -> same_methods(instance.methods, methods))
  if found == nil
    too_deep := type_arguments.any((type) -> type_depth(type) > MAX_TYPE_DEPTH)
    if too_deep or generic.instances.length >= MAX_INSTANCES
      message := endless_instances(generic.name.name, too_deep)
      fail_in_context program, at, message, "from #{describe(generic, generic.instances[0])}"
  variant := same_arguments.length
  instance := found ? add_instance(program, ref, type_arguments, methods, variant, at)
  check program, generic, instance if found == nil and instance.entry.type == nil
  abort_part() if instance.entry.state == FAILED
  if instance.entry.type == nil
    fail program, at, "'#{generic.name.name}' is recursive, so its return type must be written"
  instance

arguments_key := (type_arguments: Type[]) -> [type_key(type) for type in type_arguments].join(', ')

# The type arguments by the names of the type parameters.
export bindings := (generic: GenericFunction, type_arguments: Type[]) ->
  types: Map<String, Type>
  { type_params } := generic
  types[param.name.name] = arg for (param, arg) in type_params.zip(type_arguments)
  types

add_instance := (
  program: ProgramWide, ref: GenericRef, type_arguments: Type[], methods: ExtensionMethod[],
  variant: Int, at: Position
) ->
  generic := generic_of(program, ref)
  type_bindings := bindings(generic, type_arguments)
  resolver := with_type_parameters(module_resolver(generic.module_index), type_bindings)
  receiver := generic.receiver
  this_type := receiver then substitute(receiver.type, type_bindings)
  entry := FunctionEntry(this_type, literal: generic.literal, name: generic.name)
  extensions := with_methods(program.shared[generic.module_index].extensions, methods)
  instance := Instance(entry, type_arguments, methods, extensions, resolver, variant, generic: ref)
  entry.type = resolve_annotation(program, generic, instance, at)
  generic.instances.push instance
  instance

# Checks the instances left unchecked; returns whether there were any.
export check_pending := (program: ProgramWide, generic: GenericFunction) ->
  is_pending := (instance: Instance) -> instance.entry.state == UNCHECKED
  pending := [instance for instance in generic.instances when is_pending(instance)]
  check program, generic, instance for instance in pending
  not pending.is_empty()

# An error in the body says which instance it was found in.
check := (program: ProgramWide, generic: GenericFunction, instance: Instance) ->
  instance.entry.state = CHECKING
  check_body := (): void ->
    program.contexts.push "in #{describe(generic, instance)}"
    check_instance program, generic.module_index, instance
    program.contexts.pop()
  instance.entry.state = check_part(program, check_body) then CHECKED else FAILED

# The defaults of the instance, for the call at `at` that leaves arguments out; an error in one is
# the call's, which says which instance's defaults it was found in. Inside the check of a call
# already, as of another instance's defaults, the error is that outer call's, which the program's
# own source makes.
export check_defaults := (
  program: ProgramWide, generic: GenericFunction, instance: Instance, at: Position
) ->
  context := "in the defaults of #{describe(generic, instance)}"
  annotating program, at, context, ->
    check_instance_defaults program, generic.module_index, instance

# A written type that the type arguments make wrong, such as `T?` of an optional type, is the
# call's error, as a type argument that misses its bound is.
resolve_annotation := (
  program: ProgramWide, generic: GenericFunction, instance: Instance, at: Position
) ->
  var type: Type?
  resolve := -> type = annotated_type(program, instance.resolver, instance.entry.literal)
  annotating program, at, "in #{describe(generic, instance)}", resolve
  type

# Runs `check` with errors reported at the call at `at`, in the module being checked, unless an
# outer call is annotated already, whose annotation is kept.
annotating := (program: ProgramWide, at: Position, context: String, check: () -> void) ->
  outer := program.annotated_call
  program.annotated_call = { at, context, path: error_module_path(program) } if outer == nil
  check()
  program.annotated_call = outer

# `print<Int>`, as messages write an instance; a method's, `Int[].map<String>`, by its
# receiver and the type arguments of its own.
describe := (generic: GenericFunction, instance: Instance) ->
  receiver := generic.receiver
  receiver_count := receiver then receiver.type_params.length else 0
  own_arguments :=
    [instance.type_arguments[i] for i in receiver_count...instance.type_arguments.length]
  this_type := instance.entry.this_type
  generic_name := generic.name.name
  name := this_type then "#{format_type(this_type)}.#{generic_name}" else generic_name
  return name if own_arguments.is_empty()
  "#{name}<#{[format_type(type) for type in own_arguments].join(', ')}>"

same_methods := (a: ExtensionMethod[], b: ExtensionMethod[]) ->
  a.length == b.length and a.all((method) -> method in b)
