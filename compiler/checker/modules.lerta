# Checks a program: the types of its expressions, its conversions and its warnings.
import CompileError, Located from '../errors'
import
  check_all_objects, check_definition_of, check_pending_objects, is_generic_object
from './object_types'
import
  complete_declarations, declare_extends, declare_later_extends, declare_names
from './declarations'
import warn_kept_cycles from './cycles'
import all_warnings, check_part, fail, in_module, report_errors from './diagnostics'
import reject_growing_instances from './growing_instances'
import Extensions from './extensions'
import check_all_functions, function_type_of, method_key from './functions'
import check_definition, check_pending from './generics'
import builtins_declarer, exported_statements, Imports, reexports_of from './imports'
import plan_runtime_errors from './interface_values'
import reject_misplaced_jumps from './jump_positions'
import BUILTINS_MODULE, Module from '../loader'
import Body, ProgramWide, Shared from './shared'
import check_top_level_code from './statement'
import top_level_values from './top_level_values'
import check_early_instances from './type_validity'
import module_resolver from './type_names'
import check_early_bounds from './object_bounds'
import FunctionType, is_kind from '../types'

# Checks the modules step by step (see docs/internals/compiler.md#modules). The warnings of all the
# modules are gathered at the end (see all_warnings), also after an error, since a module that calls
# a generic function of another checks an instance of it there, which may find warnings and use
# names of that module. `on_checked` takes the program as far as it is checked, and them, with an
# error too, before it is thrown.
export check_modules := (
  entry_path: String, modules: Module[], on_checked: (ProgramWide, Located[]) -> void
) ->
  program := ProgramWide(entry_path, modules, finds_all_errors: true)
  try
    check_program program
  catch error: CompileError
    on_checked program, all_warnings(program)
    throw error
  on_checked program, all_warnings(program)
  program

# Checks the program as check_modules does, into the ProgramWide given. Throws its errors as one
# CompileError: an error ends the part of the program it is found in, or else all the checking.
export check_program := (program: ProgramWide) ->
  check_part program, -> check_steps(program)
  report_errors program

check_steps := (program: ProgramWide) ->
  { modules } := program
  program.shared.push create_shared(program, module) for module in modules
  for_each_module program, (shared) ->
    reject_misplaced_jumps program, modules[shared.index].program
    declare_names shared
  for_each_module program, complete_declarations
  program.builtins = builtins_module(program)

  # Checking the instances of those would not end.
  return if reject_growing_instances(program)

  check_early_instances program
  for_each_module program, declare_extends
  for_each_module program, declare_later_extends
  check_early_bounds program
  for_each_module program, check_top_level
  for_each_module program, check_bodies
  plan_runtime_errors builtins_declarer(program, 'Error') if program.builtins != nil

  # Instances of generic functions and of generic classes and structs may make others.
  # Checks the module's instances left unchecked, and tells whether there were any. Each round
  # goes through every module, until none has any left.
  check_round := (shared: Shared) ->
    var checked = false
    checked = check_pending(program, generic) or checked for generic in shared.generics
    check_pending_objects(shared) or checked
  var pending = true
  while pending
    pending = false
    pending = check_round(shared) or pending for shared in program.shared

  # The generic bodies that no call made an instance of.
  for_each_module program, (shared) ->
    check_definition program, generic for generic in shared.generics
    for info in shared.objects.values()
      check_definition_of program, info if is_generic_object(info)

  warn_kept_cycles program

# The module that std:builtins is, which may be the entry module itself.
builtins_module := (program: ProgramWide) ->
  return index if index := program.shared.last()!.imports.builtins
  program.entry_path == BUILTINS_MODULE then program.shared.length - 1

for_each_module := (program: ProgramWide, step: (Shared) -> void) ->
  for shared in program.shared
    in_module shared, -> step(shared)

create_shared := (program: ProgramWide, module: Module) ->
  index := module.index
  name := module.display_path ? 'the entry module'
  path := module.display_path
  extensions := Extensions(module_index: index, module_name: name)
  top_level := top_level_values(module.program)
  exported := exported_statements(module.program)
  reexported := reexports_of(module)
  Shared(
    program
    index
    name
    path
    extensions
    top_level
    exported
    reexported
    imports: Imports()
  )

# The names of the top-level code are warned about if never used once the functions, checked
# later, and the instances of generic functions that other modules call, which may use them, are
# checked (see all_warnings).
check_top_level := (shared: Shared) ->
  program := shared.program
  shared.top_level.started = true
  resolver := module_resolver(shared.index)
  { extensions } := shared
  body := Body(shared, resolver, extensions, facts: shared.facts)
  shared.top_level_scope = check_top_level_code(body, program.modules[shared.index].program)

check_bodies := (shared: Shared) ->
  program := shared.program
  check_all_objects shared
  check_all_functions shared
  reject_deinit_results shared
  program.bodies_checked.push shared.index

reject_deinit_results := (shared: Shared) ->
  program := shared.program
  for info in shared.objects.values()
    literal := info.methods['deinit'] ? continue
    key := method_key(info.declaration.name.name, 'deinit')
    type := function_type_of(program, shared.index, key, literal.position)
    result := (type as FunctionType?)?.result
    if result
      fail program, literal.position, 'deinit cannot throw' if is_kind(result, 'never')
      fail program, literal.position, 'deinit gives no value' unless is_kind(result, 'void')
