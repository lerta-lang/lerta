# Checks a program: the types of its expressions, its conversions and its warnings.
import check_all_objects, check_pending_objects from './object_types'
import
  complete_declarations, declare_extends, declare_later_extends, declare_names
from './declarations'
import check_part, enter_module, fail, leave_module, report_errors from './diagnostics'
import Extensions from './extensions'
import check_all_functions, function_type_of, method_key from './functions'
import check_pending from './generics'
import exported_statements, Imports from './imports'
import plan_runtime_errors from './interface_values'
import reject_misplaced_jumps from './jump_positions'
import BUILTINS_MODULE, Module from '../loader'
import Body, ProgramWide, Shared from './shared'
import check_top_level_code from './statement'
import top_level_values from './top_level_values'
import module_resolver from './type_names'
import FunctionType, is_kind from '../types'

# Checks the modules step by step, each step for all of them before the next, so that the modules
# of an import cycle can use each other's names: the names, the declarations, the extends, the
# top-level code in the order it runs (see load_modules), then the bodies of the functions and
# objects. Inferred types are worked out on demand across modules, as within one. The warnings of
# all the modules are gathered at the end (see all_warnings), or with an error, since a module
# that calls a generic function of another checks an instance of it there, which may find warnings
# and use names of that module.
export const check_modules = (entry_path: String, modules: Module[], reports_warnings: Bool) ->
  const program = ProgramWide(entry_path, modules, reports_warnings)
  check_program program
  program

# Checks the program as check_modules does, into the ProgramWide given. Throws its errors as one
# CompileError: an error ends the part of the program it is found in, or else all the checking.
export const check_program = (program: ProgramWide) ->
  check_part program, -> check_steps(program)
  report_errors program

const check_steps = (program: ProgramWide) ->
  const { modules } = program
  program.shared.push create_shared(program, module) for module in modules
  for shared in program.shared
    enter_module shared
    reject_misplaced_jumps program, modules[shared.index].program
    declare_names shared
    leave_module shared
  for_each_module program, complete_declarations
  for_each_module program, declare_extends
  for_each_module program, declare_later_extends
  for_each_module program, check_top_level
  for_each_module program, check_bodies
  program.builtins = builtins_module(program)
  plan_runtime_errors program.shared[builtins] if const builtins = program.builtins
  # Instances of generic functions and of generic classes and structs may make others.
  # Checks the module's instances left unchecked, and tells whether there were any. Each round
  # goes through every module, until none has any left.
  const check_round = (shared: Shared) ->
    var checked = false
    checked = check_pending(program, generic) or checked for generic in shared.generics
    check_pending_objects(shared) or checked
  var pending = true
  while pending
    pending = false
    pending = check_round(shared) or pending for shared in program.shared

# The module that std:builtins is, which every module but std:io imports, unless the program is
# std:io alone; std:builtins itself may be the entry module.
const builtins_module = (program: ProgramWide) ->
  return index if const index = program.shared.last()!.imports.builtins
  program.entry_path == BUILTINS_MODULE then program.shared.length - 1

const for_each_module = (program: ProgramWide, step: (Shared) -> void) ->
  for shared in program.shared
    enter_module shared
    step shared
    leave_module shared

const create_shared = (program: ProgramWide, module: Module) ->
  const index = module.index
  const name = module.display_path ? 'the entry module'
  const path = module.display_path
  const extensions = Extensions(module_index: index, module_name: name)
  const top_level = top_level_values(module.program)
  const exported = exported_statements(module.program)
  Shared program, index, name, path, extensions, top_level, exported, imports: Imports()

# The names of the top-level code are warned about if never used once the functions, checked
# later, and the instances of generic functions that other modules call, which may use them, are
# checked (see all_warnings).
const check_top_level = (shared: Shared) ->
  const program = shared.program
  shared.top_level.started = true
  const resolver = module_resolver(shared.index)
  const { extensions } = shared
  const body = Body(shared, resolver, extensions, facts: shared.facts)
  shared.top_level_scope = check_top_level_code(body, program.modules[shared.index].program)

const check_bodies = (shared: Shared) ->
  const program = shared.program
  check_all_objects shared
  check_all_functions shared
  reject_deinit_results shared
  program.bodies_checked.push shared.index

# A deinit runs as part of a release, where nothing could take a value it gave, or handle a throw.
const reject_deinit_results = (shared: Shared) ->
  const program = shared.program
  for info in shared.objects.values()
    const literal = info.methods['deinit'] ? continue
    const key = method_key(info.declaration.name.name, 'deinit')
    const type = function_type_of(program, shared.index, key, literal.position)
    const result = (type as FunctionType?)?.result
    if result
      fail program, literal.position, 'deinit cannot throw' if is_kind(result, 'never')
      fail program, literal.position, 'deinit gives no value' if not is_kind(result, 'void')
