# Checks the conditions or patterns of a `case`, and how they narrow its subject in each arm.
import Case, CaseArm, Expression, Identifier, NamedType, NilLiteral from '../ast'
import fail from './diagnostics'
import expect_condition, expect_type, set_type, type_of, unnarrowed_type from './expression'
import narrowable from './narrowable'
import Narrowing, narrowings_of from './narrowing'
import Body, enum_value_of from './shared'
import has_type, resolve from './type_names'
import
  EnumType, format_enum_member, format_member, format_type, inner_of, INTEGER_KINDS, is_assignable,
  is_kind, is_one_of_kinds, members_of, other_members, optional_type, OptionalType, Type, TypeKind,
  union_of, union_type, UnionType
from '../types'

VALUE_KINDS: TypeKind[] = [INTEGER_KINDS..., 'Char', 'Bool', 'String', ENUM]

# A condition of a case without a subject is one of an `if`, which narrows locals in its arm.
check_condition := (body: Body, condition: Expression) ->
  expect_condition body, condition
  narrowings_of(body, condition).where_true

# How the subject is narrowed in each arm, and in the else arm.
struct CaseNarrowings
  arms: Narrowing[][]
  otherwise: Narrowing[]

# Checks the conditions or patterns, and returns how they narrow.
export check_patterns := (body: Body, case_expression: Case): CaseNarrowings ->
  { arms } := case_expression
  subject := case_expression.subject
  if subject == nil
    conditions := [
      for arm in arms
        check_condition(body, arm.patterns[0])
    ]
    return { arms: conditions, otherwise: [] }
  subject_type := type_of(body, subject)
  is_optional := subject_type is OptionalType
  is_nil_arm := (arm: CaseArm) -> is_optional and arm.patterns.any(is_nil_pattern)
  unhandled_nil := is_optional and not check_nil_arms(body, arms)
  missing: String[] = unhandled_nil then ['nil'] else []
  type := inner_of(subject_type)

  # As `is` does, the patterns take the members of the type that the subject was declared with.
  declared := inner_of(unnarrowed_type(body, subject, subject_type))
  is_value := is_one_of_kinds(type, VALUE_KINDS)
  if declared is UnionType and not is_value
    return check_type_patterns(body, case_expression, is_nil_arm, subject, declared, type, missing)

  unless is_value
    message := "cannot branch on a value of type #{format_type(subject_type)}"
    fail body.program, subject.position, message
  for patterns in (arm.patterns for arm in arms when not is_nil_arm(arm))
    for pattern in patterns
      if declared is UnionType
        fail_narrowed_type_pattern body, pattern, type
      expect_type body, pattern, type
  if type is EnumType
    check_member_patterns body, case_expression, type, missing
  else if case_expression.otherwise == nil
    fail body.program, case_expression.position, 'a case on values needs an else arm'
  no_narrowings: Narrowing[]
  narrowed :=
    if is_optional
      subject_narrowings body, subject, type
    else
      no_narrowings
  arm_narrowings := [
    for arm in arms
      is_nil_arm(arm) then no_narrowings else narrowed
  ]
  { arms: arm_narrowings, otherwise: unhandled_nil then no_narrowings else narrowed }

is_nil_pattern := (pattern: Expression) -> pattern is NilLiteral

check_nil_arms := (body: Body, arms: CaseArm[]) ->
  var handled = false
  for arm in arms
    for pattern in arm.patterns
      continue unless is_nil_pattern(pattern)
      if arm.patterns.length > 1
        fail body.program, pattern.position, 'nil must be the only pattern of its arm'
      if handled
        fail_handled_twice body, pattern, 'nil'
      type_of body, pattern
      handled = true
  handled

check_type_patterns := (
  body: Body, case_expression: Case, is_nil_arm: (CaseArm) -> Bool, subject: Expression,
  union: UnionType, narrowed: Type, missing_nil: String[]
) ->
  handled: Set<Type>
  arm_narrowings: Narrowing[][]
  for arm in case_expression.arms
    if is_nil_arm(arm)
      arm_narrowings.push []
      continue
    types := [
      for pattern in arm.patterns
        type_pattern(body, pattern, union)
    ]
    for (pattern_type, pattern) in types.zip(arm.patterns)
      for member in members_of(pattern_type)
        unless handled.add(member)
          fail_handled_twice body, pattern, format_member(member, union)
    arm_narrowings.push subject_narrowings(body, subject, union_of(types)!)
  is_unhandled := (member: Type) -> member not in handled
  unhandled_members := members_of(narrowed).filter(is_unhandled)
  missing := [
    for member in unhandled_members
      format_member(member, union)
  ]
  fail_unhandled body, case_expression, missing + missing_nil

  # Where nil is handled, the else arm does not see it.
  unhandled := not missing_nil.is_empty() then optional_type(narrowed) else narrowed
  handled_members := [member for member in union.members when member in handled]
  others := other_members(unhandled, union_type(handled_members))
  otherwise: Narrowing[] =
    if others
      subject_narrowings body, subject, others
    else
      []

  CaseNarrowings(otherwise, arms: arm_narrowings)

check_member_patterns := (
  body: Body, case_expression: Case, type: EnumType, missing_nil: String[]
) ->
  handled: Set<Int>
  for arm in case_expression.arms
    for pattern in arm.patterns
      index := enum_value_of(body.facts, pattern) else continue
      if index in handled
        fail_handled_twice body, pattern, format_enum_member(type.members[index])
      handled.add index
  members := type.members
  missing := [format_enum_member(member) for member at i in members when i not in handled]
  fail_unhandled body, case_expression, missing + missing_nil

fail_handled_twice := (body: Body, pattern: Expression, handled: String) ->
  fail body.program, pattern.position, "#{handled} is already handled by an earlier arm"

# Without an else arm, a case must handle each of the `missing`.
fail_unhandled := (body: Body, case_expression: Case, missing: String[]) ->
  return if case_expression.otherwise != nil or missing.is_empty()
  message := "case does not handle #{missing.join(', ')}; add them or an else arm"
  fail body.program, case_expression.position, message

# The pattern's type, recorded on the pattern for codegen: a member of the union, or a union of some
# of its members, which a type alias names.
type_pattern := (body: Body, pattern: Expression, union: UnionType) ->
  fail_pattern := ->
    types := "the types #{format_type(union)} or a union of them"
    fail body.program, pattern.position, "expected one of #{types}"
  { program, resolver } := body
  unless pattern is Identifier
    message := 'a pattern of a case on types names a type so far; test the others with `is`'
    fail program, pattern.position, message
  name := pattern.name
  fail_pattern() unless has_type(program, resolver, name)
  type_name := NamedType(name, args: [], position: pattern.position)
  type := resolve(program, resolver, type_name)
  fail_pattern() if not is_assignable(type, union) or is_kind(type, 'never')
  set_type(body, pattern, type)

# Explains the narrowing, where a type pattern would otherwise be reported as an undefined name.
fail_narrowed_type_pattern := (body: Body, pattern: Expression, narrowed: Type) ->
  names_type := pattern is Identifier and has_type(body.program, body.resolver, pattern.name)
  return unless names_type
  message := "the subject is narrowed to #{format_type(narrowed)} here, so its patterns are values"
  fail body.program, pattern.position, message

subject_narrowings := (body: Body, subject: Expression, type: Type): Narrowing[] ->
  value := narrowable(body, subject) else return []
  [{ type, subject: value.subject }]
