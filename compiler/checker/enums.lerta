# Enums: their declarations, the expressions that name their members, `E.MEMBER`, or `MEMBER` or
# `'text'` alone where an E is expected, and std:enums' `parse` and `members`.
import COMPLETION_NAME, probe_enum from './completion_probe'
import Call, EnumDeclaration, Expression, Identifier, Member, Position, StringLiteral from '../ast'
import fail, fail_already_defined, fail_already_member from './diagnostics'
import has_function from './functions'
import builtin_export, builtin_type, has_import, imported_type from './imports'
import record_member from './member'
import EnumValue from './member_targets'
import lookup, qualified_name, record_reference from './name'
import EnumQuery, EnumQueryKind from './references'
import expect_type from './expression'
import resolve from './type_names'
import Body, declared_symbol, has_declared_type, ProgramWide, Shared from './shared'
import
  ArrayType, EnumMember, EnumType, format_type, inner_of_expected, InterfaceType, is_kind,
  optional_type, string_type, Type, TypeParameterType, UnionType
from '../types'

# Registers the module's enums, after its classes and structs (see add_objects).
export add_enums := (shared: Shared, declarations: EnumDeclaration[]) ->
  program := shared.program
  for declaration in declarations
    { name } := declaration.name
    fail_already_defined program, declaration.name if has_declared_type(shared, name)
    members: EnumMember[]
    for member in declaration.members
      text :=
        case member
          when Identifier then member.name
          when StringLiteral then member.value

      # A name and a literal of the same text would have the same to_string and parse.
      if members.any((each) -> each.text == text)
        fail_already_member program, member.position, text, name

      members.push { text, is_name: member is Identifier }
    symbol := declared_symbol(shared, name)
    shared.enums[name] = { name, symbol, members, module: shared.name }

# The enum of the name, of the module, imported or of std:builtins.
export enum_type := (shared: Shared, name: String) ->
  return own if own := shared.enums[name]
  exported := imported_type(shared, name) ? builtin_type(shared, name) ? return nil
  exported.type as EnumType?

# `E.MEMBER`, where no local takes the name of the enum E.
export type_of_qualified_member := (body: Body, member: Member, expected: Type?): Type? ->
  type := qualifying_enum(body, member) ? return nil
  { name, position } := member.name
  probe_enum body, type if name == COMPLETION_NAME
  no_member := -> fail(body.program, position, "#{type.name} has no member '#{name}'")
  record_member body, member, EnumValue(name_index(type, name) ? no_member())
  where_expected := expected_enum(expected)?.symbol == type.symbol
  alone := not is_name_taken(body, name)
  body.facts.alone_members.add member if alone
  body.facts.unqualifiable.add member if where_expected and alone
  type

# `parse<E>(text)` of std:enums, the member of the enum E whose text is the String, or nil, and
# `members<E>()`, its members in their order.
export type_of_enum_query := (body: Body, call: Call, kind: EnumQueryKind) ->
  { program } := body
  callee := call.callee as Identifier!
  unless call.named_args.is_empty()
    fail program, call.position, "#{callee.name} takes no named arguments"
  if call.type_args.length != 1
    fail program, call.position, "#{callee.name} takes one type argument, an enum"
  written := call.type_args[0]
  type := resolve(program, body.resolver, written)
  reject_non_enum body, type, written.position
  arguments := kind == PARSE then 'one argument, the text' else 'no arguments'
  arity := kind == PARSE then 1 else 0
  fail program, call.position, "#{callee.name} takes #{arguments}" if call.args.length != arity
  expect_type body, arg, string_type for arg in call.args
  record_reference body, callee, EnumQuery(kind, type)
  case kind
    when PARSE then optional_type(type)
    when MEMBERS then ArrayType(type)

ENUMS_MODULE := 'std:enums'

# Whether the interface type is std:enums' Enum, which the enums satisfy.
export is_enum_bound := (program: ProgramWide, bound: InterfaceType) ->
  is_declared_by := (shared: Shared) ->
    shared.name == bound.module and is_enum_declaration(shared, bound.name)
  program.shared.any(is_declared_by)

# Whether the interface of the name, declared in the module, is std:enums' Enum.
is_enum_declaration := (shared: Shared, name: String) ->
  is_entry := shared.path == nil and shared.program.entry_path == ENUMS_MODULE
  name == 'Enum' and (shared.name == ENUMS_MODULE or is_entry)

# Whether the type is a type parameter that Enum bounds, which stands for an enum.
export is_enum_parameter := (body: Body, type: Type) ->
  return false if type is not TypeParameterType or not type.standing
  bound := body.resolver.bounds[type.name]
  bound != nil and is_enum_bound(body.program, bound)

# Rejects a type that does not satisfy Enum.
export reject_non_enum := (body: Body, type: Type, at: Position) ->
  return if type is EnumType or is_enum_parameter(body, type)
  fail body.program, at, "#{format_type(type)} does not satisfy Enum: it is not an enum"

# The enum E of `E.x`, where no local takes its name, or of `mod.E.x` (see qualified_name).
qualifying_enum := (body: Body, member: Member) ->
  object := member.object
  if object is Member
    return enum_type(body.shared, name.name) if name := qualified_name(body, object)
    return nil
  return nil unless object is Identifier
  return nil if lookup(body, object.name) != nil
  enum_type(body.shared, object.name)

export type_of_elided_member := (body: Body, identifier: Identifier, expected: Type?): Type? ->
  type := expected_enum(expected) ? return nil
  name := identifier.name
  index := name_index(type, name) ? return nil
  if is_name_taken(body, name)
    message := "'#{name}' names something else here; write #{type.name}.#{name}"
    fail body.program, identifier.position, message
  record_reference body, identifier, EnumValue(index)
  type

export type_of_literal_member := (body: Body, literal: StringLiteral, expected: Type?): Type? ->
  type := expected_literal_enum(expected) ? return nil
  text := literal.value
  no_member := ->
    hint := name_index(type, text) != nil then "; write #{text}" else ''
    fail body.program, literal.position, "'#{text}' is not a member of #{type.name}#{hint}"
  is_literal_of_text := (member: EnumMember) -> not member.is_name and member.text == text
  index := type.members.find_index(is_literal_of_text) ? no_member()
  body.facts.enum_literals[literal] = index
  type

# The enum that the expected type is, or the only enum among the members of a union that it is: of
# two, a member alone would be ambiguous.
expected_enum := (expected: Type?) ->
  inner := inner_of_expected(expected)
  return inner if inner is EnumType
  return nil unless inner is UnionType
  enums := [member for member in inner.members when member is EnumType]
  enums.length == 1 then enums[0]

# As expected_enum, but none of a union that holds a String, which a literal would be then.
expected_literal_enum := (expected: Type?) ->
  inner := inner_of_expected(expected)
  holds_string := inner is UnionType and inner.members.any((member) -> is_kind(member, 'String'))
  holds_string then nil else expected_enum(expected)

# An identifier that may stand for a member of an enum that the context expects: a name that
# nothing takes. Such an operand of `==` is typed after the other one, which tells the enum.
export may_name_member := (body: Body, expression: Expression) ->
  return false unless expression is Identifier
  not is_name_taken(body, expression.name)

# Whether a name in scope takes the name: a local, a top-level name or a builtin.
is_name_taken := (body: Body, name: String) ->
  { shared } := body
  return true if lookup(body, name) != nil or has_function(shared, name)
  return true if has_import(shared, name) or name in shared.top_level.names
  builtin_export(shared, name) != nil

name_index := (type: EnumType, name: String) ->
  type.members.find_index((member) -> member.is_name and member.text == name)
