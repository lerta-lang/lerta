# Enums: their declarations, the expressions that name their members, `E.MEMBER`, or `MEMBER` or
# `'text'` alone where an E is expected, and `E.parse`.
import { EnumDeclaration, Expression, Identifier, Member, StringLiteral } from '../ast'
import { fail } from './diagnostics'
import { has_function } from './functions'
import { builtin_export, has_import, imported_type } from './imports'
import { lookup } from './name'
import { Body, ProgramWide, Shared } from './shared'
import { is_builtin_type_name } from './type_names'
import {
  EnumMember, EnumType, FunctionType, optional_type, OptionalType, string_type, Type
} from '../types'

# Registers the module's enums, after its classes and structs (see add_objects).
export const add_enums = (
  program: ProgramWide, shared: Shared, declarations: Array<EnumDeclaration>
) ->
  for declaration in declarations
    const { name, position } = declaration.name
    const is_taken = shared.objects.has(name) or shared.enums.has(name)
    fail program, position, "'#{name}' is already defined" if is_taken or is_builtin_type_name(name)
    const members: Array<EnumMember> = []
    for member in declaration.members
      const text = case member
        when Identifier then member.name
        when StringLiteral then member.value
      if member is Identifier and text == 'parse'
        fail program, member.position, "'parse' cannot name a member: #{name}.parse parses one"
      # A name and a literal of the same text would have the same to_string and parse.
      if members.any((each) -> each.text == text)
        fail program, member.position, "'#{text}' is already a member of #{name}"
      members.push EnumMember(text, is_name: member is Identifier)
    const symbol = "#{shared.index}.#{name}"
    shared.enums[name] = EnumType(name, symbol, members, module: shared.name)

# The enum of the name, of the module or imported.
export const enum_type = (program: ProgramWide, shared: Shared, name: String): EnumType? ->
  return own if const own = shared.enums[name]
  const exported = imported_type(program, shared, name) ? return nil
  const type = exported.type
  type as EnumType?

# `E.MEMBER`, where no local takes the name of the enum E.
export const type_of_qualified_member = (body: Body, member: Member): Type? ->
  const type = qualifying_enum(body, member) ? return nil
  const { name, position } = member.name
  fail body.program, position, "#{type.name}.parse must be called" if name == 'parse'
  const no_member = () -> fail(body.program, position, "#{type.name} has no member '#{name}'")
  name_member body, member, type, name_index(type, name) ? no_member()

# `E.parse`, the member whose to_string gives a String, or nil. Codegen finds the enum in
# Shared.enum_parses.
export const enum_parse_type = (body: Body, member: Member): FunctionType? ->
  return nil if member.name.name != 'parse'
  const type = qualifying_enum(body, member) ? return nil
  body.facts.enum_parses[member] = type
  FunctionType params: [string_type], result: optional_type(type)

# The enum E of `E.x`, where no local takes its name.
const qualifying_enum = (body: Body, member: Member) ->
  const object = member.object
  return nil if not (object is Identifier)
  return nil if lookup(body, object.name) != nil
  enum_type body.program, body.shared, object.name

# `MEMBER` alone, where an E (or an E?) is expected and E has that member. It cannot take the place
# of another name in scope, which it would hide.
export const type_of_elided_member = (body: Body, identifier: Identifier, expected: Type?): Type? ->
  const type = expected_enum(expected) ? return nil
  const name = identifier.name
  const index = name_index(type, name) ? return nil
  if is_name_taken(body, name)
    const message = "'#{name}' names something else here; write #{type.name}.#{name}"
    fail body.program, identifier.position, message
  name_member body, identifier, type, index

# `'text'` alone, where an E (or an E?) is expected: the literal member of that text, which E must
# have. A name member has only its name as a spelling.
export const type_of_literal_member = (
  body: Body, literal: StringLiteral, expected: Type?
): Type? ->
  const type = expected_enum(expected) ? return nil
  const text = literal.value
  const no_member = () ->
    const hint = name_index(type, text) != nil then "; write #{text}" else ''
    fail body.program, literal.position, "'#{text}' is not a member of #{type.name}#{hint}"
  const is_literal_of_text = (member: EnumMember) -> not member.is_name and member.text == text
  const index = member_index(type, is_literal_of_text) ? no_member()
  name_member body, literal, type, index

const expected_enum = (expected: Type?) ->
  const wanted = expected ? return nil
  const type = wanted is OptionalType then wanted.inner else wanted
  type as EnumType?

# An identifier that may stand for a member of an enum that the context expects: a name that
# nothing takes. Such an operand of `==` is typed after the other one, which tells the enum.
export const may_name_member = (body: Body, expression: Expression) ->
  return false if not (expression is Identifier)
  not is_name_taken(body, expression.name)

# Whether a name in scope takes the name: a local, a top-level name or a builtin.
const is_name_taken = (body: Body, name: String) ->
  const { program, shared } = body
  return true if lookup(body, name) != nil or has_function(shared, name)
  return true if has_import(shared, name) or shared.top_level.names.has(name)
  builtin_export(program, shared, name) != nil

const name_index = (type: EnumType, name: String) ->
  member_index type, (member) -> member.is_name and member.text == name

const member_index = (type: EnumType, matches: (EnumMember) -> Bool) ->
  for i in 0...type.members.length
    return i if matches(type.members[i])
  nil

# Records the member's place, which codegen gives as the value.
const name_member = (body: Body, expression: Expression, type: EnumType, index: Int) ->
  body.facts.enum_values[expression] = index
  type
