# Checks loops: `for` over a range, an array, a Binary or an Iter, `while`, comprehensions, and
# where `break` and `continue` may be.
import
  Comprehension, Expression, For, Identifier, Jump, method_call, Range, Statement, While
from '../ast'
import check_item_type, check_value_type from './collection'
import fail from './diagnostics'
import expect_condition, expect_type, type_of from './expression'
import type_of_item_function from './closure'
import iterable_item_of, reject_not_iterable from './satisfaction'
import narrow, narrowings_of from './narrowing'
import Local from './scopes'
import Body from './shared'
import
  check_block, check_condition, check_statement, define_local, narrow_where_holds, nothing
from './statement'
import
  ArrayType, bool_type, format_type, int_type, iterable_item, IterType, Type, void_type
from '../types'

export check_loop_jump := (body: Body, jump: Jump) ->
  return if body.loop_depth > 0
  fail body.program, jump.position, "'#{jump.kind.to_string()}' outside a loop"

# A loop variable is a const declared by the loop rather than by a statement, hence not
# `declared`.
define_loop_variable := (body: Body, variable: Identifier, type: Type) ->
  local := Local(type, identifier: variable)
  define_local body, local

# The item, and its place, an Int, if the loop names it.
define_loop_variables := (body: Body, variable: Identifier, index: Identifier?, type: Type) ->
  define_loop_variable body, variable, type
  define_loop_variable body, index, int_type if index

export check_for := (body: Body, for_statement: For) ->
  { iterable, variable, index } := for_statement
  item_type := type_of_iterated(body, iterable, "after 'in'")
  define := -> define_loop_variables(body, variable, index, item_type)
  check_loop_body body, for_statement.body, define

export check_while := (body: Body, while_statement: While): void ->
  body.scopes.push()
  body.scopes.hide_var_views()
  condition := while_statement.condition
  define := check_condition(body, condition)
  # The condition holds where each round starts, as it is tested before it.
  narrowings := narrowings_of(body, condition).where_true
  check_loop_body body, while_statement.body, ->
    define()
    narrow body, narrowings
  body.scopes.pop()

export type_of_comprehension := (body: Body, comprehension: Comprehension, expected: Type?): Type ->
  { element, variable, index, iterable, guard, bindings } := comprehension
  place := comprehension.spread then "before '...'" else "after 'in'"
  item_type := type_of_iterated(body, iterable, place)
  if comprehension.lazy != nil
    return type_of_iter_comprehension(body, comprehension, item_type, expected)
  expected_element := expected_array_element(expected)
  var element_type: Type = void_type
  define := ->
    define_loop_variables body, variable, index, item_type
    check_statement body, binding for binding in bindings
    if guard
      expect_condition body, guard
      narrow_where_holds body, guard
  finish := ->
    if expected_element
      expect_type body, element, expected_element
      element_type = expected_element
    else
      element_type = type_of(body, element)
  check_block body, [], define, finish
  ArrayType check_item_type(body.program, element_type, element.position, 'an array')

expected_array_element := (expected: Type?) -> (expected as ArrayType?)?.element

type_of_iter_comprehension := (
  body: Body, comprehension: Comprehension, item_type: Type, expected: Type?
) ->
  { guard, element } := comprehension.lazy!
  type_of_item_function body, guard, item_type, bool_type, nil if guard
  expected_item := expected_iter_item(expected)
  holds := comprehension.guard
  element_type := type_of_item_function(body, element, item_type, expected_item, holds)
  at := comprehension.element.position
  item := check_value_type(body.program, element_type.result, at, 'an Iter')
  IterType item

expected_iter_item := (expected: Type?) -> (expected as IterType?)?.item

check_loop_body := (body: Body, statements: Statement[], define: () -> void) ->
  body.loop_depth += 1
  define_hiding := ->
    body.scopes.hide_var_views()
    define()
  check_block body, statements, define_hiding, nothing
  body.loop_depth -= 1

# A range without a start or an end only takes the place of an index, so far.
range_part := (body: Body, range: Range, part: Expression?) ->
  part ? fail(body.program, range.position, 'only an index takes a range without a start or an end')

# The type of the items that a loop, a comprehension, `Set()` or `Map()` goes through. A value of a
# type that satisfies Iterable is gone through by the Iter of its `iter()`, a call recorded in the
# facts, which codegen generates instead (see iter_calls). `place` tells where the iterable is
# written, for messages, and `expected` is the type that an array literal there takes.
export type_of_iterated := (
  body: Body
  iterable: Expression
  place: String
  expected: Type? = nil
): Type ->
  body.facts.consuming_reads.add iterable if iterable is Identifier
  if iterable is Range
    expect_type body, range_part(body, iterable, iterable.start), int_type
    expect_type body, range_part(body, iterable, iterable.end), int_type
    return int_type
  type := type_of(body, iterable, expected)
  return item if item := iterable_item(type)
  at := iterable.position
  if iterable_item_of(body, type, at) == nil
    iterables := 'a range, an array, a Binary, an Iter or an Iterable'
    reject_not_iterable body, type, at, "expected #{iterables} #{place}, got #{format_type(type)}"
  call := method_call(iterable, 'iter', [], at)
  body.facts.iter_calls[iterable] = call
  iterable_item(type_of(body, call))!
