# Errors and warnings found by the checker. An error names the module whose code is being checked
# and, if it is found in an instance of a generic function, the innermost instance being checked.
# It ends the checking of the part of the program it is found in, and the errors of all the parts
# end the build together, after the warnings (see check_part and report_errors).
import Identifier, Position from '../ast'
import compile_errors, DiagnosticKind, Located from '../errors'
import is_standard_module, Module from '../loader'
import is_nested_name, is_standard_name, module_location from '../source'
import CheckError, Diagnostic, ProgramWide, Shared from './shared'
import ImportedName, ModuleAlias from './imports'
import Local from './scopes'

# Ends the checking of the part of the program being checked, whose error is kept, or that cannot
# be checked as a part that it needs has an error.
struct CheckAborted: Error

export fail := (program: ProgramWide, at: Position, message: String) ->
  if call := program.annotated_call
    report_error_in program, call.path, call.at, "#{message} (#{call.context})"
  contexts := program.contexts
  report_error program, at, message if contexts.is_empty()
  fail_in_context program, at, message, contexts.last()!

export fail_already_defined := (program: ProgramWide, name: Identifier) ->
  fail program, name.position, "'#{name.name}' is already defined"

# Fails as nothing gives the type argument `name` of `callee`; the advice writes the call as
# `written`.
export fail_cannot_infer := (
  program: ProgramWide, at: Position, name: String, callee: String, written: String
) ->
  advice := "write it, as in #{written}<...>(...)"
  fail program, at, "cannot infer the type argument #{name} of '#{callee}'; #{advice}"

export fail_already_member := (program: ProgramWide, at: Position, name: String, owner: String) ->
  fail program, at, "'#{name}' is already a member of #{owner}"

# An error that says what was being checked, such as `in print<Int>`.
export fail_in_context := (program: ProgramWide, at: Position, message: String, context: String) ->
  report_error program, at, "#{message} (#{context})"

report_error := (program: ProgramWide, at: Position, message: String) ->
  report_error_in program, error_module_path(program), at, message

report_error_in := (program: ProgramWide, path: String?, at: Position, message: String) ->
  error := CheckError(path, diagnostic: { message, at })
  program.errors.push error

  # A check that does not find all errors ends at the first.
  report_errors program unless program.finds_all_errors

  abort_part()

# Ends the checking of the part, without an error of its own: that of the part it needs is kept.
export abort_part := ->
  throw CheckAborted('the checking of a part of the program ended with an error')

# Checks a part of the program, such as a function's body, whose error ends it alone, so that the
# checking goes on with the other parts and finds their errors too. Returns whether the part
# checked. The stacks of what is being checked are left as the part found them.
export check_part := (program: ProgramWide, check: () -> void) ->
  { modules_checked, contexts, functions_checked, annotated_call } := program
  module_depth := modules_checked.length
  context_depth := contexts.length
  function_depth := functions_checked.length
  try
    check()
    true
  catch _: CheckAborted
    modules_checked.truncate module_depth
    contexts.truncate context_depth
    functions_checked.truncate function_depth
    program.annotated_call = annotated_call
    false

# Throws the errors of the program as one CompileError, if it has any; its warnings are left to
# all_warnings.
export report_errors := (program: ProgramWide) ->
  return if program.errors.is_empty()
  errors: Located[]
  for module in program.modules
    path := module.display_path
    diagnostics := [error.diagnostic for error in program.errors when error.path == path]
    errors.append located_diagnostics(program, path, diagnostics)
  throw compile_errors(errors)

# The path of the innermost module being checked, which an error is in; nil for the entry module.
export error_module_path := (program: ProgramWide) ->
  index := program.modules_checked.last()
  index then program.modules[index].display_path

# Diagnostics name the module whose code is checked: from enter_module on, or while `check` runs.
export enter_module := (shared: Shared) -> shared.program.modules_checked.push(shared.index)

export in_module := (shared: Shared, check: () -> void) ->
  enter_module shared
  check()
  shared.program.modules_checked.pop()

export warn := (shared: Shared, at: Position, message: String, kind: DiagnosticKind = OTHER) ->
  shared.warnings.push { message, at, kind }

export warn_if_unused := (shared: Shared, local: Local) ->
  { name, position } := local.identifier
  return if not local.declared or local.used or name.starts_with('_')
  warn shared, position, "'#{name}' is never used"

# The warnings of the program, where they are found. A program's author cannot act on the
# warnings of the standard modules, which would warn, for example, about the names that only
# generic functions the program never calls use. The unused names of a module are known once its
# functions are checked, which may use them; not if a part has an error, as the names that only it
# uses may not have been seen used before the error.
export all_warnings := (program: ProgramWide) ->
  if program.errors.is_empty()
    warn_unused program.shared[index] for index in program.bodies_checked
  warnings: Located[]

  # A file of std's directories is of the standard modules that import it, whose own warnings it
  # gives when one of them is built on its own.
  shows_std_files := is_standard_name(program.entry_path)
  is_shown := (module: Module) ->
    return true unless is_standard_module(module)
    shows_std_files and is_nested_name(module.display_path!)

  for module in program.modules
    continue unless is_shown(module)
    found := program.shared[module.index].warnings
    warnings.append located_diagnostics(program, module.display_path, found)
  warnings

# The diagnostics of the module of the path, in source order.
located_diagnostics := (program: ProgramWide, path: String?, diagnostics: Diagnostic[]) ->
  location := module_location(program.entry_path, path)
  located := (each: Diagnostic) ->
    { at, message, kind } := each
    Located(location, message, kind, line: at.line, column: at.column)
  [located(each) for each in in_source_order(diagnostics)]

# The names of the top-level code and the imports that are never used.
warn_unused := (shared: Shared) ->
  if scope := shared.top_level_scope
    warn_if_unused shared, local for local in scope.values()
  { names, modules } := shared.imports
  imports: (ImportedName | ModuleAlias)[] = [names.values()..., modules.values()...]
  for imported in imports
    { name, used } := imported
    message := "'#{name.name}' is imported but never used"
    warn shared, name.position, message, UNUSED_IMPORT unless used

# Warnings are found as scopes end, and errors as parts are checked on demand; they are reported in
# source order, once each, though each instance of a generic function finds those of its body
# again.
in_source_order := (diagnostics: Diagnostic[]) ->
  seen: Set<String>
  unique: Diagnostic[]
  for diagnostic in diagnostics
    key := "#{diagnostic.at.line}:#{diagnostic.at.column}:#{diagnostic.message}"
    continue unless seen.add(key)
    unique.push diagnostic
  unique.sorted((a, b) -> a.at.compare(b.at))
