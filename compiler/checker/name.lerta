# Types the names that expressions use: locals, the module's functions, the names it imports and
# the builtins, in that order.
import Expression, FunctionLiteral, Identifier, Member from '../ast'
import captured from './closure'
import COMPLETION_NAME, probe_locals, probe_module from './completion_probe'
import fail from './diagnostics'
import function_type_of, generic_function, has_function from './functions'
import
  builtin_export, Export, ExternExport, FunctionExport, GenericExport, imported_export,
  InterfaceExport, qualified_import, TypeExport, use_import, value_local, ValueExport
from './imports'
import object_type from './object_types'
import ExternReference, FunctionReference, Reference, ScopedLocal, TopLevelValue from './references'
import Local from './scopes'
import Body, Shared from './shared'
import abort_if_failed, fail_runs_later, reject_pending from './top_level_values'
import has_alias from './type_names'
import has_declared_type from './interfaces'

# The local of the name: in the scopes, or outside them, as a function literal captures it from
# around it, as a top-level value that a function or a method sees, or as an imported value.
export lookup := (body: Body, name: String) ->
  return local if local := body.scopes.lookup_local(name)
  return outer if outer := captured(body, name)
  if body.sees_top_level
    return top_level if top_level := body.shared.top_level.locals[name]
  value_local body.shared, name

# The declaration of the top-level function written in Lerta that the callee names, if it does, as
# type_of_identifier finds it.
export named_function_literal := (body: Body, callee: Expression): FunctionLiteral? ->
  return nil unless callee is Identifier
  { program, shared } := body
  name := callee.name
  return nil if lookup(body, name) != nil
  return entry.literal if entry := shared.functions.entries[name]
  exported := export_named(shared, name)
  return nil unless exported is FunctionExport
  program.shared[exported.module_index].functions.entries[exported.name]!.literal

export type_of_identifier := (body: Body, identifier: Identifier, is_callee: Bool) ->
  { program, shared } := body
  { name, position } := identifier
  if local := lookup(body, name)
    origin := local.original()
    origin.used = true
    origin.reads.push identifier
    body.facts.local_declarations[identifier] = origin.identifier
    is_own := body.scopes.lookup_local(name) != nil
    # Read from a function literal, whose body has scopes of its own, or from a block inside the
    # local's scope.
    is_inner := not is_own or body.scopes.depth() != origin.scope_depth
    origin.read_in_inner_scope = true if is_inner
    body.facts.escaping_locals.add origin.identifier if not is_callee or not is_own
    record_reference body, identifier, local_reference(body, name, local)
    return local.type
  if function_type := function_type_of(program, shared.index, name, position)
    record_reference body, identifier, FunctionReference(name, module_index: shared.index)
    return function_type
  fail_only_called body, identifier if generic_function(shared, name) != nil
  if object_type(shared, name) != nil
    fail program, position, "'#{name}' is a type; construct it as #{name}(...)"
  fail program, position, "'#{name}' is a type" if name in shared.enums
  fail program, position, "'#{name}' is an interface" if name in shared.interfaces
  fail program, position, "'#{name}' is a type" if has_alias(shared, name)
  if imported := use_import(shared, name)
    exported := imported_export(program, imported)
    if exported is ValueExport and exported.type == nil
      abort_if_failed program.shared[exported.module_index].top_level, exported.name
      fail_runs_later program, identifier, "'#{imported.module}'", body.sees_top_level
    return type_of_export(body, exported, identifier, is_callee)
  abort_if_failed shared.top_level, name
  reject_pending program, shared.top_level, identifier if body.sees_top_level
  if name in shared.imports.modules
    fail program, position, "'#{name}' is a module, which is no value: write #{name}.<export>"
  probe_locals body if name == COMPLETION_NAME
  undefined_name := -> fail(program, position, "undefined name '#{name}'")
  builtin := builtin_export(shared, name) ? undefined_name()
  type_of_export body, builtin, identifier, is_callee

# `name.export` of a module imported as `name`, where no local takes the name, as the name that the
# export is imported by (see qualified_import), recorded as the member's replacement (see
# NodeFacts.replacements), which later checks of the member return; nil for any other member.
export qualified_name := (body: Body, member: Member): Identifier? ->
  replacement := body.facts.replacements[member]
  return replacement if replacement is Identifier
  object := member.object
  return nil if object is not Identifier or lookup(body, object.name) != nil
  if member.name.name == COMPLETION_NAME
    probe_module body, imported.module_index if imported := body.shared.imports.modules[object.name]
  qualified := qualified_import(body.shared, object.name, member.name) ? return nil
  name := Identifier(member.name..., name: qualified)
  body.facts.replacements[member] = name
  name

# The generic function that the callee names: one of the module, an imported one or a builtin,
# unless a local or another name of the module takes the name.
export generic_callee := (body: Body, callee: Expression) ->
  return nil unless callee is Identifier
  shared := body.shared
  name := callee.name
  return nil if lookup(body, name) != nil
  return nil if body.sees_top_level and name in shared.top_level.names
  return nil if has_declared_type(shared, name) or has_alias(shared, name)
  return generic_function(shared, name) if has_function(shared, name)
  exported := export_named(shared, name)
  return nil unless exported is GenericExport
  use_import shared, name
  exported.generic

# The C function that the name refers to, declared by the module or imported, unless a local or
# another name of the module takes the name.
export extern_named := (body: Body, name: Identifier) ->
  return nil if lookup(body, name.name) != nil
  return nil if body.sees_top_level and name.name in body.shared.top_level.names
  exported := export_named(body.shared, name.name)
  exported is ExternExport then exported

# The export that the name is imported by, or else that of std:builtins of the name, if any.
export_named := (shared: Shared, name: String) ->
  imported := shared.imports.names[name] ? return builtin_export(shared, name)
  imported_export shared.program, imported

# A generic function is called through generic_callee, so here it is used as a value. A value
# whose type is not known yet is reported by type_of_identifier.
type_of_export := (body: Body, exported: Export, identifier: Identifier, is_callee: Bool) ->
  { name, position } := identifier
  case exported
    when TypeExport then fail(body.program, position, "'#{name}' is a type")
    when InterfaceExport then fail(body.program, position, "'#{name}' is an interface")
    when GenericExport then fail_only_called(body, identifier)
    when ExternExport
      fail_only_called body, identifier unless is_callee
      { symbol, module_index } := exported
      record_reference body, identifier, ExternReference(symbol, module_index, name: exported.name)
      exported.type
    when FunctionExport
      { module_index } := exported
      record_reference body, identifier, FunctionReference(module_index, name: exported.name)
      function_type_of(body.program, module_index, exported.name, position)!
    # A builtin value has no local in the module for local_reference to find, unlike an imported
    # one, so its reference is recorded here.
    when ValueExport
      { module_index } := exported
      record_reference body, identifier, TopLevelValue(module_index, name: exported.name)
      exported.type ? panic('the type of an imported value is not known')

fail_only_called := (body: Body, identifier: Identifier) ->
  message := "'#{identifier.name}' can only be called so far, not used as a value"
  fail body.program, identifier.position, message

# What the name, which lookup found as the local, refers to: a top-level value of the module or
# of another one, or a local of a scope, as one that a function literal captures is. A narrowed
# local refers to what it narrows.
export local_reference := (body: Body, name: String, local: Local): Reference ->
  return ScopedLocal(name) if local.captured
  shared := body.shared
  origin := local.original()
  if body.sees_top_level and origin == shared.top_level.locals[name]
    return TopLevelValue(name, module_index: shared.index)
  imported := shared.imports.names[name]
  if imported and imported.local == origin
    exported := imported_export(body.program, imported) as ValueExport!
    return TopLevelValue(module_index: exported.module_index, name: exported.name)
  ScopedLocal name

export record_reference := (body: Body, identifier: Identifier, reference: Reference) ->
  body.facts.references[identifier] = reference
