# Checks statements and blocks, defining the locals they declare; loops are checked by `loop`.
import all_but_last from '../arrays'
import
  Assignment, Await, Binding, Call, Coalesce, Condition, Declaration, EnumDeclaration, Expression,
  Extend, Extern, For, FunctionLiteral, Identifier, If, Import, InterfaceDeclaration, is_exported,
  Pass, Statement, statement_else_body, This, TypeAlias, TypeDeclaration, While
from '../ast'
import check_assignment from './assignment'
import check_part, fail, fail_already_defined, warn_if_unused from './diagnostics'
import expect_condition, expect_optional, expect_type, type_of from './expression'
import has_function, required_params from './functions'
import check_for, check_while from './loop'
import ends_with_jump, narrow, narrowings_of, narrowings_where from './narrowing'
import ObjectInfo from './object_types'
import check_last_statement from './result'
import Local from './scopes'
import Body, SelfContext from './shared'
import define_top_level, top_level_value from './top_level_values'
import names_type_or_import, resolve from './type_names'
import
  format_type, FunctionType, inner_of, is_kind, is_one_of_kinds, IterType, never_type, ObjectType,
  optional_type, OptionalType, PromiseType, Type, void_type
from '../types'

# Does nothing, where a block has nothing more to define or check.
export const nothing = -> return

# Each initializer sees the constructor arguments and the fields initialized before it.
export const check_initializers = (body: Body, info: ObjectInfo, self: SelfContext) ->
  for field in info.fields
    const value = field.value ? continue
    self.initializing = field
    if const field_type = field.type
      expect_type body, value, field_type
      continue
    const type = type_of(body, value)
    reject_if_not_storable body, type, value
    field.type = type
  self.initializing = nil

# The parameters are borrowed locals. A method's body also has `@` as a local that cannot be
# written in the source. `holds`, a condition known to hold where the body runs, narrows the
# parameters it tests.
export const check_function_body = (
  body: Body, literal: FunctionLiteral, params: Type[], holds: Expression?
) ->
  const define_params = ->
    if const self = body.self
      const identifier = Identifier(name: '@', position: literal.position)
      const object = Local(identifier, type: self.type, used: true)
      body.scopes.define '@', object
    const required = required_params(literal)
    for declared, i in literal.params
      const identifier = declared.name
      if const default = declared.default
        expect_type body, default, params[i]
      else if i > required
        const reason = 'as those before it have'
        const message = "the parameter '#{identifier.name}' needs a default, #{reason}"
        fail body.program, identifier.position, message
      const param = Local(identifier, type: params[i])
      define_local body, param
    narrow_where_holds body, holds if holds
  const statements = literal.body
  const finish = -> check_last_statement(body, last) if const last = statements.last()
  check_block body, all_but_last(statements), define_params, finish

# The top-level code. Its names may be used by the functions, which are checked later, so its
# scope is kept to warn about those never used once they are. An error ends the checking of its
# statement alone, leaving the scopes and loops that the statement was in.
export const check_top_level_code = (body: Body, statements: Statement[]) ->
  body.scopes.push()
  for statement in statements
    continue if check_part(body.program, -> check_statement(body, statement))
    body.scopes.pop() while body.scopes.depth() > 1
    body.loop_depth = 0
    if const declaration = top_level_value(statement)
      body.shared.top_level.failed.add declaration.name.name
  body.scopes.pop()

# A block that gives a value: its last statement, typed in its scope by `type_of_last` if it is an
# expression; the block is void if it ends with another statement, and never if with a jump.
export const type_of_block = (
  body: Body, statements: Statement[], define: () -> void, type_of_last: (Expression) -> Type
) ->
  const last = statements.last()!
  var type: Type = void_type
  const finish = ->
    if const value = last as Expression?
      type = type_of_last(value)
      return
    check_statement body, last
    type = never_type if ends_with_jump([last], (expression) -> is_never_typed(body, expression))
  check_block body, all_but_last(statements), define, finish
  type

# Whether the expression was typed `never`.
const is_never_typed = (body: Body, expression: Expression) ->
  const type = body.facts.types[expression] ? return false
  is_kind type, 'never'

# A block is a scope; `define` declares the names that belong to it besides its statements, and
# `finish` checks more before the scope ends. A compile error ends the checking of the body, or of
# the top-level statement, that the block is in, so the scope needs no cleanup on the way out (see
# check_top_level_code).
export const check_block = (
  body: Body, statements: Statement[], define: () -> void, finish: () -> void
) ->
  body.scopes.push()
  define()
  check_statement body, statement for statement in statements
  finish()
  const scope = body.scopes.pop()
  warn_if_unused body.shared, local for local in scope.values()

export const check_statement = (body: Body, statement: Statement): void ->
  const is_top_level = body.is_top_level()
  if is_exported(statement) and not is_top_level
    fail body.program, statement.position, 'export can only be at the top level'
  const require_top_level = (message: String) ->
    fail body.program, statement.position, message if not is_top_level
  case statement
    when For then check_for(body, statement)
    when While then check_while(body, statement)
    when If then check_if(body, statement)
    when Declaration then check_declaration(body, statement)
    when Assignment then check_assignment(body, statement)
    when TypeAlias then require_top_level('a type can only be declared at the top level')
    when EnumDeclaration then require_top_level('an enum can only be declared at the top level')
    when InterfaceDeclaration
      require_top_level 'an interface can only be declared at the top level'
    when Extern then require_top_level('an extern can only be declared at the top level')
    when Extend then require_top_level('an extend can only be at the top level')
    when Import then require_top_level('an import can only be at the top level')
    when Pass then pass
    when TypeDeclaration
      require_top_level 'a class or struct can only be declared at the top level'
    else check_expression_statement(body, statement as Expression!)

export const check_if = (body: Body, if_statement: If) ->
  const { then_body } = if_statement
  const else_body = statement_else_body(if_statement)
  const entries = check_if_condition(body, if_statement)
  check_block body, then_body, entries.enter_then, nothing
  check_block body, else_body, entries.enter_else, nothing
  const is_never = (expression: Expression) -> is_never_typed(body, expression)
  entries.enter_else() if else_body.length == 0 and ends_with_jump(then_body, is_never)

# Checks the condition, and returns what entering each branch does: the then branch defines the
# name that the condition binds, and each narrows the locals that the condition tests.
export const check_if_condition = (body: Body, if_statement: If) ->
  const condition = if_statement.condition
  const define = check_condition(body, condition)
  const narrowings = narrowings_of(body, condition)
  const narrow_where = (value: Bool) -> narrow(body, narrowings_where(narrowings, value))
  const enter_then = ->
    define()
    narrow_where true
  { enter_then, enter_else: -> narrow_where(false) }

# Checks the condition, and returns what it defines in the body: the name of `const name = value`.
export const check_condition = (body: Body, condition: Condition) ->
  if condition is Binding
    const inner = expect_optional(body, condition.value)
    const identifier = condition.name
    const local = Local(identifier, type: inner, declared: true)
    -> define_local(body, local)
  else
    expect_condition body, condition as Expression!
    nothing

# Narrows, in the current scope, the locals that the condition tests, where it holds.
export const narrow_where_holds = (body: Body, condition: Expression) ->
  narrow body, narrowings_of(body, condition).where_true

# A top-level function was added to the module's functions before checking started.
const check_declaration = (body: Body, declaration: Declaration) ->
  const value = declaration.value
  return if value is FunctionLiteral and body.is_top_level()
  const type_name = declaration.type
  const annotated = type_name then resolve(body.program, body.resolver, type_name)
  expect_type body, value, annotated if annotated
  const value_type = annotated ? type_of(body, value)
  reject_if_not_storable body, value_type, value
  # An exported value is for other modules to use.
  const { name, mutable, exported, weak } = declaration
  const type = weak then weak_local_type(body, declaration, value_type) else value_type
  const declared = not declaration.of_loop
  const is_this = value is This and not mutable and not weak
  define_local body, Local(type, mutable, declared, weak, is_this, identifier: name, used: exported)

# A weak local holds an object of a class, or nil, and is no top-level value, which would stay
# for good.
const weak_local_type = (body: Body, declaration: Declaration, value_type: Type) ->
  const program = body.program
  const at = declaration.position
  fail program, at, 'a weak const or var can only be a local' if body.is_top_level()
  if declaration.type != nil and not (value_type is OptionalType)
    const written = "#{format_type(value_type)}?"
    fail program, at, "a weak const or var may hold nil: write its type as #{written}"
  const object = inner_of(value_type) as ObjectType?
  const holds_class = object?.is_struct == false
  fail program, at, 'a weak const or var holds an object of a class' if not holds_class
  optional_type value_type

const reject_if_not_storable = (body: Body, type: Type, value: Expression) ->
  if is_one_of_kinds(type, ['void', 'never', 'nil'])
    fail body.program, value.position, "cannot store a value of type #{format_type(type)}"

export const define_local = (body: Body, local: Local) ->
  const { name, position } = local.identifier
  const { program, shared } = body
  const is_top_level = body.is_top_level()
  const is_taken = has_function(shared, name) or names_type_or_import(shared, name)
  fail_already_defined program, local.identifier if is_top_level and is_taken
  if not body.scopes.define(name, local)
    fail program, position, "'#{name}' is already defined in this scope"
  define_top_level shared.top_level, local if is_top_level
  body.facts.types[local.identifier] = local.type

const check_expression_statement = (body: Body, statement: Expression) ->
  check_discarded body, statement, type_of(body, statement)

# See the rules for discarded values in docs/reference/errors.md.
export const check_discarded = (body: Body, statement: Expression, type: Type) ->
  const program = body.program
  const at = statement.position
  fail program, at, 'an Iter does nothing until it is consumed' if type is IterType
  fail program, at, 'a Promise must be awaited' if type is PromiseType
  return if statement is Call or statement is Await or is_one_of_kinds(type, ['void', 'never'])
  # `x ? return` is a guard: its value is the reason to stop, not something to use.
  return if statement is Coalesce and is_never_typed(body, statement.fallback)
  if statement is Identifier and type is FunctionType
    const message = "function value is unused; to call it, write `#{statement.name}()`"
    fail program, at, message
  fail program, at, 'value is unused'
