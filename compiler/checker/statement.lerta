# Checks statements and blocks, defining the locals they declare; loops are checked by `loop`.
import
  Assignment, Await, Binding, Call, Case, Coalesce, Condition, Declaration, EnumDeclaration,
  Expression, Extend, Extern, Intrinsic, For, FunctionLiteral, Identifier, If, Import,
  InterfaceDeclaration, is_exported, NilLiteral, OMITTED_VALUES, Pass, Statement,
  statement_else_body, This, Try, TypeAlias, TypeDeclaration, While
from '../ast'
import check_assignment from './assignment'
import check_case_statement, check_try_statement from './case'
import declared_constant from './constants'
import check_part, fail, fail_already_defined, warn, warn_if_unused from './diagnostics'
import expect_condition, expect_optional, expect_type, type_of from './expression'
import
  described_parameter, has_function, is_taken_apart_parameter, required_params
from './functions'
import names_literals_assign from './literal_assignments'
import
  finish_local_functions, forget_local_function_uses, predeclare_local_functions,
  predeclared_function
from './local_functions'
import named_function from './name'
import check_for, check_while from './loop'
import ends_with_jump, narrow, narrowings_of, narrowings_where from './narrowing'
import ObjectInfo from './object_types'
import check_last_statement from './result'
import Local from './scopes'
import Body, SelfContext from './shared'
import define_top_level, top_level_value from './top_level_values'
import names_type_or_import, resolve from './type_names'
import is_standard_name, module_location from '../source'
import
  format_type, FunctionType, inner_of, is_assignable, is_kind, is_one_of_kinds, IterType,
  never_type, nil_type, ObjectType, optional_type, OptionalType, PromiseType, Type, void_type
from '../types'

# Does nothing, where a block has nothing more to define or check.
export nothing := -> return

# Each initializer sees the constructor arguments and the fields initialized before it.
export check_initializers := (body: Body, info: ObjectInfo, self: SelfContext) ->
  for field in info.fields
    value := field.value ? continue
    self.initializing = field
    if field_type := field.type
      expect_type body, value, field_type
      continue
    type := type_of(body, value)
    reject_if_not_storable body, type, value
    field.type = type
  self.initializing = nil

# The parameters are borrowed locals. A method's body also has `@` as a local that cannot be
# written in the source. `holds`, a condition known to hold where the body runs, narrows the
# parameters it tests. The defaults are checked unless `checks_defaults` is false, as for an
# instance of a generic function, whose defaults are checked apart (see check_instance_defaults).
export check_function_body := (
  body: Body
  literal: FunctionLiteral
  params: Type[]
  holds: Expression?
  checks_defaults = true
) ->
  statements := literal.body
  define_params := ->
    define_parameters body, literal, params, checks_defaults
    narrow_where_holds body, holds if holds
    # The last statement, which check_block leaves to `finish`, may declare one too.
    predeclare_local_functions body, statements.last() then [statements.last()!] else []
  body.names_literals_assign = names_literals_assign(statements)
  before_last := statements.all_but_last()
  finish := ->
    last := statements.last() ? return
    warn_if_unreachable body, previous, last if previous := before_last.last()
    check_last_statement body, last
  # A function literal's own name, outside its parameters and locals, which may hide it.
  body.scopes.push()
  body.scopes.define itself.identifier.name, itself if itself := body.self_local
  check_block body, before_last, define_params, finish
  body.scopes.pop()

# Defines `@` and the parameters in order, each default seeing those before it, checked if
# `checks_defaults`.
export define_parameters := (
  body: Body, literal: FunctionLiteral, params: Type[], checks_defaults: Bool
) ->
  if self := body.self
    identifier := Identifier(name: '@', position: literal.position)
    object := Local(identifier, type: self.type, used: true)
    body.scopes.define '@', object
  required := required_params(literal)
  for declared at i in literal.params
    identifier := declared.name
    if default := declared.default
      expect_type body, default, params[i] if checks_defaults
    else if i > required
      described := described_parameter(identifier)
      # One taken apart takes no default (see parse_destructured_parameter).
      problem :=
        if is_taken_apart_parameter(identifier)
          'cannot follow one with a default'
        else
          'needs a default, as those before it have'
      fail body.program, identifier.position, "#{described} #{problem}"
    param := Local(identifier, type: params[i])
    define_local body, param

# The top-level code. Its names may be used by the functions, which are checked later, so its
# scope is kept to warn about those never used once they are. An error ends the checking of its
# statement alone, leaving the scopes and loops that the statement was in.
export check_top_level_code := (body: Body, statements: Statement[]) ->
  body.names_literals_assign = names_literals_assign(statements)
  body.scopes.push()
  for statement at i in statements
    warn_if_unreachable body, statements[i - 1], statement if i > 0
    continue if check_part(body.program, -> check_statement(body, statement))
    body.scopes.pop() while body.scopes.depth() > 1
    body.loop_depth = 0
    if declaration := top_level_value(statement)
      body.shared.top_level.failed.add declaration.name.name
  scope := body.scopes.pop()
  warn_if_consumed_twice body, local for local in scope.values()
  scope

# A block that gives a value: its last statement, typed in its scope by `type_of_last` if it is an
# expression; the block is void if it ends with another statement, and never if with a jump.
export type_of_block := (
  body: Body, statements: Statement[], define: () -> void, type_of_last: (Expression) -> Type
) ->
  last := statements.last()!
  before_last := statements.all_but_last()
  var type: Type = void_type
  finish := ->
    warn_if_unreachable body, previous, last if previous := before_last.last()
    if value := last as Expression?
      type = type_of_last(value)
      return
    check_statement body, last
    type = never_type if ends_with_jump([last], (expression) -> is_never_typed(body, expression))
  check_block body, before_last, define, finish
  type

# Warns at a statement after one that never ends, as `return` or a call of `exit` does.
warn_if_unreachable := (body: Body, previous: Statement, statement: Statement) ->
  is_never := (expression: Expression) -> is_never_typed(body, expression)
  warn body.shared, statement.position, 'unreachable code' if ends_with_jump([previous], is_never)

# Whether the expression was typed `never`.
export is_never_typed := (body: Body, expression: Expression) ->
  type := body.facts.types[expression] ? return false
  is_kind(type, 'never')

# A block is a scope; `define` declares the names that belong to it besides its statements, and
# `finish` checks more before the scope ends. A compile error ends the checking of the body, or of
# the top-level statement, that the block is in, so the scope needs no cleanup on the way out (see
# check_top_level_code).
export check_block := (
  body: Body, statements: Statement[], define: () -> void, finish: () -> void
) ->
  body.scopes.push()
  define()
  predeclare_local_functions body, statements
  try
    for statement at i in statements
      warn_if_unreachable body, statements[i - 1], statement if i > 0
      check_statement body, statement
    finish()
    finish_local_functions body
  finally
    # The uses hold the bodies reading the functions, which hold the facts.
    forget_local_function_uses body
  scope := body.scopes.pop()
  warn_if_unused body.shared, local for local in scope.values()
  record_only_read body, local for local in scope.values()
  warn_if_consumed_twice body, local for local in scope.values()

# A `:=` local that is read once, in its own scope, as what a loop or a comprehension goes through
# or as the object of a method, and nowhere else, so that codegen may evaluate its value there
# instead (see lazy_reads in NodeFacts).
record_only_read := (body: Body, local: Local) ->
  return if not local.declared or local.mutable or local.weak or local.captured
  return if local.reads.length != 1 or local.read_in_inner_scope
  read := local.reads[0]
  body.facts.lazy_reads[local.identifier] = read if read in body.facts.consuming_reads

# Warns at the read of a `:=` local holding an Iter that starts a second traversal of it, as one
# that goes through it, by a loop, a comprehension or a method, throws once another has started.
# has_next and next go on with a traversal: only the first of them starts one, and only before a
# consumer, after which they find the end. Only the reads in the local's own block count, as they
# run one after another; those in a branch, a loop or a function literal may run any number of
# times.
warn_if_consumed_twice := (body: Body, local: Local) ->
  return if not local.declared or local.mutable or local.type is not IterType
  { consuming_reads, stepping_reads } := body.facts
  var stepped = false
  var consumes = false
  starts: Identifier[]
  for read in Set<Identifier>(local.reads)
    continue if read in local.inner_reads
    if read in consuming_reads
      consumes = true
      starts.push read
    else if read in stepping_reads and not stepped and not consumes
      stepped = true
      starts.push read
  return if not consumes or starts.length < 2
  name := local.identifier.name
  message := "'#{name}' is an Iter, which this traverses again after another traversal; " +
    "write #{name}.to_array() where it is made to go through it more than once"
  warn body.shared, starts[1].position, message

export check_statement := (body: Body, statement: Statement): void ->
  is_top_level := body.is_top_level()
  if is_exported(statement) and not is_top_level
    fail body.program, statement.position, 'export can only be at the top level'
  require_top_level := (message: String) ->
    fail body.program, statement.position, message unless is_top_level
  case statement
    when For then check_for(body, statement)
    when While then check_while(body, statement)
    when If then check_if(body, statement)
    when Try then check_try_statement(body, statement)
    when Case then check_case_statement(body, statement)
    when Declaration then check_declaration(body, statement)
    when Assignment then check_assignment(body, statement)
    when TypeAlias then require_top_level('a type can only be declared at the top level')
    when EnumDeclaration then require_top_level('an enum can only be declared at the top level')
    when InterfaceDeclaration
      require_top_level 'an interface can only be declared at the top level'
    when Extern then require_top_level('an extern can only be declared at the top level')
    when Intrinsic then require_top_level('an intrinsic can only be declared at the top level')
    when Extend then require_top_level('an extend can only be at the top level')
    when Import then require_top_level('an import can only be at the top level')
    when Pass then pass
    when TypeDeclaration
      require_top_level 'a class or struct can only be declared at the top level'
    else check_expression_statement(body, statement)

export check_if := (body: Body, if_statement: If) ->
  { then_body } := if_statement
  else_body := statement_else_body(if_statement)
  entries := check_if_condition(body, if_statement)
  check_block body, then_body, entries.enter_then, nothing
  check_block body, else_body, entries.enter_else, nothing
  is_never := (expression: Expression) -> is_never_typed(body, expression)
  entries.enter_else() if else_body.is_empty() and ends_with_jump(then_body, is_never)

# Checks the condition, and returns what entering each branch does: the then branch defines the
# name that the condition binds, and each narrows the locals that the condition tests.
export check_if_condition := (body: Body, if_statement: If) ->
  condition := if_statement.condition
  define := check_condition(body, condition)
  narrowings := narrowings_of(body, condition)
  narrow_where := (value: Bool) -> narrow(body, narrowings_where(narrowings, value))
  enter_then := ->
    define()
    narrow_where true
  { enter_then, enter_else: -> narrow_where(false) }

# Checks the condition, and returns what it defines in the body: the name of `name := value`.
export check_condition := (body: Body, condition: Condition) ->
  if condition is Binding
    inner := expect_optional(body, condition.value)
    identifier := condition.name
    local := Local(identifier, type: inner, declared: true)
    -> define_local(body, local)
  else
    expect_condition body, condition
    nothing

# Narrows, in the current scope, the locals that the condition tests, where it holds.
export narrow_where_holds := (body: Body, condition: Expression) ->
  narrow body, narrowings_of(body, condition).where_true

# A top-level function was added to the module's functions before checking started.
check_declaration := (body: Body, declaration: Declaration) ->
  value := declaration.value
  if value is FunctionLiteral
    return if body.is_top_level()
    body.facts.local_function_names[value] = declaration.name unless declaration.mutable
  type_name := declaration.type
  annotated := type_name then resolve(body.program, body.resolver, type_name)
  reject_omitted_value body, declaration, annotated
  expect_type body, value, annotated if annotated
  value_type := annotated ? type_of(body, value)
  reject_if_not_storable body, value_type, value
  # An exported value is for other modules to use.
  { name, mutable, exported, weak } := declaration
  type := weak then weak_local_type(body, declaration, value_type) else value_type
  declared := not declaration.of_loop
  is_this := value is This and not mutable and not weak
  assigned_by_literal := mutable and name.name in body.names_literals_assign
  scope_depth := body.scopes.depth()
  constant := body.is_top_level() and not mutable then declared_constant(body, value, type)
  if predeclared := predeclared_function(body, value)
    predeclared.pending = false
    body.facts.types[name] = type
    return
  local := Local
    type, mutable, declared, weak, is_this, assigned_by_literal, scope_depth, constant,
    identifier: name, used: exported
  define_local body, local

# `var x: T` without a value: of a type other than an array, a map or a set, which start empty, it
# is nil, which the type must fit.
reject_omitted_value := (body: Body, declaration: Declaration, type: Type?) ->
  written := type ? return
  is_nil := declaration.value is NilLiteral
  return if not declaration.omits_value or not is_nil or is_assignable(nil_type, written)
  needs := "a var of type #{format_type(written)} needs an initial value"
  message := "#{needs}: #{OMITTED_VALUES}"
  fail body.program, declaration.type!.position, message

# A weak local holds an object of a class, or nil, and is no top-level value, which would stay
# for good.
weak_local_type := (body: Body, declaration: Declaration, value_type: Type) ->
  program := body.program
  at := declaration.position
  fail program, at, 'a weak const or var can only be a local' if body.is_top_level()
  if declaration.type != nil and value_type is not OptionalType
    written := "#{format_type(value_type)}?"
    fail program, at, "a weak const or var may hold nil: write its type as #{written}"
  object := inner_of(value_type) as ObjectType?
  holds_class := object?.is_struct == false
  fail program, at, 'a weak const or var holds an object of a class' unless holds_class
  optional_type(value_type)

reject_if_not_storable := (body: Body, type: Type, value: Expression) ->
  if is_one_of_kinds(type, ['void', 'never', 'nil'])
    fail body.program, value.position, "cannot store a value of type #{format_type(type)}"

export define_local := (body: Body, local: Local) ->
  { name, position } := local.identifier
  { program, shared } := body
  is_top_level := body.is_top_level()
  is_taken := has_function(shared, name) or names_type_or_import(shared, name)
  fail_already_defined program, local.identifier if is_top_level and is_taken
  unless body.scopes.define(name, local)
    fail program, position, "'#{name}' is already defined in this scope"
  define_top_level shared.top_level, local if is_top_level
  body.facts.types[local.identifier] = local.type

check_expression_statement := (body: Body, statement: Expression) ->
  check_discarded body, statement, type_of(body, statement)

# See the rules for discarded values in docs/reference/errors.md.
export check_discarded := (body: Body, statement: Expression, type: Type) ->
  program := body.program
  at := statement.position
  reject_unconsumed body, statement, type
  return if statement is Call | Await or is_one_of_kinds(type, ['void', 'never'])
  # `x ? return` is a guard: its value is the reason to stop, not something to use.
  return if statement is Coalesce and is_never_typed(body, statement.fallback)
  if statement is Identifier and type is FunctionType
    message := "function value is unused; to call it, write `#{statement.name}()`"
    fail program, at, message
  fail program, at, 'value is unused'

# An Iter or a Promise must be used, even as the value of an arm of a statement whose arms give
# values with no type in common, as a Promise and void, which gives void.
reject_unconsumed := (body: Body, value: Expression, type: Type): void ->
  at := value.position
  fail body.program, at, 'an Iter does nothing until it is consumed' if type is IterType
  if type is PromiseType
    fail body.program, at, "a Promise must be awaited#{awaiting_cause(body, value)}"
  return unless is_kind(type, 'void')
  arms := arm_bodies(value) ? return
  for arm in arms
    last := arm.last() as Expression?
    arm_type := last then body.facts.types[last]
    reject_unconsumed body, last!, arm_type if arm_type

# Why a call gives a Promise, where it calls a function that awaits, which a change to its body may
# have made one: where that function first awaits, unless std declares it, which is not to change.
awaiting_cause := (body: Body, value: Expression) ->
  call := value as Call ? return ''
  callee := call.callee as Identifier ? return ''
  (literal, shared) := named_function(body, callee) ? return ''
  at := literal.await_at ? return ''
  location := module_location(body.program.entry_path, shared.path)
  return '' if is_standard_name(location)
  ": '#{callee.name}' returns a Promise, as it awaits at #{location}:#{at.line}:#{at.column}"

# The blocks of a statement that holds others, whose last statements give its value.
export arm_bodies := (statement: Expression): Statement[][]? ->
  case statement
    when If then [statement.then_body, statement.else_body]
    when Case
      arms := [arm.body for arm in statement.arms]
      arms.push otherwise if otherwise := statement.otherwise
      arms
    when Try then [statement.body, [catch_clause.body for catch_clause in statement.catches]...]
    else nil
