# The arrays whose items the program takes out, by `xs[i] = x` or `xs.pop()`, by their item types:
# an item of an array of any other type stays in it as long as the array lives. The checker records
# them as it checks the code, of each instance of a generic function, all before codegen.
import ProgramWide from './shared'
import ArrayType, type_key from '../types'

export record_taken_items := (program: ProgramWide, array: ArrayType) ->
  program.taken_items.add type_key(array.element)

export are_items_taken := (program: ProgramWide, array: ArrayType) ->
  type_key(array.element) in program.taken_items
