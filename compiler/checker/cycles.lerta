# Warns of the cycle that a function literal makes when it captures `@` and is stored where `@`
# holds it, as docs/reference/errors.md#cycles states.
import
  ArrayLiteral, Call, Coalesce, Conditional, Expression, FunctionLiteral, Index, MapLiteral, Member,
  RecordLiteral, This, TupleLiteral, Unwrap
from '../ast'
import BuiltinMethod, keeps_argument from './builtins'
import warn from './diagnostics'
import constructed_type from './object'
import info_of from './object_types'
import MethodSource from './methods'
import arguments_of, Body from './shared'
import ObjectType from '../types'

# Warns if storing the value at the target, already checked, makes such a cycle.
export warn_if_cycle := (body: Body, target: Expression, value: Expression) ->
  return unless is_held_by_this(body, target)
  literal := capturing_literal(body, value) ? return
  advice := 'write it `weak -> ...`, which captures @ weakly'
  message := "this function captures @, which then holds it, so neither is freed; #{advice}"
  warn body.shared, literal.position, message

# Warns if a builtin method that keeps its argument is given one that makes such a cycle.
export warn_if_kept := (body: Body, call: Call, member: Member, source: MethodSource?) ->
  keeps := source is BuiltinMethod and keeps_argument(source.member)
  warn_if_cycle body, member.object, arguments_of(body.facts, call)[0] if keeps

is_held_by_this := (body: Body, target: Expression): Bool ->
  case target
    when This then true
    when Member then not is_weak_field(body, target) and is_held_by_this(body, target.object)
    when Index then is_held_by_this(body, target.object)
    when Unwrap then is_held_by_this(body, target.operand)
    else false

is_weak_field := (body: Body, member: Member) ->
  object_type := body.facts.types[member.object] as ObjectType ? return false
  info_of(body.program, object_type).field_named(member.name.name)?.weak == true

capturing_literal := (body: Body, value: Expression): FunctionLiteral? ->
  first := (parts: Expression[]) -> parts.find_map((part) -> capturing_literal(body, part))
  # A method of `@` used as a value is the literal that calls it (see function_references).
  return capturing_literal(body, replaced) if replaced := body.facts.replacements[value]
  case value
    when FunctionLiteral
      captures := body.facts.captures[value] ? []
      captures.any((capture) -> capture.is_this) then value
    when ArrayLiteral then first(value.elements)
    when TupleLiteral then first(value.items)
    when MapLiteral then first([entry.value for entry in value.entries])
    when RecordLiteral then first([field.value for field in value.fields])
    when Coalesce then first([value.value, value.fallback])
    when Conditional then first([value.then_value, value.else_value])
    when Call
      return nil if constructed_type(body, value.callee) == nil
      first [value.args..., [arg.value for arg in value.named_args]...]
    else nil
