# Types `case` (its conditions or patterns, and the values of its arms) and `then`/`else`.
import {
  as_expression, Case, CaseArm, Conditional, Expression, Identifier, NamedType, NilLiteral
  Statement
} from '../ast'
import { fail } from './diagnostics'
import { expect_condition, expect_type, set_type, type_of } from './expression'
import { lookup } from './name'
import { narrow, Narrowing, narrowings_of } from './narrowing'
import { Body } from './shared'
import { type_of_block } from './statement'
import { has_type, resolve } from './type_names'
import {
  EnumType, format_enum_member, format_member, format_type, inner_of, is_assignable, is_kind
  is_one_of_kinds, members_of, OptionalType, same_type, Type, type_key, TypeKind, unify, UnionType
} from '../types'

const VALUE_KINDS: Array<TypeKind> = ['Int', 'Byte', 'Bool', 'String', ENUM]

# The body of a case arm or of then/else, and the locals narrowed in it.
struct Branch
  statements: Array<Statement>
  narrowings: Array<Narrowing>

# The last statement of a branch, and the type of its value.
struct BranchValue
  last: Statement
  type: Type

export const type_of_case = (body: Body, case_expression: Case, expected: Type?) ->
  const arm_narrowings = check_patterns(body, case_expression)
  const { arms } = case_expression
  const arm_branch = (i: Int) ->
    Branch statements: arms[i].body, narrowings: arm_narrowings[i]
  const branches = [arm_branch(i) for i in 0...arms.length]
  if const otherwise = case_expression.otherwise
    branches.push Branch(statements: otherwise, narrowings: [])
  type_of_branches body, branches, expected, case_expression, 'case arms', nil

# A condition of a case without a subject is one of an `if`, which narrows locals in its arm.
const check_condition = (body: Body, condition: Expression) ->
  expect_condition body, condition
  narrowings_of(body, condition).where_true

# The condition narrows a local as `if` does: in the value for when it holds, or the other.
export const type_of_conditional = (body: Body, conditional: Conditional, expected: Type?) ->
  expect_condition body, conditional.condition
  const narrowings = narrowings_of(body, conditional.condition)
  const then_body: Array<Statement> = [conditional.then_value]
  const else_body: Array<Statement> = [conditional.else_value]
  const branches = [
    Branch(statements: then_body, narrowings: narrowings.where_true)
    Branch(statements: else_body, narrowings: narrowings.where_false)
  ]
  const description = 'the values of then and else'
  const void_message = 'then and else must give values; to run statements, write an if'
  type_of_branches body, branches, expected, conditional, description, void_message

# The type of the values the branches give: the expected type, or else one that they unify to (see
# unify), to which they are converted. Each value is typed with a local narrowed, if its branch
# narrows one. `void_message` is the error for a value that is void, which the branches may give
# unless it is set.
const type_of_branches = (
  body: Body, branches: Array<Branch>, expected: Type?, at: Expression, description: String
  void_message: String?
) ->
  # Each body is a block, which sees the locals its branch narrows.
  const type_of_body = (branch: Branch, type_of_last: (Expression) -> Type) ->
    type_of_block body, branch.statements, () -> narrow(body, branch.narrowings), type_of_last
  if expected
    const check_value = (value: Expression) ->
      expect_type body, value, expected
      expected
    for branch in branches
      const type = type_of_body(branch, check_value)
      if is_kind(type, 'void')
        const message = "expected #{format_type(expected)}, got void"
        fail body.program, branch.statements.last().position, message
    return expected
  const type_of_value = (value: Expression) -> type_of(body, value, nil)
  const value_of = (branch: Branch) ->
    BranchValue last: branch.statements.last(), type: type_of_body(branch, type_of_value)
  const values = [value_of(branch) for branch in branches]
  if const message = void_message
    if const valueless = values.find((value) -> is_kind(value.type, 'void'))
      fail body.program, valueless.last.position, message
  unify_values body, values, at, description

# A mix of T, T? and nil gives T?, to which the values (the last statements of the bodies) are
# converted.
const unify_values = (
  body: Body, values: Array<BranchValue>, at: Expression, description: String
) ->
  var type = values[0].type
  for value in values
    const mismatch = () ->
      const types = "expected #{format_type(type)}, got #{format_type(value.type)}"
      fail body.program, value.last.position, "#{description} must have the same type: #{types}"
    type = unify(type, value.type) ? mismatch()
  if is_kind(type, 'nil')
    const message = "nil alone does not give the type of #{description}; write it in an annotation"
    fail body.program, at.position, message
  for value in values
    const is_converted = not is_kind(value.type, 'never') and not same_type(value.type, type)
    body.facts.conversions[value.last] = type if is_converted and as_expression(value.last) != nil
  type

# Checks the conditions or patterns; returns, for each arm, how the subject is narrowed in it. A
# subject of type T? is matched as a T, besides an arm for nil.
const check_patterns = (body: Body, case_expression: Case) ->
  const { arms } = case_expression
  const subject = case_expression.subject
  if subject == nil
    return [check_condition(body, arm.patterns[0]) for arm in arms]
  const subject_type = type_of(body, subject, nil)
  const is_optional = subject_type is OptionalType
  const is_nil_arm = (arm: CaseArm) -> is_optional and arm.patterns.any(is_nil_pattern)
  const unhandled_nil = is_optional and not check_nil_arms(body, arms)
  const missing: Array<String> = unhandled_nil then ['nil'] else []
  const type = inner_of(subject_type)
  if type is UnionType
    return check_type_patterns(body, case_expression, is_nil_arm, subject, type, missing)
  if not is_one_of_kinds(type, VALUE_KINDS)
    const message = "cannot branch on a value of type #{format_type(subject_type)}"
    fail body.program, subject.position, message
  const value_patterns = [arm.patterns for arm in arms when not is_nil_arm(arm)]
  for patterns in value_patterns
    expect_type body, pattern, type for pattern in patterns
  if type is EnumType
    check_member_patterns body, case_expression, type, missing
  else if case_expression.otherwise == nil
    fail body.program, case_expression.position, 'a case on values needs an else arm'
  const no_narrowings: Array<Narrowing> = []
  const narrowed = is_optional then subject_narrowings(body, subject, type) else no_narrowings
  [is_nil_arm(arm) then no_narrowings else narrowed for arm in arms]

const is_nil_pattern = (pattern: Expression) -> pattern is NilLiteral

# Whether an arm handles nil, which must be the only pattern of its arm.
const check_nil_arms = (body: Body, arms: Array<CaseArm>) ->
  var handled = false
  for arm in arms
    for pattern in arm.patterns
      continue if not is_nil_pattern(pattern)
      if arm.patterns.length > 1
        fail body.program, pattern.position, 'nil must be the only pattern of its arm'
      fail_handled_twice body, pattern, 'nil' if handled
      type_of body, pattern, nil
      handled = true
  handled

# Each pattern names a type of the union; without an else arm, every type must be handled. An arm
# with one type narrows a subject that is a local that cannot be reassigned.
const check_type_patterns = (
  body: Body, case_expression: Case, is_nil_arm: (CaseArm) -> Bool, subject: Expression
  union: UnionType, missing_nil: Array<String>
) ->
  const handled: Map<String, Bool> = Map()
  const arm_narrowings: Array<Array<Narrowing>> = []
  for arm in case_expression.arms
    if is_nil_arm(arm)
      arm_narrowings.push []
      continue
    const types = [type_pattern(body, pattern, union) for pattern in arm.patterns]
    for i in 0...types.length
      for member in members_of(types[i])
        const key = type_key(member)
        fail_handled_twice body, arm.patterns[i], format_member(member, union) if handled.has(key)
        handled.add key
    arm_narrowings.push types.length == 1 then subject_narrowings(body, subject, types[0]) else []
  const missing = [
    format_member(member, union) for member in union.members when not handled.has(type_key(member))
  ]
  missing.append missing_nil
  fail_unhandled body, case_expression, missing
  arm_narrowings

# Each pattern that names a member of the enum handles it; without an else arm, every member must
# be handled.
const check_member_patterns = (
  body: Body, case_expression: Case, type: EnumType, missing_nil: Array<String>
) ->
  const handled: Map<Int, Bool> = Map()
  for arm in case_expression.arms
    for pattern in arm.patterns
      const index = body.facts.enum_values[pattern] ? continue
      if handled.has(index)
        fail_handled_twice body, pattern, format_enum_member(type.members[index])
      handled.add index
  const members = type.members
  const missing = [
    format_enum_member(members[i]) for i in 0...members.length when not handled.has(i)
  ]
  missing.append missing_nil
  fail_unhandled body, case_expression, missing

const fail_handled_twice = (body: Body, pattern: Expression, handled: String) ->
  fail body.program, pattern.position, "#{handled} is already handled by an earlier arm"

# Without an else arm, a case must handle each of the `missing`.
const fail_unhandled = (body: Body, case_expression: Case, missing: Array<String>) ->
  return if case_expression.otherwise != nil or missing.length == 0
  const message = "case does not handle #{missing.join(', ')}; add them or an else arm"
  fail body.program, case_expression.position, message

# The pattern's type, recorded on the pattern for codegen: a member of the union, or a union of some
# of its members, which a type alias names.
const type_pattern = (body: Body, pattern: Expression, union: UnionType) ->
  const fail_pattern = () ->
    const types = "the types #{format_type(union)} or a union of them"
    fail body.program, pattern.position, "expected one of #{types}"
  const { program, resolver } = body
  const name = pattern is Identifier then pattern.name else fail_pattern()
  fail_pattern() if not has_type(program, resolver, name)
  const type_name = NamedType(name, args: [], position: pattern.position, optional: false)
  const type = resolve(program, resolver, type_name)
  fail_pattern() if not is_assignable(type, union) or is_kind(type, 'never')
  set_type body, pattern, type

const subject_narrowings = (body: Body, subject: Expression, type: Type): Array<Narrowing> ->
  return [] if not (subject is Identifier)
  const local = lookup(body, subject.name) ? return []
  return [] if local.mutable
  [Narrowing(local, type)]
