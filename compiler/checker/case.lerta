# Types `case`, `if` with `else`, `try` and `then`/`else`, whose values their branches give (see
# branches), and a `case`'s conditions or patterns (see case_patterns).
import Case, Catch, Conditional, Expression, If, Statement, Try from '../ast'
import fail from './diagnostics'
import expect_condition, set_type from './expression'
import ends_with_jump, narrow, narrowings_of from './narrowing'
import Body from './shared'
import
  check_block, check_if, check_if_condition, define_local, is_never_typed, nothing
from './statement'
import std_interface from './interfaces'
import reject_unsatisfied from './satisfaction'
import Local from './scopes'
import resolve from './type_names'
import format_type, is_kind, members_of, never_type, ObjectType, Type, void_type from '../types'
import Branch, BranchValue, type_of_branches, unify_unless_void, unify_values from './branches'
import check_patterns from './case_patterns'

export type_of_case := (body: Body, case_expression: Case, expected: Type?) ->
  narrowings := check_patterns(body, case_expression)
  { arms } := case_expression
  arm_branch := (i: Int) ->
    Branch statements: arms[i].body, enter: -> narrow(body, narrowings.arms[i])
  branches := [arm_branch(i) for i in 0...arms.length]
  if otherwise := case_expression.otherwise
    branches.push { statements: otherwise, enter: -> narrow(body, narrowings.otherwise) }
  unify_arms := (values: BranchValue[]) -> unify_values(body, values, case_expression, 'case arms')
  type_of_branches body, branches, expected, unify_arms

export type_of_if := (body: Body, if_expression: If, expected: Type?): Type ->
  { then_body, else_body } := if_expression
  if else_body.is_empty()
    check_if body, if_expression
    return void_type
  entries := check_if_condition(body, if_expression)
  branches: Branch[] =
    { statements: then_body, enter: entries.enter_then }
    { statements: else_body, enter: entries.enter_else }
  # A `?.` is an if only after parsing, so its error names what the source has.
  nil_safe := "'?.', whose chain gives no value"
  description := if_expression.nil_safe then nil_safe else 'the branches of if'
  unify := unify_unless_void(body, if_expression, description)
  type_of_branches body, branches, expected, unify

# A case that is a statement gives no value: its arms are checked as statements, as a try's blocks
# are, so that their values need no type in common. It never ends if none of its arms does.
export check_case_statement := (body: Body, case_expression: Case) ->
  narrowings := check_patterns(body, case_expression)
  blocks: Statement[][] = [arm.body for arm in case_expression.arms]
  for arm, i in case_expression.arms
    check_block body, arm.body, -> narrow(body, narrowings.arms[i]), nothing
  if otherwise := case_expression.otherwise
    check_block body, otherwise, -> narrow(body, narrowings.otherwise), nothing
    blocks.push otherwise
  is_never := (expression: Expression) -> is_never_typed(body, expression)
  never_ends := blocks.all((block) -> ends_with_jump(block, is_never))
  body.facts.types[case_expression] = never_ends then never_type else void_type

# A try that is a statement gives no value: its blocks are checked as statements, as an if's
# branches are, so that the values they end with are discarded by the same rules.
export check_try_statement := (body: Body, try_expression: Try) ->
  { catches, finally_body } := try_expression
  check_block body, try_expression.body, nothing, nothing
  check_block body, clause.body, catch_entry(body, clause), nothing for clause in catches
  check_block body, finally_body, nothing, nothing if finally_body
  body.facts.types[try_expression] = void_type

export type_of_try := (body: Body, try_expression: Try, expected: Type?) ->
  branches := [Branch(statements: try_expression.body, enter: nothing)]
  for clause in try_expression.catches
    branches.push { statements: clause.body, enter: catch_entry(body, clause) }
  unify := unify_unless_void(body, try_expression, 'the values of try and catch')
  type := type_of_branches(body, branches, expected, unify)
  check_block body, finally_body, nothing, nothing if finally_body := try_expression.finally_body
  type

# What entering a catch does: it defines the name of the exception it takes.
catch_entry := (body: Body, clause: Catch) ->
  caught := caught_type(body, clause)
  -> define_local(body, Local(identifier: clause.name, type: caught))

caught_type := (body: Body, clause: Catch): Type ->
  error := std_interface(body.shared, 'Error', clause.position).type
  type_name := clause.type ? return error
  type := resolve(body.program, body.resolver, type_name)
  set_type body, type_name, type
  return type if type == error
  for member in members_of(type)
    unless member is ObjectType
      takes := 'a class or struct, or a union of them'
      message := "a catch takes #{takes}, not #{format_type(member)}"
      fail body.program, type_name.position, message
    reject_unsatisfied body, member, error, type_name.position
  type

# The condition narrows a local as `if` does: in the value for when it holds, or the other.
export type_of_conditional := (body: Body, conditional: Conditional, expected: Type?) ->
  expect_condition body, conditional.condition
  narrowings := narrowings_of(body, conditional.condition)
  then_body: Statement[] = [conditional.then_value]
  else_body: Statement[] = [conditional.else_value]
  branches: Branch[] =
    { statements: then_body, enter: -> narrow(body, narrowings.where_true) }
    { statements: else_body, enter: -> narrow(body, narrowings.where_false) }
  unify_then_else := (values: BranchValue[]) ->
    if valueless := values.find((value) -> is_kind(value.type, 'void'))
      message := 'then and else must give values; to run statements, write an if'
      fail body.program, valueless.last.position, message
    { without_else } := conditional
    description := without_else then 'then without else' else 'the values of then and else'
    unify_values body, values, conditional, description
  type_of_branches body, branches, expected, unify_then_else
