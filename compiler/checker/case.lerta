# Types `case` (its conditions or patterns, and the values of its arms) and `then`/`else`.
import
  Case, CaseArm, Catch, Conditional, Expression, Identifier, If, NamedType, NilLiteral, Statement,
  Try
from '../ast'
import fail from './diagnostics'
import expect_condition, expect_type, set_type, type_of, unnarrowed_type from './expression'
import narrowable from './narrowable'
import narrow, Narrowing, narrowings_of from './narrowing'
import Body, enum_value_of from './shared'
import
  check_block, check_if, check_if_condition, define_local, nothing, type_of_block
from './statement'
import std_interface from './interfaces'
import reject_unsatisfied from './satisfaction'
import Local from './scopes'
import has_type, resolve from './type_names'
import
  EnumType, format_enum_member, format_member, format_type, inner_of, INTEGER_KINDS, is_assignable,
  is_kind, is_one_of_kinds, members_of, ObjectType, other_members, optional_type, OptionalType,
  same_type, Type, type_key, TypeKind, unify, union_type, UnionType, void_type
from '../types'

const VALUE_KINDS: TypeKind[] = [INTEGER_KINDS..., 'Bool', 'String', ENUM]

# The body of a case arm, of then/else or of an if, and what entering it does: narrowing locals, or
# defining one.
struct Branch
  statements: Statement[]
  enter: () -> void

# The last statement of a branch, and the type of its value.
struct BranchValue
  last: Statement
  type: Type

export const type_of_case = (body: Body, case_expression: Case, expected: Type?) ->
  const narrowings = check_patterns(body, case_expression)
  const { arms } = case_expression
  const arm_branch = (i: Int) ->
    Branch statements: arms[i].body, enter: -> narrow(body, narrowings.arms[i])
  const branches = [arm_branch(i) for i in 0...arms.length]
  if const otherwise = case_expression.otherwise
    branches.push Branch(statements: otherwise, enter: -> narrow(body, narrowings.otherwise))
  const unify_arms = (values: BranchValue[]) ->
    unify_values body, values, case_expression, 'case arms'
  type_of_branches body, branches, expected, unify_arms

export const type_of_if = (body: Body, if_expression: If, expected: Type?): Type ->
  const { then_body, else_body } = if_expression
  if else_body.length == 0
    check_if body, if_expression
    return void_type
  const entries = check_if_condition(body, if_expression)
  const branches =
    Branch(statements: then_body, enter: entries.enter_then)
    Branch(statements: else_body, enter: entries.enter_else)
  # A `?.` is an if only after parsing, so its error names what the source has.
  const nil_safe = "'?.', whose chain gives no value"
  const description = if_expression.nil_safe then nil_safe else 'the branches of if'
  const unify = unify_unless_void(body, if_expression, description)
  type_of_branches body, branches, expected, unify

export const type_of_try = (body: Body, try_expression: Try, expected: Type?) ->
  const branches = [Branch(statements: try_expression.body, enter: nothing)]
  for clause in try_expression.catches
    const caught = caught_type(body, clause)
    const define = -> define_local(body, Local(identifier: clause.name, type: caught))
    branches.push Branch(statements: clause.body, enter: define)
  const unify = unify_unless_void(body, try_expression, 'the values of try and catch')
  const type = type_of_branches(body, branches, expected, unify)
  if const finally_body = try_expression.finally_body
    check_block body, finally_body, nothing, nothing
  type

const caught_type = (body: Body, clause: Catch): Type ->
  const error = std_interface(body.shared, 'Error', clause.position).type
  const type_name = clause.type ? return error
  const type = resolve(body.program, body.resolver, type_name)
  set_type body, type_name, type
  return type if same_type(type, error)
  for member in members_of(type)
    if member is not ObjectType
      const takes = 'a class or struct, or a union of them'
      const message = "a catch takes #{takes}, not #{format_type(member)}"
      fail body.program, type_name.position, message
    reject_unsatisfied body, member, error, type_name.position
  type

# A condition of a case without a subject is one of an `if`, which narrows locals in its arm.
const check_condition = (body: Body, condition: Expression) ->
  expect_condition body, condition
  narrowings_of(body, condition).where_true

# The condition narrows a local as `if` does: in the value for when it holds, or the other.
export const type_of_conditional = (body: Body, conditional: Conditional, expected: Type?) ->
  expect_condition body, conditional.condition
  const narrowings = narrowings_of(body, conditional.condition)
  const then_body: Statement[] = [conditional.then_value]
  const else_body: Statement[] = [conditional.else_value]
  const branches =
    Branch(statements: then_body, enter: -> narrow(body, narrowings.where_true))
    Branch(statements: else_body, enter: -> narrow(body, narrowings.where_false))
  const unify_then_else = (values: BranchValue[]) ->
    if const valueless = values.find((value) -> is_kind(value.type, 'void'))
      const message = 'then and else must give values; to run statements, write an if'
      fail body.program, valueless.last.position, message
    const { without_else } = conditional
    const description = without_else then 'then without else' else 'the values of then and else'
    unify_values body, values, conditional, description
  type_of_branches body, branches, expected, unify_then_else

# The type of the values the branches give: the expected type, or else the one that `unify_all`
# makes of them. Each value is typed as its branch is entered, which may narrow a local.
const type_of_branches = (
  body: Body, branches: Branch[], expected: Type?, unify_all: (BranchValue[]) -> Type
) ->
  # Each body is a block, which sees the locals its branch narrows.
  const type_of_body = (branch: Branch, type_of_last: (Expression) -> Type) ->
    type_of_block body, branch.statements, branch.enter, type_of_last
  if expected
    const check_value = (value: Expression) ->
      expect_type body, value, expected
      expected
    for branch in branches
      const type = type_of_body(branch, check_value)
      if is_kind(type, 'void')
        const message = "expected #{format_type(expected)}, got void"
        fail body.program, branch.statements.last()!.position, message
    return expected
  const type_of_value = (value: Expression) -> type_of(body, value)
  const value_of = (branch: Branch) ->
    BranchValue last: branch.statements.last()!, type: type_of_body(branch, type_of_value)
  unify_all [value_of(branch) for branch in branches]

# Unifies the values of branches, as unify_values does. Statements give no value, so neither do
# branches with one among them.
const unify_unless_void = (body: Body, at: Expression, description: String) ->
  (values: BranchValue[]) ->
    return void_type if values.any((value) -> is_kind(value.type, 'void'))
    unify_values body, values, at, description

# The values, the last statements of the bodies, are converted to the type they unify to.
const unify_values = (body: Body, values: BranchValue[], at: Expression, description: String) ->
  var type = values[0].type
  for value in values
    const mismatch = ->
      const types = "expected #{format_type(type)}, got #{format_type(value.type)}"
      fail body.program, value.last.position, "#{description} must have the same type: #{types}"
    type = unify(type, value.type) ? mismatch()
  if is_kind(type, 'nil')
    const message = "nil alone does not give the type of #{description}; write it in an annotation"
    fail body.program, at.position, message
  for value in values
    const is_converted = not is_kind(value.type, 'never') and not same_type(value.type, type)
    body.facts.conversions[value.last] = type if is_converted and value.last is Expression
  type

# How the subject is narrowed in each arm, and in the else arm.
struct CaseNarrowings
  arms: Narrowing[][]
  otherwise: Narrowing[]

# Checks the conditions or patterns, and returns how they narrow.
const check_patterns = (body: Body, case_expression: Case): CaseNarrowings ->
  const { arms } = case_expression
  const subject = case_expression.subject
  if subject == nil
    const conditions = [check_condition(body, arm.patterns[0]) for arm in arms]
    return CaseNarrowings(arms: conditions, otherwise: [])
  const subject_type = type_of(body, subject)
  const is_optional = subject_type is OptionalType
  const is_nil_arm = (arm: CaseArm) -> is_optional and arm.patterns.any(is_nil_pattern)
  const unhandled_nil = is_optional and not check_nil_arms(body, arms)
  const missing: String[] = unhandled_nil then ['nil'] else []
  const type = inner_of(subject_type)
  # As `is` does, the patterns take the members of the type that the subject was declared with.
  const declared = inner_of(unnarrowed_type(body, subject, subject_type))
  if declared is UnionType
    return check_type_patterns(body, case_expression, is_nil_arm, subject, declared, type, missing)
  if not is_one_of_kinds(type, VALUE_KINDS)
    const message = "cannot branch on a value of type #{format_type(subject_type)}"
    fail body.program, subject.position, message
  const value_patterns = [arm.patterns for arm in arms when not is_nil_arm(arm)]
  for patterns in value_patterns
    expect_type body, pattern, type for pattern in patterns
  if type is EnumType
    check_member_patterns body, case_expression, type, missing
  else if case_expression.otherwise == nil
    fail body.program, case_expression.position, 'a case on values needs an else arm'
  const no_narrowings: Narrowing[] = []
  const narrowed = is_optional then subject_narrowings(body, subject, type) else no_narrowings
  const arm_narrowings = [is_nil_arm(arm) then no_narrowings else narrowed for arm in arms]
  CaseNarrowings arms: arm_narrowings, otherwise: unhandled_nil then no_narrowings else narrowed

const is_nil_pattern = (pattern: Expression) -> pattern is NilLiteral

const check_nil_arms = (body: Body, arms: CaseArm[]) ->
  var handled = false
  for arm in arms
    for pattern in arm.patterns
      continue if not is_nil_pattern(pattern)
      if arm.patterns.length > 1
        fail body.program, pattern.position, 'nil must be the only pattern of its arm'
      fail_handled_twice body, pattern, 'nil' if handled
      type_of body, pattern
      handled = true
  handled

const check_type_patterns = (
  body: Body, case_expression: Case, is_nil_arm: (CaseArm) -> Bool, subject: Expression,
  union: UnionType, narrowed: Type, missing_nil: String[]
) ->
  const handled = Set<String>()
  const arm_narrowings: Narrowing[][] = []
  for arm in case_expression.arms
    if is_nil_arm(arm)
      arm_narrowings.push []
      continue
    const types = [type_pattern(body, pattern, union) for pattern in arm.patterns]
    for (pattern_type, pattern) in types.zip(arm.patterns)
      for member in members_of(pattern_type)
        const key = type_key(member)
        fail_handled_twice body, pattern, format_member(member, union) if handled.has(key)
        handled.add key
    arm_narrowings.push types.length == 1 then subject_narrowings(body, subject, types[0]) else []
  const is_unhandled = (member: Type) -> not handled.has(type_key(member))
  const unhandled_members = members_of(narrowed).filter(is_unhandled)
  const missing = [format_member(member, union) for member in unhandled_members]
  fail_unhandled body, case_expression, [missing..., missing_nil...]
  # Where nil is handled, the else arm does not see it.
  const unhandled = missing_nil.length > 0 then optional_type(narrowed) else narrowed
  const handled_members = [member for member in union.members when handled.has(type_key(member))]
  const others = other_members(unhandled, union_type(handled_members))
  const otherwise: Narrowing[] = others then subject_narrowings(body, subject, others) else []
  CaseNarrowings otherwise, arms: arm_narrowings

const check_member_patterns = (
  body: Body, case_expression: Case, type: EnumType, missing_nil: String[]
) ->
  const handled = Set<Int>()
  for arm in case_expression.arms
    for pattern in arm.patterns
      const index = enum_value_of(body.facts, pattern) ? continue
      if handled.has(index)
        fail_handled_twice body, pattern, format_enum_member(type.members[index])
      handled.add index
  const members = type.members
  const missing = [format_enum_member(member) for member, i in members when not handled.has(i)]
  fail_unhandled body, case_expression, [missing..., missing_nil...]

const fail_handled_twice = (body: Body, pattern: Expression, handled: String) ->
  fail body.program, pattern.position, "#{handled} is already handled by an earlier arm"

# Without an else arm, a case must handle each of the `missing`.
const fail_unhandled = (body: Body, case_expression: Case, missing: String[]) ->
  return if case_expression.otherwise != nil or missing.length == 0
  const message = "case does not handle #{missing.join(', ')}; add them or an else arm"
  fail body.program, case_expression.position, message

# The pattern's type, recorded on the pattern for codegen: a member of the union, or a union of some
# of its members, which a type alias names.
const type_pattern = (body: Body, pattern: Expression, union: UnionType) ->
  const fail_pattern = ->
    const types = "the types #{format_type(union)} or a union of them"
    fail body.program, pattern.position, "expected one of #{types}"
  const { program, resolver } = body
  const name = pattern is Identifier then pattern.name else fail_pattern()
  fail_pattern() if not has_type(program, resolver, name)
  const type_name = NamedType(name, args: [], position: pattern.position)
  const type = resolve(program, resolver, type_name)
  fail_pattern() if not is_assignable(type, union) or is_kind(type, 'never')
  set_type body, pattern, type

const subject_narrowings = (body: Body, subject: Expression, type: Type): Narrowing[] ->
  const value = narrowable(body, subject) ? return []
  [Narrowing(type, subject: value.subject)]
