# The methods that the compiler gives the builtin types (see
# docs/internals.md#builtins).
import
  ArrayType, bool_type, EnumType, float_type, FunctionType, is_integer, is_one_of_kinds, is_set,
  IterType, MapType, SimpleType, string_type, TupleType, Type, TypeKind, void_type
from '../types'

# The builtin methods, which the checker resolves a name to once, so that codegen generates each
# by a `case` that names them all. A set's `remove` is a map's, as a set is a map.
export enum BuiltinMember
  ARRAY_PUSH
  ARRAY_POP
  ARRAY_TO_STRING
  MAP_REMOVE
  MAP_KEYS
  MAP_ENTRIES
  SET_HAS
  SET_ADD
  SET_ITER
  ITER_HAS_NEXT
  ITER_NEXT
  ENUM_TO_STRING
  WRAPPING_ADD
  WRAPPING_SUB
  WRAPPING_MUL
  INTEGER_TO_STRING
  INTEGER_TO_FLOAT
  # A conversion to the integer type that the method's type gives (see integer_method).
  INTEGER_CONVERSION

# The source of a builtin method (see methods' MethodSource): its member and its type.
export struct BuiltinMethod(member: BuiltinMember, type: Type)

const method = (member: BuiltinMember, params: Type[], result: Type) ->
  BuiltinMethod member, type: FunctionType(params, result)

# The method of a generic builtin type, an enum or an integer type by the name, if it has one: an
# enum's to_string gives the member's text.
export const builtin_method = (receiver: Type, name: String) ->
  case receiver
    when ArrayType then array_method(receiver.element, name)
    when MapType then map_method(receiver, name)
    when IterType then iter_method(receiver.item, name)
    when EnumType then name == 'to_string' then method(ENUM_TO_STRING, [], string_type)
    else is_integer(receiver) then integer_method(receiver, name)

# `x.wrapping_add(y)` and so on, which wrap around where the operators throw; the conversions to
# the integer types and to Float; and to_string.
const integer_method = (receiver: Type, name: String) ->
  const wrapping: BuiltinMember? =
    case name
      when 'wrapping_add' then WRAPPING_ADD
      when 'wrapping_sub' then WRAPPING_SUB
      when 'wrapping_mul' then WRAPPING_MUL
      else nil
  return method(wrapping, [receiver], receiver) if wrapping
  return method(INTEGER_TO_STRING, [], string_type) if name == 'to_string'
  return method(INTEGER_TO_FLOAT, [], float_type) if name == 'to_float'
  const kind = CONVERSIONS[name] ? return nil
  method INTEGER_CONVERSION, [], SimpleType(kind)

# The integer types that `to_int`, `to_byte`, `to_int8` and so on convert to.
const CONVERSIONS: Map<String, TypeKind> =
  'to_int': 'Int', 'to_byte': 'Byte', 'to_int8': 'Int8', 'to_int16': 'Int16', 'to_int32': 'Int32',
  'to_uint16': 'UInt16', 'to_uint32': 'UInt32', 'to_uint64': 'UInt64'

# Whether the builtin method keeps its argument, as an array's `push` does, which a cycle can go
# through (see cycles).
export const keeps_argument = (member: BuiltinMember) -> member == ARRAY_PUSH

const array_method = (element: Type, name: String) ->
  case name
    when 'push' then method(ARRAY_PUSH, [element], void_type)
    when 'pop' then method(ARRAY_POP, [], element)
    when 'to_string' then is_text_item(element) then method(ARRAY_TO_STRING, [], string_type)
    else nil

# An item type that the text of an array can show, as the compiler knows how to write it (see
# codegen array_text); arrays of other items are Stringable only through an extend.
const is_text_item = (item: Type): Bool ->
  return is_text_item(item.element) if item is ArrayType
  is_integer(item) or is_one_of_kinds(item, ['String', 'Float', 'Bool', ENUM])

const iter_method = (item: Type, name: String) ->
  case name
    when 'has_next' then method(ITER_HAS_NEXT, [], bool_type)
    when 'next' then method(ITER_NEXT, [], item)
    else nil

const map_method = (map: MapType, name: String) ->
  const { key, value } = map
  return set_method(key, name) if is_set(map)
  case name
    when 'remove' then method(MAP_REMOVE, [key], void_type)
    when 'keys' then method(MAP_KEYS, [], ArrayType(element: key))
    when 'entries' then method(MAP_ENTRIES, [], IterType(item: TupleType(items: [key, value])))
    else nil

const set_method = (item: Type, name: String) ->
  case name
    when 'has' then method(SET_HAS, [item], bool_type)
    when 'add' then method(SET_ADD, [item], void_type)
    when 'remove' then method(MAP_REMOVE, [item], void_type)
    when 'iter' then method(SET_ITER, [], IterType(item))
    else nil
