# The methods that the compiler gives the builtin types (see
# docs/internals.md#builtins).
import is_equatable, is_hashable from './equality'
import builtins_declarer from './imports'
import info_of from './object_types'
import operand_kinds, operator_of_method, SIGNED_KINDS from './operator'
import ProgramWide from './shared'
import
  ArrayType, bool_type, EnumType, float32_type, float_type, FunctionType, int_type, integer_bits,
  is_integer, is_kind, is_one_of_kinds, is_set, is_signed, IterType, MapType, NUMBER_KINDS,
  ObjectType, optional_type, OptionalType, PromiseType, SimpleType, string_type, TupleType, Type,
  TypeKind, void_type
from '../types'

# The builtin methods, which the checker resolves a name to once, so that codegen generates each
# by a `case` that names them all. A set's `remove` is a map's, as a set is a map.
export enum BuiltinMember
  ARRAY_PUSH
  ARRAY_POP
  MAP_REMOVE
  MAP_KEYS
  MAP_ENTRIES
  SET_CONTAINS
  SET_ADD
  SET_ITER
  ITER_HAS_NEXT
  ITER_NEXT
  ENUM_TO_STRING
  ENUM_TO_LITERAL
  WRAPPING_ADD
  WRAPPING_SUB
  WRAPPING_MUL
  # `equals` and `hash` of the types that `==` compares and that can be map keys, but by a method
  # of their own (see Equatable and Hashable).
  EQUALS
  HASH
  NUMBER_COMPARE
  INTEGER_TO_FLOAT
  # A Float's to_float32 and a Float32's to_float.
  FLOAT_CONVERSION
  # A conversion to the integer type that the method's type gives (see integer_method).
  INTEGER_CONVERSION
  # The method that an operator calls, which applies it (see operator_method).
  OPERATOR
  PROMISE_CANCEL

# The source of a builtin method (see methods' MethodSource): its member and its type.
export struct BuiltinMethod
  member: BuiltinMember
  type: Type

method := (member: BuiltinMember, params: Type[], result: Type) ->
  BuiltinMethod member, type: FunctionType(params, result)

# The method of a generic builtin type, an enum or an integer type by the name, if it has one: an
# enum's to_string gives the member's text, and its to_literal the member as declared.
export builtin_method := (program: ProgramWide, receiver: Type, name: String) ->
  return equality_method(program, receiver, name) if name == 'equals' or name == 'hash'
  return value_method(program, receiver, name) if is_value_type(receiver)
  case receiver
    when ArrayType then array_method(receiver.element, name)
    when MapType then map_method(receiver, name)
    when IterType then iter_method(receiver.item, name)
    when PromiseType then name == 'cancel' then method(PROMISE_CANCEL, [], void_type)
    else nil

# Whether the type's values are numbers, Chars, Bools, texts, Binaries or members of enums; numbers
# and Chars order by their builtin compare (see Comparable).
is_value_type := (type: Type) ->
  kinds: TypeKind[] = [NUMBER_KINDS..., 'Char', 'Bool', 'String', 'Binary']
  type is EnumType or is_one_of_kinds(type, kinds)

# The equals of a type that `==` compares, but by an equals of its own, and the hash of one that
# can be a map key, but by a hash of its own; a compare of its own gives its equals.
equality_method := (program: ProgramWide, receiver: Type, name: String): BuiltinMethod? ->
  return nil if receiver is ObjectType and info_of(program, receiver).methods.contains(name)
  if name == 'equals'
    return is_equatable(program, receiver, nil) then method(EQUALS, [receiver], bool_type)
  is_key := receiver is not OptionalType and is_hashable(program, receiver, nil)
  is_key then method(HASH, [], int_type)

value_method := (program: ProgramWide, receiver: Type, name: String) ->
  case name
    when 'compare'
      return nil unless is_one_of_kinds(receiver, [NUMBER_KINDS..., 'Char'])
      method NUMBER_COMPARE, [receiver], ordering_type(program)
    else
      if receiver is EnumType
        return method(ENUM_TO_STRING, [], string_type) if name == 'to_string'
        return method(ENUM_TO_LITERAL, [], string_type) if name == 'to_literal'
      return operator if operator := operator_method(receiver, name)
      return char_method(name) if is_kind(receiver, 'Char')
      return conversion if conversion := float_conversion(receiver, name)
      is_integer(receiver) then integer_method(receiver, name)

# The method that an operator calls, `add` for `+` and so on, of a type that the operator applies
# to, which applies it: the numbers', and String's and Binary's add.
operator_method := (receiver: Type, name: String) ->
  if name == 'neg'
    return is_one_of_kinds(receiver, SIGNED_KINDS) then method(OPERATOR, [], receiver)
  operator := operator_of_method(name) ? return nil
  is_one_of_kinds(receiver, operand_kinds(operator)) then method(OPERATOR, [receiver], receiver)

# The enum that compare gives, of std:builtins.
export ordering_type := (program: ProgramWide) ->
  builtins_declarer(program, 'Ordering').enums['Ordering']!

# `x.wrapping_add(y)` and so on, which wrap around where the operators throw; the conversions to
# the integer types and to Float.
integer_method := (receiver: Type, name: String) ->
  wrapping: BuiltinMember? =
    case name
      when 'wrapping_add' then WRAPPING_ADD
      when 'wrapping_sub' then WRAPPING_SUB
      when 'wrapping_mul' then WRAPPING_MUL
      else nil
  return method(wrapping, [receiver], receiver) if wrapping
  return method(INTEGER_TO_FLOAT, [], float_type) if name == 'to_float'
  kind := CONVERSIONS[name] ? return nil
  target := SimpleType(kind)
  method INTEGER_CONVERSION, [], holds_all(target, receiver) then target else optional_type(target)

# A Float's `to_float32`, the nearest Float32, an infinity beyond the largest, and a Float32's
# `to_float`, the same value.
float_conversion := (receiver: Type, name: String) ->
  case
    when is_kind(receiver, 'Float') and name == 'to_float32'
      method FLOAT_CONVERSION, [], float32_type
    when is_kind(receiver, 'Float32') and name == 'to_float'
      method FLOAT_CONVERSION, [], float_type
    else nil

# Whether every value of the integer type `from` is one of `to`, which converting to it gives,
# where it gives nil for a value that it does not hold: a type of no fewer bits and of no other
# sign, or an unsigned type into a signed one of more bits; and only Bytes are all Chars, the
# numbers below the surrogates.
holds_all := (to: Type, from: Type) ->
  return is_kind(from, 'Byte') if is_kind(to, 'Char')
  wider := integer_bits(to) > integer_bits(from)
  as_wide := integer_bits(to) >= integer_bits(from)
  is_signed(from) == is_signed(to) then as_wide else not is_signed(from) and wider

# The types that `to_int`, `to_byte`, `to_int8` and so on convert to: the integer types, and Char.
CONVERSIONS: Map<String, TypeKind> =
  'to_int': 'Int', 'to_byte': 'Byte', 'to_int8': 'Int8', 'to_int16': 'Int16', 'to_int32': 'Int32',
  'to_uint16': 'UInt16', 'to_uint32': 'UInt32', 'to_uint64': 'UInt64', 'to_char': 'Char'

# A Char's number, which every Char has, as an Int.
char_method := (name: String) -> name == 'to_int' then method(INTEGER_CONVERSION, [], int_type)

# Whether the builtin method keeps its argument, as an array's `push` does, which a cycle can go
# through (see cycles).
export keeps_argument := (member: BuiltinMember) -> member == ARRAY_PUSH

array_method := (element: Type, name: String) ->
  case name
    when 'push' then method(ARRAY_PUSH, [element], void_type)
    when 'pop' then method(ARRAY_POP, [], element)
    else nil

iter_method := (item: Type, name: String) ->
  case name
    when 'has_next' then method(ITER_HAS_NEXT, [], bool_type)
    when 'next' then method(ITER_NEXT, [], item)
    else nil

map_method := (map: MapType, name: String) ->
  { key, value } := map
  return set_method(key, name) if is_set(map)
  case name
    when 'remove' then method(MAP_REMOVE, [key], void_type)
    when 'keys' then method(MAP_KEYS, [], IterType(key))
    when 'entries' then method(MAP_ENTRIES, [], IterType(TupleType([key, value])))
    else nil

set_method := (item: Type, name: String) ->
  case name
    when 'contains' then method(SET_CONTAINS, [item], bool_type)
    when 'add' then method(SET_ADD, [item], bool_type)
    when 'remove' then method(MAP_REMOVE, [item], void_type)
    when 'iter' then method(SET_ITER, [], IterType(item))
    else nil
