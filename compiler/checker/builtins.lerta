# The methods and properties that the compiler gives the builtin types (see
# docs/internals.md#builtins).
import
  ArrayType, binary_type, bool_type, EnumType, FunctionType, int_type, is_kind, is_one_of_kinds,
  is_set, IterType, MapType, string_type, TupleType, Type, void_type
from '../types'

const method = (params: Type[], result: Type) -> FunctionType(params, result)

# The type of a method of a generic builtin type or an enum, if it has one: an enum's to_string
# gives the member's text.
export const builtin_method = (receiver: Type, name: String): Type? ->
  case receiver
    when ArrayType then array_method(receiver.element, name)
    when MapType then map_method(receiver, name)
    when IterType then iter_method(receiver.item, name)
    when EnumType then name == 'to_string' then method([], string_type)
    else nil

# Whether the builtin method keeps its argument, as an array's `push` does, which a cycle can go
# through (see cycles).
export const keeps_argument = (receiver: Type, name: String) ->
  receiver is ArrayType and name == 'push'

const array_method = (element: Type, name: String): Type? ->
  case name
    when 'push' then method([element], void_type)
    when 'pop' then method([], element)
    when 'to_string' then is_text_item(element) then method([], string_type)
    else nil

# An item type that the text of an array can show, as the compiler knows how to write it (see
# codegen array_text); arrays of other items are Stringable only through an extend.
const is_text_item = (item: Type): Bool ->
  return is_text_item(item.element) if item is ArrayType
  is_one_of_kinds item, ['String', 'Int', 'Float', 'Bool', 'Byte', ENUM]

const iter_method = (item: Type, name: String): Type? ->
  case name
    when 'has_next' then method([], bool_type)
    when 'next' then method([], item)
    else nil

const map_method = (map: MapType, name: String): Type? ->
  const { key, value } = map
  return set_method(key, name) if is_set(map)
  case name
    when 'remove' then method([key], void_type)
    when 'keys' then method([], ArrayType(element: key))
    when 'entries' then method([], IterType(item: TupleType(items: [key, value])))
    else nil

const set_method = (item: Type, name: String): Type? ->
  case name
    when 'has' then method([item], bool_type)
    when 'add', 'remove' then method([item], void_type)
    when 'iter' then method([], IterType(item))
    else nil

# The type of a property of a builtin type, read without a call, if it has one.
export const builtin_property = (receiver: Type, name: String) ->
  return int_type if name == 'length' and is_one_of_kinds(receiver, [ARRAY, MAP, 'Binary'])
  return binary_type if name == 'binary' and is_kind(receiver, 'String')
  nil
