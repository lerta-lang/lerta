# What an editor's completion asks of the checker (see compiler/lsp/complete.lerta): it checks the
# text with a name of its own, COMPLETION_NAME, where a name is being written, and the checker
# records, where it meets that name, the locals that the code there sees, or the type of the object
# whose member it is.
import Extensions from './extensions'
import Body, ProgramWide from './shared'
import EnumType, Type from '../types'

# No name of a program, which a program could write though: it then gives the completion's view.
export COMPLETION_NAME := '__lerta_completion__'

# The locals that the code at the name sees, by their names, the innermost of a name, and the
# extends in effect there; and of `object.NAME`, the type of the object, or the module or the enum
# that the object names.
export struct CompletionProbe
  locals: Map<String, Type>
  extensions: Extensions
  object: Type?
  module_index: Int?
  enum_type: EnumType?
  # Whether the name is in the module's top-level code, which sees the top-level values that it
  # has declared, rather than in a function, which sees them all.
  in_top_level := default false

# Records the locals that the body sees where it meets the name.
export probe_locals := (body: Body) ->
  locals: Map<String, Type>
  var each: Body? = body
  while { scopes, enclosing } := each
    for scope in scopes.scopes.reversed()
      for (name, local) in scope.locals
        locals[name] = local.type unless name in locals
    each = enclosing
  in_top_level := not body.sees_top_level and body.enclosing == nil
  set_probe body.program, { locals, in_top_level, extensions: body.extensions }

# Records the type of the object whose member the name is.
export probe_member := (body: Body, object: Type) ->
  set_probe body.program, { object, locals: Map(), extensions: body.extensions }

# Records the module, imported as a name, whose export the name is.
export probe_module := (body: Body, module_index: Int) ->
  set_probe body.program, { module_index, locals: Map(), extensions: body.extensions }

# Records the enum whose member the name is.
export probe_enum := (body: Body, enum_type: EnumType) ->
  set_probe body.program, { enum_type, locals: Map(), extensions: body.extensions }

set_probe := (program: ProgramWide, probe: CompletionProbe) ->
  program.completion = probe if program.completion == nil
