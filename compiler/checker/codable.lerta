# The types that the compiler converts by their parts, which satisfy Codable, and the calls of the
# code that it generates for each (see codegen/codable).
import Call, Identifier, Position from '../ast'
import fail from './diagnostics'
import type_of from './expression'
import record_reference from './name'
import CodableConversion, CodableDirection from './references'
import Body, ProgramWide, Shared from './shared'
import resolve from './type_names'
import field_type, info_of from './object_types'
import
  ArrayType, EnumType, format_type, InterfaceType, is_kind, is_number, is_one_of_kinds, is_set,
  MapType, NUMBER_KINDS, ObjectType, OptionalType, RecordType, TupleType, Type, type_key, TypeKind,
  TypeParameterType, UnionType, void_type
from '../types'

CODABLE_MODULE := 'std:codable'

export is_codable_bound := (program: ProgramWide, bound: InterfaceType) ->
  is_declared_by := (shared: Shared) ->
    shared.name == bound.module and is_codable_declaration(shared, bound.name)
  program.shared.any(is_declared_by)

# Whether the interface of the name, declared in the module, is std:codable's Codable.
export is_codable_declaration := (shared: Shared, name: String) ->
  is_codable_module(shared) and name == 'Codable'

# std:codable, also when it is the entry module, as when it is built on its own.
is_codable_module := (shared: Shared) ->
  is_entry := shared.path == nil and shared.program.entry_path == CODABLE_MODULE
  shared.name == CODABLE_MODULE or is_entry

# Rejects a type that has a part that is not data, naming the part by its path, as JsonError does
# in std:json: `$[]` is an item of an array, `$.*` a value of a map, and `$[0]` and `$.name` an item
# of a tuple and a field.
export reject_uncodable := (body: Body, type: Type, at: Position) ->
  { program } := body
  finder := PartFinder(program, at, bounds: body.resolver.bounds)
  part := finder.uncodable_part(type, '$') ? return
  where := part.path == '$' then 'it' else part.path
  reason := "#{where} #{part.problem}"
  fail program, at, "#{format_type(type)} does not satisfy Codable: #{reason}"

# A part of a type, by its path from it, and why it is not data.
struct Part
  path: String
  problem: String

unconverted := (path: String, problem: String) ->
  Part(path, problem: "#{problem}, which is not data")

class PartFinder
  program: ProgramWide
  at: Position
  # Those of the type parameters that stand for themselves, which Codable may bound.
  bounds: Map<String, InterfaceType>
  # The classes and structs whose parts are being looked through, which a part of them that is
  # of their own type does not look through again.
  private visited := Set<String>()

  private uncodable_part := (type: Type, path: String): Part? ->
    case
      when is_one_of_kinds(type, SCALAR_KINDS) or type is EnumType then nil
      when type is OptionalType then @uncodable_part(type.inner, path)
      when type is ArrayType then @uncodable_part(type.element, "#{path}[]")
      when type is TupleType then @first_part([(item, "#{path}[#{i}]") for item at i in type.items])
      when type is RecordType
        @first_part([(field.type, "#{path}.#{field.name}") for field in type.fields])
      when is_set(type) then @uncodable_part((type as MapType!).key, "#{path}[]")
      when type is MapType and is_kind(type.key, 'String')
        @uncodable_part(type.value, "#{path}.*")
      when type is MapType
        return part if part := @uncodable_part(type.key, "#{path}[][0]")
        @uncodable_part(type.value, "#{path}[][1]")
      when type is ObjectType then @object_part(type, path)
      when type is UnionType then @union_part(type, path)
      when type is TypeParameterType and @is_codable_parameter(type) then nil
      else unconverted(path, "is of type #{format_type(type)}")

  private is_codable_parameter := (type: TypeParameterType) ->
    bound := @bounds[type.name]
    type.standing and bound != nil and is_codable_bound(@program, bound)

  private first_part := (parts: (Type, String)[]): Part? ->
    for (type, path) in parts
      return part if part := @uncodable_part(type, path)
    nil

  # The members, which decoding tells apart by their kinds.
  private union_part := (type: UnionType, path: String): Part? ->
    members_by_kind: Map<Int, Type>
    for member in type.members
      return part if part := @uncodable_part(member, path)
      no_union := "has a member of type #{format_type(member)}, which no union holds so far"
      kind := codable_kind(member) ? return { path, problem: no_union }
      if other := members_by_kind[kind]
        both := "#{format_type(other)} and #{format_type(member)}"
        problem := "has two members that are #{KIND_WORDS[kind]}, #{both}"
        return { path, problem: "#{problem}, which decoding could not tell apart" }
      members_by_kind[kind] = member
    nil

  private object_part := (type: ObjectType, path: String): Part? ->
    key := type_key(type)
    return nil unless @visited.add(key)
    info := info_of(@program, type)
    for field in info.fields
      field_path := "#{path}.#{field.name.name}"
      # The state of its methods, not data, which a decoded object would take as it is written.
      return { path: field_path, problem: 'is private' } if field.name.name in info.private_names
      return unconverted(field_path, 'is weak') if field.weak
      return part if part := @uncodable_part(field_type(@program, info, field, @at), field_path)
    nil

# The kind of a member of a union, as a KIND_ number of std:codable, which a Decoder's peek_kind
# gives for its value; nil for an array, a map, a tuple or an anonymous struct, which decoding does
# not tell apart so far.
export codable_kind := (member: Type) ->
  case
    when is_kind(member, 'Bool') then 0
    when is_number(member) then 1
    when is_one_of_kinds(member, ['String', 'Binary', 'Char']) or member is EnumType then 2
    when member is ObjectType then 3
    else nil

# The kinds as messages write them, by their numbers.
KIND_WORDS := ['Bool values', 'numbers', 'text', 'classes or structs']

SCALAR_KINDS: TypeKind[] = [NUMBER_KINDS..., 'Bool', 'String', 'Binary', 'Char']

# `encode_value(encoder, value)` writes the value, of a Codable type, and `decode_value<T>(decoder)`
# reads a T. The encoder or decoder is of a class or struct, whose methods the generated code calls.
export type_of_codable_call := (body: Body, call: Call, direction: CodableDirection) ->
  program := body.program
  callee := call.callee as Identifier!
  encodes := direction == ENCODE
  arity := encodes then 2 else 1
  if call.args.length != arity or not call.named_args.is_empty()
    fail program, call.position, "#{callee.name} takes #{arity} arguments"
  arg_types := [type_of(body, arg) for arg in call.args]
  coder := arg_types[0]
  unless coder is ObjectType | TypeParameterType
    expected := encodes then 'an Encoder' else 'a Decoder'
    fail program, call.args[0].position, "#{callee.name} takes #{expected} first"
  type :=
    if encodes
      arg_types[1]
    else
      written := call.type_args.first() ? fail(program, call.position, "#{callee.name}<T> needs T")
      resolve program, body.resolver, written
  reject_uncodable body, type, call.position
  record_reference body, callee, CodableConversion(type, direction)
  encodes then void_type else type
