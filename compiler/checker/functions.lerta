# Top-level functions and the methods of classes, structs and extends. As they can be used before
# their declaration, a body is checked on demand: when its return type is first needed, or at the
# end. A generic function's are checked per instance (see
# GenericFunction).
import
  BooleanLiteral, Expression, FloatLiteral, FunctionLiteral, Identifier, IntegerLiteral, NamedType,
  Position, StringLiteral
from '../ast'
import check_function from './bodies'
import abort_part, check_part, fail, fail_already_defined from './diagnostics'
import GenericFunction, GenericRef from './generics'
import ProgramWide, Shared from './shared'
import module_resolver, resolve, resolve_result, Resolver from './type_names'
import
  ArrayType, bool_type, float_type, FunctionType, int_type, ObjectType, string_type, Type
from '../types'

# Where the checking of a function or a type is, so that a cycle is found when it reaches one
# that is still being checked.
export enum CheckState
  UNCHECKED
  CHECKING
  CHECKED
  # Checked with an error, so that what needs it cannot be checked either (see abort_part).
  FAILED

export class FunctionEntry
  name: Identifier
  literal: FunctionLiteral
  # Known from the annotations, or once the body is checked when the return type is inferred.
  type: Type?
  # The type of a method's object, a class or struct or an extended type, which its body sees as
  # `@`.
  this_type: Type?
  # Whether the type is the one its declaration writes, `f: (Int) -> Int = (n) -> n`, which the
  # literal is checked as, as a local's literal is checked as the type expected.
  is_declared = default false
  state: CheckState = UNCHECKED

export class Functions
  # A method is keyed by its type and name, as `Point.length` (see method_key).
  entries: Map<String, FunctionEntry> = Map()
  # The generic functions, by name, as their places in the module's generics (see Shared).
  generics: Map<String, Int> = Map()

# The written types of the parameters; `expected`, the types a function type expects, where they
# are known, stands in for those left out (the caller checks that there are as many).
export parameter_types := (
  program: ProgramWide
  resolver: Resolver
  literal: FunctionLiteral
  expected: Type?[] = []
) ->
  types: Type[]
  for param, i in literal.params
    expected_type := i < expected.length then expected[i]
    unwritten := expected_type then expected_type else literal_type(param.default)
    if type_name := param.type
      type := resolve(program, resolver, type_name)
      inferable := type == unwritten
      inferable_before := program.inferable_parameters[param.name] ? true
      program.inferable_parameters[param.name] = inferable and inferable_before
      types.push param.variadic then ArrayType(element: type) else type
      continue
    { name, position } := param.name
    message := "the type of the parameter '#{name}' must be written"
    types.push unwritten ? fail(program, position, message)
  last_is_struct := ends_with_struct(resolver, literal, types)
  reject_misplaced_variadic program, literal, last_is_struct
  reject_struct_default program, literal, last_is_struct
  types

# Whether the type is a struct, which a last parameter of the type lets a call construct from its
# named arguments, or leave out, constructing it from none (see gathered_argument).
export is_struct_type := (type: Type?) -> type is ObjectType and type.is_struct

# Whether the last parameter is of a struct type as declared, not through a type parameter that an
# instance binds to a struct, so that every instance of a generic function agrees.
ends_with_struct := (resolver: Resolver, literal: FunctionLiteral, types: Type[]) ->
  written := literal.params.last()?.type ? return false
  is_type_parameter := written is NamedType and resolver.type_parameters.has(written.name)
  not is_type_parameter and is_struct_type(types.last())

# A variadic parameter comes last, or before a last parameter of a struct type, which named
# arguments alone then give, and its function has no defaults, so that the arguments that it takes
# are those after the others.
reject_misplaced_variadic := (
  program: ProgramWide, literal: FunctionLiteral, last_is_struct: Bool
) ->
  params := literal.params
  found := params.find_index((param) -> param.variadic) ? return
  name := params[found].name
  last := params.length - 1
  is_placed := found == last or (found == last - 1 and last_is_struct)
  if not is_placed
    before_struct := 'or only before a last parameter of a struct type'
    fail program, name.position, "a variadic parameter must be the last, #{before_struct}"
  if param := params.find((each) -> each.default != nil)
    fail program, param.default!.position, 'a variadic function cannot have defaults so far'

# A last parameter of a struct type has no default, as a call that leaves it out constructs it, and
# neither do the others so far: a call would have to construct it at its place after the defaults.
reject_struct_default := (program: ProgramWide, literal: FunctionLiteral, last_is_struct: Bool) ->
  return if not last_is_struct
  param := literal.params.find((each) -> each.default != nil) ? return
  value := param.default!
  if param == literal.params.last()
    reason := 'a call that leaves it out constructs it'
    fail program, value.position, "a last parameter of a struct type has no default; #{reason}"
  message := 'a function with a last parameter of a struct type has no defaults so far'
  fail program, value.position, message

# The type of a default that is a literal of one type alone.
literal_type := (value: Expression?): Type? ->
  case value
    when IntegerLiteral then int_type
    when FloatLiteral then float_type
    when StringLiteral then string_type
    when BooleanLiteral then bool_type
    else nil

# The number of parameters that a call must give: those before the first with a default.
export required_params := (literal: FunctionLiteral) ->
  literal.params.find_index((param) -> param.default != nil) ? literal.params.length

# The function's type, if its return type is written; otherwise only its body tells.
export annotated_type := (
  program: ProgramWide, resolver: Resolver, literal: FunctionLiteral
): Type? ->
  return_type := literal.return_type ? return nil
  params := parameter_types(program, resolver, literal)
  FunctionType params, result: resolve_result(program, resolver, return_type)

export reject_generic := (program: ProgramWide, literal: FunctionLiteral) ->
  return if literal.type_params.is_empty()
  fail program, literal.position, 'only a top-level function or a method can be generic so far'

export reject_variadic := (program: ProgramWide, literal: FunctionLiteral) ->
  param := literal.params.find((each) -> each.variadic) ? return
  message := 'only a top-level function or a method can be variadic so far'
  fail program, param.name.position, message

export reject_defaults := (program: ProgramWide, literal: FunctionLiteral) ->
  param := literal.params.find((each) -> each.default != nil) ? return
  message := 'only a top-level function or a method can have a default so far'
  fail program, param.default!.position, message

export add_function := (
  shared: Shared, key: String, name: Identifier, literal: FunctionLiteral, this_type: Type?
) ->
  program := shared.program
  reject_defined shared, key, name
  reject_generic program, literal
  type := annotated_type(program, module_resolver(shared.index), literal)
  shared.functions.entries[key] = FunctionEntry(name, literal, type, this_type)

# Adds a top-level function whose declaration writes its type, a function type, which the literal
# must fit (see reject_misfit).
export add_declared_function := (
  shared: Shared, name: Identifier, literal: FunctionLiteral, declared: FunctionType
) ->
  reject_defined shared, name.name, name
  shared.functions.entries[name.name] =
    FunctionEntry(name, literal, type: declared, this_type: nil, is_declared: true)

# Adds a generic function or method of the module; returns how others refer to it.
export add_generic := (shared: Shared, generic: GenericFunction) ->
  ref := GenericRef(module_index: shared.index, index: shared.generics.length)
  shared.generics.push generic
  ref

export add_generic_function := (shared: Shared, generic: GenericFunction) ->
  { name } := generic
  reject_defined shared, name.name, name
  shared.functions.generics[name.name] = add_generic(shared, generic).index

reject_defined := (shared: Shared, key: String, name: Identifier) ->
  fail_already_defined shared.program, name if has_function(shared, key)

export has_function := (shared: Shared, name: String) ->
  shared.functions.entries.has(name) or shared.functions.generics.has(name)

export generic_function := (shared: Shared, name: String) ->
  index := shared.functions.generics[name] ? return nil
  GenericRef index, module_index: shared.index

# The type of the function of the module, checking its body first if the return type must be
# inferred.
export function_type_of := (program: ProgramWide, module_index: Int, name: String, at: Position) ->
  entry := program.shared[module_index].functions.entries[name] ? return nil
  if caller := program.functions_checked.last()
    program.calls[caller, default: []].push(entry.literal)
  return type if type := entry.type
  abort_part() if entry.state == FAILED
  if entry.state == CHECKING
    fail program, at, "'#{name}' is recursive, so its return type must be written"
  check_entry program, module_index, entry
  entry.type ? abort_part()

export check_all_functions := (shared: Shared) ->
  check_entry shared.program, shared.index, entry for entry in shared.functions.entries.values()

check_entry := (program: ProgramWide, module_index: Int, entry: FunctionEntry) ->
  return if entry.state != UNCHECKED
  entry.state = CHECKING
  check := (): void ->
    program.functions_checked.push entry.literal
    check_function program, module_index, entry
    program.functions_checked.pop()
  entry.state = check_part(program, check) then CHECKED else FAILED

export method_key := (type_name: String, method: String) -> "#{type_name}.#{method}"
