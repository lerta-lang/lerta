# Types calls of generic functions and methods: checks their type arguments (see
# type_argument_inference) against the bounds and the signature, and has the instance checked
# (see generics).
import Call, Member, Position, TypeParameter from '../ast'
import check_argument_count, packed_arguments from './arguments'
import fail, fail_cannot_infer from './diagnostics'
import require_type from './expression'
import methods_reachable_from from './extensions'
import
  bindings, check_defaults, generic_of, GenericFunction, GenericRef, Instance, instantiate
from './generics'
import reject_unsatisfied from './satisfaction'
import Body, InstanceLink from './shared'
import infer_type_arguments, receiver_type_arguments, TypeBinding from './type_argument_inference'
import substitute from './type_patterns'
import reject_invalid_type from './type_validity'
import FunctionType, InterfaceType, Type from '../types'

# The result of a call of a generic function.
export type_of_generic_call := (body: Body, call: Call, generic: GenericRef, expected: Type?) ->
  function_type(instance_of_call(body, call, generic, expected, nil)).result

# The type of the generic method that the call's callee names, a function type without the
# receiver.
export type_of_generic_method_call := (
  body: Body, call: Call, member: Member, generic: GenericRef, receiver: Type, expected: Type?
) ->
  binding := TypeBinding(type: receiver, at: member.object.position)
  function_type instance_of_call(body, call, generic, expected, binding)

# The instance of a generic method that the receiver gives all the type arguments of, if it does;
# `call`, if given, calls it.
export receiver_instance := (
  body: Body, generic: GenericRef, receiver: Type, at: Position, call: Call?
) ->
  generic_function := generic_of(body.program, generic)
  type_arguments := receiver_type_arguments(body, generic_function, receiver, at)
  return nil if type_arguments == nil
  reject_unsatisfied_bounds body, generic_function, type_arguments, [at for _ in type_arguments]
  instance := instantiate_here(body, generic, type_arguments, at)
  body.facts.instances[call] = InstanceLink(instance) if call
  instance

# Each argument typed alone must fit its parameter once the type arguments are known.
instance_of_call := (
  body: Body, call: Call, ref: GenericRef, expected: Type?, receiver: TypeBinding?
) ->
  program := body.program
  generic := generic_of(program, ref)
  if not call.named_args.is_empty()
    kind := generic.receiver == nil then 'function' else 'method'
    message := "a generic #{kind} takes no named arguments so far"
    fail program, call.named_args[0].name.position, message
  packed := packed_arguments(body, call, generic.literal)
  args := packed ? call.args
  check_argument_count body, call, args.length, generic.params.length, generic.literal
  body.facts.arguments[call] = packed if packed
  inference := infer_type_arguments(body, call, args, generic, expected, receiver)
  type_arguments := type_arguments_of(body, call, generic, inference.bindings)
  reject_invalid_signature body, generic, type_arguments, call.position
  instance := instantiate_here(body, ref, type_arguments, call.position)
  type := function_type(instance)
  require_type body, each.arg, each.type, type.params[each.index] for each in inference.inferred
  body.facts.instances[call] = InstanceLink(instance)
  # Leaving arguments out uses defaults, which are checked for the instance then.
  check_defaults program, generic, instance, call.position if args.length < generic.params.length
  instance

# The instance's body sees the extends in effect here of the types it may reach.
instantiate_here := (body: Body, generic: GenericRef, type_arguments: Type[], at: Position) ->
  methods := methods_reachable_from(body.program, body.extensions, type_arguments)
  instantiate body.program, generic, type_arguments, methods, at

# The type arguments in order, which must all be known and satisfy their bounds.
type_arguments_of := (
  body: Body, call: Call, generic: GenericFunction, inferred: Map<String, TypeBinding>
) ->
  callee := generic.name.name
  binding_of := (param: TypeParameter) ->
    name := param.name.name
    written := generic.receiver then "x.#{callee}" else callee
    inferred[name] ? fail_cannot_infer(body.program, call.position, name, callee, written)
  given := [binding_of(param) for param in generic.type_params]
  types := [each.type for each in given]
  reject_unsatisfied_bounds body, generic, types, [each.at for each in given]
  types

# Each type argument, given where `places` has it, must satisfy its bound, which may name the type
# parameters, as in `X: Iterable<T>`.
reject_unsatisfied_bounds := (
  body: Body, generic: GenericFunction, types: Type[], places: Position[]
) ->
  type_bindings := bindings(generic, types)
  for i in 0...types.length
    if bound := generic.bounds[i]
      bound_type := substitute(bound, type_bindings) as InterfaceType!
      reject_unsatisfied body, types[i], bound_type, places[i]

function_type := (instance: Instance) -> instance.entry.type as FunctionType!

reject_invalid_signature := (
  body: Body, generic: GenericFunction, type_arguments: Type[], at: Position
) ->
  type_bindings := bindings(generic, type_arguments)
  reject_invalid := (type: Type) ->
    reject_invalid_type body.program, substitute(type, type_bindings), at
  reject_invalid param for param in generic.params
  reject_invalid result if result := generic.result
