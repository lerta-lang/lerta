# Types calls of generic functions and methods: checks their type arguments (see
# type_argument_inference) against the bounds and the signature, and has the instance checked
# (see generics).
import Call, Expression, Member, Position, TypeParameter from '../ast'
import check_argument_count, check_gathered, gathered_of, packed_arguments from './arguments'
import fail, fail_cannot_infer from './diagnostics'
import require_type from './expression'
import ExtensionMethod from './extensions'
import members_for from './interfaces'
import extension_methods, parts_method from './parts'
import ExtensionSource, find_method, MethodSource, OwnMethod from './methods'
import
  bindings, check_defaults, generic_of, GenericFunction, GenericRef, Instance, instantiate
from './generics'
import is_struct_type from './functions'
import reject_unsatisfied from './satisfaction'
import Body, InstanceLink, ProgramWide from './shared'
import infer_type_arguments, receiver_type_arguments, TypeBinding from './type_argument_inference'
import infer, substitute, type_parameter_names from './type_patterns'
import reject_invalid_type from './type_validity'
import FunctionType, inner_of, InterfaceType, RecordType, Type, type_key from '../types'

# The result of a call of a generic function.
export type_of_generic_call := (body: Body, call: Call, generic: GenericRef, expected: Type?) ->
  function_type(instance_of_call(body, call, generic, expected, nil)).result

# The type of the generic method that the call's callee names, a function type without the
# receiver.
export type_of_generic_method_call := (
  body: Body, call: Call, member: Member, generic: GenericRef, receiver: Type, expected: Type?
) ->
  binding := TypeBinding(type: receiver, at: member.object.position)
  function_type(instance_of_call(body, call, generic, expected, binding))

# The instance of a generic method that the receiver gives all the type arguments of, if it does;
# `call`, if given, calls it.
export receiver_instance := (
  body: Body, generic: GenericRef, receiver: Type, at: Position, call: Call?
) ->
  generic_function := generic_of(body.program, generic)
  type_arguments := receiver_type_arguments(body, generic_function, receiver, at)
  return nil if type_arguments == nil
  reject_unsatisfied_bounds body, generic_function, type_arguments, [at for _ in type_arguments]
  instance := instantiate_here(body, generic, type_arguments, at)
  if call
    body.facts.instances[call] = InstanceLink(instance)
  instance

# Each argument typed alone must fit its parameter once the type arguments are known.
instance_of_call := (
  body: Body, call: Call, ref: GenericRef, expected: Type?, receiver: TypeBinding?
) ->
  program := body.program
  generic := generic_of(program, ref)
  packed := packed_arguments(body, call, generic.literal)
  args := packed else call.args
  gathered := gathered_in_generic(body, call, args, generic)
  passed := gathered then [args..., gathered] else args
  check_argument_count
    body
    call
    generic.literal
    given: passed.length
    params: generic.params.length
  if gathered
    check_gathered body, gathered, generic.params.last()!
  body.facts.arguments[call] = passed if packed or gathered
  inference := infer_type_arguments(body, call, args, generic, expected, receiver)
  type_arguments := type_arguments_of(body, call, generic, inference.bindings)
  reject_invalid_signature body, generic, type_arguments, call.position
  instance := instantiate_here(body, ref, type_arguments, call.position)
  type := function_type(instance)
  for each in inference.inferred
    require_type body, each.arg, each.type, type.params[each.index]
  body.facts.instances[call] = InstanceLink(instance)

  # Leaving arguments out uses defaults, which are checked for the instance then.
  if passed.length < generic.params.length
    check_defaults program, generic, instance, call.position

  instance

# The argument gathered as for any call, but not into a struct whose type names a type parameter,
# which instances may differ in.
gathered_in_generic := (body: Body, call: Call, args: Expression[], generic: GenericFunction) ->
  last := generic.params.last()
  if last and not type_parameter_names(last).is_empty()
    inner := inner_of(last)
    if is_struct_type(inner) or inner is RecordType
      unless call.named_args.is_empty()
        kind := generic.receiver == nil then 'function' else 'method'
        takes := 'named arguments only for a struct with no type parameter'
        fail body.program, call.named_args[0].name.position, "a generic #{kind} takes #{takes}"
      return nil
  gathered_of(body, call, args, generic.params)

# The instance's body, checked at its definition, reaches the type arguments only through their
# bounds, so it sees the methods of the extends in effect here that satisfy them: the witnesses.
instantiate_here := (body: Body, ref: GenericRef, type_arguments: Type[], at: Position) ->
  { program } := body
  generic := generic_of(program, ref)
  witnesses := Witnesses()
  add_witnesses body, generic, bindings(generic, type_arguments), witnesses
  instantiate(program, ref, type_arguments, witnesses.methods.to_array(), at)

# The methods found, and each generic method with the type it satisfies a bound for, which the
# same generic method may do for several types, as `extend<U: B> U[]` for C[][] and C[].
class Witnesses
  private
    methods: Set<ExtensionMethod> = Set()
    visited := Set<String>()

# Adds the methods of extends that satisfy the bounds of the generic's type parameters, bound to
# the types, and those that satisfy the bounds of a generic method that satisfies a bound's member
# in turn, an extend's or a class's or struct's own.
add_witnesses := (
  body: Body, generic: GenericFunction, type_bindings: Map<String, Type>, witnesses: Witnesses
): void ->
  { program } := body
  for (param, bound) in generic.type_params.zip(generic.bounds)
    type := type_bindings[param.name.name] else continue
    written := bound else continue
    bound_type := substitute(written, type_bindings) as InterfaceType!
    for member in members_for(program, bound_type, type)
      source := find_method(program, type, member.name, body.extensions)
      witnesses.methods.add source.method if source is ExtensionSource
      if source == nil
        by_parts := parts_method(body, type, member.name, param.name.position)
        if by_parts
          for method in extension_methods(program, program.parts_plans[by_parts.parts!])
            witnesses.methods.add method
      ref := generic_method(source) else continue
      key := "#{ref.module_index}.#{ref.index} #{type_key(type)}"
      continue unless witnesses.visited.add(key)
      add_witnesses body, generic_of(program, ref), receiver_bindings(program, ref, type), witnesses

# The generic method of the source, an extend's or a class's or struct's own, whose instance sees
# the witnesses of its bounds too.
generic_method := (source: MethodSource?) ->
  case source
    when ExtensionSource then source.method.generic
    when OwnMethod then source.generic
    else nil

# The type arguments that the receiver of the generic method gives, matched against the type.
receiver_bindings := (program: ProgramWide, ref: GenericRef, type: Type) ->
  type_bindings: Map<String, Type>
  receiver := generic_of(program, ref).receiver else return type_bindings
  bind := (name: String, bound: Type) -> type_bindings[name] = bound
  infer receiver.type, type, bind
  type_bindings

# The type arguments in order, which must all be known and satisfy their bounds.
type_arguments_of := (
  body: Body, call: Call, generic: GenericFunction, inferred: Map<String, TypeBinding>
) ->
  callee := generic.name.name
  binding_of := (param: TypeParameter) ->
    name := param.name.name
    written := generic.receiver then "x.#{callee}" else callee
    inferred[name] else fail_cannot_infer(body.program, call.position, name, callee, written)
  given := [binding_of(param) for param in generic.type_params]
  types := [each.type for each in given]
  reject_unsatisfied_bounds body, generic, types, [each.at for each in given]
  types

# Each type argument, given where `places` has it, must satisfy its bound, which may name the type
# parameters, as in `X: Iterable<T>`.
reject_unsatisfied_bounds := (
  body: Body, generic: GenericFunction, types: Type[], places: Position[]
) ->
  type_bindings := bindings(generic, types)
  for i in 0..types.length
    if bound := generic.bounds[i]
      bound_type := substitute(bound, type_bindings) as InterfaceType!
      reject_unsatisfied body, types[i], bound_type, places[i]

function_type := (instance: Instance) -> instance.entry.type as FunctionType!

reject_invalid_signature := (
  body: Body, generic: GenericFunction, type_arguments: Type[], at: Position
) ->
  type_bindings := bindings(generic, type_arguments)
  reject_invalid := (type: Type) ->
    reject_invalid_type body.program, substitute(type, type_bindings), at
  reject_invalid param for param in generic.params
  reject_invalid result if result := generic.result
