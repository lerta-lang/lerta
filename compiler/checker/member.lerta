# Types the members of values: method calls, `x.name(...)`, and properties, `x.name`; and finds
# the member of a name that an interface reads.
import { Call, Identifier, Member, This } from '../ast'
import { builtin_property } from './builtins'
import { fail } from './diagnostics'
import { check_arguments, reject_type_arguments, set_type, type_of } from './expression'
import { plain_method_type } from './extensions'
import {
  common_field_type, common_field_type_by_name, field_type, field_type_by_name
} from './fields'
import { receiver_instance, type_of_generic_method_call } from './generic_call'
import { BuiltinMethod, ExtensionSource, find_method, MethodSource, OwnMethod } from './methods'
import { method_owner, object_method_type } from './object'
import { Body } from './shared'
import { format_type, Type, UnionType } from '../types'

# The result of a call of the method that `member` names: a method of the object's type (see
# find_method), or a field that holds a function.
export const type_of_method_call = (body: Body, call: Call, member: Member, expected: Type?) ->
  const receiver = type_of(body, member.object, nil)
  const source = find(body, receiver, member.name.name)
  const generic = generic_method(source)
  if generic == nil
    reject_type_arguments body, call
    return check_arguments(body, call, type_of_method(body, member, receiver, source))
  const method = type_of_generic_method_call(body, call, member, generic, receiver, expected)
  set_type body, member, method
  method.result

const generic_method = (source: MethodSource?) ->
  return nil if source == nil
  case source
    when OwnMethod then source.generic
    when ExtensionSource then source.method.generic
    else nil

const type_of_method = (body: Body, member: Member, receiver: Type, source: MethodSource?) ->
  const { name, position } = member.name
  reject_deinit body, receiver, member
  const from_source = source then method_type(body, receiver, source, member.name, nil) else nil
  const no_method = () ->
    fail body.program, position, "type #{format_type(receiver)} has no method '#{name}'"
  const field = case
    when receiver is UnionType then common_field_type(body, receiver, member)
    else field_type(body, receiver, member)
  const method = from_source ? field ? no_method()
  set_type body, member, method

const find = (body: Body, receiver: Type, name: String) ->
  find_method body.program, receiver, name, body.extensions

# The type of the method, checking its body first if needed. A generic one's comes from its
# instance for the receiver, if the receiver gives all its type arguments; `call`, if given, calls
# it.
const method_type = (
  body: Body, receiver: Type, source: MethodSource, name: Identifier, call: Call?
) ->
  case source
    when OwnMethod then object_method_type(body, source.receiver, name)
    when BuiltinMethod then source.type
    when ExtensionSource
      const method = source.method
      const generic = method.generic ? return plain_method_type(body.program, method, name.position)
      const instance = receiver_instance(body, generic, receiver, name.position, call) ? return nil
      instance.entry.type

# The type of the member of the type that an interface reads by the name: of a method, or of a
# field or a property, or of a field of every member of a union, as `x.name` reads it; nil if it
# has none. `call`, if given, calls a generic method.
export const member_type_by_name = (body: Body, type: Type, name: Identifier, call: Call?): Type? ->
  if const source = find(body, type, name.name)
    return method_type(body, type, source, name, call)
  return common_field_type_by_name(body, type, name) if type is UnionType
  return field if const field = field_type_by_name(body, type, name)
  return property if const property = builtin_property(type, name.name)
  nil

# A class's deinit is only run by a release.
const reject_deinit = (body: Body, object_type: Type, member: Member) ->
  const { name, position } = member.name
  return if name != 'deinit' or method_owner(body, object_type, name) == nil
  const message = 'deinit runs when the object is released; it cannot be called or used'
  fail body.program, position, message

# A member that is not called is a field, or a property such as `length`. A field read from a union
# must be in every member, with the same type.
export const type_of_property = (body: Body, member: Member): Type ->
  const object_type = type_of_object(body, member)
  const { name, position } = member.name
  reject_deinit body, object_type, member
  return common_field_type(body, object_type, member) if object_type is UnionType
  return field if const field = field_type(body, object_type, member)
  return property if const property = builtin_property(object_type, name)
  if find(body, object_type, name) != nil
    fail body.program, position, "a method must be called: write `#{name}()`"
  fail body.program, position, "type #{format_type(object_type)} has no property '#{name}'"

# `@x` in a method or an initializer reads the object's field.
const type_of_object = (body: Body, member: Member) ->
  const object = member.object
  if object is This
    return set_type(body, object, self.type) if const self = body.self
  type_of body, object, nil
