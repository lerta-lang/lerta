# Types the members of values: method calls, `x.name(...)`, and properties, `x.name`; and finds
# the member of a name that an interface reads.
import Call, FunctionLiteral, Identifier, Member, This from '../ast'
import check_arguments from './arguments'
import BuiltinMethod from './builtins'
import COMPLETION_NAME, probe_member from './completion_probe'
import warn_if_kept from './cycles'
import fail from './diagnostics'
import reject_type_arguments, set_type, type_of from './expression'
import plain_method_type from './extensions'
import common_field_type, common_field_type_by_name, field_type, field_type_by_name from './fields'
import receiver_instance, type_of_generic_method_call from './generic_call'
import interface_member from './interfaces'
import
  builtin_property, FoundMember, InterfaceProperty, MemberTarget, Method, Property
from './member_targets'
import narrowed_field_type from './narrowable'
import
  ExtensionSource, find_method, InterfaceMethod, MemberMethod, MethodSource, OwnMethod, UnionMethod
from './methods'
import method_owner, object_method_type from './object'
import info_of from './object_types'
import find_interface_extension from './satisfaction'
import Body from './shared'
import
  format_member, format_type, format_types, FunctionType, InterfaceType, same_type, Type, UnionType
from '../types'

# The result of a call of the method that `member` names: a method of the object's type (see
# find_method), or a field that holds a function.
export type_of_method_call := (body: Body, call: Call, member: Member, expected: Type?) ->
  receiver := type_of(body, member.object)
  probe_member body, receiver if member.name.name == COMPLETION_NAME
  source := find_callable(body, receiver, member.name)
  generic := generic_method(source)
  if generic == nil
    reject_type_arguments body, call
    method := type_of_method(body, member, receiver, source)
    result := check_arguments(body, call, method, method_literal_of(body, source, member))
    warn_if_kept body, call, member, source
    return result
  record_member body, member, Method(source: source!)
  method := type_of_generic_method_call(body, call, member, generic, receiver, expected)
  set_type body, member, method
  method.result

# The declaration of a method written in Lerta.
method_literal_of := (body: Body, source: MethodSource?, member: Member): FunctionLiteral? ->
  case source
    when OwnMethod then info_of(body.program, source.receiver).methods[member.name.name]
    when ExtensionSource then source.method.literal
    else nil

export generic_method := (source: MethodSource?) ->
  return nil if source == nil
  case source
    when OwnMethod then source.generic
    when ExtensionSource then source.method.generic
    else nil

type_of_method := (body: Body, member: Member, receiver: Type, source: MethodSource?) ->
  { name, position } := member.name
  reject_deinit body, receiver, member
  from_source := source then method_type(body, receiver, source, member.name, nil)
  no_method := ->
    fail body.program, position, "type #{format_type(receiver)} has no method '#{name}'"
  field := ->
    if receiver is UnionType
      if problem := union_method_problem(body, receiver, member.name)
        fail body.program, position, problem
      return common_field_type(body, receiver, member)
    field_type(body, receiver, member) ? no_method()
  method := from_source ? field()
  record_member body, member, from_source then Method(source: source!) else Property(kind: FIELD)
  set_type body, member, method

find := (body: Body, receiver: Type, name: Identifier) ->
  return union_method(body, receiver, name) if receiver is UnionType
  find_method body.program, receiver, name.name, body.extensions

# The method of the name that every member of the union has, of one type, or nil.
union_method := (body: Body, union: UnionType, name: Identifier): UnionMethod? ->
  found := find_union_method(body, union, name)
  found.problem == nil then UnionMethod(type: found.type!, members: found.members)

# Why no method of the name can be called on the union, or nil if one can or no member has one.
export union_method_problem := (body: Body, union: UnionType, name: Identifier) ->
  return nil if union.members.all((member) -> find_callable(body, member, name) == nil)
  find_union_method(body, union, name).problem

struct UnionMethods
  type: Type?
  members: MemberMethod[]
  # Why the method cannot be called on the union, if it cannot.
  problem: String?

# The method of the name in each member of the union, which must all have it, of one type, as a
# call on the member would call it. A generic one would have an instance of each member.
find_union_method := (body: Body, union: UnionType, name: Identifier): UnionMethods ->
  members: MemberMethod[]
  var first: Type?
  for member in union.members
    member_name := format_member(member, union)
    of_member := "of #{member_name}, a member of #{format_type(union)}"
    failed := (problem: String) -> UnionMethods(type: nil, members: members, problem: problem)
    missing := "'#{name.name}' is no method #{of_member}"
    source := find_callable(body, member, name) ? return failed(missing)
    return failed(generic_problem(source, name.name, of_member)) if generic_method(source) != nil
    type := method_type(body, member, source, name, nil)!
    if first and not same_type(first, type)
      first_name := format_member(members[0].member, union)
      types := format_types(first, type)
      differing := "#{types.first} in #{first_name} but #{types.second} in #{member_name}"
      return failed("'#{name.name}' has type #{differing}")
    first = type
    members.push MemberMethod(member, source)
  UnionMethods type: first, members: members, problem: nil

# Why the generic method cannot be called on the union: it has type parameters of its own or of its
# type, or it comes from an extend of an interface, which has an instance for each type.
generic_problem := (source: MethodSource, name: String, of_member: String) ->
  bound := source is ExtensionSource then source.method.bound
  return "'#{name}' #{of_member}, comes from an extend of #{format_type(bound)}" if bound
  "'#{name}' is a generic method, or one of a generic type, #{of_member}"

# The method that a call of the name calls: one of the receiver's type (see find_method), or one
# that an extend of an interface it satisfies gives it, which codegen reads from the facts. A
# member of the type of the same name would make the call ambiguous.
find_callable := (body: Body, receiver: Type, name: Identifier): MethodSource? ->
  own := find(body, receiver, name)
  extended := find_interface_extension(body, receiver, name) ? return own
  if own != nil or field_type_by_name(body, receiver, name) != nil
    from := "from an extend of #{format_type(extended.bound!)} in #{extended.module_name}"
    gets := "has a member '#{name.name}', and gets a method of that name #{from}"
    fail body.program, name.position, "#{format_type(receiver)} #{gets}"
  ExtensionSource method: extended

# The type of the method, checking its body first if needed. A generic one's comes from its
# instance for the receiver, if the receiver gives all its type arguments; `call`, if given, calls
# it.
method_type := (body: Body, receiver: Type, source: MethodSource, name: Identifier, call: Call?) ->
  if generic := generic_method(source)
    instance := receiver_instance(body, generic, receiver, name.position, call) ? return nil
    return instance.entry.type
  case source
    when OwnMethod then object_method_type(body, source.receiver, name)
    when BuiltinMethod then source.type
    when InterfaceMethod then source.type
    when UnionMethod then source.type
    when ExtensionSource then plain_method_type(body.program, source.method, name.position)

# The member of the type that an interface reads by the name: a method, or a field or a property,
# or a field of every member of a union, as `x.name` reads it; nil if it has none. `call`, if
# given, calls a generic method.
export find_member := (body: Body, type: Type, name: Identifier, call: Call? = nil): FoundMember? ->
  if source := find(body, type, name)
    method := method_type(body, type, source, name, call) ? return nil
    return FoundMember(target: Method(source), type: method)
  if type is UnionType
    common := common_field_type_by_name(body, type, name) ? return nil
    return FoundMember(target: Property(kind: FIELD), type: common)
  if field := field_type_by_name(body, type, name)
    return FoundMember(target: Property(kind: FIELD), type: field)
  property_of body, type, name.name

# A property of a builtin type, or of an interface value, by the name.
property_of := (body: Body, type: Type, name: String): FoundMember? ->
  return property if property := builtin_property(type, name)
  interface_property body, type, name

export member_type_by_name := (
  body: Body
  type: Type
  name: Identifier
  call: Call? = nil
): Type? -> find_member(body, type, name, call)?.type

# The member of the interface type of the name that is no method, which is read through the itab.
interface_property := (body: Body, type: Type, name: String) ->
  return nil if type is not InterfaceType
  found := interface_member(body.program, type, name) ? return nil
  member_type := found.member.type
  return nil if member_type is FunctionType
  FoundMember target: InterfaceProperty(index: found.index), type: member_type

# Records what the member refers to, which codegen generates it by.
export record_member := (body: Body, member: Member, target: MemberTarget) ->
  body.facts.members[member] = target

reject_deinit := (body: Body, object_type: Type, member: Member) ->
  { name, position } := member.name
  return if name != 'deinit' or method_owner(body, object_type, name) == nil
  message := 'deinit runs when the object is released; it cannot be called or used'
  fail body.program, position, message

export type_of_property := (body: Body, member: Member): Type ->
  object_type := type_of_object(body, member)
  { name, position } := member.name
  probe_member body, object_type if name == COMPLETION_NAME
  reject_deinit body, object_type, member
  if object_type is UnionType
    record_member body, member, Property(kind: FIELD)
    return common_field_type(body, object_type, member)
  if field := field_type(body, object_type, member)
    record_member body, member, Property(kind: FIELD)
    return narrowed_field_type(body, member) ? field
  if property := property_of(body, object_type, name)
    record_member body, member, property.target
    return property.type
  extended := find_interface_extension(body, object_type, member.name)
  if find(body, object_type, member.name) != nil or extended != nil
    fail body.program, position, "a method must be called: write `#{name}()`"
  fail body.program, position, "type #{format_type(object_type)} has no property '#{name}'"

type_of_object := (body: Body, member: Member) ->
  object := member.object
  if object is This
    return set_type(body, object, self.type) if self := body.self
  type_of body, object
