# The names that code assigns, matched without their scopes: those that the function literals of a
# body assign, for narrowing, and those that expressions assign anywhere, for borrowing in codegen.
import
  Assignment, Binding, Case, Condition, Declaration, Expression, For, FunctionLiteral, Identifier,
  If, operands_of, Statement, Try, While
from '../ast'

# The names that the function literals in a body assign, found before the body is checked, so that
# a `var` of one of them is not narrowed anywhere (see narrowable_local): a literal may run at any
# point after it is written, even inside a call made where an earlier test narrows the `var`.
# A literal's own `var` of an outer `var`'s name stops the outer one being narrowed too.
export names_literals_assign := (statements: Statement[]) ->
  names: Set<String>
  visit_statements names, statements, false
  names

# The names that the expressions assign anywhere, in function literals or not, so that a `var` of
# one of them is not borrowed while they are evaluated (see is_var_kept).
export names_assigned := (expressions: Expression[]) ->
  names: Set<String>
  visit names, expression, true for expression in expressions
  names

# `collects`: whether the assignments of the statements are collected: those in a function literal
# of the body, or every one (see names_assigned).
visit_statements := (names: Set<String>, statements: Statement[], collects: Bool): void ->
  visit_statement names, statement, collects for statement in statements

visit_statement := (names: Set<String>, statement: Statement, collects: Bool) ->
  case statement
    when Declaration then visit(names, statement.value, collects)
    when Assignment
      target := statement.target
      names.add target.name if collects and target is Identifier
      visit names, target, collects
      visit names, statement.value, collects
    when While
      visit_condition names, statement.condition, collects
      visit_statements names, statement.body, collects
    when For
      visit names, statement.iterable, collects
      visit_statements names, statement.body, collects
    when Expression then visit(names, statement, collects)
    else pass

visit_condition := (names: Set<String>, condition: Condition, collects: Bool) ->
  case condition
    when Binding then visit(names, condition.value, collects)
    else visit(names, condition, collects)

visit := (names: Set<String>, expression: Expression, collects: Bool): void ->
  case expression
    when FunctionLiteral then visit_statements(names, expression.body, true)
    when If
      visit_condition names, expression.condition, collects
      visit_statements names, expression.then_body, collects
      visit_statements names, expression.else_body, collects
    when Case
      visit names, subject, collects if subject := expression.subject
      for arm in expression.arms
        visit names, pattern, collects for pattern in arm.patterns
        visit_statements names, arm.body, collects
      visit_statements names, otherwise, collects if otherwise := expression.otherwise
    when Try
      visit_statements names, expression.body, collects
      visit_statements names, clause.body, collects for clause in expression.catches
      visit_statements names, finally_body, collects if finally_body := expression.finally_body
    else visit(names, operand, collects) for operand in operands_of(expression)
