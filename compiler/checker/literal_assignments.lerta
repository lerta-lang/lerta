# The names that code assigns, matched without their scopes: those that the function literals and
# methods of a body assign, for narrowing, and those that expressions assign anywhere, for
# borrowing in codegen.
import Assignment, children_of, Expression, FunctionLiteral, Identifier, Statement from '../ast'

# The names that the function literals and methods in a body assign, found before the body is
# checked, so that a `var` of one of them is not narrowed anywhere (see narrowable_local): a literal
# may run at any point after it is written, even inside a call made where an earlier test narrows
# the `var`.
# A literal's own `var` of an outer `var`'s name stops the outer one being narrowed too.
export names_literals_assign := (statements: Statement[]) ->
  names: Set<String>
  for statement in statements
    add_assigned names, statement, false
  names

# The names that the expressions assign anywhere, in function literals or not, so that a `var` of
# one of them is not borrowed while they are evaluated (see is_var_kept).
export names_assigned := (expressions: Expression[]) ->
  names: Set<String>
  for expression in expressions
    add_assigned names, expression, true
  names

# `collects`: whether the assignments of the node are collected: those in a function literal of the
# body, or every one (see names_assigned).
add_assigned := (names: Set<String>, node: Statement, collects: Bool): void ->
  if collects and node is Assignment
    target := node.target
    names.add target.name if target is Identifier
  inside := collects or node is FunctionLiteral
  for child in children_of(node)
    add_assigned names, child, inside
