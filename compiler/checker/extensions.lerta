# The methods that `extend` statements give to types, in effect where
# docs/reference/objects.md#extend says, so that a module sees only the extends it asks for.
import FunctionLiteral, Identifier, Import, Position from '../ast'
import fail from './diagnostics'
import function_type_of from './functions'
import GenericRef from './generics'
import info_of from './object_types'
import ProgramWide, Shared from './shared'
import is_pattern, matches, overlaps, parts_of from './type_patterns'
import format_type, InterfaceType, ObjectType, Type, type_key from '../types'

# The receiver of a generic extend, `T[]`, has type parameters, which stand for any type.
export class ExtensionMethod
  # Self, for a method of an extend of an interface, which `bound` is.
  receiver: Type
  bound: InterfaceType?
  name: Identifier
  literal: FunctionLiteral
  # The declaring module: its index, and how messages name it.
  module_index: Int
  module_name: String
  # A method of a generic extend, or one with type parameters of its own, has instances; the
  # declaring module's functions hold another's type by `key`.
  generic: GenericRef?
  key: String

export class Extensions
  module_index: Int
  module_name: String
  in_effect: ExtensionMethod[] = []
  # methods_reachable_from's results by the type arguments' keys, which every generic call asks
  # again; a method added to those in effect may change them (see add_in_effect).
  reachable: Map<String, ReachableMethods> = Map()

# The methods, which hold for good if `inferred_fields` is nil, or else only while
# ProgramWide.inferred_fields is still the same: a field whose type its initializer gives has none
# until the initializer is checked, so the methods reached before then may be more afterwards.
struct ReachableMethods(methods: ExtensionMethod[], inferred_fields: Int?)

# The type of a method that is not generic, checking its body first if needed.
export const plain_method_type = (program: ProgramWide, method: ExtensionMethod, at: Position) ->
  function_type_of program, method.module_index, method.key, at

# The methods of the module that `statement` imports; a module imported twice brings them once.
# A conflict between two imported modules is the importer's, so it is reported at its import.
export const add_imported = (
  program: ProgramWide, extensions: Extensions, methods: ExtensionMethod[], statement: Import
) ->
  for method in methods
    continue if extensions.in_effect.contains(method)
    if const other = overlapping(extensions, method)
      const modules = "#{other.module_name} and #{method.module_name}"
      const method_name = "a method '#{method.name.name}'"
      const gets = "gets #{method_name} from extends in both #{modules}"
      const message = "#{format_type(extended_type(method))} #{gets}"
      fail program, statement.position, message
    add_in_effect extensions, method

# The type that the method's extend extends: an interface, or a type, which may be a pattern.
export const extended_type = (method: ExtensionMethod) ->
  return bound if const bound = method.bound
  method.receiver

# A method of an extend of the module (see declare_extend).
export const add_own = (shared: Shared, method: ExtensionMethod) ->
  const { name } = method
  const extensions = shared.extensions
  if const other = overlapping(extensions, method)
    const is_same_module = other.module_index == extensions.module_index
    const where = is_same_module then 'the same module' else other.module_name
    const method_name = "a method '#{name.name}'"
    const extended = format_type(extended_type(method))
    const other_extended = format_type(extended_type(other))
    const message =
      if method.bound == nil or extended == other_extended
        "#{extended} already has #{method_name}, from an extend in #{where}"
      # Extends of two interfaces, which a type may satisfy both.
      else
        const also = 'which a type may satisfy too'
        const gives = "an extend in #{where} gives one to #{other_extended}, #{also}"
        "#{extended} cannot get #{method_name}: #{gives}"
    fail shared.program, name.position, message
  add_in_effect extensions, method
  shared.own_methods.push method
  shared.program.methods_matching = Map()

# The extends in effect here, with `methods` before them, as an instance of a generic function
# sees them (see GenericFunction).
export const with_methods = (extensions: Extensions, methods: ExtensionMethod[]) ->
  const { module_index, module_name } = extensions
  const seen = Extensions(module_index, module_name)
  seen.in_effect.append methods
  for method in extensions.in_effect
    seen.in_effect.push method if not methods.contains(method)
  seen

# The methods that the extends in effect give the types and the types they are made of, fields
# included: those that the body of an instance with these type arguments may reach.
export const methods_reachable_from = (
  program: ProgramWide, extensions: Extensions, types: Type[]
) ->
  const key = [type_key(type) for type in types].join("\n")
  if const cached = extensions.reachable[key]
    const inferred_fields = cached.inferred_fields
    return cached.methods if inferred_fields == nil or inferred_fields == program.inferred_fields
  const reach = Reach()
  visit_reachable program, reach, type for type in types
  # A generic extend's methods, as those of T[], may be in effect for several of the types.
  const in_effect = Set<ExtensionMethod>(extensions.in_effect)
  const found: Set<ExtensionMethod>
  for (reached, type) in reach.seen.entries()
    for method in methods_matching(program, reached, type)
      found.add method if in_effect.has(method)
  const methods = [method for method in found]
  # Until then, the classes and structs may get more fields (see ProgramWide.members_known).
  if program.members_known
    const inferred_fields = reach.is_complete then nil else program.inferred_fields
    extensions.reachable[key] = ReachableMethods(methods, inferred_fields)
  methods

# The types visit_reachable has reached by their keys, and whether it has reached every field's
# type.
class Reach
  seen: Map<String, Type> = Map()
  is_complete = true

# The methods of every module's extends whose receivers match the type of the key.
const methods_matching = (program: ProgramWide, key: String, type: Type) ->
  const find = ->
    const found: ExtensionMethod[]
    for shared in program.shared
      found.append [method for method in shared.own_methods when matches(method.receiver, type)]
    found
  program.methods_matching.get_or_put key, find

const add_in_effect = (extensions: Extensions, method: ExtensionMethod) ->
  extensions.in_effect.push method
  extensions.reachable = Map()

const visit_reachable = (program: ProgramWide, reach: Reach, type: Type): void ->
  const key = type_key(type)
  return if reach.seen.has(key)
  reach.seen[key] = type
  visit_reachable program, reach, part for part in parts_of(type)
  if type is ObjectType
    for field in info_of(program, type).fields
      if const field_type = field.type
        visit_reachable program, reach, field_type
      else
        reach.is_complete = false

# The method of the name that an extend of a type in effect gives the receiver: that of an extend of
# the type itself, if there is one, before that of a generic extend of the same module that matches
# it (see overlapping); those of the extends of interfaces are found by the interfaces it satisfies (see
# find_interface_extension).
export const find_extension = (extensions: Extensions, receiver: Type, name: String) ->
  const is_found = (method: ExtensionMethod) ->
    method.bound == nil and method.name.name == name and matches(method.receiver, receiver)
  const found = [method for method in extensions.in_effect when is_found(method)]
  return specific if const specific = found.find((method) -> not is_pattern(method.receiver))
  found.first()

# A method of the name that an extend in effect gives some type that `method`'s receiver, a
# pattern, also matches, which another extend cannot give it too, unless the two are of one module
# and one of them extends a type without type parameters, whose method that type takes before the
# pattern's (see find_extension). Of one module only, so that the pattern's other methods, checked
# there, call the same method as any other caller. Two extends of interfaces may both be of a type,
# which is known only where their method is called (see find_interface_extension), so they clash
# by name; an extend of a type and one of an interface clash only there.
const overlapping = (extensions: Extensions, method: ExtensionMethod) ->
  const name = method.name.name
  const is_found = (other: ExtensionMethod) ->
    return false if other.name.name != name or (other.bound == nil) != (method.bound == nil)
    return true if other.bound != nil
    const one_is_specific = is_pattern(other.receiver) != is_pattern(method.receiver)
    const specializes = one_is_specific and other.module_index == method.module_index
    overlaps(other.receiver, method.receiver) and not specializes
  extensions.in_effect.find is_found
