# Narrowing an optional local where a condition shows it is not nil, or a local of a union type
# where it shows which type it has, including after a guard `if`; and so a path of fields from one
# (see narrowable).
import
  BinaryOperation, Condition, Expression, Identifier, If, is_equality_operator, IsTest, Member,
  NilLiteral, Statement, Try, UnaryOperation, UnionMember
from '../ast'
import FieldPath, narrowable from './narrowable'
import Local from './scopes'
import Body from './shared'
import resolve from './type_names'
import inner_of, is_kind, other_members, OptionalType, Type, UnionType from '../types'

# A local or a path of fields, and the narrower type it has.
export struct Narrowing
  subject: Local | FieldPath
  type: Type

# The locals a condition narrows where it holds, and where it does not.
export struct ConditionNarrowings
  where_true: Narrowing[]
  where_false: Narrowing[]

export narrowings_where := (narrowings: ConditionNarrowings, value: Bool) ->
  value then narrowings.where_true else narrowings.where_false

# A name or a member that a condition tests.
struct Tested
  value: Expression
  condition_value: Bool
  is_type: UnionMember?

tested := (body: Body, condition: Condition) ->
  case condition
    when Identifier, Member then Tested(value: condition, condition_value: true)
    when IsTest
      value := condition.value
      return nil if not is_name_or_member(value)
      Tested value, condition_value: true, is_type: condition.type
    when BinaryOperation
      operator := condition.operator
      return nil if not is_equality_operator(operator)
      if value := nil_tested(condition.left, condition.right)
        return Tested(value, condition_value: operator == '!=')
      value := value_tested(body, condition.left, condition.right) ? return nil
      Tested value, condition_value: operator == '=='
    else nil

is_name_or_member := (value: Expression) -> value is Identifier or value is Member

# The name or member that one side compares with a value on the other that cannot be nil.
value_tested := (body: Body, left: Expression, right: Expression) ->
  cannot_be_nil := (operand: Expression) ->
    type := body.facts.types[operand] ? return false
    not (type is OptionalType or is_kind(type, 'nil'))
  case
    when is_name_or_member(left) and cannot_be_nil(right) then left
    when is_name_or_member(right) and cannot_be_nil(left) then right
    else nil

# The name or member that one side compares with nil on the other.
nil_tested := (left: Expression, right: Expression) ->
  case
    when left is NilLiteral and is_name_or_member(right) then right
    when right is NilLiteral and is_name_or_member(left) then left
    else nil

export ends_with_jump := (statements: Statement[], is_never: (Expression) -> Bool): Bool ->
  return false if statements.is_empty()
  last := statements.last()!
  jumps := (block: Statement[]) -> ends_with_jump(block, is_never)
  if last is If
    jumps(last.then_body) and jumps(last.else_body)
  # A try statement is typed void, not never, so whether it jumps is read from its blocks: the block
  # and every catch, or a finally, which can end only with a throw.
  else if last is Try
    blocks := [last.body]
    blocks.push clause.body for clause in last.catches
    finally_body := last.finally_body
    blocks.all(jumps) or (finally_body != nil and jumps(finally_body))
  else
    expression := last as Expression ? return false
    is_never expression

# A view of a local with a narrower type, which marks the local itself as used.
narrowed_view := (local: Local, type: Type) ->
  { identifier, mutable, used } := local
  view := Local(identifier, type, mutable, used, origin: local.original())
  view.captured = local.captured
  view

export narrowings_of := (body: Body, condition: Condition): ConditionNarrowings ->
  if condition is UnaryOperation and condition.operator == 'not'
    inner := narrowings_of(body, condition.operand)
    return { where_true: inner.where_false, where_false: inner.where_true }
  if condition is BinaryOperation
    operator := condition.operator
    return narrowings_of_logical(body, condition) if operator == 'and' or operator == 'or'
  tested_narrowings(body, condition) ? narrowings_only_where([], true)

# Both operands narrow where `a and b` holds, or where `a or b` does not.
narrowings_of_logical := (body: Body, logical: BinaryOperation) ->
  value := logical.operator == 'and'
  first := narrowings_where(narrowings_of(body, logical.left), value)
  var second: Narrowing[] = []
  with_narrowings body, first, ->
    second = narrowings_where(narrowings_of(body, logical.right), value)
  narrowings_only_where [first..., second...], value

narrowings_only_where := (narrowings: Narrowing[], value: Bool) ->
  return ConditionNarrowings(where_true: narrowings, where_false: []) if value
  ConditionNarrowings where_true: [], where_false: narrowings

# Runs `check` where the right operand of `a and b` is evaluated, which is where a holds, or of
# `a or b`, where a does not.
export where_right_operand := (body: Body, logical: BinaryOperation, check: () -> void) ->
  left := narrowings_of(body, logical.left)
  with_narrowings body, narrowings_where(left, logical.operator == 'and'), check

# Runs `check` with the narrowings, in a scope of their own.
with_narrowings := (body: Body, narrowings: Narrowing[], check: () -> void) ->
  body.scopes.push()
  narrow body, narrowings
  check()
  body.scopes.pop()

# Until the innermost scope ends, the locals and the paths are seen with the narrower types.
export narrow := (body: Body, narrowings: Narrowing[]) ->
  for narrowing in narrowings
    { subject, type } := narrowing
    case subject
      when Local then body.scopes.narrow(subject.identifier.name, narrowed_view(subject, type))
      when FieldPath then body.scopes.narrow_path(subject.key, { type, root: subject.root })

# How a test such as `x != nil` or `x is T` narrows the local or the path it tests.
tested_narrowings := (body: Body, condition: Condition) ->
  test := tested(body, condition) ? return nil
  value := narrowable(body, test.value) ? return nil
  { subject } := value
  if is_type := test.is_type
    return nil if inner_of(value.declared) is not UnionType
    type := resolve(body.program, body.resolver, is_type)
    others := other_members(value.current, type)
    where_false: Narrowing[] = others then [{ subject, type: others }] else []
    return ConditionNarrowings(where_false, where_true: [{ subject, type }])
  type := value.current
  return nil if type is not OptionalType
  narrowings_only_where [{ subject, type: type.inner }], test.condition_value
