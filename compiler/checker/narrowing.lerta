# Narrowing an optional local where a condition shows it is not nil, or a local of a union type
# where it shows which type it has, including after a guard `if`.
import {
  as_expression, BinaryOperation, Condition, Expression, Identifier, If, IsTest, NamedType
  NilLiteral, Statement, UnaryOperation
} from '../ast'
import { lookup } from './name'
import { Local } from './scopes'
import { Body } from './shared'
import { resolve } from './type_names'
import { inner_of, is_kind, OptionalType, Type, UnionType } from '../types'

# A local, and the narrower type it has.
export struct Narrowing
  local: Local
  type: Type

# The locals a condition narrows where it holds, and where it does not.
export struct ConditionNarrowings
  where_true: Array<Narrowing>
  where_false: Array<Narrowing>

export const narrowings_where = (narrowings: ConditionNarrowings, value: Bool) ->
  value then narrowings.where_true else narrowings.where_false

# `x`, `x != nil`, `x == nil`, `x == v`, `x != v` and `x is T` test the name x: it is not nil, or
# is a T, where the condition has `condition_value`. For `x is T`, `is_type` is T, the type x then
# has; otherwise x is tested against nil. In `x == v`, v cannot be nil, so x is not nil where they
# are equal.
export struct TestedName
  name: Identifier
  condition_value: Bool
  is_type: NamedType?

export const tested_name = (body: Body, condition: Condition): TestedName? ->
  case condition
    when Identifier then TestedName(name: condition, condition_value: true, is_type: nil)
    when IsTest
      const value = condition.value
      return nil if not (value is Identifier)
      TestedName name: value, condition_value: true, is_type: condition.type
    when BinaryOperation
      const operator = condition.operator
      return nil if operator != '==' and operator != '!='
      if const name = nil_tested(condition.left, condition.right)
        return TestedName(name, condition_value: operator == '!=', is_type: nil)
      const name = value_tested(body, condition.left, condition.right) ? return nil
      TestedName name, condition_value: operator == '==', is_type: nil
    else nil

# The name that one side compares with a value on the other that cannot be nil.
const value_tested = (body: Body, left: Expression, right: Expression) ->
  const cannot_be_nil = (operand: Expression) ->
    const type = body.shared.types[operand] ? return false
    not (type is OptionalType or is_kind(type, 'nil'))
  case
    when left is Identifier and cannot_be_nil(right) then left
    when right is Identifier and cannot_be_nil(left) then right
    else nil

# The name that one side compares with nil on the other.
const nil_tested = (left: Expression, right: Expression) ->
  const tested = case
    when left is NilLiteral then right
    when right is NilLiteral then left
    else nil
  tested is Identifier then tested else nil

# A body that cannot go on past its end: it ends with an expression that never gives a value,
# such as `return`, `break`, `continue`, `throw` or a call to `exit`, or an `if` whose branches
# both end so.
export const ends_with_jump = (
  statements: Array<Statement>
  is_never: (Expression) -> Bool
): Bool ->
  return false if statements.length == 0
  const last = statements[statements.length - 1]
  case last
    when If
      ends_with_jump(last.then_body, is_never) and ends_with_jump(last.else_body, is_never)
    else
      const expression = as_expression(last) ? return false
      is_never expression

# A view of a local with a narrower type, which marks the local itself as used.
export const narrowed_view = (local: Local, type: Type) ->
  const { identifier, mutable, used } = local
  const view = Local(identifier, type, mutable, used, declared: false, origin: local.origin ? local)
  view.captured = local.captured
  view

# `not` swaps where its operand narrows. In `a and b`, b is evaluated where a holds, and both
# narrow where the whole holds; in `a or b`, b is evaluated where a does not hold, and both narrow
# where the whole does not.
export const narrowings_of = (body: Body, condition: Condition): ConditionNarrowings ->
  if condition is UnaryOperation and condition.operator == 'not'
    const inner = narrowings_of(body, condition.operand)
    return ConditionNarrowings(where_true: inner.where_false, where_false: inner.where_true)
  if condition is BinaryOperation
    const operator = condition.operator
    return narrowings_of_logical(body, condition) if operator == 'and' or operator == 'or'
  const tested = tested_narrowing(body, condition) ? return narrowings_only_where([], true)
  narrowings_only_where [tested.narrowing], tested.condition_value

# Both operands narrow where `a and b` holds, or where `a or b` does not.
const narrowings_of_logical = (body: Body, logical: BinaryOperation) ->
  const value = logical.operator == 'and'
  const first = narrowings_where(narrowings_of(body, logical.left), value)
  var second: Array<Narrowing> = []
  where_right_operand body, logical, () ->
    second = narrowings_where(narrowings_of(body, logical.right), value)
  const both = [narrowing for narrowing in first]
  both.push narrowing for narrowing in second
  narrowings_only_where both, value

const narrowings_only_where = (narrowings: Array<Narrowing>, value: Bool) ->
  return ConditionNarrowings(where_true: narrowings, where_false: []) if value
  ConditionNarrowings where_true: [], where_false: narrowings

# Runs `check` where the right operand of `a and b` is evaluated, which is where a holds, or of
# `a or b`, where a does not.
export const where_right_operand = (body: Body, logical: BinaryOperation, check: () -> void) ->
  const left = narrowings_of(body, logical.left)
  body.scopes.push()
  narrow body, narrowings_where(left, logical.operator == 'and')
  check()
  body.scopes.pop()

# Until the innermost scope ends, the locals are seen with the narrower types.
export const narrow = (body: Body, narrowings: Array<Narrowing>) ->
  for narrowing in narrowings
    const { local, type } = narrowing
    body.scopes.narrow local.identifier.name, narrowed_view(local, type)

struct TestedNarrowing
  narrowing: Narrowing
  condition_value: Bool

# The local a test such as `x != nil` narrows, and the value of the condition where it does. Only
# a local that cannot be reassigned is narrowed.
const tested_narrowing = (body: Body, condition: Condition): TestedNarrowing? ->
  const tested = tested_name(body, condition) ? return nil
  const local = lookup(body, tested.name.name) ? return nil
  return nil if local.mutable
  const { condition_value } = tested
  if const is_type = tested.is_type
    return nil if not (inner_of(local.type) is UnionType)
    const type = resolve(body.program, body.resolver, is_type)
    return TestedNarrowing(condition_value, narrowing: Narrowing(local, type))
  const type = local.type
  return nil if not (type is OptionalType)
  TestedNarrowing condition_value, narrowing: Narrowing(local, type: type.inner)
