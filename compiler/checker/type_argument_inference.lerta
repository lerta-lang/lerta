# Finds the type arguments of a call of a generic function or method: those written, and those
# inferred from the receiver, the arguments and the type the call is expected to have.
import
  ArrayLiteral, Call, Expression, FunctionLiteral, IntegerLiteral, MapLiteral, NilLiteral, Position,
  RecordLiteral, StringLiteral, TupleLiteral
from '../ast'
import fail from './diagnostics'
import may_name_member from './enums'
import expect_type, type_of from './expression'
import GenericFunction from './generics'
import infer_through_members from './satisfaction'
import Body from './shared'
import resolve from './type_names'
import has_type_parameters, infer, substitute from './type_patterns'
import
  inner_of, InterfaceType, is_kind, OptionalType, same_type, Type, TypeParameterType
from '../types'

# A type argument, and where it was given or inferred from.
export struct TypeBinding
  type: Type
  at: Position

# An argument typed alone, which its parameter must take once the type arguments are known.
export struct InferredArgument
  arg: Expression
  type: Type
  index: Int

export struct Inference
  bindings: Map<String, TypeBinding>
  inferred: InferredArgument[]

# The type arguments of a generic method that the receiver gives, if it gives all of them: those
# of an extend of a type match its type, and those of an extend of an interface come from how the
# receiver satisfies it (see declare_interface_extend).
export const receiver_type_arguments = (
  body: Body, generic: GenericFunction, receiver: Type, at: Position
) ->
  const bindings: Map<String, Type> = Map()
  const bind = (name: String, type: Type) -> bindings[name] = type if not bindings.has(name)
  const pattern = generic.receiver!.type
  infer pattern, receiver, bind
  # The receiver of an extend of an interface is Self, the first type parameter.
  infer_through_members body, generic.bounds[0]!, receiver, at, bind if pattern is TypeParameterType
  return nil if generic.type_params.any((param) -> not bindings.has(param.name.name))
  [bindings[param.name.name]! for param in generic.type_params]

# The call has as many arguments as the generic has parameters.
export const infer_type_arguments = (
  body: Body, call: Call, generic: GenericFunction, expected: Type?, receiver: TypeBinding?
) ->
  const params = generic.params
  const bindings = written_bindings(body, call, generic)
  const written: Map<String, Bool> = Map()
  written.add name for name in bindings.keys()
  const inferred: InferredArgument[] = []
  const bind_at = (at: Position) ->
    (name: String, bound_type: Type) ->
      # nil and never tell nothing about the type.
      return if is_kind(bound_type, 'nil') or is_kind(bound_type, 'never')
      if const bound = bindings[name]
        return if written.has(name) or not widens(bound.type, bound_type)
      bindings[name] = TypeBinding(at, type: bound_type)
  # A value converts to an interface type, whose type arguments its members may give.
  const bind_from = (pattern: Type, type: Type, at: Position) ->
    infer pattern, type, bind_at(at)
    const target = inner_of(pattern)
    const value_type = inner_of(type)
    if target is InterfaceType and value_type is not InterfaceType
      infer_through_members body, target, value_type, at, bind_at(at)
  bind_from generic.receiver!.type, receiver.type, receiver.at if receiver
  const check_argument = (index: Int) ->
    const arg = call.args[index]
    const param = substitute(params[index], types_of(bindings))
    if not has_type_parameters(param) and needs_context(body, arg)
      expect_type body, arg, param
      return
    # A function literal's parameters may take the types that are known already.
    const type = type_of(body, arg, arg is FunctionLiteral then param)
    fail body.program, arg.position, 'expected a value, got void' if is_kind(type, 'void')
    bind_from params[index], type, arg.position
    inferred.push InferredArgument(arg, type, index)
  const is_function = (i: Int) -> call.args[i] is FunctionLiteral
  const is_literal = (i: Int) -> needs_context(body, call.args[i]) and not is_function(i)
  for arg, i in call.args
    check_argument i if not needs_context(body, arg)
  if const result = generic.result
    bind_from result, expected, call.position if expected
  for i in 0...call.args.length
    check_argument i if is_literal(i)
  # The type argument of a bounded type parameter gives those that its bound names, as `X:
  # Iterable<T>` gives T, before function literals take their parameters' types.
  const bind_from_bounds = ->
    for (type_param, written_bound) in generic.type_params.zip(generic.bounds)
      const bound = written_bound ? continue
      const known = bindings[type_param.name.name] ? continue
      infer_through_members body, bound, known.type, known.at, bind_at(known.at)
  bind_from_bounds()
  for i in 0...call.args.length
    check_argument i if is_function(i)
  Inference bindings, inferred

const widens = (bound: Type, type: Type) ->
  type is OptionalType then same_type(type.inner, bound) else false

# `f<Int>(x)` gives all the type arguments; `x.f<Int>(y)`, those of the method's own, as the
# receiver gives the extend's.
const written_bindings = (body: Body, call: Call, generic: GenericFunction) ->
  const bindings: Map<String, TypeBinding> = Map()
  const { name } = generic
  const type_params = generic.literal.type_params
  return bindings if call.type_args.length == 0
  if call.type_args.length != type_params.length
    const counts = "takes #{type_params.length} type argument(s), got #{call.type_args.length}"
    fail body.program, call.position, "'#{name.name}' #{counts}"
  for (type_param, type_name) in type_params.zip(call.type_args)
    const type = resolve(body.program, body.resolver, type_name)
    bindings[type_param.name.name] = TypeBinding(type, at: type_name.position)
  bindings

# A literal whose type may depend on what is expected of it, or a name that may stand for a
# member of an enum.
export const needs_context = (body: Body, arg: Expression) ->
  case arg
    when FunctionLiteral, NilLiteral, IntegerLiteral, StringLiteral then true
    when ArrayLiteral, MapLiteral, RecordLiteral, TupleLiteral then true
    else may_name_member(body, arg)

const types_of = (bindings: Map<String, TypeBinding>) ->
  const types: Map<String, Type> = Map()
  types[name] = binding.type for (name, binding) in bindings.entries()
  types
