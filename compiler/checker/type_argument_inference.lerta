# Finds the type arguments of a call of a generic function or method: those written, and those
# inferred from the receiver, the arguments and the type the call is expected to have.
import
  ArrayLiteral, binary_literal_bytes, Call, Expression, FloatLiteral, FunctionLiteral,
  IntegerLiteral, MapLiteral, NilLiteral, Position, RecordLiteral, StringLiteral, TupleLiteral
from '../ast'
import keep_constructions from './collection'
import fail from './diagnostics'
import is_function_reference from './function_references'
import may_name_member from './enums'
import expect_type, type_of from './expression'
import GenericFunction from './generics'
import float_first from './literals'
import infer_through_members from './satisfaction'
import Body from './shared'
import resolve from './type_names'
import is_pattern, infer, substitute from './type_patterns'
import
  inner_of, InterfaceType, is_kind, is_one_of_kinds, OptionalType, Type, TypeParameterType
from '../types'

# A type argument, and where it was given or inferred from.
export struct TypeBinding
  type: Type
  at: Position

# An argument typed alone, which its parameter must take once the type arguments are known.
export struct InferredArgument
  arg: Expression
  type: Type
  index: Int

export struct Inference
  bindings: Map<String, TypeBinding>
  inferred: InferredArgument[]

# The type arguments of a generic method that the receiver gives, if it gives all of them: those
# of an extend of a type match its type, and those of an extend of an interface come from how the
# receiver satisfies it (see declare_interface_extend).
export receiver_type_arguments := (
  body: Body, generic: GenericFunction, receiver: Type, at: Position
) ->
  bindings: Map<String, Type>
  bind := (name: String, type: Type) -> bindings[name] = type unless name in bindings
  pattern := generic.receiver!.type
  infer pattern, receiver, bind

  # The receiver of an extend of an interface is Self, the first type parameter.
  if pattern is TypeParameterType
    infer_through_members body, generic.bounds[0]!, receiver, at, bind

  return nil if generic.type_params.any((param) -> param.name.name not in bindings)
  [bindings[param.name.name]! for param in generic.type_params]

# The call's arguments, as it passes them, are as many as the generic has parameters.
export infer_type_arguments := (
  body: Body, call: Call, args: Expression[], generic: GenericFunction, expected: Type?,
  receiver: TypeBinding?
) ->
  bindings := written_bindings(body, call, generic)
  inferrer := Inferrer(body, args, generic, bindings)
  if receiver
    inferrer.bind_from generic.receiver!.type, receiver.type, receiver.at

    # An argument cannot widen the type arguments the receiver gives, as `T` of `Int[]` to `Int?`,
    # which the receiver does not hold.
    inferrer.fixed.add name for name in inferrer.bindings.keys()
  is_function := (i: Int) -> takes_function_type(body, args[i])
  is_literal := (i: Int) -> needs_context(body, args[i]) and not is_function(i)
  for arg at i in args
    inferrer.check_argument i unless needs_context(body, arg)
  if result := generic.result
    if expected
      inferrer.bind_from result, expected, call.position
  literals := [i for i in 0..args.length when is_literal(i)]
  inferrer.check_argument i for i in float_first(literals, (i) -> args[i])
  inferrer.bind_from_bounds()
  for i in 0..args.length
    inferrer.check_argument i if is_function(i)
  Inference(bindings, inferred: inferrer.inferred)

# The type arguments of a call as they are found, from those written on.
class Inferrer
  args
    body: Body
    args: Expression[]
    generic: GenericFunction
    bindings: Map<String, TypeBinding>

  # The names of the type arguments written or given by the receiver, which nothing inferred
  # replaces.
  private
    fixed := Set(@bindings.keys())
    inferred: InferredArgument[] = []

    bind_at := (at: Position) ->
      (name: String, bound_type: Type) ->
        # nil and never tell nothing about the type.
        return if is_one_of_kinds(bound_type, ['nil', 'never'])
        if bound := @bindings[name]
          return if name in @fixed or not widens(bound.type, bound_type)
        @bindings[name] = { at, type: bound_type }

    # A value converts to an interface type, whose type arguments its members may give.
    bind_from := (pattern: Type, type: Type, at: Position) ->
      infer pattern, type, @bind_at(at)
      target := inner_of(pattern)
      value_type := inner_of(type)
      if target is InterfaceType and value_type is not InterfaceType
        infer_through_members @body, target, value_type, at, @bind_at(at)

    check_argument := (index: Int) ->
      body := @body
      arg := @args[index]
      declared := @generic.params[index]
      param := substitute(declared, types_of(@bindings))

      # A parameter whose type names no type parameter takes its argument as in any call.
      declared_alone := not is_pattern(declared)
      if declared_alone or (needs_context(body, arg) and not is_pattern(param))
        expect_type body, arg, param

        # The other arguments gave the type, which the constructions in the literal show as theirs
        # do.
        keep_constructions body, [arg] unless declared_alone
        return

      # A function literal's parameters may take the types that are known already.
      expected :=
        if takes_function_type(body, arg)
          param
        else
          nil
      type := type_of(body, arg, expected)

      if is_kind(type, 'void')
        fail body.program, arg.position, 'expected a value, got void'
      @bind_from declared, type, arg.position
      @inferred.push { arg, type, index }

    # The type argument of a bounded type parameter gives those that its bound names, as `X:
    # Iterable<T>` gives T, before function literals take their parameters' types.
    bind_from_bounds := ->
      for (type_param, written_bound) in @generic.type_params.zip(@generic.bounds)
        bound := written_bound else continue
        known := @bindings[type_param.name.name] else continue
        infer_through_members @body, bound, known.type, known.at, @bind_at(known.at)

widens := (bound: Type, type: Type) -> type is OptionalType then type.inner == bound else false

# `f<Int>(x)` gives the first type arguments, and the others are inferred; `x.f<Int>(y)` gives
# those of the method's own, as the receiver gives the extend's.
written_bindings := (body: Body, call: Call, generic: GenericFunction) ->
  bindings: Map<String, TypeBinding>
  { name } := generic
  type_params := generic.literal.type_params
  if call.type_args.length > type_params.length
    counts := "takes #{type_params.length} type argument(s), got #{call.type_args.length}"
    fail body.program, call.position, "'#{name.name}' #{counts}"
  for type_name at i in call.type_args
    type := resolve(body.program, body.resolver, type_name)
    bindings[type_params[i].name.name] = { type, at: type_name.position }
  bindings

# A literal whose type may depend on what is expected of it, or a name that may stand for a
# member of an enum.
export needs_context := (body: Body, arg: Expression) ->
  case arg
    when
      FunctionLiteral, NilLiteral, IntegerLiteral, FloatLiteral, StringLiteral, ArrayLiteral,
      MapLiteral, RecordLiteral, TupleLiteral
    then true
    else
      is_literal := binary_literal_bytes(arg) != nil
      is_literal or may_name_member(body, arg) or is_function_reference(body, arg)

# A function literal and a function reference take the parameters' types that are known already.
export takes_function_type := (body: Body, arg: Expression) ->
  arg is FunctionLiteral or is_function_reference(body, arg)

types_of := (bindings: Map<String, TypeBinding>) ->
  types: Map<String, Type>
  types[name] = binding.type for (name, binding) in bindings
  types
