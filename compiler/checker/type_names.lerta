# Types written in the source, such as `Array<Int>` in an annotation.
import {
  FunctionTypeName, Identifier, NamedType, Position, RecordTypeField, RecordTypeName, TypeAlias
  TypeName, UnionTypeName
} from '../ast'
import { fail } from './diagnostics'
import { imported_type } from './imports'
import { ProgramWide, Shared } from './shared'
import {
  ArrayType, binary_type, bool_type, byte_type, format_type, FunctionType, int_type, IterType
  is_kind, is_map_key_type, is_reference_type, MapType, never_type, ObjectType, optional_type
  OptionalType, record_type, RecordField, same_type, string_type, Type, union_type, UnionType
  void_type
} from '../types'

# Names of builtin types, which a class or struct cannot take.
export const is_builtin_type_name = (name: String) ->
  simple_type(name) != nil or ['Array', 'Iter', 'Map', 'void', 'never'].any((each) -> each == name)

const simple_type = (name: String) ->
  case name
    when 'Int' then int_type
    when 'String' then string_type
    when 'Bool' then bool_type
    when 'Byte' then byte_type
    when 'Binary' then binary_type
    else nil

export class AliasEntry
  alias: TypeAlias
  type: Type? = nil

# Resolves type names in a module, including its classes and structs and those it imports; the
# names of type parameters stand for the given types, as in the body of a generic function.
export struct Resolver
  module_index: Int
  type_parameters: Map<String, Type>

export const module_resolver = (module_index: Int) ->
  Resolver module_index, type_parameters: Map()

export const with_type_parameters = (
  resolver: Resolver
  type_parameters: Map<String, Type>
) -> Resolver(type_parameters, module_index: resolver.module_index)

# A class, struct or imported type of the name, marking its import as used.
const named_type = (program: ProgramWide, shared: Shared, name: String): Type? ->
  if const info = shared.objects[name]
    return info.type
  if const exported = imported_type(program, shared, name)
    return exported.type
  nil

# Whether the name is that of a type, which a type parameter cannot take.
export const has_type = (program: ProgramWide, resolver: Resolver, name: String) ->
  const shared = program.shared[resolver.module_index]
  return true if is_builtin_type_name(name) or named_type(program, shared, name) != nil
  has_alias shared, name

export const add_alias = (program: ProgramWide, shared: Shared, alias: TypeAlias) ->
  const { name, position } = alias.name
  const is_taken = shared.aliases.has(name) or is_builtin_type_name(name)
  if is_taken or named_type(program, shared, name) != nil
    fail program, position, "'#{name}' is already defined"
  shared.aliases[name] = AliasEntry(alias)

# Resolves every alias, so that an alias that is never used is checked too.
export const resolve_aliases = (program: ProgramWide, shared: Shared) ->
  const resolver = module_resolver(shared.index)
  for name in shared.aliases.keys()
    resolve_alias program, resolver, name, shared.aliases[name]!.alias.name.position

export const alias_type = (program: ProgramWide, shared: Shared, name: Identifier) ->
  resolve_alias(program, module_resolver(shared.index), name.name, name.position)!

export const has_alias = (shared: Shared, name: String) -> shared.aliases.has(name)

export const resolve = (program: ProgramWide, resolver: Resolver, type_name: TypeName) ->
  resolve_type program, resolver, type_name, false

# `void` and `never` are only allowed as a return type.
export const resolve_result = (
  program: ProgramWide
  resolver: Resolver
  type_name: TypeName
) -> resolve_type(program, resolver, type_name, true)

const resolve_type = (
  program: ProgramWide
  resolver: Resolver
  type_name: TypeName
  is_result: Bool
) ->
  case type_name
    when UnionTypeName then resolve_union(program, resolver, type_name)
    when RecordTypeName
      const type = resolve_record(program, resolver, type_name)
      optional_if program, type, type_name.position, type_name.optional
    when FunctionTypeName
      const type = resolve_function(program, resolver, type_name)
      optional_if program, type, type_name.position, type_name.optional
    when NamedType
      const type = resolve_name(program, resolver, type_name, is_result)
      optional_if program, type, type_name.position, type_name.optional

const optional_if = (program: ProgramWide, type: Type, at: Position, optional: Bool) ->
  return type if not optional
  if is_kind(type, 'void') or is_kind(type, 'never')
    fail program, at, "#{format_type(type)} cannot be optional"
  if type is OptionalType
    fail program, at, "#{format_type(type)} cannot be optional again: its nil would be ambiguous"
  optional_type type

const resolve_record = (
  program: ProgramWide
  resolver: Resolver
  type_name: RecordTypeName
): Type ->
  const names: Map<String, Bool> = Map()
  for field in type_name.fields
    const { name, position } = field.name
    fail program, position, "'#{name}' is already a field" if names.has(name)
    names[name] = true
  const resolve_field = (field: RecordTypeField) ->
    RecordField name: field.name.name, type: resolve(program, resolver, field.type)
  record_type [resolve_field(field) for field in type_name.fields]

const resolve_function = (
  program: ProgramWide
  resolver: Resolver
  type_name: FunctionTypeName
): Type ->
  const params = [resolve(program, resolver, param) for param in type_name.params]
  FunctionType params, result: resolve_result(program, resolver, type_name.result)

# A union holds classes and structs; a member that is itself a union is flattened.
const resolve_union = (
  program: ProgramWide
  resolver: Resolver
  type_name: UnionTypeName
): Type ->
  const members: Array<Type> = []
  for member in type_name.members
    const type = resolve(program, resolver, member)
    case type
      when UnionType
        members.push(each) for each in type.members
      when ObjectType then members.push(type)
      else
        const message = "a union can only hold classes and structs so far, not #{format_type(type)}"
        fail program, member.position, message
  const unique: Array<Type> = []
  for type in members
    unique.push(type) if not unique.any((other) -> same_type(other, type))
  union_type unique

const resolve_alias = (program: ProgramWide, resolver: Resolver, name: String, at: Position) ->
  const shared = program.shared[resolver.module_index]
  const entry = shared.aliases[name] ? return nil
  if const type = entry.type
    return type
  fail program, at, "the type '#{name}' refers to itself" if shared.resolving.has(name)
  shared.resolving[name] = true
  const type = resolve(program, resolver, entry.alias.type)
  entry.type = type
  shared.resolving.remove(name)
  type

const resolve_name = (
  program: ProgramWide
  resolver: Resolver
  type_name: NamedType
  is_result: Bool
): Type ->
  const { name, args, position } = type_name
  const fail_here = (message: String) -> fail(program, position, message)
  case name
    when 'Array'
      fail_here 'Array takes one type argument' if args.length != 1
      return ArrayType(element: resolve_element(program, resolver, args[0]))
    when 'Iter'
      fail_here 'Iter takes one type argument' if args.length != 1
      return IterType(item: resolve(program, resolver, args[0]))
    when 'Map'
      fail_here 'Map takes two type arguments' if args.length != 2
      const key = resolve_key(program, resolver, args[0])
      return MapType(key, value: resolve_map_value(program, resolver, args[1]))
    else
      fail_here "'#{name}' takes no type arguments" if args.length > 0
  return void_type if is_result and name == 'void'
  return never_type if is_result and name == 'never'
  if const parameter = resolver.type_parameters[name]
    return parameter
  if const simple = simple_type(name)
    return simple
  if const named = named_type(program, program.shared[resolver.module_index], name)
    return named
  resolve_alias(program, resolver, name, position) ? fail_here("unknown type '#{name}'")

# A type parameter's type argument is checked where it is given (see generic_call).
const resolve_key = (program: ProgramWide, resolver: Resolver, type_name: TypeName) ->
  const type = resolve(program, resolver, type_name)
  if not is_map_key_type(type) and not is_kind(type, 'TypeParameter')
    const message = "a map key must be a String, an Int or a class, got #{format_type(type)}"
    fail program, type_name.position, message
  type

# A missing key reads as nil, so a value cannot be nil itself.
const resolve_map_value = (program: ProgramWide, resolver: Resolver, type_name: TypeName) ->
  const type = resolve(program, resolver, type_name)
  if type is OptionalType
    fail program, type_name.position, "a map cannot hold values of type #{format_type(type)}"
  type

# An array item is 8 bytes, which cannot hold an optional Int, Byte or Bool.
const resolve_element = (program: ProgramWide, resolver: Resolver, type_name: TypeName) ->
  const type = resolve(program, resolver, type_name)
  if type is OptionalType and not is_reference_type(type)
    const message = "an array cannot hold values of type #{format_type(type)} yet"
    fail program, type_name.position, message
  type
