# Types written in the source, such as `Int[]` in an annotation.
import
  ArrayTypeName, FunctionTypeName, Identifier, NamedType, Position, RecordTypeField, RecordTypeName,
  TupleTypeName, TypeAlias, TypeName, UnionTypeName
from '../ast'
import check_item_type, check_map_value, reject_map_key from './collection'
import fail, fail_already_defined from './diagnostics'
import
  builtin_type, has_import, import_qualified_type, imported_type, imports_value
from './imports'
import
  has_declared_type, imported_interface, named_interface, value_interface_type
from './interfaces'
import ProgramWide, record_type_name, Shared from './shared'
import reject_invalid_instance from './type_validity'
import
  ArrayType, binary_type, bool_type, char_type, float32_type, float_type, format_type, FunctionType,
  inner_of, INTEGER_KINDS, is_kind, is_union_member, IterType, MapType, never_type, ObjectType,
  optional_type, OptionalType, PromiseType, record_type, RecordField, set_of, SimpleType,
  string_type, TupleType, Type, TypeKind, union_of, UnionType, void_type
from '../types'

# Names of the types that the compiler declares, which the module's names shadow, but which a
# type parameter cannot take.
is_core_type_name := (name: String) ->
  simple_type(name) != nil or ['Iter', 'Promise', 'Map', 'Set', 'void', 'never'].contains(name)

# The parts of the written type that name the type of the name, wherever they are in it.
export named_in := (type_name: TypeName?, name: String) ->
  [named for named in named_types_in(type_name) when named.name == name]

# The names in the written type, in all its parts, outer ones first.
export named_types_in := (type_name: TypeName?) ->
  found: NamedType[]
  collect_named type_name, found
  found

collect_named := (type_name: TypeName?, found: NamedType[]): void ->
  written := type_name ? return
  collect := (part: TypeName) -> collect_named(part, found)
  case written
    when NamedType
      found.push written
      collect arg for arg in written.args
    when FunctionTypeName
      collect param for param in written.params
      collect written.result
    when RecordTypeName then collect(field.type) for field in written.fields
    when TupleTypeName then collect(item) for item in written.items
    when UnionTypeName then collect(member) for member in written.members
    when ArrayTypeName then collect(written.element)

simple_type := (name: String) ->
  case name
    when 'Float' then float_type
    when 'Float32' then float32_type
    when 'String' then string_type
    when 'Bool' then bool_type
    when 'Binary' then binary_type
    when 'Char' then char_type
    else
      kind := TypeKind.parse(name) ? return nil
      INTEGER_KINDS.contains(kind) then SimpleType(kind)

export class AliasEntry
  alias: TypeAlias
  type: Type? = nil

# Resolves type names in a module, including its classes and structs and those it imports; the
# names of type parameters stand for the given types, as in the body of a generic function.
export struct Resolver
  module_index: Int
  type_parameters: Map<String, Type>

export module_resolver := (module_index: Int) -> Resolver(module_index, type_parameters: Map())

export with_type_parameters := (resolver: Resolver, type_parameters: Map<String, Type>) ->
  Resolver(resolver..., type_parameters)

# A class, struct, enum or imported type of the name, or else a type that std:builtins exports
# unless an alias takes the name, marking its import as used.
export named_type := (shared: Shared, name: String): Type? ->
  return info.type if info := shared.objects[name]
  return own if own := shared.enums[name]
  return declared.type if declared := shared.interfaces[name]
  return exported.type if exported := imported_type(shared, name)
  return imported.type if imported := imported_interface(shared, name)
  return nil if has_alias(shared, name)
  return builtin.type if builtin := builtin_type(shared, name)
  nil

# Whether the name is that of a type, which a type parameter cannot take.
export has_type := (program: ProgramWide, resolver: Resolver, name: String) ->
  shared := program.shared[resolver.module_index]
  return true if is_core_type_name(name) or named_type(shared, name) != nil
  has_alias shared, name

export add_alias := (shared: Shared, alias: TypeAlias) ->
  program := shared.program
  { name } := alias.name
  is_taken := shared.aliases.has(name) or has_declared_type(shared, name)
  fail_already_defined program, alias.name if is_taken
  shared.aliases[name] = AliasEntry(alias)

# Resolves every alias, so that an alias that is never used is checked too.
export resolve_aliases := (shared: Shared) ->
  resolver := module_resolver(shared.index)
  for (name, declared) in shared.aliases.entries()
    resolve_alias shared.program, resolver, name, declared.alias.name.position

export alias_type := (shared: Shared, name: Identifier) ->
  resolve_alias(shared.program, module_resolver(shared.index), name.name, name.position)!

export has_alias := (shared: Shared, name: String) -> shared.aliases.has(name)

# Whether a type, an alias or an import of the module takes the name, which a top-level function
# or value cannot then take.
export names_type_or_import := (shared: Shared, name: String) ->
  has_declared_type(shared, name) or has_alias(shared, name) or has_import(shared, name)

# Whether a top-level value or function of the module, or a value it imports, takes the name,
# which then names no type in the module, as types and values share one namespace.
names_value := (shared: Shared, name: String) ->
  { names, function_names } := shared.top_level
  names.has(name) or function_names.has(name) or imports_value(shared, name)

export resolve := (program: ProgramWide, resolver: Resolver, type_name: TypeName) ->
  resolve_type program, resolver, type_name, false

export resolve_result := (program: ProgramWide, resolver: Resolver, type_name: TypeName) ->
  resolve_type program, resolver, type_name, true

resolve_type := (program: ProgramWide, resolver: Resolver, type_name: TypeName, is_result: Bool) ->
  return resolve_union(program, resolver, type_name) if type_name is UnionTypeName
  type: Type =
    case type_name
      when RecordTypeName then resolve_record(program, resolver, type_name)
      when FunctionTypeName then resolve_function(program, resolver, type_name)
      when TupleTypeName then resolve_tuple(program, resolver, type_name)
      when NamedType then resolve_name(program, resolver, type_name, is_result)
      when ArrayTypeName
        ArrayType element: resolve_element(program, resolver, type_name.element)
  optional_if program, type, type_name.position, type_name.optional

optional_if := (program: ProgramWide, type: Type, at: Position, optional: Bool) ->
  return type if not optional
  if is_kind(type, 'void') or is_kind(type, 'never')
    fail program, at, "#{format_type(type)} cannot be optional"
  if type is OptionalType
    fail program, at, "#{format_type(type)} cannot be optional again: its nil would be ambiguous"
  optional_type type

resolve_record := (program: ProgramWide, resolver: Resolver, type_name: RecordTypeName): Type ->
  names: Set<String>
  for field in type_name.fields
    { name, position } := field.name
    fail program, position, "'#{name}' is already a field" if not names.add(name)
  resolve_field := (field: RecordTypeField) ->
    RecordField name: field.name.name, type: resolve(program, resolver, field.type)
  record_type [resolve_field(field) for field in type_name.fields]

resolve_tuple := (program: ProgramWide, resolver: Resolver, type_name: TupleTypeName): Type ->
  TupleType items: [resolve(program, resolver, item) for item in type_name.items]

resolve_function := (program: ProgramWide, resolver: Resolver, type_name: FunctionTypeName): Type ->
  params := [resolve(program, resolver, param) for param in type_name.params]
  FunctionType params, result: resolve_result(program, resolver, type_name.result)

# A member that is optional, as `String?` in `Int | String?`, makes the union optional: nil is one
# of its values.
resolve_union := (program: ProgramWide, resolver: Resolver, type_name: UnionTypeName): Type ->
  resolve_member := (member: TypeName) ->
    resolved := resolve(program, resolver, member)
    type := inner_of(resolved)
    if type is not UnionType and not is_union_member(type)
      objects := 'arrays, maps, tuples, anonymous structs and interfaces'
      kinds := "classes, structs, numbers, Bool, String, Binary, enums, #{objects}"
      message := "a union can only hold #{kinds} so far, not #{format_type(type)}"
      fail program, member.position, message
    resolved
  # Its members are all a union's, so only more than one array or map type makes it none.
  members := [resolve_member(member) for member in type_name.members]
  return union if union := union_of(members)
  message := 'a union holds one array type and one map type at most, which it tells apart so far'
  fail program, type_name.position, message

resolve_alias := (program: ProgramWide, resolver: Resolver, name: String, at: Position) ->
  shared := program.shared[resolver.module_index]
  entry := shared.aliases[name] ? return nil
  return type if type := entry.type
  fail program, at, "the type '#{name}' refers to itself" if not shared.resolving.add(name)
  type := resolve(program, resolver, entry.alias.type)
  entry.type = type
  shared.resolving.remove name
  type

resolve_name := (
  program: ProgramWide, resolver: Resolver, type_name: NamedType, is_result: Bool
): Type ->
  { name, args, position } := type_name
  fail_here := (message: String) -> fail(program, position, message)
  shared := program.shared[resolver.module_index]
  import_qualified_type shared, type_name
  if parameter := resolver.type_parameters[name]
    fail_here "'#{name}' takes no type arguments" if not args.is_empty()
    return parameter
  fail_here "'#{name}' is a value, not a type" if names_value(shared, name)
  if not names_type_or_import(shared, name) and is_core_type_name(name)
    return resolve_core_type(program, resolver, type_name, is_result)
  interface_info := named_interface(program, resolver, name)
  named := named_type(shared, name)
  generic_object := named is ObjectType and not named.args.is_empty()
  takes_arguments := interface_info != nil or generic_object
  fail_here "'#{name}' takes no type arguments" if not args.is_empty() and not takes_arguments
  declared :=
    case
      when interface_info then value_interface_type(program, resolver, interface_info, type_name)
      when generic_object
        instantiate_object program, resolver, named as ObjectType!, type_name
      else named
  if declared
    record_type_name shared, type_name, declared
    return declared
  type := resolve_alias(program, resolver, name, position) ? fail_here("unknown type '#{name}'")
  record_type_name shared, type_name, type
  shared.alias_names[type_name] = shared.aliases[name]!.alias.name
  type

# A type of a name that is_core_type_name accepts.
resolve_core_type := (
  program: ProgramWide, resolver: Resolver, type_name: NamedType, is_result: Bool
): Type ->
  { name, args, position } := type_name
  fail_here := (message: String) -> fail(program, position, message)
  case name
    when 'Iter'
      fail_here 'Iter takes one type argument' if args.length != 1
      return IterType(item: resolve(program, resolver, args[0]))
    when 'Promise'
      fail_here 'Promise takes one type argument, or none' if args.length > 1
      return PromiseType(value: void_type) if args.is_empty()
      return PromiseType(value: resolve(program, resolver, args[0]))
    when 'Map'
      fail_here 'Map takes two type arguments' if args.length != 2
      key := resolve_key(program, resolver, args[0])
      return MapType(key, value: resolve_map_value(program, resolver, args[1]))
    when 'Set'
      fail_here 'Set takes one type argument' if args.length != 1
      return set_of(resolve_key(program, resolver, args[0], 'a set item'))
    else pass
  fail_here "'#{name}' takes no type arguments" if not args.is_empty()
  return void_type if is_result and name == 'void'
  return never_type if is_result and name == 'never'
  simple_type(name) ? fail_here("unknown type '#{name}'")

# The written generic class or struct, with its type arguments.
export instantiate_object := (
  program: ProgramWide, resolver: Resolver, generic: ObjectType, type_name: NamedType
) ->
  { args, position } := type_name
  count := generic.args.length
  if args.length != count
    fail program, position, "'#{generic.name}' takes #{count} type argument(s), got #{args.length}"
  resolved := [resolve(program, resolver, arg) for arg in args]
  { name, symbol, module, is_struct } := generic
  type := ObjectType(name, symbol, module, is_struct, args: resolved)
  reject_invalid_instance program, resolver.module_index, type, position
  type

# A type parameter's type argument is checked where it is given (see generic_call).
resolve_key := (
  program: ProgramWide
  resolver: Resolver
  type_name: TypeName
  role = 'a map key'
) ->
  type := resolve(program, resolver, type_name)
  reject_map_key program, type, type_name.position, role if not is_kind(type, TYPE_PARAMETER)
  type

resolve_map_value := (program: ProgramWide, resolver: Resolver, type_name: TypeName) ->
  type := resolve(program, resolver, type_name)
  check_map_value program, type, type_name.position
  type

resolve_element := (program: ProgramWide, resolver: Resolver, type_name: TypeName): Type ->
  check_item_type program, resolve(program, resolver, type_name), type_name.position, 'an array'
