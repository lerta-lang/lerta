# Checks the arguments of calls: their count, and those that a call passes otherwise than as written,
# its variadic arguments packed into an array and its named arguments gathered into an argument of
# its last parameter (see NodeFacts.arguments).
import
  ArrayLiteral, Call, Expression, FunctionLiteral, is_spread, NamedValue, Parameter, RecordLiteral
from '../ast'
import fail from './diagnostics'
import expect_type, require_type from './expression'
import is_struct_type, required_params from './functions'
import struct_construction, type_of_expected_construction from './object'
import Body from './shared'
import format_type, FunctionType, inner_of, nil_type, ObjectType, RecordType, Type from '../types'

# The result of a call of a function of the type, once its arguments are checked. `declaration`,
# the function's literal if the call knows it, tells the parameters that may be left out.
export check_arguments := (
  body: Body, call: Call, callee_type: Type, declaration: FunctionLiteral?
) ->
  program := body.program
  if callee_type is not FunctionType
    fail program, call.position, "cannot call a value of type #{format_type(callee_type)}"
  params := callee_type.params
  packed := packed_arguments(body, call, declaration)
  args := packed ? call.args
  leaves_out_struct := args.length == params.length - 1 and is_struct_type(params.last())
  gathers := call.named_args.length > 0 or leaves_out_struct
  gathered := gathers then gathered_argument(body, call, params.last())
  passed := gathered then [args..., gathered] else args
  check_argument_count body, call, passed.length, params.length, declaration
  expect_type body, arg, params[i] for arg, i in args
  check_gathered body, gathered, params.last()! if gathered
  body.facts.arguments[call] = passed if packed or gathered
  callee_type.result

export check_argument_count := (
  body: Body, call: Call, count: Int, param_count: Int, declaration: FunctionLiteral?
) ->
  required := declaration then required_params(declaration) else param_count
  return if count >= required and count <= param_count
  range := required == param_count then '' else "#{required} to "
  expected := "#{range}#{param_count}"
  fail body.program, call.position, "expected #{expected} argument(s), got #{count}"

# The arguments with those from the place of the declaration's variadic parameter on packed into
# one, an array literal of them, `f(a, [b, c])` of `f(a, b, c)` for `f = (x: Int, rest: Int...)`, as
# codegen passes them; a spread among them is one of the literal. Nil if the declaration has no
# variadic parameter. A spread anywhere else is an error.
export packed_arguments := (body: Body, call: Call, declaration: FunctionLiteral?) ->
  program := body.program
  params := declaration?.params ? []
  place := params.find_index((param) -> param.variadic)
  packed := place != nil then pack_from(body, call, params, place)
  if spread := (packed ? call.args).find(is_spread)
    fail
      program
      spread.position
      'a spread `xs...` can only be an item of an array or an argument of a variadic parameter'
  packed

pack_from := (body: Body, call: Call, params: Parameter[], place: Int) ->
  fixed := [arg for arg, i in call.args when i < place]
  if spread := fixed.find(is_spread)
    rest := params[place].name.name
    fail
      body.program
      spread.position
      "a spread fills only the variadic parameter '#{rest}', after the others"
  count := call.args.length
  if count < place
    fail body.program, call.position, "expected at least #{place} argument(s), got #{count}"
  elements := [arg for arg, i in call.args when i >= place]
  position := elements.first()?.position ? call.position
  [fixed..., ArrayLiteral(elements, position)]

# Named arguments, none where a last parameter of a struct type is left out, are gathered into an
# argument of that parameter: an anonymous struct, or a construction of the struct, so that codegen,
# which reads named arguments only as a construction, generates the call as any other.
gathered_argument := (body: Body, call: Call, last_param: Type?): Expression ->
  position := call.named_args.first()?.name.position ? call.position
  type := inner_of(last_param ? nil_type)
  if type is RecordType
    fields := [NamedValue(name: arg.name, value: arg.value) for arg in call.named_args]
    return RecordLiteral(fields, position)
  return struct_construction(type as ObjectType!, call.named_args, position) if is_struct_type(type)
  uses := 'construct a class or struct, or give a last parameter of a struct type'
  fail body.program, position, "named arguments #{uses}"

# The gathered argument must fit the last parameter.
check_gathered := (body: Body, gathered: Expression, param: Type) ->
  return expect_type(body, gathered, param) if gathered is not Call
  require_type body, gathered, type_of_expected_construction(body, gathered, param), param
