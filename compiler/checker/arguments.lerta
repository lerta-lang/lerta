# Checks the arguments of calls: their count, and those that a call passes otherwise than as
# written, its variadic arguments packed into an array and its named arguments gathered into an
# argument of its last parameter (see NodeFacts.arguments).
import
  ArrayLiteral, Call, Expression, FunctionLiteral, Identifier, is_spread, NamedType, Parameter,
  RecordLiteral
from '../ast'
import fail from './diagnostics'
import expect_type, require_type, type_of from './expression'
import is_struct_type, required_params from './functions'
import struct_construction, type_of_expected_construction from './object'
import Body from './shared'
import
  format_type, FunctionType, inner_of, nil_type, ObjectType, RecordType, Type, TypeParameterType
from '../types'

# The result of a call of a function of the type, once its arguments are checked. `declaration`,
# the function's literal if the call knows it, tells the parameters that may be left out.
export check_arguments := (
  body: Body, call: Call, callee_type: Type, declaration: FunctionLiteral?
) ->
  program := body.program
  unless callee_type is FunctionType
    fail program, call.position, "cannot call a value of type #{format_type(callee_type)}"
  params := callee_type.params
  packed := packed_arguments(body, call, declaration)
  args := packed ? call.args
  if gathers_per_instance(call, args, params)
    expect_type body, arg, params[i] for arg at i in args
    type_of body, arg.value for arg in call.named_args
    return callee_type.result
  gathered := gathered_of(body, call, args, params)
  passed := gathered then [args..., gathered] else args
  check_argument_count body, call, declaration, given: passed.length, params: params.length
  expect_type body, arg, params[i] for arg at i in args
  check_gathered body, gathered, params.last()! if gathered
  body.facts.arguments[call] = passed if packed or gathered
  callee_type.result

export check_argument_count := (
  body: Body, call: Call, declaration: FunctionLiteral?, counts: { given: Int, params: Int }
) ->
  { given, params } := counts
  required := declaration then required_params(declaration) else params
  return if given in required..=params
  range := required == params then '' else "#{required} to "
  message := "expected #{range}#{params} argument(s), got #{given}"
  var split = given
  split += comparisons_more(arg) for arg in call.args
  hint := '; `a<b, c>(d)` is a call with type arguments: write spaces around `<` and `>` to compare'
  fail body.program, call.position, split in required..=params then message + hint else message

# How many arguments more the argument would be as the comparisons that it may have been meant
# for: `a<b, c>(d)`, without spaces, is one call with type arguments, while `a < b, c > d` is two
# comparisons.
comparisons_more := (arg: Expression) ->
  call := arg as Call ? return 0
  { callee, args, type_args } := call
  names := type_args.all((type) -> type is NamedType and type.args.is_empty() and not type.optional)
  may_be := callee is Identifier and args.length == 1 and type_args.length > 1 and names
  may_be then type_args.length - 1 else 0

# The arguments with those from the place of the declaration's variadic parameter on packed into
# one, an array literal of them, `f(a, [b, c])` of `f(a, b, c)` for `f = (x: Int, rest: Int...)`, as
# codegen passes them; a spread among them is one of the literal. Nil if the declaration has no
# variadic parameter. A spread anywhere else is an error.
export packed_arguments := (body: Body, call: Call, declaration: FunctionLiteral?) ->
  program := body.program
  params := declaration?.params ? []
  place := params.find_index((param) -> param.variadic)
  packed := place != nil then pack_from(body, call, params, place)
  if spread := (packed ? call.args).find(is_spread)
    fail
      program
      spread.position
      'a spread `xs...` can only be an item of an array or an argument of a variadic parameter'
  packed

pack_from := (body: Body, call: Call, params: Parameter[], place: Int) ->
  # There may be fewer arguments than `place`, which is reported below, after a spread among them.
  fixed := call.args[..min(place, call.args.length)]
  if spread := fixed.find(is_spread)
    rest := params[place].name.name
    fail
      body.program
      spread.position
      "a spread fills only the variadic parameter '#{rest}', after the others"
  count := call.args.length
  if count < place
    fail body.program, call.position, "expected at least #{place} argument(s), got #{count}"
  elements := call.args[place..]
  position := elements.first()?.position ? call.position
  [fixed..., ArrayLiteral(elements, position)]

# Whether the call gathers named arguments, or none, into a last parameter of a type parameter
# standing for itself, which only an instance tells to be a struct, an anonymous one or neither.
gathers_per_instance := (call: Call, args: Expression[], params: Type[]) ->
  last := inner_of(params.last() ? nil_type)
  return false if last is not TypeParameterType or not last.standing
  not call.named_args.is_empty() or args.length == params.length - 1

# The argument that the named arguments, or none where a last parameter of a struct type is left
# out, are gathered into, if there is one.
export gathered_of := (body: Body, call: Call, args: Expression[], params: Type[]) ->
  leaves_out := args.length == params.length - 1 and is_struct_type(params.last())
  return nil if call.named_args.is_empty() and not leaves_out
  gathered_argument body, call, params.last()

# Named arguments, none where a last parameter of a struct type is left out, are gathered into an
# argument of that parameter: an anonymous struct, or a construction of the struct, so that codegen,
# which reads named arguments only as a construction, generates the call as any other.
gathered_argument := (body: Body, call: Call, last_param: Type?): Expression ->
  position := call.named_args.first()?.name.position ? call.position
  type := inner_of(last_param ? nil_type)
  if type is RecordType
    fields := [arg for arg in call.named_args]
    return RecordLiteral(fields, position)
  if is_struct_type(type)
    return struct_construction(type as ObjectType!, call.named_args, nil, position)
  uses := 'construct a class or struct, or give a last parameter of a struct type'
  fail body.program, position, "named arguments #{uses}"

# The gathered argument must fit the last parameter.
export check_gathered := (body: Body, gathered: Expression, param: Type) ->
  return expect_type(body, gathered, param) unless gathered is Call
  require_type body, gathered, type_of_expected_construction(body, gathered, param), param
