# The `const`s and `var`s at the top level of a module, which its functions and methods see.
import Declaration, FunctionLiteral, Identifier, Statement from '../ast'
import abort_part, fail from './diagnostics'
import Local from './scopes'
import ProgramWide from './shared'

export class TopLevelValues
  names: Set<String>
  # The top-level functions, known before they are declared, as types are resolved earlier.
  function_names: Set<String>
  # A value's local once the top-level code has declared it; until then its type is unknown.
  locals: Map<String, Local> = Map()
  # The values whose declarations have an error, which what uses them cannot be checked without.
  failed: Set<String> = Set()
  # Whether the top-level code is being checked or has been: until then, only the top-level code
  # of a module that runs before this one, in the same import cycle, can need a value's type.
  started = false

# A top-level declaration whose value is not a function literal.
export top_level_value := (statement: Statement) ->
  return nil if statement is not Declaration
  statement.value is FunctionLiteral then nil else statement

export top_level_values := (program: Statement[]) ->
  names: Set<String>
  function_names: Set<String>
  for statement in program
    continue if statement is not Declaration
    set := statement.value is FunctionLiteral then function_names else names
    set.add statement.name.name
  TopLevelValues names, function_names

# A use of a value whose declaration has an error cannot be checked, and has no error of its own.
export abort_if_failed := (values: TopLevelValues, name: String) ->
  abort_part() if name in values.failed

# Called as the top-level code declares the value.
export define_top_level := (values: TopLevelValues, local: Local) ->
  values.locals[local.identifier.name] = local

# Rejects a use of a value whose type is not known yet.
export reject_pending := (program: ProgramWide, values: TopLevelValues, identifier: Identifier) ->
  { name, position } := identifier
  return if name not in values.names or name in values.locals
  fail_runs_later program, identifier, 'this module', true if not values.started
  reason := 'as it is declared below code that needs it here'
  advice := 'declare it before, or write the type of this function or field'
  message := "the type of '#{name}' is not known yet, #{reason}; #{advice}"
  fail program, position, message

# Rejects a use of a value of `module`, of the same import cycle, whose type is not known yet;
# `in_function` is a function whose return type is inferred or a field initializer.
export fail_runs_later := (
  program: ProgramWide, identifier: Identifier, module: String, in_function: Bool
) ->
  advice :=
    if in_function
      "#{module} runs after the top-level code that needs this function or field; write its type"
    else
      "#{module} runs after this module; read it in a function whose return type is written"
  message := "the type of '#{identifier.name}' is not known yet, as #{advice}"
  fail program, identifier.position, message
