# Checks a type that type arguments make, as the signature of a generic function's instance, the
# fields of a generic class's or the members of a generic interface's, as a written type is checked
# (see type_names).
import Position from '../ast'
import check_map_types, check_value_type, reject_map_key from './collection'
import check_part, in_module from './diagnostics'
import members_for from './interfaces'
import reject_unsatisfied_object_bounds from './object_bounds'
import info_of from './object_types'
import ProgramWide from './shared'
import Resolver from './type_names'
import is_pattern, parts_of from './type_patterns'
import
  ArrayType, InterfaceType, is_set, IterType, MapType, ObjectType, Type, type_key
from '../types'

# Fails at `at`, where the type is given, if a part of it is invalid.
export reject_invalid_type := (program: ProgramWide, type: Type, at: Position): void ->
  if type is ArrayType
    check_value_type program, type.element, at, 'an array'
  if type is IterType
    check_value_type program, type.item, at, 'an Iter'
  if type is MapType
    reject_invalid_map program, type, at
  if type is ObjectType
    reject_invalid_instance_types program, type, at
  if type is InterfaceType
    reject_invalid_instance_types program, type, at
  for part in parts_of(type)
    reject_invalid_type program, part, at

# A set's value type, void, is no map value.
reject_invalid_map := (program: ProgramWide, type: MapType, at: Position) ->
  if is_set(type)
    return reject_map_key(program, type.key, at, 'a set item')
  check_map_types program, type.key, type.value, at, at

# Checks the field types of an instance of a generic class or struct, or the member types of one of
# a generic interface, where the module gives it, once they are known, and the bounds of the
# former's type arguments, by the bounds of the type parameters that the resolver has.
export reject_invalid_instance := (
  program: ProgramWide, resolver: Resolver, type: ObjectType | InterfaceType, at: Position
) ->
  if program.members_known
    reject_invalid_instance_types program, type, at
  else
    { module_index, bounds } := resolver
    program.early_instances.push { type, at, module_index, bounds }
  if type is ObjectType
    reject_unsatisfied_object_bounds program, resolver, type, at

# Checks the instances given before the fields and members were known, each as a part of the
# program.
export check_early_instances := (program: ProgramWide) ->
  program.members_known = true
  for instance in program.early_instances
    shared := program.shared[instance.module_index]
    in_module shared, ->
      check_part program, -> reject_invalid_instance_types(program, instance.type, instance.at)

# Reports each instance once, where it is first given; which also ends the check of a field or a
# member whose type holds the instance itself, as `next: Node<T>?` does.
reject_invalid_instance_types := (
  program: ProgramWide, type: ObjectType | InterfaceType, at: Position
) ->
  return if type.args.is_empty() or is_pattern(type)
  case type
    when ObjectType
      info := info_of(program, type)
      return if info.fields_checked
      info.fields_checked = true
      for field in info.fields
        if field_type := field.type
          reject_invalid_type program, field_type, at
    when InterfaceType
      key := type_key(type)
      return if key in program.checked_interfaces
      program.checked_interfaces[key] = true
      for member in members_for(program, type, type)
        reject_invalid_type program, member.type, at
