# Intrinsics: the functions of standard modules that the compiler gives (see Intrinsic). A call of
# one is checked, and generated, as the code that the checker makes for it in its place, in the
# scope of the call, so that what follows sees its locals and its narrowings (see
# NodeFacts.intrinsic_calls).
import scan from 'std:scanner'
import
  Binding, BinaryOperation, Call, copy_identifier, Declaration, Expression, Identifier, If,
  Intrinsic, IsTest, Member, NilLiteral, Position, Range, Statement, StringLiteral, This, Throw,
  UnaryOperation
from '../ast'
import fail from './diagnostics'
import may_name_member, type_of_enum_query from './enums'
import expect_type, set_type, type_of from './expression'
import type_of_codable_call from './codable'
import ExternReference from './references'
import add_intrinsic, builtins_declarer from './imports'
import record_reference from './name'
import is_contextual from './literals'
import has_method from './member'
import Body, Shared from './shared'
import Local from './scopes'
import module_resolver, resolve from './type_names'
import SYSTEMS from '../platform_description'
import check_block, check_if_condition, define_local, nothing from './statement'
import CLOSING_BRACKETS, lex, OPENING_BRACKETS, Token, TokenKind from '../lexer/tokens'
import is_standard_name, module_location from '../source'
import
  ArrayType, bool_type, EnumType, format_type, is_one_of_kinds, OptionalType, string_type, Type,
  void_type
from '../types'

INTRINSICS := ['assert', 'dbg', 'encode_value', 'decode_value', 'parse', 'members']

# What an intrinsic value is, as a message tells it, and whether a declared type is that.
struct ValueIntrinsic
  described: String
  fits: (Type) -> Bool

# The values, by their names: whether the build is optimized, as by -O, and the system that it is
# for, the member of the enum that the target's system names, which codegen finds.
VALUE_INTRINSICS :=
  'optimized': ValueIntrinsic(described: 'of type Bool', fits: (type) -> type == bool_type)
  'platform': ValueIntrinsic(described: 'an enum of a member for each system', fits: names_systems)

names_systems := (type: Type) ->
  type is EnumType and SYSTEMS.all((system) -> { text: system, is_name: false } in type.members)

# Only a standard module declares intrinsics, and only those that the compiler gives: a function
# without a type, and a value with its type.
export declare_intrinsics := (shared: Shared, statements: Statement[]) ->
  program := shared.program
  for statement in statements
    continue unless statement is Intrinsic
    { name } := statement
    unless is_standard_name(module_location(program.entry_path, shared.path))
      fail program, statement.position, 'only a standard module can declare an intrinsic'
    type := declared_type(shared, statement)
    known := type then name.name in VALUE_INTRINSICS else name.name in INTRINSICS
    fail program, name.position, "no intrinsic '#{name.name}'" unless known
    add_intrinsic shared, name, type

# The type of an intrinsic value, which must be the one that the compiler gives it; nil for a
# function.
declared_type := (shared: Shared, statement: Intrinsic) ->
  type_name := statement.type ? return nil
  program := shared.program
  type := resolve(program, module_resolver(shared.index), type_name)
  expected := VALUE_INTRINSICS[statement.name.name] ? return type
  unless expected.fits(type)
    fail program, type_name.position, "intrinsic '#{statement.name.name}' is #{expected.described}"

  type

# The code that the checker makes for a call of an intrinsic, which codegen generates in its place:
# its statements, then its value, if it gives one.
export struct IntrinsicCode
  statements: Statement[]
  value: Expression?

# The type of the call. `encode_value` and `decode_value` of std:codable, and `parse` and
# `members` of std:enums, are calls of the code that codegen makes for each type (see
# type_of_codable_call and type_of_enum_query); the others give code of their own.
export type_of_intrinsic_call := (body: Body, call: Call, name: String, expected: Type?) ->
  return type_of_codable_call(body, call, ENCODE) if name == 'encode_value'
  return type_of_codable_call(body, call, DECODE) if name == 'decode_value'
  return type_of_enum_query(body, call, PARSE) if name == 'parse'
  return type_of_enum_query(body, call, MEMBERS) if name == 'members'
  reject_named_arguments body, call, name
  code :=
    case name
      when 'assert' then IntrinsicCode(statements: assertion(body, call), value: nil)
      else debugged(body, call, expected)
  body.facts.intrinsic_calls[call] = code
  value := code.value ? return void_type
  type_of body, value

reject_named_arguments := (body: Body, call: Call, name: String) ->
  return if call.named_args.is_empty() and call.type_args.is_empty()
  fail body.program, call.position, "#{name} takes no named or type arguments"

# `assert condition`: throws an AssertionError if the condition does not hold, and narrows what
# follows where it does, as a guard. The message tells where, quotes the call, and gives the values
# of the operands of a comparison or of `is` that the source does not write as literals.
assertion := (body: Body, call: Call) ->
  fail body.program, call.position, 'assert takes one condition' if call.args.length != 1
  held := Held(body, prefix: local_prefix('assert', call.position))
  test := held_test(held, call.args[0])
  shown := -> [operand_text(body, each) for each in held.shown]
  statements: Statement[] = [held.declarations..., guard(body, call, test, shown)]
  statements

# The guard that throws an AssertionError where the test does not hold, checked so that what
# follows is narrowed where it does. `shown` gives the texts that the message adds, made where the
# test does not hold, as the operands are narrowed there.
guard := (body: Body, call: Call, test: Expression, shown: () -> Expression[]): Statement ->
  at := call.position
  failure := Throw(position: at, message: NilLiteral(at), assertion: true)
  negated := UnaryOperation(operator: 'not', operand: test, position: at)
  checked := If(position: at, condition: negated, then_body: [failure], else_body: [])
  entries := check_if_condition(body, checked)
  enter_failure := ->
    entries.enter_then()
    quoted: Expression = text(quoted_call(body, call), at)
    failure.message = shown().iter().fold(quoted, concatenation)
  check_block body, checked.then_body, enter_failure, nothing
  entries.enter_else()
  checked

# The condition with the operands that it compares, or tests by `is`, held (see Held.hold), and so
# those of the one that `not` negates, as `x is not T` and `x not in xs` are read. The test is
# checked once first, as any test is, so that each operand has the type and the conversion that
# Held.hold reads; a path is checked there by a copy, as the guard checks the path itself, which
# narrowing needs.
held_test := (held: Held, condition: Expression): Expression ->
  if condition is UnaryOperation and condition.operator == 'not' and is_test(condition.operand)
    return UnaryOperation(condition..., operand: held_test(held, condition.operand))
  return condition unless is_test(condition)
  copied := (operand: Expression, _label: String) ->
    is_path(operand) then copied_path(operand) else operand
  type_of held.body, with_operands(condition, copied)
  with_operands condition, (operand, label) -> held.hold(operand, label)

COMPARISONS := ['==', '!=', '<', '<=', '>', '>=', 'in']

is_test := (expression: Expression) ->
  expression is IsTest or (expression is BinaryOperation and expression.operator in COMPARISONS)

# The test with each operand, and each part of a range after `in`, which is no value, given by
# `operand`, in the order that they are evaluated, with a label for the message.
with_operands := (test: Expression, operand: (Expression, String) -> Expression): Expression ->
  part := (value: Expression?, label: String) -> value then operand(value, label)
  case test
    when BinaryOperation
      { right } := test
      left := operand(test.left, 'left')
      changed_right :=
        if right is Range
          Range(right..., start: part(right.start, 'start'), end: part(right.end, 'end'))
        else
          operand right, 'right'
      BinaryOperation(test..., left, right: changed_right)
    when IsTest then IsTest(test..., value: operand(test.value, 'value'))
    else test

# An operand that a failed assertion shows, by its label and the expression that reads it again.
struct Shown
  label: String
  value: Expression

# The locals that hold the operands of an assertion, and the operands that its message shows.
class Held
  body: Body
  prefix: String
  declarations: Declaration[] = []
  shown: Shown[] = []

  # An operand is held in a local of its own, of the type that the test gave it, so that the message
  # shows the value that was tested; the guard's test converts the local where it converted the
  # operand. A path, which narrowing needs as it is and which reads the same value again, is left
  # as it is, and so is what the source shows: a literal, nil, which makes the test one of nil, or
  # a name that stands for a member of an enum, which the message leaves out.
  hold := (operand: Expression, label: String) ->
    is_written := is_contextual(operand) or operand is NilLiteral or may_name_member(@body, operand)
    return operand if is_written
    read :=
      if is_path(operand)
        operand
      else
        name := "#{@prefix}.#{label}"
        facts := @body.facts
        type := facts.types[operand] ? type_of(@body, operand)
        facts.conversions.remove operand
        @declarations.push held_local(@body, name, operand, type)
        named name, operand.position
    @shown.push { label, value: copied_path(read) }
    read

# A name, `@` or a path of members from one.
is_path := (expression: Expression): Bool ->
  case expression
    when Identifier, This then true
    when Member then is_path(expression.object)
    else false

# A new node of the path, as each place in the code has a node of its own.
copied_path := (path: Expression): Expression ->
  case path
    when Identifier then copy_identifier(path)
    when This then This(path.position)
    when Member then Member(path..., object: copied_path(path.object))
    else panic('not a path')

# `dbg(value)`: writes where the call is, its code and the literal of the value to stderr, and
# gives the value, which it evaluates once, typed where it is expected.
debugged := (body: Body, call: Call, expected: Type?) ->
  fail body.program, call.position, 'dbg takes one value' if call.args.length != 1
  at := call.position
  name := "#{local_prefix('dbg', at)}.value"
  value := call.args[0]
  held := held_local(body, name, value, type_of(body, value, expected))
  # nil alone has no type to hold it by, and void and never have no value.
  held_type := type_of(body, named(name, at))
  if is_one_of_kinds(held_type, ['nil', 'void', 'never'])
    message := "dbg takes a value, not one of type #{format_type(held_type)}"
    fail body.program, call.args[0].position, message
  shown := literal_text(body, named(name, at)) ? text(
    "<#{format_type(type_of(body, named(name, at)))}>"
    at
  )
  line :=
    concatenation(concatenation(text("#{quoted_call(body, call)} = ", at), shown), text("\n", at))
  IntrinsicCode statements: [held, stderr_write(body, line)], value: named(name, at)

# The call of std:builtins' C function that writes the text to stderr, typed here rather than
# checked, as a name of the program's own could hide the function's.
stderr_write := (body: Body, text: Expression): Statement ->
  program := body.program
  symbol := 'lerta_print_stderr'
  expect_type body, text, string_type
  callee := named(symbol, text.position)
  call := Call(callee, position: text.position, args: [text], named_args: [], type_args: [])
  declarer := builtins_declarer(program, 'print_error')
  record_reference body, callee, ExternReference(symbol, module_index: declarer.index, name: symbol)
  set_type body, callee, program.extern_types[symbol]!.type
  set_type body, call, void_type
  call

# The label and the literal of the operand, or nothing if its type has no literal (see
# literal_text).
operand_text := (body: Body, shown: Shown): Expression ->
  at := shown.value.position
  literal := literal_text(body, shown.value) ? return text('', at)
  concatenation label_text(shown.label, at), literal

label_text := (label: String, at: Position) -> text("\n  #{label}: ", at)

# The literal of the value, nil if its type has none: that of an optional value is `nil` or the
# literal of what it holds.
literal_text := (body: Body, value: Expression): Expression? ->
  type := type_of(body, value)
  return member_call(value, 'to_literal') if has_literal(body, type, value.position)
  return nil if type is not OptionalType or not has_literal(body, type.inner, value.position)
  present_or value, 'nil', (inner) -> member_call(inner, 'to_literal')

# An array has a to_literal only where its items have one, which looking it up for other items
# would report as an error.
has_literal := (body: Body, type: Type, at: Position): Bool ->
  return has_literal(body, type.element, at) if type is ArrayType
  has_method body, type, Identifier(name: 'to_literal', position: at)

# `if v := value then present(v) else absent`, of a name that no source can write.
present_or := (value: Expression, absent: String, present: (Expression) -> Expression) ->
  at := value.position
  name := local_prefix('present', at)
  binding := Binding(value, position: at, name: named(name, at))
  then_body: Statement[] = [present(named(name, at))]
  If then_body, position: at, condition: binding, else_body: [text(absent, at)]

# The start of the names of the locals that the code made for a call at the position has, which no
# source can write.
local_prefix := (name: String, at: Position) -> "#{name}@#{at.line}:#{at.column}"

# The declaration of a local of the type that holds the value, defined in the scope. It is defined
# here rather than checked as a declaration, which at the top level would take a function for one
# of the module's own functions, which are known before checking.
held_local := (body: Body, name: String, value: Expression, type: Type) ->
  at := value.position
  declaration := Declaration(value, position: at, mutable: false, type: nil, name: named(name, at))
  define_local
    body
    Local(type, identifier: declaration.name, declared: true, scope_depth: body.scopes.depth())
  declaration

named := (name: String, at: Position) -> Identifier(name, position: at)

text := (value: String, at: Position) -> StringLiteral(value, position: at)

member := (object: Expression, name: String) ->
  Member object, position: object.position, name: named(name, object.position)

member_call := (object: Expression, name: String) -> call_of(member(object, name), object.position)

call_of := (callee: Expression, at: Position) ->
  Call callee, position: at, args: [], named_args: [], type_args: []

concatenation := (left: Expression, right: Expression): Expression ->
  BinaryOperation left, right, operator: '+', position: left.position

# Where the call is, as diagnostics name it, and its code as written.
quoted_call := (body: Body, call: Call) ->
  shared := body.shared
  at := call.position
  program := shared.program
  module := program.modules[shared.index]
  location := module_location(program.entry_path, shared.path)
  tokens := shared.source_tokens ? lex(module.source, location).tokens
  shared.source_tokens = tokens
  "#{location}:#{at.line}:#{at.column}: #{code_at(module.source, tokens, at)}"

# The code of the source, of the tokens given, that starts at the position, through the end of its
# line, or of the line that closes the brackets it opens; a comment after it is left out.
code_at := (source: String, tokens: Token[], at: Position) ->
  starts_there := (token: Token) ->
    token.line == at.line and token.column == at.column and token.kind not in LINE_ENDS
  start := tokens.find_index(starts_there) ? return ''
  last := tokens[last_of_code(tokens, start)]
  lines := source.lines()
  return columns(lines[at.line - 1], at.column, last.end_column) if last.end_line == at.line
  parts := [columns(lines[at.line - 1], at.column, INT_MAX)]
  parts.push lines[line - 1] for line in (at.line + 1)..last.end_line
  parts.push columns(lines[last.end_line - 1], 1, last.end_column)
  parts.join "\n"

# The place of the last token of the call whose callee is at `start`: the `)` that closes its
# arguments if they are in parentheses, as the call may be part of an expression; else the last
# before the end of its line or a bracket that it does not open.
last_of_code := (tokens: Token[], start: Int) ->
  next := tokens[start + 1]
  in_parentheses := next.kind == '(' and not next.spaced
  var depth = 0
  var last = start
  for i in start..tokens.length
    kind := tokens[i].kind
    if kind in OPENING_BRACKETS
      depth += 1
    else if kind in CLOSING_BRACKETS
      break if depth == 0
      depth -= 1
      return i if depth == 0 and in_parentheses
    else if depth == 0 and kind in LINE_ENDS
      break
    last = i
  last

LINE_ENDS: TokenKind[] = [NEWLINE, INDENT, DEDENT, EOF]

# The text from the column `start` up to `end`, counted in code points from 1.
columns := (line: String, start: Int, end: Int) ->
  scanner := scan(line)
  scanner.next() for _ in 1..start
  taken := scanner.mark()
  for _ in start..end
    break if scanner.done()
    scanner.next()
  taken()
