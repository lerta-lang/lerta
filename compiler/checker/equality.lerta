# Which values `==` compares, and which can be map keys (see
# docs/reference/objects.md#equality-and-order).
import Position from '../ast'
import field_type, info_of from './object_types'
import ProgramWide from './shared'
import
  ArrayType, EnumType, is_identity_type, is_number, is_one_of_kinds, ObjectType, OptionalType,
  RecordType, SimpleType, TupleType, Type, TypeKind, UnionType
from '../types'

# The method by which a class or struct compares its values, `equals` or `compare`, if it has one
# of its own; others compare as the language does.
export own_equality := (program: ProgramWide, type: Type) ->
  return nil if type is not ObjectType
  methods := info_of(program, type).methods
  return 'equals' if 'equals' in methods
  'compare' in methods then 'compare'

# Whether the class or struct hashes its values with a `hash` of its own.
export has_own_hash := (program: ProgramWide, type: ObjectType) ->
  info_of(program, type).methods.contains('hash')

# Whether the type compares by its contents, or by a method of its own (see own_equality), rather
# than as a number, a text or an object.
export compares_by_contents := (program: ProgramWide, type: Type): Bool ->
  case type
    when ObjectType then type.is_struct or own_equality(program, type) != nil
    when RecordType, TupleType, ArrayType then true
    when UnionType
      not is_identity_type(type) or
        type.members.any((member) -> compares_by_contents(program, member))
    else false

# Whether `==` compares values of the type. `at` is where a struct's field types are needed, or nil
# for where each field is declared.
export is_equatable := (program: ProgramWide, type: Type, at: Position?) ->
  equatable program, type, at, false, Set()

# Whether values of the type can be map keys: they compare, and a type that compares by a method
# of its own hashes by one too, so that equal values have the same hash.
export is_hashable := (program: ProgramWide, type: Type, at: Position?) ->
  equatable program, type, at, true, Set()

# The simple types that compare by value but for the numbers.
VALUE_KINDS: TypeKind[] = ['Char', 'Bool', 'String', 'Binary']

equatable := (
  program: ProgramWide, type: Type, at: Position?, hashes: Bool, seen: Set<String>
): Bool ->
  all := (parts: Type[]) -> parts.all((part) -> equatable(program, part, at, hashes, seen))
  case type
    when SimpleType then is_number(type) or is_one_of_kinds(type, VALUE_KINDS)
    when EnumType then true
    when ObjectType
      return not hashes or has_own_hash(program, type) if own_equality(program, type)
      # A struct that holds itself, through an array, compares as far as its other parts do.
      return true if not type.is_struct or type.symbol in seen
      seen.add type.symbol
      info := info_of(program, type)
      all [field_type(program, info, field, at ? field.name.position) for field in info.fields]
    when RecordType then all([field.type for field in type.fields])
    when TupleType then all(type.items)
    when ArrayType then all([type.element])
    when OptionalType then all([type.inner])
    when UnionType then all(type.members)
    else false
