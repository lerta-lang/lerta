# Types classes and structs: construction, `@` and methods; and anonymous struct literals. Their
# fields are in fields.
import
  Call, Comprehension, construction_arguments, Expression, FunctionLiteral, Identifier, is_spread,
  Member, NamedType, NamedValue, Position, RecordLiteral, This
from '../ast'
import fail, fail_cannot_infer from './diagnostics'
import expect_type, reject_type_arguments, require_type, set_type, type_of from './expression'
import function_type_of, has_function, method_key from './functions'
import float_first from './literals'
import lookup, record_reference from './name'
import Constructor from './references'
import field_type, FieldInfo, info_of, is_argument, object_type, ObjectInfo from './object_types'
import Body from './shared'
import instantiate_object from './type_names'
import reject_invalid_instance from './type_validity'
import needs_context from './type_argument_inference'
import has_type_parameters, infer, substitute from './type_patterns'
import
  format_type, inner_of, is_kind, is_one_of_kinds, ObjectType, OptionalType, record_type,
  RecordField, RecordType, Type
from '../types'

# A call to the name of a class or struct, not shadowed by a local or a function, constructs one.
export constructed_type := (body: Body, callee: Expression) ->
  return nil if callee is not Identifier
  name := callee.name
  return nil if lookup(body, name) != nil or has_function(body.shared, name)
  type := object_type(body.shared, name) ? return nil
  body.facts.types[callee] = type
  type

# A construction of the struct, with the named arguments: a call of its name, which may name nothing
# or another type where the call is made, as type_of_expected_construction finds the struct by its
# type.
export struct_construction := (
  type: ObjectType, named_args: NamedValue[], spread: Comprehension?, position: Position
) ->
  callee := Identifier(position, name: type.name)
  Call callee, position, named_args, args: spread then [spread] else [], type_args: []

# The struct that the expected type is, or makes optional.
export expected_struct := (expected: Type?) ->
  given := expected ? return nil
  type := inner_of(given)
  type is ObjectType and type.is_struct then type

# A construction of the struct that is expected (see struct_construction), whose type arguments are
# inferred from the expected type's.
export type_of_expected_construction := (body: Body, call: Call, expected: Type) ->
  info := info_of(body.program, inner_of(expected) as ObjectType!)
  declared := info.generic?.type ? info.type
  set_type body, call, type_of_construction(body, call, declared, expected)

export type_of_construction := (
  body: Body, call: Call, declared: ObjectType, expected: Type?
): ObjectType ->
  program := body.program
  if expanded := expanded_construction(body, call, declared)
    body.facts.replacements[call] = expanded
    type := type_of_construction(body, expanded, declared, expected)
    set_type body, expanded, type
    return type
  reject_positional_args body, call, declared
  named_args := construction_arguments(call)
  typed: Map<Expression, Type>
  type := constructed_instance(body, call, named_args, declared, expected, typed)
  body.facts.types[call.callee] = type
  # The callee is a name (see constructed_type).
  record_reference body, call.callee as Identifier!, Constructor(type)
  info := info_of(program, type)
  given: Set<String>
  for arg in named_args
    { name, position } := arg.name
    fail program, position, "the argument '#{name}' is given twice" if not given.add(name)
    field_type := argument_type(body, info, arg)
    value := arg.value
    if value_type := typed[value]
      require_type body, value, value_type, field_type
    else
      expect_type body, value, field_type
  required := [field.name.name for field in required_fields(info)]
  for name in required
    fail program, call.position, "missing argument '#{name}'" if not given.has(name)
  is_given := (field: FieldInfo) -> not is_argument(field) or given.has(field.name.name)
  body.facts.full_constructions.add call if info.fields.all(is_given)
  type

# The construction that the call stands for, if it is written with a spread or a value alone.
expanded_construction := (body: Body, call: Call, declared: ObjectType): Call? ->
  return spread if spread := spread_construction(body, call, declared)
  positional_construction body, call, declared

# The fields without initializers that are not optional, whose arguments a construction must give.
required_fields := (info: ObjectInfo) ->
  [field for field in info.fields when field.value == nil and field.type! is not OptionalType]

# A construction from a value alone, `Error('failed')`, as that of the one argument that must be
# given, by its name (see NodeFacts.replacements).
positional_construction := (body: Body, call: Call, declared: ObjectType) ->
  value := positional_value(body, call, declared) ? return nil
  required := required_fields(info_of(body.program, declared))
  if required.length != 1
    message := "#{format_type(declared)} takes a value alone only where one argument must be given"
    fail body.program, value.position, message
  name := Identifier(position: value.position, name: required[0].name.name)
  { callee, type_args, position } := call
  Call callee, type_args, position, args: [], named_args: [{ name, value }]

# The one argument of a construction that is neither the name of one of its arguments (see
# construction_arguments) nor a spread.
export positional_value := (body: Body, call: Call, declared: ObjectType) ->
  return nil if call.args.length != 1 or not call.named_args.is_empty()
  value := call.args[0]
  return nil if is_spread(value)
  names_argument := value is Identifier and info_of(body.program, declared).field_named(value.name)
  names_argument then nil else value

# The field that a named argument gives, which must be an argument (see is_argument).
argument_field := (body: Body, info: ObjectInfo, arg: NamedValue) ->
  { name, position } := arg.name
  type := format_type(info.type)
  no_field := -> fail(body.program, position, "#{type} has no field '#{name}'")
  field := info.field_named(name) ? no_field()
  fail body.program, position, "#{type} computes its field '#{name}'" if not is_argument(field)
  field

# The type of the field that a named argument gives, which its default alone may give.
argument_type := (body: Body, info: ObjectInfo, arg: NamedValue) ->
  field_type body.program, info, argument_field(body, info, arg), arg.name.position

# The type that the call constructs: the declared class or struct, or an instance of a generic
# one. Its type arguments are those written, or else those that the expected type gives, then the
# named arguments typed alone, as for a generic function (see infer_type_arguments), whose types
# `typed` keeps.
constructed_instance := (
  body: Body, call: Call, named_args: NamedValue[], declared: ObjectType, expected: Type?,
  typed: Map<Expression, Type>
) ->
  program := body.program
  if declared.args.is_empty()
    reject_type_arguments body, call
    return declared
  info := info_of(program, declared)
  if not call.type_args.is_empty()
    type_name := NamedType(name: declared.name, args: call.type_args, position: call.position)
    return instantiate_object(program, body.resolver, declared, type_name)
  type_bindings: Map<String, Type>
  bind := (name: String, type: Type) ->
    return if is_kind(type, 'nil') or is_kind(type, 'never')
    type_bindings[name] = type if not type_bindings.has(name)
  infer declared, inner_of(expected), bind if expected
  infer_from := (arg: NamedValue, expected_type: Type?) ->
    type := type_of(body, arg.value, expected_type)
    typed[arg.value] = type
    infer argument_type(body, info, arg), type, bind
  is_literal := (arg: NamedValue) -> needs_context(body, arg.value)
  for arg in named_args
    infer_from arg, nil if not is_literal(arg)
  # A literal whose field's type is still unknown gives its own type, as `1` an Int.
  literals := [arg for arg in named_args when is_literal(arg)]
  for arg in float_first(literals, (arg) -> arg.value)
    pattern := substitute(argument_type(body, info, arg), type_bindings)
    continue if not has_type_parameters(pattern)
    infer_from arg, arg.value is FunctionLiteral then pattern
  args: Type[]
  type_name := declared.name
  for param in info.declaration.type_params
    name := param.name.name
    args.push
      type_bindings[name] ? fail_cannot_infer(program, call.position, name, type_name, type_name)
  { name, symbol, module, is_struct } := declared
  type := ObjectType(name, symbol, module, is_struct, args)
  reject_invalid_instance program, body.resolver.module_index, type, call.position
  type

# The class or struct of the type, if it has a method of the name.
export method_owner := (body: Body, object_type: Type, name: String) ->
  return nil if object_type is not ObjectType
  info_of(body.program, object_type).methods.has(name) then object_type

# The type of the method `name` of an object, or nil if the type is no class or struct with that
# method.
export object_method_type := (body: Body, object_type: Type, name: Identifier) ->
  owner := method_owner(body, object_type, name.name) ? return nil
  module_index := info_of(body.program, owner).module_index
  function_type_of body.program, module_index, method_key(owner.name, name.name), name.position

# `@` is a local of a method's body (see check_function_body), which a function literal in it
# captures like any other. An initializer has no such local, so `@` can only read fields there (see
# field_of).
export type_of_this := (body: Body, at: Expression) ->
  return local.type if local := lookup(body, '@')
  message :=
    if body.self
      'an initializer can only use `@` to read a field, as in `@name`'
    else
      "'@' can only be used in a method, a function literal in a method, or a field initializer"
  fail body.program, at.position, message

# A construction from a spread, `Point(p..., x: 1)`, as the construction of the arguments of p but
# those written, read from p (see NodeFacts.replacements): a value of the type constructed.
spread_construction := (body: Body, call: Call, declared: ObjectType): Call? ->
  spread := spread_argument(body, call.args, 'a construction') ? return nil
  source := spread.iterable
  type := type_of(body, source)
  object := type as ObjectType?
  is_same := object != nil and object.name == declared.name and object.module == declared.module
  if not is_same
    message := "a spread of #{format_type(declared)} must be one, not #{format_type(type)}"
    fail body.program, source.position, message
  rest := [arg for arg in call.args when arg != spread]
  { callee, type_args, position, named_args } := call
  written := Call(callee, type_args, position, named_args, args: rest)
  reject_positional_args body, written, declared
  names := Set([arg.name.name for arg in construction_arguments(written)])
  fields := info_of(body.program, object!).fields
  arguments := [field.name.name for field in fields when is_argument(field)]
  copied := [read_field(source, name) for name in arguments when not names.has(name)]
  Call callee, type_args, position, args: rest, named_args: [copied..., named_args...]

# A field of the value of a spread, read where it is, as the argument of that name.
read_field := (source: Expression, name: String) ->
  { position } := source
  NamedValue
    name: Identifier(position, name)
    value: Member(position, object: source, name: Identifier(position, name))

# The spread among the items, which must come first, alone, and be of a name, `@` or a path of
# fields from one, which reads nothing that the reads of its fields could change.
spread_argument := (body: Body, items: Expression[], holder: String) ->
  spreads := [item for item in items when is_spread(item)]
  first := spreads.first() ? return nil
  if spreads.length > 1 or items[0] != first
    fail body.program, first.position, "a spread comes first in #{holder}, once"
  spread := first as Comprehension!
  if not is_path(spread.iterable)
    message := 'a spread of a struct is of a name, `@` or a path of fields from one, so far'
    fail body.program, spread.iterable.position, message
  spread

is_path := (value: Expression): Bool ->
  value is Member then is_path(value.object) else value is Identifier or value is This

# A record where a struct is expected constructs it (see NodeFacts.replacements).
export type_of_record := (body: Body, record: RecordLiteral, expected: Type?): Type ->
  program := body.program
  if struct_type := expected_struct(expected)
    construction := struct_construction(struct_type, record.fields, record.spread, record.position)
    body.facts.replacements[record] = construction
    return type_of_expected_construction(body, construction, expected!)
  if spread := record.spread
    expanded := spread_record(body, record, spread)
    body.facts.replacements[record] = expanded
    return set_type(body, expanded, type_of_record(body, expanded, expected))
  names: Set<String>
  for field in record.fields
    { name, position } := field.name
    fail program, position, "'#{name}' is already a field" if not names.add(name)
  expected_fields := expected_record_fields(expected)
  type_of_field := (field: NamedValue) ->
    name := field.name.name
    value := field.value
    if expected_field := expected_fields.find((each) -> each.name == name)
      expect_type body, value, expected_field.type
      return RecordField(expected_field..., name)
    type := type_of(body, value)
    if is_one_of_kinds(type, ['void', 'never', 'nil'])
      fail program, value.position, "a field cannot hold a value of type #{format_type(type)}"
    RecordField name, type
  record_type [type_of_field(field) for field in record.fields]

# An anonymous struct from a spread, `{ r..., z: 1 }`, as the anonymous struct of the fields of r
# but those written, read from r, and those (see NodeFacts.replacements).
spread_record := (body: Body, record: RecordLiteral, spread: Comprehension) ->
  spread_argument body, [spread], 'an anonymous struct'
  source := spread.iterable
  type := type_of(body, source)
  if type is not RecordType
    message := "a spread of an anonymous struct must be one, not #{format_type(type)}"
    fail body.program, source.position, message
  names := Set([field.name.name for field in record.fields])
  copied := [read_field(source, field.name) for field in type.fields when not names.has(field.name)]
  RecordLiteral fields: [copied..., record.fields...], position: record.position

expected_record_fields := (expected: Type?): RecordField[] ->
  type := expected ? return []
  record := inner_of(type)
  record is RecordType then record.fields else []

# A construction's arguments are named, or names alone (see construction_arguments).
reject_positional_args := (body: Body, call: Call, type: ObjectType) ->
  if not_named := call.args.find((arg) -> arg is not Identifier)
    example := "Point(x: 1) or Point(x), or with one value alone, as in Error('failed')"
    message := "#{format_type(type)} is constructed with named arguments, as in #{example}"
    fail body.program, not_named.position, message
