# Values of interface types. A value of a type that satisfies an interface converts to it where the
# interface is expected; the conversion records the plan of the itab through which the interface
# value reads the type's members (see codegen interface).
import Expression, Identifier, Position from '../ast'
import fail from './diagnostics'
import receiver_instance from './generic_call'
import Instance from './generics'
import InterfaceMember, iter_source_type, members_for, std_interface from './interfaces'
import find_member, generic_method, member_type_by_name from './member'
import MemberTarget, Method from './member_targets'
import ObjectInfo from './object_types'
import reject_unsatisfied, satisfies from './satisfaction'
import Body, Shared from './shared'
import module_resolver from './type_names'
import
  format_type, inner_of, InterfaceType, is_one_of_kinds, is_reference_type, IterType, Type,
  TypeParameterType, UnionType
from '../types'

# How the type gives a member of the interface: by a method, with the instance of a generic one, or
# by a field or a property, as find_member finds it.
export struct ItabEntry
  member: InterfaceMember
  target: MemberTarget
  instance: Instance?

# What converting a value of the type to the interface needs: the entries of the itab, in the
# order of the interface's members.
export struct Itab
  type: Type
  target: InterfaceType
  entries: ItabEntry[]

# Whether the expression's value, which is not of the expected type, converts to it through an itab:
# to an interface type, or to an Iter.
export converts_through_itab := (body: Body, expression: Expression, type: Type, expected: Type) ->
  return true if converts_to_interface(body, expression, type, expected)
  converts_to_iter(body, expression, type, expected)

# Whether the expression's value, which is not of the expected type, converts to it: to an
# interface type, or to one optional, which its type must satisfy, or to a union, or one optional,
# that has an interface member which it satisfies, and which a box holds (see codegen generate).
# Records the itab's plan.
converts_to_interface := (body: Body, expression: Expression, type: Type, expected: Type) ->
  return false if is_one_of_kinds(type, ['nil', 'never', OPTIONAL, INTERFACE])
  inner := inner_of(expected)
  target :=
    if inner is UnionType
      interface_member_of body, expression, type, inner
    else
      inner
  return false unless target is InterfaceType
  record_itab body, expression, type, target
  true

# The interface member of the union that the type satisfies, which must be the only one, or nil.
interface_member_of := (body: Body, expression: Expression, type: Type, union: UnionType) ->
  at := expression.position
  is_satisfied := (member: Type) -> member is InterfaceType and satisfies(body, type, member, at)
  satisfied := [member for member in union.members when is_satisfied(member)]
  return nil if satisfied.is_empty()
  return satisfied[0] if satisfied.length == 1
  names := [format_type(member) for member in satisfied].join(' and ')
  which := 'so the union cannot tell which it is; convert it to one of them first'
  message := "#{format_type(type)} satisfies #{names}, members of #{format_type(union)}, #{which}"
  fail(body.program, at, message)

# Whether the expression's value, which is not of the expected type, converts to it: to an Iter, or
# to one optional, which an Iter makes of a value that has `has_next(): Bool` and `next(): T` (see
# iter_source_type). The Iter holds the value as an interface value, whose itab's plan is recorded.
converts_to_iter := (body: Body, expression: Expression, type: Type, expected: Type) ->
  target := inner_of(expected)
  return false unless target is IterType
  return false if is_one_of_kinds(type, ['nil', 'never', OPTIONAL, ITER])
  has_next := Identifier(name: 'has_next', position: expression.position)
  return false if member_type_by_name(body, type, has_next) == nil
  record_itab body, expression, type, iter_source_type(target.item)
  true

# Records the plan of the itab of the value converted to the interface type, which its type must
# satisfy. Of a type parameter standing for itself, whose instances tell whether it is a reference,
# and which no codegen reads, there is no itab.
record_itab := (body: Body, expression: Expression, type: Type, target: InterfaceType) ->
  if type is TypeParameterType and type.standing
    return reject_unsatisfied(body, type, target, expression.position)
  body.facts.itabs[expression] = itab_of(body, expression.position, type, target)

itab_of := (body: Body, at: Position, type: Type, target: InterfaceType) ->
  to_target := "to #{format_type(target)}"
  unless is_reference_type(type)
    reason := 'only references can be held by interface values so far'
    fail body.program, at, "#{format_type(type)} cannot be converted #{to_target}: #{reason}"
  reject_unsatisfied body, type, target, at
  members := members_for(body.program, target, type)
  entries := [itab_entry(body, type, member, at) for member in members]
  Itab(type, target, entries)

itab_entry := (body: Body, type: Type, member: InterfaceMember, at: Position) ->
  name := Identifier(name: member.name, position: at)

  # The type satisfies the interface (see reject_unsatisfied), so it has the member.
  target := find_member(body, type, name)!.target

  generic := target is Method then generic_method(target.source)
  instance :=
    if generic
      receiver_instance body, generic, type, at, nil
    else
      nil
  ItabEntry(member, target, instance)

# The plans of the itabs of the runtime's errors, from which codegen makes them (see
# runtime_errors), by the module that declares the Error of std:builtins, which `shared` is: its
# structs that declare Error, in the order they are declared there. std keeps the runtime's errors
# in that module.
export plan_runtime_errors := (shared: Shared) ->
  resolver := module_resolver(shared.index)
  body := Body(shared, resolver, extensions: shared.extensions, facts: shared.facts)
  at := Position(line: 1, column: 1)
  error := std_interface(shared, 'Error', at).type
  declares_error := (info: ObjectInfo) -> info.satisfies == error
  errors := (info for info in shared.objects.values() when declares_error(info))
  shared.program.runtime_errors = [itab_of(body, at, info.type, error) for info in errors]
