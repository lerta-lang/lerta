# Rejects the generic classes, structs and interfaces whose instances would grow without end, as
# each instance's members are checked: those whose members make, of one of them, an instance with a
# type argument that holds a type parameter in a larger type, as `B<A<T>>` holds `T`, when the
# instances that its members make lead back to the first, as where `A<T>` holds a `B<A<T>>` and
# `B<T>` an `A<B<T>>`. Each type parameter of a declaration is a vertex of a graph, with an edge to
# each type parameter whose type argument holds it; the instances grow without end where a cycle
# holds an edge that makes a larger type.
import NamedType, Position, TypeName from '../ast'
import check_part, fail, in_module from './diagnostics'
import is_generic_object, method_literal, written_types from './object_types'
import ProgramWide from './shared'
import named_in, named_type, named_types_in from './type_names'
import InterfaceType, ObjectType, Type from '../types'

# A type parameter of the declaration `holder`, which an instance of `held` takes, in the type
# argument written at `at`.
struct Edge
  from: String
  to: String
  # Whether the type argument holds the type parameter in a larger type, as `A<T>` or `T[]` does.
  grows: Bool
  holder: String
  held: String
  at: Position
  module_index: Int

# A generic declaration whose members are written in the module, with its type parameters.
struct GenericDeclaration
  symbol: String
  name: String
  params: String[]
  module_index: Int

# Whether it rejected any, after which checking the instances would not end.
export reject_growing_instances := (program: ProgramWide) ->
  edges := edges_of(program)
  components := components_of(edges)
  reported: Set<String>
  for edge in edges
    continue if not edge.grows or components[edge.from] != components[edge.to]
    place := "#{edge.module_index}:#{edge.at.line}:#{edge.at.column}"
    continue unless reported.add(place)
    shared := program.shared[edge.module_index]
    in_module shared, -> check_part(program, -> fail(program, edge.at, message_of(edge)))
  not reported.is_empty()

message_of := (edge: Edge) ->
  grows := 'whose instances would grow without end'
  if edge.holder == edge.held
    return "'#{edge.holder}' cannot hold a larger instance of itself, #{grows}"
  back := "which leads back to '#{edge.holder}'"
  "'#{edge.holder}' cannot hold a larger instance of '#{edge.held}', #{back}, #{grows}"

edges_of := (program: ProgramWide) ->
  edges: Edge[]
  for info in program.infos.values()
    continue if info.generic != nil or not is_generic_object(info)
    { type, module_index } := info
    params := [param.name.name for param in info.declaration.type_params]
    declaration := GenericDeclaration(params, module_index, symbol: type.symbol, name: type.name)
    for member in info.declaration.members
      # A method's own type parameters, which it has an instance for each of, do not count, nor do
      # the declaration's that they would shadow, which is reported apart.
      method_params := [param.name.name for param in method_literal(member)?.type_params ? []]
      for written in written_types(member)
        add_edges program, edges, declaration, method_params, written
    # The interface that it satisfies gives its members to it. Its type counts as written whether
    # the members use its type arguments or not, which is simpler than following them there.
    add_edges program, edges, declaration, [], info.declaration.satisfies
  for interface_info in program.interfaces.values()
    written := interface_info.declaration ? continue
    continue if interface_info.type_params.is_empty()
    declaration := GenericDeclaration
      params: interface_info.type_params
      module_index: interface_info.module_index!
      symbol: interface_info.type.symbol
      name: interface_info.name
    add_edges program, edges, declaration, [], member.type for member in written.members
  edges

add_edges := (
  program: ProgramWide, edges: Edge[], declaration: GenericDeclaration, method_params: String[],
  written: TypeName?
) ->
  { params, module_index } := declaration
  shared := program.shared[module_index]
  is_parameter := (name: String) -> name in params or name in method_params
  for named in named_types_in(written)
    continue if named.args.is_empty() or is_parameter(named.name)
    held := generic_symbol(named_type(shared, named.name)) ? continue
    for arg, i in named.args
      for param, index in params
        continue if param in method_params or named_in(arg, param).is_empty()
        edges.push {
          module_index
          from: vertex(declaration.symbol, index)
          to: vertex(held, i)
          grows: not is_alone(arg, param)
          holder: declaration.name
          held: named.name
          at: named.position
        }

vertex := (symbol: String, index: Int) -> "#{symbol} #{index}"

generic_symbol := (named: Type?) ->
  type := named ? return nil
  case type
    when ObjectType, InterfaceType then not type.args.is_empty() then type.symbol
    else nil

# Whether the type argument is the type parameter itself, as in `next: Node<T>?`.
is_alone := (arg: TypeName, param: String) ->
  arg is NamedType and arg.name == param and arg.args.is_empty() and not arg.optional

# The strongly connected components of the graph, by Tarjan's algorithm, as a number for each
# vertex: two vertices have the same one when each leads to the other.
components_of := (edges: Edge[]) ->
  search := Search()
  for edge in edges
    if next := search.successors[edge.from]
      next.push edge.to
    else
      search.successors[edge.from] = [edge.to]
  for edge in edges
    visit search, edge.from unless edge.from in search.order
  search.component

class Search
  successors: Map<String, String[]> = Map()
  # The order in which the vertices are reached, and the earliest that each leads back to.
  order: Map<String, Int> = Map()
  low: Map<String, Int> = Map()
  stack: String[] = []
  on_stack: Set<String> = Set()
  component: Map<String, Int> = Map()

visit := (search: Search, vertex: String): void ->
  number := search.order.length
  search.order[vertex] = number
  search.low[vertex] = number
  search.stack.push vertex
  search.on_stack.add vertex
  for next in search.successors[vertex] ? []
    if next not in search.order
      visit search, next
      lower search, vertex, search.low[next]!
    else if next in search.on_stack
      lower search, vertex, search.order[next]!
  return if search.low[vertex] != number
  while true
    member := search.stack.pop()
    search.on_stack.remove member
    search.component[member] = number
    break if member == vertex

lower := (search: Search, vertex: String, low: Int) ->
  search.low[vertex] = low if low < search.low[vertex]!
