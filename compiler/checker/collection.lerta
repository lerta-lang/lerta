# Types arrays, maps and sets: their literals, `Map()`, `Set()`, and indexing (of a Binary too).
import
  ArrayLiteral, Call, Expression, Identifier, is_spread, Index, MapEntry, MapLiteral, NamedType,
  Position, Throw
from '../ast'
import fail from './diagnostics'
import is_equatable from './equality'
import expect_type, type_of from './expression'
import has_function from './functions'
import is_contextual from './literals'
import lookup from './name'
import Body, ProgramWide from './shared'
import resolve from './type_names'
import
  ArrayType, byte_type, format_type, inner_of, int_type, is_kind, is_reference_type, is_set, MapType,
  optional_type, OptionalType, set_of, Type
from '../types'

# The type of the values of a container, such as 'an Iter', which `at` gives: any type with
# values.
export const check_value_type = (
  program: ProgramWide, type: Type, at: Position, container: String
) ->
  if is_kind(type, 'nil')
    const message = "nil alone does not give the type of #{container}; write it in an annotation"
    fail program, at, message
  if is_kind(type, 'void') or is_kind(type, 'never')
    fail program, at, "#{container} cannot hold values of type #{format_type(type)}"
  type

# The type of an item of a container, such as 'an array', which `at` gives. An optional value
# that is not a reference has no item kind yet (see LertaItemKind in runtime/lerta.h).
export const check_item_type = (
  program: ProgramWide, type: Type, at: Position, container: String
) ->
  check_value_type program, type, at, container
  if type is OptionalType and not is_reference_type(type)
    fail program, at, "#{container} cannot hold values of type #{format_type(type)}"
  type

# A key is any value that `==` compares but an optional one, since a missing key reads as nil.
# `role` names the key in messages: 'a map key', or 'a set item'.
export const reject_map_key = (program: ProgramWide, key: Type, at: Position, role = 'a map key') ->
  if key is OptionalType or not is_equatable(program, key, at)
    const message = "#{role} must be a value that == compares, not optional"
    fail program, at, "#{message}, got #{format_type(key)}"

# The types of a map's keys and values, which `key_at` and `value_at` give (see reject_map_key and
# check_map_value).
export const check_map_types = (
  program: ProgramWide, key: Type, value: Type, key_at: Position, value_at: Position
) ->
  reject_map_key program, key, key_at
  check_map_value program, value, value_at

# A map's value is not optional, since a missing key reads as nil.
export const check_map_value = (program: ProgramWide, value: Type, at: Position) ->
  check_value_type program, value, at, 'a map'
  if value is OptionalType
    fail program, at, "a map cannot hold values of type #{format_type(value)}"

# The element type comes from the expected type if there is one, so that `[[], [1]]` can be
# typed; otherwise as docs/reference/types.md#array states.
export const type_of_array = (body: Body, array: ArrayLiteral, expected: Type?) ->
  if expected is ArrayType
    expect_element body, item, expected.element for item in array.elements
    return expected
  const elements = array.elements
  const gives_value = (item: Expression) -> item is not Throw
  const empty = ->
    const message = 'the type of an empty array must be written, as in `const xs: Int[] = []`'
    fail body.program, array.position, message
  const first = elements.first()
  const is_anchor = (item: Expression) -> gives_value(item) and not is_contextual(item)
  const anchor = elements.find(is_anchor) ? elements.find(gives_value) ? first ? empty()
  const anchor_type = type_of(body, anchor)
  const element_type = is_spread(anchor) then (anchor_type as ArrayType!).element else anchor_type
  const element = check_item_type(body.program, element_type, anchor.position, 'an array')
  for item in elements
    expect_element body, item, element if item != anchor
  ArrayType element

# A spread is checked as the array of its items, whose items must be of the type.
const expect_element = (body: Body, item: Expression, element: Type) ->
  expect_type body, item, is_spread(item) then ArrayType(element) else element

export const type_of_map = (body: Body, map: MapLiteral, expected: Type?) ->
  const type = expected_map(expected) ? map_type_of_entry(body, map.entries[0])
  for entry in map.entries
    expect_type body, entry.key, type.key
    expect_type body, entry.value, type.value
  type

const expected_map = (expected: Type?) ->
  const type = expected ? return nil
  const map = inner_of(type) as MapType ? return nil
  is_set(map) then nil else map

const expected_set = (expected: Type?) ->
  const type = expected ? return nil
  const map = inner_of(type) as MapType ? return nil
  is_set(map) then map

const map_type_of_entry = (body: Body, entry: MapEntry) ->
  const key = type_of(body, entry.key)
  const value = type_of(body, entry.value)
  check_map_types body.program, key, value, entry.key.position, entry.value.position
  MapType key, value

# A call of the builtin `Map` or `Set`, unless the name is taken in the program.
export const is_builtin_call = (body: Body, callee: Expression, name: String) ->
  return false if callee is not Identifier
  callee.name == name and lookup(body, name) == nil and not has_function(body.shared, name)

export const type_of_empty_map = (body: Body, call: Call, expected: Type?) ->
  const program = body.program
  const target = written_or_expected(body, call, 'Map', expected)
  const missing_type = ->
    const example = '`Map<String, Int>()`'
    fail program, call.position, "the type of an empty map must be written, as in #{example}"
  if const set = expected_set(target)
    fail program, call.position, "expected #{format_type(set)}, got a map; write Set()"
  const type = expected_map(target) ? missing_type()
  if call.args.length > 0 or call.named_args.length > 0
    fail program, call.position, 'Map() takes no arguments'
  type

# `Set()`, of the expected type, or `Set(xs)`, of the items of an array.
export const type_of_new_set = (body: Body, call: Call, expected: Type?) ->
  const program = body.program
  if call.args.length > 1 or call.named_args.length > 0
    fail program, call.position, 'Set() takes an array of its items, or nothing'
  const set = expected_set(written_or_expected(body, call, 'Set', expected))
  if call.args.length == 0
    const example = '`Set<String>()`'
    const message = "the type of an empty set must be written, as in #{example}"
    return set ? fail(program, call.position, message)
  const items = call.args[0]
  const array_type = set then ArrayType(element: set.key)
  const type = type_of(body, items, array_type)
  const not_array = "expected an array, got #{format_type(type)}"
  const array = type as ArrayType ? fail(program, items.position, not_array)
  reject_map_key program, array.element, items.position, 'a set item'
  set_of array.element

# The type that `Map<K, V>()` or `Set<T>()` writes, or else the one expected.
const written_or_expected = (body: Body, call: Call, name: String, expected: Type?) ->
  return expected if call.type_args.length == 0
  const written = NamedType(name, args: call.type_args, position: call.callee.position)
  resolve body.program, body.resolver, written

# An item of an array or a Binary, or the value of a map's key, which may not be there.
export const type_of_index = (body: Body, index: Index): Type ->
  const object_type = type_of(body, index.object)
  if object_type is MapType
    reject_set_index body, index, object_type
    expect_type body, index.index, object_type.key
    return optional_type(object_type.value)
  if object_type is not ArrayType and not is_kind(object_type, 'Binary')
    const message = "cannot index a value of type #{format_type(object_type)}"
    fail body.program, index.object.position, message
  expect_type body, index.index, int_type
  object_type is ArrayType then object_type.element else byte_type

const reject_set_index = (body: Body, index: Index, type: MapType) ->
  return if not is_set(type)
  const message = "cannot index a value of type #{format_type(type)}; use has"
  fail body.program, index.object.position, message
