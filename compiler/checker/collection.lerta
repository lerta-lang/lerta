# Types arrays, maps and sets: their literals, `Map()`, `Set()`, and indexing (of a Binary too).
import
  ArrayLiteral, Call, Expression, Identifier, Index, is_spread, MapLiteral, NamedType, Position,
  Range, RecordLiteral, Throw, TupleLiteral
from '../ast'
import fail from './diagnostics'
import is_equatable, is_hashable from './equality'
import expect_type, type_of from './expression'
import has_function from './functions'
import float_first, is_contextual from './literals'
import lookup, record_reference from './name'
import CollectionMaker from './references'
import Body, ProgramWide from './shared'
import names_type_or_import, resolve from './type_names'
import
  ArrayType, binary_type, byte_type, format_type, inner_of, int_type, is_kind, is_reference_type,
  is_set, MapType, optional_type, OptionalType, set_of, Type
from '../types'

# The type of the values of a container, such as 'an Iter', which `at` gives: any type with
# values.
export check_value_type := (program: ProgramWide, type: Type, at: Position, container: String) ->
  if is_kind(type, 'nil')
    message := "nil alone does not give the type of #{container}; write it in an annotation"
    fail program, at, message
  if is_kind(type, 'void') or is_kind(type, 'never')
    fail program, at, "#{container} cannot hold values of type #{format_type(type)}"
  type

# The type of an item of a container, such as 'an array', which `at` gives. An optional value
# that is not a reference has no item kind yet (see LertaItemKind in runtime/lerta.h).
export check_item_type := (program: ProgramWide, type: Type, at: Position, container: String) ->
  check_value_type program, type, at, container
  if type is OptionalType and not is_reference_type(type)
    fail program, at, "#{container} cannot hold values of type #{format_type(type)}"
  type

# A key is any value that `==` compares but an optional one, since a missing key reads as nil, and
# hashes as equal values do (see is_hashable). `role` names the key in messages: 'a map key', or
# 'a set item'.
export reject_map_key := (program: ProgramWide, key: Type, at: Position, role = 'a map key') ->
  got := format_type(key)
  if key is OptionalType or not is_equatable(program, key, at)
    fail program, at, "#{role} must be a value that == compares, not optional, got #{got}"
  if not is_hashable(program, key, at)
    reason := 'a class or struct that compares by its own equals or compare needs a hash too'
    fail program, at, "#{role} must hash as it compares, got #{got}: #{reason}"

# The types of a map's keys and values, which `key_at` and `value_at` give (see reject_map_key and
# check_map_value).
export check_map_types := (
  program: ProgramWide, key: Type, value: Type, key_at: Position, value_at: Position
) ->
  reject_map_key program, key, key_at
  check_map_value program, value, value_at

# A map's value is not optional, since a missing key reads as nil.
export check_map_value := (program: ProgramWide, value: Type, at: Position) ->
  check_value_type program, value, at, 'a map'
  if value is OptionalType
    fail program, at, "a map cannot hold values of type #{format_type(value)}"

# The element type comes from the expected type if there is one, so that `[[], [1]]` can be
# typed; otherwise as docs/reference/types.md#array states.
export type_of_array := (body: Body, array: ArrayLiteral, expected: Type?) ->
  if expected is ArrayType
    expect_element body, item, expected.element for item in array.elements
    return expected
  elements := array.elements
  empty := ->
    message := 'the type of an empty array must be written, as in `var xs: Int[] = []`'
    fail body.program, array.position, message
  anchor := anchor_of(elements) ? empty()
  anchor_type := type_of(body, anchor)
  element_type := is_spread(anchor) then (anchor_type as ArrayType!).element else anchor_type
  element := check_item_type(body.program, element_type, anchor.position, 'an array')
  for item in elements
    expect_element body, item, element if item != anchor
  keep_constructions body, elements
  ArrayType element

# The item whose type the others take: one that decides its own type rather than taking it from
# the context, or else one that holds a float literal (see float_first), or else the first; a throw,
# which gives no value, only if all are. Nil for no items.
anchor_of := (items: Expression[]) ->
  gives_value := (item: Expression) -> item is not Throw
  is_anchor := (item: Expression) -> gives_value(item) and not is_contextual(item)
  valued := float_first([item for item in items when gives_value(item)], (item) -> item)
  return anchor if anchor := items.find(is_anchor)
  return anchor if anchor := valued.first()
  items.first()

# A spread is checked as the array of its items, whose items must be of the type.
expect_element := (body: Body, item: Expression, element: Type) ->
  expect_type body, item, is_spread(item) then ArrayType(element) else element

# Values whose type others gave, such as the items that take the type of their anchor, keep their
# constructions, and so do the literals in them, which show that type as the others do, rather than
# being written as records (see NodeFacts.recordable).
export keep_constructions := (body: Body, items: Expression[]): void ->
  for item in items
    case item
      when Call then body.facts.recordable.remove(item)
      when ArrayLiteral then keep_constructions(body, item.elements)
      when TupleLiteral then keep_constructions(body, item.items)
      when RecordLiteral then keep_constructions(body, [field.value for field in item.fields])
      when MapLiteral
        keep_constructions body, [entry.key for entry in item.entries]
        keep_constructions body, [entry.value for entry in item.entries]
      else pass

# The key and the value types come from the expected type if there is one; otherwise each from an
# anchor among the keys and among the values, as an array's element type does.
export type_of_map := (body: Body, map: MapLiteral, expected: Type?) ->
  if type := expected_map(expected)
    for entry in map.entries
      expect_type body, entry.key, type.key
      expect_type body, entry.value, type.value
    return type
  key := anchor_of([entry.key for entry in map.entries])!
  value := anchor_of([entry.value for entry in map.entries])!
  type := map_type_of_anchors(body, key, value)
  for entry in map.entries
    expect_type body, entry.key, type.key if entry.key != key
    expect_type body, entry.value, type.value if entry.value != value
  keep_constructions body, [entry.key for entry in map.entries]
  keep_constructions body, [entry.value for entry in map.entries]
  type

expected_map := (expected: Type?) ->
  type := expected ? return nil
  map := inner_of(type) as MapType ? return nil
  is_set(map) then nil else map

expected_set := (expected: Type?) ->
  type := expected ? return nil
  map := inner_of(type) as MapType ? return nil
  is_set(map) then map

map_type_of_anchors := (body: Body, key: Expression, value: Expression) ->
  key_type := type_of(body, key)
  value_type := type_of(body, value)
  check_map_types body.program, key_type, value_type, key.position, value.position
  MapType key: key_type, value: value_type

# A call of the builtin `Map` or `Set`, unless the name is taken in the program.
is_builtin_call := (body: Body, callee: Expression, name: String) ->
  return false if callee is not Identifier
  is_taken := has_function(body.shared, name) or names_type_or_import(body.shared, name)
  callee.name == name and lookup(body, name) == nil and not is_taken

# Whether the call makes the builtin Map or Set of the name: by the name, or as the parser made it.
export makes_builtin := (body: Body, call: Call, name: String) ->
  callee := call.callee
  made := call.makes_builtin and callee is Identifier and callee.name == name
  made or is_builtin_call(body, callee, name)

# Records the call of the builtin Map or Set, whose callee is a name (see is_builtin_call), as
# making the collection of the type.
export made_collection := (body: Body, call: Call, type: MapType) ->
  record_reference body, call.callee as Identifier!, CollectionMaker(type)
  type

export type_of_empty_map := (body: Body, call: Call, expected: Type?) ->
  program := body.program
  target := written_or_expected(body, call, 'Map', expected)
  missing_type := ->
    example := '`Map<String, Int>()`'
    fail program, call.position, "the type of an empty map must be written, as in #{example}"
  if set := expected_set(target)
    fail program, call.position, "expected #{format_type(set)}, got a map; write Set()"
  type := expected_map(target) ? missing_type()
  if not call.args.is_empty() or not call.named_args.is_empty()
    fail program, call.position, 'Map() takes no arguments'
  type

# `Set()`, of the expected type, or `Set(xs)`, of the items of an array.
export type_of_new_set := (body: Body, call: Call, expected: Type?) ->
  program := body.program
  if call.args.length > 1 or not call.named_args.is_empty()
    fail program, call.position, 'Set() takes an array of its items, or nothing'
  set := expected_set(written_or_expected(body, call, 'Set', expected))
  if call.args.is_empty()
    example := '`Set<String>()`'
    message := "the type of an empty set must be written, as in #{example}"
    return set ? fail(program, call.position, message)
  items := call.args[0]
  array_type := set then ArrayType(element: set.key)
  type := type_of(body, items, array_type)
  not_array := "expected an array, got #{format_type(type)}"
  array := type as ArrayType ? fail(program, items.position, not_array)
  reject_map_key program, array.element, items.position, 'a set item'
  set_of array.element

# The type that `Map<K, V>()` or `Set<T>()` writes, or else the one expected.
written_or_expected := (body: Body, call: Call, name: String, expected: Type?) ->
  return expected if call.type_args.is_empty()
  written := NamedType(name, args: call.type_args, position: call.callee.position)
  resolve body.program, body.resolver, written

# An item of an array or a Binary, or the value of a map's key, which may not be there.
export type_of_index := (body: Body, index: Index): Type ->
  object_type := type_of(body, index.object)
  range := index.index as Range?
  return type_of_slice(body, range, object_type) if range
  if object_type is MapType
    reject_set_index body, index, object_type
    expect_type body, index.index, object_type.key
    return optional_type(object_type.value)
  if object_type is not ArrayType and not is_kind(object_type, 'Binary')
    message := "cannot index a value of type #{format_type(object_type)}"
    fail body.program, index.object.position, message
  expect_type body, index.index, int_type
  object_type is ArrayType then object_type.element else byte_type

# `b[start...end]`, the bytes of a Binary from `start` up to `end`, which no other type takes.
type_of_slice := (body: Body, range: Range, object_type: Type) ->
  if not is_kind(object_type, 'Binary')
    message := "only a Binary takes a range as its index, not #{format_type(object_type)}"
    fail body.program, range.position, message
  expect_type body, range.start, int_type
  expect_type body, range.end, int_type
  binary_type

reject_set_index := (body: Body, index: Index, type: MapType) ->
  return if not is_set(type)
  message := "cannot index a value of type #{format_type(type)}; use has"
  fail body.program, index.object.position, message
