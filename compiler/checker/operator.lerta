# Types unary and binary operators, nil tests and `?`.
import all_but_last from '../arrays'
import
  ArrayLiteral, Assignment, BinaryOperation, Coalesce, Expression, Identifier, is_equality_operator,
  is_nil_test, is_order_operator, method_call, NilLiteral, Position, Range, StringLiteral,
  UnaryOperation
from '../ast'
import fail from './diagnostics'
import compares_by_contents, own_equality from './equality'
import may_name_member from './enums'
import expect_condition, expect_optional, expect_type, require_type, type_of from './expression'
import compares_by_bounds, has_method, member_type_by_name from './member'
import appends_to_literal, holds_float_literal, is_contextual from './literals'
import range_part from './loop'
import where_right_operand from './narrowing'
import Body from './shared'
import
  ArrayType, bool_type, FLOAT_KINDS, format_type, FunctionType, inner_of, inner_of_expected,
  INTEGER_KINDS, is_identity_type, is_kind, is_one_of_kinds, members_of, NUMBER_KINDS, ObjectType,
  OptionalType, SIGNED_INTEGER_KINDS, string_type, Type, TypeKind, TypeParameterType
from '../types'

EQUALITY_KINDS: TypeKind[] = [NUMBER_KINDS..., 'Char', 'Bool', 'String', 'Binary', ENUM]

# The arithmetic and bitwise operators, which give a value of their operands' type, as a comparison
# does not.
NUMERIC_OPERATORS := ['+', '-', '*', '/', '%', '&', '|', '^', '<<', '>>']

export is_numeric_operator := (operator: String) -> operator in NUMERIC_OPERATORS

# The methods that the arithmetic and bitwise operators call on values of the types that they do
# not apply to otherwise, `a + b` as `a.add(b)`, as prefix `-` calls `neg` (see Add and the like
# in std:builtins).
export OPERATOR_METHODS :=
  '+': 'add', '-': 'sub', '*': 'mul', '/': 'div', '%': 'rem', '&': 'bit_and', '|': 'bit_or',
  '^': 'bit_xor', '<<': 'shl', '>>': 'shr'

operators_by_method: Map<String, String>
operators_by_method[method] = operator for (operator, method) in OPERATOR_METHODS.entries()

# The operator whose method has the name, as `+` that of `add`, or nil.
export operator_of_method := (name: String) -> operators_by_method[name]

# The result of the call of the method of the name on the object, of a type that the operator,
# written as `written`, does not apply to otherwise, with the arguments; a call recorded in the
# facts, which codegen generates instead of the operation (see operator_calls). Nil if the type has
# no such member, which is an error for a class or struct, or a type parameter standing for itself.
export type_of_operator_call := (
  body: Body, operation: BinaryOperation | UnaryOperation | Assignment, written: String,
  object: Expression, object_type: Type, name: String, args: Expression[]
): Type? ->
  at := operation.position
  method_name := Identifier(name, position: at)
  if member_type_by_name(body, object_type, method_name) == nil
    return nil if object_type is not ObjectType and object_type is not TypeParameterType
    message := "#{format_type(object_type)} has no #{name}, by which #{written} applies"
    fail body.program, object.position, message
  call := method_call(object, name, args, at)
  body.facts.operator_calls[operation] = call
  type_of body, call

share_a_class := (a: Type, b: Type) ->
  others := members_of(b)
  members_of(a).any((member) -> member in others)

# Lists kinds for a message, such as "Int or Byte".
export describe_kinds := (kinds: TypeKind[]) ->
  integers := INTEGER_KINDS.all((kind) -> kind in kinds)
  others := [kind.to_string() for kind in kinds when not (integers and kind in INTEGER_KINDS)]
  # All the integer types are named as one, first.
  names := integers then ['an integer type', others...] else others
  return names[0] if names.length == 1
  "#{all_but_last(names).join(', ')} or #{names.last()!}"

# The expected type, or that inside an expected optional type, if it is of one of the kinds, as a
# hint for the operands: `1 + 2` is a Float where a `Float?` is expected.
hint_of := (expected: Type?, kinds: TypeKind[]) ->
  type := inner_of_expected(expected) ? return nil
  is_one_of_kinds(type, kinds) then type

export type_of_unary := (body: Body, unary: UnaryOperation, expected: Type?): Type ->
  if unary.operator == 'not'
    expect_condition body, unary.operand
    return bool_type
  type := type_of(body, unary.operand, hint_of(expected, SIGNED_KINDS))
  unless is_one_of_kinds(type, SIGNED_KINDS)
    operand := unary.operand
    return result if result := type_of_operator_call(body, unary, '-', operand, type, 'neg', [])
    message := "expected #{describe_kinds(SIGNED_KINDS)}, got #{format_type(type)}"
    fail body.program, unary.operand.position, message
  type

# The types that prefix `-` takes: not an unsigned one, whose negation throws unless it is 0.
export SIGNED_KINDS: TypeKind[] = [SIGNED_INTEGER_KINDS..., FLOAT_KINDS...]

type_of_nil_test := (body: Body, binary: BinaryOperation) ->
  left_is_nil := binary.left is NilLiteral
  type_of body, left_is_nil then binary.left else binary.right
  expect_optional body, left_is_nil then binary.right else binary.left
  bool_type

export type_of_coalesce := (body: Body, coalesce: Coalesce) ->
  inner := expect_optional(body, coalesce.value)
  expect_type body, coalesce.fallback, inner
  inner

export operand_kinds := (operator: String): TypeKind[] ->
  # Strings order by their compare, and Chars by their numbers.
  return [NUMBER_KINDS..., 'Char', 'String'] if is_order_operator(operator)
  case operator
    when '+' then [NUMBER_KINDS..., 'String', 'Binary']
    when '%', '&', '|', '^', '<<', '>>' then INTEGER_KINDS
    else NUMBER_KINDS

# An arithmetic or bitwise operator passes the expected type to its operands; a comparison's
# operands have their own.
export type_of_binary := (body: Body, binary: BinaryOperation, expected: Type?): Type ->
  operator := binary.operator
  if operator == 'and' or operator == 'or'
    expect_condition body, binary.left
    where_right_operand body, binary, -> expect_condition(body, binary.right)
    return bool_type
  return type_of_nil_test(body, binary) if is_nil_test(binary)
  range := binary.right
  return type_of_range_test(body, binary, range) if operator == 'in' and range is Range
  return type_of_in_test(body, binary) if operator == 'in'
  if is_equality_operator(operator)
    reject := (type: Type) -> "cannot compare values of type #{format_type(type)}"
    type_of_operands body, binary, nil, EQUALITY_KINDS, reject
    return bool_type
  allowed := operand_kinds(operator)
  reject := (type: Type) -> "expected #{describe_kinds(allowed)}, got #{format_type(type)}"
  if is_order_operator(operator)
    type := type_of_operands(body, binary, nil, allowed, reject)
    order_by_compare body, binary if is_kind(type, 'String')
    return bool_type
  type_of_operands body, binary, hint_of(expected, allowed), allowed, reject

# `x in a..=b` compares `x` with the ends in place, making no range. The parts take the type of the
# first that has its own, or else of the first float literal, as the operands of `<=` do. Only the
# types that compare by themselves take one, as `x` is compared twice, by the comparisons of values
# alone, with no call of compare and no object to hold for the second.
type_of_range_test := (body: Body, binary: BinaryOperation, range: Range) ->
  parts := [binary.left, range_part(body, range, range.start), range_part(body, range, range.end)]
  own := parts.find((part) -> not takes_context(body, part))
  deciding := own ? parts.find(holds_float_literal) ? binary.left
  type := type_of(body, deciding)
  allowed: TypeKind[] = [NUMBER_KINDS..., 'Char']
  unless is_one_of_kinds(type, allowed)
    message := "a range after `in` takes #{describe_kinds(allowed)}, got #{format_type(type)}"
    fail body.program, deciding.position, message
  for part in parts
    expect_type body, part, type if part != deciding
  bool_type

# `x in xs` tests the call of `xs.contains(x)`, of the Contains interface, the facts record for
# codegen to make (see in_tests). A String also takes a Char, as the String of it, as `+` appends
# one.
type_of_in_test := (body: Body, binary: BinaryOperation) ->
  { left, right, position } := binary
  expected := expected_container(body, binary)
  # The call of contains types the literal again, and takes its type from here.
  body.in_test_arrays[right] = expected if expected and right is ArrayLiteral
  container := type_of(body, right, expected)
  contains := member_type_by_name(body, container, Identifier(position, name: 'contains'))
  unless contains
    message := "#{format_type(container)} has no contains, by which `in` applies"
    fail body.program, right.position, message
  reject_optional_item body, left, contains
  # The item is typed by the call, as the parameter's type may decide it, as of `[]`, but for the
  # Char that a String takes.
  text := is_kind(container, 'String') then char_as_text(container, type_of(body, left), left)
  call := method_call(right, 'contains', [text then text else left], position)
  body.facts.in_tests[binary] = call
  result := type_of(body, call)
  if result != bool_type
    fail body.program, position, "contains gives #{format_type(result)}, but `in` needs a Bool"
  bool_type

# An optional item where contains takes no nil, as of an array, which holds none, is reported as
# such, rather than as an argument of the wrong type. An item that may take its type from the
# parameter, as one from the context or an array literal does, is left to the call, which types it;
# so is one of a contains that is not a function, which the call reports.
reject_optional_item := (body: Body, item: Expression, contains: Type) ->
  return unless contains is FunctionType
  return if contains.params.first() is OptionalType
  return if takes_context(body, item) or item is ArrayLiteral
  item_type := type_of(body, item)
  if item_type is OptionalType
    message := "#{format_type(item_type)} cannot be tested by `in`; unwrap it first"
    fail body.program, item.position, message

# The type that `x in [...]` expects of an array literal whose items all take their type from the
# context: the array of the type of `x`, which `in` takes only without nil, as the other
# operand of `==` takes the type of the first. Nil if `x` takes its type from the context too, and
# is then typed by the parameter of contains; nil for any other test.
expected_container := (body: Body, binary: BinaryOperation) ->
  { left, right } := binary
  return nil if right is not ArrayLiteral or takes_context(body, left)
  return nil unless right.elements.all((item) -> takes_context(body, item))
  item := inner_of(type_of(body, left))
  # One that does not compare is typed as before, so that the error is not reported in contains.
  return nil unless compares_by_bounds(body, item, binary.position)
  ArrayType item

# The call of `to_string()` of a Char that a String's contains takes, as `+` appends one: nil for
# any other part.
export char_as_text := (container: Type, part: Type, value: Expression) ->
  takes_char := is_kind(container, 'String') and is_kind(part, 'Char')
  takes_char then method_call(value, 'to_string', [], value.position)

# Whether the operand takes its type from the context: a literal, or a name that may stand for a
# member of an enum.
takes_context := (body: Body, operand: Expression) ->
  is_contextual(operand) or may_name_member(body, operand)

type_of_operands := (
  body: Body, binary: BinaryOperation, expected: Type?, allowed_kinds: TypeKind[],
  reject: (Type) -> String
) ->
  { left, right, operator } := binary
  appends_to := (operand: Expression) -> operand == left and appends_to_literal(binary)
  hint := (operand: Expression, type: Type?) -> appends_to(operand) then nil else type
  takes := (operand: Expression) ->
    contextual := not appends_to(operand) and is_contextual(operand)
    contextual or may_name_member(body, operand)
  decides_more := (operand: Expression, than: Expression) ->
    not takes(operand) or (holds_float_literal(operand) and not holds_float_literal(than))
  right_first := takes(left) and decides_more(right, left)
  first := right_first then right else left
  second := right_first then left else right
  type := type_of(body, first, hint(first, expected))
  program := body.program
  call_type := type_of_operation_call(body, binary, first, second, type, right_first, allowed_kinds)
  return call_type if call_type
  is_equality := is_equality_operator(operator)
  inner := is_equality then inner_of(type) else type
  by_contents := is_equality and compares_by_contents(program, inner)
  is_identity := is_equality and is_identity_type(inner) and not by_contents
  return type_of_identity_operand(body, second, type) if is_identity
  is_order := is_order_operator(operator)
  is_allowed :=
    case
      when by_contents then compares_by_bounds(body, inner, first.position)
      # `<` and the like of a class or struct compare by its compare.
      when is_order and own_equality(program, inner) == 'compare' then true
      when inner is TypeParameterType then bound_compares(body, inner, is_order, first.position)
      else is_one_of_kinds(inner, allowed_kinds)
  reject_operand body, operator, first, type, reject unless is_allowed
  return type_of_equality_operand(body, first, second, type) if is_equality
  second_type := type_of(body, second, hint(second, type))
  is_unit := not right_first and operator == '+' and appends_unit(type, second_type)
  return type if is_unit
  reject_text_and_bytes body, second, type, second_type
  require_type body, second, second_type, type
  type

# The type of an operation that is a call in place of the operator, or nil for one that is not: a
# String appended to a Char, or an operator applied to a type it does not apply to.
type_of_operation_call := (
  body: Body, binary: BinaryOperation, first: Expression, second: Expression, type: Type,
  right_first: Bool, allowed_kinds: TypeKind[]
): Type? ->
  { left, right, operator } := binary
  # A string literal on the left of a Char, which no Char's method takes, is
  # the String it appends to.
  if right_first and operator == '+' and is_kind(type, 'Char') and second is StringLiteral
    expect_type body, second, string_type
    return string_type
  return nil if not is_numeric_operator(operator) or is_one_of_kinds(type, allowed_kinds)
  # The method is that of the left operand.
  name := OPERATOR_METHODS[operator]!
  return type_of_operator_call(body, binary, operator, left, type, name, [right]) unless right_first
  has_method := member_type_by_name(body, type, Identifier(name, position: first.position)) != nil
  if has_method or type is ObjectType
    message := "#{operator} calls the #{name} of its left operand, not of #{format_type(type)}"
    fail body.program, first.position, message
  nil

# Rejects the operand, of a type the operator does not apply to.
reject_operand := (
  body: Body, operator: String, operand: Expression, type: Type, reject: (Type) -> String
) ->
  program := body.program
  if is_order_operator(operator)
    if own_equality(program, inner_of(type)) == 'compare'
      fail
        program
        operand.position
        "#{operator} takes no optional values, got #{format_type(type)}"
    if type is ObjectType or type is TypeParameterType
      fail
        program
        operand.position
        "#{format_type(type)} has no compare, by which #{operator} orders"
  fail program, operand.position, reject(type)

# Whether the bound of a type parameter standing for itself gives the method that the operator
# compares by: compare for `<` and the like; equals or compare for `==`, as a class's own does.
bound_compares := (body: Body, type: TypeParameterType, is_order: Bool, at: Position) ->
  has := (name: String) -> has_method(body, type, Identifier(name, position: at))
  has('compare') or (not is_order and has('equals'))

# `<` and the like of two Strings test the Ordering of the left one's compare, by the call of it,
# which the facts record for codegen to generate in place of the operation (see order_calls).
order_by_compare := (body: Body, binary: BinaryOperation) ->
  call := method_call(binary.left, 'compare', [binary.right], binary.position)
  body.facts.order_calls[binary] = call
  type_of body, call

# `+` appends a Char to a String, as its UTF-8, and a Byte to a Binary.
export appends_unit := (target: Type, value_type: Type) ->
  appends_char := is_kind(target, 'String') and is_kind(value_type, 'Char')
  appends_char or (is_kind(target, 'Binary') and is_kind(value_type, 'Byte'))

# `+` joins two Strings or two Binarys, but not one of each, whose bytes `.binary` gives.
export reject_text_and_bytes := (body: Body, operand: Expression, first: Type, second: Type) ->
  kinds: TypeKind[] = ['String', 'Binary']
  mixed := is_one_of_kinds(first, kinds) and is_one_of_kinds(second, kinds)
  return if not mixed or is_kind(first, 'String') == is_kind(second, 'String')
  message := "cannot join a String and a Binary: write `.binary` for the String's bytes"
  fail body.program, operand.position, message

type_of_equality_operand := (
  body: Body, first: Expression, second: Expression, first_type: Type
): Type ->
  second_type := type_of(body, second, inner_of(first_type))
  if second_type is OptionalType and second_type.inner == first_type
    require_type body, first, first_type, second_type
    return second_type
  require_type body, second, second_type, first_type
  first_type

type_of_identity_operand := (body: Body, second: Expression, first_type: Type) ->
  type := type_of(body, second)
  first_inner := inner_of(first_type)
  inner := inner_of(type)
  if not is_identity_type(inner) or not share_a_class(first_inner, inner)
    message := "cannot compare #{format_type(first_type)} with #{format_type(type)}"
    fail body.program, second.position, message
  first_type
