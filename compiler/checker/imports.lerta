# The names a module imports from other modules, the C functions it declares as externs, and what
# it exports for the modules that import it.
import
  Declaration, EnumDeclaration, Exportable, exported_declaration, Extern, FunctionLiteral,
  Intrinsic, Identifier, Import, InterfaceDeclaration, NamedType, Statement, TypeAlias,
  TypeDeclaration
from '../ast'
import Constant from './constants'
import fail, fail_already_defined from './diagnostics'
import generic_function from './functions'
import GenericRef from './generics'
import InterfaceInfo from './interfaces'
import BUILTINS_MODULE, Module from '../loader'
import ObjectInfo, object_type from './object_types'
import Local from './scopes'
import ProgramWide, Shared from './shared'
import alias_type from './type_names'
import Type from '../types'

# A C function, by its symbol (see Extern), and the extern that declares it, by its module's index
# and its name there.
export struct ExternExport
  type: Type
  symbol: String
  module_index: Int
  name: String

# A function that the compiler gives, which a standard module declares (see Intrinsic), or, with a
# type, a value that it gives.
export struct IntrinsicExport
  name: String
  type: Type?

# A function of another module, whose type is asked of that module, as it may need its body
# checked.
export struct FunctionExport
  module_index: Int
  name: String

export struct GenericExport
  generic: GenericRef

# A `const` of another module; its type is nil until that module's top-level code is checked.
export struct ValueExport
  type: Type?
  constant: Constant?
  module_index: Int
  name: String

# A class or struct, which brings its info, or an enum or an alias.
export struct TypeExport
  type: Type
  info: ObjectInfo?

export struct InterfaceExport
  info: InterfaceInfo

# What a module exports under a name. The names are known from the syntax, so that the modules of
# an import cycle can import each other's before any is checked; an export itself is worked out
# when it is asked for.
export type Export =
  ExternExport | IntrinsicExport | FunctionExport | GenericExport | ValueExport | TypeExport
  InterfaceExport

# A name of another module, worked out when it is asked for (see export_of).
export struct ExportRef
  module_index: Int
  name: String

# `name` is the name the module knows it by: its alias, if it has one; `module` is the imported
# module as the import names it. An extern or an intrinsic of the module is its own export.
export class ImportedName
  args
    name: Identifier
    source: ExportRef | ExternExport | IntrinsicExport
    var used: Bool
    module: String

  # The local of an imported `const`, made once, as narrowed paths compare their roots by identity.
  var local: Local?

# A module imported as a name, `import 'module' as name`.
export class ModuleAlias
  args
    name: Identifier
    module_index: Int
    module: String
  var used = false

export class Imports
  names := Map<String, ImportedName>()

  # The modules imported as names, by their names.
  modules := Map<String, ModuleAlias>()

  # The module that std:builtins is.
  var builtins: Int?

# The declarations that the module exports, by name.
export exported_statements := (program: Statement[]) ->
  exported: Map<String, Exportable>
  for statement in program
    exported[declaration.name.name] = declaration if declaration := exported_declaration(statement)
  exported

# The names that the module exports from the modules it imports, by name, as those modules know
# them. The first of a name is kept; add_imports rejects the others.
export reexports_of := (module: Module) ->
  reexported: Map<String, ExportRef>
  for statement in module.program
    continue if statement is not Import or not statement.exported
    exporter := module.imported[statement]!
    for name in statement.names
      local := (name.alias else name.name).name
      unless local in reexported
        reexported[local] = { module_index: exporter, name: name.name.name }
  reexported

# The declaration that the module exports under the name, followed through the modules that export
# it from others; nil if the module exports no such name, or if they export it from each other.
export export_ref := (program: ProgramWide, module_index: Int, name: String) ->
  followed_export(program, { module_index, name }, Set())

# `passed` holds the names of the modules that the export has been followed through.
followed_export := (program: ProgramWide, ref: ExportRef, passed: Set<String>): ExportRef? ->
  shared := program.shared[ref.module_index]
  return ref if ref.name in shared.exported
  key := "#{ref.module_index} #{ref.name}"
  return nil unless passed.add(key)
  next := shared.reexported[ref.name] else return nil
  followed_export(program, next, passed)

# What the module exports under the name, besides its extends.
export export_of := (program: ProgramWide, module_index: Int, name: String): Export ->
  shared := program.shared[module_index]
  statement := shared.exported[name]!
  return GenericExport(generic) if generic := generic_function(shared, name)
  case statement
    when Declaration
      return FunctionExport(module_index, name) if statement.value is FunctionLiteral
      type := shared.facts.types[statement.name]
      ValueExport(module_index, name, type, constant: shared.top_level.locals[name]?.constant)
    # An extern's name is its own import, since add_extern rejects an import of the same name.
    # An extern's or an intrinsic's name is its own import, since add_extern and add_intrinsic
    # reject an import of the same name.
    when Extern, Intrinsic
      source := shared.imports.names[name]!.source
      source is ExportRef then panic('an extern or an intrinsic is imported') else source
    when TypeDeclaration
      type := object_type(shared, name)!
      TypeExport(type, info: program.infos[type.symbol])
    when EnumDeclaration then TypeExport(shared.enums[name]!)
    when InterfaceDeclaration then InterfaceExport(shared.interfaces[name]!)
    when TypeAlias then TypeExport(alias_type(shared, statement.name))

export imported_export := (program: ProgramWide, imported: ImportedName): Export ->
  source := imported.source
  case source
    when ExportRef then export_of(program, source.module_index, source.name)
    when ExternExport, IntrinsicExport then source

# The module's own names that clash with imports are rejected as they are declared.
export add_imports := (shared: Shared, statements: Statement[]) ->
  program := shared.program
  reexported: Set<String>
  for statement in statements
    if statement is Import
      exporter := program.modules[shared.index].imported[statement]!
      if statement.exported
        check_reexport shared, statement, exporter, reexported
      else
        shared.imports.builtins = exporter if statement.module == BUILTINS_MODULE
        add_import shared, statement, exporter

# The names that the module exports from another must be exported there, and must not be
# exported twice. `reexported` holds those of the module's earlier exports from others.
check_reexport := (shared: Shared, statement: Import, exporter: Int, reexported: Set<String>) ->
  program := shared.program
  for exported in statement.names
    { name } := exported
    unless export_ref(program, exporter, name.name)
      fail_no_export program, statement.module, name
    local := exported.alias else name
    is_twice := local.name in shared.exported or local.name in reexported
    fail_already_defined program, local if is_twice
    reexported.add local.name

fail_no_export := (program: ProgramWide, module: String, name: Identifier) ->
  fail program, name.position, "'#{module}' has no export '#{name.name}'"

add_import := (shared: Shared, statement: Import, exporter: Int) ->
  program := shared.program
  names := shared.imports.names
  if alias := statement.alias
    modules := shared.imports.modules
    fail_already_defined program, alias if alias.name in names or alias.name in modules
    modules[alias.name] = ModuleAlias(name: alias, module_index: exporter, module: statement.module)
  for imported in statement.names
    { name } := imported
    source :=
      export_ref(program, exporter, name.name) else fail_no_export(program, statement.module, name)
    local := imported.alias else name
    fail_already_defined program, local if has_import(shared, local.name)
    names[local.name] = ImportedName(source, name: local, used: false, module: statement.module)

# Whether the module imports a value by the name: a function, a `const` or an extern.
export imports_value := (shared: Shared, name: String) ->
  source := shared.imports.names[name]?.source else return false
  case source
    when ExternExport, IntrinsicExport then true
    when ExportRef
      exported := shared.program.shared[source.module_index].exported[source.name]!
      not names_a_type(exported)

names_a_type := (statement: Exportable) ->
  case statement
    when TypeDeclaration, EnumDeclaration, InterfaceDeclaration, TypeAlias then true
    else false

# A C function the module declares, which it calls as it calls those it imports from standard
# modules.
export add_extern := (shared: Shared, name: Identifier, type: Type, symbol: String) ->
  names := shared.imports.names
  fail_already_defined shared.program, name if has_import(shared, name.name)
  source := ExternExport(type, symbol, module_index: shared.index, name: name.name)
  names[name.name] = ImportedName(name, source, used: true, module: BUILTINS_MODULE)

# An intrinsic that the module declares, which it calls as it calls those it imports.
export add_intrinsic := (shared: Shared, name: Identifier, type: Type?) ->
  names := shared.imports.names
  fail_already_defined shared.program, name if has_import(shared, name.name)
  source := IntrinsicExport(type, name: name.name)
  names[name.name] = ImportedName(name, source, used: true, module: BUILTINS_MODULE)

export has_import := (shared: Shared, name: String) ->
  name in shared.imports.names or name in shared.imports.modules

# Imports the export that a written type's name `alias.export` names, so that the type is found by
# that name, which this gives (see qualified_import).
export import_qualified_type := (shared: Shared, type_name: NamedType) ->
  (alias, name) := type_name.name.split_once('.') else return nil
  qualified_import(shared, alias, Identifier(name, position: type_name.position))

# The name that the export of a module imported as `alias` is imported by, `alias.export`, which
# this imports on its first use, marking the module's import as used; nil if no module is imported
# as `alias`. An export that the module does not have is an error.
export qualified_import := (shared: Shared, alias: String, exported: Identifier) ->
  imported := shared.imports.modules[alias] else return nil
  imported.used = true
  program := shared.program
  name := exported.name
  source := export_ref(program, imported.module_index, name) else fail_no_export(
    program
    imported.module
    exported
  )
  qualified := "#{alias}.#{name}"
  names := shared.imports.names
  unless qualified in names
    local := Identifier(exported..., name: qualified)
    names[qualified] = ImportedName(source, name: local, used: true, module: imported.module)
  qualified

# The imported name, marked as used.
export use_import := (shared: Shared, name: String) ->
  imported := shared.imports.names[name] else return nil
  imported.used = true
  imported

# An imported type, marking its import as used.
export imported_type := (shared: Shared, name: String) ->
  imported := shared.imports.names[name] else return nil
  exported := imported_export(shared.program, imported) as TypeExport else return nil
  imported.used = true
  exported

# An imported `const` of another file as a local, so that it is read and narrowed as one; using it
# marks the import as used. One whose type is not known yet is left to
# type_of_export, which reports it where it is used.
export value_local := (shared: Shared, name: String) ->
  imported := shared.imports.names[name] else return nil
  return imported.local if imported.local
  exported := imported_export(shared.program, imported) as ValueExport else return nil
  type := exported.type else return nil
  imported.used = true
  local := Local(type, identifier: imported.name, used: true, constant: exported.constant)
  imported.local = local
  local

export builtin_export := (shared: Shared, name: String) ->
  program := shared.program
  builtins := shared.imports.builtins else return nil
  ref := export_ref(program, builtins, name) else return nil
  export_of(program, ref.module_index, ref.name)

# The module that declares what std:builtins exports under the name, which std:builtins may export
# from another module. std:builtins must export the name.
export builtins_declarer := (program: ProgramWide, name: String) ->
  ref := export_ref(program, program.builtins!, name)!
  program.shared[ref.module_index]

# A class, struct, enum or alias that std:builtins exports.
export builtin_type := (shared: Shared, name: String) ->
  exported := builtin_export(shared, name) else return nil
  exported is TypeExport then exported
