# Facts about literals: which expressions take their type from the context, and integer and
# string literals as the integer types that are expected.
import
  BinaryOperation, Expression, FloatLiteral, IntegerLiteral, StringLiteral, UnaryOperation
from '../ast'
import fail from './diagnostics'
import is_numeric_operator from './operator'
import ProgramWide from './shared'
import float_bits, integer_float_text from '../float_literals'
import format_type, int_type, integer_range, is_kind, Type from '../types'

# Whether an expression takes its type from the context: a literal, or arithmetic on such
# expressions, so that `1 + 2` is a Byte where one is expected.
export is_contextual := (expression: Expression): Bool ->
  case expression
    when IntegerLiteral, FloatLiteral, StringLiteral then true
    when UnaryOperation then expression.operator == '-' and is_contextual(expression.operand)
    when BinaryOperation
      { operator, left, right } := expression
      is_numeric_operator(operator) and is_contextual(left) and is_contextual(right)
    else false

# Whether a contextual expression holds a float literal, which is a Float unless a Float32 is
# expected. It decides more of its type than other literals do, which an Int fits too, so it is
# checked before them, as the operand, the item or the argument whose type the others take.
export holds_float_literal := (expression: Expression): Bool ->
  case expression
    when FloatLiteral then true
    when UnaryOperation then holds_float_literal(expression.operand)
    when BinaryOperation
      holds_float_literal(expression.left) or holds_float_literal(expression.right)
    else false

# The items, those of contextual expressions that hold a float literal first (see
# holds_float_literal), each in its order.
export float_first := <T>(items: T[], expression_of: (T) -> Expression) ->
  holds_float := (item: T) -> holds_float_literal(expression_of(item))
  floats := [item for item in items when holds_float(item)]
  [floats..., [item for item in items when not holds_float(item)]...]

# An integer literal where an integer type other than Int is expected, or a string literal of one
# character where a Byte or a Char is: one byte, or one code point.
export integer_literal := (
  program: ProgramWide, literal: IntegerLiteral | StringLiteral, type: Type
) ->
  at := literal.position
  case literal
    when IntegerLiteral
      { least, most } := integer_range(type)
      value := literal.value
      fits := value != nil and value >= least and value <= most
      fail program, at, "integer literal does not fit in #{format_type(type)}" unless fits
    when StringLiteral
      if is_kind(type, 'Char')
        one := literal.value.count() == 1
        fail program, at, 'a string literal used as a Char must be one code point' unless one
      else
        fits := literal.value.binary.length == 1
        fail program, at, 'a string literal used as a Byte must be one byte long' unless fits
  type

# A float literal, or an integer one where a Float or a Float32 is expected, must be finite as one,
# so that a mistyped exponent is found: an infinity is written INFINITY (see
# docs/reference/types.md#float). A hexadecimal integer one stands for the bits of an Int, so it
# must fit in one.
export float_literal := (program: ProgramWide, literal: Expression, type: Type) ->
  text :=
    case literal
      when FloatLiteral then literal.text
      when IntegerLiteral
        if is_hexadecimal(literal)
          int_literal program, literal
          return type
        integer_float_text literal
      else panic('not a number literal')
  if float_bits(text, type) == nil
    fail program, literal.position, "float literal does not fit in #{format_type(type)}"
  type

export int_literal := (program: ProgramWide, literal: IntegerLiteral) ->
  fail program, literal.position, 'integer literal does not fit in Int' if literal.value == nil
  int_type

is_hexadecimal := (literal: IntegerLiteral) ->
  (literal.text.without_prefix('-') ? literal.text).starts_with('0x')
