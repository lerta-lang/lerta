# Facts about literals: which expressions take their type from the context, and integer and
# string literals as the integer types that are expected.
import
  ArrayLiteral, binary_literal_bytes, BinaryOperation, Comprehension, Expression, FloatLiteral,
  IntegerLiteral, Interpolation, is_spread, StringLiteral, UnaryOperation
from '../ast'
import fail from './diagnostics'
import is_numeric_operator from './operator'
import ProgramWide from './shared'
import float_bits, integer_float_text from '../float_literals'
import format_type, int_type, integer_range, is_kind, Type from '../types'

# Whether an expression takes its type from the context: a literal, arithmetic on such
# expressions, so that `1 + 2` is a Byte where one is expected, or the spread of an array literal
# of them, as `[1, 2]...`.
export is_contextual := (expression: Expression): Bool ->
  return literal.elements.all(is_contextual) if literal := spread_literal(expression)
  case expression
    when IntegerLiteral, FloatLiteral, StringLiteral then true
    when Interpolation then binary_literal_bytes(expression) != nil
    when UnaryOperation then expression.operator in ['-', '~'] and is_contextual(expression.operand)
    when BinaryOperation
      { operator, left, right } := expression
      is_arithmetic := is_numeric_operator(operator) and not appends_to_literal(expression)
      is_arithmetic and is_contextual(left) and is_contextual(right)
    else false

# Whether `+` appends to a Binary literal on its left, which is then a Binary rather than a Byte, so
# that `b'a' + c` appends a byte, as `b'ab' + c` does.
export appends_to_literal := (binary: BinaryOperation) ->
  binary.operator == '+' and binary_literal_bytes(binary.left) != nil

# Whether a contextual expression holds a float literal, which is a Float unless a Float32 is
# expected. It decides more of its type than other literals do, which an Int fits too, so it is
# checked before them, as the operand, the item or the argument whose type the others take.
export holds_float_literal := (expression: Expression): Bool ->
  return literal.elements.any(holds_float_literal) if literal := spread_literal(expression)
  case expression
    when FloatLiteral then true
    when UnaryOperation then holds_float_literal(expression.operand)
    when BinaryOperation
      holds_float_literal(expression.left) or holds_float_literal(expression.right)
    else false

# The array literal that a spread goes through, as `[1, 2]` of `[1, 2]...`; nil for any other
# expression.
spread_literal := (expression: Expression) ->
  if is_spread(expression)
    (expression as Comprehension!).iterable as ArrayLiteral?
  else
    nil

# The items, those of contextual expressions that hold a float literal first (see
# holds_float_literal), each in its order.
export float_first := <T>(items: T[], expression_of: (T) -> Expression) ->
  holds_float := (item: T) -> holds_float_literal(expression_of(item))
  floats := [item for item in items when holds_float(item)]
  floats + [item for item in items when not holds_float(item)]

# An integer literal where an integer type other than Int is expected, a string literal of one code
# point where a Char is, or a Binary literal of one byte where a Byte is. A string literal is no
# Byte, which only a Binary literal is, as its bytes need not be text.
export integer_literal := (
  program: ProgramWide, literal: IntegerLiteral | StringLiteral | Interpolation, type: Type
) ->
  at := literal.position
  case literal
    when IntegerLiteral
      { least, most } := integer_range(type)
      value := literal.value
      fits := value != nil and value in least..=most
      unless fits
        fail program, at, "integer literal does not fit in #{format_type(type)}"
    when StringLiteral
      if is_kind(type, 'Char')
        one := literal.value.count() == 1
        unless one
          fail program, at, 'a string literal used as a Char must be one code point'
      else
        fail program, at, "a string literal is no Byte; write a Binary literal, as b'a'"
    when Interpolation
      fits := binary_literal_bytes(literal)!.length == 1
      unless fits
        fail program, at, 'a Binary literal used as a Byte must be one byte long'
  type

# A float literal, or an integer one where a Float or a Float32 is expected, must be finite as one,
# so that a mistyped exponent is found: an infinity is written INFINITY (see
# docs/reference/types.md#float). A hexadecimal integer one stands for the bits of an Int, so it
# must fit in one.
export float_literal := (program: ProgramWide, literal: Expression, type: Type) ->
  text :=
    case literal
      when FloatLiteral then literal.text
      when IntegerLiteral
        if is_hexadecimal(literal)
          int_literal program, literal
          return type
        integer_float_text literal
      else panic('not a number literal')
  if float_bits(text, type) == nil
    fail program, literal.position, "float literal does not fit in #{format_type(type)}"
  type

export int_literal := (program: ProgramWide, literal: IntegerLiteral) ->
  if literal.value == nil
    fail program, literal.position, 'integer literal does not fit in Int'
  int_type

is_hexadecimal := (literal: IntegerLiteral) ->
  (literal.text.without_prefix('-') else literal.text).starts_with('0x')
