# Facts about literals: which expressions take their type from the context, and literals as Bytes.
import
  BinaryOperation, Expression, FloatLiteral, IntegerLiteral, StringLiteral, UnaryOperation
from '../ast'
import fail from './diagnostics'
import is_numeric_operator from './operator'
import ProgramWide from './shared'
import float_bits from '../float_literals'
import byte_type, float_type from '../types'

# Whether an expression takes its type from the context: a literal, or arithmetic on such
# expressions, so that `1 + 2` is a Byte where one is expected.
export const is_contextual = (expression: Expression): Bool ->
  case expression
    when IntegerLiteral, StringLiteral then true
    when UnaryOperation then expression.operator == '-' and is_contextual(expression.operand)
    when BinaryOperation
      const { operator, left, right } = expression
      is_numeric_operator(operator) and is_contextual(left) and is_contextual(right)
    else false

export const byte_literal = (program: ProgramWide, literal: Expression) ->
  const message =
    case literal
      when IntegerLiteral
        const fits = literal.value >= 0 and literal.value <= 255
        fits then nil else 'integer literal does not fit in Byte'
      when StringLiteral
        const fits = literal.value.binary.length == 1
        fits then nil else 'a string literal used as a Byte must be one byte long'
      else 'a string literal used as a Byte must be one byte long'
  fail program, literal.position, message if message
  byte_type

# A float literal, or an integer one where a Float is expected, must be finite as a double: no
# Float is infinite (see docs/reference/types.md#float).
export const float_literal = (program: ProgramWide, literal: Expression) ->
  const text =
    case literal
      when FloatLiteral then literal.text
      when IntegerLiteral then "#{literal.value}"
      else panic('not a number literal')
  fail program, literal.position, 'float literal does not fit in Float' if float_bits(text) == nil
  float_type
