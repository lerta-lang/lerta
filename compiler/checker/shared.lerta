# What the checking of a program keeps: what is found for each module, which the checking of the
# others may read, and the state of the checking of one body. Objects refer to the modules, and to
# what each module declares, by index, so that no two of them refer to each other.
import
  Call, Exportable, Expression, FunctionLiteral, Identifier, Member, Node, Position
from '../ast'
import ExtensionMethod, Extensions from './extensions'
import Functions from './functions'
import GenericFunction, Instance from './generics'
import Imports from './imports'
import MemberTarget from './member_targets'
import Itab from './interface_values'
import InterfaceInfo from './interfaces'
import Module from '../loader'
import FieldInfo, ObjectInfo from './object_types'
import Local, Scopes from './scopes'
import TopLevelValues from './top_level_values'
import AliasEntry, Resolver from './type_names'
import EnumType, InterfaceType, ObjectType, Type from '../types'

# What each function literal that is not a top-level function captures from around it: the names
# and the types they have there, which may be narrowed.
export struct Capture
  name: String
  type: Type
  is_var: Bool
  # A weak local is captured as the box of its object (see captured_value in codegen).
  is_weak: Bool
  # `@`, or a `const` of it.
  is_this: Bool

# The type of a C function, and the module of the extern that first declared it.
export struct ExternType
  type: Type
  module_name: String

# A warning or an error: a warning is reported without stopping the compilation, and an error ends
# the checking of the part of the program it is found in (see check_part).
export struct Diagnostic
  message: String
  at: Position

# An error found in the module of the path, nil for the entry module.
export struct CheckError
  path: String?
  diagnostic: Diagnostic

# What the checking finds of each node of a body, which codegen reads.
export class NodeFacts
  # The type of every expression, and the type that the name of `x is T` stands for.
  types: Map<Node, Type> = Map()
  # The type an expression is converted to where it is used, such as an Int passed as an Int?.
  conversions: Map<Node, Type> = Map()
  # The members of enums that expressions name, `E.MEMBER` or `MEMBER`, as their places in them.
  enum_values: Map<Expression, Int> = Map()
  # What the members that are read or called refer to.
  members: Map<Member, MemberTarget> = Map()
  captures: Map<FunctionLiteral, Capture[]> = Map()
  # The instances of generic functions that calls call.
  instances: Map<Call, Instance> = Map()
  # The calls of `iter()` through which `for` and comprehensions go through the values of types
  # that satisfy Iterable, by those values (see type_of_iterated).
  iter_calls: Map<Expression, Call> = Map()
  # The itabs of the values converted to interface types (see interface_values).
  itabs: Map<Expression, Itab> = Map()
  # The `var`s that function literals capture, by their declarations' names.
  shared_vars: Set<Identifier> = Set()
  # The values that each function gives as its results, which tell `lerta fmt` whether its return
  # type can be inferred (see inferable).
  results: Map<FunctionLiteral, Expression[]> = Map()

# What is found for one module, and what its checkers share.
export class Shared
  # The program, which holds this module's Shared.
  weak! program: ProgramWide
  # The module's index, how messages name it, and the path that diagnostics give for it (see
  # Module).
  index: Int
  name: String
  path: String?
  imports: Imports
  extensions: Extensions
  top_level: TopLevelValues
  # What the module exports, besides its extends, by name (see export_of).
  exported: Map<String, Exportable>
  # What is found of the nodes of the module's code; an instance of a generic function has its own.
  facts = NodeFacts()
  warnings: Diagnostic[] = []
  functions = Functions()
  # The generic functions, then the generic methods of the module's own extends, in the order they
  # are declared; others refer to them by their places here (see GenericRef).
  generics: GenericFunction[] = []
  # The classes and structs that the module declares, by name.
  objects: Map<String, ObjectInfo> = Map()
  # The enums that the module declares, by name.
  enums: Map<String, EnumType> = Map()
  # The interfaces that the module declares, by name.
  interfaces: Map<String, InterfaceInfo> = Map()
  # Type aliases, resolved on first use, so that they can refer to each other in any order.
  aliases: Map<String, AliasEntry> = Map()
  resolving: Set<String> = Set()
  # The methods of the module's extends, which the modules that import it get.
  own_methods: ExtensionMethod[] = []
  # Whether the module's top-level code awaits, which makes the program's a coroutine (see main).
  top_level_awaits = false
  # The names of the top-level code, once it is checked: those never used are warned about once
  # the functions that may use them are checked (see warn_unused).
  top_level_scope: Map<String, Local>? = nil

# An instance of a generic class, struct or interface written before the fields and members of
# every generic one are known, which is checked once they are (see check_early_instances).
export struct EarlyInstance
  type: ObjectType | InterfaceType
  at: Position
  module_index: Int

# A call whose instance's written types are being resolved: an error in them is the call's (see
# resolve_annotation).
export struct AnnotatedCall
  at: Position
  context: String

# What the modules share: what each module's checking finds, the classes and structs of every
# module, by symbol, the type each C function was first declared with by an extern, and what a
# compile error reports with it.
export class ProgramWide
  entry_path: String
  modules: Module[]
  # Whether the errors are reported with the warnings, the checking going on after an error with the
  # other parts of the program (see check_part); not where the program is checked only to see
  # whether it checks, which the first error tells.
  reports_warnings: Bool
  shared: Shared[] = []
  infos: Map<String, ObjectInfo> = Map()
  # Whether the fields of every class and struct and the members of every interface are known;
  # until then, the instances given are kept to be checked then.
  members_known = false
  early_instances: EarlyInstance[] = []
  # The instances of generic interfaces whose members have been checked, by their type_key.
  checked_interfaces: Map<String, Bool> = Map()
  # The module that std:builtins is, if the program has it.
  builtins: Int? = nil
  # The itabs of the runtime's errors (see plan_runtime_errors).
  runtime_errors: Itab[] = []
  # The interfaces of every module, by symbol.
  interfaces: Map<String, InterfaceInfo> = Map()
  extern_types: Map<String, ExternType> = Map()
  errors: CheckError[] = []
  # The paths of the modules whose code is being checked, innermost last: an error is in the
  # innermost.
  module_paths: String?[] = []
  # The instances of generic functions being checked, as messages describe them, innermost last.
  contexts: String[] = []
  annotated_call: AnnotatedCall? = nil
  # The modules whose functions are checked, whose unused names can be told.
  bodies_checked: Int[] = []
  # The functions whose bodies are being checked, innermost last.
  functions_checked: FunctionLiteral[] = []
  # The functions whose types each function's body uses, which tell `lerta fmt` which functions
  # are recursive (see inferable).
  calls: Map<FunctionLiteral, FunctionLiteral[]> = Map()
  # Whether the written type of each parameter, by its name, is the one it would have without it,
  # from the function type expected or a default, every time it is checked; which tells `lerta fmt`
  # whether it can be left out (see inferable).
  inferable_parameters: Map<Identifier, Bool> = Map()

# The type of the object that `@` refers to: in a method, the method of an extend, or the
# initializer of a field, which sees the constructor arguments and the fields initialized before
# it.
export class SelfContext
  type: Type
  initializing: FieldInfo?

export struct Result
  value: Expression
  type: Type

# The function whose body is being checked: its written return type, or the one being inferred.
# For a function that yields, they are the item type of the Iter it returns instead, and its
# results are the values it yields; for a function that awaits, the value type of the Promise it
# returns.
export class FunctionContext
  literal: FunctionLiteral
  annotated: Type?
  yields: Bool
  awaits: Bool
  inferred: Type? = nil
  # The returned values, converted to the return type once it is known.
  results: Result[] = []

# The checking of one body: the top-level code, a function's, or the initializers of a class or
# struct. The body of a generic function's instance resolves its type parameters to its type
# arguments, and sees the extends where it is called (see Instance).
export class Body
  shared: Shared
  resolver: Resolver
  extensions: Extensions
  facts: NodeFacts
  context: FunctionContext?
  self: SelfContext?
  # For the body of a function literal: the body it is written in, whose locals it captures.
  enclosing: Body?
  # For a weak function literal's body: it captures `@` weakly.
  weak_this = default false
  program = @shared.program
  # Those it captures, if it is a function literal's.
  captures: Capture[] = []
  scopes = Scopes()
  loop_depth = 0
  # A function or a method sees the top-level values; the top-level code declares them.
  sees_top_level = @context != nil or @self != nil

  # Whether the code being checked is the module's top-level code, outside any block.
  is_top_level = -> not @sees_top_level and @scopes.depth() == 1

# How symbols name the module of the index (see Module).
export const module_symbol_name = (program: ProgramWide, index: Int) ->
  program.modules[index].symbol_name
