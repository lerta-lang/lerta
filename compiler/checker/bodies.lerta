# Checks the bodies of the module's functions, methods, instances of generic functions and
# initializers of fields, each on demand (see functions, generics and object_types).
import Identifier from '../ast'
import fail, in_module from './diagnostics'
import Extensions from './extensions'
import ordering_type from './builtins'
import receiver_instance from './generic_call'
import find_member, generic_method from './member'
import Method from './member_targets'
import annotated_type, FunctionEntry, parameter_types from './functions'
import Instance from './generics'
import ObjectInfo from './object_types'
import finish_function_type, function_context, reject_nil_result from './result'
import Body, NodeFacts, ProgramWide, SelfContext, Shared from './shared'
import reject_unsatisfied from './satisfaction'
import check_function_body, check_initializers, define_parameters from './statement'
import module_resolver, Resolver from './type_names'
import bool_type, format_qualified, format_type, FunctionType, int_type, Type from '../types'

# A body may be checked on demand from another module, such as the method `to_string` that an
# instance of `print` calls; its diagnostics give its own module.
export check_function := (program: ProgramWide, module_index: Int, entry: FunctionEntry) ->
  shared := program.shared[module_index]
  resolver := module_resolver(module_index)
  check_function_with shared, shared.facts, entry, resolver, shared.extensions

# An instance's body sees the names of its module, with the type parameters standing for its type
# arguments, and the extends of the type arguments where it is called.
export check_instance := (program: ProgramWide, module_index: Int, instance: Instance) ->
  { entry, resolver, extensions, facts } := instance
  check_function_with program.shared[module_index], facts, entry, resolver, extensions, false

# The defaults of an instance, once, for a call that leaves arguments out.
export check_instance_defaults := (
  program: ProgramWide, module_index: Int, instance: Instance
): void ->
  return if instance.defaults_checked
  instance.defaults_checked = true
  shared := program.shared[module_index]
  { entry, resolver, extensions, facts } := instance
  in_module shared, ->
    checked := function_body(shared, facts, entry, resolver, extensions)
    checked.body.scopes.push()
    define_parameters checked.body, entry.literal, checked.params, true
    checked.body.scopes.pop()

check_function_with := (
  shared: Shared
  facts: NodeFacts
  entry: FunctionEntry
  resolver: Resolver
  extensions: Extensions
  checks_defaults = true
): void ->
  program := shared.program
  in_module shared, ->
    literal := entry.literal
    if literal.weak
      fail program, literal.position, 'a top-level function or a method cannot be weak'
    { body, params, context } := function_body(shared, facts, entry, resolver, extensions)
    check_function_body body, literal, params, nil, checks_defaults
    # The conversions of the results are recorded even if the type was known from its annotation.
    finished := finish_function_type(context, params, facts)
    checked_type := reject_nil_result(program, finished, literal)
    reject_misfit program, entry, checked_type, resolver if entry.is_declared
    type := entry.type ? checked_type
    entry.type = type
    facts.types[literal] = type

annotated_result := (type: Type?) -> (type as FunctionType?)?.result

# A literal whose declaration writes its type must have that type, with the parameter types and
# the return type that it writes itself, and no defaults or variadic parameter, which a function
# type cannot tell, as for a local's literal.
reject_misfit := (program: ProgramWide, entry: FunctionEntry, checked: Type, resolver: Resolver) ->
  if param := entry.literal.params.find((each) -> each.default != nil)
    message := 'a function whose type is declared cannot have a default'
    fail program, param.default!.position, message
  if param := entry.literal.params.find((each) -> each.variadic)
    fail program, param.name.position, 'a function whose type is declared cannot be variadic'
  declared := entry.type!
  written := annotated_type(program, resolver, entry.literal)
  type := written ? checked
  return if type == declared
  message := "expected #{format_type(declared)}, got #{format_type(type)}"
  fail program, entry.literal.position, message

# The body in which the function's parameters, its defaults and its statements are checked, with
# the parameters' types and the context of its results.
function_body := (
  shared: Shared, facts: NodeFacts, entry: FunctionEntry, resolver: Resolver, extensions: Extensions
) ->
  { literal, this_type } := entry
  declared := entry.is_declared then entry.type as FunctionType?
  declared_params: Type?[] = [param for param in declared?.params ? []]
  params := parameter_types(shared.program, resolver, literal, declared_params)
  context := function_context(shared.program, literal, annotated_result(entry.type))
  self := this_type then SelfContext(this_type)
  { body: Body(shared, resolver, extensions, facts, context, self), params, context }

# The body in which code of the object's declaration is checked, in its module.
in_object := (program: ProgramWide, info: ObjectInfo, self: SelfContext?, check: (Body) -> void) ->
  shared := program.shared[info.module_index]
  { extensions } := shared
  in_module shared, ->
    check Body(shared, extensions, self, resolver: info.resolver, facts: info.facts)

export check_object := (program: ProgramWide, info: ObjectInfo) ->
  self := SelfContext(info.type)
  in_object program, info, self, (body) -> check_initializers(body, info, self)

# Once the type is checked, as its methods' types may need its fields'.
export check_satisfies := (program: ProgramWide, info: ObjectInfo): void ->
  satisfies := info.satisfies ? return
  at := info.declaration.satisfies!.position
  in_object program, info, nil, (body) -> reject_unsatisfied(body, info.type, satisfies, at)

# Rejects a class or struct whose own equals, compare or hash is not of its type, that has both
# equals and compare, or that has a hash but neither, by which equal values would be told.
export check_equality_methods := (program: ProgramWide, info: ObjectInfo): void ->
  methods := info.methods
  has := (name: String) -> name in methods
  return if not has('equals') and not has('compare') and not has('hash')
  in_object program, info, nil, (body) ->
    type := info.type
    name := format_type(type)
    at := (method: String) -> methods[method]!.position
    if has('equals') and has('compare')
      fail
        program
        at('equals')
        "#{name} has both equals and compare, which gives its == too; leave out equals"
    if has('hash') and not has('equals') and not has('compare')
      fail program, at('hash'), "#{name} has a hash but neither equals nor compare"
    expect_method := (method: String, expected: FunctionType) ->
      return if not has(method)
      name_at := Identifier(name: method, position: at(method))
      found := find_member(body, type, name_at)
      if found and found.type == expected
        target := found.target
        generic := target is Method then generic_method(target.source)
        if generic
          instance := receiver_instance(body, generic, type, name_at.position, nil)
          info.comparison_instances[method] = instance!
        return
      must := "#{method} of #{name} must be of type"
      got := found?.type ? return fail(program, at(method), "#{must} #{format_type(expected)}")
      # A type of the module may take the name of the builtin one: they are told apart by module.
      qualified := format_type(got) == format_type(expected)
      show := (each: Type) -> format_qualified(each, qualified)
      fail program, at(method), "#{must} #{show(expected)}, not #{show(got)}"
    expect_method 'equals', { params: [type], result: bool_type }
    expect_method 'compare', { params: [type], result: ordering_type(program) }
    expect_method 'hash', { params: [], result: int_type }
