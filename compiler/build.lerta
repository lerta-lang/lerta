# Builds a program: has clang compile the IR that codegen generates for it, written to a temporary
# directory, which is removed afterwards, and link it with the runtime's cached objects.
import is_file, make_dir, make_temp_dir, open, remove_tree from 'std:io'
import exit, run from 'std:process'
import ProgramWide from './checker/shared'
import run_clang_jobs from './clang_jobs'
import
  build_flags, BuildKind, executable_suffix, LTO_CACHE, lto_link_flags, UNIVERSAL_TARGET,
  UNIVERSAL_TRIPLES
from './clang_flags'
import generate from './codegen/codegen'
import check_program, write_ir from './compile'
import CompileError from './errors'
import is_absolute, join from './paths'
import target_system from './platform_description'
import real_path_text from './loader'
import cache_dir, cached_include_dir, cached_runtime from './runtime_cache'

# What to build: the executable `output`, or one in the temporary directory if nil, of `kind`,
# linked with `linked_files`, such as C files that define the program's externs, and given
# `linker_flags`, each passed to the linker as `-Wl,<flag>`.
export struct BuildRequest
  source: String
  linked_files: String[]
  linker_flags: String[]
  output: String?
  kind: BuildKind
  # `-Werror`: a warning stops the build, as an error does.
  warnings_as_errors: Bool
  # Without `--no-trace`: an uncaught exception prints its trace (see generate).
  traces: Bool
  # `--source-lines`: the program tells a debugger where its code comes from in the source.
  source_lines: Bool
  # `--eager-nan-checks`: each float operation checks its own result for NaN where it is (see
  # docs/internals/representation.md#floats).
  eager_nan_checks := default false

export build := (request: BuildRequest) -> build_then(request, nil)

# Builds the program in the temporary directory and runs it there with `args`, exiting with its
# exit code.
export build_and_run := (request: BuildRequest, args: String[]) -> build_then(request, args)

# Builds the executable, then runs it with `run_args`, if given, while the temporary directory,
# which holds the IR and, without an output, the executable, is still there. Exits with 0 or the
# code that the executable exits with. clang's messages go to stderr as clang writes them, and its
# failure exits with code 1.
build_then := (request: BuildRequest, run_args: String[]?) ->
  program := await check_program(request.source, request.warnings_as_errors)
  reject_input_as_output request, program
  reject_objective_c_off_macos request
  not_utf8 := CompileError('the temporary directory is not valid UTF-8')
  dir := make_temp_dir().text() ? throw not_utf8
  code :=
    try
      await build_in_dir(request, program, dir, run_args)
    finally
      await remove_tree(dir)
  # A Windows program that crashes exits with an NTSTATUS, such as 0xC0000005, which exit does not
  # take.
  exit code in 0..=255 then code else 255

# The output would replace a file that the build reads, which another path may name: a module,
# whose key is its real path, or a linked file.
reject_input_as_output := (request: BuildRequest, program: ProgramWide) ->
  output := request.output ? return
  return unless is_file(output)
  real_output := real_path_text(output)
  linked := [real_path_text(file) for file in request.linked_files when is_file(file)]
  inputs := [[module.key for module in program.modules]..., linked...]
  return unless inputs.any((input) -> input == real_output)
  throw CompileError("the output '#{output}' is an input of the build")

# clang compiles Objective-C for other systems too, but links it only with Apple's runtime.
reject_objective_c_off_macos := (request: BuildRequest) ->
  file := request.linked_files.find((file) -> file.ends_with('.m')) ? return
  return if target_system(request.kind.target) == 'macos'
  throw CompileError("'#{file}' is Objective-C, which links only for macOS")

# What build_then exits with: 1 if clang, lipo or dsymutil fails.
build_in_dir := (request: BuildRequest, program: ProgramWide, dir: String, run_args: String[]?) ->
  var executable: String?
  if request.kind.target == UNIVERSAL_TARGET
    executable = await build_universal(request, program, dir)
  else
    executable = await link_executable(request, program, dir, '')
  return 1 unless executable
  # On macOS, the debug information stays in the object files, which are removed, so dsymutil
  # copies it beside the executable first; it reads their paths from the executable, as the link
  # was given them, in the directory it ran in.
  if request.source_lines and target_system(request.kind.target) == 'macos'
    return 1 if (await run('dsymutil', executable, cwd: real_path_text(dir))).code != 0
  program_args := run_args ? return 0
  (await run(executable, program_args...)).code

# Links an executable for each of UNIVERSAL_TRIPLES, from objects in a directory of its own under
# `dir`, and has lipo join them into the executable; nil if either fails.
build_universal := (request: BuildRequest, program: ProgramWide, dir: String) ->
  slices: String[]
  for triple in UNIVERSAL_TRIPLES
    make_dir join(dir, triple)
    kind: BuildKind = { request.kind..., target: triple }
    slice_request: BuildRequest = { request..., output: join(dir, "#{triple}/program"), kind }
    slice := await link_executable(slice_request, program, dir, "#{triple}/") ? return nil
    slices.push slice
  executable := executable_path(request, dir)
  return nil if (await run('lipo', '-create', '-output', executable, slices...)).code != 0
  executable

# The path of the executable that the link writes: the output, or one in `dir`.
executable_path := (request: BuildRequest, dir: String) ->
  work_dir := real_path_text(dir)
  default := join(work_dir, "program#{executable_suffix(request.kind.target)}")
  link_path real_path_text('.'), request.output ? default

# Has clang compile the program for the request's target in `dir`, into objects whose names relative
# to it start with `prefix`, and link it there; the executable's path, or nil if clang fails.
link_executable := (request: BuildRequest, program: ProgramWide, dir: String, prefix: String) ->
  { kind } := request
  runtime := await cached_runtime(kind, dir) ? return nil
  { function_attributes, coro_end_type } := runtime
  { traces, source_lines, eager_nan_checks } := request
  modules := generate
    program
    function_attributes
    coro_end_type
    { traces, source_lines, eager_nan_checks, separate: true, optimized: kind.optimize }
  flags := build_flags(kind)
  objects := await compile_modules(modules, flags, dir, prefix) ? return nil
  # The linked C and Objective-C files may include the runtime's header.
  compiles_c := request.linked_files.any((file) -> file.ends_with('.c') or file.ends_with('.m'))
  include_flags: String[] = compiles_c then ["-I#{await cached_include_dir()}"] else []
  # The link runs in the temporary directory and names the modules' objects in it, and the paths it
  # is given besides are under the directory the compiler runs in (see
  # docs/internals/architecture.md#per-module-output).
  cwd := real_path_text('.')
  work_dir := real_path_text(dir)
  executable := executable_path(request, dir)
  # libm, which std:math calls, is apart from libc on Linux; elsewhere -lm links nothing more.
  libraries := ["-l#{library}" for library in ['m', runtime.libraries...]]
  lto_cache := join(real_path_text(cache_dir()), LTO_CACHE)
  system := target_system(kind.target)
  lto_flags := kind.optimize then lto_link_flags(system, lto_cache)
  # dsymutil (below) reads the debug information from the objects, which the link-time optimizer
  # makes in a directory that it removes unless told one.
  keeps_objects := source_lines and system == 'macos' and kind.optimize
  lto_objects: String[] =
    keeps_objects then ["-Wl,-object_path_lto,#{join(work_dir, "#{prefix}lto")}"] else []
  args := [
    objects...
    flags...
    include_flags...
    (lto_flags ? [])...
    lto_objects...
    [real_path_text(object) for object in runtime.objects]...
    [link_path(cwd, file) for file in request.linked_files]...
    ["-Wl,#{flag}" for flag in request.linker_flags]...
    # Last, as GNU ld with --as-needed drops a library that nothing before it on the line needs.
    libraries...
    '-o'
    executable
  ]
  # clang's driver for macOS, given a source to compile as it links with -flto, has the linker keep
  # what it optimizes in a directory under TMPDIR, which it never removes; under the temporary
  # directory, it is removed with it.
  clang := await run('clang', args..., cwd: work_dir, env: { 'TMPDIR': work_dir })
  clang.code == 0 then executable

# The path that the link, which runs in the build's temporary directory, is given for a file named
# on the command line: a relative one below `cwd`, the directory the compiler runs in, written there
# as it is, so that the system resolves its `..` and the symbolic links on its way from there, as it
# did when clang ran in that directory. Worked out as text instead, a `..` would cancel the name
# before it, which names another file when that name is a link or is not there at all. A path from a
# root alone, as `/out` on Windows, is left to the drive of the directory the link runs in, as `C:a`
# is left to the drive's own directory (see compiler/paths.lerta).
link_path := (cwd: String, path: String) -> is_absolute(path) then path else "#{cwd}/#{path}"

# Has clang compile the IR of each module, written to `dir`, into an object file there, as many at
# once as there are CPUs; the objects' paths relative to `dir`, which start with `prefix`, or nil if
# it fails for any.
compile_modules := (modules: String[][], flags: String[], dir: String, prefix: String) ->
  names := ["#{prefix}module#{i}" for _, i in modules]
  paths := [join(dir, name) for name in names]
  for (path, lines) in paths.zip(modules)
    { writer } := open("#{path}.ll", WRITE)
    await write_ir(lines, writer)
    await writer.end()
  # clang warns that the .ll has no target triple; it is given here, or the host's is meant.
  job := (path: String) -> ['-Wno-override-module', '-c', "#{path}.ll", flags..., '-o', "#{path}.o"]
  jobs := [job(path) for path in paths]
  return nil unless await run_clang_jobs(jobs)
  ["#{name}.o" for name in names]
