# Builds a program: has clang compile the IR that codegen generates for it and link it with the
# runtime, both written to a temporary directory, which is removed afterwards.
import { make_temp_dir, remove_tree, stderr, write_file } from 'std:io'
import { exit, run } from 'std:process'
import { all_warnings } from './checker/diagnostics'
import { check_modules } from './checker/modules'
import { generate } from './codegen/codegen'
import { embedded_source, EMBEDDED_PATHS } from './embedded'
import { load_modules } from './loader'
import { basename, has_extension, join } from './paths'

# What to build: the executable `output`, or one in the temporary directory if nil, for `target`
# (a triple such as i686-linux-gnu) or else for the host, linked with `linked_files`, such as C
# files that define the program's externs.
export struct BuildRequest
  source: String
  linked_files: Array<String>
  output: String?
  optimize: Bool
  target: String?

# The checked program of the entry module `source`, whose warnings are printed. A compile error is
# thrown.
export const check_program = (source: String) ->
  const program = check_modules(source, load_modules(source))
  stderr.write "#{warning}\n" for warning in all_warnings(program)
  program

export const generate_ir = (source: String) -> generate(check_program(source))

export const build = (request: BuildRequest) -> build_then(request, (_executable) -> 0)

# Builds the program in the temporary directory and runs it there with `args`, exiting with its
# exit code.
export const build_and_run = (request: BuildRequest, args: Array<String>) ->
  build_then request, (executable) -> run(executable, args)

# Builds the executable, then has `use` take it while the temporary directory, which holds the
# IR, the runtime and, without an output, the executable, is still there. Exits with the code that
# `use` returns. clang's messages go to stderr as clang writes them, and its failure exits with
# code 1.
const build_then = (request: BuildRequest, use: (String) -> Int) ->
  const ir = generate_ir(request.source)
  const dir = make_temp_dir().decode_utf8() ? throw 'the temporary directory is not valid UTF-8'
  const ir_path = join(dir, 'program.ll')
  write_file ir_path, ir.binary
  const executable = request.output ? join(dir, "program#{executable_suffix(request.target)}")
  const clang_status = run('clang', clang_args(request, ir_path, write_runtime(dir), executable))
  const code = clang_status == 0 then use(executable) else 1
  remove_tree dir
  exit code

# Writes the embedded runtime, runtime/*.c and runtime/*.h, to `dir`, and returns the paths of
# the C files.
const write_runtime = (dir: String) ->
  const c_files: Array<String> = []
  for path in EMBEDDED_PATHS
    continue if not path.binary.occurs_at(0, 'runtime/'.binary)
    const file = join(dir, basename(path))
    write_file file, embedded_source(path)!.binary
    c_files.push file if has_extension(file, '.c')
  c_files

const MINGW_SUFFIX = '-w64-mingw32'.binary

const is_mingw = (target: String) ->
  const triple = target.binary
  triple.occurs_at triple.length - MINGW_SUFFIX.length, MINGW_SUFFIX

# What the name of an executable for the target ends with: `.exe` for Windows. Without a target,
# it is for the host, which is not Windows, as the compiler does not run there yet.
export const executable_suffix = (target: String?) ->
  target and is_mingw(target) then '.exe' else ''

# test/runtime.ts builds the runtime with the same flags.
# Link-time optimization lets the generated code inline the runtime's C functions; unoptimized
# builds use the debug runtime, which checks for leaks at exit.
const clang_args = (
  request: BuildRequest, ir_path: String, runtime_c_files: Array<String>, output: String
) ->
  # clang warns that the .ll has no target triple; it is given here, or the host's is meant.
  const args = ['-Wno-override-module', ir_path]
  if const target = request.target
    args.push "--target=#{target}"
    # GNU ld, which clang uses for mingw by default, cannot link the bitcode of -flto.
    args.push '-fuse-ld=lld' if is_mingw(target)
  const flags = request.optimize then ['-O2', '-flto'] else ['-D', 'LERTA_DEBUG']
  args.push flag for flag in flags
  args.push file for file in runtime_c_files
  args.push file for file in request.linked_files
  args.push '-o'
  args.push output
  args
