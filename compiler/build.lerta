# Builds a program: has clang compile the IR that codegen generates for it, written to a temporary
# directory, which is removed afterwards, and link it with the runtime's cached objects.
import make_temp_dir, remove_tree, stderr, write_file from 'std:io'
import exit, run from 'std:process'
import all_warnings from './checker/diagnostics'
import check_modules from './checker/modules'
import ProgramWide from './checker/shared'
import build_flags, executable_suffix from './clang_flags'
import generate from './codegen/codegen'
import CompileError from './errors'
import load_modules from './loader'
import join from './paths'
import cached_runtime from './runtime_cache'

# What to build: the executable `output`, or one in the temporary directory if nil, for `target`
# (a triple such as i686-linux-gnu) or else for the host, linked with `linked_files`, such as C
# files that define the program's externs.
export struct BuildRequest
  source: String
  linked_files: Array<String>
  output: String?
  optimize: Bool
  target: String?
  # `-Werror`: a warning stops the build, as an error does.
  warnings_as_errors: Bool

# The checked program of the entry module `source`, whose warnings are printed; with
# `warnings_as_errors`, a warning exits with code 1, as an error does. A compile error is thrown.
export const check_program = (source: String, warnings_as_errors: Bool) ->
  const program = check_modules(source, load_modules(source))
  const warnings = all_warnings(program)
  stderr.write "#{warning}\n" for warning in warnings
  exit 1 if warnings_as_errors and warnings.length > 0
  program

# The IR as `dump-llvm` prints it: without the function attributes of a target, which a build
# gets from clang, and for LLVM before 23 (see IrModule).
export const generate_ir = (source: String, warnings_as_errors: Bool) ->
  generate(check_program(source, warnings_as_errors), '', 'i1', false)[0]

export const build = (request: BuildRequest) -> build_then(request, nil)

# Builds the program in the temporary directory and runs it there with `args`, exiting with its
# exit code.
export const build_and_run = (request: BuildRequest, args: Array<String>) ->
  build_then request, args

# Builds the executable, then runs it with `run_args`, if given, while the temporary directory,
# which holds the IR and, without an output, the executable, is still there. Exits with 0 or the
# code that the executable exits with. clang's messages go to stderr as clang writes them, and its
# failure exits with code 1.
const build_then = (request: BuildRequest, run_args: Array<String>?) ->
  const program = check_program(request.source, request.warnings_as_errors)
  const not_utf8 = CompileError(message: 'the temporary directory is not valid UTF-8')
  const dir = make_temp_dir().text() ? throw not_utf8
  const code = try
    await build_in_dir(request, program, dir, run_args)
  finally
    remove_tree dir
  exit code

# What build_then exits with: 1 if clang fails.
const build_in_dir = (
  request: BuildRequest, program: ProgramWide, dir: String, run_args: Array<String>?
) ->
  const runtime = (await cached_runtime(request.optimize, request.target, dir)) ? return 1
  const modules = generate(program, runtime.function_attributes, runtime.coro_end_type, true)
  const ir_paths = [join(dir, "module#{i}.ll") for _, i in modules]
  write_file path, text.binary for (path, text) in ir_paths.zip(modules)
  const executable = request.output ? join(dir, "program#{executable_suffix(request.target)}")
  const libraries = ["-l#{library}" for library in runtime.libraries]
  const args = clang_args(request, ir_paths, [runtime.objects..., libraries...], executable)
  return 1 if await run('clang', args) != 0
  const program_args = run_args ? return 0
  await run(executable, program_args)

const clang_args = (
  request: BuildRequest, ir_paths: Array<String>, runtime: Array<String>, output: String
) ->
  # clang warns that the .ll has no target triple; it is given here, or the host's is meant.
  const flags = build_flags(request.optimize, request.target)
  ['-Wno-override-module', ir_paths..., flags..., runtime..., request.linked_files..., '-o', output]
