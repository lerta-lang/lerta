# What the compiler does with arrays that the builtin arrays do not do yet: sorting, and taking
# all items but the last.

# The items but the last; none for an empty array.
export const all_but_last = <T>(items: Array<T>): Array<T> ->
  [items[i] for i in 0...(items.length - 1)]

# The items in the order that `compare` gives (negative when its first argument goes first), equal
# items keeping their order.
export const sorted = <T>(items: Array<T>, compare: (T, T) -> Int): Array<T> ->
  const result: Array<T> = []
  for item in items
    var index = result.length
    index -= 1 while index > 0 and compare(result[index - 1], item) > 0
    result.push item
    var i = result.length - 1
    while i > index
      result[i] = result[i - 1]
      i -= 1
    result[index] = item
  result
