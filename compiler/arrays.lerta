# The items but the last; none for an empty array, which a slice to one before its end could not
# give, as the compiler's blocks may be empty.
export all_but_last := <T>(items: T[]): T[] ->
  items.is_empty() then [] else items.slice(0, items.length - 1)

# Removes the items from `length` on, and gives them, in order; `length` is at most the number of
# items.
export take_from := <T>(items: T[], length: Int) ->
  taken := items.slice(length)
  items.truncate length
  taken
