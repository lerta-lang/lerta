# The command line of minilerta, which the seed is: `minilerta <source>` prints the IR of the
# source, as `lerta dump-llvm` does, for clang to build. The seed needs nothing more (see
# docs/internals.md#bootstrap).
import stdout from 'std:io'
import argv, exit from 'std:process'
import generate_ir from './compile'

if argv.length != 1 or argv[0].starts_with('-')
  print_error 'usage: minilerta <source>'
  exit 2
await stdout.write(await generate_ir(argv[0], false))
