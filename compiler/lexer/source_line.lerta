# A line of a source, as bytes, or the part of one that `column_offset` code points precede.
# Diagnostics count columns in code points, so a position is a byte index that `column` converts.
import { compile_error } from '../errors'

export struct SourceLine
  path: String
  bytes: Binary
  number: Int
  column_offset: Int
  length = @bytes.length
  # The number of code points before each byte index, the length included.
  code_points_before = count_code_points(@bytes)

  # The column of the byte at `index`, starting at 1.
  column = (index: Int) -> @column_offset + @code_points_before[index] + 1

  fail = (message: String, index: Int) ->
    compile_error @path, @number, @column(index), message

  text = (start: Int, end: Int) -> @bytes.text(start, end)!

  # The index of the first `byte` from `start` on, or nil if there is none.
  index_of = (byte: Byte, start: Int) ->
    for i in start...@length
      return i if @bytes[i] == byte
    nil

  # The index of the first byte from `start` on that fails `test`, or the length.
  scan_while = (start: Int, test: (Byte) -> Bool) ->
    var end = start
    end += 1 while end < @length and test(@bytes[end])
    end

  # The code point whose UTF-8 sequence starts at `index`.
  code_point_at = (index: Int) ->
    const lead = @bytes[index].to_int()
    const length = lead < 0x80 then 1 else lead < 0xE0 then 2 else lead < 0xF0 then 3 else 4
    var value =
      case length
        when 1 then lead
        when 2 then lead % 32
        when 3 then lead % 16
        else lead % 8
    value = value * 64 + @bytes[index + k].to_int() % 64 for k in 1...length
    value

const count_code_points = (bytes: Binary) ->
  const counts = [0]
  var count = 0
  for byte in bytes
    count += 1 if not is_continuation(byte)
    counts.push count
  counts

const is_continuation = (byte: Byte) -> byte >= 0x80 and byte <= 0xBF
