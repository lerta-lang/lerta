# `"..."` literals: escapes and `#{expression}` interpolation, within one line.
import { hex_digit_value } from '../hex'
import { SourceLine } from './source_line'

export struct TextPart
  text: String

# The source of an interpolated expression, parsed later; `column` is where it starts.
export struct CodePart
  source: String
  column: Int

export type TemplatePart = TextPart | CodePart

const MAX_CODE_POINT = 0x10FFFF

# Reads the literal whose opening quote is at `start`. Returns its parts and the index after it.
export const scan_double_quoted = (line: SourceLine, start: Int) ->
  const parts: Array<TemplatePart> = []
  var text: Array<Byte> = []
  var i = start + 1
  while true
    line.fail 'unterminated string literal', start if i == line.length
    const c = line.bytes[i]
    case
      when c == '"' then break
      when c == '\'
        const escape = read_escape(line, i)
        text.push byte for byte in escape.value
        i = escape.end
      when c == '#' and line.bytes.occurs_at(i + 1, '{'.binary)
        const brace = find_interpolation_end(line, i + 2)
        const close = brace ? line.fail('unterminated interpolation', i)
        parts.push TextPart(text: decode(text)) if text.length > 0
        text = []
        parts.push CodePart(source: line.text(i + 2, close), column: line.column(i + 2))
        i = close + 1
      else
        text.push c
        i += 1
  parts.push TextPart(text: decode(text)) if text.length > 0 or parts.length == 0
  { parts, end: i + 1 }

# Escapes and interpolations split the text only between whole characters.
const decode = (bytes: Array<Byte>) -> bytes.to_binary().text()!

const read_escape = (line: SourceLine, start: Int) ->
  const kind: Byte = start + 1 < line.length then line.bytes[start + 1] else 0
  const simple = simple_escape(kind)
  return { value: simple.binary, end: start + 2 } if simple
  line.fail 'invalid escape sequence', start if not line.bytes.occurs_at(start + 1, 'u{'.binary)
  const close = line.index_of('}', start + 3) ? line.fail('invalid unicode escape', start)
  const digits = line.bytes.slice(start + 3, close)
  const code_point = parse_code_point(digits) ? line.fail('invalid unicode escape', start)
  { value: encode_utf8(code_point), end: close + 1 }

const simple_escape = (kind: Byte) ->
  case kind
    when 'n' then "\n"
    when 't' then "\t"
    when 'r' then "\r"
    when '0' then "\0"
    when '\' then '\'
    when '"' then '"'
    when '#' then '#'
    else nil

# The code point that 1 to 6 hexadecimal digits give, or nil if they do not give one.
const parse_code_point = (digits: Binary) ->
  return nil if digits.length == 0 or digits.length > 6
  var value = 0
  for digit in digits
    const digit_value = hex_digit_value(digit) ? return nil
    value = value * 16 + digit_value
  const is_surrogate = value >= 0xD800 and value <= 0xDFFF
  value <= MAX_CODE_POINT and not is_surrogate then value else nil

const encode_utf8 = (code_point: Int) ->
  const bytes: Array<Byte> = case
    when code_point < 0x80 then [code_point.to_byte()]
    when code_point < 0x800 then [(0xC0 + code_point / 0x40).to_byte(), continuation(code_point)]
    when code_point < 0x10000
      const lead = (0xE0 + code_point / 0x1000).to_byte()
      [lead, continuation(code_point / 0x40), continuation(code_point)]
    else
      const lead = (0xF0 + code_point / 0x40000).to_byte()
      const second = continuation(code_point / 0x1000)
      const third = continuation(code_point / 0x40)
      [lead, second, third, continuation(code_point)]
  bytes.to_binary()

# The continuation byte of the low 6 bits.
const continuation = (bits: Int) -> (0x80 + bits % 0x40).to_byte()

# The index of the `}` that closes an interpolation, skipping nested braces and string literals.
# Each arm moves past what it reads.
const find_interpolation_end = (line: SourceLine, start: Int): Int? ->
  var depth = 0
  var i = start
  while i < line.length
    case line.bytes[i]
      when '"' then i = scan_double_quoted(line, i).end
      when "'"
        const close = line.index_of("'", i + 1) ? return nil
        i = close + 1
      when '{'
        depth += 1
        i += 1
      when '}'
        return i if depth == 0
        depth -= 1
        i += 1
      else i += 1
  nil
