# `"..."` literals, within one line, and `"""` literals, over the lines up to their closing `"""`:
# escapes and `#{expression}` interpolation. `'''` literals span lines as `"""` ones do, without
# escapes or interpolation.
import SourceLine from './source_line'

export struct TextPart
  text: String

# The source of an interpolated expression, parsed later; it starts at `line` and `column`.
export struct CodePart
  source: String
  line: Int
  column: Int

export type TemplatePart = TextPart | CodePart

# Reads the literal whose opening quote is at `start`. Returns its parts and the index after it.
export scan_double_quoted := (line: SourceLine, start: Int) ->
  template := Template()
  at_end := (i: Int) -> i == line.length or line.bytes[i] == '"'
  close := read_template(line, start + 1, template, at_end)
  line.fail 'unterminated string literal', start if close == line.length
  { parts: template.finish(), end: close + 1 }

# A `"""` or `'''` literal: its parts, the line of its closing quotes and the index after them.
export struct MultilineLiteral
  parts: TemplatePart[]
  line: SourceLine
  end: Int

# Reads the literal whose opening quotes, `"""` or `'''`, end the line `lines[first]`, at `start`.
# Its text is that of the lines after it, up to its closing quotes, without their common
# indentation, joined by line feeds.
export scan_multiline := (lines: SourceLine[], first: Int, start: Int) ->
  is_raw := lines[first].bytes[start] == "'"
  var last = first
  var close: Int?
  while close == nil
    last += 1
    lines[first].fail('unterminated string literal', start) if last == lines.length
    close = is_raw then closing_raw_quotes(lines[last]) else closing_quotes(lines[last])
  ends := [i == last then close! else lines[i].length for i in (first + 1)...(last + 1)]
  texts := [lines[first + 1 + i].text(0, end) for end, i in ends]
  width := common_indentation(texts)
  template := Template()
  for end, i in ends
    template.text += "\n" if i > 0
    continue if is_blank(texts[i])
    line := lines[first + 1 + i]
    if is_raw
      template.text += line.text(width, end)
    else
      read_template line, width, template, (j) -> j == end
  MultilineLiteral parts: template.finish(), line: lines[last], end: close! + 3

# The least of the leading spaces of the lines that are not blank, which a `"""` or `'''` literal
# leaves out of each.
export common_indentation := (lines: String[]) ->
  var width: Int?
  for line in lines
    continue if is_blank(line)
    spaces := leading_spaces(line)
    width = spaces if width == nil or spaces < width
  width ? 0

# Whether the line of a `"""` or `'''` literal is blank, which makes it empty, whatever its
# indentation.
export is_blank := (line: String) -> leading_spaces(line) == line.binary.length

leading_spaces := (line: String) ->
  var count = 0
  count += 1 while count < line.binary.length and line.binary[count] == ' '
  count

# The index of the `'''` that closes a `'''` literal on the line, if one does: the first there.
closing_raw_quotes := (line: SourceLine) -> line.bytes.index_of("'''".binary)

# The index of the `"""` that closes a `"""` literal on the line, if one does. A `\` escapes the
# character after it, so `\"""` is no closing, nor is one in an interpolation.
closing_quotes := (line: SourceLine) ->
  var i = 0
  while i < line.length
    return i if line.bytes.occurs_at(i, '"""'.binary)
    if line.bytes.occurs_at(i, '#{'.binary)
      brace := find_interpolation_end(line, i + 2)
      i = (brace ? line.fail('unterminated interpolation', i)) + 1
    else
      i += line.bytes[i] == '\' then 2 else 1
  nil

# The parts of a literal as they are read.
class Template
  parts: TemplatePart[] = []
  # The text since the last interpolation.
  text = ''

  add_code = (part: CodePart) ->
    @parts.push TextPart(text: @text) if not @text.is_empty()
    @text = ''
    @parts.push part

  finish = ->
    @parts.push TextPart(text: @text) if not @text.is_empty() or @parts.is_empty()
    @parts

# Reads the text from `start` into the template, up to where `at_end` holds, which it holds at the
# end of the line, if not before. Returns the index there.
read_template := (line: SourceLine, start: Int, template: Template, at_end: (Int) -> Bool) ->
  # The bytes from `plain` on need no change and are taken whole; escapes and interpolations split
  # them only between whole characters.
  var i = start
  var plain = i
  while not at_end(i)
    c := line.bytes[i]
    case
      when c == '\'
        escape := read_escape(line, i)
        template.text += line.text(plain, i)
        template.text += escape.value
        i = escape.end
        plain = i
      when c == '#' and line.bytes.occurs_at(i + 1, '{'.binary)
        brace := find_interpolation_end(line, i + 2)
        close := brace ? line.fail('unterminated interpolation', i)
        template.text += line.text(plain, i)
        source := line.text(i + 2, close)
        template.add_code { source, line: line.number, column: line.column(i + 2) }
        i = close + 1
        plain = i
      else i += 1
  template.text += line.text(plain, i)
  i

read_escape := (line: SourceLine, start: Int) ->
  kind: Byte = start + 1 < line.length then line.bytes[start + 1] else 0
  simple := simple_escape(kind)
  return { value: simple, end: start + 2 } if simple
  line.fail 'invalid escape sequence', start if not line.bytes.occurs_at(start + 1, 'u{'.binary)
  close := line.index_of('}', start + 3) ? line.fail('invalid unicode escape', start)
  digits := line.bytes[(start + 3)...close]
  char := parse_char(digits) ? line.fail('invalid unicode escape', start)
  { value: char.to_string(), end: close + 1 }

simple_escape := (kind: Byte) ->
  case kind
    when 'n' then "\n"
    when 't' then "\t"
    when 'r' then "\r"
    when '0' then "\0"
    when '\' then '\'
    when '"' then '"'
    when '#' then '#'
    else nil

# The Char that 1 to 6 hexadecimal digits give, or nil if they give none.
parse_char := (digits: Binary) ->
  return nil if digits.is_empty() or digits.length > 6
  var value = 0
  for digit in digits
    digit_value := digit.hex_value() ? return nil
    value = value << 4 | digit_value
  value.to_char()

# The index of the `}` that closes an interpolation, skipping nested braces and string literals with
# the interpolations in them. It reads them in a loop, not by recursion, as they may nest deep.
find_interpolation_end := (line: SourceLine, start: Int) ->
  # The braces open in the code of each interpolation being read, and where each string literal in
  # that code starts, the innermost last: a string is being read where there are as many of each.
  braces := [0]
  strings: Int[]
  var i = start
  while i < line.length
    byte := line.bytes[i]
    if strings.length == braces.length
      if byte == '\'
        i += 1
      else if byte == '"'
        strings.pop()
      else if byte == '#' and line.bytes.occurs_at(i + 1, '{'.binary)
        braces.push 0
        i += 1
    else
      case byte
        when '"' then strings.push(i)
        when "'" then i = line.index_of("'", i + 1) ? return nil
        when '{' then braces[braces.length - 1] += 1
        when '}'
          open := braces.pop()
          return i if braces.is_empty() and open == 0
          braces.push open - 1 if open > 0
        else pass
    i += 1
  line.fail 'unterminated string literal', strings.last()! if not strings.is_empty()
  nil
