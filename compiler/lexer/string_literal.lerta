# `"..."` literals, within one line, and `"""` literals, over the lines up to their closing `"""`:
# escapes and `#{expression}` interpolation. `'''` literals span lines as `"""` ones do, without
# escapes or interpolation. `b"..."` literals read as `"..."` ones, into a Binary.
import SourceLine from './source_line'

# The bytes are valid UTF-8, except in a Binary literal.
export struct TextPart
  bytes: Binary

# The source of an interpolated expression, parsed later; it starts at `line` and `column`.
export struct CodePart
  source: String
  line: Int
  column: Int

export type TemplatePart = TextPart | CodePart

# Reads the literal whose opening quote is at `start`, of a Binary literal if `is_binary`. Returns
# its parts and the index after it.
export scan_double_quoted := (line: SourceLine, start: Int, is_binary: Bool) ->
  template := Template()
  at_end := (i: Int) -> i == line.length or line.bytes[i] == b'"'
  close := read_template(line, start + 1, template, is_binary, at_end)
  line.fail 'unterminated string literal', start if close == line.length
  { parts: template.finish(), end: close + 1 }

# A `"""` or `'''` literal: its parts, the line of its closing quotes and the index after them.
export struct MultilineLiteral
  parts: TemplatePart[]
  line: SourceLine
  end: Int

# Reads the literal whose opening quotes, `"""` or `'''`, end the line `lines[first]`, at `start`.
# Its text is that of the lines after it, up to its closing quotes, without their common
# indentation, joined by line feeds.
export scan_multiline := (lines: SourceLine[], first: Int, start: Int) ->
  is_raw := lines[first].bytes[start] == b"'"
  var last = first
  var close: Int?
  while close == nil
    last += 1
    lines[first].fail('unterminated string literal', start) if last == lines.length
    close = is_raw then closing_raw_quotes(lines[last]) else closing_quotes(lines[last])
  assert close
  ends := [i == last then close else lines[i].length for i in (first + 1)..=last]
  texts := [lines[first + 1 + i].text(0, end) for end, i in ends]
  width := common_indentation(texts)
  template := Template()
  for end, i in ends
    template.bytes += b"\n" if i > 0
    continue if is_blank(texts[i])
    line := lines[first + 1 + i]
    if is_raw
      template.bytes += line.bytes[width..end]
    else
      read_template line, width, template, false, (j) -> j == end
  MultilineLiteral parts: template.finish(), line: lines[last], end: close + 3

# The least of the leading spaces of the lines that are not blank, which a `"""` or `'''` literal
# leaves out of each.
export common_indentation := (lines: String[]) ->
  (leading_spaces(line) for line in lines when not is_blank(line)).min() ? 0

# Whether the line of a `"""` or `'''` literal is blank, which makes it empty, whatever its
# indentation.
export is_blank := (line: String) -> line.binary.all((byte) -> byte == b' ')

leading_spaces := (line: String) ->
  var count = 0
  count += 1 while count < line.binary.length and line.binary[count] == b' '
  count

# The index of the `'''` that closes a `'''` literal on the line, if one does: the first there.
closing_raw_quotes := (line: SourceLine) -> line.bytes.index_of(b"'''")

# The index of the `"""` that closes a `"""` literal on the line, if one does. A `\` escapes the
# character after it, so `\"""` is no closing, nor is one in an interpolation.
closing_quotes := (line: SourceLine) ->
  var i = 0
  while i < line.length
    return i if line.bytes.occurs_at(i, b'"""')
    if line.bytes.occurs_at(i, b'#{')
      brace := find_interpolation_end(line, i + 2)
      i = (brace ? line.fail('unterminated interpolation', i)) + 1
    else
      i += line.bytes[i] == b'\' then 2 else 1
  nil

# The parts of a literal as they are read.
class Template
  parts: TemplatePart[] = []
  # The bytes since the last interpolation.
  var bytes = b''

  add_code := (part: CodePart) ->
    @parts.push TextPart(@bytes) unless @bytes.is_empty()
    @bytes = b''
    @parts.push part

  finish := ->
    @parts.push TextPart(@bytes) if not @bytes.is_empty() or @parts.is_empty()
    @parts

# Reads the text from `start` into the template, up to where `at_end` holds, which it holds at the
# end of the line, if not before. Returns the index there.
read_template := (
  line: SourceLine, start: Int, template: Template, is_binary: Bool, at_end: (Int) -> Bool
) ->
  # The bytes from `plain` on need no change and are taken whole; escapes and interpolations split
  # them only between whole characters.
  var i = start
  var plain = i
  until at_end(i)
    c := line.bytes[i]
    case
      when c == b'\'
        escape := read_escape(line, i, is_binary)
        template.bytes += line.bytes[plain..i]
        template.bytes += escape.value
        i = escape.end
        plain = i
      when c == b'#' and line.bytes.occurs_at(i + 1, b'{')
        brace := find_interpolation_end(line, i + 2)
        close := brace ? line.fail('unterminated interpolation', i)
        template.bytes += line.bytes[plain..i]
        source := line.text(i + 2, close)
        template.add_code { source, line: line.number, column: line.column(i + 2) }
        i = close + 1
        plain = i
      else i += 1
  template.bytes += line.bytes[plain..i]
  i

# A `\xHH` escape gives any byte in a Binary literal, and an ASCII one, up to `\x7F`, in a String.
read_escape := (line: SourceLine, start: Int, is_binary: Bool) ->
  kind := line.bytes.get(start + 1) ? 0
  simple := simple_escape(kind)
  return { value: simple.binary, end: start + 2 } if simple
  return read_byte_escape(line, start, is_binary) if kind == b'x'
  line.fail 'invalid escape sequence', start unless line.bytes.occurs_at(start + 1, b'u{')
  close := line.index_of(b'}', start + 3) ? line.fail('invalid unicode escape', start)
  digits := line.bytes[(start + 3)..close]
  char := parse_char(digits) ? line.fail('invalid unicode escape', start)
  { value: char.to_string().binary, end: close + 1 }

read_byte_escape := (line: SourceLine, start: Int, is_binary: Bool) ->
  end := start + 4
  digits := end <= line.length then line.bytes[(start + 2)..end] else b''
  value := parse_byte(digits) ? line.fail('invalid byte escape', start)
  if not is_binary and not value <= 0x7F
    line.fail 'a String takes \x00 to \x7F, and other characters as \u{...}', start
  { value: [value].to_binary(), end }

# The Byte that 2 hexadecimal digits give, or nil if they give none.
export parse_byte := (digits: Binary) ->
  return nil if digits.length != 2
  high := digits[0].hex_value() ? return nil
  low := digits[1].hex_value() ? return nil
  (high << 4 | low).to_byte()

simple_escape := (kind: Byte) ->
  case kind
    when b'n' then "\n"
    when b't' then "\t"
    when b'r' then "\r"
    when b'0' then "\0"
    when b'\' then '\'
    when b'"' then '"'
    when b'#' then '#'
    else nil

# The Char that 1 to 6 hexadecimal digits give, or nil if they give none.
export parse_char := (digits: Binary) ->
  return nil if digits.is_empty() or digits.length > 6
  var value = 0
  for digit in digits
    digit_value := digit.hex_value() ? return nil
    value = value << 4 | digit_value
  value.to_char()

# The code of an interpolation being read: the braces open in it, and where the string literal
# being read in it starts, if one is.
class InterpolationLevel
  var braces = 0
  var string_start: Int? = nil

# The index of the `}` that closes an interpolation, skipping nested braces and string literals with
# the interpolations in them. It reads them in a loop, not by recursion, as they may nest deep.
export find_interpolation_end := (line: SourceLine, start: Int) ->
  # The innermost last.
  levels := [InterpolationLevel()]
  var i = start
  while i < line.length
    byte := line.bytes[i]
    level := levels.last()!
    if level.string_start != nil
      if byte == b'\'
        i += 1
      else if byte == b'"'
        level.string_start = nil
      else if byte == b'#' and line.bytes.occurs_at(i + 1, b'{')
        levels.push InterpolationLevel()
        i += 1
    else
      case byte
        when b'"' then level.string_start = i
        when b"'" then i = line.index_of(b"'", i + 1) ? return nil
        when b'{' then level.braces += 1
        when b'}'
          if level.braces > 0
            level.braces -= 1
          else
            levels.pop()
            return i if levels.is_empty()
        else pass
    i += 1
  # The innermost string left open: every level but the innermost is in one.
  for level in levels.reversed()
    line.fail 'unterminated string literal', start if start := level.string_start
  nil
