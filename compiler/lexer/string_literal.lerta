# `"..."` literals: escapes and `#{expression}` interpolation, within one line.
import hex_digit_value from '../hex'
import SourceLine from './source_line'

export struct TextPart(text: String)

# The source of an interpolated expression, parsed later; `column` is where it starts.
export struct CodePart(source: String, column: Int)

export type TemplatePart = TextPart | CodePart

# Reads the literal whose opening quote is at `start`. Returns its parts and the index after it.
export const scan_double_quoted = (line: SourceLine, start: Int) ->
  const parts: TemplatePart[] = []
  # The text since the last interpolation, and the bytes from `plain` on, which need no change and
  # are taken whole; escapes and interpolations split it only between whole characters.
  var text = ''
  var i = start + 1
  var plain = i
  while true
    line.fail 'unterminated string literal', start if i == line.length
    const c = line.bytes[i]
    case
      when c == '"' then break
      when c == '\'
        const escape = read_escape(line, i)
        text += line.text(plain, i)
        text += escape.value
        i = escape.end
        plain = i
      when c == '#' and line.bytes.occurs_at(i + 1, '{'.binary)
        const brace = find_interpolation_end(line, i + 2)
        const close = brace ? line.fail('unterminated interpolation', i)
        text += line.text(plain, i)
        parts.push TextPart(text) if text != ''
        text = ''
        parts.push CodePart(source: line.text(i + 2, close), column: line.column(i + 2))
        i = close + 1
        plain = i
      else i += 1
  text += line.text(plain, i)
  parts.push TextPart(text) if text != '' or parts.length == 0
  { parts, end: i + 1 }

const read_escape = (line: SourceLine, start: Int) ->
  const kind: Byte = start + 1 < line.length then line.bytes[start + 1] else 0
  const simple = simple_escape(kind)
  return { value: simple, end: start + 2 } if simple
  line.fail 'invalid escape sequence', start if not line.bytes.occurs_at(start + 1, 'u{'.binary)
  const close = line.index_of('}', start + 3) ? line.fail('invalid unicode escape', start)
  const digits = line.bytes.slice(start + 3, close)
  const char = parse_char(digits) ? line.fail('invalid unicode escape', start)
  { value: char.to_string(), end: close + 1 }

const simple_escape = (kind: Byte) ->
  case kind
    when 'n' then "\n"
    when 't' then "\t"
    when 'r' then "\r"
    when '0' then "\0"
    when '\' then '\'
    when '"' then '"'
    when '#' then '#'
    else nil

# The Char that 1 to 6 hexadecimal digits give, or nil if they give none.
const parse_char = (digits: Binary) ->
  return nil if digits.length == 0 or digits.length > 6
  var value = 0
  for digit in digits
    const digit_value = hex_digit_value(digit) ? return nil
    value = value << 4 | digit_value
  value.to_char()

# The index of the `}` that closes an interpolation, skipping nested braces and string literals.
# Each arm moves past what it reads.
const find_interpolation_end = (line: SourceLine, start: Int): Int? ->
  var depth = 0
  var i = start
  while i < line.length
    case line.bytes[i]
      when '"' then i = scan_double_quoted(line, i).end
      when "'"
        const close = line.index_of("'", i + 1) ? return nil
        i = close + 1
      when '{'
        depth += 1
        i += 1
      when '}'
        return i if depth == 0
        depth -= 1
        i += 1
      else i += 1
  nil
