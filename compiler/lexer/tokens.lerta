# Splits a source into tokens, with the indentation as indent and dedent tokens. Covers only the
# tokens the parser uses so far; any other character is an unexpected character until the feature
# that needs it is implemented.
import Position from '../position'
import compile_error from '../errors'
import hex, hex_digit_value from '../hex'
import SourceLine from './source_line'
import
  MultilineLiteral, scan_double_quoted, scan_multiline, TemplatePart, TextPart
from './string_literal'

# A keyword or a punctuation is its own kind, whose text is its own. The others are named:
# INTERPOLATED is a string with interpolations, LINE_BREAK a line end inside brackets (see
# Brackets), and INDENT and DEDENT the start and the end of an indented block.
export enum TokenKind
  IDENTIFIER
  INTEGER
  FLOAT
  STRING
  INTERPOLATED
  NEWLINE
  LINE_BREAK
  INDENT
  DEDENT
  EOF
  'true'
  'false'
  'nil'
  'and'
  'or'
  'not'
  'const'
  'var'
  'if'
  'else'
  'while'
  'for'
  'break'
  'continue'
  'return'
  'case'
  'then'
  'class'
  'struct'
  'throw'
  'import'
  'export'
  'extern'
  'extend'
  'enum'
  'interface'
  'try'
  'catch'
  'finally'
  'yield'
  'await'
  '...'
  '=='
  '!='
  '<='
  '>='
  '+='
  '-='
  '*='
  '/='
  '%='
  '&='
  '|='
  '^='
  ':='
  '->'
  '('
  ')'
  '['
  ']'
  '{'
  '}'
  ','
  '.'
  ':'
  '+'
  '-'
  '*'
  '/'
  '%'
  '<'
  '>'
  '='
  '?'
  '!'
  '@'
  '|'
  '&'
  '^'

export struct Token
  kind: TokenKind
  # The identifier name, the number's text without separators (with its `0x` prefix if
  # hexadecimal), the string literal's contents or the punctuation; empty for layout tokens.
  text: String
  # Whether whitespace or the start of the line precedes it: `f (x)` and `f(x)` parse differently.
  spaced: Bool
  line: Int
  # Counted in code points, starting at 1.
  column: Int
  # The parts of an interpolated string.
  parts: TemplatePart[]?
  # The line and the column after it, where the formatter reads its spelling up to; those of its
  # start for a layout token. Only a `"""` or `'''` literal ends on a later line.
  end_line = default @line
  end_column = default @column

  position = -> Position(line: @line, column: @column)

# A comment, which runs from its `#` to the end of its line, alone on it if `own_line`. The
# compiler skips comments; the formatter puts them back by the tokens around them.
export struct Comment(line: Int, column: Int, own_line: Bool)

export struct Lexed(tokens: Token[], comments: Comment[])

# `path` names the source in diagnostics.
export tokenize := (source: String, path: String) -> lex(source, path).tokens

# The tokens, and the comments apart from them.
export lex := (source: String, path: String) ->
  tokens: Token[]
  comments: Comment[]
  layout := Layout(path, tokens)
  lines := source_lines(source, path)
  # The lines up to this number are inside a `"""` or `'''` literal.
  var literal_end = 0
  for line in lines
    continue if line.number <= literal_end
    indent := line.scan_while(0, is_space)
    continue if indent == line.length
    if line.bytes[indent] == '#'
      comments.push { own_line: true, line: line.number, column: line.column(indent) }
      continue
    line.fail 'tabs are not allowed in indentation', indent if line.bytes[indent] == "\t"
    layout.start_line line, indent
    var scanner = LineScanner(line, position: indent)
    while true
      layout.add token for token in scanner.run()
      start := scanner.multiline_start ? break
      literal := scan_multiline(lines, scanner.line.number - 1, start)
      layout.add multiline_token(scanner.line, start, literal)
      scanner = LineScanner(line: literal.line, position: literal.end)
      literal_end = literal.line.number
    last := scanner.line
    if index := scanner.comment_index
      comments.push { own_line: false, line: last.number, column: last.column(index) }
    layout.end_line last, indent
  layout.finish lines.length
  Lexed tokens, comments

source_lines := (source: String, path: String) ->
  texts := source.split("\n")
  lines: SourceLine[]
  for text, index in texts
    ends_with_lf := index + 1 < texts.length
    bytes := ends_with_lf then without_carriage_return(text) else text.binary
    lines.push { path, bytes, number: index + 1, column_offset: 0 }
  lines

# The tokens of an interpolated expression, placed where it is in the source line.
export tokenize_fragment := (source: String, path: String, line: Int, column: Int) ->
  fragment := SourceLine(path, bytes: source.binary, number: line, column_offset: column - 1)
  scanner := LineScanner(line: fragment, position: 0)
  tokens := scanner.run()
  fragment.fail 'unterminated string literal', start if start := scanner.multiline_start
  end := fragment.column(fragment.length)
  tokens.push layout_token(NEWLINE, line, end)
  tokens.push layout_token(EOF, line, end)
  tokens

# A line that LF ends may end with CRLF.
without_carriage_return := (line: String) ->
  bytes := line.binary
  ends_with_cr := bytes.length > 0 and bytes[bytes.length - 1] == "\r"
  ends_with_cr then bytes.slice(0, bytes.length - 1) else bytes

layout_token := (kind: TokenKind, line: Int, column: Int) ->
  Token kind, line, column, text: '', spaced: true

# A level of the layout: the indentation of its blocks, from its base, and the brackets open in it.
# The file is one; a line inside brackets that ends with `->` opens another, of an indented block
# on the lines after it, whose base is that line's indentation (see Layout).
class Frame
  indents: Int[]
  open: Token[] = []

  # The indentation that ends the frame's block: no deeper than its base.
  base = -> @indents[0]

# Lines are laid out by indentation into blocks, which INDENT, NEWLINE and DEDENT mark. Lines inside
# brackets continue the line that opened them, whatever their indentation, and end with a
# LINE_BREAK, which the parser reads as it reads the brackets: a separator in a list, and nothing in
# a grouping. A line inside brackets that ends with `->`, followed by a line indented deeper, opens
# an indented block there, a function's body, laid out as any block, which a line no deeper than
# the one with `->`, or a closing bracket of the brackets it is in, ends.
class Layout
  path: String
  tokens: Token[]
  frames = [Frame(indents: [0])]
  # The indentation of the line inside brackets that ended with `->`, if the last one did.
  arrow_indent: Int? = nil

  frame = -> @frames.last()!

  in_brackets = -> @frame().open.length > 0

  start_line = (line: SourceLine, indent: Int) ->
    column := line.column(indent)
    if base := @arrow_indent
      @arrow_indent = nil
      if indent > base
        # The line break after `->` ends the line that the block's body follows.
        arrow_end := @tokens.pop()
        @tokens.push layout_token(NEWLINE, arrow_end.line, arrow_end.column)
        @frames.push Frame(indents: [base, indent])
        @tokens.push layout_token(INDENT, line.number, column)
        return
    while @frames.length > 1 and not @in_brackets() and indent <= @frame().base()
      @close_frame line.number, column
      @tokens.push layout_token(LINE_BREAK, line.number, column)
    return if @in_brackets()
    # A closing bracket that starts a line of a block closes the brackets around it, whatever its
    # indentation (see add).
    first := line.bytes[indent]
    return if @frames.length > 1 and (first == ')' or first == ']' or first == '}')
    indents := @frame().indents
    if indent > indents.last()!
      indents.push indent
      @tokens.push layout_token(INDENT, line.number, column)
      return
    while indent < indents.last()!
      indents.pop()
      @tokens.push layout_token(DEDENT, line.number, column)
    line.fail 'indentation does not match any outer block', indent if indent != indents.last()!

  # A closing bracket in a block that has none open closes the brackets that the block is in,
  # which ends the block first.
  add = (token: Token) ->
    open := @frame().open
    case token.kind
      when '(', '[', '{' then open.push(token)
      when ')', ']', '}'
        if open.length == 0 and @frames.length > 1
          # A bracket at the start of a line follows the line end of the block's last line.
          after_line_end := @tokens.last()!.kind == NEWLINE
          @tokens.push layout_token(NEWLINE, token.line, token.column) if not after_line_end
          @close_frame token.line, token.column
        # An extra closing bracket is left to the parser to report.
        @frame().open.pop() if @in_brackets()
      else pass
    @tokens.push token

  end_line = (line: SourceLine, indent: Int) ->
    in_brackets := @in_brackets()
    ends_with_arrow := @tokens.length > 0 and @tokens.last()!.kind == '->'
    @arrow_indent = indent if in_brackets and ends_with_arrow
    kind: TokenKind = in_brackets then LINE_BREAK else NEWLINE
    @tokens.push layout_token(kind, line.number, line.column(line.length))

  # Ends the innermost frame's block, which leaves the line in the brackets around it.
  close_frame = (line: Int, column: Int) ->
    frame := @frames.pop()
    @tokens.push layout_token(DEDENT, line, column) for _ in 1...frame.indents.length

  finish = (eof_line: Int) ->
    unclosed := @frames.find((frame) -> frame.open.length > 0)
    if frame := unclosed
      bracket := frame.open.last()!
      compile_error @path, bracket.line, bracket.column, "'#{bracket.kind}' is never closed"
    indents := @frame().indents
    @tokens.push layout_token(DEDENT, eof_line, 1) for _ in 1...indents.length
    @tokens.push layout_token(EOF, eof_line, 1)

# The tokens of one line, from `position`.
class LineScanner
  line: SourceLine
  position: Int
  tokens: Token[] = []
  # Where the comment that ends the line starts, if any; scanning stops at it.
  comment_index: Int? = nil
  # Where the `"""` or `'''` that opens a literal on the lines after it starts, if the line ends
  # with one; scanning stops at it, and the caller reads the literal.
  multiline_start: Int? = nil

  run = ->
    while @position < @line.length
      c := @line.bytes[@position]
      case
        when c == ' ' then @position += 1
        when c == '#'
          @comment_index = @position
          break
        when @at_multiline_quotes()
          quotes := @line.text(@position, @position + 3)
          # Quoted with the other quote, which is clearer than the same one next to them.
          shown := quotes == '"""' then "'#{quotes}'" else "\"#{quotes}\""
          @line.fail "#{shown} must end its line", @position if @position + 3 != @line.length
          @multiline_start = @position
          break
        when is_identifier_start(c) then @scan_word()
        when c == "'" then @scan_raw_string()
        when c == '"' then @scan_double_quoted()
        when c.is_digit() then @scan_number()
        else @scan_punctuation()
    @tokens

  at_multiline_quotes = ->
    bytes := @line.bytes
    bytes.occurs_at(@position, '"""'.binary) or bytes.occurs_at(@position, "'''".binary)

  # Adds the token that starts at the position, and moves to `end`, after it.
  add = (kind: TokenKind, text: String, end: Int, parts: TemplatePart[]?) ->
    start := @position
    spaced := start == 0 or @line.bytes[start - 1] == ' '
    column := @line.column(start)
    end_column := @line.column(end)
    @tokens.push { kind, text, spaced, parts, column, end_column, line: @line.number }
    @position = end

  scan_word = ->
    end := @line.scan_while(@position, is_identifier_part)
    word := @line.text(@position, end)
    @add keyword_kind(word) ? IDENTIFIER, word, end, nil

  scan_raw_string = ->
    start := @position
    close := @line.index_of("'", start + 1) ? @line.fail('unterminated string literal', start)
    @add STRING, @line.text(start + 1, close), close + 1, nil

  scan_double_quoted = ->
    { parts, end } := scan_double_quoted(@line, @position)
    if text := plain_text(parts)
      @add STRING, text, end, nil
    else
      @add INTERPOLATED, '', end, parts

  # A `.` begins a fraction only before a digit, so `1.f()` stays an integer and a member.
  scan_number = ->
    bytes := @line.bytes
    after_digits := (start: Int) -> @line.scan_while(start, is_identifier_part)
    var end = after_digits(@position)
    is_decimal := not @line.text(@position, end).starts_with('0x')
    # What looks like a fraction is taken whole (see Float literals in docs/reference/syntax.md).
    at_dot := end + 1 < @line.length and bytes[end] == '.'
    after_dot: Byte = at_dot then bytes[end + 1] else ' '
    has_fraction := after_dot.is_digit() or after_dot == '_'
    end = after_digits(end + 1) if has_fraction
    ends_with_exponent := bytes[end - 1] == 'e' or bytes[end - 1] == 'E'
    # The sign is taken even with no digit after it, so that a diagnostic shows it.
    sign_follows := end < @line.length and (bytes[end] == '+' or bytes[end] == '-')
    end = after_digits(end + 1) if is_decimal and ends_with_exponent and sign_follows
    text := @line.text(@position, end)
    digits := text.split('_').join('')
    return @add(INTEGER, digits, end, nil) if is_integer_literal(text)
    return @add(FLOAT, digits, end, nil) if is_float_literal(text)
    @line.fail "invalid number literal '#{text}'", @position

  # The longest punctuation that starts here; `...` is the longest of all. What follows may not be
  # a whole character, so a slice that is not valid UTF-8 is skipped. No word starts here, so no
  # keyword or named kind can match.
  scan_punctuation = ->
    for length in [3, 2, 1]
      end := @position + length
      continue if end > @line.length
      text := @line.bytes.text(@position, end) ? continue
      if kind := TokenKind.parse(text)
        @add kind, text, end, nil
        return
    @fail_unexpected_character()

  # Control characters such as '\r' would garble the error line if printed raw.
  fail_unexpected_character = ->
    number := @line.char_at(@position).to_int()
    is_printable_ascii := number >= 0x20 and number <= 0x7E
    shown :=
      if is_printable_ascii
        "'#{@line.text(@position, @position + 1)}'"
      else
        "U+#{hex(number, 4)}"
    @line.fail "unexpected character #{shown}", @position

# The token of the `"""` or `'''` literal that starts at `start` on the line.
multiline_token := (line: SourceLine, start: Int, literal: MultilineLiteral) ->
  plain := plain_text(literal.parts)
  kind: TokenKind = plain != nil then STRING else INTERPOLATED
  parts := plain != nil then nil else literal.parts
  Token
    kind
    parts
    text: plain ? ''
    spaced: start == 0 or line.bytes[start - 1] == ' '
    line: line.number
    column: line.column(start)
    end_line: literal.line.number
    end_column: literal.line.column(literal.end)

# The text of a literal without interpolations, or nil.
plain_text := (parts: TemplatePart[]) ->
  return nil if parts.length != 1
  part := parts[0]
  part is TextPart then part.text

# The kind of a keyword; the named kinds are no keywords, so that a name such as EOF stays a name.
keyword_kind := (word: String) ->
  kind := TokenKind.parse(word) ? return nil
  case kind
    when IDENTIFIER, INTEGER, FLOAT, STRING, INTERPOLATED, NEWLINE then nil
    when LINE_BREAK, INDENT, DEDENT, EOF then nil
    else kind

is_space := (c: Byte) -> c == ' '
is_identifier_start := (c: Byte) -> c.is_letter() or c == '_'
is_identifier_part := (c: Byte) -> is_identifier_start(c) or c.is_digit()
is_hex_digit := (c: Byte) -> hex_digit_value(c) != nil

is_float_literal := (text: String) ->
  parts := text.split('e').join('E').split('E')
  return false if parts.length > 2
  significand := parts[0].split('.')
  return false if significand.length > 2 or (parts.length == 1 and significand.length == 1)
  return false if not is_integer_literal(significand[0]) or significand[0].starts_with('0x')
  return false if significand.length == 2 and not is_digit_run(significand[1])
  return true if parts.length == 1
  exponent := parts[1].without_prefix('-') ? parts[1].without_prefix('+') ? parts[1]
  is_digit_run exponent

# Digits, with separators between them.
is_digit_run := (text: String) ->
  bytes := text.binary
  return false if bytes.length == 0 or not bytes[0].is_digit()
  for i in 1...bytes.length
    c := bytes[i]
    separates_digits := c == '_' and i + 1 < bytes.length and bytes[i + 1].is_digit()
    return false if not c.is_digit() and not separates_digits
  true

is_integer_literal := (text: String) ->
  bytes := text.binary
  if text.starts_with('0x')
    return false if text == '0x'
    for i in 2...bytes.length
      return false if not is_hex_digit(bytes[i])
    return true
  return text == '0' if text.starts_with('0')
  is_digit_run text
