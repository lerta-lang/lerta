# Splits a source into tokens, with the indentation as indent and dedent tokens. Covers only the
# tokens the parser uses so far; any other character is an unexpected character until the feature
# that needs it is implemented.
import { compile_error } from '../errors'
import { hex, hex_digit_value } from '../hex'
import { SourceLine } from './source_line'
import { scan_double_quoted, TemplatePart, TextPart } from './string_literal'

# A keyword or a punctuation is its own kind, whose text is its own. The others are named:
# INTERPOLATED is a string with interpolations, LINE_BREAK a line end inside brackets (see
# Brackets), and INDENT and DEDENT the start and the end of an indented block.
export enum TokenKind
  IDENTIFIER
  INTEGER
  STRING
  INTERPOLATED
  NEWLINE
  LINE_BREAK
  INDENT
  DEDENT
  EOF
  'true'
  'false'
  'nil'
  'and'
  'or'
  'not'
  'const'
  'var'
  'if'
  'else'
  'while'
  'for'
  'in'
  'break'
  'continue'
  'return'
  'case'
  'when'
  'then'
  'class'
  'struct'
  'throw'
  'import'
  'export'
  'extern'
  'extend'
  'enum'
  'interface'
  'try'
  'catch'
  'finally'
  '...'
  '=='
  '!='
  '<='
  '>='
  '+='
  '-='
  '*='
  '/='
  '%='
  '->'
  '('
  ')'
  '['
  ']'
  '{'
  '}'
  ','
  '.'
  ':'
  '+'
  '-'
  '*'
  '/'
  '%'
  '<'
  '>'
  '='
  '?'
  '!'
  '@'
  '|'

export struct Token
  kind: TokenKind
  # The identifier name, the integer's text without separators (with its `0x` prefix if
  # hexadecimal), the string literal's contents or the punctuation; empty for layout tokens.
  text: String
  # Whether whitespace or the start of the line precedes it: `f (x)` and `f(x)` parse differently.
  spaced: Bool
  line: Int
  # Counted in code points, starting at 1.
  column: Int
  # The parts of an interpolated string.
  parts: Array<TemplatePart>?

# `path` names the source in diagnostics.
export const tokenize = (source: String, path: String) ->
  const tokens: Array<Token> = []
  const indents = [0]
  const brackets = Brackets(path)
  const lines = source.split("\n")
  for text, index in lines
    const ends_with_lf = index + 1 < lines.length
    const bytes = ends_with_lf then without_carriage_return(text) else text.binary
    const line = SourceLine(path, bytes, number: index + 1, column_offset: 0)
    const indent = line.scan_while(0, is_space)
    const is_blank = indent == line.length or line.bytes[indent] == '#'
    continue if is_blank
    line.fail 'tabs are not allowed in indentation', indent if line.bytes[indent] == "\t"
    emit_indentation tokens, indents, line, indent if not brackets.are_open()
    for token in LineScanner(line, position: indent).run()
      brackets.update token
      tokens.push token
    const kind: TokenKind = brackets.are_open() then LINE_BREAK else NEWLINE
    tokens.push layout_token(kind, line.number, line.column(line.length))
  brackets.check_closed()
  const eof_line = lines.length
  while indents.length > 1
    indents.pop()
    tokens.push layout_token(DEDENT, eof_line, 1)
  tokens.push layout_token(EOF, eof_line, 1)
  tokens

# The tokens of an interpolated expression, placed where it is in the source line.
export const tokenize_fragment = (source: String, path: String, line: Int, column: Int) ->
  const fragment = SourceLine(path, bytes: source.binary, number: line, column_offset: column - 1)
  const tokens = LineScanner(line: fragment, position: 0).run()
  const end = fragment.column(fragment.length)
  tokens.push layout_token(NEWLINE, line, end)
  tokens.push layout_token(EOF, line, end)
  tokens

# A line that LF ends may end with CRLF.
const without_carriage_return = (line: String) ->
  const bytes = line.binary
  const ends_with_cr = bytes.length > 0 and bytes[bytes.length - 1] == "\r"
  ends_with_cr then bytes.slice(0, bytes.length - 1) else bytes

const layout_token = (kind: TokenKind, line: Int, column: Int) ->
  Token kind, line, column, text: '', spaced: true

# Lines inside brackets continue the line that opened them, whatever their indentation, and end
# with a LINE_BREAK, which the parser reads as it reads the brackets: a separator in a list, and
# nothing in a grouping.
class Brackets
  path: String
  open: Array<Token> = []

  update = (token: Token) ->
    case token.kind
      when '(', '[', '{' then @open.push token
      # An extra closing bracket is left to the parser to report.
      when ')', ']', '}'
        @open.pop() if @are_open()
      else pass

  are_open = () -> @open.length > 0

  check_closed = ->
    return if @open.length == 0
    const unclosed = @open.last()
    compile_error @path, unclosed.line, unclosed.column, "'#{unclosed.kind}' is never closed"

const emit_indentation = (
  tokens: Array<Token>, indents: Array<Int>, line: SourceLine, indent: Int
) ->
  const column = line.column(indent)
  if indent > indents.last()
    indents.push indent
    tokens.push layout_token(INDENT, line.number, column)
    return
  while indent < indents.last()
    indents.pop()
    tokens.push layout_token(DEDENT, line.number, column)
  line.fail 'indentation does not match any outer block', indent if indent != indents.last()

# The tokens of one line, from `position`.
class LineScanner
  line: SourceLine
  position: Int
  tokens: Array<Token> = []

  run = () ->
    while @position < @line.length
      const c = @line.bytes[@position]
      case
        when c == ' ' then @position += 1
        when c == '#' then break
        when is_identifier_start(c) then @scan_word()
        when c == "'" then @scan_raw_string()
        when c == '"' then @scan_double_quoted()
        when c.is_digit() then @scan_integer()
        else @scan_punctuation()
    @tokens

  # Adds the token that starts at the position, and moves to `end`, after it.
  add = (kind: TokenKind, text: String, end: Int, parts: Array<TemplatePart>?) ->
    const start = @position
    const spaced = start == 0 or @line.bytes[start - 1] == ' '
    const column = @line.column(start)
    @tokens.push Token(kind, text, spaced, parts, column, line: @line.number)
    @position = end

  scan_word = ->
    const end = @line.scan_while(@position, is_identifier_part)
    const word = @line.text(@position, end)
    @add keyword_kind(word) ? IDENTIFIER, word, end, nil

  scan_raw_string = ->
    const start = @position
    const close = @line.index_of("'", start + 1) ? @line.fail('unterminated string literal', start)
    @add STRING, @line.text(start + 1, close), close + 1, nil

  scan_double_quoted = ->
    const { parts, end } = scan_double_quoted(@line, @position)
    if const text = plain_text(parts)
      @add STRING, text, end, nil
    else
      @add INTERPOLATED, '', end, parts

  scan_integer = ->
    const end = @line.scan_while(@position, is_identifier_part)
    const text = @line.text(@position, end)
    const is_valid = is_integer_literal(text.binary)
    @line.fail "invalid integer literal '#{text}'", @position if not is_valid
    @add INTEGER, text.split('_').join(''), end, nil

  # The longest punctuation that starts here; `...` is the longest of all. What follows may not be
  # a whole character, so a slice that is not valid UTF-8 is skipped. No word starts here, so no
  # keyword or named kind can match.
  scan_punctuation = ->
    for length in [3, 2, 1]
      const end = @position + length
      continue if end > @line.length
      const text = @line.bytes.text(@position, end) ? continue
      if const kind = TokenKind.parse(text)
        @add kind, text, end, nil
        return
    @fail_unexpected_character()

  # Control characters such as '\r' would garble the error line if printed raw.
  fail_unexpected_character = () ->
    const code_point = @line.code_point_at(@position)
    const is_printable_ascii = code_point >= 0x20 and code_point <= 0x7E
    const shown =
      case
        when is_printable_ascii then "'#{@line.text(@position, @position + 1)}'"
        else "U+#{hex(code_point, 4)}"
    @line.fail "unexpected character #{shown}", @position

# The text of a literal without interpolations, or nil.
const plain_text = (parts: Array<TemplatePart>) ->
  return nil if parts.length != 1
  const part = parts[0]
  part is TextPart then part.text else nil

# The kind of a keyword; the named kinds are no keywords, so that a name such as EOF stays a name.
const keyword_kind = (word: String): TokenKind? ->
  const kind = TokenKind.parse(word) ? return nil
  case kind
    when IDENTIFIER, INTEGER, STRING, INTERPOLATED, NEWLINE then nil
    when LINE_BREAK, INDENT, DEDENT, EOF then nil
    else kind

const is_space = (c: Byte) -> c == ' '
const is_identifier_start = (c: Byte) -> c.is_letter() or c == '_'
const is_identifier_part = (c: Byte) -> is_identifier_start(c) or c.is_digit()
const is_hex_digit = (c: Byte) -> hex_digit_value(c) != nil

# `1_000` is 1000. A separator goes only between digits, and a leading zero is rejected so that
# `010` is not mistaken for octal. `0xFF` is hexadecimal.
const is_integer_literal = (text: Binary) ->
  if text.occurs_at(0, '0x'.binary)
    return false if text.length == 2
    for i in 2...text.length
      return false if not is_hex_digit(text[i])
    return true
  return text.length == 1 if text[0] == '0'
  for i in 1...text.length
    const c = text[i]
    const separates_digits = c == '_' and i + 1 < text.length and text[i + 1].is_digit()
    return false if not c.is_digit() and not separates_digits
  true
