# Splits a source into tokens, with the indentation as indent and dedent tokens. Covers only the
# tokens the parser uses so far; any other character is an unexpected character until the feature
# that needs it is implemented.
import parse from 'std:enums'
import Position from '../position'
import flags_error from '../../std/internal/regex_syntax'
import SourceLine from './source_line'
import
  MultilineLiteral, scan_double_quoted, scan_multiline, TemplatePart, TextPart
from './string_literal'

# A keyword or a punctuation is its own kind, whose text is its own. The others are named:
# INTERPOLATED is a string with interpolations, BINARY a Binary literal, with or without them, and
# INDENT and DEDENT the start and the end of an indented block.
export enum TokenKind
  IDENTIFIER
  INTEGER
  FLOAT
  STRING
  INTERPOLATED
  BINARY

  # `/pattern/flags`, whose text is `pattern/flags`, as written.
  REGEX
  NEWLINE
  INDENT
  DEDENT
  EOF
  'true'
  'false'
  'nil'
  'and'
  'or'
  'not'
  'var'
  'if'
  'else'
  'while'
  'unless'
  'until'
  'for'
  'break'
  'continue'
  'return'
  'case'
  'then'
  'class'
  'struct'
  'throw'
  'import'
  'export'
  'extern'
  'intrinsic'
  'extend'
  'enum'
  'interface'
  'try'
  'catch'
  'finally'
  'yield'
  'await'
  '...'
  '..='
  '**='
  '..'
  '=='
  '!='
  '<='
  '>='
  '+='
  '-='
  '*='
  '/='
  '%='
  '&='
  '|='
  '^='
  '**'
  ':='
  '->'
  '('
  ')'
  '['
  ']'
  '{'
  '}'
  ','
  '.'
  ':'
  '+'
  '-'
  '*'
  '/'
  '%'
  '<'
  '>'
  '='
  '?'
  '!'
  '@'
  '|'
  '&'
  '^'
  '~'

# The tokens that may end a value, after which a `/` divides, unless it is spaced as a regular
# expression's.
VALUE_ENDS: TokenKind[] =
  IDENTIFIER, INTEGER, FLOAT, STRING, INTERPOLATED, BINARY, REGEX, 'true', 'false', 'nil', ')', ']',
  '}', '?', '!', '@'

export OPENING_BRACKETS: TokenKind[] = ['(', '[', '{']
export CLOSING_BRACKETS: TokenKind[] = [')', ']', '}']

# How the token changes the depth of brackets: one deeper after an opening one, one shallower
# after a closing one.
export depth_change := (kind: TokenKind) ->
  case
    when kind in OPENING_BRACKETS then 1
    when kind in CLOSING_BRACKETS then -1
    else 0

# The index of the bracket that closes the one at `open`, or nil if none does.
export matching_bracket := (code: Token[], open: Int) ->
  var depth = 0
  for index in open..code.length
    depth += depth_change(code[index].kind)
    return index if depth == 0
  nil

export struct Token
  kind: TokenKind

  # The identifier name, the number's text without separators (with its `0x` prefix if
  # hexadecimal), the string literal's contents or the punctuation; empty for layout tokens.
  text: String

  # Whether whitespace or the start of the line precedes it: `f (x)` and `f(x)` parse differently.
  spaced: Bool

  line: Int

  # Counted in code points, starting at 1.
  column: Int

  # The parts of an interpolated string or a Binary literal.
  parts: TemplatePart[]?

  # The line and the column after it, where the formatter reads its spelling up to; those of its
  # start for a layout token. Only a `"""` or `'''` literal ends on a later line.
  end_line := @line
  end_column := @column

  position := -> Position(line: @line, column: @column)

  # Whether it is the identifier `word`, which is not a keyword, so that it stays usable as a name.
  is_word := (word: String) -> @kind == IDENTIFIER and @text == word

# A comment, which runs from its `#` to the end of its line, alone on it if `own_line`. The
# compiler skips comments; the formatter puts them back by the tokens around them.
export struct Comment
  line: Int
  column: Int
  own_line: Bool

export struct Lexed
  tokens: Token[]
  comments: Comment[]

# `path` names the source in diagnostics.
export tokenize := (source: String, path: String) -> lex(source, path).tokens

# The tokens, and the comments apart from them.
export lex := (source: String, path: String) ->
  tokens: Token[]
  comments: Comment[]
  layout := Layout(path, tokens)
  lines := source_lines(source, path)

  # The lines up to this number are inside a `"""` or `'''` literal.
  var literal_end = 0

  # The brackets open at the start of the line (see LineScanner.depth).
  var brackets = 0

  for line in lines
    continue if line.number <= literal_end
    indent := line.scan_while(0, is_space)
    continue if indent == line.length
    if line.bytes[indent] == b'#'
      comments.push { own_line: true, line: line.number, column: line.column(indent) }
      continue
    line.fail 'tabs are not allowed in indentation', indent if line.bytes[indent] == b"\t"
    layout.start_line line, indent
    var scanner = LineScanner(line, position: indent, depth: brackets)
    while true
      tokens.append scanner.run()
      start := scanner.multiline_start else break
      literal := scan_multiline(lines, scanner.line.number - 1, start)
      tokens.push multiline_token(scanner.line, start, literal)
      scanner = LineScanner(line: literal.line, position: literal.end, depth: scanner.depth)
      literal_end = literal.line.number
    last := scanner.line
    if index := scanner.comment_index
      comments.push { own_line: false, line: last.number, column: last.column(index) }
    brackets = scanner.depth
    layout.end_line last
  layout.finish lines.length
  Lexed(tokens, comments)

source_lines := (source: String, path: String): SourceLine[] ->
  texts := source.split("\n")
  [
    for text at index in texts
      ends_with_lf := index + 1 < texts.length
      bytes := ends_with_lf then without_carriage_return(text).binary else text.binary
      { path, bytes, number: index + 1, column_offset: 0 }
  ]

# The line without a CR at its end, which it has where CRLF ends it.
export without_carriage_return := (line: String) -> line.without_suffix("\r") else line

# The tokens of an interpolated expression, placed where it is in the source line.
export tokenize_fragment := (source: String, path: String, line: Int, column: Int) ->
  fragment := SourceLine(path, bytes: source.binary, number: line, column_offset: column - 1)
  scanner := LineScanner(line: fragment, position: 0, depth: 0)
  tokens := scanner.run()
  fragment.fail 'unterminated string literal', start if start := scanner.multiline_start
  fragment.fail 'a comment cannot be in an interpolation', index if index := scanner.comment_index
  fragment.fail "';' cannot be in an interpolation", index if index := scanner.separator_index
  end := fragment.column(fragment.length)
  tokens.push layout_token(NEWLINE, line, end)
  tokens.push layout_token(EOF, line, end)
  tokens

layout_token := (kind: TokenKind, line: Int, column: Int) ->
  Token(kind, line, column, text: '', spaced: true)

# Lines are laid out by indentation into blocks, which INDENT, NEWLINE and DEDENT mark, inside
# brackets too: the parser reads the lines of a block that continues a line as its continuation
# (see TokenStream.continue_line).
class Layout
  args
    path: String
    tokens: Token[]
  private
    indents := [0]

    start_line := (line: SourceLine, indent: Int) ->
      column := line.column(indent)
      if indent > @indents.last()!
        @indents.push indent
        @tokens.push layout_token(INDENT, line.number, column)
        return
      while indent < @indents.last()!
        @indents.pop()
        @tokens.push layout_token(DEDENT, line.number, column)
      line.fail 'indentation does not match any outer block', indent if indent != @indents.last()!

    end_line := (line: SourceLine) ->
      @tokens.push layout_token(NEWLINE, line.number, line.column(line.length))

    finish := (eof_line: Int) ->
      for _ in 1..@indents.length
        @tokens.push layout_token(DEDENT, eof_line, 1)
      @tokens.push layout_token(EOF, eof_line, 1)

# The tokens of one line, from `position`.
class LineScanner
  args
    line: SourceLine
    var position: Int

    # The brackets open here, from the lines before too, which a closing bracket that opens none
    # leaves as they are, for the parser to report.
    var depth: Int
  private
    tokens: Token[] = []

    # Where the comment that ends the line starts, if any; scanning stops at it.
    var comment_index: Int?

    # Where the `"""` or `'''` that opens a literal on the lines after it starts, if the line ends
    # with one; scanning stops at it, and the caller reads the literal.
    var multiline_start: Int?

    # Where the first `;` on the line is, if any.
    var separator_index: Int?

    run := ->
      while @position < @line.length
        c := @line.bytes[@position]
        case
          when c == b' ' then @position += 1
          when c == b'#'
            @comment_index = @position
            break
          # Ends a statement as a line end does, for a program on one line, as on the command line.
          when c == b';' then @scan_separator()
          when @at_multiline_quotes()
            quotes := @line.text(@position, @position + 3)

            # Quoted with the other quote, which is clearer than the same one next to them.
            shown := quotes == '"""' then "'#{quotes}'" else "\"#{quotes}\""

            @line.fail "#{shown} must end its line", @position if @position + 3 != @line.length
            @multiline_start = @position
            break
          when @at_binary_literal() then @scan_binary()
          when c == b'/' and @starts_regex() then @scan_regex()
          when is_identifier_start(c) then @scan_word()
          when c == b"'" then @scan_raw_string()
          when c == b'"' then @read_double_quoted()
          when c.is_digit() then @scan_number()
          else @scan_punctuation()
      @tokens

    # A `;` comes between two statements: after code on its line other than another `;`, and before
    # code.
    scan_separator := ->
      @separator_index = @position unless @separator_index
      after_separator := @tokens.last()?.kind == NEWLINE
      after_code := @line.scan_while(0, is_space) < @position and not after_separator
      next := @line.scan_while(@position + 1, is_space)
      between := after_code and next < @line.length and @line.bytes[next] != b'#'
      @line.fail "';' must come between statements", @position unless between
      @line.fail "';' cannot be inside brackets", @position if @depth > 0
      @add NEWLINE, ';', @position + 1, nil

    # Whether the `/` at the position starts a regular expression: where the token before it is no
    # value, or, after one, with whitespace before it and none after, as `f -1` passes `-1` (see
    # docs/reference/syntax.md#regular-expression-literals). After a value, `/=` is the operator.
    starts_regex := ->
      previous := @tokens.last() else return true
      return true unless previous.kind in VALUE_ENDS
      bytes := @line.bytes
      spaced_before := @position == 0 or bytes[@position - 1] == b' '
      after := bytes.get(@position + 1)
      spaced_before and after != nil and after not in [b' ', b'=']

    # A regular expression, which ends at the first `/` that no `\` before it takes, as a string
    # ends at its quote, and its flags, the letters right after it. A `/` in a class, as in `[/]`,
    # ends it too, which the class left open would make an error less clear than this one.
    scan_regex := ->
      bytes := @line.bytes
      var end = @position + 1
      var in_class = false
      while end < bytes.length and bytes[end] != b'/'
        in_class = true if bytes[end] == b'['
        in_class = false if bytes[end] == b']'
        end += bytes[end] == b'\' then 2 else 1
      if end >= bytes.length
        previous := @tokens.last()
        after_value := previous != nil and previous.kind in VALUE_ENDS
        hint := after_value then "; for a division, space both sides of '/'" else ''
        @line.fail "unterminated regular expression#{hint}", @position
      @line.fail "a '/' in a character class is written '\\/'", end if in_class
      flags_end := @line.scan_while(end + 1, is_identifier_part)

      # Checked here, so that a keyword read as flags, as in `/a/if`, is told as such. Each flag
      # before the one at fault is ASCII, so its column is its byte's.
      if error := flags_error(@line.text(end + 1, flags_end))
        @line.fail error.message, end + error.column
      @add REGEX, @line.text(@position + 1, flags_end), flags_end, nil

    at_multiline_quotes := ->
      bytes := @line.bytes
      bytes.occurs_at(@position, b'"""') or bytes.occurs_at(@position, b"'''")

    # `b` before a quote.
    at_binary_literal := ->
      next := @line.bytes.get(@position + 1)
      @line.bytes[@position] == b'b' and (next == b"'" or next == b'"')

    scan_binary := ->
      quote := @position + 1
      if @line.bytes.occurs_at(quote, b"'''") or @line.bytes.occurs_at(quote, b'"""')
        @line.fail 'a Binary literal spans one line', @position
      if @line.bytes[quote] == b"'"
        close := @raw_string_end(quote)
        parts: TemplatePart[] = [TextPart(@line.bytes[(quote + 1)..close])]
        @add BINARY, '', close + 1, parts
      else
        { parts, end } := scan_double_quoted(@line, quote, true)
        @add BINARY, '', end, parts

  # Adds the token that starts at the position, and moves to `end`, after it.
  add := (kind: TokenKind, text: String, end: Int, parts: TemplatePart[]?) ->
    start := @position
    spaced := start == 0 or @line.bytes[start - 1] == b' '
    column := @line.column(start)
    end_column := @line.column(end)
    @tokens.push { kind, text, spaced, parts, column, end_column, line: @line.number }
    @depth += 1 if kind in OPENING_BRACKETS
    @depth -= 1 if kind in CLOSING_BRACKETS and @depth > 0
    @position = end

  private
    scan_word := ->
      end := @line.scan_while(@position, is_identifier_part)
      word := @line.text(@position, end)
      @add keyword_kind(word) else IDENTIFIER, word, end, nil

    scan_raw_string := ->
      close := @raw_string_end(@position)
      @add STRING, @line.text(@position + 1, close), close + 1, nil

    # The index of the `'` that closes the `'...'` literal whose opening quote is at `start`.
    raw_string_end := (start: Int) ->
      @line.index_of(b"'", start + 1) else @line.fail('unterminated string literal', start)

    read_double_quoted := ->
      { parts, end } := scan_double_quoted(@line, @position, false)
      if text := plain_text(parts)
        @add STRING, text, end, nil
      else
        @add INTERPOLATED, '', end, parts

    # A `.` begins a fraction only before a digit, so `1.f()` stays an integer and a member.
    scan_number := ->
      bytes := @line.bytes
      after_digits := (start: Int) -> @line.scan_while(start, is_identifier_part)
      var end = after_digits(@position)
      is_decimal := not @line.text(@position, end).starts_with('0x')

      # What looks like a fraction is taken whole (see Float literals in docs/reference/syntax.md).
      after_dot := bytes.get(end + 1)
      has_fraction :=
        bytes.get(end) == b'.' and (after_dot?.is_digit() == true or after_dot == b'_')
      if has_fraction
        end = after_digits(end + 1)

      ends_with_exponent := bytes[end - 1] in [b'e', b'E']

      # The sign is taken even with no digit after it, so that a diagnostic shows it.
      sign_follows := end < @line.length and (bytes[end] == b'+' or bytes[end] == b'-')
      if is_decimal and ends_with_exponent and sign_follows
        end = after_digits(end + 1)

      text := @line.text(@position, end)
      digits := text.replace('_', '')
      if is_integer_literal(text)
        return @add(INTEGER, digits, end, nil)
      if is_float_literal(text)
        return @add(FLOAT, digits, end, nil)
      @line.fail "invalid number literal '#{text}'", @position

    # The longest punctuation that starts here; `...` and `..=` are the longest of all. What follows
    # may not be a whole character, so a slice that is not valid UTF-8 is skipped. No word starts
    # here, so no keyword or named kind can match.
    scan_punctuation := ->
      for length in [3, 2, 1]
        end := @position + length
        continue if end > @line.length
        text := @line.bytes.text(@position, end) else continue
        if kind := parse<TokenKind>(text)
          @add kind, text, end, nil
          return
      @fail_unexpected_character()

    # Control characters such as '\r' would garble the error line if printed raw.
    fail_unexpected_character := ->
      number := @line.char_at(@position).to_int()
      is_printable_ascii := number in 0x20..=0x7E
      shown :=
        if is_printable_ascii
          "'#{@line.text(@position, @position + 1)}'"
        else
          "U+#{number.to_hex(4).to_upper()}"
      @line.fail "unexpected character #{shown}", @position

# The token of the `"""` or `'''` literal that starts at `start` on the line.
multiline_token := (line: SourceLine, start: Int, literal: MultilineLiteral) ->
  plain := plain_text(literal.parts)
  kind: TokenKind = plain != nil then STRING else INTERPOLATED
  parts := plain != nil then nil else literal.parts
  Token(
    kind
    parts
    text: plain else ''
    spaced: start == 0 or line.bytes[start - 1] == b' '
    line: line.number
    column: line.column(start)
    end_line: literal.line.number
    end_column: literal.line.column(literal.end)
  )

# The text of a literal without interpolations, or nil.
plain_text := (parts: TemplatePart[]) ->
  return nil if parts.length != 1
  part := parts[0]

  # A String's escapes give valid UTF-8 (see read_escape).
  part is TextPart then part.bytes.text()!

# The kind of a keyword; the named kinds are no keywords, so that a name such as EOF stays a name.
keyword_kind := (word: String) ->
  kind := parse<TokenKind>(word) else return nil
  if kind in [
    IDENTIFIER, INTEGER, FLOAT, STRING, INTERPOLATED, BINARY, REGEX, NEWLINE, INDENT, DEDENT, EOF
  ]
    nil
  else
    kind

is_space := (c: Byte) -> c == b' '
is_identifier_start := (c: Byte) -> c.is_letter() or c == b'_'
is_identifier_part := (c: Byte) -> is_identifier_start(c) or c.is_digit()

# A decimal one may have one `_` between each two digits and starts with 0 only as 0 itself; a
# hexadecimal one has no `_`.
is_integer_literal := (text: String) -> /^(0x[0-9a-fA-F]+|0|[1-9](_?\d)*)$/.test(text)

# It also takes an integer literal, which scan_number takes as one first.
is_float_literal := (text: String) ->
  /^(0|[1-9](_?\d)*)(\.\d(_?\d)*)?([eE][+-]?\d(_?\d)*)?$/.test(text)
