# Sorting, which the builtin arrays do not do yet.

# The items in the order that `compare` gives (negative when its first argument goes first), equal
# items keeping their order.
export const sorted = <T>(items: Array<T>, compare: (T, T) -> Int): Array<T> ->
  const result: Array<T> = []
  for item in items
    var index = result.length
    index -= 1 while index > 0 and compare(result[index - 1], item) > 0
    result.push item
    var i = result.length - 1
    while i > index
      result[i] = result[i - 1]
      i -= 1
    result[index] = item
  result

# An order of texts by their bytes, which does not depend on a locale.
export const compare_text = (a: String, b: String) ->
  const left = a.binary
  const right = b.binary
  var i = 0
  while i < left.length and i < right.length
    return left[i].to_int() - right[i].to_int() if left[i] != right[i]
    i += 1
  left.length - right.length
