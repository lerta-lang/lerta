# What the compiler makes of a program, as text, for the dump commands (see
# docs/reference/compiler.md#dumps): its tokens, its syntax tree, and that tree with the checker's
# types.
import
  ArrayLiteral, ArrayTypeName, Assignment, Await, BinaryOperation, Binding, BooleanLiteral, Call,
  Case, CaseArm, Cast, Catch, Coalesce, Comprehension, Conditional, Declaration, EnumDeclaration,
  Expression, Extend, Extern, Intrinsic, FloatLiteral, For, FunctionLiteral, FunctionTypeName,
  Identifier, If, Import, ImportName, Index, IntegerLiteral, InterfaceDeclaration, Interpolation,
  InterpolationPart, IsTest, Jump, LazyFunctions, MapEntry, MapLiteral, Member, MemberDeclaration,
  NamedType, NamedValue, NilLiteral, Node, Parameter, Pass, Position, Range, RecordLiteral,
  RecordTypeField, RecordTypeName, Return, Statement, StringLiteral, This, Throw, Try, TupleItem,
  TupleLiteral, TupleTypeName, TypeAlias, TypeDeclaration, TypeName, TypeParameter, UnaryOperation,
  UnionTypeName, Unwrap, While, Yield
from './ast'
import CodePart, TemplatePart, TextPart from './lexer/string_literal'
import Token from './lexer/tokens'
import is_standard_module from './loader'
import ProgramWide, Shared from './checker/shared'
import format_type from './types'

INDENT := '  '

# The dump is built as a tree of these, then written out.

# `positionless`, if given, is the text where positions are left out.
struct Scalar
  text: String
  positionless: String?

# A node, whose head is its kind and position, or a group of fields without a kind.
struct Group
  head: Head?
  fields: Field[]

# The line of a node's kind and position, which the dump may annotate.
struct Head
  kind: String
  position: Position
  node: Node

struct List
  items: Item[]

type Value = Scalar | Group | List
type Item = Scalar | Group

# A field of a position, which is left out where positions are.
struct Field
  name: String
  value: Value
  is_position := default false

NONE := Scalar('-')

export dump_ast := (program: Statement[]) -> dump_annotated(program, (_) -> '')

# The dump without the positions of the nodes, nor in the names that the parser makes of them (see
# name_text), which compares two trees whatever their layout.
export dump_ast_without_positions := (program: Statement[]) -> write_dump(program, (_) -> '', false)

# The text after a node's header line, such as its type.
export type Annotate = (Node) -> String

export dump_annotated := (program: Statement[], annotate: Annotate) ->
  write_dump program, annotate, true

export dump_annotated_without_positions := (program: Statement[], annotate: Annotate) ->
  write_dump program, annotate, false

write_dump := (program: Statement[], annotate: Annotate, positions: Bool) ->
  lines: String[]
  writer := Writer(lines, annotate, positions)
  write_items writer, statements(program).items, ''
  [line + "\n" for line in lines].join()

struct Writer
  lines: String[]
  annotate: Annotate
  positions: Bool

write_items := (writer: Writer, items: Item[], indent: String) ->
  write_item writer, item, indent for item in items

write_item := (writer: Writer, item: Item, indent: String) ->
  case item
    when Scalar then writer.lines.push("#{indent}- #{scalar_text(writer, item)}")
    when Group
      writer.lines.push "#{indent}-"
      write_group writer, item, indent + INDENT

write_group := (writer: Writer, group: Group, indent: String) ->
  field_indent :=
    if head := group.head
      { line, column } := head.position
      position := writer.positions then " #{line}:#{column}" else ''
      writer.lines.push indent + head.kind + position + writer.annotate(head.node)
      indent + INDENT
    else
      indent
  for field in group.fields
    write_field writer, field, field_indent if writer.positions or not field.is_position

write_field := (writer: Writer, field: Field, indent: String): void ->
  value := field.value
  name := indent + field.name
  lines := writer.lines
  case value
    when Scalar then lines.push("#{name}: #{scalar_text(writer, value)}")
    when Group
      lines.push "#{name}:"
      write_group writer, value, indent + INDENT
    when List
      if value.items.is_empty()
        lines.push "#{name}: []"
      else
        lines.push "#{name}:"
        write_items writer, value.items, indent + INDENT

scalar_text := (writer: Writer, scalar: Scalar) ->
  writer.positions then scalar.text else scalar.positionless ? scalar.text

node := (kind: String, of: Node, fields: Field[]) ->
  Group fields, head: { kind, position: of.position, node: of }

# A group without a kind writes its position as fields.
position_fields := (position: Position) ->
  { line, column } := position
  [
    Field(name: 'column', value: number(column), is_position: true)
    Field(name: 'line', value: number(line), is_position: true)
  ]

group := (fields: Field[]) -> Group(fields)

field := (name: String, value: Value) -> Field(name, value)

text := (value: String) -> Scalar(quote(value))

number := (value: Int) -> Scalar(value.to_string())

flag := (value: Bool) -> Scalar(value.to_string())

optional_node := (value: Node?): Value -> value then dump_node(value) else NONE

optional_text := (value: String?) -> value then text(value) else NONE

optional_statements := (body: Statement[]?): Value -> body then statements(body) else NONE

statements := (body: Statement[]) -> List([dump_node(s) for s in body])

expressions := (values: Expression[]) -> List([dump_node(e) for e in values])

types := (values: TypeName[]) -> List([dump_node(t) for t in values])

dump_node := (node: Node) ->
  case node
    when StringLiteral then dump_string(node)
    when Interpolation then dump_interpolation(node)
    when BooleanLiteral then dump_boolean(node)
    when NilLiteral then dump_nil(node)
    when IntegerLiteral then dump_integer(node)
    when FloatLiteral then dump_float(node)
    when Identifier then dump_identifier(node)
    when ArrayLiteral then dump_array(node)
    when Comprehension then dump_comprehension(node)
    when MapLiteral then dump_map(node)
    when RecordLiteral then dump_record(node)
    when TupleLiteral then dump_tuple(node)
    when TupleItem then dump_tuple_item(node)
    when Conditional then dump_conditional(node)
    when Index then dump_index(node)
    when Call then dump_call(node)
    when This then dump_this(node)
    when Member then dump_member(node)
    when UnaryOperation then dump_unary(node)
    when BinaryOperation then dump_binary(node)
    when Unwrap then dump_unwrap(node)
    when Coalesce then dump_coalesce(node)
    when Throw then dump_throw(node)
    when Yield then dump_yield(node)
    when Await then dump_await(node)
    when Jump then dump_jump(node)
    when Return then dump_return(node)
    when Range then dump_range(node)
    when Case then dump_case(node)
    when Try then dump_try(node)
    when IsTest then dump_is(node)
    when Cast then dump_cast(node)
    when FunctionLiteral then dump_function(node)
    when Import then dump_import(node)
    when TypeDeclaration then dump_type_declaration(node)
    when EnumDeclaration then dump_enum(node)
    when InterfaceDeclaration then dump_interface(node)
    when TypeAlias then dump_type_alias(node)
    when Extern then dump_extern(node)
    when Intrinsic then dump_intrinsic(node)
    when Extend then dump_extend(node)
    when Declaration then dump_declaration(node)
    when Assignment then dump_assignment(node)
    when If then dump_if(node)
    when While then dump_while(node)
    when For then dump_for(node)
    when Pass then dump_pass(node)
    when Binding then dump_binding(node)
    when NamedType then dump_named_type(node)
    when UnionTypeName then dump_union_type(node)
    when FunctionTypeName then dump_function_type(node)
    when RecordTypeName then dump_record_type(node)
    when TupleTypeName then dump_tuple_type(node)
    when ArrayTypeName then dump_array_type(node)

dump_string := (literal: StringLiteral) ->
  node 'string', literal, [field('value', text(literal.value))]

dump_interpolation := (interpolation: Interpolation) ->
  parts := List([dump_interpolation_part(part) for part in interpolation.parts])
  kind := interpolation.binary then 'binary' else 'interpolation'
  node kind, interpolation, [field('parts', parts)]

dump_interpolation_part := (part: InterpolationPart): Item ->
  case part
    when TextPart then Scalar(quote_bytes(part.bytes))
    when Call then dump_call(part)

dump_boolean := (literal: BooleanLiteral) ->
  node 'boolean', literal, [field('value', flag(literal.value))]

dump_nil := (literal: NilLiteral) -> node('nil', literal, [])

dump_integer := (literal: IntegerLiteral) ->
  integer := literal.value
  value := integer then number(integer) else text(literal.text)
  node 'integer', literal, [field('value', value)]

dump_float := (literal: FloatLiteral) ->
  node 'float', literal, [field('value', text(literal.text))]

dump_identifier := (identifier: Identifier) ->
  node 'identifier', identifier, [field('name', name_text(identifier))]

# A name that the parser makes of the identifier's position, as `_tuple.3.5`, `destructured.3.5` or
# `?3:5`, ends with it, which a written name cannot.
name_text := (identifier: Identifier) ->
  { name, position } := identifier
  { line, column } := position
  made := ["#{line}.#{column}", "#{line}:#{column}"].find(name.ends_with)
  positionless := made then quote(name.without_suffix(made)!)
  Scalar positionless, text: quote(name)

dump_array := (array: ArrayLiteral): Group ->
  node 'array', array, [field('elements', expressions(array.elements))]

dump_comprehension := (comprehension: Comprehension): Group ->
  node 'comprehension', comprehension, [
    field('bindings', statements(comprehension.bindings))
    field('element', dump_node(comprehension.element))
    field('guard', optional_node(comprehension.guard))
    field('iterable', dump_node(comprehension.iterable))
    field('lazy', dump_lazy(comprehension.lazy))
    field('variable', dump_node(comprehension.variable))
    field('index', optional_node(comprehension.index))
  ]

dump_lazy := (lazy: LazyFunctions?): Value ->
  return NONE if lazy == nil
  group [field('element', dump_node(lazy.element)), field('guard', optional_node(lazy.guard))]

dump_map := (map: MapLiteral) ->
  entries := List([dump_map_entry(entry) for entry in map.entries])
  node 'map', map, [field('entries', entries)]

dump_map_entry := (entry: MapEntry): Group ->
  group [field('key', dump_node(entry.key)), field('value', dump_node(entry.value))]

dump_record := (record: RecordLiteral) ->
  spread := field('spread', optional_node(record.spread))
  node 'record', record, [spread, field('fields', named_values(record.fields))]

dump_tuple := (tuple: TupleLiteral): Group ->
  node 'tuple', tuple, [field('items', expressions(tuple.items))]

dump_tuple_item := (item: TupleItem): Group ->
  node 'tuple_item', item, [
    field('count', number(item.count))
    field('index', number(item.index))
    field('tuple', dump_node(item.tuple))
  ]

named_values := (values: NamedValue[]) -> List([dump_named_value(value) for value in values])

dump_named_value := (value: NamedValue): Group ->
  group [field('name', dump_node(value.name)), field('value', dump_node(value.value))]

dump_conditional := (conditional: Conditional): Group ->
  node 'conditional', conditional, [
    field('condition', dump_node(conditional.condition))
    field('else_value', dump_node(conditional.else_value))
    field('then_value', dump_node(conditional.then_value))
    # How it was written, as a position is: `else nil` and no `else` are the same program.
    { name: 'without_else', value: flag(conditional.without_else), is_position: true }
  ]

dump_index := (index: Index): Group ->
  node 'index', index, [
    field('default_value', optional_node(index.default_value))
    field('index', dump_node(index.index))
    field('object', dump_node(index.object))
  ]

dump_call := (call: Call): Group ->
  node 'call', call, [
    field('args', expressions(call.args))
    field('callee', dump_node(call.callee))
    # How it was written, as a position is: `m: Map<K, V>` and `m: Map<K, V> = Map()` are the same
    # program where no local takes the name Map.
    { name: 'makes_builtin', value: flag(call.makes_builtin), is_position: true }
    field('named_args', named_values(call.named_args))
    field('type_args', types(call.type_args))
  ]

dump_this := (this: This) -> node('this', this, [])

dump_member := (member: Member): Group ->
  node 'member', member, [
    field('name', dump_node(member.name))
    field('object', dump_node(member.object))
  ]

dump_unary := (unary: UnaryOperation): Group ->
  node 'unary', unary, [
    field('operand', dump_node(unary.operand))
    field('operator', text(unary.operator))
  ]

dump_binary := (binary: BinaryOperation): Group ->
  node 'binary', binary, [
    field('left', dump_node(binary.left))
    field('operator', text(binary.operator))
    field('right', dump_node(binary.right))
  ]

dump_unwrap := (unwrap: Unwrap): Group ->
  node 'unwrap', unwrap, [field('operand', dump_node(unwrap.operand))]

dump_coalesce := (coalesce: Coalesce): Group ->
  node 'coalesce', coalesce, [
    field('fallback', dump_node(coalesce.fallback))
    field('value', dump_node(coalesce.value))
  ]

dump_throw := (expression: Throw): Group ->
  node 'throw', expression, [field('message', dump_node(expression.message))]

dump_yield := (expression: Yield): Group ->
  node 'yield', expression, [field('value', dump_node(expression.value))]

dump_await := (expression: Await): Group ->
  node 'await', expression, [field('operand', dump_node(expression.operand))]

dump_jump := (jump: Jump) -> node(jump.kind.to_string(), jump, [])

dump_pass := (statement: Pass) -> node('pass', statement, [])

dump_return := (expression: Return) ->
  node 'return', expression, [field('value', optional_node(expression.value))]

dump_range := (range: Range) ->
  node 'range', range, [
    field('end', optional_node(range.end))
    field('inclusive', flag(range.inclusive))
    field('start', optional_node(range.start))
  ]

dump_case := (expression: Case) ->
  node 'case', expression, [
    field('arms', List([dump_case_arm(arm) for arm in expression.arms]))
    field('otherwise', optional_statements(expression.otherwise))
    field('subject', optional_node(expression.subject))
  ]

dump_case_arm := (arm: CaseArm): Group ->
  group [field('body', statements(arm.body)), field('patterns', expressions(arm.patterns))]

dump_try := (expression: Try): Group ->
  node 'try', expression, [
    field('body', statements(expression.body))
    field('catches', List([dump_catch(each) for each in expression.catches]))
    field('finally_body', optional_statements(expression.finally_body))
  ]

# A catch clause has a position but no kind, so its position is written as fields.
dump_catch := (clause: Catch) ->
  group [
    field('body', statements(clause.body))
    position_fields(clause.position)...
    field('name', dump_node(clause.name))
    field('type', optional_node(clause.type))
  ]

dump_is := (test: IsTest): Group ->
  node 'is', test, [field('type', dump_node(test.type)), field('value', dump_node(test.value))]

dump_cast := (cast: Cast): Group ->
  fields := [field('type', dump_node(cast.type)), field('value', dump_node(cast.value))]
  node cast.throws then 'as!' else 'as?', cast, fields

dump_function := (function: FunctionLiteral): Group ->
  node 'function', function, [
    field('awaits', flag(function.awaits))
    field('body', statements(function.body))
    field('params', List([dump_parameter(param) for param in function.params]))
    field('return_type', optional_node(function.return_type))
    field('type_params', type_parameters(function.type_params))
    field('weak', flag(function.weak))
    field('yields', flag(function.yields))
  ]

dump_parameter := (param: Parameter) ->
  group [
    field('default', optional_node(param.default))
    field('name', dump_node(param.name))
    field('type', optional_node(param.type))
    field('variadic', flag(param.variadic))
  ]

type_parameters := (params: TypeParameter[]) ->
  List [dump_type_parameter(param) for param in params]

dump_type_parameter := (param: TypeParameter) ->
  group [field('bound', optional_node(param.bound)), field('name', dump_node(param.name))]

dump_import := (statement: Import) ->
  node 'import', statement, [
    field('alias', optional_node(statement.alias))
    field('exported', flag(statement.exported))
    field('module', text(statement.module))
    field('names', List([dump_import_name(name) for name in statement.names]))
  ]

dump_import_name := (name: ImportName): Group ->
  group [field('alias', optional_node(name.alias)), field('name', dump_node(name.name))]

dump_type_declaration := (declaration: TypeDeclaration): Group ->
  node 'type_declaration', declaration, [
    field('exported', flag(declaration.exported))
    field('is_struct', flag(declaration.is_struct))
    field('members', members(declaration.members))
    field('name', dump_node(declaration.name))
    field('satisfies', optional_node(declaration.satisfies))
    field('type_params', type_parameters(declaration.type_params))
  ]

members := (values: MemberDeclaration[]) ->
  List [dump_member_declaration(member) for member in values]

# A member has a position but no kind, so its position is written as fields.
dump_member_declaration := (member: MemberDeclaration) ->
  group [
    position_fields(member.position)...
    field('has_default', flag(member.has_default))
    field('modifier', optional_text(member.modifier?.to_string()))
    field('name', dump_node(member.name))
    field('throws', flag(member.throws))
    field('type', optional_node(member.type))
    field('value', optional_node(member.value))
  ]

dump_enum := (declaration: EnumDeclaration): Group ->
  node 'enum', declaration, [
    field('exported', flag(declaration.exported))
    field('members', List([dump_node(member) for member in declaration.members]))
    field('name', dump_node(declaration.name))
  ]

dump_interface := (declaration: InterfaceDeclaration): Group ->
  node 'interface', declaration, [
    field('exported', flag(declaration.exported))
    field('members', members(declaration.members))
    field('name', dump_node(declaration.name))
    field('type_params', type_parameters(declaration.type_params))
  ]

dump_type_alias := (alias: TypeAlias): Group ->
  node 'type_alias', alias, [
    field('exported', flag(alias.exported))
    field('name', dump_node(alias.name))
    field('type', dump_node(alias.type))
  ]

dump_extern := (declaration: Extern): Group ->
  node 'extern', declaration, [
    field('exported', flag(declaration.exported))
    field('name', dump_node(declaration.name))
    field('symbol', dump_node(declaration.symbol))
    field('type', dump_node(declaration.type))
  ]

dump_intrinsic := (declaration: Intrinsic): Group ->
  node 'intrinsic', declaration, [
    field('exported', flag(declaration.exported))
    field('name', dump_node(declaration.name))
    field('type', optional_node(declaration.type))
  ]

dump_extend := (declaration: Extend): Group ->
  node 'extend', declaration, [
    field('members', members(declaration.members))
    field('type', dump_node(declaration.type))
    field('type_params', type_parameters(declaration.type_params))
  ]

dump_declaration := (declaration: Declaration): Group ->
  node 'declaration', declaration, [
    field('exported', flag(declaration.exported))
    field('mutable', flag(declaration.mutable))
    field('name', dump_node(declaration.name))
    # How it was written, as a position is: `var x: T?` and `var x: T? = nil` are the same program.
    { name: 'omits_value', value: flag(declaration.omits_value), is_position: true }
    field('type', optional_node(declaration.type))
    field('value', dump_node(declaration.value))
    field('weak', flag(declaration.weak))
  ]

dump_assignment := (assignment: Assignment): Group ->
  node 'assignment', assignment, [
    field('operator', text(assignment.operator))
    field('target', dump_node(assignment.target))
    field('value', dump_node(assignment.value))
  ]

dump_if := (statement: If): Group ->
  node 'if', statement, [
    field('condition', dump_node(statement.condition))
    field('else_body', statements(statement.else_body))
    field('nil_safe', flag(statement.nil_safe))
    field('then_body', statements(statement.then_body))
  ]

dump_while := (statement: While): Group ->
  node 'while', statement, [
    field('body', statements(statement.body))
    field('condition', dump_node(statement.condition))
  ]

dump_for := (statement: For): Group ->
  node 'for', statement, [
    field('body', statements(statement.body))
    field('iterable', dump_node(statement.iterable))
    field('variable', dump_node(statement.variable))
    field('index', optional_node(statement.index))
  ]

dump_binding := (binding: Binding): Group ->
  node 'binding', binding, [
    field('name', dump_node(binding.name))
    field('value', dump_node(binding.value))
  ]

dump_named_type := (type: NamedType): Group ->
  node 'type_name', type, [
    field('args', types(type.args))
    field('name', text(type.name))
    field('optional', flag(type.optional))
  ]

dump_union_type := (type: UnionTypeName): Group ->
  member_list := List([dump_node(member) for member in type.members])
  node 'union_type', type, [field('members', member_list), field('optional', flag(type.optional))]

dump_function_type := (type: FunctionTypeName): Group ->
  node 'function_type', type, [
    field('optional', flag(type.optional))
    field('params', types(type.params))
    field('result', dump_node(type.result))
  ]

dump_record_type := (type: RecordTypeName) ->
  fields := List([dump_record_type_field(each) for each in type.fields])
  node 'record_type', type, [field('fields', fields), field('optional', flag(type.optional))]

dump_tuple_type := (type: TupleTypeName): Group ->
  node 'tuple_type', type, [
    field('items', types(type.items))
    field('optional', flag(type.optional))
  ]

dump_array_type := (type: ArrayTypeName): Group ->
  node 'array_type', type, [
    field('element', dump_node(type.element))
    field('optional', flag(type.optional))
  ]

dump_record_type_field := (type_field: RecordTypeField): Group ->
  group [field('name', dump_node(type_field.name)), field('type', dump_node(type_field.type))]

# The tokens, one per line, for `dump-tokens`.

export dump_tokens := (tokens: Token[]) -> [dump_token(token) for token in tokens].join()

dump_token := (token: Token) ->
  spacing := token.spaced then 'spaced' else 'joined'
  line := "#{token.line}:#{token.column} #{spacing} #{token.kind} #{quote(token.text)}\n"
  parts := token.parts ? return line
  line + [dump_part(part) for part in parts].join()

dump_part := (part: TemplatePart) ->
  case part
    when TextPart then "  text #{quote_bytes(part.bytes)}\n"
    when CodePart then "  code #{part.column} #{quote(part.source)}\n"

# The bytes below 0x20, 0x7F, `\` and `"` are written as `\xHH`, so that each token stays on its
# line.
quote := (text: String) ->
  var quoted = '"'
  for c in text
    code := c.to_int()
    escaped := code < 0x20 or code == 0x7F or c == '\' or c == '"'
    quoted += escaped then "\\x#{code.to_hex(2).to_upper()}" else c.to_string()
  quoted + '"'

# As quote, with the bytes that are not valid UTF-8, of a Binary literal, written as `\xHH` too.
quote_bytes := (bytes: Binary) ->
  return quote(text) if text := bytes.text()
  var quoted = '"'
  for byte in bytes
    escaped := byte not in 0x20..0x7F or byte == b'\' or byte == b'"'
    quoted += escaped then "\\x#{byte.to_hex(2).to_upper()}" else byte.to_char().to_string()
  quoted + '"'

# The syntax trees of a program's modules, as dump_ast writes them, with the types that the checker
# gave their nodes, for `dump-checked`.
export dump_checked := (program: ProgramWide) ->
  dump_module := (shared: Shared) ->
    module := program.modules[shared.index]
    header := "module #{module.display_path ? program.entry_path}\n"
    header + dump_annotated(module.program, (node) -> type_annotation(shared, node))
  is_shown := (shared: Shared) -> not is_standard_module(program.modules[shared.index])
  [dump_module(shared) for shared in program.shared when is_shown(shared)].join()

type_annotation := (shared: Shared, node: Node) ->
  type := shared.facts.types[node] ? return ''
  converted := shared.facts.conversions[node]
  conversion := converted then " => #{format_type(converted)}" else ''
  " : #{format_type(type)}#{conversion}"
