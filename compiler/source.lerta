# Where modules are and how they are named, files and the standard modules, `std:name`, which the
# compiler carries (see compiler/embedded.lerta); and reading their source text, which must be
# valid UTF-8.
import { is_file, read_file } from 'std:io'
import { EMBEDDED_PATHS, embedded_source } from './embedded'
import { CompileError } from './errors'
import { dirname, join } from './paths'

export const read_source = (path: String) ->
  throw CompileError(message: "'#{path}' is not a file") if not is_file(path)
  read_file(path).text() ? throw CompileError(message: "'#{path}' is not valid UTF-8")

export const SOURCE_EXTENSION = '.lerta'

# A standard module is named `std:name`, and is the file std/<name>.lerta.
const STD_PREFIX = 'std:'
const STD_DIR = 'std/'

export const is_standard_name = (module: String) -> module.starts_with(STD_PREFIX)

# The source of the standard module, or nil if there is none.
export const standard_source = (module: String) ->
  embedded_source "#{STD_DIR}#{module.without_prefix(STD_PREFIX)!}#{SOURCE_EXTENSION}"

# The names of the standard modules, from their embedded paths.
export const standard_names = () ->
  const name_of = (path: String) ->
    "#{STD_PREFIX}#{path.without_prefix(STD_DIR)!.without_suffix(SOURCE_EXTENSION)!}"
  [name_of(path) for path in EMBEDDED_PATHS when path.starts_with(STD_DIR)]

# The source that the command line names: a file, or a standard module as `std:name`.
export const read_entry_source = (path: String) ->
  return read_source(path) if not is_standard_name(path)
  standard_source(path) ? throw CompileError(message: "unknown standard module '#{path}'")

# The path that diagnostics give for a module, from its path as the loader keeps it (see Module):
# the entry module's path as given for the entry module, the name of a standard module, `std:io`,
# or else the module's path, relative to the entry module's directory, joined to that directory.
export const module_location = (entry_path: String, module_path: String?) ->
  return entry_path if module_path == nil
  return module_path if is_standard_name(module_path)
  join dirname(entry_path), module_path
