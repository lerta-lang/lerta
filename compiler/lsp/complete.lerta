# Completion: the names that may be written where a name is being written, which an editor offers.
# The text is checked with the name being written replaced by the checker's own COMPLETION_NAME,
# which it meets where the name is: it records the locals that the code there sees, or, after `.`,
# the type of the object (see checker/completion_probe).
import scan from 'std:scanner'
import builtin_method from '../checker/builtins'
import COMPLETION_NAME, CompletionProbe from '../checker/completion_probe'
import export_of, export_ref, ExportRef, ExternExport, IntrinsicExport from '../checker/imports'
import find_extension from '../checker/extensions'
import members_for from '../checker/interfaces'
import builtin_property from '../checker/member_targets'
import info_of from '../checker/object_types'
import ProgramWide, Shared from '../checker/shared'
import
  EnumType, format_type, FunctionType, inner_of, InterfaceType, ObjectType, RecordType, Type
from '../types'

export struct CompletionItem
  label: String
  kind: Int
  detail: String?

# The kinds of items, as the LSP numbers them.
METHOD := 2
FUNCTION := 3
FIELD := 5
VARIABLE := 6
CLASS := 7
MODULE := 9
PROPERTY := 10
ENUM := 13
KEYWORD := 14
ENUM_MEMBER := 20
STRUCT := 22

# Where a name is being written, in a line of the text: what comes before the name and what comes
# after it, around the cursor. Whether it is a member is the checker's to tell (see
# completion_items).
struct Writing
  before: String
  after: String

# The name being written at the column of the line, in code points from 1, the cursor before it,
# in it or after it.
export writing_at := (line: String, column: Int) ->
  start := name_start(line, column)
  scanner := scan(line)
  before := scanner.mark()
  scanner.next() for _ in 1..start
  written_before := before()
  scanner.skip_while is_name_character
  Writing(before: written_before, after: scanner.rest())

# The column where the name that the column is in or after starts: after the last code point
# before the column that no name holds.
name_start := (line: String, column: Int) ->
  scanner := scan(line)
  var start = 1
  for at in 1..column
    c := scanner.next() else break
    start = at + 1 unless is_name_character(c)
  start

# The text with the name being written, on the line of the index, replaced by the checker's own.
export probe_text := (text: String, line_index: Int, writing: Writing) ->
  lines := text.split("\n")
  lines[line_index] = "#{writing.before}#{COMPLETION_NAME}#{writing.after}"
  lines.join("\n")

# The items that may be written there, from what the checker found of the probe text.
export completion_items := (
  program: ProgramWide, module_index: Int, probe: CompletionProbe?
): CompletionItem[] ->
  shared := program.shared[module_index]

  # The checker met no name of its own where the code is no value to write, as a comment, a
  # string or a type; nor after an error before it in the part of the code it is in, which ends
  # the checking of that part. A member of an enum written alone, where the enum is expected, is
  # not offered among the names.
  found := probe else return []

  # A member, of an object, a module or an enum, as the checker found it, or else a name.
  if object := found.object
    return member_items(program, shared, found, object)
  if index := found.module_index
    return exported_items(program, program.shared[index])
  return enum_items(type) if type := found.enum_type

  locals := local_items(found.locals)

  # A local takes the name from the module's.
  outer := [
    item
    for item in module_items(program, shared, found.in_top_level)
    when item.label not in found.locals
  ]
  locals + outer + keyword_items()

enum_items := (type: EnumType) ->
  [
    CompletionItem(label: member.text, kind: ENUM_MEMBER, detail: type.name)
    for member in type.members
    when member.is_name
  ]

# The fields and methods of the type, those of the extends in effect where it is read, and the
# builtin methods and properties of its kind; of the type without nil, for `?.`.
member_items := (program: ProgramWide, shared: Shared, probe: CompletionProbe, read_type: Type) ->
  type := inner_of(read_type)
  items: Map<String, CompletionItem>
  add := (label: String, kind: Int, detail: String?) -> add_new(items, { label, kind, detail })
  if type is ObjectType
    info := info_of(program, type)
    is_inside := shared.index == info.module_index
    reaches := (name: String) -> is_inside or name not in info.private_names
    for field in info.fields
      if reaches(field.name.name)
        add field.name.name, FIELD, formatted(field.type)
    for name in info.methods.keys()
      if reaches(name)
        add name, METHOD, nil
    for name in info.generics.keys()
      if reaches(name)
        add name, METHOD, nil
  else if type is RecordType
    for field in type.fields
      add field.name, FIELD, format_type(field.type)
  else if type is InterfaceType
    for member in members_for(program, type, type)
      kind := member.type is FunctionType then METHOD else PROPERTY
      add member.name, kind, format_type(member.type)
  for name in BUILTIN_MEMBER_NAMES
    if property := builtin_property(type, name)
      add name, PROPERTY, format_type(property.type)
    else if method := builtin_method(program, type, name)
      add name, METHOD, format_type(method.type)
  extensions := probe.extensions
  for method in extensions.in_effect
    name := method.name.name
    if method.bound == nil and find_extension(extensions, type, name) != nil
      add name, METHOD, nil
  items.values().to_array()

# The names of the builtin members of the builtin types, whose methods and properties
# checker/builtins and member_targets give by name; the operators' methods are left out.
BUILTIN_MEMBER_NAMES :=
  'length', 'binary', 'push', 'pop', 'to_string', 'keys', 'iter', 'remove', 'has_next', 'next',
  'compare', 'equals', 'hash', 'wrapping_add', 'wrapping_sub', 'wrapping_mul', 'to_float',
  'to_float32', 'to_int', 'to_byte', 'to_int8', 'to_int16', 'to_int32', 'to_uint16', 'to_uint32',
  'to_uint64'

local_items := (locals: Map<String, Type>) ->
  [
    CompletionItem(label: name, kind: VARIABLE, detail: format_type(type))
    for (name, type) in locals
    when name not in ['@', COMPLETION_NAME]
  ]

# The names of the module, those it imports, and those that std:builtins exports. Top-level code
# sees the top-level values that it has declared, which are among its locals, and no others yet.
module_items := (program: ProgramWide, shared: Shared, in_top_level: Bool) ->
  own := names_of(program, shared)
  declared_later := (item: CompletionItem) -> in_top_level and item.label in shared.top_level.locals
  items := [item for item in own when not declared_later(item)]
  for name in shared.imports.modules.keys()
    items.push { label: name, kind: MODULE, detail: nil }

  # An imported name is as its module declares it, under the name it is imported by; a name of a
  # module imported as a name, `m.x`, is no name of its own.
  for (name, imported) in shared.imports.names
    continue if '.' in name or has_label(items, name)
    source := imported.source
    item :=
      case source
        when ExportRef
          declared := exported_items(program, program.shared[source.module_index])
          declared.find((each) -> each.label == source.name) else continue
        when ExternExport then extern_item(name, source.type)
        when IntrinsicExport then intrinsic_item(name)
    items.push { item..., label: name }
  if builtins := shared.imports.builtins
    for item in exported_items(program, program.shared[builtins])
      items.push item unless has_label(items, item.label)
  items

# The names that the module exports: its own, C functions, as `panic` of std:builtins, and those
# it exports from other modules.
exported_items := (program: ProgramWide, shared: Shared): CompletionItem[] ->
  items := [item for item in names_of(program, shared) when item.label in shared.exported]
  for name in shared.exported.keys()
    continue if has_label(items, name)
    exported := export_of(program, shared.index, name)
    if exported is ExternExport
      items.push extern_item(name, exported.type)
    items.push intrinsic_item(name) if exported is IntrinsicExport
  for name in shared.reexported.keys()
    ref := export_ref(program, shared.index, name) else continue
    declared := exported_items(program, program.shared[ref.module_index])
    item := declared.find((each) -> each.label == ref.name) else continue
    items.push { item..., label: name }
  items

has_label := (items: CompletionItem[], label: String) -> items.any((each) -> each.label == label)

# Adds the item, unless one of its label is there.
add_new := (items: Map<String, CompletionItem>, item: CompletionItem) ->
  items[item.label] = item unless item.label in items

extern_item := (name: String, type: Type) ->
  CompletionItem(label: name, kind: FUNCTION, detail: format_type(type))

intrinsic_item := (name: String) -> CompletionItem(label: name, kind: FUNCTION, detail: nil)

# The top-level names that the module declares.
names_of := (program: ProgramWide, shared: Shared) ->
  items: CompletionItem[]
  for (name, local) in shared.top_level.locals
    items.push { label: name, kind: VARIABLE, detail: format_type(local.type) }

  # A method's entry is named by its receiver too, as `Point.sum`.
  for (name, entry) in shared.functions.entries
    continue if '.' in name
    items.push { label: name, kind: FUNCTION, detail: formatted(entry.type) }

  for generic in shared.generics
    if generic.receiver == nil
      items.push { label: generic.name.name, kind: FUNCTION, detail: nil }
  for (name, info) in shared.objects
    items.push { label: name, kind: info.type.is_struct then STRUCT else CLASS, detail: nil }
  for name in shared.enums.keys()
    items.push { label: name, kind: ENUM, detail: nil }
  items

# The keywords, those of TokenKind in compiler/lexer/tokens.lerta, wherever a name is written: the
# editor narrows them by what is written of the name.
KEYWORDS :=
  'true', 'false', 'nil', 'and', 'or', 'not', 'var', 'if', 'else', 'while', 'unless', 'until',
  'for', 'break', 'continue', 'return', 'case', 'then', 'class', 'struct', 'throw', 'import',
  'export', 'extern', 'intrinsic', 'extend', 'enum', 'interface', 'try', 'catch', 'finally',
  'yield', 'await'

keyword_items := ->
  [
    for word in KEYWORDS
      CompletionItem(label: word, kind: KEYWORD, detail: nil)
  ]

formatted := (type: Type?) -> type then format_type(type)

# Whether the Char may be in a name.
export is_name_character := (c: Char) -> c.is_alphanumeric() or c == '_'
