# The answers to the requests about the open documents: formatting one, the types and the doc
# comments of a name in it and where the name is declared, the names that lead to a declaration,
# in the files of the workspace too, and what may be written where a name is being written.
import is_file from 'std:io'
import Identifier, Position from '../ast'
import ProgramWide from '../checker/shared'
import CompileError from '../errors'
import format_source from '../format/format'
import is_standard_name, open_texts, read_source, text_key from '../source'
import
  characters, check_file, LspPosition, LspRange, name_range, source_position
from './diagnostics'
import completion_items, CompletionItem, probe_text, writing_at from './complete'
import Documents from './documents'
import
  definition_of, hover_markdown, is_shared, is_written, location_of, module_at, references_in,
  target_at, Written
from './locate'
import path_of_uri from './uri'
import entries_for from './workspace'

export struct TextDocument
  uri: String

export struct DocumentParams
  text_document: TextDocument

export struct PositionParams
  text_document: TextDocument
  position: LspPosition

export struct ReferenceParams
  text_document: TextDocument
  position: LspPosition
  context: { include_declaration: Bool }

struct MarkupContent
  kind: String
  value: String

struct Hover
  contents: MarkupContent

struct Location
  uri: String
  range: LspRange

struct TextEdit
  range: LspRange
  new_text: String

# A position in a document, in the module of a program that holds it.
struct Cursor
  path: String
  program: ProgramWide
  module_index: Int
  at: Position

# More references than one reads: finding them stops checking programs once it has found these.
REFERENCE_LIMIT := 1000

# The edit that writes the document in the style, of its whole text, or none if it is so already;
# nil if it does not parse.
export formatting_edits := (documents: Documents, params: DocumentParams) ->
  path := path_of_uri(params.text_document.uri) else return nil
  text := open_texts[text_key(path)] else return nil
  try
    formatted := (await format_source(text, path)).text
    none: TextEdit[]
    return none if formatted == text
    lines := text.split("\n")
    end :=
      LspPosition(line: lines.length - 1, character: characters(lines.last()!, documents.encoding))
    range := LspRange(end, start: { line: 0, character: 0 })
    [TextEdit(range, new_text: formatted)]
  catch _: CompileError
    nil

# The types and the doc comments of the name at the position.
export hover := (documents: Documents, params: PositionParams) ->
  { path, program, module_index, at } :=
    await cursor_at(documents, params.text_document, params.position) else return nil
  markdown := hover_markdown(program, module_index, await read_source(path), at) else return nil
  Hover({ kind: 'markdown', value: markdown })

# Where the name at the position is declared, if in a file that still writes it there.
export definition := (documents: Documents, params: PositionParams) ->
  { path, program, module_index, at } :=
    await cursor_at(documents, params.text_document, params.position) else return nil
  declared := definition_of(program, module_index, await read_source(path), at) else return nil
  await written_location(documents, location_of(program, declared.module_index), declared.name)

# The names that lead to the declaration that the name at the position leads to, or is, in the
# programs of the open documents, and, for a declaration that other modules may name, of the entry
# modules of the workspace that hold the other files that may write them (see workspace.lerta), up
# to about REFERENCE_LIMIT of them; none if no name leads to it, or it is in a standard module.
export references := (documents: Documents, params: ReferenceParams): Promise<Location[]> ->
  { path, program, module_index, at } :=
    await cursor_at(documents, params.text_document, params.position) else return []
  target := target_at(program, module_index, await read_source(path), at) else return []
  return [] if is_standard_name(target.key)
  place := (written: Written) ->
    { line, column } := written.name.position
    (written.key, line, column)
  found: Map<(String, Int, Int), Written>
  covered: Set<String>
  search := (searched: ProgramWide) ->
    for each in await references_in(searched, target)
      if place(each) != place(target)
        found[place(each)] = each
    for index in 0..searched.modules.length
      covered.add text_key(location_of(searched, index))
  await search(each) for each in documents.programs.values()
  if is_shared(program, target)
    for entry in await entries_for(documents.roots, target.key, target.name.name, covered)
      break if found.length >= REFERENCE_LIMIT
      await search(checked) if checked := (await check_file(entry, documents.encoding)).program
  return [] if found.is_empty()
  if params.context.include_declaration
    found[place(target)] = target
  places := found.keys().to_array().sorted().take(REFERENCE_LIMIT)
  locations: Location[]
  for each in places
    written := found[each]!
    location := await written_location(documents, written.key, written.name) else continue
    locations.push location
  locations

# What may be written where a name is being written, from a check of the document's text with the
# checker's own name there (see complete.lerta), whose diagnostics are not published.
export completion := (documents: Documents, params: PositionParams): Promise<CompletionItem[]> ->
  path := path_of_uri(params.text_document.uri) else return []
  key := text_key(path)
  text := open_texts[key] else return []
  return [] unless is_file(path)
  at := await source_position(path, params.position, documents.encoding)
  lines := text.split("\n")
  return [] unless at.line in 1..=lines.length
  writing := writing_at(lines[at.line - 1], at.column)
  open_texts[key] = probe_text(text, at.line - 1, writing)
  checked :=
    try
      await check_file(path, documents.encoding)
    finally
      open_texts[key] = text
  program := checked.program else return []
  module_index := module_at(program, path) else return []
  completion_items(program, module_index, program.completion)

# The position in the document, in the program of an open document that holds it.
cursor_at := (documents: Documents, document: TextDocument, position: LspPosition) ->
  path := path_of_uri(document.uri) else return nil
  program := documents.program_of(path) else return nil
  module_index := module_at(program, path) else return nil
  at := await source_position(path, position, documents.encoding)
  Cursor(path, program, module_index, at)

# Where the file writes the name, if it is not a standard module, and still writes it there.
written_location := (documents: Documents, location: String, name: Identifier) ->
  return nil if is_standard_name(location)
  return nil unless is_written((await read_source(location)).split("\n"), name)
  range := await name_range(location, name, documents.encoding)
  Location(range, uri: documents.uri_of(location))
