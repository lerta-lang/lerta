# The messages of the Language Server Protocol, which come on stdin and go on stdout, each after a
# header that gives its length in bytes, as JSON whose keys are in camel case.
import stdin, stdout from 'std:io'
import Codable from 'std:codable'
import decode_json, encode_json from 'std:json'

# What the server reads of a message first, to tell what it is: a request has an id too, which its
# response gives back.
export struct Header
  method: String?
  id: Int | String?

export struct Request<P>
  id: Int | String
  params: P

export struct Notification<P>
  params: P

struct Response<R>
  jsonrpc: String
  id: Int | String
  result: R

# A parse error has no id, as the message that it answers could not be read.
struct ErrorResponse
  jsonrpc: String
  id: Int | String?
  error: ResponseError

struct ResponseError
  code: Int
  message: String

struct Outgoing<P>
  jsonrpc: String
  method: String
  params: P

JSONRPC := '2.0'

# The code of an error response for a message that is not JSON, for a request of a method that the
# server does not handle, for params that are not as the method takes them, and for a bug of the
# server.
export PARSE_ERROR := -32700
export METHOD_NOT_FOUND := -32601
export INVALID_PARAMS := -32602
export INTERNAL_ERROR := -32603

# The body of the next message, or nil at the end of the input.
export read_message := ->
  var length: Int?
  while true
    line := await stdin.read_line() else return nil
    break if line.is_empty()
    (name, value) := line.split_once(':') else continue

    # Header names are told apart regardless of case, as HTTP's are.
    length = value.trim().parse_int() if name.to_lower() == 'content-length'
  count := length else throw ValueError('an LSP message without its Content-Length')

  # An empty body is no JSON, which the server answers as such.
  return '' if count < 1

  body :=
    await stdin.read_exactly(count) else throw IOError("the end came after 0 of #{count} bytes")
  body.text() else throw ValueError('an LSP message that is not valid UTF-8')

export decode_header := (body: String) -> decode_json<Header>(body, CAMEL_CASE)

export decode_request := <P: Codable>(body: String): Request<P> ->
  decode_json<Request<P>>(body, CAMEL_CASE)

# The params of a notification.
export decode_notification := <P: Codable>(body: String): P ->
  decode_json<Notification<P>>(body, CAMEL_CASE).params

export respond := <R: Codable>(id: Int | String, result: R) ->
  await write_message(encode_json(Response(id, result, jsonrpc: JSONRPC), CAMEL_CASE))

export respond_error := (id: Int | String?, code: Int, message: String) ->
  response := ErrorResponse(id, jsonrpc: JSONRPC, error: { code, message })
  await write_message(encode_json(response, CAMEL_CASE))

export notify := <P: Codable>(method: String, params: P) ->
  await write_message(encode_json(Outgoing(method, params, jsonrpc: JSONRPC), CAMEL_CASE))

write_message := (body: String) ->
  await stdout.write("Content-Length: #{body.binary.length}\r\n\r\n#{body}")
  await stdout.flush()
