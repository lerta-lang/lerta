# The errors and warnings of a program, as the LSP publishes them for each of its files: its entry
# module is checked as `lerta build` checks it, without generating code.
import check_modules from '../checker/modules'
import Position from '../ast'
import ProgramWide from '../checker/shared'
import CompileError, Located from '../errors'
import load_modules from '../loader'
import is_standard_name, module_location, read_source from '../source'

# A position as the LSP takes it, from 0, its character counted in the units of the encoding that
# the server and the client agree on (see PositionEncoding).
export struct LspPosition(line: Int, character: Int)

export struct LspRange(start: LspPosition, end: LspPosition)

export struct LspDiagnostic(range: LspRange, severity: Int, source: String, message: String)

ERROR := 1
WARNING := 2

# How a position counts the characters of a line: in code points, as diagnostics do, or in UTF-16
# units, which the LSP takes unless the client says it takes code points.
export enum PositionEncoding
  UTF32
  UTF16

# What a check found: the diagnostics, by the paths of the files, and the program as far as it is
# checked, if its modules could be loaded.
export struct Checked(by_path: Map<String, LspDiagnostic[]>, program: ProgramWide?)

# The diagnostics of the program whose entry module is at the path, by the paths of its files,
# every one of them, those without any too, but the standard modules; only the entry module's and
# those that have some if the modules cannot be loaded. An error that is found in no module is the
# entry module's, at its start.
export check_file := (path: String, encoding: PositionEncoding) ->
  by_path: Map<String, LspDiagnostic[]>
  by_path[path] = []
  var warnings: Located[] = []
  var errors: Located[] = []
  var checked: ProgramWide?
  keep_warnings := (program: ProgramWide, found: Located[]) ->
    checked = program
    warnings = found
  try
    modules := await load_modules(path)
    for module in modules
      location := module_location(path, module.display_path)
      by_path[location] = [] if not is_standard_name(location)
    check_modules path, modules, keep_warnings
  catch error: CompileError
    placed := Located(location: path, line: 1, column: 1, message: error.message)
    errors = not error.errors.is_empty() then error.errors else [placed]
  add := (located: Located, severity: Int) ->
    return if is_standard_name(located.location)
    at := await position(located, encoding)
    range := LspRange(start: at, end: at)
    diagnostic := LspDiagnostic(range, severity, source: 'lerta', message: located.message)
    by_path.get_or_put(located.location, -> []).push(diagnostic)
  await add(each, ERROR) for each in errors
  await add(each, WARNING) for each in warnings
  Checked by_path, program: checked

# The position of the diagnostic, whose column counts code points: in UTF-16 units, those before
# it on its line count 2 each above U+FFFF.
position := (located: Located, encoding: PositionEncoding) ->
  await lsp_position(located.location, { line: located.line, column: located.column }, encoding)

# The position, of lines and columns from 1 and columns in code points, in the file at the
# location, as the LSP takes it.
export lsp_position := (location: String, at: Position, encoding: PositionEncoding) ->
  line := at.line - 1
  before := at.column - 1
  return LspPosition(line, character: before) if encoding == UTF32
  LspPosition line, character: characters(await line_text(location, line), encoding, before)

# The position that the LSP gives in the file at the location, of lines and columns from 1 and
# columns in code points.
export source_position := (location: String, at: LspPosition, encoding: PositionEncoding) ->
  column := Position(line: at.line + 1, column: at.character + 1)
  return column if encoding == UTF32
  var units = 0
  var counted = 0
  for code in await line_text(location, at.line)
    break if units >= at.character
    units += code.to_int() > 0xFFFF then 2 else 1
    counted += 1
  Position line: at.line + 1, column: counted + 1

line_text := (location: String, line: Int) ->
  lines := (await read_source(location)).split("\n")
  line < lines.length then lines[line] else ''

# The characters of the text, or of its first `count` code points, in the encoding's units.
export characters := (text: String, encoding: PositionEncoding, count: Int? = nil) ->
  var units = 0
  var counted = 0
  for code in text
    break if counted == count
    units += encoding == UTF16 and code.to_int() > 0xFFFF then 2 else 1
    counted += 1
  units
