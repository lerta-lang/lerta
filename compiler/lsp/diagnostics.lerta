# The errors and warnings of a program, as the LSP publishes them for each of its files: its entry
# module is checked as `lerta build` checks it, without generating code.
import check_modules from '../checker/modules'
import Identifier, Position from '../ast'
import ProgramWide from '../checker/shared'
import CompileError, Located from '../errors'
import load_modules_partially from '../loader'
import is_standard_name, module_location, read_source from '../source'

# A position as the LSP takes it, from 0, its character counted in the units of the encoding that
# the server and the client agree on (see PositionEncoding).
export struct LspPosition
  line: Int
  character: Int

export struct LspRange
  start: LspPosition
  end: LspPosition

export struct LspDiagnostic
  range: LspRange
  severity: Int
  source: String
  message: String

ERROR := 1
WARNING := 2

# How a position counts the characters of a line: in code points, as diagnostics do, or in UTF-16
# units, which the LSP takes unless the client says it takes code points.
export enum PositionEncoding
  UTF32
  UTF16

# What a check found: the diagnostics, by the paths of the files, and the program as far as it is
# checked, if its modules could be loaded.
export struct Checked
  by_path: Map<String, LspDiagnostic[]>
  program: ProgramWide?

# The diagnostics of the program whose entry module is at the path, by the paths of its files,
# every one of them, those without any too, but the standard modules; only the entry module's and
# those that have some if the modules cannot be loaded.
export check_file := (path: String, encoding: PositionEncoding) ->
  found := await found_in(path)
  by_path: Map<String, LspDiagnostic[]>
  by_path[location] = [] for location in found.locations
  add := (located: Located, severity: Int) ->
    return if is_standard_name(located.location)
    diagnostic := await diagnostic_of(located, severity, encoding)
    by_path[located.location, default: []].push(diagnostic)
  await add(each, ERROR) for each in found.errors
  await add(each, WARNING) for each in found.warnings
  Checked by_path, program: found.program

# What the check of a program found: the errors and the warnings, the program as far as it is
# checked, if its modules could be loaded, and the locations of its modules that are not standard.
struct Found
  errors: Located[]
  warnings: Located[]
  program: ProgramWide?
  locations: String[]

# What the check of the program whose entry module is at the path finds. An error that is found in
# no module is the entry module's, at its start. A module is loaded with the statements that parse,
# so that the program is checked while it is being written.
found_in := (path: String) ->
  locations := [path]
  var warnings: Located[] = []
  var errors: Located[] = []
  parse_errors: Located[]
  var checked: ProgramWide?
  keep_warnings := (program: ProgramWide, found: Located[]) ->
    checked = program
    warnings = found
  try
    modules := await load_modules_partially(path, parse_errors)
    for module in modules
      location := module_location(path, module.display_path)
      locations.push location if not is_standard_name(location)
    check_modules path, modules, keep_warnings
  catch error: CompileError
    placed := Located(location: path, line: 1, column: 1, message: error.message)
    errors = not error.errors.is_empty() then error.errors else [placed]
  # A file whose statements do not all parse has only its parse errors: the checker's would mostly
  # be of the names that the statements left out declare. Those of the files that import such names
  # from it are kept, as they hold of its code as it is.
  unparsed := Set([each.location for each in parse_errors])
  # An error of loading, which ends it before the checker starts, is kept.
  errors = [each for each in errors when each.location not in unparsed] if checked
  errors.append parse_errors
  Found
    locations
    errors
    warnings: [each for each in warnings when each.location not in unparsed]
    program: checked

diagnostic_of := (located: Located, severity: Int, encoding: PositionEncoding) ->
  at := await position(located, encoding)
  LspDiagnostic severity, range: { start: at, end: at }, source: 'lerta', message: located.message

# The position of the diagnostic, whose column counts code points: in UTF-16 units, those before
# it on its line count 2 each above U+FFFF.
position := (located: Located, encoding: PositionEncoding) ->
  await lsp_position(located.location, { line: located.line, column: located.column }, encoding)

# The position, of lines and columns from 1 and columns in code points, in the file at the
# location, as the LSP takes it.
export lsp_position := (location: String, at: Position, encoding: PositionEncoding) ->
  line := at.line - 1
  before := at.column - 1
  return LspPosition(line, character: before) if encoding == UTF32
  LspPosition line, character: characters(await line_text(location, line), encoding, before)

# The range of the name in the file at the location, as the LSP takes it.
export name_range := (location: String, name: Identifier, encoding: PositionEncoding) ->
  { line, column } := name.position
  start := await lsp_position(location, name.position, encoding)
  end := await lsp_position(location, { line, column: column + name.name.count() }, encoding)
  LspRange start, end

# The position that the LSP gives in the file at the location, of lines and columns from 1 and
# columns in code points.
export source_position := (location: String, at: LspPosition, encoding: PositionEncoding) ->
  column := Position(line: at.line + 1, column: at.character + 1)
  return column if encoding == UTF32
  var units = 0
  var counted = 0
  for code in await line_text(location, at.line)
    break if units >= at.character
    units += units_of(code, UTF16)
    counted += 1
  Position line: at.line + 1, column: counted + 1

line_text := (location: String, line: Int) ->
  lines := (await read_source(location)).split("\n")
  lines.get(line) ? ''

# The characters of the text, or of its first `count` code points, in the encoding's units.
export characters := (text: String, encoding: PositionEncoding, count: Int? = nil) ->
  var units = 0
  var counted = 0
  for code in text
    break if counted == count
    units += units_of(code, encoding)
    counted += 1
  units

# The units of the encoding that the code point takes: in UTF-16, 2 above U+FFFF.
units_of := (code: Char, encoding: PositionEncoding) ->
  encoding == UTF16 and code.to_int() > 0xFFFF then 2 else 1
