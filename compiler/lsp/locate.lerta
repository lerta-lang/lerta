# The names of a checked program by their positions, for an editor's hover, going to a definition
# and finding references: what the checker found of the name at a place, its types and its
# declaration, the doc comments of its declaration, and the names that lead to a declaration.
import
  EnumDeclaration, Extend, Identifier, Import, InterfaceDeclaration, Member, NamedType, Position,
  Statement, TypeDeclaration
from '../ast'
import generic_of, GenericFunction from '../checker/generics'
import export_ref, ExportRef from '../checker/imports'
import EnumValue, Method, Property from '../checker/member_targets'
import ExtensionSource, OwnMethod from '../checker/methods'
import info_of from '../checker/object_types'
import Constructor, ExternReference, FunctionReference, TopLevelValue from '../checker/references'
import NodeFacts, ProgramWide, Shared from '../checker/shared'
import resolved_alias from '../checker/type_names'
import is_name_character, name_start from './complete'
import doc_comment from './doc_comments'
import is_standard_name, module_location, read_source, text_key from '../source'
import
  EnumType, format_type, format_type_naming, inner_of, InterfaceType, ObjectType, Type, UnionType
from '../types'

# A declaration: a name of a module, by the module's place.
struct Declared
  module_index: Int
  name: Identifier

# A name as it is written in the module's code, with its type if the checker found one, and its
# declaration, found when asked. The type of an alias's name is written in full, as what it names.
struct Candidate
  name: Identifier
  type: Type?
  declaration: () -> Declared?
  names_alias: Bool

# The place among the program's modules of the module at the location, as diagnostics give it.
export module_at := (program: ProgramWide, location: String) ->
  is_at := (shared: Shared) -> location_of(program, shared.index) == location
  program.shared.find(is_at)?.index

# The location of the module of the place, as diagnostics give it.
export location_of := (program: ProgramWide, module_index: Int) ->
  module_location(program.entry_path, program.modules[module_index].display_path)

# The Markdown of the name at the position of the module's source: the types it has, in a generic
# body one at its definition and one for each instance, written as `name: Type` in a block of Lerta,
# a union by the name of an alias of it that the module knows, then the doc comments of its
# declaration; nil if it has neither.
export hover_markdown := (program: ProgramWide, module_index: Int, source: String, at: Position) ->
  candidates := candidates_at(program, module_index, source, at)
  names := union_alias_names(program, module_index)
  lines: Set<String>
  for candidate in candidates
    type := candidate.type else continue
    written := candidate.names_alias then format_type(type) else format_type_naming(type, names)
    lines.add "#{candidate.name.name}: #{written}"
  parts: String[]
  parts.push "```lerta\n#{lines.to_array().join("\n")}\n```" unless lines.is_empty()
  if declared := candidates.find_map(Candidate.declaration)
    parts.push doc if doc := doc_of(program, declared)
  parts.is_empty() then nil else parts.join("\n\n")

# The names of the aliases of unions that the module declares or imports, by their unions; where
# more than one names a union, the module's own before the imported ones, and among each the one
# declared or imported first. An alias of another type is left out, as `Int` would read as its alias
# everywhere.
union_alias_names := (program: ProgramWide, module_index: Int) ->
  shared := program.shared[module_index]
  names: Map<Type, String>
  add := (declarer: Shared, alias: String, local: String) ->
    type := resolved_alias(declarer, alias) else return
    names[type] = local if inner_of(type) is UnionType and type not in names
  for alias in shared.aliases.keys()
    add shared, alias, alias
  for imported in shared.imports.names.values()
    source := imported.source
    continue unless source is ExportRef
    add program.shared[source.module_index], source.name, imported.name.name
  names

# The declaration of the name at the position, if the checker found one.
export definition_of := (program: ProgramWide, module_index: Int, source: String, at: Position) ->
  candidates_at(program, module_index, source, at).find_map(Candidate.declaration)

# A name where a file writes it: the key of the file's text (see text_key), and the name.
export struct Written
  key: String
  name: Identifier

# The declaration that the name at the position leads to, or else the name itself, which is a
# declaration if any name leads to it.
export target_at := (
  program: ProgramWide, module_index: Int, source: String, at: Position
): Written? ->
  if declared := definition_of(program, module_index, source, at)
    return { key: key_of(program, declared.module_index), name: declared.name }
  line := source.split("\n").get(at.line - 1) else return nil
  start := name_start(line, at.column)
  from_start := line.skip(start - 1)
  name := from_start.without_suffix(from_start.skip_while(is_name_character))!
  return nil if name.is_empty()
  position := Position(at..., column: start)
  { key: key_of(program, module_index), name: Identifier(name, position) }

# The names that lead to the target in the program's modules but the standard ones, as far as
# their files still write them. A module whose text does not write the target's name has none, as
# a name that leads to a declaration of another module is imported by its name, if under another.
export references_in := (program: ProgramWide, target: Written) ->
  found: Written[]
  for module_index in 0..program.modules.length
    found.append await module_references(program, module_index, target)
  found

# The names that lead to the target in the module, if it is not a standard one, as far as its file
# still writes them.
export module_references := (
  program: ProgramWide, module_index: Int, target: Written
): Promise<Written[]> ->
  location := location_of(program, module_index)
  return [] if is_standard_name(location)
  source := await read_source(location)
  return [] unless target.name.name in source
  lines := source.split("\n")
  keys: Map<Int, String>
  leads_to_target := (declared: Declared) ->
    return false unless declared.name.position == target.name.position
    index := declared.module_index
    unless index in keys
      keys[index] = key_of(program, index)
    keys[index] == target.key
  found: Written[]
  for candidate in module_candidates(program, module_index)
    continue unless is_written(lines, candidate.name)
    declared := candidate.declaration() else continue
    if leads_to_target(declared)
      found.push { key: text_key(location), name: candidate.name }
  found

# Whether the names of other modules may lead to the target, a declaration of the program: a
# top-level name that its module exports, or a member of a class, a struct, an interface, an enum or
# an extend, which values carry to any module. Not a local, nor any name that is not a declaration.
export is_shared := (program: ProgramWide, target: Written) ->
  is_declarer := (shared: Shared) -> key_of(program, shared.index) == target.key
  module_index := program.shared.find(is_declarer)?.index else return false
  is_target := (name: Identifier) -> name.position == target.name.position
  return true if member_names(program.modules[module_index].program).any(is_target)
  name := target.name.name
  top_level := top_level_declaration(program, module_index, name) else return false
  is_target(top_level.name) and name in program.shared[module_index].exported

# The names of the members that the statements declare in classes, structs, interfaces, enums and
# extends.
member_names := (statements: Statement[]) ->
  names: Identifier[]
  for statement in statements
    case statement
      when TypeDeclaration, InterfaceDeclaration, Extend
        names.push member.name for member in statement.members
      when EnumDeclaration
        for member in statement.members
          names.push member if member is Identifier
      else pass
  names

# The key of the text of the module of the place (see text_key).
key_of := (program: ProgramWide, module_index: Int) -> text_key(location_of(program, module_index))

# The names at the position in the module's code, as far as its source still writes them.
candidates_at := (program: ProgramWide, module_index: Int, source: String, at: Position) ->
  lines := source.split("\n")
  is_at := (candidate: Candidate) -> spans(candidate.name, at) and is_written(lines, candidate.name)
  module_candidates(program, module_index).filter(is_at).to_array()

# The names in the module's code: those whose types and references its own facts and those of the
# definitions and instances of its generic functions and classes hold, the callees of generic
# functions, and the names it imports.
module_candidates := (program: ProgramWide, module_index: Int) ->
  shared := program.shared[module_index]
  found: Candidate[]
  add := (candidate: Candidate) -> found.push(candidate)
  for facts in all_facts(shared)
    add_fact_names add, program, module_index, facts
    add_generic_callees add, program, facts
  add_type_names add, program, module_index
  add_imported_names add, program, module_index
  add_reexported_names add, program, module_index
  found

type AddCandidate = (Candidate) -> void

# The names that the facts give types: names, members, and the enums of members written with them.
add_fact_names := (add: AddCandidate, program: ProgramWide, module_index: Int, facts: NodeFacts) ->
  for (node, type) in facts.types
    if node is Identifier
      add {
        type
        name: node
        declaration: -> name_declaration(program, module_index, facts, node)
        names_alias: false
      }
    else if node is Member
      add {
        type
        name: node.name
        declaration: -> member_declaration(program, facts, node)
        names_alias: false
      }
      if enum_name := enum_name_of(node, facts)
        add {
          type
          name: enum_name
          declaration: -> type_declaration(program, type)
          names_alias: false
        }

# The callees of generic functions, which lead to the generic functions.
add_generic_callees := (add: AddCandidate, program: ProgramWide, facts: NodeFacts) ->
  for (call, link) in facts.instances
    callee := call.callee
    continue unless callee is Identifier
    instance := link.instance
    generic := generic_of(program, instance.generic)
    declared := Declared(module_index: generic.module_index, name: generic.name)
    add { name: callee, type: instance.entry.type, declaration: -> declared, names_alias: false }

# The names of types that the module writes, which lead to their declarations or to their aliases.
add_type_names := (add: AddCandidate, program: ProgramWide, module_index: Int) ->
  shared := program.shared[module_index]
  for (type_name, types) in shared.type_names
    alias := shared.alias_names[type_name]
    for type in types
      declaration := ->
        if alias
          return Declared(module_index, name: alias)
        type_declaration(program, type)
      add { type, name: written_name(type_name), declaration, names_alias: alias != nil }

# The names that the module imports from other modules, which lead to their declarations.
add_imported_names := (add: AddCandidate, program: ProgramWide, module_index: Int) ->
  for imported in program.shared[module_index].imports.names.values()
    source := imported.source
    continue unless source is ExportRef
    ref := source
    add {
      name: imported.name
      type: nil
      declaration: -> top_level_declaration(program, ref.module_index, ref.name)
      names_alias: false
    }

# The names that the module exports from other modules, which lead to their declarations.
add_reexported_names := (add: AddCandidate, program: ProgramWide, module_index: Int) ->
  module := program.modules[module_index]
  for statement in module.program
    continue unless statement is Import
    reexport := statement
    continue unless reexport.exported
    exporter := module.imported[reexport]!
    for exported in reexport.names
      ref := export_ref(program, exporter, exported.name.name) else continue
      names := [exported.name]
      names.push alias if alias := exported.alias
      for name in names
        add {
          name
          type: nil
          declaration: -> top_level_declaration(program, ref.module_index, ref.name)
          names_alias: false
        }

# The doc comments of the declaration, from the text that its module was checked from.
doc_of := (program: ProgramWide, declared: Declared) ->
  source := program.modules[declared.module_index].source
  doc_comment(source, location_of(program, declared.module_index), declared.name)

# What the name refers to: a top-level value, a function, a class or struct, an extern, or else a
# local, whose declaration the checker kept.
name_declaration := (
  program: ProgramWide, module_index: Int, facts: NodeFacts, name: Identifier
): Declared? ->
  reference := facts.references[name]
  case reference
    when TopLevelValue, FunctionReference
      top_level_declaration(program, reference.module_index, reference.name)
    when Constructor
      info := info_of(program, reference.type)
      { module_index: info.module_index, name: info.declaration.name }
    when ExternReference then top_level_declaration(program, reference.module_index, reference.name)
    else
      local := facts.local_declarations[name] else return nil
      { module_index, name: local }

# A top-level value, a function, a generic function, a type or an extern of the module, by its
# name there.
top_level_declaration := (program: ProgramWide, module_index: Int, name: String) ->
  shared := program.shared[module_index]
  declared := (identifier: Identifier) -> Declared(module_index, name: identifier)
  return declared(local.identifier) if local := shared.top_level.locals[name]
  return declared(entry.name) if entry := shared.functions.entries[name]
  is_generic := (each: GenericFunction) -> each.name.name == name and each.receiver == nil
  return declared(generic.name) if generic := shared.generics.find(is_generic)
  return declared(info.declaration.name) if info := shared.objects[name]
  imported := shared.imports.names[name] else return nil
  imported.source is ExportRef then nil else declared(imported.name)

# The field or method that the member reads or calls, or the field that it assigns, for which the
# checker keeps no target; or the member of an enum.
member_declaration := (program: ProgramWide, facts: NodeFacts, member: Member) ->
  name := member.name.name
  object_type := facts.types[member.object]
  target := facts.members[member] else return member_of_type(program, object_type, name)
  case target
    when Method
      source := target.source
      case source
        when OwnMethod then declared_member(program, source.receiver, name)
        when ExtensionSource
          Declared(module_index: source.method.module_index, name: source.method.name)
        else nil
    when Property
      target.kind == FIELD then member_of_type(program, object_type, name)
    when EnumValue then enum_member_declaration(program, facts.types[member]!, name)
    else nil

# The member of the enum by its name, as its declaration writes it.
enum_member_declaration := (program: ProgramWide, type: Type, name: String) ->
  enum_type := type as EnumType else return nil
  (module_index, declaration) := enum_statement(program, enum_type) else return nil
  for each in declaration.members
    if each is Identifier and each.name == name
      return Declared(module_index, name: each)
  nil

# The name of the enum of an enum's member written with it, as `Color` of `Color.RED` or of
# `m.Color.RED`.
enum_name_of := (member: Member, facts: NodeFacts) ->
  return nil unless facts.members[member] is EnumValue
  object := member.object
  case object
    when Identifier then object
    when Member then object.name
    else nil

# The declaration of the class, struct, interface or enum that the type is.
type_declaration := (program: ProgramWide, type: Type): Declared? ->
  case type
    when ObjectType
      info := info_of(program, type)
      { module_index: info.module_index, name: info.declaration.name }
    when EnumType
      (module_index, declaration) := enum_statement(program, type) else return nil
      { module_index, name: declaration.name }
    when InterfaceType then interface_declaration(program, type)
    else nil

# The enum's declaration, in the module that declares the enum, the one whose own enum of its name
# is it.
enum_statement := (program: ProgramWide, type: EnumType) ->
  declares := (shared: Shared) -> shared.enums[type.name]?.symbol == type.symbol
  module_index := program.shared.find(declares)?.index else return nil
  for statement in program.modules[module_index].program
    if statement is EnumDeclaration and statement.name.name == type.name
      return (module_index, statement)
  nil

# The interface's declaration, in the module whose own interface of its name is it.
interface_declaration := (program: ProgramWide, type: InterfaceType) ->
  declares := (shared: Shared) -> shared.interfaces[type.name]?.type.symbol == type.symbol
  module_index := program.shared.find(declares)?.index else return nil
  for statement in program.modules[module_index].program
    if statement is InterfaceDeclaration and statement.name.name == type.name
      return Declared(module_index, name: statement.name)
  nil

# The type name as an identifier, which spans the name as written, as `m.Point` of a qualified one,
# without its type arguments.
written_name := (type_name: NamedType) ->
  Identifier(name: type_name.name, position: type_name.position)

# The member of the type by its name, if the type is a class or a struct.
member_of_type := (program: ProgramWide, type: Type?, name: String) ->
  object_type := type as ObjectType else return nil
  declared_member(program, object_type, name)

declared_member := (program: ProgramWide, type: ObjectType, name: String) ->
  info := info_of(program, type)
  member := info.declaration.members.find((each) -> each.name.name == name) else return nil
  Declared(module_index: info.module_index, name: member.name)

# Whether the source, as its lines, writes the name at its position, rather than the parser or the
# checker making it there, as `?2:3` for the object of `x?.y` or `to_string` for an interpolation.
# The program may be of an older text than the lines (see Server.programs), so a name it has may no
# longer be written where it was.
export is_written := (lines: String[], name: Identifier) ->
  { line, column } := name.position
  return false if line > lines.length
  after := lines[line - 1].skip(column - 1).without_prefix(name.name) else return false

  # The whole name, which another one written there may start with.
  not after.take(1).any(is_name_character)

# Whether the name, which starts at its position, holds the column, both in code points: the column
# right after it too, where a cursor that has just written it is.
spans := (name: Identifier, at: Position) ->
  start := name.position
  length := name.name.count()
  start.line == at.line and at.column in start.column..=(start.column + length)

# A generic body's are those of its definition, then those of its instances.
all_facts := (shared: Shared) ->
  facts := [shared.facts]
  for generic in shared.generics
    facts.push generic.definition.facts
    facts.push instance.facts for instance in generic.instances
  for info in shared.objects.values()
    facts.push info.facts
    facts.push definition.facts if definition := info.standing.first()
    facts.push instance.facts for instance in info.instances
  facts
