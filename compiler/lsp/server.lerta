# `lerta lsp`: a language server over stdin and stdout (see docs/reference/compiler.md#lsp). It
# takes the whole text of a document on each change, publishes the diagnostics of the program
# whose entry module is the document when it is opened or changed, formats it as `lerta fmt --fix`
# would write it, and gives the types of a name in it and where the name is declared.
import is_file from 'std:io'
import exit from 'std:process'
import JsonError from 'std:json'
import ProgramWide from '../checker/shared'
import CompileError from '../errors'
import AnnotationKey from '../format/annotated'
import removable_annotations from '../format/annotations'
import format_source from '../format/format'
import module_key from '../loader'
import is_standard_name, open_texts, read_source, text_key from '../source'
import
  characters, check_file, LspDiagnostic, LspPosition, LspRange, name_range, PositionEncoding,
  source_position
from './diagnostics'
import completion_items, CompletionItem, probe_text, writing_at from './complete'
import definition_of, hover_lines, is_written, location_of, module_at from './locate'
import
  decode_header, decode_notification, decode_request, INTERNAL_ERROR, INVALID_PARAMS,
  METHOD_NOT_FOUND, PARSE_ERROR, notify, read_message, Request, respond, respond_error
from './protocol'
import path_of_uri, uri_of_path from './uri'

struct InitializeParams
  capabilities: ClientCapabilities

struct ClientCapabilities
  general: { position_encodings: String[]? }?

struct InitializeResult
  capabilities: ServerCapabilities
  server_info: { name: String }

# The document's whole text on each change (TextDocumentSyncKind.Full).
struct ServerCapabilities
  position_encoding: String
  text_document_sync: Int
  document_formatting_provider: Bool
  hover_provider: Bool
  definition_provider: Bool
  # Completion after a `.` as well as where a name starts.
  completion_provider: { trigger_characters: String[] }

struct TextDocument
  uri: String

struct OpenedDocument
  uri: String
  text: String

struct DidOpenParams
  text_document: OpenedDocument

struct DidChangeParams
  text_document: TextDocument
  content_changes: { text: String }[]

struct DocumentParams
  text_document: TextDocument

struct PositionParams
  text_document: TextDocument
  position: LspPosition

struct MarkupContent
  kind: String
  value: String

struct Hover
  contents: MarkupContent

struct Location
  uri: String
  range: LspRange

struct PublishDiagnosticsParams
  uri: String
  diagnostics: LspDiagnostic[]

struct TextEdit
  range: LspRange
  new_text: String

FULL_SYNC := 1

class Server
  var encoding = PositionEncoding.UTF16
  var shut_down = false
  # What the last check of each open document found, by its path: the diagnostics of each file of
  # its program (see check_file). A file's diagnostics are those of all the open documents'
  # checks.
  found: Map<String, Map<String, LspDiagnostic[]>> = Map()
  # The program of each open document's last check whose modules could be loaded, as far as it was
  # checked, which hover and going to a definition read. A text that does not load, as one being
  # written or one whose import is missing, keeps the program of the text before it, whose names
  # are found where the new text still writes them (see locate.lerta).
  programs: Map<String, ProgramWide> = Map()
  # The URI that each open document was opened with, by its text's key (see text_key), which the
  # server sends back, as the client knows the document by that spelling, while several URIs,
  # `file://localhost/a.lerta` and `file:///a.lerta`, name one path.
  uris: Map<String, String> = Map()

  # Handles each message until the input ends or an exit notification comes. A header that gives
  # no length tells nothing of where the next message starts, and a body that the end cuts short
  # leaves nothing to answer, so each ends the server.
  run := ->
    while true
      body :=
        try
          await read_message() ? return
        catch error: ValueError | IOError
          print_error error.message
          exit 1
      await @handle(body)

  # A message that is not JSON, or not of a message's shape, is answered as a parse error, which
  # has no id to answer.
  handle := (body: String) ->
    header :=
      try
        decode_header body
      catch error: JsonError
        return await respond_error(nil, PARSE_ERROR, error.message)
    try
      await @dispatch(header.method ? '', header.id, body)
    catch error: JsonError
      await respond_error(id, INVALID_PARAMS, error.message) if id := header.id
    catch error
      # A bug of the server ends the message alone, as one message should not end the session.
      print_error error.message
      await respond_error(id, INTERNAL_ERROR, error.message) if id := header.id

  dispatch := (method: String, id: Int | String?, body: String) ->
    case method
      when 'initialize' then await @initialize(decode_request<InitializeParams>(body))
      when 'textDocument/didOpen'
        params := decode_notification<DidOpenParams>(body)
        await @set_text(params.text_document.uri, params.text_document.text)
      when 'textDocument/didChange'
        params := decode_notification<DidChangeParams>(body)
        if change := params.content_changes.last()
          await @set_text(params.text_document.uri, change.text)
      when 'textDocument/didClose'
        await @close(decode_notification<DocumentParams>(body).text_document.uri)
      when 'textDocument/formatting'
        request := decode_request<DocumentParams>(body)
        await respond(
          request.id
          await formatting_edits(request.params.text_document.uri, @encoding)
        )
      when 'textDocument/hover'
        request := decode_request<PositionParams>(body)
        await respond(request.id, await @hover(request.params))
      when 'textDocument/definition'
        request := decode_request<PositionParams>(body)
        await respond(request.id, await @definition(request.params))
      when 'textDocument/completion'
        request := decode_request<PositionParams>(body)
        await respond(request.id, await @completion(request.params))
      when 'shutdown'
        @shut_down = true
        await respond<Bool?>(given, nil) if given := id
      when 'exit' then exit(@shut_down then 0 else 1)
      else await respond_error(given, METHOD_NOT_FOUND, "no method #{method}") if given := id

  initialize := (request: Request<InitializeParams>) ->
    encodings := request.params.capabilities.general?.position_encodings ? []
    @encoding = UTF32 if 'utf-32' in encodings
    encoding := @encoding == UTF32 then 'utf-32' else 'utf-16'
    capabilities := ServerCapabilities
      position_encoding: encoding
      text_document_sync: FULL_SYNC
      document_formatting_provider: true
      hover_provider: true
      definition_provider: true
      completion_provider: { trigger_characters: ['.'] }
    await respond(request.id, InitializeResult(capabilities, server_info: { name: 'lerta' }))

  # A document that is no file yet is formatted, but not checked: a program's modules are files. One
  # whose file is gone keeps the diagnostics of its last check until it is closed, but not its
  # program, whose positions its new text no longer has; the open documents that import it are
  # checked again, from its new text.
  set_text := (uri: String, text: String) ->
    path := path_of_uri(uri) ? return
    open_texts[text_key(path)] = text
    @uris[text_key(path)] = uri
    unless is_file(path)
      @programs.remove path
      await @check(doc) for doc in @importers(path)
      return
    await @check(doc) for doc in [path, @importers(path)...]

  # Its importers' checks, which took its text, are made again, from the file.
  close := (uri: String) ->
    path := path_of_uri(uri) ? return
    open_texts.remove text_key(path)
    files := @found[path]?.keys().to_array() ? []
    @found.remove path
    @programs.remove path
    await @check(doc) for doc in @importers(path)
    await @publish(file) for file in files
    @uris.remove text_key(path)

  # The types of the name at the position, as a block of Lerta, from the program of the document's
  # own check if it has one, or of another open document's that holds it.
  hover := (params: PositionParams) ->
    path := path_of_uri(params.text_document.uri) ? return nil
    program := @program_of(path) ? return nil
    module_index := module_at(program, path) ? return nil
    at := await source_position(path, params.position, @encoding)
    lines := hover_lines(program, module_index, await read_source(path), at)
    return nil if lines.is_empty()
    Hover { kind: 'markdown', value: "```lerta\n#{lines.join("\n")}\n```" }

  # Where the name at the position is declared, if in a file that still writes it there.
  definition := (params: PositionParams) ->
    path := path_of_uri(params.text_document.uri) ? return nil
    program := @program_of(path) ? return nil
    module_index := module_at(program, path) ? return nil
    at := await source_position(path, params.position, @encoding)
    declared := definition_of(program, module_index, await read_source(path), at) ? return nil
    location := location_of(program, declared.module_index)
    return nil if is_standard_name(location)
    return nil unless is_written((await read_source(location)).split("\n"), declared.name)
    range := await name_range(location, declared.name, @encoding)
    Location range, uri: @uri_of(location)

  # What may be written where a name is being written, from a check of the document's text with
  # the checker's own name there (see complete.lerta), whose diagnostics are not published.
  completion := (params: PositionParams): Promise<CompletionItem[]> ->
    path := path_of_uri(params.text_document.uri) ? return []
    key := text_key(path)
    text := open_texts[key] ? return []
    return [] unless is_file(path)
    at := await source_position(path, params.position, @encoding)
    lines := text.split("\n")
    return [] unless at.line in 1..lines.length
    writing := writing_at(lines[at.line - 1], at.column)
    open_texts[key] = probe_text(text, at.line - 1, writing)
    checked :=
      try
        await check_file(path, @encoding)
      finally
        open_texts[key] = text
    program := checked.program ? return []
    module_index := module_at(program, path) ? return []
    completion_items program, module_index, program.completion

  program_of := (path: String) ->
    return own if own := @programs[path]
    for (doc, files) in @found.entries()
      return @programs[doc] if path in files and doc in @programs
    nil

  # The other open documents whose programs hold the document at the path.
  importers := (path: String) ->
    [doc for (doc, files) in @found.entries() when doc != path and path in files]

  # Checks the program whose entry module is the open document at the path, and publishes the
  # diagnostics of the files of its program, as of this check and of the last one. Its program is
  # kept if its modules cannot be loaded.
  check := (path: String) ->
    before := @found[path]?.keys().to_array() ? []
    checked := await check_file(path, @encoding)
    found := checked.by_path
    @found[path] = found
    @programs[path] = program if program := checked.program
    files := [file for file in before when file not in found]
    files.append found.keys().to_array()
    await @publish(file) for file in files

  # The URI of the file as the client opened it, or else as the server writes one.
  uri_of := (path: String) -> @uris[text_key(path)] ? uri_of_path(path)

  # Publishes the diagnostics that the open documents' checks found in the file, each once.
  publish := (file: String) ->
    diagnostics: Set<LspDiagnostic>
    for found in @found.values()
      diagnostics.add each for each in found[file] ? []
    params := PublishDiagnosticsParams(uri: @uri_of(file), diagnostics: diagnostics.to_array())
    await notify('textDocument/publishDiagnostics', params)

# The edit that writes the document in the style, of its whole text, or none if it is so already;
# nil if it does not parse.
formatting_edits := (uri: String, encoding: PositionEncoding) ->
  path := path_of_uri(uri) ? return nil
  text := open_texts[text_key(path)] ? return nil
  try
    formatted := format_source(text, path, await removable_types(path)).text
    none: TextEdit[]
    return none if formatted == text
    lines := text.split("\n")
    end := LspPosition(line: lines.length - 1, character: characters(lines.last()!, encoding))
    range := LspRange(start: { line: 0, character: 0 }, end: end)
    [TextEdit(range, new_text: formatted)]
  catch _: CompileError
    nil

# The annotations that `lerta fmt --fix` leaves out of the file, which the checker tells; none for
# a document that is no file yet, which no program holds.
removable_types := (path: String): Promise<AnnotationKey[]> ->
  return [] unless is_file(path)
  (await removable_annotations([path]))[module_key(path)] ? []

export lsp_command := (args: String[]) ->
  throw CompileError('lerta lsp takes no arguments') unless args.is_empty()
  await Server().run()
