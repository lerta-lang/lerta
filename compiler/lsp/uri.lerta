# The `file:` URIs of the LSP and the paths they name, `file:///a%20b/c.lerta` and `/a b/c.lerta`,
# or on Windows `file:///C:/a.lerta` and `C:/a.lerta`.

FILE_PREFIX := 'file://'

# The path of the URI, or nil for one that names no file. A host may come before the path, as in
# `file://localhost/a.lerta`, which names a file only when it is this machine.
export path_of_uri := (uri: String): String? ->
  after_prefix := uri.without_prefix(FILE_PREFIX) ? return nil
  (host, rest) := after_prefix.split_once('/') ? return nil
  return nil if not (host.is_empty() or host.to_lower() == 'localhost')
  path := percent_decoded("/#{rest}") ? return nil
  is_windows_drive(path) then path.without_prefix('/')! else path

# The URI of the absolute path.
export uri_of_path := (path: String) ->
  absolute := path.starts_with('/') then path else "/#{path}"
  "#{FILE_PREFIX}#{percent_encoded(absolute)}"

# `/C:/`: a drive after the slash that a URI's path starts with.
is_windows_drive := (path: String) ->
  bytes := path.binary
  bytes.length >= 3 and bytes[0] == '/' and bytes[1].is_letter() and bytes[2] == ':'

percent_decoded := (text: String) ->
  bytes := text.binary
  decoded: Byte[]
  var i = 0
  while i < bytes.length
    if bytes[i] != '%'
      decoded.push bytes[i]
      i += 1
      continue
    return nil if i + 2 >= bytes.length
    high := bytes[i + 1].hex_value() ? return nil
    low := bytes[i + 2].hex_value() ? return nil
    decoded.push (high * 16 + low).to_byte()!
    i += 3
  decoded.to_binary().text()

# Besides letters and digits, the bytes that a path keeps in a URI: the unreserved ones of a URI,
# the separator, and the colon of a drive.
KEPT_BYTES: Byte[] = ['-', '.', '_', '~', '/', ':']

# Each byte but those that a path keeps, as `%XX`.
percent_encoded := (path: String) ->
  pieces: String[]
  for byte in path.binary
    keeps := byte.is_letter() or byte.is_digit() or byte in KEPT_BYTES
    pieces.push keeps then byte.to_char().to_string() else "%#{byte.to_int().to_hex(2).to_upper()}"
  pieces.join ''
