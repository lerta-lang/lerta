# File paths, as those of Node's `path` module work them out, written with `/` as the separator.
# On Windows, `\` separates them too, and an absolute path starts at a drive or a network share.
# A path relative to the current directory of a drive, `C:a`, is not supported: a real path, from
# which the compiler works out the others, never is one.

import platform from 'std:process'
import all_but_last from './arrays'

is_windows := platform == 'windows'

# A path as the root it starts at, and the names below it, without empty ones. The root is `` for
# a relative path, `/`, or on Windows a drive, `C:/`, in upper case as drives are named in either,
# or a network share, `//server/share/`, as written, which a real path writes alike. Two
# separators before a single name start no share, so that `/` is their root.
struct SplitPath(root: String, names: String[])

split_path := (path: String) ->
  slashed := is_windows then path.replace('\', '/') else path
  bytes := slashed.binary
  names := [name for name in slashed.split('/') when name != '']
  starts_at_separator := bytes.length > 0 and bytes[0] == '/'
  is_share := starts_at_separator and bytes.length > 1 and bytes[1] == '/'
  case
    when is_windows and is_drive(bytes)
      SplitPath root: "#{names[0].to_upper()}/", names: names_after(names, 1)
    when is_windows and is_share and names.length >= 2
      SplitPath root: "//#{names[0]}/#{names[1]}/", names: names_after(names, 2)
    when starts_at_separator then SplitPath(names, root: '/')
    else SplitPath(names, root: '')

# Whether the path starts with a drive and a separator, as `C:\`: `C:` alone names the current
# directory of that drive, which is relative.
is_drive := (bytes: Binary) ->
  bytes.length >= 3 and bytes[0].is_letter() and bytes[1] == ':' and bytes[2] == '/'

names_after := (names: String[], count: Int) -> [names[i] for i in count...names.length]

joined := (root: String, names: String[]) ->
  root == '' and names.length == 0 then '.' else "#{root}#{names.join('/')}"

# The directory of the path: `.` for a name alone, and the root for the root.
export dirname := (path: String) ->
  split := split_path(path)
  names := split.names
  joined split.root, names.length == 0 then names else all_but_last(names)

export join := (a: String, b: String) -> normalize("#{a}/#{b}")

# The path without `.` and empty names, and with each `..` removing the name before it.
normalize := (path: String) ->
  split := split_path(path)
  is_absolute := split.root != ''
  names: String[]
  for name in split.names
    case name
      when '.' then continue
      when '..'
        can_cancel := names.length > 0 and names.last() != '..'
        if can_cancel
          names.pop()
        else if not is_absolute
          names.push name
      else names.push(name)
  joined split.root, names

# The path from the directory `from` to `to`, both relative to `cwd` unless absolute. Paths under
# different roots have none, so `to` is given absolute.
export relative := (cwd: String, from: String, to: String) ->
  from_path := split_path(absolute(cwd, from))
  to_path := split_path(absolute(cwd, to))
  return joined(to_path.root, to_path.names) if from_path.root != to_path.root
  from_names := from_path.names
  to_names := to_path.names
  var common = 0
  while common < from_names.length and common < to_names.length
    break if from_names[common] != to_names[common]
    common += 1
  names := ['..' for _ in common...from_names.length]
  names.push to_names[i] for i in common...to_names.length
  names.join '/'

# Whether the path starts at a root (see split_path). On Windows a path that starts at `/` alone
# names the file from the root of the current drive, so it names one file for each drive.
export is_absolute := (path: String) -> split_path(path).root != ''

# The path as it is if it is absolute, and otherwise from `cwd`, with `.` and `..` worked out as
# text, as join does: a `..` after a name that is a symbolic link names another directory than the
# system resolves it to.
absolute := (cwd: String, path: String) ->
  normalize is_absolute(path) then path else join(cwd, path)

# The last name of the path: `c` for `a/b/c`, and `` for a root.
export basename := (path: String) -> split_path(path).names.last() ? ''
