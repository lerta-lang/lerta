const HEX_DIGITS = '0123456789ABCDEF'

# `n`, which is not negative, in uppercase hexadecimal, padded with zeros to `width` digits.
export const hex = (n: Int, width: Int) ->
  var digits = ''
  var rest = n
  while rest > 0 or digits.binary.length < width
    const digit = rest % 16
    digits = HEX_DIGITS.binary.text(digit, digit + 1) + digits
    rest /= 16
  digits

# The value of a hexadecimal digit, or nil if `c` is not one.
export const hex_digit_value = (c: Byte) ->
  case
    when c.is_digit() then (c - '0').to_int()
    when c >= 'a' and c <= 'f' then (c - 'a').to_int() + 10
    when c >= 'A' and c <= 'F' then (c - 'A').to_int() + 10
    else nil
