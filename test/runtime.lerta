# Runtime checks that no Lerta program can trigger: a C program of test/runtime stands in for the
# generated code and is linked with the runtime as `build` links it, for the host or for another
# target (see lib/target).
import build_flags, target_flags from '../compiler/clang'
import Check, in_slot, jobs, select, SuiteChecks from './lib/report'
import compare_text, expect_status, lines, reason_unless from './lib/expect'
import
  exit_in_time, system_build, OUTPUT_LIMIT, root_dir, SetupError, shown_text, suite_dir
from './lib/lerta'
import timeout from 'std:async'
import Buffer from 'std:io'
import encode_json from 'std:json'
import platform, run from 'std:process'
import runtime_c_names, target_system from '../compiler/platform_description'
import host_target, Target from './lib/target'
import no_wine_prefixes, start_wine_prefixes, wine_env from './lib/wine'
import
  is_dir, is_file, list_dir, make_dir, make_link, make_temp_dir, remove_tree, write_file
from 'std:io'

runtime_dir := "#{root_dir}/runtime"
sources_dir := "#{root_dir}/test/runtime"
libuv_dir := "#{root_dir}/third_party/libuv"
work_dir := suite_dir('runtime')

# The seconds that a check whose program could hang waits for it.
HANG_SECONDS := 10.0

var target = host_target

# The status that a program of test/runtime exits with where its check does not apply.
SKIPPED := 77

# How a program ended and what it printed.
struct Outcome
  status: Int
  stdout: String
  stderr: String

execute := (
  program: String
  args: String[] = []
  cwd: String = work_dir
  stdin: Binary? = nil
  env: Map<String, String> = Map()
) ->
  output := Buffer(limit: OUTPUT_LIMIT)
  errors := Buffer(limit: OUTPUT_LIMIT)
  ran := run(program, args..., cwd: cwd, stdin: stdin, stdout: output, stderr: errors, env: env)
  ended := await exit_in_time(program, ran)
  Outcome(status: ended.code, stdout: shown_text(output.binary), stderr: shown_text(errors.binary))

# Wine runs a Windows program in a prefix of its own, when there are such prefixes (see lib/wine).
var wine_prefixes = no_wine_prefixes()

# Runs a program that `build` built, which Wine runs for a Windows target elsewhere than on Windows.
execute_built := (
  executable: String
  args: String[] = []
  cwd: String = work_dir
  env: Map<String, String> = Map()
) ->
  unless target.wine
    return await execute(executable, args, cwd, nil, env)
  prefix := wine_prefixes.take()
  try
    variables := wine_env(prefix)
    variables[name] = value for (name, value) in env
    await execute('wine', [executable, args...], cwd, nil, variables)
  finally
    wine_prefixes.give_back prefix if prefix

clang := (args: String[], cwd: String = work_dir) ->
  outcome := await execute('clang', args, cwd)
  throw SetupError("clang #{args.join(' ')} failed:\n#{outcome.stderr}") if outcome.status != 0

# What the runtime's programs are built with, set up once for all of them by set_up_runtime: the
# host's runtime C files, and libuv's objects and libraries.
struct Runtime
  c_files: String[]
  libuv_objects: String[]
  libraries: String[]
var runtime = Runtime(c_files: [], libuv_objects: [], libraries: [])

# Compiles libuv's sources that the target's description lists, with its flags, into the directory
# that clang runs in, and takes the runtime's C files and the libraries that it lists.
set_up_runtime := ->
  build := await system_build(target_system(target.triple))
  { libuv_sources, libuv_flags, libraries } := build
  objects_dir := "#{work_dir}/libuv"
  make_dir objects_dir
  libuv_paths := ["#{libuv_dir}/#{source}" for source in libuv_sources]
  libuv_args := [
    '-c'
    target_flags(target.triple)...
    libuv_flags...
    "-I#{libuv_dir}/include"
    "-I#{libuv_dir}/src"
    '-w'
    libuv_paths...
  ]
  await in_slot(-> clang(libuv_args, objects_dir))
  c_files := ["#{runtime_dir}/#{file}" for file in runtime_c_names(list_dir(runtime_dir), build)]
  libuv_objects := ["#{objects_dir}/#{file}" for file in list_dir(objects_dir)]
  runtime = { c_files, libuv_objects, libraries }

# What `build` gives clang for the runtime's sources for the target, with -O or without it and its
# default memory checks; libuv is compiled once, without them, by set_up_runtime.
runtime_clang_args := (optimize: Bool) ->
  # libm, as compiler/build.lerta links it.
  libraries := ["-l#{library}" for library in ['m', runtime.libraries...]]
  [
    build_flags({ optimize, memory_checks: not optimize, target: target.triple })...
    "-I#{libuv_dir}/include"
    runtime.c_files...
    runtime.libuv_objects...
    libraries...
    (target.windows then ["#{sources_dir}/binary_stdout.c"] else [])...
  ]

var build_count = 0

# Builds test/runtime/<source>.c, with the macros, and gives the path of its executable, which is
# numbered, as a source may be built more than once.
build := (source: String, optimize: Bool, macros: String[] = []) ->
  build_count += 1
  executable := "#{work_dir}/#{source}-#{build_count}#{target.executable_suffix}"
  defines := ["-D#{macro}" for macro in macros]
  await clang(
    [
      '-I'
      runtime_dir
      defines...
      "#{sources_dir}/#{source}.c"
      runtime_clang_args(optimize)...
      '-o'
      executable
    ]
  )
  executable

build_and_run := (source: String, optimize: Bool, macros: String[] = []) ->
  await execute_built(await build(source, optimize, macros))

# The reasons for an outcome other than an exit with 0 and nothing on stderr.
expect_clean := (outcome: Outcome) ->
  compare_text('stderr', '', outcome.stderr) + expect_status(0, outcome.status)

clean_check := (name: String, source: String, optimize: Bool, macros: String[] = []) ->
  Check(name, run: -> expect_clean(await build_and_run(source, optimize, macros)))

# A debug program that must stop with the message.
stop_check := (name: String, source: String, message: String, macros: String[] = []) ->
  Check(name, run: ->
    outcome := await build_and_run(source, false, macros)
    [
      compare_text('stderr', "#{message}\n", outcome.stderr)...
      reason_unless(outcome.status != 0, 'expected the program to stop, but it exited with 0')...
    ]
  )

use_after_drop := (use: String) ->
  message := "#{use} of a dropped object"
  stop_check(
    "the debug runtime stops a #{message}"
    'use_after_drop'
    message
    ["USE=lerta_#{use}"]
  )

kind_name := (optimize: Bool) -> optimize then 'optimized' else 'debug'

# A program of each runtime that must exit with 0 and print nothing on stderr.
both_runtimes := (what: String, source: String) ->
  [
    clean_check("the #{kind_name(optimize)} runtime #{what}", source, optimize)
    for optimize in [false, true]
  ]

# Runs the program with stdout and stderr on a terminal, which `script` makes, and gives what the
# terminal shows. The terminal ends lines with CRLF, and macOS's `script` may show the end of its
# input first.
run_on_terminal := (executable: String) ->
  args :=
    if platform == 'macos'
      ['-q', '/dev/null', executable]
    else
      ['-qec', executable, '/dev/null']
  (await execute('script', args, work_dir, b'')).stdout

# A check of what only POSIX targets have, such as /dev/null, fcntl and `script`.
posix_target_check := (name: String, run: () -> Promise<String[]?>) ->
  Check(name, run: -> target.windows then nil else await run())
on_posix_target := (check: Check) -> posix_target_check(check.name, check.run)

# Not under Wine, which shows a link of the host as the directory that it names.
remove_tree_check := Check
  name: 'lerta_os_remove_tree removes a directory with everything in it, deeper than the ' +
    'descriptors it may open, but not what a link names'
  run: ->
    return nil if target.wine
    tree := "#{work_dir}/tree"
    linked := "#{work_dir}/linked"
    make_dir "#{tree}/inner/empty"
    make_dir "#{tree}/deep#{'/x'.repeat(40)}"
    make_dir linked
    await write_file("#{tree}/inner/file", b'')
    await write_file("#{linked}/file", b'')
    make_link linked, "#{tree}/link"
    executable := await build('remove_tree', false)
    outcome := await execute_built(executable, [], work_dir, { 'LERTA_TEST_TREE': tree })
    [
      expect_clean(outcome)...
      reason_unless(not is_dir(tree), "#{tree} is still there")...
      reason_unless(is_file("#{linked}/file"), 'the link was followed')...
    ]

# In a directory of its own, where it makes the long one, removed after.
long_temp_dir_check := posix_target_check
  'lerta_os_make_temp_dir makes one in a TMPDIR longer than its first buffer for it'
  ->
    dir := make_temp_dir()
    try
      expect_clean(await execute_built(await build('long_temp_dir', false), [], dir))
    finally
      await remove_tree(dir)

checks: Check[] = [
  remove_tree_check
  long_temp_dir_check
  { name: 'the debug runtime reports a leak', run: ->
    outcome := await build_and_run('leak', false)
    [
      compare_text('stderr', "leak: 1 object(s)\n", outcome.stderr)...
      expect_status(23, outcome.status)...
    ]
  }
  clean_check('the debug runtime accepts released objects', 'released', false)
  clean_check('the debug runtime fills a freed object or buffer with 0xDB', 'freed_bytes', false)
  clean_check('a LertaQueue keeps its items in order as it drops and grows', 'queue', false)
  use_after_drop('retain')
  use_after_drop('release')
  stop_check(
    'the debug runtime stops a release of a dropped object after another is allocated'
    'release_after_allocation'
    'release of a dropped object'
  )
  stop_check(
    'the debug runtime stops a retain of a dropped object whose slab became empty'
    'retain_after_empty_slab'
    'retain of a dropped object'
  )
  stop_check(
    'the debug runtime stops a release of a dropped object that had a deinit'
    'release_deinit'
    'release of a dropped object'
  )
  both_runtimes('allocates places of every kind of size', 'allocate_sizes')...
  both_runtimes('reuses freed places among full and fresh slabs', 'reuse_places')...
  both_runtimes('allocates objects of every kind of size', 'new_objects')...
  both_runtimes('reallocates buffers of every kind of size', 'reallocate')...
  both_runtimes('keeps empty slabs for reuse as its build does', 'keep_empty_slabs')...
  stop_check(
    'the debug runtime stops a release of an object queued to be dropped'
    'release_queued'
    'release of a dropped object'
  )
  { name: 'lerta_string_slice throws unless both ends are within and at characters', run: ->
    outcome := await build_and_run('string_slice', false)
    out_of_range := 'error 0: slice out of range'
    within := 'error 0: slice within a character'
    in_place := ["'a'", "'é'", "'😀'", "''"]
    expected := [
      in_place...
      within
      within
      within
      within
      out_of_range
      out_of_range
      out_of_range
    ]
    compare_text('stdout', lines(expected), outcome.stdout) + expect_clean(outcome)
  }
  { name: 'string and word hashes take a seed, a secret and keys that each process draws', run: ->
    executable := await build('string_hash', true)
    first := await execute_built(executable)
    second := await execute_built(executable)

    # The way of i686, which has no 128-bit integers, for the target.
    narrow := await build_and_run('string_hash', true, ['LERTA_NO_INT128'])

    # wyhash, final version 4.3, as the reference's wyhash.h gives them, with its default secret and
    # then with the secret that its make_secret makes from the seed 0; the first is the reference's
    # vector of the empty bytes under the seed 0, and the secrets are make_secret's of 0 and 1.
    known :=
      '93228a4de0eec5a2'
      '8e6d4af7d310c8c4'
      '5121ba5bc9a828b5'
      '78c4aa0c972a522d'
      'e08aeeb68058fb32'
      '845a2c5da2318785'
      'cd82974fce6df97f'
      '094e98feb6055cc6'
      'b4d6ac74d009e1d4'
      'b42922e019b409be'
      '17b9ead432120ac5'
      'a51fa8a613d0e5b9'
      '44a77a3d52394b70'
      '031e7fc29c5b1c14'
      '4b0bfbbf3d4d4343'
      '87edaf96d89a08ef'
      '305fdea0ed4a2619'
      'd29ffdd201a46f9a'
      '5b00c06ef7540f8f'
      'e2cb58f6ab8e4419'
      'ecbfb7ff9e3d9a97'
      '0691f11bac523a91'
      '948137d69794b570'
      '77ed9a7dfb9ac9b7'
      '2513bb3f4da95c04'
      '39d43c5c4e3a724b'
      '6596e14753cca38b'
      'c68d954b2b339353'
      '96b4a6e45c65aa55'
      '0ff09999359563a5'
      '2d6c35b48de81b2b'
      'd2ca93c527b49c2b'
      '47c3660fc5e1c9b1'
      '63345c8f3d25085d'

    # The hashes under the process's own seed, secret and keys: of "a", and of the word 0.
    own_hashes := (outcome: Outcome) ->
      printed := outcome.stdout.split("\n")
      [
        for i in 0..2
          position := known.length + i
          printed.length > position then printed[position] else ''
      ]
    firsts := own_hashes(first)
    seconds := own_hashes(second)
    [
      compare_text('stdout', lines([known..., firsts...]), first.stdout)...
      expect_clean(first)...
      compare_text('stdout', lines([known..., own_hashes(narrow)...]), narrow.stdout)...
      expect_clean(narrow)...
      expect_clean(second)...
      reason_unless(firsts[0] != seconds[0], 'two processes hashed "a" alike')...
      reason_unless(firsts[1] != seconds[1], 'two processes hashed the word 0 alike')...
    ]
  }
  clean_check('the optimized runtime does not count objects', 'leak', true)
  # Skipped where the program exits with SKIPPED, as a 32-bit one does, which has no room for 2 GiB.
  posix_target_check('a write of more than 2 GiB is done whole', ->
    outcome := await build_and_run('write_large', false)
    outcome.status == SKIPPED then nil else expect_clean(outcome)
  )
  on_posix_target(
    clean_check('print_error drops its output once stderr has failed', 'print_error_failed', false)
  )
  on_posix_target(
    clean_check(
      'print_error drops its output once a write to stderr has failed'
      'print_error_failed'
      false
      ['FAIL_BY_WRITE']
    )
  )
  # The write is rejected, which no one awaits, so the program reports it and exits with 1.
  posix_target_check('a write to stderr is rejected once print_error has failed', ->
    outcome := await build_and_run('print_error_failed', false, ['DROP_BY_WRITE'])
    [
      compare_text('stderr', "cannot write to stderr\n", outcome.stderr)...
      expect_status(1, outcome.status)...
    ]
  )
  posix_target_check('output is written out while every thread of the pool is busy', ->
    executable := await build('write_busy_pool', false)
    outcome := await timeout(execute_built(executable), HANG_SECONDS)
    [
      compare_text('stdout', "flushed\nprinted\n", outcome.stdout)...
      expect_status(0, outcome.status)...
    ]
  )
  posix_target_check('a write to a non-blocking pipe waits while the pipe is full', ->
    outcome := await build_and_run('write_non_blocking', false)
    length := outcome.stdout.binary.length
    [
      compare_text('stdout length', '1048576', length.to_string())...
      expect_status(0, outcome.status)...
    ]
  )
  posix_target_check('a read of a non-blocking stdin waits while the pipe is empty', ->
    executable := await build('read_non_blocking', false)
    script := '{ sleep 0.3; printf hi; } | "$0"'
    outcome := await timeout(execute('sh', ['-c', script, executable]), HANG_SECONDS)
    expect_status(0, outcome.status)
  )
  posix_target_check("libuv's uv_spawn leaves a handle that it fails to spawn to uv_close", ->
    executable := await build('spawn_fails', false)
    outcome := await timeout(execute_built(executable), HANG_SECONDS)
    [
      compare_text('stdout', "EINVAL\n2\n0\n", outcome.stdout)...
      expect_status(0, outcome.status)...
    ]
  )
  {
    name: 'the writes of Writers stay in the buffer, for stderr too, until it is written out'
    run: ->
      outcome := await build_and_run('interleaved_writes', false, ['EXIT_AT_ONCE'])
      compare_text('stdout', '', outcome.stdout) + compare_text('stderr', '', outcome.stderr)
  }
  posix_target_check(
    'the buffer is written out at exit, to a terminal too, in the order of the writes'
    ->
      shown := await run_on_terminal(await build('interleaved_writes', false))
      expected := "first\r\nsecond\r\nthird\r\n"
      reason :=
        "expected the terminal to end with #{encode_json(expected)}, got #{encode_json(shown)}"
      reason_unless(shown.ends_with(expected), reason)
  )
]

# The checks that the suite selected, if any, of the programs built for `given`.
export suite := (given: Target) ->
  target = given
  title := 'runtime checks'
  selected := select(title, checks) else return nil
  set_up := ->
    await set_up_runtime()
    if target.wine
      wine_prefixes = await start_wine_prefixes(work_dir, jobs())
  SuiteChecks(title, checks: selected, ready: set_up(), stop: -> await wine_prefixes.stop())
