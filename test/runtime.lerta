# Runtime checks that no Lerta program can trigger: a C program of test/runtime stands in for the
# generated code and is linked with the runtime as `build` links it.
import build_flags from '../compiler/clang_flags'
import Check, run_checks, select from './lib/report'
import compare_text, expect_status, lines, reason_if from './lib/expect'
import host_systems, read_text_or_throw, root_dir, SetupError, suite_dir from './lib/lerta'
import timeout from 'std:async'
import encode_json from 'std:json'
import platform, run from 'std:process'
import is_dir, is_file, list_dir, make_dir, make_link, write_file from 'std:io'

runtime_dir := "#{root_dir}/runtime"
sources_dir := "#{root_dir}/test/runtime"
libuv_dir := "#{root_dir}/third_party/libuv"
work_dir := suite_dir('runtime')

# The most output kept of each stream of a program, more than the 1 MiB that write_non_blocking.c
# writes.
OUTPUT_LIMIT := 2 * 1024 * 1024

# The seconds that a check whose program could hang waits for it.
HANG_SECONDS := 10.0

# How a program ended and what it printed.
struct Outcome
  status: Int
  stdout: String
  stderr: String

execute := (
  program: String
  args: String[] = []
  cwd: String = work_dir
  stdin: Binary? = nil
  env: Map<String, String> = Map()
) ->
  stdout: Byte[]
  stderr: Byte[]
  ended := await run(
    program
    args...
    cwd: cwd
    stdin: stdin
    stdout: stdout
    stderr: stderr
    env: env
    output_limit: OUTPUT_LIMIT
  )
  text := (bytes: Byte[]) -> bytes.to_binary().text() ? '(not valid UTF-8)'
  Outcome status: ended.code, stdout: text(stdout), stderr: text(stderr)

clang := (args: String[], cwd: String = work_dir) ->
  outcome := await execute('clang', args, cwd)
  throw SetupError("clang #{args.join(' ')} failed:\n#{outcome.stderr}") if outcome.status != 0

# libuv as the runtime's programs link it, compiled once for all of them by set_up_libuv.
struct Libuv
  objects: String[]
  libraries: String[]
var libuv = Libuv(objects: [], libraries: [])

# Compiles the sources and links the libraries that third_party/libuv.txt lists for the host's
# system, by the rule of is_for in compiler/libuv.lerta, with its flags, into the directory that
# clang runs in.
set_up_libuv := ->
  lines := [
    line.split(' ')
    for line in (await read_text_or_throw("#{root_dir}/third_party/libuv.txt")).split("\n")
    when not line.is_empty() and not line.starts_with('#')
  ]
  listed := (kind: String) ->
    [words[2] for words in lines when words[1] == kind and host_systems.contains(words[0])]
  objects_dir := "#{work_dir}/libuv"
  make_dir objects_dir
  await clang(
    [
      '-c'
      listed('flag')...
      "-I#{libuv_dir}/include"
      "-I#{libuv_dir}/src"
      '-w'
      ("#{libuv_dir}/#{source}" for source in listed('source'))...
    ]
    objects_dir
  )
  libuv =
    objects: ["#{objects_dir}/#{file}" for file in list_dir(objects_dir)]
    libraries: listed('library')

# The host's: platform_<systems>.c only for the host's systems, as compiler/runtime_cache.lerta
# takes them.
is_host_c_file := (file: String) ->
  name := file.without_suffix('.c') ? return false
  host_systems.contains name.without_prefix('platform_') ? 'all'

runtime_c_files :=
  ["#{runtime_dir}/#{file}" for file in list_dir(runtime_dir) when is_host_c_file(file)]

# What `build` gives clang for the runtime's sources on the host, with -O or without it and its
# default memory checks; libuv is compiled once, without them, by set_up_libuv.
runtime_clang_args := (optimize: Bool) ->
  [
    build_flags({ optimize, memory_checks: not optimize, target: nil })...
    "-I#{libuv_dir}/include"
    runtime_c_files...
    libuv.objects...
    # libm, as compiler/build.lerta links it.
    ("-l#{library}" for library in ['m', libuv.libraries...])...
  ]

var build_count = 0

# Builds test/runtime/<source>.c, with the macros, and gives the path of its executable, which is
# numbered, as a source may be built more than once.
build := (source: String, optimize: Bool, macros: String[] = []) ->
  build_count += 1
  executable := "#{work_dir}/#{source}-#{build_count}"
  await clang(
    [
      '-I'
      runtime_dir
      ("-D#{macro}" for macro in macros)...
      "#{sources_dir}/#{source}.c"
      runtime_clang_args(optimize)...
      '-o'
      executable
    ]
  )
  executable

build_and_run := (source: String, optimize: Bool, macros: String[] = []) ->
  await execute(await build(source, optimize, macros))

# The reasons for an outcome other than an exit with 0 and nothing on stderr.
expect_clean := (outcome: Outcome) ->
  [compare_text('stderr', '', outcome.stderr)..., expect_status(0, outcome.status)...]

clean_check := (name: String, source: String, optimize: Bool, macros: String[] = []) ->
  Check name, run: -> expect_clean(await build_and_run(source, optimize, macros))

# A debug program that must stop with the message.
stop_check := (name: String, source: String, message: String, macros: String[] = []) ->
  Check name, run: ->
    outcome := await build_and_run(source, false, macros)
    [
      compare_text('stderr', "#{message}\n", outcome.stderr)...
      reason_if(outcome.status == 0, 'expected the program to stop, but it exited with 0')...
    ]

use_after_drop := (use: String) ->
  message := "#{use} of a dropped object"
  stop_check "the debug runtime stops a #{message}", 'use_after_drop', message, ["USE=lerta_#{use}"]

kind_name := (optimize: Bool) -> optimize then 'optimized' else 'debug'

# A program of each runtime that must exit with 0 and print nothing on stderr.
both_runtimes := (what: String, source: String) ->
  [
    clean_check("the #{kind_name(optimize)} runtime #{what}", source, optimize)
    for optimize in [false, true]
  ]

# Runs the program with stdout and stderr on a terminal, which `script` makes, and gives what the
# terminal shows. The terminal ends lines with CRLF, and macOS's `script` may show the end of its
# input first.
run_on_terminal := (executable: String) ->
  args :=
    platform == 'macos' then ['-q', '/dev/null', executable] else ['-qec', executable, '/dev/null']
  (await execute('script', args, work_dir, ''.binary)).stdout

remove_tree_check := Check
  name: 'lerta_os_remove_tree removes a directory with everything in it, but not what a link names'
  run: ->
    tree := "#{work_dir}/tree"
    linked := "#{work_dir}/linked"
    make_dir "#{tree}/inner/empty"
    make_dir linked
    await write_file("#{tree}/inner/file", ''.binary)
    await write_file("#{linked}/file", ''.binary)
    make_link linked, "#{tree}/link"
    executable := await build('remove_tree', false)
    outcome := await execute(executable, [], work_dir, nil, { 'LERTA_TEST_TREE': tree })
    [
      expect_clean(outcome)...
      reason_if(is_dir(tree), "#{tree} is still there")...
      reason_if(not is_file("#{linked}/file"), 'the link was followed')...
    ]

checks := [
  remove_tree_check
  Check(name: 'the debug runtime reports a leak', run: ->
    outcome := await build_and_run('leak', false)
    [
      compare_text('stderr', "leak: 1 object(s)\n", outcome.stderr)...
      expect_status(23, outcome.status)...
    ]
  )
  clean_check('the debug runtime accepts released objects', 'released', false)
  use_after_drop('retain')
  use_after_drop('release')
  stop_check(
    'the debug runtime stops a release of a dropped object after another is allocated'
    'release_after_allocation'
    'release of a dropped object'
  )
  stop_check(
    'the debug runtime stops a retain of a dropped object whose slab became empty'
    'retain_after_empty_slab'
    'retain of a dropped object'
  )
  stop_check(
    'the debug runtime stops a release of a dropped object that had a deinit'
    'release_deinit'
    'release of a dropped object'
  )
  both_runtimes('allocates places of every kind of size', 'allocate_sizes')...
  both_runtimes('reuses freed places among full and fresh slabs', 'reuse_places')...
  both_runtimes('allocates objects of every kind of size', 'new_objects')...
  both_runtimes('reallocates buffers of every kind of size', 'reallocate')...
  both_runtimes('keeps empty slabs for reuse as its build does', 'keep_empty_slabs')...
  stop_check(
    'the debug runtime stops a release of an object queued to be dropped'
    'release_queued'
    'release of a dropped object'
  )
  Check(name: 'lerta_string_slice throws unless both ends are within and at characters', run: ->
    outcome := await build_and_run('string_slice', false)
    out_of_range := 'error 0: slice out of range'
    within := 'error 0: slice within a character'
    in_place := ["'a'", "'é'", "'😀'", "''"]
    expected := [
      in_place...
      within
      within
      within
      within
      out_of_range
      out_of_range
      out_of_range
    ]
    [compare_text('stdout', lines(expected), outcome.stdout)..., expect_clean(outcome)...]
  )
  Check(name: 'lerta_string_hash is SipHash-1-3 under a key of its own in each process', run: ->
    executable := await build('string_hash', true)
    first := await execute(executable)
    second := await execute(executable)
    # SipHash-1-3, as Python 3.13 hashes bytes under the zero key with PYTHONHASHSEED=0; the empty
    # bytes, which Python hashes as 0, and the key 0 to 15 by a SipHash in Python that gives these
    # and, with 2 and 4 rounds, the reference's vector of the empty bytes, 726fdb47dd0e0e31.
    known :=
      'd1fba762150c532c'
      '68a914128e01e473'
      '010bac45c41e3669'
      '4d4c9a4a8ef6e0ad'
      '7cc43f98813e4dbd'
      '5abe2169dff36275'
      'e3c25f87624f1cdb'
      '2f098ab0c751325a'
      'ead411e67ebe2eea'
      '75927f9d95124362'
      'af9f77a65ab51a1d'
      'fe64ce8b6617fcff'
      'a6baf4fb0f9fe1c2'
      'a0cf3211850f8e0d'
      '7f86049379fbfe67'
      'f30eb725bb91c9ea'
      '8972188433a5c5b7'
      'd320d86d2a519956'
    own_hash := (outcome: Outcome) ->
      printed := outcome.stdout.split("\n")
      printed.length > known.length then printed[known.length] else ''
    own_hashes := [own_hash(first), own_hash(second)]
    [
      compare_text('stdout', lines([known..., own_hashes[0]]), first.stdout)...
      expect_clean(first)...
      expect_clean(second)...
      reason_if(own_hashes[0] == own_hashes[1], 'two processes hashed "a" alike')...
    ]
  )
  clean_check('the optimized runtime does not count objects', 'leak', true)
  clean_check('a write of more than 2 GiB is done whole', 'write_large', false)
  clean_check('print_error drops its output once stderr has failed', 'print_error_failed', false)
  clean_check(
    'print_error drops its output once a write to stderr has failed'
    'print_error_failed'
    false
    ['FAIL_BY_WRITE']
  )
  # The write is rejected, which no one awaits, so the program reports it and exits with 1.
  Check(name: 'a write to stderr is rejected once print_error has failed', run: ->
    outcome := await build_and_run('print_error_failed', false, ['DROP_BY_WRITE'])
    [
      compare_text('stderr', "cannot write to stderr\n", outcome.stderr)...
      expect_status(1, outcome.status)...
    ]
  )
  Check(name: 'output is written out while every thread of the pool is busy', run: ->
    executable := await build('write_busy_pool', false)
    outcome := await timeout(execute(executable), HANG_SECONDS)
    [
      compare_text('stdout', "flushed\nprinted\n", outcome.stdout)...
      expect_status(0, outcome.status)...
    ]
  )
  Check(name: 'a write to a non-blocking pipe waits while the pipe is full', run: ->
    outcome := await build_and_run('write_non_blocking', false)
    length := outcome.stdout.binary.length
    [
      compare_text('stdout length', '1048576', length.to_string())...
      expect_status(0, outcome.status)...
    ]
  )
  Check(name: 'a read of a non-blocking stdin waits while the pipe is empty', run: ->
    executable := await build('read_non_blocking', false)
    script := '{ sleep 0.3; printf hi; } | "$0"'
    outcome := await timeout(execute('sh', ['-c', script, executable]), HANG_SECONDS)
    expect_status 0, outcome.status
  )
  Check(name: "libuv's uv_spawn leaves a handle that it fails to spawn to uv_close", run: ->
    executable := await build('spawn_fails', false)
    outcome := await timeout(execute(executable), HANG_SECONDS)
    [
      compare_text('stdout', "EINVAL\n2\n0\n", outcome.stdout)...
      expect_status(0, outcome.status)...
    ]
  )
  Check(
    name: 'the writes of Writers stay in the buffer, for stderr too, until it is written out'
    run: ->
      outcome := await build_and_run('interleaved_writes', false, ['EXIT_AT_ONCE'])
      [compare_text('stdout', '', outcome.stdout)..., compare_text('stderr', '', outcome.stderr)...]
  )
  Check(
    name: 'the buffer is written out at exit, to a terminal too, in the order of the writes'
    run: ->
      shown := await run_on_terminal(await build('interleaved_writes', false))
      expected := "first\r\nsecond\r\nthird\r\n"
      reason :=
        "expected the terminal to end with #{encode_json(expected)}, got #{encode_json(shown)}"
      reason_if not shown.ends_with(expected), reason
  )
]

# The number of the checks that failed.
export suite := ->
  title := 'runtime checks'
  selected := select(title, checks) ? return 0
  await set_up_libuv()
  await run_checks(title, selected)
