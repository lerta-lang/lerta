# Run tests: each source is compiled by the compiler (see lib/lerta), for the target that the driver
# gives (see main and lib/target), and run, and its output is compared with <name>.out (stdout),
# <name>.err (stderr: the compile errors or an uncaught throw) and <name>.warn (compile warnings). A
# missing file means empty output. The run must fail exactly when <name>.err exists. A place in a
# standard module that a trace goes through is written without its line and column,
# `(std:builtins/text:XX)`, since any change to std would move them.
# Tests run in parallel, as many at once as the driver says, and are reported in order; each program
# runs in an empty directory of its own, where it may write files. Every test that compiles runs
# twice, without and with optimization, to catch code whose behavior changes when optimized.
#   tests/**/<name>.lerta  expected files next to it; a lib/ directory holds modules that tests
#                          import, which are checked only through those tests
#   examples/<name>.lerta  only .out, in tests/examples/ to keep examples/ clean
#   tests/bin/<name>.lerta commands that tests run, the same on every platform, unlike those of the
#                          system; they are built first and found on PATH
#   tests/cli/             not run tests, but the files of the CLI checks (see cli.lerta)
#   tests/harness/         tests that must fail, run only by the self checks (see self.lerta)
#   tests/**/posix/        tests of what only POSIX systems have, such as signals, which are not
#                          run for Windows
#   tests/**/windows/      tests of what only Windows has, such as drives, which are run only for
#                          Windows
import Buffer, is_dir, is_file, list_dir, make_dir, read_file from 'std:io'
import env, Exit, platform, run from 'std:process'
import compare_output, compare_text, lines from './lib/expect'
import
  build_runtimes, compiler, exit_in_time, OUTPUT_LIMIT, root_dir, run_file, SetupError, suite_dir
from './lib/lerta'
import at_once, Check, jobs, run_checks, select from './lib/report'
import host_target, Target from './lib/target'
import no_wine_prefixes, start_wine_prefixes, WINE_DLL_OVERRIDES from './lib/wine'

# The target that the suite was given.
var target = host_target

work_dir := suite_dir('run')

struct Suite
  source_dir: String
  expected_dir: String
  extensions: String[]

# `label` is shown in failures, such as `examples/hello`. The expected files are read before the
# checks start, so that a check reaches its first wait only in its build (see unoptimized_runs).
struct TestCase
  label: String
  name: String
  suite: Suite
  expected: Map<String, Binary>

EXPECTED_EXTENSIONS := ['out', 'err', 'warn']

EXAMPLES_EXPECTED_DIR := 'tests/examples'
COMMANDS_DIR := 'tests/bin'
CLI_DIR := 'tests/cli'
# Tests that must fail, which only the self checks run (see self_check_dir).
HARNESS_DIR := 'tests/harness'

# `dir` and its subdirectories, relative to the root, except `excluded` and lib/ directories.
directory_tree := (dir: String, excluded: String[]): String[] ->
  subdirs := [
    "#{dir}/#{entry}"
    for entry in list_dir("#{root_dir}/#{dir}")
    when entry != 'lib' and is_dir("#{root_dir}/#{dir}/#{entry}")
  ]
  tree := [dir]
  for path in subdirs
    continue if path in excluded
    tree.append directory_tree(path, excluded)
  tree

# A directory, relative to the root, whose tests run in place of those of tests/ and examples/, so
# that the self checks can see how tests that must fail are reported (see self.lerta).
self_check_dir := env('LERTA_TEST_RUN_DIR')

test_dirs :=
  if dir := self_check_dir
    directory_tree dir, []
  else
    directory_tree 'tests', [EXAMPLES_EXPECTED_DIR, COMMANDS_DIR, CLI_DIR, HARNESS_DIR]

# Examples are living documentation: they must compile and run.
examples := Suite(source_dir: 'examples', expected_dir: EXAMPLES_EXPECTED_DIR, extensions: ['out'])

skipped_dirs := ->
  skipped_kind := target.windows then 'posix' else 'windows'
  [dir for dir in test_dirs when dir.split('/').contains(skipped_kind)]

no_suites: Suite[]

suites := (skipped: String[]) ->
  [
    (
      Suite(source_dir: dir, expected_dir: dir, extensions: EXPECTED_EXTENSIONS)
      for dir in test_dirs
      when dir not in skipped
    )...
    (self_check_dir then no_suites else [examples])...
  ]

names_with_extension := (dir: String, extension: String) ->
  suffix := ".#{extension}"
  [
    file.without_suffix(suffix)!
    for file in list_dir("#{root_dir}/#{dir}")
    when file.ends_with(suffix)
  ]

collect := (suite: Suite) ->
  tests: TestCase[]
  for name in names_with_extension(suite.source_dir, 'lerta')
    expected: Map<String, Binary>
    for extension in suite.extensions
      path := "#{root_dir}/#{suite.expected_dir}/#{name}.#{extension}"
      expected[extension] = await read_file(path) if is_file(path)
    tests.push { name, suite, expected, label: "#{suite.source_dir}/#{name}" }
  tests

# Files in the expected directory that no test would read, such as the expected output of a
# deleted source.
stray_files := (suite: Suite) ->
  sources := names_with_extension(suite.source_dir, 'lerta')
  expected_files: String[]
  for extension in EXPECTED_EXTENSIONS
    for name in names_with_extension(suite.expected_dir, extension)
      if name not in sources or extension not in suite.extensions
        expected_files.push "#{suite.expected_dir}/#{name}.#{extension}"
  misplaced_sources: String[] =
    if suite.expected_dir == suite.source_dir
      []
    else
      [
        "#{suite.expected_dir}/#{name}.lerta"
        for name in names_with_extension(suite.expected_dir, 'lerta')
      ]
  [expected_files..., misplaced_sources...]

struct Outcome
  stdout: Binary
  stderr: Binary
  warnings: String
  # How the program ended, or nil if it did not compile.
  exit: Exit?

# A diagnostic names its place first, as `<file>:<line>:<column>: `; anything else, such as clang's
# messages, is a failure of the build itself. What follows the place, or nil.
after_place := (line: String) ->
  parts := line.split(':')
  # The file's name is not empty, and may hold `:` itself, as C:\dir does.
  for i in 1..(parts.length - 2)
    continue if i == 1 and parts[0].is_empty()
    if is_number(parts[i]) and is_number(parts[i + 1]) and parts[i + 2].starts_with(' ')
      return parts[(i + 2)..].join(':').without_prefix(' ')!
  nil

is_diagnostic := (line: String) -> after_place(line) != nil
is_warning := (line: String) -> after_place(line)?.starts_with('warning: ') ? false

# Diagnostics are reported as the CLI prints them for a bare file name, so that the expected files
# do not depend on where the test directory is.
compile_and_run := (test: TestCase, optimize: Bool) ->
  source_file := "#{test.name}.lerta"
  name := "#{test.label.replace('/', '_')}#{optimize then '_O' else ''}"
  executable := "#{work_dir}/#{name}#{target.executable_suffix}"
  optimize_args: String[] = optimize then ['-O'] else []
  args := ['build', source_file, '-o', executable, optimize_args..., target.args...]
  built := await run_file(compiler, args, "#{root_dir}/#{test.suite.source_dir}")
  diagnostics := [line for line in built.errors.split("\n") when line != '']
  warnings := [line for line in diagnostics when is_warning(line)]
  others := [line for line in diagnostics when not is_warning(line)]
  is_compile_error := built.status == 1 and
    not others.is_empty() and
    others.find((line) -> not is_diagnostic(line)) == nil
  if is_compile_error
    stderr := lines(others).binary
    return Outcome(stderr, stdout: b'', warnings: lines(warnings))
  if built.status != 0 or not others.is_empty()
    throw SetupError("the build failed (#{built.failure}):\n#{built.errors}")
  ran := await run_program(executable)
  { stdout, stderr, exit } := ran
  Outcome stdout, stderr, exit, warnings: lines(warnings)

path_delimiter := platform == 'windows' then ';' else ':'

# The commands of tests/bin are built next to the tested programs, and `run` finds them on PATH: a
# POSIX program on the PATH given here, and a Windows program under Wine on its Windows PATH, to
# which Wine adds WINEPATH (Z: is the root of the Unix file system).
command_env := (prefix: String?) ->
  variables :=
    'PATH': "#{work_dir}#{path_delimiter}#{env('PATH') ? ''}"
    'WINEPATH': "Z:#{work_dir}"
    'WINEDLLOVERRIDES': WINE_DLL_OVERRIDES
  variables['WINEPREFIX'] = prefix if prefix
  variables

# The commands are built at once, after the runtimes, whose cache their builds share.
build_commands := ->
  cwd := "#{root_dir}/#{COMMANDS_DIR}"
  build := (name: String) ->
    executable := "#{work_dir}/#{name}#{target.executable_suffix}"
    args := ['build', "#{name}.lerta", '-o', executable, '-O', target.args...]
    built := await run_file(compiler, args, cwd)
    if built.status != 0
      message := "the build of #{COMMANDS_DIR}/#{name} failed (#{built.failure}):\n#{built.errors}"
      throw SetupError(message)
  await promise for promise in [build(name) for name in names_with_extension(COMMANDS_DIR, 'lerta')]

# The benchmarks (see bench/run.lerta): each source must build without a diagnostic. Each
# benchmark's main.lerta must then run and print its main.out; the other sources, such as the
# runners and the HTTP server, are only built.
BENCH_DIR := 'bench'

bench_check := (dir: String, name: String) ->
  label := "#{dir}/#{name}"
  executable := "#{work_dir}/#{label.replace('/', '_')}#{target.executable_suffix}"
  args := ['build', "#{name}.lerta", '-o', executable, target.args...]
  build_and_run := (): Promise<String[]?> ->
    built := await run_file(compiler, args, "#{root_dir}/#{dir}")
    if built.status != 0 or not built.errors.is_empty()
      return ["the build failed (#{built.failure}):\n#{built.errors}"]
    return [] unless name == 'main'
    expected_path := "#{root_dir}/#{dir}/main.out"
    return ["needs main.out in #{dir}"] unless is_file(expected_path)
    expected := await read_file(expected_path)
    ran := await run_program(executable)
    [
      compare_output('stdout', expected, ran.stdout)...
      compare_output('stderr', b'', ran.stderr)...
      (ran.exit.code == 0 then [] else ["expected the run to succeed, but #{ending(ran.exit)}"])...
    ]
  Check name: label, run: build_and_run

bench_checks := ->
  checks: Check[]
  return checks if self_check_dir
  for dir in directory_tree(BENCH_DIR, [])
    checks.push bench_check(dir, name) for name in names_with_extension(dir, 'lerta')
  checks

# The website (see site/site.lerta): it must be written from docs/ without a diagnostic or a
# warning, and its server must build without one. They run on the host only, as nothing of them
# depends on the target.
site_check := (label: String, args: String[]) ->
  check := (): Promise<String[]?> ->
    ran := await run_file(compiler, args, root_dir)
    return [] if ran.status == 0 and ran.errors.is_empty()
    ["#{label} failed (#{ran.failure}):\n#{ran.errors}"]
  Check name: label, run: check

site_checks := ->
  checks: Check[]
  return checks if self_check_dir or not target.args.is_empty()
  site_dir := "#{work_dir}/site"
  checks.push site_check('site/site.lerta', ['run', 'site/site.lerta', '--', site_dir])
  serve := "#{work_dir}/serve#{host_target.executable_suffix}"
  checks.push site_check('site/serve.lerta', ['build', 'site/serve.lerta', '-o', serve])
  checks

# Wine runs a Windows program in a prefix of its own, when there are such prefixes (see lib/wine).
var wine_prefixes = no_wine_prefixes()

# The longest a program may run, far beyond what any test takes, so that one that does not end
# fails instead of holding up the run; Wine starts a program much more slowly.
run_timeout_seconds := -> target.wine then 180.0 else 60.0

struct ProgramRun
  stdout: Binary
  stderr: Binary
  exit: Exit

var program_runs = 0

# Runs a built program, whose exit status tells whether it failed, in a directory of its own, so
# that files it writes do not meet those of the other runs, with an empty standard input, so that
# one that reads it ends.
run_program := (path: String) ->
  program_runs += 1
  cwd := "#{work_dir}/run-#{program_runs}"
  make_dir cwd
  no_args: String[]
  (file, args) := target.wine then ('wine', [path]) else (path, no_args)
  prefix := wine_prefixes.take()
  try
    output := Buffer(limit: OUTPUT_LIMIT)
    errors := Buffer(limit: OUTPUT_LIMIT)
    ran := run
      file
      args...
      cwd: cwd
      env: command_env(prefix)
      stdin: b''
      stdout: output
      stderr: errors
    exit := await exit_in_time(path, ran, run_timeout_seconds())
    ProgramRun exit, stdout: output.binary, stderr: errors.binary
  finally
    wine_prefixes.give_back prefix if prefix

# A compile error happens before any optimization, so a test that fails to compile without -O is
# not repeated with it: the -O check waits for the unoptimized one.
unoptimized_runs: Map<String, Promise<Outcome>>

run_test := (test: TestCase, optimize: Bool): Promise<String[]?> ->
  expected := test.expected
  pending := compile_and_run(test, optimize)
  unoptimized_runs[test.label] = pending unless optimize
  outcome := await pending
  expects_failure := 'err' in expected
  failed := outcome.exit?.code != 0
  expectation := expects_failure then 'fail' else 'succeed'
  status_reasons: String[] =
    if failed == expects_failure
      []
    else
      ["expected the run to #{expectation}, but #{ending(outcome.exit)}"]
  none := b''
  [
    compare_output('stdout', expected['out'] ? none, outcome.stdout)...
    compare_output('stderr', expected['err'] ? none, without_std_places(outcome.stderr))...
    compare_text('warnings', expected['warn']?.text() ? '', outcome.warnings)...
    status_reasons...
  ]

# How a run that did not end as expected ended, so that a failure shows its cause, as an exit
# code that the output does not explain.
ending := (exit: Exit?) ->
  return 'it did not compile' unless exit
  return "it was ended by signal #{signal}" if signal := exit.signal
  exit.code == 0 then 'it did not' else "it exited with #{exit.code}"

# The output with the line and column of each place in a standard module that a trace goes
# through written as XX (see std_frame).
without_std_places := (output: Binary) ->
  text := output.text() ? return output
  [std_frame(line) for line in text.split("\n")].join("\n").binary

# A line of a trace, `  at Binary.text (std:builtins/text:201:5)`, with `XX` for the line and the
# column of a place in a standard module, which must be numbers, so that a place that is not well
# formed still differs; any other line as it is.
std_frame := (line: String) ->
  return line if not line.starts_with('  at ') or not line.ends_with(')')
  found := line.split_once(' (std:') ? return line
  (head, place) := found
  parts := place.without_suffix(')')!.split(':')
  return line if parts.length != 3 or not [parts[1], parts[2]].all(is_number)
  "#{head} (std:#{parts[0]}:XX)"

is_number := (part: String) -> part.is_digits()

optimized_check := (test: TestCase) ->
  wait := ->
    unoptimized := unoptimized_runs[test.label] ? return
    try
      _outcome := await unoptimized
    catch _
      # The unoptimized check reports the error.
      return
  check := ->
    if unoptimized := unoptimized_runs[test.label]
      return nil if (await unoptimized).exit == nil
    await run_test(test, true)
  Check name: "#{test.label} (-O)", run: check, wait: wait

# The number of the checks that failed, of the programs built for `given`.
export suite := (given: Target) ->
  target = given
  title := 'run tests'
  skipped := skipped_dirs()
  # The bench and site checks, the longest, start first, so that no run ends waiting on one of them.
  all_checks := [bench_checks()..., site_checks()...]
  for group in suites(skipped)
    # A stray file fails the run as a check of its own, so the summary lists it.
    for file in stray_files(group)
      all_checks.push { name: file, run: -> at_once(['stray file: no test reads it']) }
  for group in suites(skipped)
    for test in await collect(group)
      all_checks.push { name: test.label, run: -> await run_test(test, false) }
      all_checks.push optimized_check(test)
  checks := select(title, all_checks) ? return 0
  # Not in work_dir itself, which is on the PATH of the tested programs.
  runtime_dir := "#{work_dir}/runtime"
  make_dir runtime_dir
  await build_runtimes(runtime_dir, [target.args, ['-O', target.args...]])
  await build_commands()
  print "not run for this target: #{dir}" for dir in skipped
  wine_prefixes = await start_wine_prefixes(work_dir, jobs()) if target.wine
  try
    await run_checks(title, checks)
  finally
    await wine_prefixes.stop()
