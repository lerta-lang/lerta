{
  "name": "lerta-test",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc && prettier --check '*.ts' && cspell --no-progress --root .. -c ../cspell.json \"**\"",
    "format": "prettier --write '*.ts'"
  },
  "devDependencies": {
    "@types/node": "^22",
    "cspell": "^10.3.6",
    "prettier": "^3.9.9",
    "typescript": "^5.9"
  },
  "engines": {
    "node": "^22.18 || >=23.6"
  }
}
