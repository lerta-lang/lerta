# An empty TMPDIR counts as unset, so the directory is made in /tmp, not at the root.
empty_temp_dir_check := ->
  check := program_check
    'a built program makes a temporary directory under an empty TMPDIR'
    "#{root_dir}/tests/io/lib/make_temp_dir.lerta"
    b''
    "true\n"
    env: { 'TMPDIR': '' }
  posix_check(check.name, check.run)

argv_check := ->
  program_check(
    'lerta build runs a program with non-ASCII command-line arguments'
    "#{root_dir}/tests/binary/lib/decode_arguments.lerta"
    b''
    "true\ntrue\ntrue\n"
    args: ['hello', 'héllo', '😀']
  )

PRINT_PROGRAM := "#{root_dir}/tests/bin/print_program.lerta"

# `program` is the last name of the path that the program is started by.
program_name_check := ->
  Check(name: 'a built program names itself by the last name of the path that starts it', run: ->
    dir := new_cli_dir('program-name')
    executable := "#{dir}/named#{host_executable_suffix}"
    built := await run_command(compiler, ['build', PRINT_PROGRAM, '-o', executable], dir)
    errors := expect_success('build', built)
    return errors unless errors.is_empty()
    by_path := await run_command(executable, [], dir)
    [
      expect_success('run by path', by_path)...
      compare_text('stdout by path', "named\n", by_path.stdout_text())...
    ]
  )

# `lerta run` names the executable after the source's file name, or `program` for standard input.
run_program_name_check := ->
  Check(name: 'lerta run names the program after its source, or program for standard input', run: ->
    dir := new_cli_dir('run-program-name')
    source := await read_file(PRINT_PROGRAM)
    await write_file("#{dir}/script", source)
    # The name of each run, what it runs, and the name that it prints.
    runs :=
      ('a source', [PRINT_PROGRAM], 'print_program')
      ('a source without .lerta', ['script'], 'script')
      ('standard input', ['-'], 'program')
    var reasons: String[]
    for (what, args, expected) in runs
      ran := await run_command(compiler, ['run', args...], dir, source)
      stdout := compare_text("stdout of #{what}", "#{expected}\n", ran.stdout_text())
      reasons += expect_success("run #{what}", ran) + stdout
    reasons
  )

COMMANDS_USAGE :=
  'usage: tool <command> [<argument>...]'
  ''
  'commands:'
  '  greet  greet someone'
  '  count  count the arguments'
  ''
.join("\n")

GREET_USAGE :=
  'usage: tool greet [options] <name>'
  ''
  'options:'
  '  -l, --loud  greet loudly'
  '  -h, --help  show this help'
  ''
.join("\n")

# parse_command and parse_args print the usage and exit with 0 for `-h`, or with 2 after the error
# for arguments that do not fit.
args_exit_check := ->
  Check(name: 'std:args prints the usage and exits with 0 for -h, or with 2 after an error', run: ->
    dir := new_cli_dir('args-exit')
    executable := "#{dir}/tool#{host_executable_suffix}"
    source := "#{root_dir}/tests/args/lib/tool.lerta"
    built := await run_command(compiler, ['build', source, '-o', executable], dir)
    errors := expect_success('build', built)
    return errors unless errors.is_empty()
    # The arguments of each run, its exit status, and what it prints to stdout and stderr.
    runs :=
      (['greet', '-l', 'bob'], 0, "HELLO, bob!\n", '')
      (['-h'], 0, COMMANDS_USAGE, '')
      (['greet', '--help'], 0, GREET_USAGE, '')
      (['greet', '--nope', 'a', 'b', '-h'], 0, GREET_USAGE, '')
      (['greet', '--', '-h'], 0, "hello, -h\n", '')
      (['greet', '--help=x'], 2, '', "tool: unknown option --help\n#{GREET_USAGE}")
      ([], 2, '', "tool: missing the command\n#{COMMANDS_USAGE}")
      (['nope'], 2, '', "tool: unknown command 'nope'\n#{COMMANDS_USAGE}")
      (['greet'], 2, '', "tool: missing <name>\n#{GREET_USAGE}")
    var reasons: String[]
    for (args, status, stdout, stderr) in runs
      ran := await run_command(executable, args, dir)
      what := "tool #{args.join(' ')}"
      reasons = [
        reasons...
        expect_status(status, ran.status).map((reason) -> "#{what}: #{reason}")...
        compare_text("stdout of #{what}", stdout, ran.stdout_text())...
        compare_text("stderr of #{what}", stderr, ran.stderr_text())...
      ]
    reasons
  )

COLOR_VARIABLES := ['NO_COLOR', 'FORCE_COLOR', 'TERM']

# The variables of `color_variables`, the others of COLOR_VARIABLES unset.
color_env := (color_variables: Map<String, String>) ->
  (color_variables, [name for name in COLOR_VARIABLES when name not in color_variables])

# What tests/io/lib/print_color.lerta prints of each stream, `expected`, with stdout and stderr on
# pipes, given the variables.
color_check := (name: String, color_variables: Map<String, String>, expected: String) ->
  (env, unset_env) := color_env(color_variables)
  program_check(
    name
    "#{root_dir}/tests/io/lib/print_color.lerta"
    b''
    "stdout: #{expected}\n"
    env: env
    unset_env: unset_env
    expected_stderr: "stderr: #{expected}\n"
  )

# The lines that it prints, `expected`, with stdout and stderr on a terminal, which `script` makes,
# but as the shell redirection `redirect` sends them. The terminal ends lines with CRLF, and macOS's
# `script` may show the end of its input first.
terminal_color_check := (
  name: String
  color_variables: Map<String, String>
  expected: String[]
  redirect = ''
) ->
  posix_check(name, ->
    built := await build_program(name, "#{root_dir}/tests/io/lib/print_color.lerta")
    return built.errors unless built.errors.is_empty()
    command := "'#{built.executable}'#{redirect}"
    on_macos := host_platform == 'macos'
    args :=
      on_macos then ['-q', '/dev/null', 'sh', '-c', command] else ['-qec', command, '/dev/null']
    (env, unset_env) := color_env(color_variables)
    ran := await run_command('script', args, built.dir, b'', env, unset_env)
    shown := ran.stdout_text()
    [
      expect_status(0, ran.status)...
      reason_unless(
        expected.all((line) -> "#{line}\r\n" in shown)
        "the terminal shows: #{shown}"
      )...
    ]
  )

# Waits for the file that the program writes.
UNTIL_FILE := 'until_file() { while [ ! -e "$1" ]; do sleep 0.02; done; }'

# Runs the script with the program of tests/process/lib/ as $0, given the seconds that the cleanup
# of `interrupted` waits as $1, and `until_file`; the script ends with how the program ended in $?,
# and the check then prints it, what the program printed to `out` and the first line of `err`.
signal_check := (
  name: String, dir: String, program: String, cleanup_seconds: String, script: String,
  expected: String
) ->
  posix_check(name, ->
    built := await build_program(dir, "#{root_dir}/tests/process/lib/#{program}.lerta")
    return built.errors unless built.errors.is_empty()
    # The directory is kept from an earlier run of the check.
    fresh := 'rm -f ready cleaning out; : >err'
    ran := await run_command(
      'sh'
      [
        '-c'
        "#{UNTIL_FILE}; #{fresh}; #{script}; echo $?; cat out; head -n 1 err"
        built.executable
        cleanup_seconds
      ]
      built.dir
    )
    expect_status(0, ran.status) + compare_text('stdout', expected, ran.stdout_text())
  )

# A shell leaves SIGINT ignored for a program that it runs in the background, and the program is
# run in the foreground instead, by a shell that it replaces, so that $$ names it.
SIGINT_IN_FOREGROUND := "#{UNTIL_FILE}; (until_file ready; kill -INT $$) & exec \"$0\" \"$1\" >out"

# Longer than the first buffer that the runtime reads a value into.
long_value := 'x'.repeat(1000)

export checks :=
  read_lines_check()
  read_parts_check()
  read_empty_check()
  read_much_check()
  read_long_line_check()
  read_bodies_check()
  read_bodies_streaming_check()
  read_errors_check()
  write_much_check()
  write_both_check()
  write_both_order_check()
  write_then_error_check()
  merged_output_order_check()
  wc_check()
  argv_check()
  program_name_check()
  run_program_name_check()
  args_exit_check()
  empty_temp_dir_check()
  invalid_argument_check()
  decode_argument_bytes_check()
  invalid_environment_check()
  closed_stdout_check()
  closed_write_check()
  closed_stderr_check()
  closed_stdio_check()
  broken_pipe_check()
  stdin_redirection_check()
  unawaited_write_check()
  slow_reader_check()
  read_before_exit_check()
  read_then_run_check()
  run_without_stdout_check()
  signal_check(
    'a built program cancels its top-level code on SIGTERM and ends by it'
    'sigterm'
    'interrupted'
    '0'
    '"$0" "$1" >out & until_file ready; kill -TERM $!; wait $!'
    "143\nfinally\ncleaned up\n"
  )
  signal_check(
    'a built program cancels its top-level code on SIGINT and ends by it'
    'sigint'
    'interrupted'
    '0'
    "sh -c '#{SIGINT_IN_FOREGROUND}' \"$0\" \"$1\""
    "130\nfinally\ncleaned up\n"
  )
  signal_check(
    'a built program ends at once on a second signal'
    'second-signal'
    'interrupted'
    '60'
    '"$0" "$1" >out & until_file ready; kill -TERM $!; until_file cleaning; kill -TERM $!; ' +
      'wait $!'
    "143\nfinally\n"
  )
  signal_check(
    'a built program ends by a signal after its top-level code while work is left'
    'signal-after-end'
    'interrupted_after_end'
    '0'
    '"$0" >out & until_file ready; sleep 0.2; kill -TERM $!; wait $!'
    "143\n"
  )
  signal_check(
    'a built program ends by a signal whose CancelledError it takes'
    'caught-signal'
    'interrupted_caught'
    '0'
    '"$0" >out & until_file ready; kill -TERM $!; wait $!'
    "143\ncaught cancelled\nwent on\n"
  )
  signal_check(
    'a built program ends by the error of a cleanup that throws after a signal'
    'failing-cleanup'
    'interrupted_failing'
    '0'
    '"$0" >out 2>err & until_file ready; kill -TERM $!; wait $!'
    "1\ncleanup failed\n"
  )
  signal_check(
    'a built program leaves a signal ignored that its parent ignores'
    'ignored-signal'
    'interrupted'
    '0'
    '(trap "" HUP; exec "$0" "$1" >out) & until_file ready; kill -HUP $!; sleep 0.2; ' +
      'kill -TERM $!; wait $!'
    "143\nfinally\ncleaned up\n"
  )
  environment_check(
    'lerta build runs a program with an unset environment value'
    Map()
    "unset\n"
    ['LERTA_TEST_VALUE']
  )
  environment_check(
    'lerta build runs a program with an empty environment value'
    { 'LERTA_TEST_VALUE': '' }
    "\n"
  )
  environment_check(
    'lerta build runs a program with a non-ASCII environment value'
    { 'LERTA_TEST_VALUE': 'héllo' }
    "héllo\n"
  )
  environment_check(
    'lerta build runs a program with a long environment value'
    { 'LERTA_TEST_VALUE': long_value }
    "#{long_value}\n"
  )
  color_check('a built program writes to pipes without color', Map(), '[false, false]')
  color_check(
    'a built program colors pipes with FORCE_COLOR'
    { 'FORCE_COLOR': '1' }
    '[false, true]'
  )
  color_check(
    'a built program ignores an empty FORCE_COLOR'
    { 'FORCE_COLOR': '' }
    '[false, false]'
  )
  color_check(
    'a built program takes NO_COLOR over FORCE_COLOR'
    { 'NO_COLOR': '1', 'FORCE_COLOR': '1' }
    '[false, false]'
  )
  color_check(
    'a built program ignores an empty NO_COLOR'
    { 'NO_COLOR': '', 'FORCE_COLOR': '1' }
    '[false, true]'
  )
  color_check(
    'a built program takes FORCE_COLOR over TERM=dumb'
    { 'FORCE_COLOR': '1', 'TERM': 'dumb' }
    '[false, true]'
  )
  terminal_color_check(
    'a built program colors a terminal'
    { 'TERM': 'xterm' }
    ['stdout: [true, true]', 'stderr: [true, true]']
  )
  terminal_color_check(
    'a built program does not color a terminal with NO_COLOR'
    { 'NO_COLOR': '1', 'TERM': 'xterm' }
    ['stdout: [true, false]', 'stderr: [true, false]']
  )
  terminal_color_check(
    'a built program does not color a dumb terminal'
    { 'TERM': 'dumb' }
    ['stdout: [true, false]', 'stderr: [true, false]']
  )
  terminal_color_check(
    'a built program colors a terminal with an empty TERM'
    { 'TERM': '' }
    ['stdout: [true, true]', 'stderr: [true, true]']
  )
  terminal_color_check(
    'a built program tells a terminal stdout from a stderr that is not'
    { 'TERM': 'xterm' }
    ['stdout: [true, true]']
    ' 2>/dev/null'
  )
  terminal_color_check(
    'a built program tells a terminal stderr from a stdout that is not'
    { 'TERM': 'xterm' }
    ['stderr: [true, true]']
    ' >/dev/null'
  )
