# Built programs run with the process environment and standard input supplied by the test.
import Check from '../lib/report'
import compare_output, compare_text, expect_status, reason_unless from '../lib/expect'
import compiler, root_dir from '../lib/lerta'
import
  executable_suffix, expect_success, host_platform, new_cli_dir, posix_check, run_command
from '../lib/cli'
import is_file from 'std:io'

struct BuiltProgram
  dir: String
  executable: String
  errors: String[]

build_program := (name: String, source: String) ->
  dir := new_cli_dir("program-#{name}")
  executable := "#{dir}/program#{executable_suffix}"
  built := await run_command(compiler, ['build', source, '-o', executable], dir)
  BuiltProgram dir, executable, errors: expect_success('build', built)

# The message of an uncaught exception, without the trace that follows it; none without a newline.
first_line := (text: String) ->
  (line, _) := text.split_once("\n") ? return ''
  "#{line}\n"

# How program_check runs the program, and what else it expects of it.
struct ProgramOptions
  env: Map<String, String> = default Map()
  args: String[] = default []
  unset_env: String[] = default []
  expected_stderr = default ''

program_check := (
  name: String, source: String, input: Binary, expected: String, options: ProgramOptions
) -> Check(name, run: ->
  built := await build_program(name, source)
  return built.errors if not built.errors.is_empty()
  ran := await run_command(
    built.executable
    options.args
    built.dir
    input
    options.env
    options.unset_env
  )
  [
    expect_status(0, ran.status)...
    compare_output('stdout', expected.binary, ran.stdout)...
    compare_output('stderr', options.expected_stderr.binary, ran.stderr)...
  ]
)

invalid_argument_check := ->
  posix_check 'a built program rejects command-line arguments that are not UTF-8', ->
    source := "#{root_dir}/examples/wc.lerta"
    built := await build_program('invalid-argument', source)
    return built.errors if not built.errors.is_empty()
    ran :=
      await run_command('sh', ['-c', "\"$0\" \"$(printf '\\377')\"", built.executable], built.dir)
    exit_only :=
      await build_program('invalid-argument-exit-only', "#{root_dir}/tests/io/lib/exit_only.lerta")
    return exit_only.errors if not exit_only.errors.is_empty()
    exit_only_ran := await run_command(
      'sh'
      ['-c', "\"$0\" \"$(printf '\\377')\"", exit_only.executable]
      exit_only.dir
    )
    [
      expect_status(1, ran.status)...
      compare_text(
        'stderr'
        "a command-line argument is not valid UTF-8\n"
        first_line(ran.stderr_text())
      )...
      expect_status(1, exit_only_ran.status)...
      compare_text(
        'stderr'
        "a command-line argument is not valid UTF-8\n"
        first_line(exit_only_ran.stderr_text())
      )...
    ]

decode_argument_bytes_check := ->
  posix_check 'a built program decodes command-line arguments at UTF-8 boundaries', ->
    built := await build_program(
      'decode-argument-bytes'
      "#{root_dir}/tests/binary/lib/decode_arguments.lerta"
    )
    return built.errors if not built.errors.is_empty()
    arguments :=
      "\"$(printf '\\177')\""
      "\"$(printf '\\302\\200')\""
      "\"$(printf '\\337\\277')\""
      "\"$(printf '\\340\\240\\200')\""
      "\"$(printf '\\355\\237\\277')\""
      "\"$(printf '\\356\\200\\200')\""
      "\"$(printf '\\360\\220\\200\\200')\""
      "\"$(printf '\\364\\217\\277\\277')\""
      "\"$(printf '\\300\\200')\""
      "\"$(printf '\\301\\277')\""
      "\"$(printf '\\340\\237\\277')\""
      "\"$(printf '\\360\\217\\277\\277')\""
      "\"$(printf '\\355\\240\\200')\""
      "\"$(printf '\\364\\220\\200\\200')\""
      "\"$(printf '\\365\\200\\200\\200')\""
      "\"$(printf '\\342\\202')\""
      "\"$(printf '\\303\\101')\""
      "\"$(printf '\\200')\""
    .join(' ')
    ran := await run_command('sh', ['-c', "\"$0\" #{arguments}", built.executable], built.dir)
    [
      expect_status(0, ran.status)...
      compare_output('stdout', ("true\n".repeat(8) + "false\n".repeat(10)).binary, ran.stdout)...
    ]

invalid_environment_check := ->
  posix_check 'a built program rejects an environment value that is not UTF-8', ->
    source := "#{root_dir}/tests/process/lib/print_env.lerta"
    built := await build_program('invalid-environment', source)
    return built.errors if not built.errors.is_empty()
    script := "LERTA_TEST_VALUE=\"$(printf '\\377')\" \"$0\""
    ran := await run_command('sh', ['-c', script, built.executable], built.dir)
    [
      expect_status(1, ran.status)...
      compare_text(
        'stderr'
        "the environment variable LERTA_TEST_VALUE is not valid UTF-8\n"
        first_line(ran.stderr_text())
      )...
    ]

closed_stdout_check := -> posix_check('a built program reports a failed stdout write', ->
  built := await build_program('closed-stdout', "#{root_dir}/tests/print/lib/print_lost.lerta")
  return built.errors if not built.errors.is_empty()
  ran := await run_command('sh', ['-c', '"$0" >&-', built.executable], built.dir)
  [expect_status(1, ran.status)..., compare_output('stderr', "reported\n".binary, ran.stderr)...]
)

closed_write_check := -> posix_check('a built program reports a rejected stdout write', ->
  built := await build_program('closed-write', "#{root_dir}/tests/io/lib/write_closed.lerta")
  return built.errors if not built.errors.is_empty()
  ran := await run_command('sh', ['-c', '"$0" >&-', built.executable], built.dir)
  [
    expect_status(1, ran.status)...
    compare_output('stderr', "cannot write to stdout\n".repeat(2).binary, ran.stderr)...
  ]
)

closed_stderr_check := ->
  posix_check 'a built program reports a rejected stderr write without failing', ->
    built :=
      await build_program('closed-stderr', "#{root_dir}/tests/io/lib/write_closed_stderr.lerta")
    return built.errors if not built.errors.is_empty()
    ran := await run_command('sh', ['-c', '"$0" 2>&-', built.executable], built.dir)
    [
      expect_status(0, ran.status)...
      compare_output('stdout', "cannot write to stderr\n".binary, ran.stdout)...
    ]

closed_stdio_check := ->
  posix_check 'a built program keeps closed stdout and stderr from being reused', ->
    built := await build_program('closed-stdio', "#{root_dir}/tests/process/lib/closed_stdio.lerta")
    return built.errors if not built.errors.is_empty()
    # An uncaught error ends with 1 too, so the file that the program makes at its end tells them
    # apart, as no output is left to tell them by.
    run_closed := (redirection: String, ended: String) ->
      script := "\"$0\" \"$1\" #{redirection}"
      ran := await run_command('sh', ['-c', script, built.executable, ended], built.dir)
      [
        expect_status(1, ran.status)...
        reason_unless(
          is_file("#{built.dir}/#{ended}")
          "#{redirection}: the program did not end"
        )...
      ]
    [
      await run_closed('>&- 2>&-', 'output-closed')...
      await run_closed('<&- >&- 2>&-', 'all-closed')...
    ]

broken_pipe_check := -> posix_check('a built program ends with SIGPIPE when its reader closes', ->
  built := await build_program('broken-pipe', "#{root_dir}/tests/io/lib/print_many.lerta")
  return built.errors if not built.errors.is_empty()
  script := '{ "$0"; echo $? >&2; } | head -1'
  ran := await run_command('sh', ['-c', script, built.executable], built.dir)
  ignoring :=
    await run_command('sh', ['-c', "trap '' PIPE; #{script}", built.executable], built.dir)
  [
    expect_status(0, ran.status)...
    compare_output('stdout', "y\n".binary, ran.stdout)...
    compare_output('stderr', "141\n".binary, ran.stderr)...
    expect_status(0, ignoring.status)...
    compare_output('stdout', "y\n".binary, ignoring.stdout)...
    compare_output('stderr', "141\n".binary, ignoring.stderr)...
  ]
)

stdin_redirection_check := ->
  posix_check 'a built program reads closed stdin as empty and rejects a directory', ->
    built := await build_program('stdin-redirection', "#{root_dir}/tests/io/lib/read_much.lerta")
    return built.errors if not built.errors.is_empty()
    closed := await run_command('sh', ['-c', '"$0" <&-', built.executable], built.dir)
    directory := await run_command('sh', ['-c', '"$0" < /', built.executable], built.dir)
    [
      expect_status(0, closed.status)...
      compare_output('stdout', "0\n".binary, closed.stdout)...
      expect_status(1, directory.status)...
      compare_text('stderr', "cannot read stdin\n", first_line(directory.stderr_text()))...
    ]

unawaited_write_check := -> posix_check('a built program reports an unawaited rejected write', ->
  built := await build_program('unawaited-write', "#{root_dir}/tests/io/lib/write_unawaited.lerta")
  return built.errors if not built.errors.is_empty()
  ran := await run_command('sh', ['-c', '"$0" >&-', built.executable], built.dir)
  [
    expect_status(1, ran.status)...
    compare_text('stderr', "cannot write to stdout\n", first_line(ran.stderr_text()))...
  ]
)

slow_reader_check := -> posix_check('a built program keeps writing while a slow reader waits', ->
  built := await build_program('slow-reader', "#{root_dir}/tests/io/lib/write_slowly_read.lerta")
  return built.errors if not built.errors.is_empty()
  ran := await run_command(
    'sh'
    ['-c', '"$0" | { sleep 1; cat >/dev/null; }', built.executable]
    built.dir
  )
  [expect_status(0, ran.status)..., compare_output('stderr', "on time\n".binary, ran.stderr)...]
)

read_before_exit_check := ->
  posix_check 'a built program exits after its pending stdin read ends', ->
    built := await build_program('read-before-exit', "#{root_dir}/tests/io/lib/read_one_line.lerta")
    return built.errors if not built.errors.is_empty()
    script := 'start=$(date +%s); "$0"; echo $(( $(date +%s) - start ))'
    pipeline := "{ printf 'a\\n'; sleep 4; } | { #{script}; }"
    ran := await run_command('sh', ['-c', pipeline, built.executable], built.dir)
    lines := ran.stdout_text().split("\n")
    [
      expect_status(0, ran.status)...
      compare_text('first line', 'a', lines[0])...
      reason_unless(['0', '1', '2'].contains(lines[1]), "program took #{lines[1]} seconds")...
    ]

read_then_run_check := -> posix_check('a built program preserves stdin for a process it runs', ->
  built := await build_program('read-then-run', "#{root_dir}/tests/io/lib/read_then_run.lerta")
  return built.errors if not built.errors.is_empty()
  script := "{ printf 'first\\n'; sleep 0.5; printf 'second\\n'; } | \"$0\""
  ran := await run_command('sh', ['-c', script, built.executable], built.dir)
  [
    expect_status(0, ran.status)...
    compare_output('stdout', "first\nsecond\ntrue\n".binary, ran.stdout)...
    compare_output('stderr', ''.binary, ran.stderr)...
  ]
)

run_without_stdout_check := ->
  posix_check 'a built program can run a process when stdout is closed', ->
    built := await build_program(
      'run-without-stdout'
      "#{root_dir}/tests/process/lib/capture_without_stdout.lerta"
    )
    return built.errors if not built.errors.is_empty()
    ran := await run_command('sh', ['-c', '"$0" >&-', built.executable], built.dir)
    [expect_status(0, ran.status)..., compare_output('stderr', "true\n".binary, ran.stderr)...]

read_lines_check := ->
  program_check
    'lerta build runs a program that reads lines without their line endings'
    "#{root_dir}/tests/io/lib/read_lines.lerta"
    "a\r\nb\n\nlast\r".binary
    "[a]\n[b]\n[]\n[last\r]\n"

read_parts_check := ->
  program_check
    'lerta build runs a program that reads parts and the rest of stdin'
    "#{root_dir}/tests/io/lib/read_parts.lerta"
    "3\nabcdef".binary
    "abc\ndef\n0\ntrue\ntrue\n"

read_empty_check := ->
  program_check
    'lerta build runs a program that reads empty stdin'
    "#{root_dir}/tests/io/lib/read_empty.lerta"
    ''.binary
    "true\ntrue\n0\n"

read_much_check := ->
  program_check
    'lerta build runs a program that reads stdin past one chunk'
    "#{root_dir}/tests/io/lib/read_much.lerta"
    'x'.repeat(200000).binary
    "200000\n"

read_long_line_check := ->
  program_check
    'lerta build runs a program that reads a line past one chunk'
    "#{root_dir}/tests/io/lib/read_long_line.lerta"
    ('x'.repeat(100000) + "\nnext\n").binary
    "100000\nnext\n"

read_bodies_check := ->
  program_check
    'lerta build runs a program that reads long and short bodies'
    "#{root_dir}/tests/io/lib/read_bodies.lerta"
    ("100000\n" + 'x'.repeat(100000) + "10\nabcd").binary
    "100000\nthe end came after 4 of 10 bytes\n"

read_bodies_streaming_check := ->
  posix_check 'a built program reads a body that arrives in separate chunks', ->
    built :=
      await build_program('read-bodies-streaming', "#{root_dir}/tests/io/lib/read_bodies.lerta")
    return built.errors if not built.errors.is_empty()
    half := "head -c 50000 /dev/zero | tr '\\0' x"
    input := "printf '100000\\n'; #{half}; sleep 0.3; #{half}; printf '10\\nabcd'"
    script := "{ #{input}; } | \"$0\""
    ran := await run_command('sh', ['-c', script, built.executable], built.dir)
    [
      expect_status(0, ran.status)...
      compare_output('stdout', "100000\nthe end came after 4 of 10 bytes\n".binary, ran.stdout)...
    ]

read_errors_check := ->
  input: Byte[] = [255, 10, 114, 101, 115, 116]
  program_check
    'lerta build runs a program that reports stdin read errors'
    "#{root_dir}/tests/io/lib/read_errors.lerta"
    input.to_binary()
    "read a count of bytes below 1: 0\nread a count of bytes below 1: 0\n" +
      "a Reader is read by another read that has not ended\na line is not valid UTF-8\nrest\n"

write_much_check := ->
  line := '0123456789'.repeat(10) + "\n"
  program_check
    'lerta build writes stdout beyond one buffer'
    "#{root_dir}/tests/io/lib/write_much.lerta"
    ''.binary
    line.repeat(2000) + "end\n"

write_both_check := ->
  program_check
    'lerta build writes to stdout and stderr'
    "#{root_dir}/tests/io/lib/write_both.lerta"
    ''.binary
    "ac\n"
    expected_stderr: 'b'

write_both_order_check := ->
  posix_check 'a built program preserves stdout and stderr write order when combined', ->
    built := await build_program('write-both-order', "#{root_dir}/tests/io/lib/write_both.lerta")
    return built.errors if not built.errors.is_empty()
    ran := await run_command('sh', ['-c', '"$0" 2>&1', built.executable], built.dir)
    [expect_status(0, ran.status)..., compare_output('stdout', "abc\n".binary, ran.stdout)...]

write_then_error_check := ->
  program_check
    'lerta build writes stdout and stderr after buffered output'
    "#{root_dir}/tests/print/lib/write_then_print_error.lerta"
    ''.binary
    "out printed\n"
    expected_stderr: "error\n"

merged_output_order_check := ->
  posix_check 'a built program preserves write order when stdout and stderr are combined', ->
    built := await build_program(
      'merged-output-order'
      "#{root_dir}/tests/print/lib/write_then_print_error.lerta"
    )
    return built.errors if not built.errors.is_empty()
    ran := await run_command('sh', ['-c', '"$0" 2>&1', built.executable], built.dir)
    [
      expect_status(0, ran.status)...
      compare_output('stdout', "out error\nprinted\n".binary, ran.stdout)...
    ]

wc_check := ->
  program_check
    'lerta build runs a program that reads its command-line arguments'
    "#{root_dir}/examples/wc.lerta"
    ''.binary
    "1 3 21 #{root_dir}/examples/hello.lerta\n"
    args: ["#{root_dir}/examples/hello.lerta"]

environment_check := (
  name: String
  env: Map<String, String>
  expected: String
  unset_env: String[] = []
) ->
  program_check
    name
    "#{root_dir}/tests/process/lib/print_env.lerta"
    ''.binary
    expected
    env: env
    unset_env: unset_env

# An empty TMPDIR counts as unset, so the directory is made in /tmp, not at the root.
empty_temp_dir_check := ->
  check := program_check
    'a built program makes a temporary directory under an empty TMPDIR'
    "#{root_dir}/tests/io/lib/make_temp_dir.lerta"
    ''.binary
    "true\n"
    env: { 'TMPDIR': '' }
  posix_check check.name, check.run

argv_check := ->
  program_check
    'lerta build runs a program with non-ASCII command-line arguments'
    "#{root_dir}/tests/binary/lib/decode_arguments.lerta"
    ''.binary
    "true\ntrue\ntrue\n"
    args: ['hello', 'héllo', '😀']

COLOR_VARIABLES := ['NO_COLOR', 'FORCE_COLOR', 'TERM']

# The variables of `color_variables`, the others of COLOR_VARIABLES unset.
color_env := (color_variables: Map<String, String>) ->
  (color_variables, [name for name in COLOR_VARIABLES when name not in color_variables])

# What tests/io/lib/print_color.lerta prints of each stream, `expected`, with stdout and stderr on
# pipes, given the variables.
color_check := (name: String, color_variables: Map<String, String>, expected: String) ->
  (env, unset_env) := color_env(color_variables)
  program_check
    name
    "#{root_dir}/tests/io/lib/print_color.lerta"
    ''.binary
    "stdout: #{expected}\n"
    env: env
    unset_env: unset_env
    expected_stderr: "stderr: #{expected}\n"

# The lines that it prints, `expected`, with stdout and stderr on a terminal, which `script` makes,
# but as the shell redirection `redirect` sends them. The terminal ends lines with CRLF, and macOS's
# `script` may show the end of its input first.
terminal_color_check := (
  name: String
  color_variables: Map<String, String>
  expected: String[]
  redirect = ''
) -> posix_check(name, ->
  built := await build_program(name, "#{root_dir}/tests/io/lib/print_color.lerta")
  return built.errors if not built.errors.is_empty()
  command := "'#{built.executable}'#{redirect}"
  on_macos := host_platform == 'macos'
  args := on_macos then ['-q', '/dev/null', 'sh', '-c', command] else ['-qec', command, '/dev/null']
  (env, unset_env) := color_env(color_variables)
  ran := await run_command('script', args, built.dir, ''.binary, env, unset_env)
  shown := ran.stdout_text()
  [
    expect_status(0, ran.status)...
    reason_unless(expected.all((line) -> "#{line}\r\n" in shown), "the terminal shows: #{shown}")...
  ]
)

# Longer than the first buffer that the runtime reads a value into.
long_value := 'x'.repeat(1000)

export checks :=
  read_lines_check()
  read_parts_check()
  read_empty_check()
  read_much_check()
  read_long_line_check()
  read_bodies_check()
  read_bodies_streaming_check()
  read_errors_check()
  write_much_check()
  write_both_check()
  write_both_order_check()
  write_then_error_check()
  merged_output_order_check()
  wc_check()
  argv_check()
  empty_temp_dir_check()
  invalid_argument_check()
  decode_argument_bytes_check()
  invalid_environment_check()
  closed_stdout_check()
  closed_write_check()
  closed_stderr_check()
  closed_stdio_check()
  broken_pipe_check()
  stdin_redirection_check()
  unawaited_write_check()
  slow_reader_check()
  read_before_exit_check()
  read_then_run_check()
  run_without_stdout_check()
  environment_check(
    'lerta build runs a program with an unset environment value'
    Map()
    "unset\n"
    ['LERTA_TEST_VALUE']
  )
  environment_check(
    'lerta build runs a program with an empty environment value'
    { 'LERTA_TEST_VALUE': '' }
    "\n"
  )
  environment_check(
    'lerta build runs a program with a non-ASCII environment value'
    { 'LERTA_TEST_VALUE': 'héllo' }
    "héllo\n"
  )
  environment_check(
    'lerta build runs a program with a long environment value'
    { 'LERTA_TEST_VALUE': long_value }
    "#{long_value}\n"
  )
  color_check('a built program writes to pipes without color', Map(), '[false, false]')
  color_check(
    'a built program colors pipes with FORCE_COLOR'
    { 'FORCE_COLOR': '1' }
    '[false, true]'
  )
  color_check(
    'a built program ignores an empty FORCE_COLOR'
    { 'FORCE_COLOR': '' }
    '[false, false]'
  )
  color_check(
    'a built program takes NO_COLOR over FORCE_COLOR'
    { 'NO_COLOR': '1', 'FORCE_COLOR': '1' }
    '[false, false]'
  )
  color_check(
    'a built program ignores an empty NO_COLOR'
    { 'NO_COLOR': '', 'FORCE_COLOR': '1' }
    '[false, true]'
  )
  color_check(
    'a built program takes FORCE_COLOR over TERM=dumb'
    { 'FORCE_COLOR': '1', 'TERM': 'dumb' }
    '[false, true]'
  )
  terminal_color_check(
    'a built program colors a terminal'
    { 'TERM': 'xterm' }
    ['stdout: [true, true]', 'stderr: [true, true]']
  )
  terminal_color_check(
    'a built program does not color a terminal with NO_COLOR'
    { 'NO_COLOR': '1', 'TERM': 'xterm' }
    ['stdout: [true, false]', 'stderr: [true, false]']
  )
  terminal_color_check(
    'a built program does not color a dumb terminal'
    { 'TERM': 'dumb' }
    ['stdout: [true, false]', 'stderr: [true, false]']
  )
  terminal_color_check(
    'a built program colors a terminal with an empty TERM'
    { 'TERM': '' }
    ['stdout: [true, true]', 'stderr: [true, true]']
  )
  terminal_color_check(
    'a built program tells a terminal stdout from a stderr that is not'
    { 'TERM': 'xterm' }
    ['stdout: [true, true]']
    ' 2>/dev/null'
  )
  terminal_color_check(
    'a built program tells a terminal stderr from a stdout that is not'
    { 'TERM': 'xterm' }
    ['stderr: [true, true]']
    ' >/dev/null'
  )
