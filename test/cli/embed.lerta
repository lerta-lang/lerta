# `build/build embed` (see tools/build/embed.lerta) writes a module whose embedded_source gives
# each file exactly, whatever its path and contents hold.
import Check, posix_check from '../lib/report'
import compare_output, compare_text, expect_status from '../lib/expect'
import compiler, read_text_or_throw, root_dir, host_executable_suffix from '../lib/lerta'
import expect_success, succeed, new_cli_dir, run_command from '../lib/cli'
import write_file from 'std:io'

# Contents with what a literal escapes or interpolates, and control characters.
CONTENTS := "\#{x} \"quoted\" back\\slash\ttab\r\x01\0end\n"

PROGRAM := """
  import embedded_source, EMBEDDED_PATHS from './embedded'
  import read_file from 'std:io'

  print EMBEDDED_PATHS
  print embedded_source(EMBEDDED_PATHS[0]) == (await read_file(EMBEDDED_PATHS[0])).text()
  """

# Embeds CONTENTS under the path, whose literal EMBEDDED_PATHS prints as `printed`.
embed_round_trip := (dir_name: String, path: String, printed: String) ->
  dir := new_cli_dir(dir_name)
  await write_file("#{dir}/#{path}", CONTENTS)
  await write_file("#{dir}/main.lerta", PROGRAM)
  embedded := await run_command(
    "#{root_dir}/build/build#{host_executable_suffix}"
    ['embed', 'embedded.lerta', path]
    dir
  )
  succeed 'embed', embedded
  executable := "#{dir}/main#{host_executable_suffix}"
  built := await run_command(compiler, ['build', 'main.lerta', '-o', executable], dir)
  succeed 'build', built
  ran := await run_command(executable, [], dir)
  [
    expect_status(0, ran.status)...
    compare_output('stdout', b"[#{printed}]\ntrue\n", ran.stdout)...
  ]

EMPTY_PROGRAM := """
  import embedded_source, EMBEDDED_PATHS from './embedded'

  print EMBEDDED_PATHS
  print embedded_source('main.lerta') == nil
  """

# Embeds no file: the module holds no path, and gives nothing for one.
embed_nothing := ->
  dir := new_cli_dir('embed-nothing')
  await write_file("#{dir}/main.lerta", EMPTY_PROGRAM)
  embedded := await run_command(
    "#{root_dir}/build/build#{host_executable_suffix}"
    ['embed', 'embedded.lerta']
    dir
  )
  succeed 'embed', embedded
  executable := "#{dir}/main#{host_executable_suffix}"
  succeed 'build', await run_command(compiler, ['build', 'main.lerta', '-o', executable], dir)
  ran := await run_command(executable, [], dir)
  [expect_status(0, ran.status)..., compare_output('stdout', b"[]\ntrue\n", ran.stdout)...]

# `lerta license` prints the notices that the compiler carries, each under its path, without the
# repository's files, which a directory of its own does not hold.
license_check := ->
  dir := new_cli_dir('license')
  printed := await run_command(compiler, ['license'], dir)
  paths :=
    'LICENSE-MIT'
    'LICENSE-APACHE'
    'third_party/libuv/LICENSE'
    'third_party/libuv/LICENSE-extra'
  notices := ["== #{path} ==\n#{await read_text_or_throw("#{root_dir}/#{path}")}" for path in paths]
  [
    expect_success('license', printed)...
    compare_text('stdout', notices.join("\n"), printed.stdout_text())...
  ]

export checks: Check[] =
  { name: 'lerta license prints the notices that the compiler carries', run: ->
    await license_check()
  }
  { name: 'embed writes a module of no file', run: -> await embed_nothing() }
  { name: 'embed gives back a file whose path holds a quote', run: ->
    await embed_round_trip('embed-quote', "it's.txt", "\"it's.txt\"")
  }
  # On Windows, `\` separates directories.
  posix_check('embed gives back a file whose path holds a backslash', ->
    await embed_round_trip('embed-backslash', 'back\slash.txt', "'back\\slash.txt'")
  )
