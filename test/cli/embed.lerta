# tools/embed.lerta, which make builds into build/embed, writes a module whose embedded_source gives
# each file exactly, whatever its path and contents hold.
import Check from '../lib/report'
import compare_output, expect_status from '../lib/expect'
import compiler, root_dir from '../lib/lerta'
import host_executable_suffix, succeed, new_cli_dir, posix_check, run_command from '../lib/cli'
import write_file from 'std:io'

# Contents with what a literal escapes or interpolates, and control characters.
CONTENTS := "\#{x} \"quoted\" back\\slash\ttab\r\x01\0end\n"

PROGRAM := """
  import embedded_source, EMBEDDED_PATHS from './embedded'
  import read_file from 'std:io'

  print EMBEDDED_PATHS
  print embedded_source(EMBEDDED_PATHS[0]) == (await read_file(EMBEDDED_PATHS[0])).text()
  """

# Embeds CONTENTS under the path, whose literal EMBEDDED_PATHS prints as `printed`.
embed_round_trip := (dir_name: String, path: String, printed: String) ->
  dir := new_cli_dir(dir_name)
  await write_file("#{dir}/#{path}", CONTENTS.binary)
  await write_file("#{dir}/main.lerta", PROGRAM.binary)
  embedded := await run_command("#{root_dir}/build/embed", ['embedded.lerta', path], dir)
  succeed 'embed', embedded
  executable := "#{dir}/main#{host_executable_suffix}"
  built := await run_command(compiler, ['build', 'main.lerta', '-o', executable], dir)
  succeed 'build', built
  ran := await run_command(executable, [], dir)
  [
    expect_status(0, ran.status)...
    compare_output('stdout', b"[#{printed}]\ntrue\n", ran.stdout)...
  ]

export checks :=
  Check(
    name: 'embed gives back a file whose path holds a quote'
    run: -> await embed_round_trip('embed-quote', "it's.txt", "\"it's.txt\"")
  )
  # On Windows, `\` separates directories.
  posix_check('embed gives back a file whose path holds a backslash', ->
    await embed_round_trip('embed-backslash', 'back\slash.txt', "'back\\slash.txt'")
  )
