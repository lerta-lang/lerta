# The language server completes names: after a dot, in scope, from imports, and keywords.
import Check from '../lib/report'
import compare_text, expect_status from '../lib/expect'
import read_text_or_throw, root_dir from '../lib/lerta'
import new_cli_dir from '../lib/cli'
import write_file from 'std:io'
import decode_json from 'std:json'
import
  uri_of, frame, did_open, did_change, completion_request, session, check_reason, excludes,
  response_body, response_ids
from '../lib/lsp'

struct CompletionItem
  label: String
  kind: Int
  detail: String?

struct CompletionResponse
  id: Int
  result: CompletionItem[]

struct CompletionCase
  here: String
  character: Int
  labels: String[]?
  holds: String[]
  lacks: String[]
  keywords: Bool

no_completion_labels: String[]

completion_items := (output: String, id: Int) ->
  decode_json<CompletionResponse>(response_body(output, id)).result

completion_item_text := (item: CompletionItem) ->
  "#{item.label} #{item.kind} #{item.detail ? 'null'}"

completion_labels := (items: CompletionItem[]) -> [item.label for item in items].join(' ')

completion_items_named := (items: CompletionItem[], label: String) ->
  [completion_item_text(item) for item in items when item.label == label].join(', ')

keyword_from_line := (line: String) ->
  return nil if not line.starts_with("  '") or not line.ends_with("'")
  word := line.split("'")[1]
  return nil if word.is_empty()
  for character in word
    return nil if character < 'a' or character > 'z'
  word

compiler_keywords := ->
  source := await read_text_or_throw("#{root_dir}/compiler/lexer/tokens.lerta")
  keywords: String[]
  for line in source.split("\n")
    keywords.push keyword if keyword := keyword_from_line(line)
  keywords

completion_check := -> Check(name: 'lerta lsp completes members after a dot', run: ->
  dir := new_cli_dir('lsp-completion')
  path := "#{dir}/a.lerta"
  text := "struct Point\n  x: Int\n  y: Int\nf := (p: Point) ->\n  print p.\n  later := 2\n"
  await write_file(path, text.binary)
  uri := uri_of(path)
  messages := [did_open(uri, text), did_change(uri, text), completion_request(uri, 4, 10)].join('')
  ran := await session(dir, messages)
  items := completion_items(ran.stdout.text()!, 1)
  [
    expect_status(0, ran.status)...
    compare_text(
      'completion items'
      "x 5 Int\ny 5 Int\nequals 2 (Point) -> Bool\nhash 2 () -> Int"
      [completion_item_text(item) for item in items].join("\n")
    )...
    compare_text('response order', '0 1 end', response_ids(ran.stdout.text()!).join(' '))...
  ]
)

completion_names_check := ->
  Check name: 'lerta lsp completes locals, module names, and keywords', run: ->
    dir := new_cli_dir('lsp-completion-names')
    path := "#{dir}/a.lerta"
    text := "struct Point\n  x: Int\ntop := 1\nf := (p: Point) ->\n  local := 1\n  print lo\n  later := 2\n"
    await write_file(path, text.binary)
    uri := uri_of(path)
    messages :=
      did_open(uri, text)
      did_change(uri, text)
      completion_request(uri, 5, 10)
    .join('')
    ran := await session(dir, messages)
    output := ran.stdout.text()!
    items := completion_items(output, 1)
    labels := [item.label for item in items when item.kind != 14]
    words := [item.label for item in items when item.kind == 14]
    keywords := await compiler_keywords()
    expected_names := ['local', 'p', 'top', 'Point']
    missing_names := [name for name in expected_names when name not in labels]
    [
      expect_status(0, ran.status)...
      compare_text('keywords', keywords.join(' '), words.join(' '))...
      ["missing completion name #{name}" for name in missing_names]...
      check_reason('later' not in labels, 'completion exposed a local declared after the cursor')...
      compare_text('response order', '0 1 end', response_ids(output).join(' '))...
    ]

completion_enum_check := -> Check(name: 'lerta lsp completes enum members after a dot', run: ->
  dir := new_cli_dir('lsp-completion-enum')
  path := "#{dir}/a.lerta"
  text := "enum Color\n  RED\nf := ->\n  print Color.\n  later := 1\n"
  await write_file(path, text.binary)
  uri := uri_of(path)
  messages := [did_open(uri, text), did_change(uri, text), completion_request(uri, 3, 14)].join('')
  ran := await session(dir, messages)
  output := ran.stdout.text()!
  items := completion_items(output, 1)
  [
    expect_status(0, ran.status)...
    compare_text('completion labels', 'RED parse', completion_labels(items))...
    compare_text('response order', '0 1 end', response_ids(output).join(' '))...
  ]
)

completion_contexts_check := ->
  Check name: 'lerta lsp completes methods, optional members, and members of @', run: ->
    dir := new_cli_dir('lsp-completion-contexts')
    path := "#{dir}/a.lerta"
    point_text :=
      "struct Point\n  x: Int\n  y: Int\nf := (p: Point) ->\n  print p.eq()\n  later := 1\n"
    optional_text :=
      "struct Point\n  x: Int\n  y: Int\nf := (q: Point?) ->\n  print q?.\n  later := 1\n"
    counter_text := "class Counter\n  count = 0\n  bump = ->\n    @count += 1\n    print @co\n"
    bare_at_text := "class Counter\n  count = 0\n  bump = ->\n    @count += 1\n    print @\n"
    parameter_text := (here: String) ->
      "struct Point\n  x: Int\n  y: Int\np := 3\nf := (p: Point, q: Point?) ->\n#{here}\n"
    await write_file(path, point_text.binary)
    uri := uri_of(path)
    messages :=
      did_open(uri, point_text)
      did_change(uri, point_text)
      completion_request(uri, 4, 11, 1)
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
      )
      did_change(uri, optional_text)
      completion_request(uri, 4, 11, 2)
      did_change(uri, counter_text)
      completion_request(uri, 4, 13, 3)
      did_change(uri, bare_at_text)
      completion_request(uri, 4, 11, 5)
      did_change(uri, parameter_text('  print p'))
      completion_request(uri, 5, 9, 6)
      completion_request(uri, 40, 0, 7)
      did_change(uri, parameter_text('  print [i for i in 0...p]'))
      completion_request(uri, 5, 24, 8)
    .join('')
    ran := await session(dir, messages)
    output := ran.stdout.text()!
    name_labels := (id: Int) ->
      [item.label for item in completion_items(output, id) when item.kind != 14]
    parameters := [
      "#{item.label} #{item.detail ? 'null'}"
      for item in completion_items(output, 6)
      when item.label == 'p'
    ]
    [
      expect_status(0, ran.status)...
      compare_text(
        'completion labels'
        'x y equals hash|x y equals hash|count bump equals hash'
        [
          completion_labels(completion_items(output, 1))
          completion_labels(completion_items(output, 2))
          completion_labels(completion_items(output, 3))
        ].join(
          '|'
        )
      )...
      compare_text(
        'formatting response'
        '{"jsonrpc":"2.0","id":4,"result":[]}'
        response_body(output, 4)
      )...
      compare_text(
        '@ alone'
        'count bump equals hash'
        completion_labels(completion_items(output, 5))
      )...
      compare_text('local over a top-level name', 'p Point', parameters.join(' '))...
      compare_text('past the end', '', name_labels(7).join(' '))...
      compare_text('after a range', 'p q', [name_labels(8)[i] for i in 0...2].join(' '))...
      compare_text('response order', '0 1 4 2 3 5 6 7 8 end', response_ids(output).join(' '))...
      excludes(output, '__lerta_completion__', 'completion changed the open document')...
    ]

completion_imports_check := ->
  Check name: 'lerta lsp completes imported values and standard-library functions', run: ->
    dir := new_cli_dir('lsp-completion-imports')
    path := "#{dir}/a.lerta"
    text := "import helper, Pair as Couple from './lib'\nimport sqrt from 'std:math'\nprint := (n: Int) -> n\nx := he\nlater := 1\ng := -> later\n"
    await write_file(path, ''.binary)
    await write_file(
      "#{dir}/lib.lerta"
      "export helper := -> 1\nexport struct Pair\n  a: Int\n".binary
    )
    uri := uri_of(path)
    messages :=
      did_open(uri, text)
      did_change(uri, text)
      completion_request(uri, 3, 12)
    .join('')
    ran := await session(dir, messages)
    output := ran.stdout.text()!
    items := completion_items(output, 1)
    [
      expect_status(0, ran.status)...
      compare_text('helper', 'helper 3 () -> Int', completion_items_named(items, 'helper'))...
      compare_text('imported alias', 'Couple 22 null', completion_items_named(items, 'Couple'))...
      compare_text('unimported name', '', completion_items_named(items, 'Pair'))...
      compare_text('sqrt', 'sqrt 3 (Float) -> Float', completion_items_named(items, 'sqrt'))...
      compare_text('panic', 'panic 3 (String) -> never', completion_items_named(items, 'panic'))...
      compare_text(
        'shadowing builtin'
        'print 3 (Int) -> Int'
        completion_items_named(items, 'print')
      )...
      compare_text('later name', '', completion_items_named(items, 'later'))...
      compare_text('response order', '0 1 end', response_ids(output).join(' '))...
    ]

completion_reexports_check := ->
  Check name: 'lerta lsp completes the names that a module exports from another', run: ->
    dir := new_cli_dir('lsp-completion-reexports')
    path := "#{dir}/a.lerta"
    text := "import './facade' as f\nx := f.h\n"
    await write_file(path, ''.binary)
    await write_file("#{dir}/lib.lerta", "export helper := -> 1\n".binary)
    await write_file("#{dir}/facade.lerta", "export helper as h from './lib'\n".binary)
    uri := uri_of(path)
    messages :=
      did_open(uri, text)
      did_change(uri, text)
      completion_request(uri, 1, 13)
    .join('')
    ran := await session(dir, messages)
    items := completion_items(ran.stdout.text()!, 1)
    [
      expect_status(0, ran.status)...
      compare_text('exported from another', 'h 3 () -> Int', completion_items_named(items, 'h'))...
      compare_text('name in its module', '', completion_items_named(items, 'helper'))...
    ]

completion_coverage_check := ->
  Check name: 'lerta lsp completes the same member and name contexts as the CLI reference', run: ->
    completion_text := (here: String) ->
      [
        "import './m' as m"
        'struct Point'
        '  x: Int'
        '  y: Int'
        'struct Named'
        '  m: Int'
        '  Color: Int'
        'class Counter'
        '  count = 0'
        '  bump = -> @count += 1'
        '  same = <T>(v: T) -> v'
        'interface Shape'
        '  area: () -> Int'
        '  name: String'
        'enum Color'
        '  RED'
        'extend Point'
        '  sum = -> @x + @y'
        '_hidden := 1'
        'total := 1'
        'f := (p: Point, shape: Shape, r: { a: Int }, c: Counter, count: Int, n: Named) ->'
        '  local := 1'
        '  if true'
        "    local := 'shadowing'"
        here
        '  later := 2'
        '  print local'
        ''
      ].join(
        "\n"
      )
    cases: CompletionCase[] =
      {
        here: '    print p.'
        character: 12
        labels: ['x', 'y', 'equals', 'hash', 'sum']
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      }
      {
        here: '    print p.x'
        character: 12
        labels: ['x', 'y', 'equals', 'hash', 'sum']
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      }
      {
        here: '    print c.'
        character: 12
        labels: nil
        holds: ['count', 'bump', 'same']
        lacks: no_completion_labels
        keywords: false
      }
      {
        here: '    print shape.'
        character: 16
        labels: ['area', 'name']
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      }
      {
        here: '    print r.'
        character: 12
        labels: nil
        holds: ['a']
        lacks: no_completion_labels
        keywords: false
      }
      {
        here: '    print Color.'
        character: 16
        labels: ['RED', 'parse']
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      }
      {
        here: '    print m.'
        character: 12
        labels: ['helper', 'Shade']
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      }
      {
        here: '    print [1].'
        character: 14
        labels: nil
        holds: ['length', 'push', 'pop', 'first', 'contains']
        lacks: no_completion_labels
        keywords: false
      }
      {
        here: '    print lo'
        character: 12
        labels: nil
        holds: [
          '_hidden', 'local', 'p', 'count', 'total', 'f', 'Point', 'Counter', 'Color', 'm', 'print',
          'min'
        ]
        lacks: ['later', '__lerta_completion__', 'Point.sum', 'Shape', 'Stringable']
        keywords: true
      }
      {
        here: "    print '😀' + tot"
        character: 20
        labels: nil
        holds: ['total']
        lacks: no_completion_labels
        keywords: true
      }
      {
        here: "    print tot + 'é'"
        character: 13
        labels: nil
        holds: ['total']
        lacks: no_completion_labels
        keywords: true
      }
      {
        here: '    print m.Shade.'
        character: 18
        labels: ['DARK', 'parse']
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      }
      {
        here: '    print n.m.'
        character: 14
        labels: nil
        holds: ['to_string', 'compare']
        lacks: ['helper']
        keywords: false
      }
      {
        here: '    print n.Color.'
        character: 18
        labels: nil
        holds: ['to_string']
        lacks: ['RED']
        keywords: false
      }
      {
        here: '    print 1 # m.'
        character: 16
        labels: no_completion_labels
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      }
      {
        here: '    # tot', character: 9, labels: no_completion_labels, holds: no_completion_labels,
        lacks: no_completion_labels, keywords: false
      }
    dir := new_cli_dir('lsp-completion-coverage')
    path := "#{dir}/a.lerta"
    await write_file(path, ''.binary)
    await write_file(
      "#{dir}/m.lerta"
      "export helper := -> 1\nexport enum Shade\n  DARK\nprivate_one := 2\n".binary
    )
    uri := uri_of(path)
    other := uri_of("#{dir}/other.lerta")
    messages := [did_open(uri, completion_text('    print local'))]
    for each, i in cases
      messages.push did_change(uri, completion_text(each.here))
      messages.push completion_request(uri, 24, each.character, 10 + i)
    messages.push did_change(uri, completion_text('    print  lo'))
    messages.push completion_request(uri, 24, 13, 97)
    messages.push
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":98,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
      )
    messages.push completion_request(other, 0, 0, 99)
    ran := await session(dir, messages.join(''))
    output := ran.stdout.text()!
    keywords := await compiler_keywords()
    reasons: String[]
    for each, i in cases
      items := completion_items(output, 10 + i)
      words := [item for item in items when item.kind == 14]
      expected_words: String[] = each.keywords then keywords else []
      actual_keyword_text := [completion_item_text(item) for item in words].join("\n")
      expected_keyword_text := ["#{word} 14 null" for word in expected_words].join("\n")
      if actual_keyword_text != expected_keyword_text
        reasons.push "unexpected keywords for #{each.here}"
      labels := [item.label for item in items when item.kind != 14]
      if expected := each.labels
        if expected.join(' ') != labels.join(' ')
          reasons.push "unexpected completion labels for #{each.here}: #{labels.join(' ')}"
      for label in each.holds
        reasons.push "missing completion #{label} for #{each.here}" if label not in labels
      for label in each.lacks
        reasons.push "unexpected completion #{label} for #{each.here}" if label in labels
      seen: String[]
      for label in labels
        if label in seen
          reasons.push "duplicate completion label #{label} for #{each.here}"
        else
          seen.push label
    member_items := completion_items(output, 10)
    expected_member_items := "x 5 Int\nequals 2 (Point) -> Bool\nsum 2 null"
    named_items := completion_items(output, 18)
    expected_named_items :=
      "local 6 String\nf 3 null\nPoint 22 null\nCounter 7 null\nColor 13 null\nconst 14 null"
    expected_ids := ['0', ["#{10 + i}" for i in 0...cases.length]..., '97', '98', '99', 'end']
    formatting_response := response_body(output, 98)
    preserved :=
      'print lo\n' in formatting_response and '__lerta_completion__' not in formatting_response
    [
      expect_status(0, ran.status)...
      reasons...
      compare_text(
        'member item kinds and types'
        expected_member_items
        [
          completion_items_named(member_items, 'x')
          completion_items_named(member_items, 'equals')
          completion_items_named(member_items, 'sum')
        ].join(
          "\n"
        )
      )...
      compare_text(
        'completion item kinds and types'
        expected_named_items
        [
          completion_items_named(named_items, 'local')
          completion_items_named(named_items, 'f')
          completion_items_named(named_items, 'Point')
          completion_items_named(named_items, 'Counter')
          completion_items_named(named_items, 'Color')
          completion_items_named(named_items, 'const')
        ].join(
          "\n"
        )
      )...
      compare_text('response order', expected_ids.join(' '), response_ids(output).join(' '))...
      compare_text(
        'completion of an unopened document'
        '{"jsonrpc":"2.0","id":99,"result":[]}'
        response_body(output, 99)
      )...
      check_reason(preserved, "formatting after completion returned #{formatting_response}")...
      excludes(output, '__lerta_completion__', 'the probe name in published diagnostics')...
    ]

export checks :=
  completion_check()
  completion_names_check()
  completion_enum_check()
  completion_contexts_check()
  completion_imports_check()
  completion_reexports_check()
  completion_coverage_check()
