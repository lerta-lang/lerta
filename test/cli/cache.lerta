# Runtime caches are isolated, complete, reused, and selected from the documented environment.
import LTO_CACHE, lto_link_flags from '../../compiler/clang_flags'
import Check from '../lib/report'
import compare_text, expect_status from '../lib/expect'
import compiler, host_systems, read_text_or_throw, root_dir from '../lib/lerta'
import
  CliRun, cli_work_dir, executable_suffix, expect_left, expect_success, host_platform, host_triple,
  new_cli_dir, new_cli_dirs, run_command, run_in_dir, run_in_new_dir
from '../lib/cli'
import is_dir, list_dir, make_dir, remove_tree, stat, write_file from 'std:io'
import process_id from 'std:process'

hello := "#{root_dir}/examples/hello.lerta"

check_reason := (condition: Bool, reason: String): String[] -> condition then [] else [reason]

# A path as the compiler prints it, which joins its parts with one `/` where the work directory,
# under a TMPDIR that ends in `/`, has two.
printed_path := (path: String) -> path.split('//').join('/')

# What a cache holds but the linker's ThinLTO cache, which only optimized builds have.
runtimes_in := (cache: String) -> [entry for entry in list_dir(cache) when entry != LTO_CACHE]

is_hex_digit := (character: Char) -> character.is_digit() or ('A' <= character and character <= 'F')

runtime_name_reasons := (name: String, kind: String) ->
  prefix := "runtime-#{kind}-#{host_triple}-clang"
  suffix := name.without_prefix(prefix) ? return [
    "the cached runtime #{name} does not start with #{prefix}"
  ]
  parts := suffix.split('-')
  return ["the cached runtime #{name} has no clang version and hash"] if parts.length != 2
  version := parts[0]
  hash := parts[1]
  [
    check_reason(
      not version.is_empty() and
        [character for character in version].all((character) -> character.is_digit())
      "the cached runtime #{name} has an invalid clang version"
    )...
    check_reason(
      hash.binary.length == 8 and [character for character in hash].all(is_hex_digit)
      "the cached runtime #{name} has an invalid hash"
    )...
  ]

runtime_file_names := ->
  # platform_<systems>.c is only for those systems.
  is_for_host := (name: String) -> host_systems.contains(name.without_prefix('platform_') ? 'all')
  names := [file.without_suffix('.c') for file in list_dir("#{root_dir}/runtime")]
  runtime := ["#{name}.o" for name in names when name and is_for_host(name)]
  libuv_text := await read_text_or_throw("#{root_dir}/third_party/libuv.txt")
  libuv: String[]
  for line in libuv_text.split("\n")
    continue if line.is_empty() or line.starts_with('#')
    fields := line.split(' ')
    continue if fields.length != 3 or not host_systems.contains(fields[0])
    continue if fields[1] != 'source' or not fields[2].ends_with('.c')
    libuv.push "libuv-#{fields[2].without_suffix('.c')!.split('/').join('-')}.o"
  [runtime..., libuv..., 'function_attributes.txt', 'coro_end_type.txt'].sorted((a, b) ->
    a.compare b
  )

thinlto_entries := (cache: String): String[] ->
  directory := "#{cache}/#{LTO_CACHE}"
  return [] if not is_dir(directory)
  entries: String[]
  for entry in list_dir(directory)
    continue if entry == 'llvmcache.timestamp'
    path := "#{directory}/#{entry}"
    details := stat(path) ? throw ValueError("no ThinLTO cache entry: #{path}")
    entries.push "#{entry} #{details.modified_time.to_fixed(9)}"
  entries.sorted (a, b) -> a.compare(b)

build_in_cache := (cache: String, flags: String[]) ->
  env: Map<String, String>
  env['LERTA_CACHE_DIR'] = cache
  await run_in_new_dir(compiler, ['build', hello, '-o', 'hello', flags...], ''.binary, env)

complete_runtime := (cache: String, name: String) ->
  dir := "#{cache}/#{name}"
  expected_files := await runtime_file_names()
  files := list_dir(dir)
  file_reasons := expect_left("the files of #{name}", expected_files, files)
  return file_reasons if not file_reasons.is_empty()
  attributes := await read_text_or_throw("#{dir}/function_attributes.txt")
  coro_end_type := await read_text_or_throw("#{dir}/coro_end_type.txt")
  [
    check_reason(
      '"target-cpu"=' in attributes
      "no target-cpu in function_attributes.txt: #{attributes}"
    )...
    check_reason(
      ['i1', 'void'].contains(coro_end_type)
      "not a type in coro_end_type.txt: #{coro_end_type}"
    )...
  ]

# The ID of a process that has ended, which the system is unlikely to give another so soon.
ended_process_id := ->
  dir := new_cli_dir("ended-process-#{next_ended_process}")
  next_ended_process += 1
  program := "#{dir}/pid.lerta"
  await write_file(program, "import process_id from 'std:process'\nprint process_id\n".binary)
  ran := await run_command(compiler, ['run', program], dir)
  if ran.status != 0
    throw ValueError("the program could not report its process id: #{ran.stderr.text()!}")
  ran.stdout.text()!.split("\n")[0]

var next_ended_process = 0

# The name of the runtime that a build with no flags caches, which only such a build tells, as the
# shared cache also holds a debug runtime for `--target <host>`; one build finds it for every check.
var plain_runtime_name: Promise<String>?

find_plain_runtime_name := ->
  cache := new_cli_dir('cache-plain')
  built := await build_in_cache(cache, [])
  reasons := expect_success('build', built.result)
  throw ValueError(reasons[0]) if not reasons.is_empty()
  entries := runtimes_in(cache)
  throw ValueError("expected one cached runtime, found: #{entries}") if entries.length != 1
  entries[0]

debug_runtime_name := ->
  plain_runtime_name = find_plain_runtime_name() if plain_runtime_name == nil
  await plain_runtime_name!

cached_runtime_check := (flags: String[], kind: String) ->
  Check name: "lerta build #{flags.join(' ')} caches and reuses the #{kind} runtime", run: ->
    cache := new_cli_dir("cache-#{kind}")
    first := await build_in_cache(cache, flags)
    reasons := expect_success('build', first.result)
    return reasons if not reasons.is_empty()
    entries := runtimes_in(cache)
    return ["expected one cached runtime in #{cache}, found: #{entries}"] if entries.length != 1
    name := entries[0]
    name_reasons := runtime_name_reasons(name, kind)
    return name_reasons if not name_reasons.is_empty()
    incomplete := await complete_runtime(cache, name)
    return incomplete if not incomplete.is_empty()
    optimized := thinlto_entries(cache)
    if (kind != 'debug') != (not optimized.is_empty())
      return ["#{flags.join(' ')} left the ThinLTO cache with: #{optimized}"]
    object := "#{cache}/#{name}/allocator.o"
    written := stat(object) ? throw ValueError("no cached object: #{object}")
    second := await build_in_cache(cache, flags)
    [
      expect_success('second build', second.result)...
      check_reason(
        stat(object)!.modified_time == written.modified_time
        'the second build recompiled the runtime'
      )...
      check_reason(
        thinlto_entries(cache).join("\n") == optimized.join("\n")
        'the second build optimized again'
      )...
      check_reason(runtimes_in(cache).length == 1, 'the second build changed the cache')...
    ]

incomplete_runtime_check := (flags: String[], kind: String) ->
  Check name: "lerta build reports an incomplete cached #{kind} runtime", run: ->
    cache := new_cli_dir("cache-incomplete-#{kind}")
    first := await build_in_cache(cache, flags)
    reasons := expect_success('build', first.result)
    return reasons if not reasons.is_empty()
    entries := runtimes_in(cache)
    return ["expected one cached runtime in #{cache}, found: #{entries}"] if entries.length != 1
    dir := printed_path("#{cache}/#{entries[0]}")
    await remove_tree("#{dir}/function_attributes.txt")
    second := await build_in_cache(cache, flags)
    [
      expect_status(1, second.result.status)...
      compare_text(
        'stderr'
        "the cached runtime #{dir} is incomplete: remove it\n"
        second.result.stderr.text()!
      )...
    ]

invalid_target_check := ->
  Check name: 'lerta build rejects unsupported and path-like runtime targets', run: ->
    beside_cache := new_cli_dir('cache-invalid-path')
    path_target := await build_in_cache("#{beside_cache}/inner", ['--target', '../outside'])
    windows_path_cache := new_cli_dir('cache-invalid-windows-path')
    windows_path := await build_in_cache(windows_path_cache, ['--target', '..\outside'])
    unsupported_cache := new_cli_dir('cache-unsupported')
    unsupported := await build_in_cache(unsupported_cache, ['--target', 'x86_64-unknown-freebsd'])
    [
      expect_status(1, path_target.result.status)...
      compare_text('stderr', "not a target: ../outside\n", path_target.result.stderr.text()!)...
      expect_status(1, windows_path.result.status)...
      compare_text('stderr', "not a target: ..\\outside\n", windows_path.result.stderr.text()!)...
      expect_status(1, unsupported.result.status)...
      compare_text(
        'stderr'
        "not a target that the runtime is built for: x86_64-unknown-freebsd\n"
        unsupported.result.stderr.text()!
      )...
      expect_left('files beside the cache', [], list_dir(beside_cache))...
      check_reason(
        runtimes_in(windows_path_cache).is_empty()
        'invalid target created a runtime cache'
      )...
      expect_left('files left in the cache', [], list_dir(unsupported_cache))...
    ]

host_target_check := ->
  Check name: 'lerta build caches a runtime named for the host target', run: ->
    cache := new_cli_dir('cache-host-target')
    ran := await build_in_cache(cache, ['--target', host_triple])
    reasons := expect_success('build', ran.result)
    return reasons if not reasons.is_empty()
    entries := runtimes_in(cache)
    return ["expected one cached runtime in #{cache}, found: #{entries}"] if entries.length != 1
    name := entries[0]
    [runtime_name_reasons(name, 'debug')..., await complete_runtime(cache, name)...]

cache_location_check := ->
  Check name: 'lerta build uses XDG_CACHE_HOME and then HOME for its runtime cache', run: ->
    return nil if host_platform == 'windows'
    xdg := new_cli_dir('cache-xdg-home')
    xdg_env: Map<String, String>
    xdg_env['LERTA_CACHE_DIR'] = ''
    xdg_env['XDG_CACHE_HOME'] = xdg
    xdg_build := await run_in_new_dir(compiler, ['build', hello, '-o', 'hello'], ''.binary, xdg_env)
    home := new_cli_dir('cache-home')
    home_env: Map<String, String>
    home_env['XDG_CACHE_HOME'] = ''
    home_env['HOME'] = home
    home_build := await run_in_new_dir(
      compiler
      ['build', hello, '-o', 'hello']
      ''.binary
      home_env
      ['LERTA_CACHE_DIR']
    )
    [
      await one_cached_runtime('XDG cache build', xdg_build.result, "#{xdg}/lerta", 'debug')...
      await one_cached_runtime(
        'HOME cache build'
        home_build.result
        "#{home}/.cache/lerta"
        'debug'
      )...
    ]

one_cached_runtime := (what: String, built: CliRun, cache: String, kind: String) ->
  reasons := expect_success(what, built)
  return reasons if not reasons.is_empty()
  no_entries: String[]
  entries := is_dir(cache) then runtimes_in(cache) else no_entries
  return ["expected one cached runtime in #{cache}, found: #{entries}"] if entries.length != 1
  [runtime_name_reasons(entries[0], kind)..., await complete_runtime(cache, entries[0])...]

# The link runs in the build's temporary directory, so a cache given by a path relative to the
# directory the build runs in must still be the one the linker writes its ThinLTO cache into, and
# what it optimized must be found again by a build in another temporary directory.
relative_cache_check := ->
  Check name: 'lerta build -O takes a cache directory given by a relative path', run: ->
    (cwd, temp) := new_cli_dirs()
    env: Map<String, String>
    env['LERTA_CACHE_DIR'] = 'cache'
    build_in := (in_temp: String) ->
      await run_in_dir(
        compiler
        ['build', hello, '-o', 'hello', '-O']
        cwd
        in_temp
        ''.binary
        env
      )
    first := await build_in(temp)
    cache := "#{cwd}/cache"
    reasons := [
      await one_cached_runtime('build', first.result, cache, 'release')...
      expect_left('files left', ['cache', "hello#{executable_suffix}"], first.left)...
      expect_left('files left in the temporary directory', [], first.left_in_temp)...
    ]
    return reasons if not reasons.is_empty()
    optimized := thinlto_entries(cache)
    second := await build_in(new_cli_dir('cache-relative-temp'))
    [
      expect_success('second build', second.result)...
      check_reason(not optimized.is_empty(), "no ThinLTO cache in #{cache}")...
      check_reason(
        thinlto_entries(cache).join("\n") == optimized.join("\n")
        'the build in another temporary directory optimized again'
      )...
    ]

no_cache_location_check := ->
  Check name: 'lerta build reports when no cache location is available', run: ->
    cwd := new_cli_dir('cache-no-location')
    ran := await run_command(
      compiler
      ['build', hello, '-o', 'hello']
      cwd
      ''.binary
      Map<String, String>()
      ['HOME', 'XDG_CACHE_HOME', 'LOCALAPPDATA', 'LERTA_CACHE_DIR']
    )
    [
      expect_status(1, ran.status)...
      compare_text(
        'stderr'
        "no cache directory: set #{host_platform == 'windows' then 'LOCALAPPDATA' else 'HOME'} " +
          "or LERTA_CACHE_DIR\n"
        ran.stderr.text()!
      )...
    ]

cache_creation_failure_check := ->
  Check name: 'lerta build reports when its cache directory cannot be made', run: ->
    file := "#{new_cli_dir('cache-blocker')}/file"
    await write_file(file, ''.binary)
    blocked := "#{file}/cache"
    flags: String[]
    ran := await build_in_cache(blocked, flags)
    [
      expect_status(1, ran.result.status)...
      compare_text(
        'stderr'
        "cannot make the cache directory: #{blocked}\n"
        ran.result.stderr.text()!
      )...
    ]

concurrent_builds_check := ->
  Check name: 'lerta builds started together leave one complete runtime in the cache', run: ->
    cache := new_cli_dir('cache-concurrent')
    env: Map<String, String>
    env['LERTA_CACHE_DIR'] = cache
    builds := [
      run_in_new_dir(
        compiler
        ['build', hello, '-o', "#{cli_work_dir}/concurrent-#{i}"]
        ''.binary
        env
      )
      for i in 0...4
    ]
    results := [await build for build in builds]
    for ran in results
      return expect_success('build', ran.result) if ran.result.status != 0
    entries := runtimes_in(cache)
    return ["expected one cached runtime in #{cache}, found: #{entries}"] if entries.length != 1
    [runtime_name_reasons(entries[0], 'debug')..., await complete_runtime(cache, entries[0])...]

empty_runtime_directory_check := ->
  Check name: 'lerta build fills an empty directory named for the runtime', run: ->
    cache := new_cli_dir('cache-empty-runtime')
    name := await debug_runtime_name()
    make_dir "#{cache}/#{name}"
    built := await build_in_cache(cache, [])
    reasons := expect_success('build', built.result)
    return reasons if not reasons.is_empty()
    await complete_runtime(cache, name)

occupied_runtime_directory_check := ->
  Check name: 'lerta build reports a runtime cache directory with other files', run: ->
    cache := new_cli_dir('cache-occupied-runtime')
    name := await debug_runtime_name()
    dir := printed_path("#{cache}/#{name}")
    make_dir dir
    await write_file("#{dir}/other", ''.binary)
    built := await build_in_cache(cache, [])
    [
      expect_status(1, built.result.status)...
      compare_text(
        'stderr'
        "cannot move the compiled runtime into the cache: #{dir}\n"
        built.result.stderr.text()!
      )...
    ]

abandoned_staging_check := ->
  Check name: 'lerta build removes staging directories of killed builds', run: ->
    cache := new_cli_dir('cache-abandoned-staging')
    name := await debug_runtime_name()
    staging := (suffix: String) -> "#{name}.staging-#{suffix}"
    stale_id := await ended_process_id()
    kept :=
      staging("#{process_id}-lerta-running")
      staging('lerta-other')
      staging("-#{stale_id}-lerta-other")
      "other.staging-#{stale_id}-lerta-other"
    for entry in [staging("#{stale_id}-lerta-killed"), kept...]
      make_dir "#{cache}/#{entry}"
      await write_file("#{cache}/#{entry}/array.o", ''.binary)
    file := staging("#{stale_id}-file")
    await write_file("#{cache}/#{file}", ''.binary)
    built := await build_in_cache(cache, [])
    reasons := expect_success('build', built.result)
    return reasons if not reasons.is_empty()
    expected := [name, kept...].sorted((a, b) -> a.compare(b))
    [
      await complete_runtime(cache, name)...
      expect_left('cache contents', expected, list_dir(cache))...
    ]

unremovable_staging_check := ->
  Check name: 'lerta build continues when a stale staging directory cannot be removed', run: ->
    return nil if host_platform == 'windows'
    uid := await run_command('id', ['-u'], cli_work_dir)
    return ["id -u failed: #{uid.stderr.text()!}"] if uid.status != 0
    return nil if uid.stdout.text()!.split("\n")[0] == '0'
    cache := new_cli_dir('cache-unremovable-staging')
    name := await debug_runtime_name()
    staging := "#{cache}/#{name}.staging-#{await ended_process_id()}-lerta-killed"
    locked := "#{staging}/locked"
    make_dir staging
    make_dir locked
    await write_file("#{locked}/array.o", ''.binary)
    restricted := await run_command('chmod', ['500', locked], cli_work_dir)
    return ["chmod failed: #{restricted.stderr.text()!}"] if restricted.status != 0
    built :=
      try
        await build_in_cache(cache, [])
      finally
        restored := await run_command('chmod', ['700', locked], cli_work_dir)
        if restored.status != 0
          throw ValueError("chmod could not restore #{locked}: #{restored.stderr.text()!}")
    reasons := expect_success('build', built.result)
    return reasons if not reasons.is_empty()
    [
      check_reason(is_dir(locked), 'the unremovable staging directory was removed')...
      await complete_runtime(cache, name)...
    ]

# The link of an optimized build gives each linker the limit of LLVM's devirtualization, as that
# linker takes an option of LLVM's, and the cache is named after it, as docs/reference/compiler.md
# gives it.
lto_link_flags_check := ->
  Check name: 'the link gives each linker the devirtualization limit', run: ->
    expected :=
      { system: 'macos', flag: '-Wl,-mllvm,-max-devirt-iterations=8' }
      { system: 'windows', flag: '-Wl,-mllvm,-max-devirt-iterations=8' }
      { system: 'linux', flag: '-Wl,-plugin-opt=-max-devirt-iterations=8' }
    missing := [e.system for e in expected when e.flag not in lto_link_flags(e.system, 'cache')]
    reasons := ["no #{system} flag for the limit" for system in missing]
    reasons.push "the ThinLTO cache is #{LTO_CACHE}" if LTO_CACHE != 'thinlto-devirt-8'
    reasons

export checks :=
  lto_link_flags_check()
  cached_runtime_check([], 'debug')
  cached_runtime_check(['-O'], 'release')
  cached_runtime_check(['-O', '--memory-checks'], 'release-checked')
  incomplete_runtime_check([], 'debug')
  incomplete_runtime_check(['-O'], 'release')
  invalid_target_check()
  host_target_check()
  cache_location_check()
  relative_cache_check()
  no_cache_location_check()
  cache_creation_failure_check()
  concurrent_builds_check()
  empty_runtime_directory_check()
  occupied_runtime_directory_check()
  abandoned_staging_check()
  unremovable_staging_check()
