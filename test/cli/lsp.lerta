type_name_check := ->
  Check name: 'lerta lsp gives type names their types and declarations', run: ->
    dir := new_cli_dir('lsp-type-names')
    path := "#{dir}/a.lerta"
    other := "#{dir}/b.lerta"
    await write_file(path, b'')
    await write_file(other, b"export enum Hue\n  WARM\nexport struct Far\n  n: Int\n")
    uri := uri_of(path)
    text :=
      "import './b' as m"
      'struct Point'
      '  x: Int'
      'enum Color'
      '  RED'
      'interface Shape'
      '  area: () -> Int'
      'type Spot = Point'
      'struct Box<T>'
      '  item: T'
      'f := (p: Point, s: Shape, c: Color): Spot -> p'
      'g := <T: Shape>(t: T, b: Box<Int>, n: Int, far: m.Far) -> 1'
      'print Color.RED'
      'print m.Hue.WARM'
      'h := <U>(u: U) ->'
      '  b: Box<U> = { item: u }'
      '  b'
      'print h(1)'
      "print h('a')"
      ''
    .join("\n")
    messages :=
      did_open(uri, text)
      definition_request(uri, 10, 9, 1)
      definition_request(uri, 10, 19, 2)
      definition_request(uri, 10, 29, 3)
      definition_request(uri, 10, 37, 4)
      definition_request(uri, 12, 6, 5)
      definition_request(uri, 11, 9, 6)
      definition_request(uri, 11, 25, 7)
      definition_request(uri, 11, 50, 8)
      definition_request(uri, 13, 8, 9)
      hover_request(uri, 10, 9, 10)
      hover_request(uri, 12, 6, 11)
      hover_request(uri, 10, 37, 12)
      hover_request(uri, 10, 19, 13)
      hover_request(uri, 11, 38, 14)
      hover_request(uri, 11, 48, 15)
      hover_request(uri, 15, 5, 16)
      hover_request(uri, 11, 19, 17)
    .join()
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout_text()
        [
          location_fragment(1, uri, 1, 7, 12)
          location_fragment(2, uri, 5, 10, 15)
          location_fragment(3, uri, 3, 5, 10)
          location_fragment(4, uri, 7, 5, 9)
          location_fragment(5, uri, 3, 5, 10)
          location_fragment(6, uri, 5, 10, 15)
          location_fragment(7, uri, 8, 7, 10)
          location_fragment(8, uri_of(other), 2, 14, 17)
          location_fragment(9, uri_of(other), 0, 12, 15)
          hover_fragment(10, 'Point: Point')
          hover_fragment(11, 'Color: Color')
          hover_fragment(12, 'Spot: Point')
          hover_fragment(13, 'Shape: Shape')
          '"id":14,"result":null'
          hover_fragment(15, 'm.Far: Far')
          hover_fragment(16, "Box: Box<Int>\nBox: Box<String>")
          '"id":17,"result":null'
        ]
      )...
    ]

partial_block_check := ->
  Check name: 'lerta lsp checks the statements of a block that parse', run: ->
    dir := new_cli_dir('lsp-partial-block')
    path := "#{dir}/a.lerta"
    await write_file(path, b'')
    uri := uri_of(path)
    text :=
      'f := (n: Int) ->'
      '  y := +'
      '  z := n + 1'
      '  if z > 0'
      '    w := *'
      '    print z'
      '  z'
      'print f(1)'
      'g := (n: Int) ->'
      '  if n > 0'
      '    x := *'
      '  else'
      '    1'
      'h := [1].map((x) ->'
      '  y := +'
      '  x'
      ')'
      'print h'
      'k := ->'
      '  x := await +'
      '  1'
      'm := (n: Int) ->'
      '  if +'
      '    print 1'
      '  n'
      'print k()'
      'print m(1)'
      'print g(1)'
      'p := ->'
      '  x := yield +'
      '  1'
      'q := ->'
      '  yield 1'
      '  x := yield +'
      'print p()'
      'print q()'
      ''
    .join("\n")
    messages :=
      did_open(uri, text)
      hover_request(uri, 6, 2, 1)
      definition_request(uri, 6, 2, 2)
      hover_request(uri, 7, 6, 3)
      hover_request(uri, 15, 2, 4)
      hover_request(uri, 17, 6, 5)
      hover_request(uri, 25, 6, 6)
      hover_request(uri, 26, 6, 7)
      hover_request(uri, 27, 6, 8)
      hover_request(uri, 34, 6, 9)
      hover_request(uri, 35, 6, 10)
    .join()
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_messages(
        ran.stdout_text()
        [
          published_diagnostics(
            uri
            [
              diagnostic_body(1, 7, 1, "expected expression, found '+'")
              diagnostic_body(4, 9, 1, "expected expression, found '*'")
              diagnostic_body(10, 9, 1, "expected expression, found '*'")
              diagnostic_body(14, 7, 1, "expected expression, found '+'")
              diagnostic_body(19, 13, 1, "expected expression, found '+'")
              diagnostic_body(22, 5, 1, "expected expression, found '+'")
              diagnostic_body(29, 13, 1, "expected expression, found '+'")
              diagnostic_body(33, 13, 1, "expected expression, found '+'")
            ]
          )
          "{\"jsonrpc\":\"2.0\",#{hover_fragment(1, 'z: Int')}}"
          "{\"jsonrpc\":\"2.0\",#{location_fragment(2, uri, 2, 2, 3)}}"
          "{\"jsonrpc\":\"2.0\",#{hover_fragment(3, 'f: (Int) -> Int')}}"
          "{\"jsonrpc\":\"2.0\",#{hover_fragment(4, 'x: Int')}}"
          "{\"jsonrpc\":\"2.0\",#{hover_fragment(5, 'h: Iter<Int>')}}"
          "{\"jsonrpc\":\"2.0\",#{hover_fragment(6, 'k: () -> Int')}}"
          "{\"jsonrpc\":\"2.0\",#{hover_fragment(7, 'm: (Int) -> Int')}}"
          '{"jsonrpc":"2.0","id":8,"result":null}'
          "{\"jsonrpc\":\"2.0\",#{hover_fragment(9, 'p: () -> Int')}}"
          "{\"jsonrpc\":\"2.0\",#{hover_fragment(10, 'q: () -> Iter<Int>')}}"
        ]
      )...
    ]

partial_import_check := ->
  Check
    name: 'lerta lsp checks an imported file that does not parse, and keeps the errors of loading'
    run: ->
      dir := new_cli_dir('lsp-partial-import')
      lib := "#{dir}/lib.lerta"
      path := "#{dir}/a.lerta"
      other := "#{dir}/c.lerta"
      await write_file(lib, b"unused := 1\nexport a := 2\nexport b := +\n")
      await write_file(path, b'')
      await write_file(other, b'')
      uri := uri_of(path)
      messages :=
        did_open(uri, "import a from './lib'\nprint a\nkept := 3\n")
        did_open(uri_of(other), "x := +\nimport y from './nowhere'\n")
        hover_request(uri, 1, 6, 1)
      .join()
      ran := await session(dir, messages)
      [
        expect_status(0, ran.status)...
        exact_messages(
          ran.stdout_text()
          [
            published_diagnostics(uri, [diagnostic_body(2, 0, 2, "'kept' is never used")])
            published_diagnostics(
              uri_of(lib)
              [diagnostic_body(2, 12, 1, "expected expression, found '+'")]
            )
            published_diagnostics(
              uri_of(other)
              [
                diagnostic_body(1, 0, 1, "cannot find module './nowhere'")
                diagnostic_body(0, 5, 1, "expected expression, found '+'")
              ]
            )
            "{\"jsonrpc\":\"2.0\",#{hover_fragment(1, 'a: Int')}}"
          ]
        )...
      ]

imported_syntax_error_check := ->
  Check
    name: 'lerta lsp finds no declaration that an imported text no longer writes, nor a program ' +
      'never loaded'
    run: ->
      dir := new_cli_dir('lsp-imported-syntax-error')
      lib := "#{dir}/lib.lerta"
      path := "#{dir}/a.lerta"
      other := "#{dir}/b.lerta"
      await write_file(lib, b'')
      await write_file(path, b'')
      await write_file(other, b'')
      uri := uri_of(path)
      messages :=
        did_open(uri, "import value from './lib'\nprint value\n")
        did_open(uri_of(lib), "export value := 1\n")
        did_change(uri_of(lib), "\nexport value := 'a\n")
        definition_request(uri, 1, 6, 1)
        hover_request(uri, 1, 6, 2)
        did_open(uri_of(other), "print 1\nx := 'a\n")
        hover_request(uri_of(other), 0, 0, 3)
      .join()
      ran := await session(dir, messages)
      [
        expect_status(0, ran.status)...
        exact_responses(
          ran.stdout_text()
          ['"id":1,"result":null', hover_fragment(2, 'value: Int'), '"id":3,"result":null']
        )...
      ]

imported_hover_definition_check := ->
  Check(
    name: 'lerta lsp gives imported, field, and generic values their types and definitions'
    run: ->
      dir := new_cli_dir('lsp-imported-hover-definition')
      lib := "#{dir}/lib.lerta"
      path := "#{dir}/a.lerta"
      text := "import make from './lib'\np := make(1)\nprint p.x\nid := <T>(v: T) -> v\n" +
        "print id(1) + id(2)\nprint id('a')\n"
      lib_text :=
        "export struct Point\n  x: Int\n  y: Int\n" + "export make := (x: Int) -> Point(x, y: 0)\n"
      await write_file(lib, lib_text)
      await write_file(path, b'')
      uri := uri_of(path)
      asks := [(1, 5), (2, 8), (3, 19), (4, 6), (5, 6), (0, 7), (1, 2)]
      messages := [did_open(uri, text)]
      for ask at i in asks
        (line, character) := ask
        messages.push hover_request(uri, line, character, 10 + 2 * i)
        messages.push definition_request(uri, line, character, 11 + 2 * i)
      ran := await session(dir, messages.join())
      [
        expect_status(0, ran.status)...
        exact_responses(
          ran.stdout_text()
          [
            hover_fragment(10, 'make: (Int) -> Point')
            location_fragment(11, uri_of(lib), 3, 7, 11)
            hover_fragment(12, 'x: Int')
            location_fragment(13, uri_of(lib), 1, 2, 3)
            hover_fragment(14, "v: T\nv: Int\nv: String")
            location_fragment(15, uri, 3, 10, 11)
            hover_fragment(16, 'id: (Int) -> Int')
            location_fragment(17, uri, 3, 0, 2)
            hover_fragment(18, 'id: (String) -> String')
            location_fragment(19, uri, 3, 0, 2)
            '"id":20,"result":null'
            location_fragment(21, uri_of(lib), 3, 7, 11)
            '"id":22,"result":null'
            '"id":23,"result":null'
          ]
        )...
      ]
  )

doc_comment_check := ->
  Check name: 'lerta lsp gives the doc comments of a declaration with its types', run: ->
    dir := new_cli_dir('lsp-doc-comments')
    path := "#{dir}/a.lerta"
    text :=
      "import shade from './lib'"
      '## A place.'
      '# A note.'
      '##'
      '## Kept apart.'
      'struct Point'
      '  x: Int  ## Across.'
      '  ## Up.'
      '  y: Int'
      '## Not for its parameter.'
      'g := (n: Int) -> n'
      '### Banner'
      'h := ('
      '  ## Taken.'
      '  m: Int'
      ') -> m'
      '## Lost by the blank line.'
      ''
      'var total = 0  ## The sum.'
      'if total == 0'
      '  print total'
      '  ## Ends the block.'
      "q := '\u{E9}'.count()  ## Counted."
      '## The text of a Float.'
      'extern lerta_float_to_string as text_of: (Float) -> String'
      'p := Point(x: 1, y: 2)'
      'print p.x + p.y + g(1) + h(2) + total + q'
      'print text_of(1.0) + shade'
      '##x'
      'export count := 0'
      'class Counter'
      '  ## Adds one.'
      '  # How: in place.'
      '  bump := -> 1  # Not a doc comment.'
      'Counter().bump()'
      'print count'
      ''
    .join("\n")
    await write_file(path, b'')
    await write_file("#{dir}/lib.lerta", b"## A shade of gray.\nexport shade := 'gray'\n")
    uri := uri_of(path)
    asks :=
      (26, 8)
      (26, 14)
      (26, 18)
      (10, 17)
      (26, 25)
      (15, 5)
      (26, 32)
      (26, 40)
      (25, 5)
      (27, 6)
      (0, 7)
      (27, 21)
      (35, 6)
      (34, 10)
    messages := [did_open(uri, text)]
    for ask at i in asks
      (line, character) := ask
      messages.push hover_request(uri, line, character, i + 1)
    ran := await session(dir, messages.join())
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout_text()
        [
          hover_fragment(1, 'x: Int', 'Across.')
          hover_fragment(2, 'y: Int', 'Up.')
          hover_fragment(3, 'g: (Int) -> Int', 'Not for its parameter.')
          hover_fragment(4, 'n: Int')
          hover_fragment(5, 'h: (Int) -> Int')
          hover_fragment(6, 'm: Int', 'Taken.')
          hover_fragment(7, 'total: Int', 'The sum.')
          hover_fragment(8, 'q: Int', 'Counted.')
          hover_fragment(9, 'Point: Point', "A place.\n\nKept apart.")
          hover_fragment(10, 'text_of: (Float) -> String', 'The text of a Float.')
          doc_fragment(11, 'A shade of gray.')
          hover_fragment(12, 'shade: String', 'A shade of gray.')
          hover_fragment(13, 'count: Int')
          hover_fragment(14, 'bump: () -> Int', 'Adds one.')
        ]
      )...
    ]

extern_definition_check := ->
  Check name: 'lerta lsp finds extern definitions in the current and imported modules', run: ->
    dir := new_cli_dir('lsp-extern-definition')
    path := "#{dir}/a.lerta"
    text := "import float_text, float_text as t from './conversions'\n" +
      "extern lerta_float_to_string as text_of: (Float) -> String\nprint text_of(1.0)\n" +
      "print float_text(2.0)\nprint t(3.0)\n"
    await write_file(path, b'')
    await write_file(
      "#{dir}/conversions.lerta"
      b"export extern lerta_float_to_string as float_text: (Float) -> String\n"
    )
    uri := uri_of(path)
    messages :=
      did_open(uri, text)
      definition_request(uri, 2, 6, 1)
      definition_request(uri, 3, 6, 2)
      definition_request(uri, 0, 7, 3)
      definition_request(uri, 4, 6, 4)
      definition_request(uri, 0, 34, 5)
    .join()
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout_text()
        [
          location_fragment(1, uri, 1, 32, 39)
          location_fragment(2, uri_of("#{dir}/conversions.lerta"), 0, 39, 49)
          location_fragment(3, uri_of("#{dir}/conversions.lerta"), 0, 39, 49)
          location_fragment(4, uri_of("#{dir}/conversions.lerta"), 0, 39, 49)
          location_fragment(5, uri_of("#{dir}/conversions.lerta"), 0, 39, 49)
        ]
      )...
    ]

reexport_definition_check := ->
  Check name: 'lerta lsp finds the declarations of names that modules export from others', run: ->
    dir := new_cli_dir('lsp-reexport-definition')
    path := "#{dir}/a.lerta"
    shapes := "#{dir}/shapes.lerta"
    text := "import n from './facade'\nexport norm as m from './shapes'\nprint n(1)\n"
    await write_file(path, b'')
    await write_file(shapes, b"export norm := (x: Int) -> x\n")
    await write_file("#{dir}/facade.lerta", b"export norm as n from './shapes'\n")
    uri := uri_of(path)
    messages :=
      did_open(uri, text)
      definition_request(uri, 0, 7, 1)
      definition_request(uri, 1, 8, 2)
      definition_request(uri, 1, 16, 3)
      definition_request(uri, 2, 6, 4)
    .join()
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout_text()
        [
          location_fragment(1, uri_of(shapes), 0, 7, 11)
          location_fragment(2, uri_of(shapes), 0, 7, 11)
          location_fragment(3, uri_of(shapes), 0, 7, 11)
          location_fragment(4, uri_of(shapes), 0, 7, 11)
        ]
      )...
    ]

export checks :=
  initialize_check()
  error_request_check()
  diagnostic_check()
  diagnostic_lifecycle_check()
  imported_diagnostic_check()
  uri_import_check()
  uri_host_check()
  malformed_message_check()
  lowercase_header_check()
  lsp_input_errors_check()
  empty_body_check()
  formatting_check()
  formatting_new_document_check()
  shared_import_check()
  changed_import_check()
  close_unsaved_import_check()
  hover_definition_check()
  alias_hover_check()
  generic_hover_check()
  generic_callee_check()
  definition_contexts_check()
  hover_contexts_check()
  optional_and_interpolation_check()
  open_import_hover_check()
  definitions_after_error_check()
  syntax_error_check()
  imported_syntax_error_check()
  partial_parse_check()
  partial_import_check()
  partial_block_check()
  type_name_check()
  imported_hover_definition_check()
  doc_comment_check()
  extern_definition_check()
