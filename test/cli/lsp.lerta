# The language server speaks JSON-RPC messages framed by their UTF-8 byte length.
import Check from '../lib/report'
import compare_text from '../lib/expect'
import compiler, root_dir from '../lib/lerta'
import cli_work_dir, expect_status, host_platform, new_cli_dir, run_command from '../lib/cli'
import make_dir, read_file, real_path, write_file from 'std:io'
import decode_json, encode_json from 'std:json'

const real_work_dir =
  host_platform == 'windows' then cli_work_dir else real_path(cli_work_dir).text()!

struct CompletionItem(label: String, kind: Int, detail: String?)

struct CompletionResponse(id: Int, result: CompletionItem[])

struct ResponseHeader(id: Int | String)

struct CompletionCase
  here: String
  character: Int
  labels: String[]?
  holds: String[]
  lacks: String[]
  keywords: Bool

const no_completion_labels: String[] = []

const unreserved_marks = [mark for mark in '-._~/:'.binary]

const uri_of = (path: String) ->
  const in_work_dir = path.without_prefix(cli_work_dir)
  const canonical_path = in_work_dir != nil then "#{real_work_dir}#{in_work_dir}" else path
  const portable = canonical_path.split('\').join('/')
  const hexadecimal = '0123456789ABCDEF'.binary
  const bytes: Byte[] = []
  for byte in portable.binary
    if byte.is_letter() or byte.is_digit() or unreserved_marks.contains(byte)
      bytes.push byte
    else
      bytes.push '%'
      bytes.push hexadecimal[byte.to_int() >> 4]
      bytes.push hexadecimal[byte.to_int() & 0xF]
  const prefix = host_platform == 'windows' then 'file:///' else 'file://'
  "#{prefix}#{bytes.to_binary().text()!}"

const frame = (json: String) -> "Content-Length: #{json.binary.length}\r\n\r\n#{json}"

const did_open = (uri: String, text: String) ->
  frame(
    "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":#{encode_json(text)}}}}"
  )

const did_change = (uri: String, text: String) -> did_change_at(uri, text, 2)

const did_change_at = (uri: String, text: String, version: Int) ->
  frame(
    "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"version\":#{version}},\"contentChanges\":[{\"text\":#{encode_json(text)}}]}}"
  )

const completion_request = (uri: String, line: Int, character: Int, id = 1) ->
  frame(
    "{\"jsonrpc\":\"2.0\",\"id\":#{id},\"method\":\"textDocument/completion\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":#{line},\"character\":#{character}}}}"
  )

const definition_request = (uri: String, line: Int, character: Int, id: Int) ->
  frame(
    "{\"jsonrpc\":\"2.0\",\"id\":#{id},\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":#{line},\"character\":#{character}}}}"
  )

const hover_request = (uri: String, line: Int, character: Int, id: Int) ->
  frame(
    "{\"jsonrpc\":\"2.0\",\"id\":#{id},\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":#{line},\"character\":#{character}}}}"
  )

const location_fragment = (id: Int, uri: String, line: Int, start: Int, end: Int) ->
  "\"id\":#{id},\"result\":{\"uri\":\"#{uri}\",\"range\":{\"start\":{\"line\":#{line},\"character\":#{start}},\"end\":{\"line\":#{line},\"character\":#{end}}}}"

const hover_fragment = (id: Int, text: String) ->
  "\"id\":#{id},\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":#{encode_json("```lerta\n#{text}\n```")}}}"

const initialize = '{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"capabilities":{}}}'
const finish =
  frame('{"jsonrpc":"2.0","id":"end","method":"shutdown"}')
  frame('{"jsonrpc":"2.0","method":"exit"}')
.join('')

const session_with_initialize = (dir: String, init: String, messages: String) ->
  const input = frame(init) + messages + finish
  await run_command(compiler, ['lsp'], dir, input.binary)

const session = (dir: String, messages: String) ->
  await session_with_initialize(dir, initialize, messages)

const contains_reasons = (output: String, expected: String[]) ->
  ["missing #{token}" for token in expected when not output.contains(token)]

const check_reason = (condition: Bool, reason: String): String[] -> condition then [] else [reason]

const excludes = (output: String, token: String, reason: String): String[] ->
  output.contains(token) then [reason] else []

const message_bodies = (output: String) ->
  const parts = output.split("\r\n\r\n")
  const messages: String[] = []
  var header = parts[0]
  for section in 1...parts.length
    const length_text = header.without_prefix('Content-Length:') ? throw ValueError(
      message: "an LSP response without its Content-Length: #{header}"
    )
    const length = length_text.trim().parse_int() ? throw ValueError(
      message: "an LSP response with an invalid length: #{header}"
    )
    const chunk = parts[section].binary
    const body = chunk.slice(0, length).text()!
    messages.push body
    header = chunk.slice(length, chunk.length).text()!
  messages

const response_bodies = (output: String) ->
  [body for body in message_bodies(output) when body.starts_with('{"jsonrpc":"2.0","id":')]

const response_body = (output: String, id: Int) ->
  const prefix = "{\"jsonrpc\":\"2.0\",\"id\":#{id},"
  response_bodies(output).find((each) -> each.starts_with(prefix)) ? throw ValueError(
    message: "no response with id #{id}"
  )

const response_ids = (output: String) ->
  ["#{decode_json<ResponseHeader>(body).id}" for body in response_bodies(output)]

const diagnostic_body = (line: Int, character: Int, severity: Int, message: String) ->
  const position = "{\"line\":#{line},\"character\":#{character}}"
  "{\"range\":{\"start\":#{position},\"end\":#{position}},\"severity\":#{severity},\"source\":\"lerta\",\"message\":#{encode_json(message)}}"

const published_diagnostics = (uri: String, diagnostics: String[]) ->
  "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":#{encode_json(uri)},\"diagnostics\":[#{diagnostics.join(',')}]}}"

const completion_items = (output: String, id: Int) ->
  decode_json<CompletionResponse>(response_body(output, id)).result

const completion_item_text = (item: CompletionItem) ->
  "#{item.label} #{item.kind} #{item.detail ? 'null'}"

const completion_labels = (items: CompletionItem[]) -> [item.label for item in items].join(' ')

const completion_items_named = (items: CompletionItem[], label: String) ->
  [completion_item_text(item) for item in items when item.label == label].join(', ')

const keyword_from_line = (line: String) ->
  return nil if not line.starts_with("  '") or not line.ends_with("'")
  const word = line.split("'")[1]
  return nil if word == ''
  for character in word
    return nil if character < 'a' or character > 'z'
  word

const compiler_keywords = ->
  const source = (await read_file("#{root_dir}/compiler/lexer/tokens.lerta")).text()!
  const keywords: String[] = []
  for line in source.split("\n")
    keywords.push keyword if const keyword = keyword_from_line(line)
  keywords

const initialize_response = (encoding: String) ->
  "{\"jsonrpc\":\"2.0\",\"id\":0,\"result\":{\"capabilities\":{\"positionEncoding\":\"#{encoding}\",\"textDocumentSync\":1,\"documentFormattingProvider\":true,\"hoverProvider\":true,\"definitionProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]}},\"serverInfo\":{\"name\":\"lerta\"}}}"

const shutdown_response = '{"jsonrpc":"2.0","id":"end","result":null}'

const response_from_fragment = (fragment: String) -> "{\"jsonrpc\":\"2.0\",#{fragment}}"

const exact_responses = (output: String, fragments: String[]) ->
  const expected = [initialize_response('utf-16')]
  expected.append [response_from_fragment(fragment) for fragment in fragments]
  expected.push shutdown_response
  compare_text 'responses', expected.join("\n"), response_bodies(output).join("\n")

const exact_messages = (output: String, messages: String[]) ->
  const expected = [initialize_response('utf-16'), messages..., shutdown_response]
  compare_text 'messages', expected.join("\n"), message_bodies(output).join("\n")

const initialize_check = ->
  Check name: 'lerta lsp negotiates UTF-16 positions and exits after shutdown', run: ->
    const dir = new_cli_dir('lsp-initialize')
    const ran = await session(dir, '')
    const utf32_init = '{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"capabilities":{"general":{"positionEncodings":["utf-16","utf-32"]}}}}'
    const utf32_dir = new_cli_dir('lsp-utf32-no-shutdown')
    const utf32 = await run_command(
      compiler
      ['lsp']
      utf32_dir
      (frame(utf32_init) + frame('{"jsonrpc":"2.0","method":"exit"}')).binary
    )
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [initialize_response('utf-16'), shutdown_response].join("\n")
        message_bodies(ran.stdout.text()!).join("\n")
      )...
      expect_status(1, utf32.status)...
      compare_text(
        'responses'
        initialize_response('utf-32')
        message_bodies(utf32.stdout.text()!).join("\n")
      )...
    ]

const error_request_check = ->
  Check name: 'lerta lsp rejects an unsupported request but ignores its notification', run: ->
    const dir = new_cli_dir('lsp-error-request')
    const messages =
      frame('{"jsonrpc":"2.0","id":1,"method":"textDocument/references","params":{}}')
      frame('{"jsonrpc":"2.0","method":"$/setTrace","params":{"value":"off"}}')
      frame('{"jsonrpc":"2.0","id":2,"method":"textDocument/formatting","params":{}}')
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [
          initialize_response('utf-16')
          '{"jsonrpc":"2.0","id":1,"error":{"code":-32601,"message":"no method textDocument/references"}}'
          "{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32602,\"message\":#{encode_json('$.params: missing the key "textDocument"')}}}"
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const diagnostic_check = ->
  Check name: 'lerta lsp reports diagnostics for an opened document', run: ->
    const dir = new_cli_dir('lsp-diagnostics')
    const path = "#{dir}/a.lerta"
    await write_file(path, ''.binary)
    const uri = uri_of(path)
    const message = frame(
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"print missing\\n\"}}}"
    )
    const ran = await session(dir, message)
    [
      expect_status(0, ran.status)...
      compare_text(
        'messages'
        [
          initialize_response('utf-16')
          published_diagnostics(uri, [diagnostic_body(0, 6, 1, "undefined name 'missing'")])
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const diagnostic_lifecycle_check = ->
  Check name: 'lerta lsp updates and clears document diagnostics', run: ->
    const dir = new_cli_dir('lsp-diagnostic-lifecycle')
    const path = "#{dir}/a.lerta"
    await write_file(path, ''.binary)
    const uri = uri_of(path)
    const messages =
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"print missing\\n\"}}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"version\":2},\"contentChanges\":[{\"text\":\"const unused = 1\\n\"}]}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"version\":3},\"contentChanges\":[{\"text\":\"print 1\\n\"}]}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
      )
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      compare_text(
        'messages'
        [
          initialize_response('utf-16')
          published_diagnostics(uri, [diagnostic_body(0, 6, 1, "undefined name 'missing'")])
          published_diagnostics(uri, [diagnostic_body(0, 6, 2, "'unused' is never used")])
          published_diagnostics(uri, [])
          published_diagnostics(uri, [])
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const imported_diagnostic_check = ->
  Check name: 'lerta lsp reports imported diagnostics in UTF-16 positions', run: ->
    const dir = new_cli_dir('lsp-imported-diagnostic')
    const path = "#{dir}/a.lerta"
    const imported = "#{dir}/b.lerta"
    await write_file(path, ''.binary)
    await write_file(imported, "export const b = '😀' + nothing\n".binary)
    const uri = uri_of(path)
    const message = frame(
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"import b from './b'\\nprint b\\n\"}}}"
    )
    const ran = await session(dir, message)
    [
      expect_status(0, ran.status)...
      compare_text(
        'messages'
        [
          initialize_response('utf-16')
          published_diagnostics(uri, [])
          published_diagnostics(
            uri_of(imported)
            [diagnostic_body(0, 24, 1, "undefined name 'nothing'")]
          )
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const uri_import_check = ->
  Check name: 'lerta lsp imports through parent paths in percent-encoded URIs', run: ->
    const dir = new_cli_dir('lsp-uri-import')
    const nested = "#{dir}/folder"
    const path = "#{nested}/é file.lerta"
    const imported = uri_of("#{dir}/lib.lerta")
    make_dir nested
    await write_file(path, ''.binary)
    await write_file("#{dir}/lib.lerta", "export const x = missing\n".binary)
    const uri = uri_of(path)
    const message = frame(
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"import x from '../lib'\\nprint x\\n\"}}}"
    )
    const other_uri = did_open('untitled:Untitled-1', 'print missing\n')
    const formatting = frame(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{imported}\"}}}"
    )
    const ran = await session(dir, message + other_uri + formatting)
    [
      expect_status(0, ran.status)...
      exact_messages(
        ran.stdout.text()!
        [
          published_diagnostics(uri, [])
          published_diagnostics(imported, [diagnostic_body(0, 17, 1, "undefined name 'missing'")])
          '{"jsonrpc":"2.0","id":1,"result":null}'
        ]
      )...
    ]

const malformed_message_check = ->
  Check name: 'lerta lsp reports a malformed JSON message and continues', run: ->
    const dir = new_cli_dir('lsp-malformed-message')
    const ran = await session(dir, frame('{bad}'))
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [
          initialize_response('utf-16')
          "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32700,\"message\":#{encode_json("$: expected a key, found 'b'")}}}"
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const lsp_input_errors_check = ->
  Check name: 'lerta lsp rejects arguments and a message without Content-Length', run: ->
    const args = await run_command(compiler, ['lsp', 'extra'], new_cli_dir('lsp-arguments'))
    const missing_length = await run_command(
      compiler
      ['lsp']
      new_cli_dir('lsp-no-content-length')
      "Content-Length: x\r\n\r\n{}".binary
    )
    [
      expect_status(1, args.status)...
      compare_text('stderr', "lerta lsp takes no arguments\n", args.stderr.text()!)...
      expect_status(1, missing_length.status)...
      compare_text(
        'stderr'
        "an LSP message without its Content-Length\n"
        missing_length.stderr.text()!
      )...
    ]

const empty_body_check = ->
  Check name: 'lerta lsp reports empty message bodies as parse errors', run: ->
    const dir = new_cli_dir('lsp-empty-body')
    const path = "#{dir}/a.lerta"
    await write_file(path, ''.binary)
    const input =
      frame(initialize)
      frame('{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":1}}}')
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"#{uri_of(path)}\"},\"contentChanges\":[]}}"
      )
      "Content-Length: 0\r\n\r\nContent-Length: -1\r\n\r\n"
      finish
    .join('')
    const ran = await run_command(compiler, ['lsp'], dir, input.binary)
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [
          initialize_response('utf-16')
          '{"jsonrpc":"2.0","id":null,"error":{"code":-32700,"message":"$: expected an object, found the end of the text"}}'
          '{"jsonrpc":"2.0","id":null,"error":{"code":-32700,"message":"$: expected an object, found the end of the text"}}'
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const formatting_check = -> Check(name: 'lerta lsp formats an open document', run: ->
  const dir = new_cli_dir('lsp-formatting')
  const path = "#{dir}/a.lerta"
  await write_file(path, ''.binary)
  const uri = uri_of(path)
  const messages =
    frame(
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"const  value = 1\\nprint value\\n\"}}}"
    )
    frame(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
    )
    did_change_at(uri, "const value = 1\nprint value\n", 2)
    frame(
      "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
    )
    did_change_at(uri, "print (\n", 3)
    frame(
      "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
    )
  .join('')
  const ran = await session(dir, messages)
  [
    expect_status(0, ran.status)...
    exact_messages(
      ran.stdout.text()!
      [
        published_diagnostics(uri, [])
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":2,\"character\":0}},\"newText\":#{encode_json("const value = 1\nprint value\n")}}]}"
        published_diagnostics(uri, [])
        '{"jsonrpc":"2.0","id":2,"result":[]}'
        published_diagnostics(uri, [diagnostic_body(0, 6, 1, "'(' is never closed")])
        '{"jsonrpc":"2.0","id":3,"result":null}'
      ]
    )...
  ]
)

const formatting_new_document_check = ->
  Check name: 'lerta lsp formats a document that does not exist yet', run: ->
    const dir = new_cli_dir('lsp-format-new')
    const uri = uri_of("#{dir}/new.lerta")
    const emoji = "\u{1F600}"
    const text = "print  '#{emoji}'"
    const messages =
      did_open(uri, text)
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
      )
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [
          initialize_response('utf-16')
          "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":11}},\"newText\":#{encode_json("print '#{emoji}'\n")}}]}"
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const shared_import_check = ->
  Check name: 'lerta lsp checks shared imports for each open document', run: ->
    const dir = new_cli_dir('lsp-shared-import')
    await write_file("#{dir}/b.lerta", "export const b: Int = 'text'\n".binary)
    const c = uri_of("#{dir}/c.lerta")
    const d = uri_of("#{dir}/d.lerta")
    await write_file("#{dir}/c.lerta", ''.binary)
    await write_file("#{dir}/d.lerta", ''.binary)
    const imports = "import b from './b'\nprint b\n"
    const messages =
      did_open(c, imports)
      did_open(d, imports)
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"#{c}\"}}}"
      )
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_messages(
        ran.stdout.text()!
        [
          published_diagnostics(c, [])
          published_diagnostics(
            uri_of("#{dir}/b.lerta")
            [diagnostic_body(0, 22, 1, 'expected Int, got String')]
          )
          published_diagnostics(d, [])
          published_diagnostics(
            uri_of("#{dir}/b.lerta")
            [diagnostic_body(0, 22, 1, 'expected Int, got String')]
          )
          published_diagnostics(c, [])
          published_diagnostics(
            uri_of("#{dir}/b.lerta")
            [diagnostic_body(0, 22, 1, 'expected Int, got String')]
          )
        ]
      )...
    ]

const changed_import_check = ->
  Check name: 'lerta lsp rechecks open importers when an imported document changes', run: ->
    const dir = new_cli_dir('lsp-changed-import')
    await write_file("#{dir}/a.lerta", ''.binary)
    await write_file("#{dir}/b.lerta", ''.binary)
    const a = uri_of("#{dir}/a.lerta")
    const b = uri_of("#{dir}/b.lerta")
    const messages =
      did_open(b, "export const b = 'text'\n")
      did_open(a, "import b from './b'\nprint b\n")
      did_change(b, "export const c = 1\n")
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_messages(
        ran.stdout.text()!
        [
          published_diagnostics(b, [])
          published_diagnostics(a, [])
          published_diagnostics(b, [])
          published_diagnostics(b, [])
          published_diagnostics(a, [diagnostic_body(0, 7, 1, "'./b' has no export 'b'")])
          published_diagnostics(b, [])
        ]
      )...
    ]

const close_unsaved_import_check = ->
  Check name: 'lerta lsp uses an imported document file again when it closes', run: ->
    const dir = new_cli_dir('lsp-close-unsaved-import')
    await write_file("#{dir}/a.lerta", ''.binary)
    await write_file("#{dir}/b.lerta", "export const f = -> 1\n".binary)
    const a = uri_of("#{dir}/a.lerta")
    const b = uri_of("#{dir}/b.lerta")
    const messages =
      did_open(a, "import f from './b'\nprint f()\n")
      did_open(b, "export const f = -> 1\n")
      did_change(b, "export const f = -> zzz\n")
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"#{b}\"}}}"
      )
    .join('')
    const ran = await session(dir, messages)
    const last =
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"#{b}\",\"diagnostics\":[]}}"
      )
      frame('{"jsonrpc":"2.0","id":"end","result":null}')
    .join('')
    [
      expect_status(0, ran.status)...
      check_reason(
        ran.stdout.text()!.ends_with(last)
        'closing the unsaved import did not clear diagnostics from its disk contents'
      )...
    ]

const hover_definition_check = ->
  Check name: 'lerta lsp gives a value type and its declaration location', run: ->
    const dir = new_cli_dir('lsp-hover-definition')
    const path = "#{dir}/a.lerta"
    const text = "const value = 1\nprint value\n"
    await write_file(path, text.binary)
    const uri = uri_of(path)
    const messages =
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"const value = 1\\nprint value\\n\"}}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":1,\"character\":6}}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":1,\"character\":6}}}"
      )
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [hover_fragment(1, 'value: Int'), location_fragment(2, uri, 0, 6, 11)]
      )...
    ]

