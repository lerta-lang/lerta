const completion_check = -> Check(name: 'lerta lsp completes members after a dot', run: ->
  const dir = new_cli_dir('lsp-completion')
  const path = "#{dir}/a.lerta"
  const text =
    "struct Point(x: Int, y: Int)\nconst f = (p: Point) ->\n  print p.\n  const later = 2\n"
  await write_file(path, text.binary)
  const uri = uri_of(path)
  const messages =
    did_open(uri, text)
    did_change(uri, text)
    completion_request(uri, 2, 10)
  .join('')
  const ran = await session(dir, messages)
  const items = completion_items(ran.stdout.text()!, 1)
  [
    expect_status(0, ran.status)...
    compare_text(
      'completion items'
      "x 5 Int\ny 5 Int\nequals 2 (Point) -> Bool\nhash 2 () -> Int"
      [completion_item_text(item) for item in items].join("\n")
    )...
    compare_text('response order', '0 1 end', response_ids(ran.stdout.text()!).join(' '))...
  ]
)

const completion_names_check = ->
  Check name: 'lerta lsp completes locals, module names, and keywords', run: ->
    const dir = new_cli_dir('lsp-completion-names')
    const path = "#{dir}/a.lerta"
    const text = "struct Point(x: Int)\nconst top = 1\nconst f = (p: Point) ->\n  const local = 1\n  print lo\n  const later = 2\n"
    await write_file(path, text.binary)
    const uri = uri_of(path)
    const messages =
      did_open(uri, text)
      did_change(uri, text)
      completion_request(uri, 4, 10)
    .join('')
    const ran = await session(dir, messages)
    const output = ran.stdout.text()!
    const items = completion_items(output, 1)
    const labels = [item.label for item in items when item.kind != 14]
    const words = [item.label for item in items when item.kind == 14]
    const keywords = await compiler_keywords()
    const expected_names = ['local', 'p', 'top', 'Point']
    const missing_names = [name for name in expected_names when not labels.contains(name)]
    [
      expect_status(0, ran.status)...
      compare_text('keywords', keywords.join(' '), words.join(' '))...
      ["missing completion name #{name}" for name in missing_names]...
      check_reason(
        not labels.contains('later')
        'completion exposed a local declared after the cursor'
      )...
      compare_text('response order', '0 1 end', response_ids(output).join(' '))...
    ]

const completion_enum_check = -> Check(name: 'lerta lsp completes enum members after a dot', run: ->
  const dir = new_cli_dir('lsp-completion-enum')
  const path = "#{dir}/a.lerta"
  const text = "enum Color\n  RED\nconst f = ->\n  print Color.\n  const later = 1\n"
  await write_file(path, text.binary)
  const uri = uri_of(path)
  const messages =
    did_open(uri, text)
    did_change(uri, text)
    completion_request(uri, 3, 14)
  .join('')
  const ran = await session(dir, messages)
  const output = ran.stdout.text()!
  const items = completion_items(output, 1)
  [
    expect_status(0, ran.status)...
    compare_text('completion labels', 'RED parse', completion_labels(items))...
    compare_text('response order', '0 1 end', response_ids(output).join(' '))...
  ]
)

const completion_contexts_check = ->
  Check name: 'lerta lsp completes methods, optional members, and members of @', run: ->
    const dir = new_cli_dir('lsp-completion-contexts')
    const path = "#{dir}/a.lerta"
    const point_text =
      "struct Point(x: Int, y: Int)\nconst f = (p: Point) ->\n  print p.eq()\n  const later = 1\n"
    const optional_text =
      "struct Point(x: Int, y: Int)\nconst f = (q: Point?) ->\n  print q?.\n  const later = 1\n"
    const counter_text = "class Counter\n  count = 0\n  bump = ->\n    @count += 1\n    print @co\n"
    const bare_at_text = "class Counter\n  count = 0\n  bump = ->\n    @count += 1\n    print @\n"
    const parameter_text = (here: String) ->
      "struct Point(x: Int, y: Int)\nconst p = 3\nconst f = (p: Point, q: Point?) ->\n#{here}\n"
    await write_file(path, point_text.binary)
    const uri = uri_of(path)
    const messages =
      did_open(uri, point_text)
      did_change(uri, point_text)
      completion_request(uri, 2, 11, 1)
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
      )
      did_change(uri, optional_text)
      completion_request(uri, 2, 11, 2)
      did_change(uri, counter_text)
      completion_request(uri, 4, 13, 3)
      did_change(uri, bare_at_text)
      completion_request(uri, 4, 11, 5)
      did_change(uri, parameter_text('  print p'))
      completion_request(uri, 3, 9, 6)
      completion_request(uri, 40, 0, 7)
      did_change(uri, parameter_text('  print [i for i in 0...p]'))
      completion_request(uri, 3, 24, 8)
    .join('')
    const ran = await session(dir, messages)
    const output = ran.stdout.text()!
    const name_labels = (id: Int) ->
      [item.label for item in completion_items(output, id) when item.kind != 14]
    const parameters = [
      "#{item.label} #{item.detail ? 'null'}"
      for item in completion_items(output, 6)
      when item.label == 'p'
    ]
    [
      expect_status(0, ran.status)...
      compare_text(
        'completion labels'
        'x y equals hash|x y equals hash|count bump equals hash'
        [
          completion_labels(completion_items(output, 1))
          completion_labels(completion_items(output, 2))
          completion_labels(completion_items(output, 3))
        ].join(
          '|'
        )
      )...
      compare_text(
        'formatting response'
        '{"jsonrpc":"2.0","id":4,"result":[]}'
        response_body(output, 4)
      )...
      compare_text(
        '@ alone'
        'count bump equals hash'
        completion_labels(completion_items(output, 5))
      )...
      compare_text('local over a top-level name', 'p Point', parameters.join(' '))...
      compare_text('past the end', '', name_labels(7).join(' '))...
      compare_text('after a range', 'p q', [name_labels(8)[i] for i in 0...2].join(' '))...
      compare_text('response order', '0 1 4 2 3 5 6 7 8 end', response_ids(output).join(' '))...
      excludes(output, '__lerta_completion__', 'completion changed the open document')...
    ]

const completion_imports_check = ->
  Check name: 'lerta lsp completes imported values and standard-library functions', run: ->
    const dir = new_cli_dir('lsp-completion-imports')
    const path = "#{dir}/a.lerta"
    const text = "import helper, Pair as Couple from './lib'\nimport sqrt from 'std:math'\nconst print = (n: Int) -> n\nconst x = he\nconst later = 1\nconst g = -> later\n"
    await write_file(path, ''.binary)
    await write_file(
      "#{dir}/lib.lerta"
      "export const helper = -> 1\nexport struct Pair(a: Int)\n".binary
    )
    const uri = uri_of(path)
    const messages =
      did_open(uri, text)
      did_change(uri, text)
      completion_request(uri, 3, 12)
    .join('')
    const ran = await session(dir, messages)
    const output = ran.stdout.text()!
    const items = completion_items(output, 1)
    [
      expect_status(0, ran.status)...
      compare_text('helper', 'helper 3 () -> Int', completion_items_named(items, 'helper'))...
      compare_text('imported alias', 'Couple 22 null', completion_items_named(items, 'Couple'))...
      compare_text('unimported name', '', completion_items_named(items, 'Pair'))...
      compare_text('sqrt', 'sqrt 3 (Float) -> Float', completion_items_named(items, 'sqrt'))...
      compare_text('panic', 'panic 3 (String) -> never', completion_items_named(items, 'panic'))...
      compare_text(
        'shadowing builtin'
        'print 3 (Int) -> Int'
        completion_items_named(items, 'print')
      )...
      compare_text('later name', '', completion_items_named(items, 'later'))...
      compare_text('response order', '0 1 end', response_ids(output).join(' '))...
    ]

const completion_coverage_check = ->
  Check name: 'lerta lsp completes the same member and name contexts as the CLI reference', run: ->
    const completion_text = (here: String) ->
      [
        "import './m' as m"
        'struct Point(x: Int, y: Int)'
        'struct Named(m: Int, Color: Int)'
        'class Counter'
        '  count = 0'
        '  bump = -> @count += 1'
        '  same = <T>(v: T) -> v'
        'interface Shape'
        '  area: () -> Int'
        '  name: String'
        'enum Color'
        '  RED'
        'extend Point'
        '  sum = -> @x + @y'
        'const _hidden = 1'
        'const total = 1'
        'const f = (p: Point, shape: Shape, r: { a: Int }, c: Counter, count: Int, n: Named) ->'
        '  const local = 1'
        '  if true'
        "    const local = 'shadowing'"
        here
        '  const later = 2'
        '  print local'
        ''
      ].join(
        "\n"
      )
    const cases =
      CompletionCase(
        here: '    print p.'
        character: 12
        labels: ['x', 'y', 'equals', 'hash', 'sum']
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      )
      CompletionCase(
        here: '    print p.x'
        character: 12
        labels: ['x', 'y', 'equals', 'hash', 'sum']
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      )
      CompletionCase(
        here: '    print c.'
        character: 12
        labels: nil
        holds: ['count', 'bump', 'same']
        lacks: no_completion_labels
        keywords: false
      )
      CompletionCase(
        here: '    print shape.'
        character: 16
        labels: ['area', 'name']
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      )
      CompletionCase(
        here: '    print r.'
        character: 12
        labels: nil
        holds: ['a']
        lacks: no_completion_labels
        keywords: false
      )
      CompletionCase(
        here: '    print Color.'
        character: 16
        labels: ['RED', 'parse']
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      )
      CompletionCase(
        here: '    print m.'
        character: 12
        labels: ['helper', 'Shade']
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      )
      CompletionCase(
        here: '    print [1].'
        character: 14
        labels: nil
        holds: ['length', 'push', 'pop', 'first', 'contains']
        lacks: no_completion_labels
        keywords: false
      )
      CompletionCase(
        here: '    print lo'
        character: 12
        labels: nil
        holds: [
          '_hidden', 'local', 'p', 'count', 'total', 'f', 'Point', 'Counter', 'Color', 'm', 'print',
          'min'
        ]
        lacks: ['later', '__lerta_completion__', 'Point.sum', 'Shape', 'Stringable']
        keywords: true
      )
      CompletionCase(
        here: "    print '😀' + tot"
        character: 20
        labels: nil
        holds: ['total']
        lacks: no_completion_labels
        keywords: true
      )
      CompletionCase(
        here: "    print tot + 'é'"
        character: 13
        labels: nil
        holds: ['total']
        lacks: no_completion_labels
        keywords: true
      )
      CompletionCase(
        here: '    print m.Shade.'
        character: 18
        labels: ['DARK', 'parse']
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      )
      CompletionCase(
        here: '    print n.m.'
        character: 14
        labels: nil
        holds: ['to_string', 'compare']
        lacks: ['helper']
        keywords: false
      )
      CompletionCase(
        here: '    print n.Color.'
        character: 18
        labels: nil
        holds: ['to_string']
        lacks: ['RED']
        keywords: false
      )
      CompletionCase(
        here: '    print 1 # m.'
        character: 16
        labels: no_completion_labels
        holds: no_completion_labels
        lacks: no_completion_labels
        keywords: false
      )
      CompletionCase(
        here: '    # tot', character: 9, labels: no_completion_labels, holds: no_completion_labels,
        lacks: no_completion_labels, keywords: false
      )
    const dir = new_cli_dir('lsp-completion-coverage')
    const path = "#{dir}/a.lerta"
    await write_file(path, ''.binary)
    await write_file(
      "#{dir}/m.lerta"
      "export const helper = -> 1\nexport enum Shade\n  DARK\nconst private_one = 2\n".binary
    )
    const uri = uri_of(path)
    const other = uri_of("#{dir}/other.lerta")
    const messages = [did_open(uri, completion_text('    print local'))]
    for each, i in cases
      messages.push did_change(uri, completion_text(each.here))
      messages.push completion_request(uri, 20, each.character, 10 + i)
    messages.push did_change(uri, completion_text('    print  lo'))
    messages.push completion_request(uri, 20, 13, 97)
    messages.push(
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":98,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
      )
    )
    messages.push completion_request(other, 0, 0, 99)
    const ran = await session(dir, messages.join(''))
    const output = ran.stdout.text()!
    const keywords = await compiler_keywords()
    const reasons: String[] = []
    for each, i in cases
      const items = completion_items(output, 10 + i)
      const words = [item for item in items when item.kind == 14]
      const expected_words: String[] = each.keywords then keywords else []
      const actual_keyword_text = [completion_item_text(item) for item in words].join("\n")
      const expected_keyword_text = ["#{word} 14 null" for word in expected_words].join("\n")
      if actual_keyword_text != expected_keyword_text
        reasons.push "unexpected keywords for #{each.here}"
      const labels = [item.label for item in items when item.kind != 14]
      if const expected = each.labels
        if expected.join(' ') != labels.join(' ')
          reasons.push "unexpected completion labels for #{each.here}: #{labels.join(' ')}"
      for label in each.holds
        reasons.push "missing completion #{label} for #{each.here}" if not labels.contains(label)
      for label in each.lacks
        reasons.push "unexpected completion #{label} for #{each.here}" if labels.contains(label)
      const seen: String[] = []
      for label in labels
        if seen.contains(label)
          reasons.push "duplicate completion label #{label} for #{each.here}"
        else
          seen.push label
    const member_items = completion_items(output, 10)
    const expected_member_items = "x 5 Int\nequals 2 (Point) -> Bool\nsum 2 null"
    const named_items = completion_items(output, 18)
    const expected_named_items =
      "local 6 String\nf 3 null\nPoint 22 null\nCounter 7 null\nColor 13 null\nconst 14 null"
    const expected_ids = ['0', ["#{10 + i}" for i in 0...cases.length]..., '97', '98', '99', 'end']
    const formatting_response = response_body(output, 98)
    const preserved = formatting_response.contains(
      'print lo\n'
    ) and not formatting_response.contains('__lerta_completion__')
    [
      expect_status(0, ran.status)...
      reasons...
      compare_text(
        'member item kinds and types'
        expected_member_items
        [
          completion_items_named(member_items, 'x')
          completion_items_named(member_items, 'equals')
          completion_items_named(member_items, 'sum')
        ].join(
          "\n"
        )
      )...
      compare_text(
        'completion item kinds and types'
        expected_named_items
        [
          completion_items_named(named_items, 'local')
          completion_items_named(named_items, 'f')
          completion_items_named(named_items, 'Point')
          completion_items_named(named_items, 'Counter')
          completion_items_named(named_items, 'Color')
          completion_items_named(named_items, 'const')
        ].join(
          "\n"
        )
      )...
      compare_text('response order', expected_ids.join(' '), response_ids(output).join(' '))...
      compare_text(
        'completion of an unopened document'
        '{"jsonrpc":"2.0","id":99,"result":[]}'
        response_body(output, 99)
      )...
      check_reason(preserved, "formatting after completion returned #{formatting_response}")...
      excludes(output, '__lerta_completion__', 'the probe name in published diagnostics')...
    ]

export const checks =
  initialize_check()
  error_request_check()
  diagnostic_check()
  diagnostic_lifecycle_check()
  imported_diagnostic_check()
  uri_import_check()
  malformed_message_check()
  lsp_input_errors_check()
  empty_body_check()
  formatting_check()
  formatting_new_document_check()
  shared_import_check()
  changed_import_check()
  close_unsaved_import_check()
  hover_definition_check()
  generic_hover_check()
  definition_contexts_check()
  hover_contexts_check()
  optional_and_interpolation_check()
  open_import_hover_check()
  definitions_after_error_check()
  imported_hover_definition_check()
  extern_definition_check()
  completion_check()
  completion_names_check()
  completion_enum_check()
  completion_contexts_check()
  completion_imports_check()
  completion_coverage_check()
