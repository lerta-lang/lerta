# The language server reports diagnostics, formats documents, and answers hovers and definitions.
import Check from '../lib/report'
import compare_text, expect_status from '../lib/expect'
import compiler from '../lib/lerta'
import new_cli_dir, run_command from '../lib/cli'
import make_dir, write_file from 'std:io'
import encode_json from 'std:json'
import
  uri_of, frame, did_open, did_change, did_change_at, definition_request, hover_request,
  location_fragment, hover_fragment, initialize, finish, session, check_reason, message_bodies,
  diagnostic_body, published_diagnostics, initialize_response, shutdown_response, exact_responses,
  exact_messages
from '../lib/lsp'

initialize_check := ->
  Check name: 'lerta lsp negotiates UTF-16 positions and exits after shutdown', run: ->
    dir := new_cli_dir('lsp-initialize')
    ran := await session(dir, '')
    utf32_init := '{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"capabilities":{"general":{"positionEncodings":["utf-16","utf-32"]}}}}'
    utf32_dir := new_cli_dir('lsp-utf32-no-shutdown')
    utf32 := await run_command(
      compiler
      ['lsp']
      utf32_dir
      (frame(utf32_init) + frame('{"jsonrpc":"2.0","method":"exit"}')).binary
    )
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [initialize_response('utf-16'), shutdown_response].join("\n")
        message_bodies(ran.stdout.text()!).join("\n")
      )...
      expect_status(1, utf32.status)...
      compare_text(
        'responses'
        initialize_response('utf-32')
        message_bodies(utf32.stdout.text()!).join("\n")
      )...
    ]

error_request_check := ->
  Check name: 'lerta lsp rejects an unsupported request but ignores its notification', run: ->
    dir := new_cli_dir('lsp-error-request')
    messages :=
      frame('{"jsonrpc":"2.0","id":1,"method":"textDocument/references","params":{}}')
      frame('{"jsonrpc":"2.0","method":"$/setTrace","params":{"value":"off"}}')
      frame('{"jsonrpc":"2.0","id":2,"method":"textDocument/formatting","params":{}}')
    .join('')
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [
          initialize_response('utf-16')
          '{"jsonrpc":"2.0","id":1,"error":{"code":-32601,"message":"no method textDocument/references"}}'
          "{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32602,\"message\":#{encode_json('$.params: missing the key "textDocument"')}}}"
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

diagnostic_check := -> Check(name: 'lerta lsp reports diagnostics for an opened document', run: ->
  dir := new_cli_dir('lsp-diagnostics')
  path := "#{dir}/a.lerta"
  await write_file(path, ''.binary)
  uri := uri_of(path)
  message := frame
    "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"print missing\\n\"}}}"
  ran := await session(dir, message)
  [
    expect_status(0, ran.status)...
    compare_text(
      'messages'
      [
        initialize_response('utf-16')
        published_diagnostics(uri, [diagnostic_body(0, 6, 1, "undefined name 'missing'")])
        shutdown_response
      ].join(
        "\n"
      )
      message_bodies(ran.stdout.text()!).join("\n")
    )...
  ]
)

diagnostic_lifecycle_check := ->
  Check name: 'lerta lsp updates and clears document diagnostics', run: ->
    dir := new_cli_dir('lsp-diagnostic-lifecycle')
    path := "#{dir}/a.lerta"
    await write_file(path, ''.binary)
    uri := uri_of(path)
    messages :=
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"print missing\\n\"}}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"version\":2},\"contentChanges\":[{\"text\":\"unused := 1\\n\"}]}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"version\":3},\"contentChanges\":[{\"text\":\"print 1\\n\"}]}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
      )
    .join('')
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      compare_text(
        'messages'
        [
          initialize_response('utf-16')
          published_diagnostics(uri, [diagnostic_body(0, 6, 1, "undefined name 'missing'")])
          published_diagnostics(uri, [diagnostic_body(0, 0, 2, "'unused' is never used")])
          published_diagnostics(uri, [])
          published_diagnostics(uri, [])
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

imported_diagnostic_check := ->
  Check name: 'lerta lsp reports imported diagnostics in UTF-16 positions', run: ->
    dir := new_cli_dir('lsp-imported-diagnostic')
    path := "#{dir}/a.lerta"
    imported := "#{dir}/b.lerta"
    await write_file(path, ''.binary)
    await write_file(imported, "export b := '😀' + nothing\n".binary)
    uri := uri_of(path)
    message := frame
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"import b from './b'\\nprint b\\n\"}}}"
    ran := await session(dir, message)
    [
      expect_status(0, ran.status)...
      compare_text(
        'messages'
        [
          initialize_response('utf-16')
          published_diagnostics(uri, [])
          published_diagnostics(
            uri_of(imported)
            [diagnostic_body(0, 19, 1, "undefined name 'nothing'")]
          )
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

uri_import_check := ->
  Check name: 'lerta lsp imports through parent paths in percent-encoded URIs', run: ->
    dir := new_cli_dir('lsp-uri-import')
    nested := "#{dir}/folder"
    path := "#{nested}/é file.lerta"
    imported := uri_of("#{dir}/lib.lerta")
    make_dir nested
    await write_file(path, ''.binary)
    await write_file("#{dir}/lib.lerta", "export x := missing\n".binary)
    uri := uri_of(path)
    message := frame
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"import x from '../lib'\\nprint x\\n\"}}}"
    other_uri := did_open('untitled:Untitled-1', 'print missing\n')
    formatting := frame
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{imported}\"}}}"
    ran := await session(dir, message + other_uri + formatting)
    [
      expect_status(0, ran.status)...
      exact_messages(
        ran.stdout.text()!
        [
          published_diagnostics(uri, [])
          published_diagnostics(imported, [diagnostic_body(0, 12, 1, "undefined name 'missing'")])
          '{"jsonrpc":"2.0","id":1,"result":null}'
        ]
      )...
    ]

malformed_message_check := ->
  Check name: 'lerta lsp reports a malformed JSON message and continues', run: ->
    dir := new_cli_dir('lsp-malformed-message')
    ran := await session(dir, frame('{bad}'))
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [
          initialize_response('utf-16')
          "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32700,\"message\":#{encode_json("$: expected a key, found 'b'")}}}"
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

lsp_input_errors_check := ->
  Check
    name: 'lerta lsp rejects arguments, a message without Content-Length and one cut short'
    run: ->
      args := await run_command(compiler, ['lsp', 'extra'], new_cli_dir('lsp-arguments'))
      missing_length := await run_command(
        compiler
        ['lsp']
        new_cli_dir('lsp-no-content-length')
        "Content-Length: x\r\n\r\n{}".binary
      )
      cut_short := await run_command(
        compiler
        ['lsp']
        new_cli_dir('lsp-cut-short')
        "Content-Length: 100\r\n\r\n{}".binary
      )
      no_body := await run_command(
        compiler
        ['lsp']
        new_cli_dir('lsp-no-body')
        "Content-Length: 100\r\n\r\n".binary
      )
      [
        expect_status(1, args.status)...
        compare_text('stderr', "lerta lsp takes no arguments\n", args.stderr.text()!)...
        expect_status(1, missing_length.status)...
        compare_text(
          'stderr'
          "an LSP message without its Content-Length\n"
          missing_length.stderr.text()!
        )...
        expect_status(1, cut_short.status)...
        compare_text('stderr', "the end came after 2 of 100 bytes\n", cut_short.stderr.text()!)...
        expect_status(1, no_body.status)...
        compare_text('stderr', "the end came after 0 of 100 bytes\n", no_body.stderr.text()!)...
      ]

empty_body_check := -> Check(name: 'lerta lsp reports empty message bodies as parse errors', run: ->
  dir := new_cli_dir('lsp-empty-body')
  path := "#{dir}/a.lerta"
  await write_file(path, ''.binary)
  input :=
    frame(initialize)
    frame('{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":1}}}')
    frame(
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"#{uri_of(path)}\"},\"contentChanges\":[]}}"
    )
    "Content-Length: 0\r\n\r\nContent-Length: -1\r\n\r\n"
    finish
  .join('')
  ran := await run_command(compiler, ['lsp'], dir, input.binary)
  [
    expect_status(0, ran.status)...
    compare_text(
      'responses'
      [
        initialize_response('utf-16')
        '{"jsonrpc":"2.0","id":null,"error":{"code":-32700,"message":"$: expected an object, found the end of the text"}}'
        '{"jsonrpc":"2.0","id":null,"error":{"code":-32700,"message":"$: expected an object, found the end of the text"}}'
        shutdown_response
      ].join(
        "\n"
      )
      message_bodies(ran.stdout.text()!).join("\n")
    )...
  ]
)

formatting_check := -> Check(name: 'lerta lsp formats an open document', run: ->
  dir := new_cli_dir('lsp-formatting')
  path := "#{dir}/a.lerta"
  await write_file(path, ''.binary)
  uri := uri_of(path)
  messages :=
    frame(
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"value  := 1\\nprint value\\n\"}}}"
    )
    frame(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
    )
    did_change_at(uri, "value := 1\nprint value\n", 2)
    frame(
      "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
    )
    did_change_at(uri, "print (\n", 3)
    frame(
      "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
    )
  .join('')
  ran := await session(dir, messages)
  [
    expect_status(0, ran.status)...
    exact_messages(
      ran.stdout.text()!
      [
        published_diagnostics(uri, [])
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":2,\"character\":0}},\"newText\":#{encode_json("value := 1\nprint value\n")}}]}"
        published_diagnostics(uri, [])
        '{"jsonrpc":"2.0","id":2,"result":[]}'
        published_diagnostics(uri, [diagnostic_body(0, 6, 1, "'(' is never closed")])
        '{"jsonrpc":"2.0","id":3,"result":null}'
      ]
    )...
  ]
)

formatting_new_document_check := ->
  Check name: 'lerta lsp formats a document that does not exist yet', run: ->
    dir := new_cli_dir('lsp-format-new')
    uri := uri_of("#{dir}/new.lerta")
    emoji := "\u{1F600}"
    text := "print  '#{emoji}'"
    messages :=
      did_open(uri, text)
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
      )
    .join('')
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [
          initialize_response('utf-16')
          "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":11}},\"newText\":#{encode_json("print '#{emoji}'\n")}}]}"
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

shared_import_check := ->
  Check name: 'lerta lsp checks shared imports for each open document', run: ->
    dir := new_cli_dir('lsp-shared-import')
    await write_file("#{dir}/b.lerta", "export b: Int = 'text'\n".binary)
    c := uri_of("#{dir}/c.lerta")
    d := uri_of("#{dir}/d.lerta")
    await write_file("#{dir}/c.lerta", ''.binary)
    await write_file("#{dir}/d.lerta", ''.binary)
    imports := "import b from './b'\nprint b\n"
    messages :=
      did_open(c, imports)
      did_open(d, imports)
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"#{c}\"}}}"
      )
    .join('')
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_messages(
        ran.stdout.text()!
        [
          published_diagnostics(c, [])
          published_diagnostics(
            uri_of("#{dir}/b.lerta")
            [diagnostic_body(0, 16, 1, 'expected Int, got String')]
          )
          published_diagnostics(d, [])
          published_diagnostics(
            uri_of("#{dir}/b.lerta")
            [diagnostic_body(0, 16, 1, 'expected Int, got String')]
          )
          published_diagnostics(c, [])
          published_diagnostics(
            uri_of("#{dir}/b.lerta")
            [diagnostic_body(0, 16, 1, 'expected Int, got String')]
          )
        ]
      )...
    ]

changed_import_check := ->
  Check name: 'lerta lsp rechecks open importers when an imported document changes', run: ->
    dir := new_cli_dir('lsp-changed-import')
    await write_file("#{dir}/a.lerta", ''.binary)
    await write_file("#{dir}/b.lerta", ''.binary)
    a := uri_of("#{dir}/a.lerta")
    b := uri_of("#{dir}/b.lerta")
    messages :=
      did_open(b, "export b := 'text'\n")
      did_open(a, "import b from './b'\nprint b\n")
      did_change(b, "export c := 1\n")
    .join('')
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_messages(
        ran.stdout.text()!
        [
          published_diagnostics(b, [])
          published_diagnostics(a, [])
          published_diagnostics(b, [])
          published_diagnostics(b, [])
          published_diagnostics(a, [diagnostic_body(0, 7, 1, "'./b' has no export 'b'")])
          published_diagnostics(b, [])
        ]
      )...
    ]

close_unsaved_import_check := ->
  Check name: 'lerta lsp uses an imported document file again when it closes', run: ->
    dir := new_cli_dir('lsp-close-unsaved-import')
    await write_file("#{dir}/a.lerta", ''.binary)
    await write_file("#{dir}/b.lerta", "export f := -> 1\n".binary)
    a := uri_of("#{dir}/a.lerta")
    b := uri_of("#{dir}/b.lerta")
    messages :=
      did_open(a, "import f from './b'\nprint f()\n")
      did_open(b, "export f := -> 1\n")
      did_change(b, "export f := -> zzz\n")
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"#{b}\"}}}"
      )
    .join('')
    ran := await session(dir, messages)
    last :=
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"#{b}\",\"diagnostics\":[]}}"
      )
      frame('{"jsonrpc":"2.0","id":"end","result":null}')
    .join('')
    [
      expect_status(0, ran.status)...
      check_reason(
        ran.stdout.text()!.ends_with(last)
        'closing the unsaved import did not clear diagnostics from its disk contents'
      )...
    ]

hover_definition_check := ->
  Check name: 'lerta lsp gives a value type and its declaration location', run: ->
    dir := new_cli_dir('lsp-hover-definition')
    path := "#{dir}/a.lerta"
    text := "value := 1\nprint value\n"
    await write_file(path, text.binary)
    uri := uri_of(path)
    messages :=
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"value := 1\\nprint value\\n\"}}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":1,\"character\":6}}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":1,\"character\":6}}}"
      )
    .join('')
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [hover_fragment(1, 'value: Int'), location_fragment(2, uri, 0, 0, 5)]
      )...
    ]

generic_hover_check := ->
  Check name: 'lerta lsp gives generic values the types of their instances', run: ->
    dir := new_cli_dir('lsp-generic-hover')
    path := "#{dir}/a.lerta"
    text := "id := <T>(v: T) -> v\nprint id(1)\nprint id('a')\n"
    await write_file(path, text.binary)
    uri := uri_of(path)
    messages :=
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"id := <T>(v: T) -> v\\nprint id(1)\\nprint id('a')\\n\"}}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":1,\"character\":6}}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":2,\"character\":6}}}"
      )
      hover_request(uri, 0, 24, 3)
    .join('')
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [
          hover_fragment(1, 'id: (Int) -> Int')
          hover_fragment(2, 'id: (String) -> String')
          hover_fragment(3, "v: Int\nv: String")
        ]
      )...
    ]

definition_contexts_check := ->
  Check name: 'lerta lsp finds assigned fields, enum members, bindings, and methods', run: ->
    dir := new_cli_dir('lsp-definition-contexts')
    path := "#{dir}/a.lerta"
    shades := "#{dir}/shades.lerta"
    text :=
      "import Shade from './shades'"
      'class K'
      '  v: Int = 1'
      '  inc = -> @v += 1'
      'k := K()'
      'k.v = 3'
      'enum Color'
      '  RED'
      'c := Color.RED'
      'found: Int? = 1'
      'if n := found'
      '  print n'
      'try'
      "  throw ValueError(message: 'x')"
      'catch error'
      '  print error.message'
      'k.inc()'
      'print c'
      'extend K'
      '  reset = -> @v = 0'
      'k.reset()'
      'print Shade.DARK'
      ''
    .join("\n")
    await write_file(path, ''.binary)
    await write_file(shades, "export enum Shade\n  LIGHT\n  DARK\n".binary)
    uri := uri_of(path)
    imported_uri := uri_of(shades)
    messages :=
      did_open(uri, text)
      definition_request(uri, 5, 2, 10)
      definition_request(uri, 3, 12, 11)
      definition_request(uri, 8, 11, 12)
      definition_request(uri, 11, 8, 13)
      definition_request(uri, 15, 8, 14)
      definition_request(uri, 19, 15, 15)
      definition_request(uri, 20, 2, 16)
      definition_request(uri, 16, 2, 17)
      definition_request(uri, 21, 12, 18)
    .join('')
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [
          location_fragment(10, uri, 2, 2, 3)
          location_fragment(11, uri, 2, 2, 3)
          location_fragment(12, uri, 7, 2, 5)
          location_fragment(13, uri, 10, 3, 4)
          location_fragment(14, uri, 14, 6, 11)
          location_fragment(15, uri, 2, 2, 3)
          location_fragment(16, uri, 19, 2, 7)
          location_fragment(17, uri, 3, 2, 5)
          location_fragment(18, imported_uri, 2, 2, 6)
        ]
      )...
    ]

hover_contexts_check := ->
  Check name: 'lerta lsp finds assigned, generic, and UTF-16 names with their definitions', run: ->
    dir := new_cli_dir('lsp-hover-contexts')
    path := "#{dir}/a.lerta"
    emoji := "\u{1F600}"
    text :=
      "s := '#{emoji}'"
      'struct Box<T>'
      '  value: T'
      'extend Int'
      '  twice = -> @ * 2'
      'var n = 1'
      'n = Box(value: 2).value.twice()'
      'print s + n.to_string()'
      "print '#{emoji}' + s"
      ''
    .join("\n")
    await write_file(path, ''.binary)
    uri := uri_of(path)
    messages :=
      did_open(uri, text)
      hover_request(uri, 7, 6, 10)
      definition_request(uri, 7, 6, 11)
      hover_request(uri, 6, 0, 12)
      definition_request(uri, 6, 0, 13)
      hover_request(uri, 6, 6, 14)
      definition_request(uri, 6, 6, 15)
      hover_request(uri, 6, 18, 16)
      definition_request(uri, 6, 18, 17)
      hover_request(uri, 6, 26, 18)
      definition_request(uri, 6, 26, 19)
      hover_request(uri, 8, 13, 20)
      definition_request(uri, 8, 13, 21)
      hover_request(uri, 8, 14, 22)
      definition_request(uri, 8, 14, 23)
      hover_request(uri, 7, 15, 24)
      definition_request(uri, 7, 15, 25)
    .join('')
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [
          hover_fragment(10, 's: String')
          location_fragment(11, uri, 0, 0, 1)
          hover_fragment(12, 'n: Int')
          location_fragment(13, uri, 5, 4, 5)
          hover_fragment(14, 'Box: Box<Int>')
          location_fragment(15, uri, 1, 7, 10)
          hover_fragment(16, 'value: Int')
          location_fragment(17, uri, 2, 2, 7)
          hover_fragment(18, 'twice: () -> Int')
          location_fragment(19, uri, 4, 2, 7)
          hover_fragment(20, 's: String')
          location_fragment(21, uri, 0, 0, 1)
          hover_fragment(22, 's: String')
          location_fragment(23, uri, 0, 0, 1)
          hover_fragment(24, 'to_string: () -> String')
          '"id":25,"result":null'
        ]
      )...
    ]

optional_and_interpolation_check := ->
  Check
    name: 'lerta lsp finds optional fields and interpolation names, not unrelated positions'
    run: ->
      dir := new_cli_dir('lsp-optional-interpolation')
      path := "#{dir}/a.lerta"
      text :=
        'struct P'
        '  x: Int'
        'f := (p: P?) -> p?.x'
        'class C'
        '  x: Int = 1'
        '  get = -> @x'
        'print C().get()'
        'print f(nil) == nil'
        'print "#{C().x}"'
        'g := (p: P?) -> p?.x.to_string()'
        'to_string_value := 1'
        'print "#{to_string_value}"'
        ''
      .join("\n")
      await write_file(path, ''.binary)
      uri := uri_of(path)
      other := uri_of("#{dir}/other.lerta")
      messages :=
        did_open(uri, text)
        hover_request(uri, 8, 13, 10)
        definition_request(uri, 8, 13, 11)
        hover_request(uri, 8, 15, 12)
        definition_request(uri, 8, 15, 13)
        hover_request(uri, 9, 23, 14)
        definition_request(uri, 9, 23, 15)
        hover_request(uri, 11, 10, 16)
        definition_request(uri, 11, 10, 17)
        hover_request(uri, 2, 19, 18)
        definition_request(uri, 2, 19, 19)
        hover_request(uri, 5, 12, 20)
        definition_request(uri, 5, 12, 21)
        hover_request(uri, 6, 40, 22)
        definition_request(uri, 6, 40, 23)
        hover_request(uri, 31, 0, 24)
        definition_request(uri, 31, 0, 25)
        hover_request(other, 0, 0, 26)
        definition_request(other, 0, 0, 27)
      .join('')
      ran := await session(dir, messages)
      [
        expect_status(0, ran.status)...
        exact_responses(
          ran.stdout.text()!
          [
            hover_fragment(10, 'x: Int')
            location_fragment(11, uri, 4, 2, 3)
            '"id":12,"result":null'
            '"id":13,"result":null'
            hover_fragment(14, 'to_string: () -> String')
            '"id":15,"result":null'
            hover_fragment(16, 'to_string_value: Int')
            location_fragment(17, uri, 10, 0, 15)
            hover_fragment(18, 'x: Int')
            location_fragment(19, uri, 1, 2, 3)
            hover_fragment(20, 'x: Int')
            location_fragment(21, uri, 4, 2, 3)
            '"id":22,"result":null'
            '"id":23,"result":null'
            '"id":24,"result":null'
            '"id":25,"result":null'
            '"id":26,"result":null'
            '"id":27,"result":null'
          ]
        )...
      ]

open_import_hover_check := ->
  Check name: 'lerta lsp answers for an imported file in an open program', run: ->
    dir := new_cli_dir('lsp-open-import-hover')
    a_path := "#{dir}/a.lerta"
    b_path := "#{dir}/b.lerta"
    b_text := "export b := 1\n"
    await write_file(a_path, ''.binary)
    await write_file(b_path, b_text.binary)
    a := uri_of(a_path)
    b := uri_of(b_path)
    messages :=
      did_open(a, "import b from './b'\nprint b\n")
      hover_request(b, 0, 7, 10)
      did_open(b, b_text)
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"#{a}\"}}}"
      )
      hover_request(a, 1, 6, 11)
    .join('')
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [hover_fragment(10, 'b: Int'), '"id":11,"result":null']
      )...
    ]

definitions_after_error_check := ->
  Check name: 'lerta lsp finds locals after errors, destructured, loop, and captured names', run: ->
    dir := new_cli_dir('lsp-definitions-after-error')
    path := "#{dir}/a.lerta"
    text :=
      'n := [1].length'
      'print n + zz'
      'q := 2'
      'print q'
      '(a, b) := (1, 2)'
      'for item in [a]'
      '  print item + b'
      'add := (x: Int) -> -> x + 1'
      'print add(1)()'
      ''
    .join("\n")
    await write_file(path, ''.binary)
    uri := uri_of(path)
    messages :=
      did_open(uri, text)
      definition_request(uri, 3, 6, 10)
      definition_request(uri, 6, 8, 11)
      definition_request(uri, 6, 15, 12)
      definition_request(uri, 7, 22, 13)
      did_change(uri, "import x from './missing'\nprint n + zz\n")
      hover_request(uri, 1, 6, 20)
    .join('')
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [
          location_fragment(10, uri, 2, 0, 1)
          location_fragment(11, uri, 5, 4, 8)
          location_fragment(12, uri, 4, 4, 5)
          location_fragment(13, uri, 7, 8, 9)
          '"id":20,"result":null'
        ]
      )...
    ]

imported_hover_definition_check := ->
  Check
    name: 'lerta lsp gives imported, field, and generic values their types and definitions'
    run: ->
      dir := new_cli_dir('lsp-imported-hover-definition')
      lib := "#{dir}/lib.lerta"
      path := "#{dir}/a.lerta"
      text := "import make from './lib'\np := make(1)\nprint p.x\nid := <T>(v: T) -> v\nprint id(1) + id(2)\nprint id('a')\n"
      await write_file(
        lib
        "export struct Point\n  x: Int\n  y: Int\nexport make := (x: Int) -> Point(x, y: 0)\n".binary
      )
      await write_file(path, ''.binary)
      uri := uri_of(path)
      asks := [(1, 5), (2, 8), (3, 19), (4, 6), (5, 6), (0, 7), (1, 2)]
      messages := [did_open(uri, text)]
      for ask, i in asks
        (line, character) := ask
        messages.push hover_request(uri, line, character, 10 + 2 * i)
        messages.push definition_request(uri, line, character, 11 + 2 * i)
      ran := await session(dir, messages.join(''))
      [
        expect_status(0, ran.status)...
        exact_responses(
          ran.stdout.text()!
          [
            hover_fragment(10, 'make: (Int) -> Point')
            location_fragment(11, uri_of(lib), 3, 7, 11)
            hover_fragment(12, 'x: Int')
            location_fragment(13, uri_of(lib), 1, 2, 3)
            hover_fragment(14, "v: Int\nv: String")
            location_fragment(15, uri, 3, 10, 11)
            hover_fragment(16, 'id: (Int) -> Int')
            location_fragment(17, uri, 3, 0, 2)
            hover_fragment(18, 'id: (String) -> String')
            location_fragment(19, uri, 3, 0, 2)
            '"id":20,"result":null'
            location_fragment(21, uri_of(lib), 3, 7, 11)
            '"id":22,"result":null'
            '"id":23,"result":null'
          ]
        )...
      ]

extern_definition_check := ->
  Check name: 'lerta lsp finds extern definitions in the current and imported modules', run: ->
    dir := new_cli_dir('lsp-extern-definition')
    path := "#{dir}/a.lerta"
    text := "import float_text, float_text as t from './conversions'\nextern lerta_float_to_string as text_of: (Float) -> String\nprint text_of(1.0)\nprint float_text(2.0)\nprint t(3.0)\n"
    await write_file(path, ''.binary)
    await write_file(
      "#{dir}/conversions.lerta"
      "export extern lerta_float_to_string as float_text: (Float) -> String\n".binary
    )
    uri := uri_of(path)
    messages :=
      did_open(uri, text)
      definition_request(uri, 2, 6, 1)
      definition_request(uri, 3, 6, 2)
      definition_request(uri, 0, 7, 3)
      definition_request(uri, 4, 6, 4)
      definition_request(uri, 0, 34, 5)
    .join('')
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [
          location_fragment(1, uri, 1, 32, 39)
          location_fragment(2, uri_of("#{dir}/conversions.lerta"), 0, 39, 49)
          location_fragment(3, uri_of("#{dir}/conversions.lerta"), 0, 39, 49)
          location_fragment(4, uri_of("#{dir}/conversions.lerta"), 0, 39, 49)
          location_fragment(5, uri_of("#{dir}/conversions.lerta"), 0, 39, 49)
        ]
      )...
    ]

reexport_definition_check := ->
  Check name: 'lerta lsp finds the declarations of names that modules export from others', run: ->
    dir := new_cli_dir('lsp-reexport-definition')
    path := "#{dir}/a.lerta"
    shapes := "#{dir}/shapes.lerta"
    text := "import n from './facade'\nexport norm as m from './shapes'\nprint n(1)\n"
    await write_file(path, ''.binary)
    await write_file(shapes, "export norm := (x: Int) -> x\n".binary)
    await write_file("#{dir}/facade.lerta", "export norm as n from './shapes'\n".binary)
    uri := uri_of(path)
    messages :=
      did_open(uri, text)
      definition_request(uri, 0, 7, 1)
      definition_request(uri, 1, 8, 2)
      definition_request(uri, 1, 16, 3)
      definition_request(uri, 2, 6, 4)
    .join('')
    ran := await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [
          location_fragment(1, uri_of(shapes), 0, 7, 11)
          location_fragment(2, uri_of(shapes), 0, 7, 11)
          location_fragment(3, uri_of(shapes), 0, 7, 11)
          location_fragment(4, uri_of(shapes), 0, 7, 11)
        ]
      )...
    ]

export checks :=
  initialize_check()
  error_request_check()
  diagnostic_check()
  diagnostic_lifecycle_check()
  imported_diagnostic_check()
  uri_import_check()
  malformed_message_check()
  lsp_input_errors_check()
  empty_body_check()
  formatting_check()
  formatting_new_document_check()
  shared_import_check()
  changed_import_check()
  close_unsaved_import_check()
  hover_definition_check()
  generic_hover_check()
  definition_contexts_check()
  hover_contexts_check()
  optional_and_interpolation_check()
  open_import_hover_check()
  definitions_after_error_check()
  imported_hover_definition_check()
  extern_definition_check()
  reexport_definition_check()
