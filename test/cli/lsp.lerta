const imported_hover_definition_check = ->
  Check(
    name: 'lerta lsp gives imported, field, and generic values their types and definitions'
    run: ->
      const dir = new_cli_dir('lsp-imported-hover-definition')
      const lib = "#{dir}/lib.lerta"
      const path = "#{dir}/a.lerta"
      const text = "import make from './lib'\nconst p = make(1)\nprint p.x\nconst id = <T>(v: T) -> v\nprint id(1) + id(2)\nprint id('a')\n"
      await write_file(
        lib
        "export struct Point(x: Int, y: Int)\nexport const make = (x: Int) -> Point(x, y: 0)\n".binary
      )
      await write_file(path, ''.binary)
      const uri = uri_of(path)
      const asks = [(1, 10), (2, 8), (3, 24), (4, 6), (5, 6), (0, 7), (1, 4)]
      const messages = [did_open(uri, text)]
      for ask, i in asks
        const (line, character) = ask
        messages.push hover_request(uri, line, character, 10 + 2 * i)
        messages.push definition_request(uri, line, character, 11 + 2 * i)
      const ran = await session(dir, messages.join(''))
      [
        expect_status(0, ran.status)...
        exact_responses(
          ran.stdout.text()!
          [
            hover_fragment(10, 'make: (Int) -> Point')
            location_fragment(11, uri_of(lib), 1, 13, 17)
            hover_fragment(12, 'x: Int')
            location_fragment(13, uri_of(lib), 0, 20, 21)
            hover_fragment(14, "v: Int\nv: String")
            location_fragment(15, uri, 3, 15, 16)
            hover_fragment(16, 'id: (Int) -> Int')
            location_fragment(17, uri, 3, 6, 8)
            hover_fragment(18, 'id: (String) -> String')
            location_fragment(19, uri, 3, 6, 8)
            '"id":20,"result":null'
            location_fragment(21, uri_of(lib), 1, 13, 17)
            '"id":22,"result":null'
            '"id":23,"result":null'
          ]
        )...
      ]
  )

