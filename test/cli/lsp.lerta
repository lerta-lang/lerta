# The language server reports diagnostics, formats documents, and answers hovers and definitions.
import Check from '../lib/report'
import compare_text, expect_status from '../lib/expect'
import compiler from '../lib/lerta'
import new_cli_dir, run_command from '../lib/cli'
import make_dir, write_file from 'std:io'
import encode_json from 'std:json'
import
  uri_of, frame, did_open, did_change, did_change_at, definition_request, hover_request,
  location_fragment, hover_fragment, initialize, finish, session, check_reason, message_bodies,
  diagnostic_body, published_diagnostics, initialize_response, shutdown_response, exact_responses,
  exact_messages
from '../lib/lsp'

const initialize_check = ->
  Check name: 'lerta lsp negotiates UTF-16 positions and exits after shutdown', run: ->
    const dir = new_cli_dir('lsp-initialize')
    const ran = await session(dir, '')
    const utf32_init = '{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"capabilities":{"general":{"positionEncodings":["utf-16","utf-32"]}}}}'
    const utf32_dir = new_cli_dir('lsp-utf32-no-shutdown')
    const utf32 = await run_command(
      compiler
      ['lsp']
      utf32_dir
      (frame(utf32_init) + frame('{"jsonrpc":"2.0","method":"exit"}')).binary
    )
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [initialize_response('utf-16'), shutdown_response].join("\n")
        message_bodies(ran.stdout.text()!).join("\n")
      )...
      expect_status(1, utf32.status)...
      compare_text(
        'responses'
        initialize_response('utf-32')
        message_bodies(utf32.stdout.text()!).join("\n")
      )...
    ]

const error_request_check = ->
  Check name: 'lerta lsp rejects an unsupported request but ignores its notification', run: ->
    const dir = new_cli_dir('lsp-error-request')
    const messages =
      frame('{"jsonrpc":"2.0","id":1,"method":"textDocument/references","params":{}}')
      frame('{"jsonrpc":"2.0","method":"$/setTrace","params":{"value":"off"}}')
      frame('{"jsonrpc":"2.0","id":2,"method":"textDocument/formatting","params":{}}')
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [
          initialize_response('utf-16')
          '{"jsonrpc":"2.0","id":1,"error":{"code":-32601,"message":"no method textDocument/references"}}'
          "{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32602,\"message\":#{encode_json('$.params: missing the key "textDocument"')}}}"
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const diagnostic_check = ->
  Check name: 'lerta lsp reports diagnostics for an opened document', run: ->
    const dir = new_cli_dir('lsp-diagnostics')
    const path = "#{dir}/a.lerta"
    await write_file(path, ''.binary)
    const uri = uri_of(path)
    const message = frame(
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"print missing\\n\"}}}"
    )
    const ran = await session(dir, message)
    [
      expect_status(0, ran.status)...
      compare_text(
        'messages'
        [
          initialize_response('utf-16')
          published_diagnostics(uri, [diagnostic_body(0, 6, 1, "undefined name 'missing'")])
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const diagnostic_lifecycle_check = ->
  Check name: 'lerta lsp updates and clears document diagnostics', run: ->
    const dir = new_cli_dir('lsp-diagnostic-lifecycle')
    const path = "#{dir}/a.lerta"
    await write_file(path, ''.binary)
    const uri = uri_of(path)
    const messages =
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"print missing\\n\"}}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"version\":2},\"contentChanges\":[{\"text\":\"const unused = 1\\n\"}]}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"version\":3},\"contentChanges\":[{\"text\":\"print 1\\n\"}]}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
      )
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      compare_text(
        'messages'
        [
          initialize_response('utf-16')
          published_diagnostics(uri, [diagnostic_body(0, 6, 1, "undefined name 'missing'")])
          published_diagnostics(uri, [diagnostic_body(0, 6, 2, "'unused' is never used")])
          published_diagnostics(uri, [])
          published_diagnostics(uri, [])
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const imported_diagnostic_check = ->
  Check name: 'lerta lsp reports imported diagnostics in UTF-16 positions', run: ->
    const dir = new_cli_dir('lsp-imported-diagnostic')
    const path = "#{dir}/a.lerta"
    const imported = "#{dir}/b.lerta"
    await write_file(path, ''.binary)
    await write_file(imported, "export const b = '😀' + nothing\n".binary)
    const uri = uri_of(path)
    const message = frame(
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"import b from './b'\\nprint b\\n\"}}}"
    )
    const ran = await session(dir, message)
    [
      expect_status(0, ran.status)...
      compare_text(
        'messages'
        [
          initialize_response('utf-16')
          published_diagnostics(uri, [])
          published_diagnostics(
            uri_of(imported)
            [diagnostic_body(0, 24, 1, "undefined name 'nothing'")]
          )
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const uri_import_check = ->
  Check name: 'lerta lsp imports through parent paths in percent-encoded URIs', run: ->
    const dir = new_cli_dir('lsp-uri-import')
    const nested = "#{dir}/folder"
    const path = "#{nested}/é file.lerta"
    const imported = uri_of("#{dir}/lib.lerta")
    make_dir nested
    await write_file(path, ''.binary)
    await write_file("#{dir}/lib.lerta", "export const x = missing\n".binary)
    const uri = uri_of(path)
    const message = frame(
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"import x from '../lib'\\nprint x\\n\"}}}"
    )
    const other_uri = did_open('untitled:Untitled-1', 'print missing\n')
    const formatting = frame(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{imported}\"}}}"
    )
    const ran = await session(dir, message + other_uri + formatting)
    [
      expect_status(0, ran.status)...
      exact_messages(
        ran.stdout.text()!
        [
          published_diagnostics(uri, [])
          published_diagnostics(imported, [diagnostic_body(0, 17, 1, "undefined name 'missing'")])
          '{"jsonrpc":"2.0","id":1,"result":null}'
        ]
      )...
    ]

const malformed_message_check = ->
  Check name: 'lerta lsp reports a malformed JSON message and continues', run: ->
    const dir = new_cli_dir('lsp-malformed-message')
    const ran = await session(dir, frame('{bad}'))
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [
          initialize_response('utf-16')
          "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32700,\"message\":#{encode_json("$: expected a key, found 'b'")}}}"
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const lsp_input_errors_check = ->
  Check name: 'lerta lsp rejects arguments and a message without Content-Length', run: ->
    const args = await run_command(compiler, ['lsp', 'extra'], new_cli_dir('lsp-arguments'))
    const missing_length = await run_command(
      compiler
      ['lsp']
      new_cli_dir('lsp-no-content-length')
      "Content-Length: x\r\n\r\n{}".binary
    )
    [
      expect_status(1, args.status)...
      compare_text('stderr', "lerta lsp takes no arguments\n", args.stderr.text()!)...
      expect_status(1, missing_length.status)...
      compare_text(
        'stderr'
        "an LSP message without its Content-Length\n"
        missing_length.stderr.text()!
      )...
    ]

const empty_body_check = ->
  Check name: 'lerta lsp reports empty message bodies as parse errors', run: ->
    const dir = new_cli_dir('lsp-empty-body')
    const path = "#{dir}/a.lerta"
    await write_file(path, ''.binary)
    const input =
      frame(initialize)
      frame('{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":1}}}')
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"#{uri_of(path)}\"},\"contentChanges\":[]}}"
      )
      "Content-Length: 0\r\n\r\nContent-Length: -1\r\n\r\n"
      finish
    .join('')
    const ran = await run_command(compiler, ['lsp'], dir, input.binary)
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [
          initialize_response('utf-16')
          '{"jsonrpc":"2.0","id":null,"error":{"code":-32700,"message":"$: expected an object, found the end of the text"}}'
          '{"jsonrpc":"2.0","id":null,"error":{"code":-32700,"message":"$: expected an object, found the end of the text"}}'
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const formatting_check = -> Check(name: 'lerta lsp formats an open document', run: ->
  const dir = new_cli_dir('lsp-formatting')
  const path = "#{dir}/a.lerta"
  await write_file(path, ''.binary)
  const uri = uri_of(path)
  const messages =
    frame(
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"const  value = 1\\nprint value\\n\"}}}"
    )
    frame(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
    )
    did_change_at(uri, "const value = 1\nprint value\n", 2)
    frame(
      "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
    )
    did_change_at(uri, "print (\n", 3)
    frame(
      "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
    )
  .join('')
  const ran = await session(dir, messages)
  [
    expect_status(0, ran.status)...
    exact_messages(
      ran.stdout.text()!
      [
        published_diagnostics(uri, [])
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":2,\"character\":0}},\"newText\":#{encode_json("const value = 1\nprint value\n")}}]}"
        published_diagnostics(uri, [])
        '{"jsonrpc":"2.0","id":2,"result":[]}'
        published_diagnostics(uri, [diagnostic_body(0, 6, 1, "'(' is never closed")])
        '{"jsonrpc":"2.0","id":3,"result":null}'
      ]
    )...
  ]
)

const formatting_new_document_check = ->
  Check name: 'lerta lsp formats a document that does not exist yet', run: ->
    const dir = new_cli_dir('lsp-format-new')
    const uri = uri_of("#{dir}/new.lerta")
    const emoji = "\u{1F600}"
    const text = "print  '#{emoji}'"
    const messages =
      did_open(uri, text)
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}"
      )
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      compare_text(
        'responses'
        [
          initialize_response('utf-16')
          "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":11}},\"newText\":#{encode_json("print '#{emoji}'\n")}}]}"
          shutdown_response
        ].join(
          "\n"
        )
        message_bodies(ran.stdout.text()!).join("\n")
      )...
    ]

const shared_import_check = ->
  Check name: 'lerta lsp checks shared imports for each open document', run: ->
    const dir = new_cli_dir('lsp-shared-import')
    await write_file("#{dir}/b.lerta", "export const b: Int = 'text'\n".binary)
    const c = uri_of("#{dir}/c.lerta")
    const d = uri_of("#{dir}/d.lerta")
    await write_file("#{dir}/c.lerta", ''.binary)
    await write_file("#{dir}/d.lerta", ''.binary)
    const imports = "import b from './b'\nprint b\n"
    const messages =
      did_open(c, imports)
      did_open(d, imports)
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"#{c}\"}}}"
      )
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_messages(
        ran.stdout.text()!
        [
          published_diagnostics(c, [])
          published_diagnostics(
            uri_of("#{dir}/b.lerta")
            [diagnostic_body(0, 22, 1, 'expected Int, got String')]
          )
          published_diagnostics(d, [])
          published_diagnostics(
            uri_of("#{dir}/b.lerta")
            [diagnostic_body(0, 22, 1, 'expected Int, got String')]
          )
          published_diagnostics(c, [])
          published_diagnostics(
            uri_of("#{dir}/b.lerta")
            [diagnostic_body(0, 22, 1, 'expected Int, got String')]
          )
        ]
      )...
    ]

const changed_import_check = ->
  Check name: 'lerta lsp rechecks open importers when an imported document changes', run: ->
    const dir = new_cli_dir('lsp-changed-import')
    await write_file("#{dir}/a.lerta", ''.binary)
    await write_file("#{dir}/b.lerta", ''.binary)
    const a = uri_of("#{dir}/a.lerta")
    const b = uri_of("#{dir}/b.lerta")
    const messages =
      did_open(b, "export const b = 'text'\n")
      did_open(a, "import b from './b'\nprint b\n")
      did_change(b, "export const c = 1\n")
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_messages(
        ran.stdout.text()!
        [
          published_diagnostics(b, [])
          published_diagnostics(a, [])
          published_diagnostics(b, [])
          published_diagnostics(b, [])
          published_diagnostics(a, [diagnostic_body(0, 7, 1, "'./b' has no export 'b'")])
          published_diagnostics(b, [])
        ]
      )...
    ]

const close_unsaved_import_check = ->
  Check name: 'lerta lsp uses an imported document file again when it closes', run: ->
    const dir = new_cli_dir('lsp-close-unsaved-import')
    await write_file("#{dir}/a.lerta", ''.binary)
    await write_file("#{dir}/b.lerta", "export const f = -> 1\n".binary)
    const a = uri_of("#{dir}/a.lerta")
    const b = uri_of("#{dir}/b.lerta")
    const messages =
      did_open(a, "import f from './b'\nprint f()\n")
      did_open(b, "export const f = -> 1\n")
      did_change(b, "export const f = -> zzz\n")
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"#{b}\"}}}"
      )
    .join('')
    const ran = await session(dir, messages)
    const last =
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"#{b}\",\"diagnostics\":[]}}"
      )
      frame('{"jsonrpc":"2.0","id":"end","result":null}')
    .join('')
    [
      expect_status(0, ran.status)...
      check_reason(
        ran.stdout.text()!.ends_with(last)
        'closing the unsaved import did not clear diagnostics from its disk contents'
      )...
    ]

const hover_definition_check = ->
  Check name: 'lerta lsp gives a value type and its declaration location', run: ->
    const dir = new_cli_dir('lsp-hover-definition')
    const path = "#{dir}/a.lerta"
    const text = "const value = 1\nprint value\n"
    await write_file(path, text.binary)
    const uri = uri_of(path)
    const messages =
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"const value = 1\\nprint value\\n\"}}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":1,\"character\":6}}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":1,\"character\":6}}}"
      )
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [hover_fragment(1, 'value: Int'), location_fragment(2, uri, 0, 6, 11)]
      )...
    ]

const generic_hover_check = ->
  Check name: 'lerta lsp gives generic values the types of their instances', run: ->
    const dir = new_cli_dir('lsp-generic-hover')
    const path = "#{dir}/a.lerta"
    const text = "const id = <T>(v: T) -> v\nprint id(1)\nprint id('a')\n"
    await write_file(path, text.binary)
    const uri = uri_of(path)
    const messages =
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"lerta\",\"version\":1,\"text\":\"const id = <T>(v: T) -> v\\nprint id(1)\\nprint id('a')\\n\"}}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":1,\"character\":6}}}"
      )
      frame(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":2,\"character\":6}}}"
      )
      hover_request(uri, 0, 24, 3)
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [
          hover_fragment(1, 'id: (Int) -> Int')
          hover_fragment(2, 'id: (String) -> String')
          hover_fragment(3, "v: Int\nv: String")
        ]
      )...
    ]

const definition_contexts_check = ->
  Check name: 'lerta lsp finds assigned fields, enum members, bindings, and methods', run: ->
    const dir = new_cli_dir('lsp-definition-contexts')
    const path = "#{dir}/a.lerta"
    const shades = "#{dir}/shades.lerta"
    const text =
      "import Shade from './shades'"
      'class K'
      '  v: Int = 1'
      '  inc = -> @v += 1'
      'const k = K()'
      'k.v = 3'
      'enum Color'
      '  RED'
      'const c = Color.RED'
      'const found: Int? = 1'
      'if const n = found'
      '  print n'
      'try'
      "  throw ValueError(message: 'x')"
      'catch error'
      '  print error.message'
      'k.inc()'
      'print c'
      'extend K'
      '  reset = -> @v = 0'
      'k.reset()'
      'print Shade.DARK'
      ''
    .join("\n")
    await write_file(path, ''.binary)
    await write_file(shades, "export enum Shade\n  LIGHT\n  DARK\n".binary)
    const uri = uri_of(path)
    const imported_uri = uri_of(shades)
    const messages =
      did_open(uri, text)
      definition_request(uri, 5, 2, 10)
      definition_request(uri, 3, 12, 11)
      definition_request(uri, 8, 16, 12)
      definition_request(uri, 11, 8, 13)
      definition_request(uri, 15, 8, 14)
      definition_request(uri, 19, 15, 15)
      definition_request(uri, 20, 2, 16)
      definition_request(uri, 16, 2, 17)
      definition_request(uri, 21, 12, 18)
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [
          location_fragment(10, uri, 2, 2, 3)
          location_fragment(11, uri, 2, 2, 3)
          location_fragment(12, uri, 7, 2, 5)
          location_fragment(13, uri, 10, 9, 10)
          location_fragment(14, uri, 14, 6, 11)
          location_fragment(15, uri, 2, 2, 3)
          location_fragment(16, uri, 19, 2, 7)
          location_fragment(17, uri, 3, 2, 5)
          location_fragment(18, imported_uri, 2, 2, 6)
        ]
      )...
    ]

const hover_contexts_check = ->
  Check name: 'lerta lsp finds assigned, generic, and UTF-16 names with their definitions', run: ->
    const dir = new_cli_dir('lsp-hover-contexts')
    const path = "#{dir}/a.lerta"
    const emoji = "\u{1F600}"
    const text =
      "const s = '#{emoji}'"
      'struct Box<T>(value: T)'
      'extend Int'
      '  twice = -> @ * 2'
      'var n = 1'
      'n = Box(value: 2).value.twice()'
      'print s + n.to_string()'
      "print '#{emoji}' + s"
      ''
    .join("\n")
    await write_file(path, ''.binary)
    const uri = uri_of(path)
    const messages =
      did_open(uri, text)
      hover_request(uri, 6, 6, 10)
      definition_request(uri, 6, 6, 11)
      hover_request(uri, 5, 0, 12)
      definition_request(uri, 5, 0, 13)
      hover_request(uri, 5, 6, 14)
      definition_request(uri, 5, 6, 15)
      hover_request(uri, 5, 18, 16)
      definition_request(uri, 5, 18, 17)
      hover_request(uri, 5, 26, 18)
      definition_request(uri, 5, 26, 19)
      hover_request(uri, 7, 13, 20)
      definition_request(uri, 7, 13, 21)
      hover_request(uri, 7, 14, 22)
      definition_request(uri, 7, 14, 23)
      hover_request(uri, 6, 15, 24)
      definition_request(uri, 6, 15, 25)
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [
          hover_fragment(10, 's: String')
          location_fragment(11, uri, 0, 6, 7)
          hover_fragment(12, 'n: Int')
          location_fragment(13, uri, 4, 4, 5)
          hover_fragment(14, 'Box: Box<Int>')
          location_fragment(15, uri, 1, 7, 10)
          hover_fragment(16, 'value: Int')
          location_fragment(17, uri, 1, 14, 19)
          hover_fragment(18, 'twice: () -> Int')
          location_fragment(19, uri, 3, 2, 7)
          hover_fragment(20, 's: String')
          location_fragment(21, uri, 0, 6, 7)
          hover_fragment(22, 's: String')
          location_fragment(23, uri, 0, 6, 7)
          hover_fragment(24, 'to_string: () -> String')
          '"id":25,"result":null'
        ]
      )...
    ]

const optional_and_interpolation_check = ->
  Check(
    name: 'lerta lsp finds optional fields and interpolation names, not unrelated positions'
    run: ->
      const dir = new_cli_dir('lsp-optional-interpolation')
      const path = "#{dir}/a.lerta"
      const text =
        'struct P(x: Int)'
        'const f = (p: P?) -> p?.x'
        'class C'
        '  x: Int = 1'
        '  get = -> @x'
        'print C().get()'
        'print f(nil) == nil'
        'print "#{C().x}"'
        'const g = (p: P?) -> p?.x.to_string()'
        'const to_string_value = 1'
        'print "#{to_string_value}"'
        ''
      .join("\n")
      await write_file(path, ''.binary)
      const uri = uri_of(path)
      const other = uri_of("#{dir}/other.lerta")
      const messages =
        did_open(uri, text)
        hover_request(uri, 7, 13, 10)
        definition_request(uri, 7, 13, 11)
        hover_request(uri, 7, 15, 12)
        definition_request(uri, 7, 15, 13)
        hover_request(uri, 8, 28, 14)
        definition_request(uri, 8, 28, 15)
        hover_request(uri, 10, 10, 16)
        definition_request(uri, 10, 10, 17)
        hover_request(uri, 1, 24, 18)
        definition_request(uri, 1, 24, 19)
        hover_request(uri, 4, 12, 20)
        definition_request(uri, 4, 12, 21)
        hover_request(uri, 5, 40, 22)
        definition_request(uri, 5, 40, 23)
        hover_request(uri, 30, 0, 24)
        definition_request(uri, 30, 0, 25)
        hover_request(other, 0, 0, 26)
        definition_request(other, 0, 0, 27)
      .join('')
      const ran = await session(dir, messages)
      [
        expect_status(0, ran.status)...
        exact_responses(
          ran.stdout.text()!
          [
            hover_fragment(10, 'x: Int')
            location_fragment(11, uri, 3, 2, 3)
            '"id":12,"result":null'
            '"id":13,"result":null'
            hover_fragment(14, 'to_string: () -> String')
            '"id":15,"result":null'
            hover_fragment(16, 'to_string_value: Int')
            location_fragment(17, uri, 9, 6, 21)
            hover_fragment(18, 'x: Int')
            location_fragment(19, uri, 0, 9, 10)
            hover_fragment(20, 'x: Int')
            location_fragment(21, uri, 3, 2, 3)
            '"id":22,"result":null'
            '"id":23,"result":null'
            '"id":24,"result":null'
            '"id":25,"result":null'
            '"id":26,"result":null'
            '"id":27,"result":null'
          ]
        )...
      ]
  )

const open_import_hover_check = ->
  Check name: 'lerta lsp answers for an imported file in an open program', run: ->
    const dir = new_cli_dir('lsp-open-import-hover')
    const a_path = "#{dir}/a.lerta"
    const b_path = "#{dir}/b.lerta"
    const b_text = "export const b = 1\n"
    await write_file(a_path, ''.binary)
    await write_file(b_path, b_text.binary)
    const a = uri_of(a_path)
    const b = uri_of(b_path)
    const messages =
      did_open(a, "import b from './b'\nprint b\n")
      hover_request(b, 0, 13, 10)
      did_open(b, b_text)
      frame(
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"#{a}\"}}}"
      )
      hover_request(a, 1, 6, 11)
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [hover_fragment(10, 'b: Int'), '"id":11,"result":null']
      )...
    ]

const definitions_after_error_check = ->
  Check name: 'lerta lsp finds locals after errors, destructured, loop, and captured names', run: ->
    const dir = new_cli_dir('lsp-definitions-after-error')
    const path = "#{dir}/a.lerta"
    const text =
      'const n = [1].length'
      'print n + zz'
      'const q = 2'
      'print q'
      'const (a, b) = (1, 2)'
      'for item in [a]'
      '  print item + b'
      'const add = (x: Int) -> -> x + 1'
      'print add(1)()'
      ''
    .join("\n")
    await write_file(path, ''.binary)
    const uri = uri_of(path)
    const messages =
      did_open(uri, text)
      definition_request(uri, 3, 6, 10)
      definition_request(uri, 6, 8, 11)
      definition_request(uri, 6, 15, 12)
      definition_request(uri, 7, 27, 13)
      did_change(uri, "import x from './missing'\nprint n + zz\n")
      hover_request(uri, 1, 6, 20)
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [
          location_fragment(10, uri, 2, 6, 7)
          location_fragment(11, uri, 5, 4, 8)
          location_fragment(12, uri, 4, 10, 11)
          location_fragment(13, uri, 7, 13, 14)
          '"id":20,"result":null'
        ]
      )...
    ]

const imported_hover_definition_check = ->
  Check(
    name: 'lerta lsp gives imported, field, and generic values their types and definitions'
    run: ->
      const dir = new_cli_dir('lsp-imported-hover-definition')
      const lib = "#{dir}/lib.lerta"
      const path = "#{dir}/a.lerta"
      const text = "import make from './lib'\nconst p = make(1)\nprint p.x\nconst id = <T>(v: T) -> v\nprint id(1) + id(2)\nprint id('a')\n"
      await write_file(
        lib
        "export struct Point(x: Int, y: Int)\nexport const make = (x: Int) -> Point(x, y: 0)\n".binary
      )
      await write_file(path, ''.binary)
      const uri = uri_of(path)
      const asks = [(1, 10), (2, 8), (3, 24), (4, 6), (5, 6), (0, 7), (1, 4)]
      const messages = [did_open(uri, text)]
      for ask, i in asks
        const (line, character) = ask
        messages.push hover_request(uri, line, character, 10 + 2 * i)
        messages.push definition_request(uri, line, character, 11 + 2 * i)
      const ran = await session(dir, messages.join(''))
      [
        expect_status(0, ran.status)...
        exact_responses(
          ran.stdout.text()!
          [
            hover_fragment(10, 'make: (Int) -> Point')
            location_fragment(11, uri_of(lib), 1, 13, 17)
            hover_fragment(12, 'x: Int')
            location_fragment(13, uri_of(lib), 0, 20, 21)
            hover_fragment(14, "v: Int\nv: String")
            location_fragment(15, uri, 3, 15, 16)
            hover_fragment(16, 'id: (Int) -> Int')
            location_fragment(17, uri, 3, 6, 8)
            hover_fragment(18, 'id: (String) -> String')
            location_fragment(19, uri, 3, 6, 8)
            '"id":20,"result":null'
            location_fragment(21, uri_of(lib), 1, 13, 17)
            '"id":22,"result":null'
            '"id":23,"result":null'
          ]
        )...
      ]
  )

const extern_definition_check = ->
  Check name: 'lerta lsp finds extern definitions in the current and imported modules', run: ->
    const dir = new_cli_dir('lsp-extern-definition')
    const path = "#{dir}/a.lerta"
    const text = "import int_text, int_text as t from './conversions'\nextern lerta_int_to_string as text_of: (Int) -> String\nprint text_of(1)\nprint int_text(2)\nprint t(3)\n"
    await write_file(path, ''.binary)
    await write_file(
      "#{dir}/conversions.lerta"
      "export extern lerta_int_to_string as int_text: (Int) -> String\n".binary
    )
    const uri = uri_of(path)
    const messages =
      did_open(uri, text)
      definition_request(uri, 2, 6, 1)
      definition_request(uri, 3, 6, 2)
      definition_request(uri, 0, 7, 3)
      definition_request(uri, 4, 6, 4)
      definition_request(uri, 0, 30, 5)
    .join('')
    const ran = await session(dir, messages)
    [
      expect_status(0, ran.status)...
      exact_responses(
        ran.stdout.text()!
        [
          location_fragment(1, uri, 1, 30, 37)
          location_fragment(2, uri_of("#{dir}/conversions.lerta"), 0, 37, 45)
          location_fragment(3, uri_of("#{dir}/conversions.lerta"), 0, 37, 45)
          location_fragment(4, uri_of("#{dir}/conversions.lerta"), 0, 37, 45)
          location_fragment(5, uri_of("#{dir}/conversions.lerta"), 0, 37, 45)
        ]
      )...
    ]

