# A Lerta program links with a C function given as C or Objective-C source, IR, an object or an
# archive.
import Check, posix_check from '../lib/report'
import compare_text, expect_status, reason_unless from '../lib/expect'
import compiler, root_dir, host_executable_suffix from '../lib/lerta'
import expect_success, succeed, run_command, run_in_new_dir, new_cli_dir from '../lib/cli'
import make_dir, make_link, read_file, write_file from 'std:io'
import platform from 'std:process'

source_dir := "#{root_dir}/tests/extern/lib"
source := "#{source_dir}/twice.lerta"
c_source := "#{source_dir}/twice.c"

run_tool := (command: String, args: String[], cwd: String) ->
  ran := await run_command(command, args, cwd)
  succeed command, ran

compile_c := (kind: String, output: String, cwd: String) ->
  flags := kind == '.o' then ['-c'] else ['-S', '-emit-llvm']
  await run_tool('clang', [flags..., c_source, '-o', output], cwd)
  output

archive := (object: String, output: String, cwd: String) ->
  await run_tool('ar', ['rcs', output, object], cwd)
  output

input_file := (extension: String, name: String, cwd: String) ->
  return c_source if extension == '.c'
  output := "#{cwd}/twice-#{name}#{extension}"
  if extension == '.a'
    object := await compile_c('.o', "#{cwd}/twice-#{name}.o", cwd)
    return await archive(object, output, cwd)
  await compile_c(extension, output, cwd)

build_twice := (file: String, flags: String[], cwd: String, name: String) ->
  executable := "#{cwd}/#{name}#{host_executable_suffix}"
  built := await run_command(compiler, ['build', source, file, '-o', executable, flags...], cwd)
  succeed 'build', built
  ran := await run_command(executable, [], cwd)
  [compare_text('stdout', "42\n", ran.stdout_text())..., expect_success('run', ran)...]

link_check := (extension: String, flags: String[]) ->
  Check name: "lerta build <source> <file#{extension}> #{flags.join(' ')} links the file", run: ->
    dir := new_cli_dir("extern-#{extension}-#{flags.join('_')}")
    file := await input_file(extension, "input-#{flags.join('_')}", dir)
    await build_twice(file, flags, dir, "twice-#{extension}-#{flags.join('_')}")

# The Objective-C source needs Foundation, which `--linker-flag` links.
objective_c_check := (optimization: String[]) ->
  flags := ['--linker-flag', '-framework,Foundation', optimization...]
  name := optimization.join('_')
  Check name: "lerta build <source> <file.m> #{flags.join(' ')} links the file", run: ->
    return nil unless platform == 'macos'
    dir := new_cli_dir("extern-objc-#{name}")
    await build_twice("#{source_dir}/twice.m", flags, dir, "twice-objc-#{name}")

# Each `--linker-flag` reaches the linker, in order: `-framework` and then its name.
split_linker_flags_check := ->
  flags := ['--linker-flag', '-framework', '--linker-flag', 'Foundation']
  Check name: "lerta run <source> <file.m> #{flags.join(' ')} links the file", run: ->
    return nil unless platform == 'macos'
    dir := new_cli_dir('extern-objc-split')
    ran := await run_command(compiler, ['run', source, "#{source_dir}/twice.m", flags...], dir)
    [compare_text('stdout', "42\n", ran.stdout_text())..., expect_success('run', ran)...]

# Without Foundation, which only `--linker-flag` links, the link fails.
objective_c_without_framework_check := ->
  Check name: 'lerta build <source> <file.m> fails to link without its framework', run: ->
    return nil unless platform == 'macos'
    built :=
      await run_in_new_dir(compiler, ['build', source, "#{source_dir}/twice.m", '-o', 'prog'])
    # The class that twice.m uses, which the linker reports as undefined.
    symbol := '_OBJC_CLASS_$_NSNumber'
    [
      expect_status(1, built.result.status)...
      reason_unless(built.result.stderr_text().contains(symbol), "no '#{symbol}' on stderr")...
    ]

objective_c_off_macos_check := ->
  Check name: 'lerta build rejects an Objective-C file for a target other than macOS', run: ->
    objective_c := "#{source_dir}/twice.m"
    built := await run_in_new_dir(
      compiler
      ['build', source, objective_c, '-o', 'prog', '--target', 'linux-amd64']
    )
    message := "'#{objective_c}' is Objective-C, which links only for macOS"
    [
      expect_status(1, built.result.status)...
      reason_unless(built.result.stderr_text().contains(message), "no '#{message}' on stderr")...
    ]

inputs := ['.c', '.o', '.ll', '.a']
optimizations: String[][] = [[], ['-O']]
relative_link_check := -> Check(name: 'lerta build links a file given by a relative path', run: ->
  dir := new_cli_dir('extern-relative')
  await write_file("#{dir}/twice.c", await read_file(c_source))
  await build_twice('twice.c', [], dir, 'twice-relative')
)

# The system resolves a `..` after a name that is a symbolic link to the directory the link points
# into, where the linked file is, as clang found it before the link ran in
# the build's own directory.
symlink_link_check := ->
  # Wine makes symbolic links but does not follow them (see std:io in the reference).
  posix_check 'lerta build links a file whose path goes through a symbolic link', ->
    dir := new_cli_dir('extern-symlink')
    make_dir "#{dir}/under"
    make_dir "#{dir}/under/below"
    make_link 'under/below', "#{dir}/link"
    await write_file("#{dir}/under/twice.c", await read_file(c_source))
    await build_twice('link/../twice.c', [], dir, 'twice-symlink')

# A `..` after a name that is not there names no file for the system, which clang reports, as it did
# when it ran in the directory the build was started in (see real_path in std:io in the reference).
missing_link_check := ->
  # Windows works a `..` out as text (see real_path in std:io in the reference), so it is found
  # there.
  posix_check 'lerta build reports a linked file that only its path as text names', ->
    dir := new_cli_dir('extern-missing')
    await write_file("#{dir}/twice.c", await read_file(c_source))
    built := await run_command(compiler, ['build', source, 'missing/../twice.c', '-o', 'prog'], dir)
    expect_status 1, built.status

# A linked C or Objective-C file includes the runtime's header without a flag of its own.
header_check := (extension: String, flags: String[]) ->
  name := "#{extension}#{flags.join('_')}"
  Check name: "lerta build <source> <file#{extension}> #{flags.join(' ')} finds lerta.h", run: ->
    return nil if extension == '.m' and platform != 'macos'
    dir := new_cli_dir("extern-header-#{name}")
    executable := "#{dir}/greeting#{host_executable_suffix}"
    file := "#{source_dir}/greeting#{extension}"
    args := ['build', "#{source_dir}/greeting.lerta", file, '-o', executable, flags...]
    succeed 'build', await run_command(compiler, args, dir)
    ran := await run_command(executable, [], dir)
    [compare_text('stdout', "hello\n", ran.stdout_text())..., expect_success('run', ran)...]

export checks: Check[]
for extension in inputs
  checks.push link_check(extension, flags) for flags in optimizations
checks.push objective_c_check(flags) for flags in optimizations
for extension in ['.c', '.m']
  checks.push header_check(extension, flags) for flags in optimizations
checks.push split_linker_flags_check()
checks.push objective_c_without_framework_check()
checks.push objective_c_off_macos_check()
checks.push relative_link_check()
checks.push symlink_link_check()
checks.push missing_link_check()
