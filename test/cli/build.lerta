# Building programs, and checking the files a build leaves.
import Check from '../lib/report'
import compare_output, compare_text, expect_status from '../lib/expect'
import compiler, root_dir from '../lib/lerta'
import
  executable_suffix, expect_left, expect_success, hello_output, run_command, run_in_dir,
  run_in_new_dir, cli_work_dir, new_cli_dir, new_cli_dirs, runtime_flags, host_platform
from '../lib/cli'
import is_file, list_dir, make_dir, make_link, read_file, write_file from 'std:io'
import env from 'std:process'

hello := "#{root_dir}/examples/hello.lerta"
no_build_flags: String[]
no_reasons: String[]

build_and_run := (flags: String[]) ->
  Check name: "lerta build examples/hello.lerta #{flags.join(' ')} and run it", run: ->
    built := await run_in_new_dir(
      compiler
      [
        'build'
        hello
        '-o'
        "#{cli_work_dir}/hello-#{flags.join('_')}#{executable_suffix}"
        flags...
      ]
    )
    reasons := expect_success('build', built.result)
    return reasons if not reasons.is_empty()
    executable := "#{cli_work_dir}/hello-#{flags.join('_')}#{executable_suffix}"
    ran := await run_command(executable, [], built.cwd)
    [compare_output('stdout', hello_output, ran.stdout)..., expect_success('run', ran)...]

default_output_check := ->
  Check name: 'lerta build examples/hello.lerta writes hello to the current directory', run: ->
    built := await run_in_new_dir(compiler, ['build', hello])
    return expect_success('build', built.result) if built.result.status != 0
    executable := "#{built.cwd}/hello#{executable_suffix}"
    ran := await run_command(executable, [], built.cwd)
    [
      expect_left('files left', ["hello#{executable_suffix}"], built.left)...
      expect_left('files left in the temporary directory', [], built.left_in_temp)...
      compare_output('stdout', hello_output, ran.stdout)...
      expect_success('run', ran)...
    ]

leading_dash_check := ->
  Check name: 'lerta build accepts source and output names that start with a dash', run: ->
    (cwd, temp) := new_cli_dirs()
    await write_file("#{cwd}/-hi.lerta", await read_file(hello))
    built := await run_in_dir(compiler, ['build', './-hi.lerta', '-o', '-hi'], cwd, temp)
    return expect_success('build', built.result) if built.result.status != 0
    executable := "#{cwd}/-hi#{executable_suffix}"
    ran := await run_command(executable, [], cwd)
    [
      expect_left('files left', ["-hi#{executable_suffix}", '-hi.lerta'], built.left)...
      expect_left('files left in the temporary directory', [], built.left_in_temp)...
      compare_output('stdout', hello_output, ran.stdout)...
      expect_success('run', ran)...
    ]

# Each output names, by another path, a file that the build reads.
struct InputCase
  what: String
  input: String
  args: String[]

input_cases: InputCase[] =
  { what: 'the source', input: 'hello.lerta', args: ['hello.lerta', '-o', './hello.lerta'] }
  {
    what: 'a linked file'
    input: 'extern.c'
    args: ['hello.lerta', 'extern.c', '-o', 'lib/../extern.c']
  }
  {
    what: 'an imported module'
    input: 'lib/greeting.lerta'
    args: ['main.lerta', '-o', 'lib/greeting.lerta']
  }
  {
    what: 'a symlink to the source'
    input: 'hello.lerta'
    args: ['hello.lerta', '-o', 'link.lerta']
  }

make_inputs := (cwd: String) ->
  make_dir "#{cwd}/lib"
  await write_file("#{cwd}/hello.lerta", await read_file(hello))
  await write_file("#{cwd}/extern.c", ''.binary)
  await write_file(
    "#{cwd}/main.lerta"
    "import greeting from './lib/greeting'\nprint greeting\n".binary
  )
  await write_file("#{cwd}/lib/greeting.lerta", "export greeting := 'hi'\n".binary)
  make_link "#{cwd}/hello.lerta", "#{cwd}/link.lerta"

input_check := (test: InputCase) ->
  Check name: "lerta build rejects an output that is #{test.what}", run: ->
    (cwd, temp) := new_cli_dirs()
    await make_inputs(cwd)
    before := await read_file("#{cwd}/#{test.input}")
    built := await run_in_dir(compiler, ['build', test.args...], cwd, temp)
    [
      expect_status(1, built.result.status)...
      compare_text(
        'stderr'
        "the output '#{test.args.last()!}' is an input of the build\n"
        built.result.stderr.text()!
      )...
      compare_output(test.input, before, await read_file("#{cwd}/#{test.input}"))...
    ]

input_checks := [input_check(test) for test in input_cases]

# The system resolves a `..` after a name that is a symbolic link to the directory the link points
# into, where the output must be written, as clang wrote it before the link ran in the build's own
# directory.
symlink_output_check := ->
  Check name: 'lerta build writes an output whose path goes through a symbolic link', run: ->
    # Wine makes symbolic links but does not follow them (see std:io in the reference).
    return nil if host_platform == 'windows'
    (cwd, temp) := new_cli_dirs()
    make_dir "#{cwd}/under"
    make_dir "#{cwd}/under/below"
    make_link 'under/below', "#{cwd}/link"
    built := await run_in_dir(compiler, ['build', hello, '-o', 'link/../hello'], cwd, temp)
    reasons := expect_success('build', built.result)
    return reasons if not reasons.is_empty()
    executable := "#{cwd}/under/hello#{executable_suffix}"
    ran := await run_command(executable, [], cwd)
    [
      expect_left('files left', ['link', 'under'], built.left)...
      expect_left('files left in the temporary directory', [], built.left_in_temp)...
      compare_output('stdout', hello_output, ran.stdout)...
      expect_success('run', ran)...
    ]

# An output whose directory is not there is clang's to report: the path worked out as text may name
# another directory that is there, by a `..` after a symbolic link or after a name that is not there
# (see real_path in std:io in the reference), which the build must not write into instead. An output
# that names a directory is clang's to report too, rather than the file its name as text would be.
missing_output_directory_check := ->
  Check name: 'lerta build reports an output directory that only the path as text has', run: ->
    # Wine makes symbolic links but does not follow them (see std:io in the reference).
    return nil if host_platform == 'windows'
    (cwd, temp) := new_cli_dirs()
    make_dir "#{cwd}/under"
    make_dir "#{cwd}/under/below"
    make_dir "#{cwd}/beside"
    make_link 'under/below', "#{cwd}/link"
    reasons: String[]
    for output in [
      'link/../beside/hello'
      'missing/../beside/hello'
      'missing/../hello'
      'missing/'
    ]
      built := await run_in_dir(compiler, ['build', hello, '-o', output], cwd, temp)
      reasons.append expect_status(1, built.result.status)
      reasons.append
        expect_left("files left for #{output}", ['beside', 'link', 'under'], built.left)
      reasons.append
        expect_left("files left in beside for #{output}", [], list_dir("#{cwd}/beside"))
      reasons.append expect_left("temporary files left for #{output}", [], built.left_in_temp)
    reasons

# A `..` after a name that is not there names no file for the system, so an output written there as
# text would be an input of the build that reject_input_as_output does not see.
missing_input_output_check := ->
  Check name: 'lerta build does not write an input that only the output path as text names', run: ->
    # Windows works a `..` out as text (see real_path in std:io in the reference), so the output
    # does name the input there, which only reject_input_as_output could tell.
    return nil if host_platform == 'windows'
    (cwd, temp) := new_cli_dirs()
    source := "#{cwd}/hi.lerta"
    await write_file(source, await read_file(hello))
    before := await read_file(source)
    built :=
      await run_in_dir(compiler, ['build', 'hi.lerta', '-o', 'missing/../hi.lerta'], cwd, temp)
    [
      expect_status(1, built.result.status)...
      compare_output('hi.lerta', before, await read_file(source))...
      expect_left('files left', ['hi.lerta'], built.left)...
      expect_left('files left in the temporary directory', [], built.left_in_temp)...
    ]

# The build resolves its temporary directory, which the link runs in, so one given by a relative
# path names the same directory for the compiler and for clang.
relative_temp_check := ->
  Check name: 'lerta build takes a temporary directory given by a relative path', run: ->
    cwd := new_cli_dir('relative-temp')
    temp := "#{cwd}/temp"
    make_dir temp
    environment := { 'TMPDIR': 'temp', 'TEMP': 'temp', 'TMP': 'temp' }
    built :=
      await run_command(compiler, ['build', hello, '-o', 'hello'], cwd, ''.binary, environment)
    reasons := expect_success('build', built)
    return reasons if not reasons.is_empty()
    ran := await run_command("#{cwd}/hello#{executable_suffix}", [], cwd)
    [
      expect_left('files left in the temporary directory', [], list_dir(temp))...
      compare_output('stdout', hello_output, ran.stdout)...
      expect_success('run', ran)...
    ]

no_clang_check := ->
  Check name: 'lerta build removes temporary files when clang cannot be started', run: ->
    cache := new_cli_dir('no-clang-cache')
    env := { 'LERTA_CACHE_DIR': cache, 'PATH': cli_work_dir }
    built := await run_in_new_dir(compiler, ['build', hello, '-o', 'hello'], ''.binary, env)
    [
      expect_status(1, built.result.status)...
      expect_left('files left', [], built.left)...
      expect_left('files left in the temporary directory', [], built.left_in_temp)...
      expect_left('files left in the cache', [], list_dir(cache))...
    ]

failed_target_check := ->
  Check name: 'lerta build removes temporary files when clang rejects a target', run: ->
    cache := new_cli_dir('failed-target-cache')
    env := { 'LERTA_CACHE_DIR': cache }
    built := await run_in_new_dir(
      compiler
      ['build', hello, '-o', 'hello', '--target', 'no-such-target']
      ''.binary
      env
    )
    [
      expect_status(1, built.result.status)...
      expect_left('files left', [], built.left)...
      expect_left('files left in the temporary directory', [], built.left_in_temp)...
      expect_left('files left in the cache', [], list_dir(cache))...
    ]

optimized_runtime_check := ->
  Check name: 'lerta build -O inlines the runtime into the program', run: ->
    source := "#{root_dir}/tests/string/split.lerta"
    built :=
      await run_in_new_dir(compiler, ['build', source, '-o', "split#{executable_suffix}", '-O'])
    reasons := expect_success('build', built.result)
    return reasons if not reasons.is_empty()
    executable := "#{built.cwd}/split#{executable_suffix}"
    disassembler := host_platform == 'macos' then 'otool' else 'objdump'
    # Without the bytes of each instruction, which the check does not read, objdump's output stays
    # under the limit that the tests put on a command's output.
    objdump_args := ['-d', '--no-show-raw-insn', executable]
    args := host_platform == 'macos' then ['-tvV', executable] else objdump_args
    code := await run_command(disassembler, args, built.cwd)
    return ["#{disassembler} failed: #{code.stderr.text()!}"] if code.status != 0
    lines := code.stdout.text()!.split("\n")
    # objdump shows a call as `call   1234 <lerta_retain>`, otool as `bl\t_lerta_retain`.
    is_call_opcode := (word: String) ->
      word.starts_with('call') or word == 'jmp' or word == 'bl' or word == 'b'
    names_retain := (word: String) ->
      parts := word.split('lerta_retain')
      parts.slice(1).any((after) ->
        bytes := after.binary
        return true if bytes.is_empty()
        next := bytes[0]
        not (next.is_letter() or next.is_digit() or next == '_'.binary[0])
      )
    is_call := (line: String) ->
      words := [word for word in line.replace("\t", ' ').split(' ') when word != '']
      opcode_index := words.find_index(is_call_opcode) ? return false
      [words[i] for i in (opcode_index + 1)...words.length].any(names_retain)
    if lines.any(is_call)
      ['lerta_retain is not inlined']
    else
      no_reasons

dump_llvm_check := -> Check(name: 'lerta dump-llvm prints the IR and leaves no file', run: ->
  dumped := await run_in_new_dir(compiler, ['dump-llvm', hello])
  ir := dumped.result.stdout.text()!
  ir_reasons: String[]
  ir_reasons.push 'no lerta_main in the IR' if 'define external void @lerta_main()' not in ir
  ir_reasons.push 'target attributes in the IR' if 'attributes #' in ir
  [
    expect_status(0, dumped.result.status)...
    ir_reasons...
    expect_left('files left', [], dumped.left)...
    expect_left('files left in the temporary directory', [], dumped.left_in_temp)...
  ]
)

# A branch to a throw carries the weights of one seldom taken: to an unwinding after a call, to an
# overflow's throw and to the throw of an Iter resumed while it runs, of a program with each.
dump_seldom_check := ->
  Check name: 'lerta dump-llvm weighs the branches to a throw as seldom', run: ->
    sources := ["#{root_dir}/bench/fib/main.lerta", "#{root_dir}/tests/yield/basic.lerta"]
    reasons: String[]
    lines: String[]
    for source in sources
      dumped := await run_in_new_dir(compiler, ['dump-llvm', source])
      reasons.append expect_status(0, dumped.result.status)
      lines.append dumped.result.stdout.text()!.split("\n")
    weights := '!prof !{!"branch_weights", i32 1, i32 2000}'
    targets := ['label %unwind.', 'label %raise.', 'label %generator.reject.']
    to := (line: String, target: String) -> line.starts_with('  br i1 ') and target in line
    for target in targets
      branches := [line for line in lines when to(line, target)]
      reasons.push "no branch to #{target}" if branches.is_empty()
      reasons.append ["no weights: #{line}" for line in branches when weights not in line]
    reasons

# The lines of the body of the program's function with the name, among the lines of the IR, or nil
# where the module defines no such function; a thunk that passes it as a value is not it.
function_body := (lines: String[], name: String): String[]? ->
  is_definition := (line: String) -> line.starts_with('define ') and '@"lerta.fn.' in line
  start := lines.find_index((line) -> is_definition(line) and line.contains(".#{name}\"("))
  return nil if start == nil
  var last = start
  last += 1 while lines[last] != '}'
  lines.slice start, last

JOINED_LITERALS := "#{root_dir}/tests/string/joined_literals.lerta"

# Literals joined by `+` are one String in the IR, which the runtime does not join.
dump_joined_literals_check := ->
  Check name: 'lerta dump-llvm joins String literals joined by +', run: ->
    dumped := await run_in_new_dir(compiler, ['dump-llvm', JOINED_LITERALS])
    ir := dumped.result.stdout.text()!
    reasons := expect_status(0, dumped.result.status)
    body := function_body(ir.split("\n"), 'joined') ? return [reasons..., 'no function joined']
    reasons.push 'a call in joined' if body.any((line) -> 'call ' in line)
    joined_text :=
      'a text too long for a line of its own, which is split over lines, with an escape\09' +
        'and joined by the compiler'
    reasons.push 'no joined literal' if joined_text not in ir
    reasons

UNCHECKED_METHODS := "#{root_dir}/tests/operator/unchecked_methods.lerta"

# A builtin method after which no exception is pending is not followed by a check for one: no
# function of the program that calls one alone reads the pending exception, but those that call
# the operator of a String or a Binary.
dump_unchecked_methods_check := ->
  Check name: 'lerta dump-llvm checks for no exception after a builtin that leaves none', run: ->
    dumped := await run_in_new_dir(compiler, ['dump-llvm', UNCHECKED_METHODS])
    lines := dumped.result.stdout.text()!.split("\n")
    unchecked :=
      'code'
      'char_of'
      'small'
      'as_float'
      'wrapped'
      'compared'
      'float_compared'
      'char_compared'
      'named'
      'literal'
      'added'
      'negated'
      'float_quotient'
    checked := ['joined', 'bytes_joined']
    reads_exception := (body: String[]) ->
      body.any (line) -> 'load ptr, ptr @lerta_exception' in line
    reasons := expect_status(0, dumped.result.status)
    for name in [unchecked..., checked...]
      body := function_body(lines, name)
      if body == nil
        reasons.push "no function #{name}"
        continue
      expected := name in checked
      if reads_exception(body) != expected
        reasons.push "#{name} #{expected then 'does not read' else 'reads'} the pending exception"
    reasons

# The float operations that the ranges of Floats show give no NaN check for none, and those that a
# rule of the ranges almost applies to still check (see tests/float/ranges.lerta).
dump_float_ranges_check := ->
  Check name: 'lerta dump-llvm checks no NaN where the ranges of Floats give none', run: ->
    dumped := await run_in_new_dir(compiler, ['dump-llvm', "#{root_dir}/tests/float/ranges.lerta"])
    lines := dumped.result.stdout.text()!.split("\n")
    unchecked :=
      'bounded_loop'
      'squares'
      'halved'
      'by_negative'
      'mirrored'
      'bounded_local'
      'nonnegative_sum'
      'negated_squares'
      'by_integer'
      'bounded_and'
      'square_only'
    checked :=
      'unbounded'
      'not_square'
      'signed_sum'
      'reassigned'
      'looped'
      'after_loop'
      'captured'
      'in_catch'
      'after_if'
      'divided'
      'fourth'
      'by_zero'
      'by_bounded'
      'in_for'
      'in_case'
      'in_finally'
      'if_value'
      'by_equality'
      'by_or'
      'below_negative'
      'narrow32'
      'from_uint64'
      'reads_shared'
      'unbounded_and'
      'product_only'
    reasons := expect_status(0, dumped.result.status)
    for name in [unchecked..., checked...]
      body := function_body(lines, name)
      if body == nil
        reasons.push "no function #{name}"
        continue
      expected := name in checked
      checks := body.any((line) -> ' = fcmp uno ' in line)
      if checks != expected
        reasons.push "#{name} #{expected then 'does not check' else 'checks'} for NaN"
    # An operation of no tree checks alone: the division of calls checks, the subtraction does not.
    spread := function_body(lines, 'spread') ? return [reasons..., 'no function spread']
    count := spread.filter((line) -> ' = fcmp uno ' in line).count()
    reasons.push "spread checks for NaN #{count} times, not once" if count != 1
    reasons

# The writes of Float fields that follow one another in grow are a batch, which one branch checks
# for NaN before it stores them, and takes them one by one only where one is NaN.
dump_batched_writes_check := ->
  Check name: 'lerta dump-llvm checks a batch of writes of Float fields at once', run: ->
    source := "#{root_dir}/tests/float/nan_in_batched_writes_trace.lerta"
    dumped := await run_in_new_dir(compiler, ['dump-llvm', source])
    reasons := expect_status(0, dumped.result.status)
    body := function_body(dumped.result.stdout.text()!.split("\n"), 'grow')
    return [reasons..., 'no function grow'] if not body
    batches := body.filter((line) -> line.starts_with('nan.one.by.one.')).count()
    reasons.push "grow has #{batches} batches, not one" if batches != 1
    reasons

# `x -= e`, where e is a tree, checks for NaN once, at the subtraction, of a local and of a field.
dump_compound_tree_check := ->
  Check name: 'lerta dump-llvm checks a compound assignment of a tree for NaN once', run: ->
    source := "#{root_dir}/tests/float/nan_in_compound_tree_trace.lerta"
    dumped := await run_in_new_dir(compiler, ['dump-llvm', source])
    reasons := expect_status(0, dumped.result.status)
    body := function_body(dumped.result.stdout.text()!.split("\n"), 'shrink')
    return [reasons..., 'no function shrink'] if not body
    count := body.filter((line) -> ' = fcmp uno ' in line).count()
    reasons.push "shrink checks for NaN #{count} times, not twice" if count != 2
    reasons

REMADE_IN_LOOPS := "#{root_dir}/tests/iter/remade_in_loops.lerta"

# A closure reads each of its captures, which it never writes after it is made, as fixed (see
# invariant), so that LLVM keeps a captured function across calls that it cannot see into; one on
# the stack, made on each round of a loop at one place, is laundered each time, and its captures
# written as fixed.
dump_fixed_captures_check := ->
  Check name: 'lerta dump-llvm reads the captures of a closure as fixed', run: ->
    dumped := await run_in_new_dir(compiler, ['dump-llvm', REMADE_IN_LOOPS])
    reasons := expect_status(0, dumped.result.status)
    lines := dumped.result.stdout.text()!.split("\n")
    is_capture := (line: String) -> '%closure, i32 0, i32 ' in line and not line.ends_with(' 2')
    captures := [i for line, i in lines when is_capture(line)]
    unfixed := [i for i in captures when '!invariant.group' not in lines[i + 1]]
    reasons.push 'no capture read' if captures.length < 2
    reasons.append ["not read as fixed: #{lines[i + 1].trim()}" for i in unfixed]
    body := function_body(lines, 'rounds') ? return [reasons..., 'no function rounds']
    stack := [line.trim().split(' = ')[0] for line in body when ' = alloca {' in line]
    is_laundered := (place: String) ->
      body.any (line) -> "@llvm.launder.invariant.group.p0(ptr #{place})" in line
    reasons.push 'no stack closure laundered' if not stack.any(is_laundered)
    is_fixed_store := (line: String) ->
      line.trim().starts_with('store i64 ') and '!invariant.group' in line
    reasons.push 'no capture written as fixed' if body.filter(is_fixed_store).count() < 2
    reasons

ITEM_WRITES := "#{root_dir}/tests/array/item_writes.lerta"

# Each load and store of an item of an array or a value of a map, of each size, names the alias tag
# of the items, whose nodes the module defines once each.
dump_item_tag_check := -> Check(name: 'lerta dump-llvm tags the loads and stores of items', run: ->
  dumped := await run_in_new_dir(compiler, ['dump-llvm', ITEM_WRITES])
  lines := dumped.result.stdout.text()!.split("\n")
  tagged := alias_tag_of(lines, 'lerta item') ? return ['the tag of items is not defined once']
  root := await clang_tbaa_root(dumped.cwd)
  has_root := lines.any((line) -> line.ends_with(" = #{root}"))
  return ["no node of clang's root of type-based alias analysis, #{root}"] if not has_root
  types := ['i8', 'i32', 'float', 'i64', '{ ptr, ptr }']
  accesses := [["load #{type}, ptr" for type in types]..., ["store #{type} " for type in types]...]
  is_tagged := (access: String) -> lines.any((line) -> access in line and line.ends_with(tagged))
  [
    expect_status(0, dumped.result.status)...
    ["no #{access} with the tag" for access in accesses when not is_tagged(access)]...
  ]
)

# What an access with the alias tag of the type of the name ends with, among the lines of the IR,
# or nil unless the module defines the type's node and the tag's once each.
alias_tag_of := (lines: String[], name: String) ->
  type := [line for line in lines when line.contains("!\"#{name}\"")]
  return nil if type.length != 1
  node := type[0].split(' = ')[0]
  tag := [line for line in lines when line.ends_with(" = !{#{node}, #{node}, i64 0}")]
  return nil if tag.length != 1
  ", !tbaa #{tag[0].split(' = ')[0]}"

FIELD_WRITES := "#{root_dir}/tests/float/field_writes.lerta"

# In a function that writes Float and Float32 fields in a loop, the accesses to the fields, to the
# top-level values and their flags, and the read of the pending exception each name their own
# alias tag, and an Int field names none.
dump_field_tag_check := ->
  Check name: 'lerta dump-llvm tags fields, top-level values and the exception', run: ->
    dumped := await run_in_new_dir(compiler, ['dump-llvm', FIELD_WRITES])
    lines := dumped.result.stdout.text()!.split("\n")
    body := function_body(lines, 'move') ? return ['no function move']
    undefined := (name: String) -> ["the tag of #{name} is not defined once"]
    float := alias_tag_of(lines, 'lerta float') ? return undefined('lerta float')
    top_level := alias_tag_of(lines, 'lerta top level') ? return undefined('lerta top level')
    pointer := alias_tag_of(lines, 'any pointer') ? return undefined('any pointer')
    value := (name: String) -> "ptr @\"lerta.value../field_writes.lerta.#{name}"
    accesses :=
      { access: 'load double, ptr %', tagged: float }
      { access: 'store double ', tagged: float }
      { access: 'store float ', tagged: float }
      { access: 'load float, ptr %', tagged: float }
      { access: "load ptr, #{value('points')}\"", tagged: top_level }
      { access: "load i1, #{value('points')}.set\"", tagged: top_level }
      { access: "load double, #{value('total')}\"", tagged: top_level }
      { access: "load i1, #{value('total')}.set\"", tagged: top_level }
      { access: 'load ptr, ptr @lerta_exception', tagged: pointer }
    is_tagged := (access: String, tagged: String) ->
      body.any (line) -> access in line and line.ends_with(tagged)
    reasons := expect_status(0, dumped.result.status)
    for expected in accesses
      if not is_tagged(expected.access, expected.tagged)
        reasons.push "no #{expected.access} with its tag"
    for flag in ['true', 'false']
      store := "store i1 #{flag}, #{value('points')}.set\""
      if not lines.any((line) -> store in line and line.ends_with(top_level))
        reasons.push "no #{store} with its tag"
    # id, the Int field, comes first after the header's two fields.
    id := body.find((line) -> 'Point", ptr %' in line and line.ends_with(', i32 0, i32 2'))
    id_load :=
      id and body.find((line) -> line.ends_with(" = load i64, ptr #{id.split(' = ')[0].trim()}"))
    reasons.push 'no load of the Int field without a tag' if not id_load
    reasons

# The root node of the alias analysis that clang gives the runtime's C, without its number, so that
# the items' type is in the same tree as the C types of the runtime.
clang_tbaa_root := (cwd: String) ->
  await write_file("#{cwd}/load.c", 'long load(long *p) { return *p; }'.binary)
  args := ['-O1', '-S', '-emit-llvm', '-o', '-', 'load.c']
  compiled := await run_command('clang', args, cwd)
  lines := compiled.stdout.text()!.split("\n")
  root := lines.find((line) -> line.ends_with('TBAA"}')) ? return "none in clang's IR"
  root.split(' = ')[1]

# The alias tag's nodes and those of the debug information share the module's numbers.
item_tag_source_lines_check := ->
  Check name: 'lerta run --source-lines -O runs a program with tagged items', run: ->
    ran := await run_command(compiler, ['run', ITEM_WRITES, '--source-lines', '-O'], cli_work_dir)
    expected := await read_file(ITEM_WRITES.without_suffix('.lerta')! + '.out')
    [expect_status(0, ran.status)..., compare_output('stdout', expected, ran.stdout)...]

dump_symbols_check := -> Check(name: 'lerta dump-llvm escapes module paths in symbol names', run: ->
  source := "#{root_dir}/tests/module/escaped_path.lerta"
  dumped := await run_in_new_dir(compiler, ['dump-llvm', source])
  ir := dumped.result.stdout.text()!
  symbols :=
    '@"lerta.fn.lib/\E5\90\8D\E5\89\8D \22a\5Cb\22.lerta.describe"'
    '@"lerta.thunk.lerta.fn.lib/\E5\90\8D\E5\89\8D \22a\5Cb\22.lerta.describe"'
    '@"lerta.method.lib/\E5\90\8D\E5\89\8D \22a\5Cb\22.lerta.Box.doubled"'
    '@"lerta.extend.lib/\E5\90\8D\E5\89\8D \22a\5Cb\22.lerta.Int.tripled"'
    '%"lerta.object.lib/\E5\90\8D\E5\89\8D \22a\5Cb\22.lerta.Pair<String>"'
    '@"lerta.value../escaped_path.lerta.box.set"'
    '@"lerta.fn.std:builtins/text.print<String>"'
  [
    expect_status(0, dumped.result.status)...
    ["no #{symbol}" for symbol in symbols when symbol not in ir]...
    expect_left('files left', [], dumped.left)...
    expect_left('files left in the temporary directory', [], dumped.left_in_temp)...
  ]
)

source_lines_check := -> Check(name: 'lerta run --source-lines runs a program', run: ->
  source := "#{root_dir}/tests/trace/lib/source_lines.lerta"
  ran := await run_command(compiler, ['run', source, '--source-lines'], cli_work_dir)
  [expect_status(0, ran.status)..., compare_output('stdout', "2\n7\n".binary, ran.stdout)...]
)

# macOS keeps the debug information beside the executable, in its dSYM bundle.
debug_file_of := (executable: String) ->
  return executable if host_platform != 'macos'
  name := executable.split('/').last()!
  "#{executable}.dSYM/Contents/Resources/DWARF/#{name}"

has_debug_info := (executable: String) ->
  debug_file := debug_file_of(executable)
  return false if not is_file(debug_file)
  marker := host_platform == 'macos' then '__debug_line' else '.debug_line'
  (await read_file(debug_file)).index_of(marker.binary) != nil

source_line_number := (text: String) -> text.is_digits() then text.parse_int()

tool_on_path := (name: String) ->
  path := env('PATH') ? return nil
  separator := host_platform == 'windows' then ';' else ':'
  for directory in path.split(separator)
    candidate := "#{directory}/#{name}#{executable_suffix}"
    return candidate if not directory.is_empty() and is_file(candidate)
  nil

run_dwarfdump := (command: String, path: String) ->
  try
    await run_command(command, ['--debug-line', path], cli_work_dir)
  catch error
    return nil

line_table_rows := (path: String) ->
  for tool in ['dwarfdump', 'llvm-dwarfdump']
    if command := tool_on_path(tool)
      if result := await run_dwarfdump(command, path)
        if result.status == 0
          rows: Int[]
          for line in result.stdout.text()!.split("\n")
            fields := [field for field in line.split(' ') when field != '']
            if fields.length >= 2 and fields[0].starts_with('0x')
              rows.push number if number := source_line_number(fields[1])
          return rows
  nil

source_lines_build_check := (flags: String[]) ->
  Check
    name: "lerta build --source-lines #{flags.join(' ')} gives the program line tables of its " +
      'source'
    run: ->
      source := "#{root_dir}/tests/trace/lib/source_lines.lerta"
      built := await run_in_new_dir(
        compiler
        ['build', source, '-o', "lines#{executable_suffix}", '--source-lines', flags...]
      )
      reasons := expect_success('build', built.result)
      return reasons if not reasons.is_empty()
      output := "#{built.cwd}/lines#{executable_suffix}"
      ran := await run_command(output, [], built.cwd)
      rows := await line_table_rows(debug_file_of(output))
      expected_lines: Int[] = flags.is_empty() then [12, 5, 16] else []
      has_debug := await has_debug_info(output)
      [
        expect_success('run', ran)...
        compare_output('stdout', "2\n7\n".binary, ran.stdout)...
        (has_debug then no_reasons else ['no debug information'])...
        (rows == nil then no_reasons else [
          [
            "no row of line #{line} in the line table"
            for line in expected_lines
            when line not in rows
          ]...
          (rows.is_empty() then ['the line table has no rows'] else no_reasons)...
        ])...
      ]

no_source_lines_check := ->
  Check name: 'lerta build without --source-lines omits debug information', run: ->
    source := "#{root_dir}/tests/trace/lib/source_lines.lerta"
    built := await run_in_new_dir(compiler, ['build', source, '-o', "lines#{executable_suffix}"])
    reasons := expect_success('build', built.result)
    return reasons if not reasons.is_empty()
    return no_reasons if host_platform == 'windows'
    output := "#{built.cwd}/lines#{executable_suffix}"
    has_debug := await has_debug_info(output)
    return ['debug information without --source-lines'] if has_debug
    no_reasons

no_trace_check := ->
  Check name: 'lerta build --no-trace prints an uncaught exception without its trace', run: ->
    source := "#{root_dir}/tests/trace/rethrow.lerta"
    executable := "#{cli_work_dir}/rethrow#{executable_suffix}"
    built := await run_in_new_dir(compiler, ['build', source, '-o', executable, '-O', '--no-trace'])
    reasons := expect_success('build', built.result)
    return reasons if not reasons.is_empty()
    ran := await run_command(executable, [], built.cwd)
    program := await read_file(executable)
    [
      expect_status(1, ran.status)...
      compare_text('stderr', "failed\n", ran.stderr.text()!)...
      (program.index_of('<top level>'.binary) != nil then [
        'the program holds the names of traces'
      ] else no_reasons)...
    ]

export checks: Check[] = [build_and_run(flags) for flags in runtime_flags]
checks.push default_output_check()
checks.push leading_dash_check()
checks.push symlink_output_check()
checks.push missing_output_directory_check()
checks.push missing_input_output_check()
checks.push relative_temp_check()
checks.append input_checks
checks.push no_clang_check()
checks.push failed_target_check()
checks.push optimized_runtime_check()
checks.push dump_llvm_check()
checks.push dump_symbols_check()
checks.push dump_seldom_check()
checks.push dump_joined_literals_check()
checks.push dump_unchecked_methods_check()
checks.push dump_float_ranges_check()
checks.push dump_compound_tree_check()
checks.push dump_batched_writes_check()
checks.push dump_fixed_captures_check()
checks.push dump_item_tag_check()
checks.push dump_field_tag_check()
checks.push item_tag_source_lines_check()
checks.push source_lines_check()
checks.push no_trace_check()
checks.push source_lines_build_check(no_build_flags)
checks.push source_lines_build_check(['-O'])
checks.push no_source_lines_check()
