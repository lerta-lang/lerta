export struct Box
  value: Int
  doubled := -> @value * 2

export class Resource
  args
    name: String
  deinit := -> print("closing #{@name}")

export enum Color
  RED
  GREEN

export interface Named
  name: String

export label := 'box'

var count = 0

export calls := -> count

export describe := (box: Box) -> "#{label} #{box.value}"

export first := <T>(items: T[]) -> items[0]

export counter := ->
  var n = 0
  ->
    n += 1
    count += 1
    n

extend Int
  tripled := -> @ * 3

export greet := (name: String, greeting = 'hi') -> "#{greeting} #{name}"

export struct Pair<T>
  left: T
  right: T
  swapped := -> Pair(left: @right, right: @left)
