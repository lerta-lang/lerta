# tools/build.lerta, which the Makefile builds into build/build: the usage errors that end it before
# it builds anything, and the parts of it that a build cannot reach on purpose.
import Check, posix_check from '../lib/report'
import compare_output, compare_text, expect_status from '../lib/expect'
import host_executable_suffix, root_dir from '../lib/lerta'
import new_cli_dir, run_command from '../lib/cli'
import is_file, read_file, write_file from 'std:io'
import platform from 'std:process'
import sleep from 'std:time'
import is_stale, sorted_once from '../../tools/build/files'
import bootstrap_for from '../../tools/build/stages'
import SETTINGS_USAGE from '../../tools/build/targets'
import CompileError from '../../compiler/errors'
import described_build, runtime_c_names from '../../compiler/platform_description'
import BuildError, command_line_batches, piped_to_file from '../../tools/build/steps'

BUILD_TOOL := "#{root_dir}/build/build#{host_executable_suffix}"

# A run that ends with code 2 and prints `message` first, as make does for a usage error; the usage
# message follows the errors that std:args reports.
usage_check := (name: String, dir_name: String, args: String[], message: String) ->
  Check name: "build/build #{name} is a usage error", run: ->
    ran := await run_command(BUILD_TOOL, args, new_cli_dir(dir_name))
    lines := ran.stderr_text().split("\n")
    from_args := message.starts_with('build: ')
    usage_next := lines.get(1)?.starts_with('usage: build') ? false
    usage_follows := not from_args or usage_next
    [
      expect_status(2, ran.status)...
      compare_text('stderr', message, lines[0])...
      (usage_follows then [] else ['no usage message follows the error'])...
    ]

# A run with `--help` that ends with code 0 and prints the usage message that starts so.
help_check := (args: String[], usage: String) ->
  Check name: "build/build #{args.join(' ')} prints the usage", run: ->
    ran := await run_command(BUILD_TOOL, args, new_cli_dir('build-tool-help'))
    first_line := ran.stdout_text().split("\n")[0]
    [expect_status(0, ran.status)..., compare_text('stdout', usage, first_line)...]

# A run of test-targets in a directory of the settings, if any, that ends with code 2 and prints
# `message`, before it runs any target.
settings_check := (
  name: String, dir_name: String, settings: String?, args: String[], message: String
) ->
  Check name: "build/build test-targets #{name} is an error", run: ->
    dir := new_cli_dir(dir_name)
    await write_file("#{dir}/test-targets.llit", settings) if settings
    ran := await run_command(BUILD_TOOL, ['test-targets', args...], dir)
    [expect_status(2, ran.status)..., compare_output('stderr', b"#{message}\n", ran.stderr)...]

# tools/test-targets.example.llit is settings that test-targets takes: a target that it has not is
# then the error, before anything runs.
example_check := Check
  name: 'build/build test-targets takes tools/test-targets.example.llit'
  run: ->
    dir := new_cli_dir('build-tool-example-settings')
    example := await read_file("#{root_dir}/tools/test-targets.example.llit")
    await write_file("#{dir}/test-targets.llit", example)
    ran := await run_command(BUILD_TOOL, ['test-targets', 'linux-arm64'], dir)
    message := b"test-targets.llit has no linux-arm64\n"
    [expect_status(2, ran.status)..., compare_output('stderr', message, ran.stderr)...]

batches_check := (name: String, args: String[], limit: Int, expected: String) ->
  Check
    name: "command_line_batches #{name}"
    run: -> compare_text('batches', expected, "#{command_line_batches(args, limit)}")

missing_input_check := Check(name: 'is_stale ends the build on an input that is missing', run: ->
  dir := new_cli_dir('build-tool-missing-input')
  output := "#{dir}/output"
  await write_file(output, 'made')
  message :=
    try
      is_stale output, ["#{dir}/missing"]
      'no error'
    catch error: BuildError
      error.message
  compare_text 'error', "missing input: #{dir}/missing", message
)

# What the producer prints goes through the filter into the output, which it replaces.
piped_check := posix_check('piped_to_file writes what the filter prints', ->
  output := "#{new_cli_dir('build-tool-piped')}/output"
  await write_file(output, 'old')
  await piped_to_file(output, ['printf', 'a\nb\n'], ['sed', 's/b/c/'])
  compare_output 'output', b"a\nc\n", await read_file(output)
)

# More than a pipe holds streams through, as nothing waits for the whole of it.
piped_large_check := posix_check('piped_to_file streams more than a pipe holds', ->
  output := "#{new_cli_dir('build-tool-piped-large')}/output"
  await piped_to_file(output, ['sh', '-c', 'yes | head -c 1000001'], ['cat'])
  compare_text 'length', '1000001', "#{(await read_file(output)).length}"
)

# Either program failing, or not starting, ends the build and leaves the output as it was, without
# the file it was written into.
piped_failure_check := (name: String, producer: String[], filter: String[], message: String) ->
  posix_check "piped_to_file ends the build when #{name}", ->
    output := "#{new_cli_dir("build-tool-piped-#{name.replace(" ", "-")}")}/output"
    await write_file(output, 'old')
    error :=
      try
        await piped_to_file(output, producer, filter)
        'no error'
      catch error
        error.message
    [
      compare_text('error', message, error)...
      compare_output('output', b'old', await read_file(output))...
      compare_text('unfinished', 'false', "#{is_file("#{output}.unfinished")}")...
    ]

# An output is stale once an input is newer than it, and not before. The pause outlasts the file
# times of the file systems that the tests run on, APFS, ext4 and NTFS, though not a coarser one
# such as FAT's.
order_check := Check(name: 'is_stale tells an output older than an input', run: ->
  dir := new_cli_dir('build-tool-order')
  input := "#{dir}/input"
  output := "#{dir}/output"
  await write_file(input, 'read')
  await sleep(0.05)
  await write_file(output, 'made')
  fresh := is_stale(output, [input])
  await sleep(0.05)
  await write_file(input, 'read again')
  compare_text 'stale', 'false true', "#{fresh} #{is_stale(output, [input])}"
)

# What the bootstrap for the target builds and runs, as one line.
bootstrap_lines := (target: String?) ->
  { target_flags, exe, compiler, dir, stage2, run_stage2 } := bootstrap_for(target)
  ["#{target_flags}", exe, compiler, dir, stage2, "#{run_stage2}"].join("\n")

# A Windows target's stage2 runs under Wine but on Windows.
bootstrap_check := Check(name: 'bootstrap_for names the stages of a target', run: ->
  windows_dir := 'build/bootstrap-windows-amd64'
  windows_stage2 := "#{windows_dir}/stage2.exe"
  windows_run :=
    platform == 'windows' then "['#{windows_stage2}']" else "['wine', '#{windows_stage2}']"
  windows :=
    "['--target', 'windows-amd64']"
    '.exe'
    'bin/lerta-windows-amd64.exe'
    windows_dir
    windows_stage2
    windows_run
  linux_stage2 := 'build/bootstrap-linux-amd64/stage2'
  linux :=
    "['--target', 'linux-amd64']"
    ''
    'bin/lerta-linux-amd64'
    'build/bootstrap-linux-amd64'
    linux_stage2
    "['#{linux_stage2}']"
  [
    compare_text('windows-amd64', windows.join("\n"), bootstrap_lines('windows-amd64'))...
    compare_text('linux-amd64', linux.join("\n"), bootstrap_lines('linux-amd64'))...
  ]
)

# A file to embed that is not UTF-8 ends the build with a message, as other failed steps do.
not_utf8_check := Check(name: 'build/build embed reports a file that is not UTF-8', run: ->
  dir := new_cli_dir('build-tool-not-utf8')
  await write_file("#{dir}/bad.txt", b"\xFF")
  ran := await run_command(BUILD_TOOL, ['embed', 'embedded.lerta', 'bad.txt'], dir)
  [
    expect_status(1, ran.status)...
    compare_output('stderr', b"'bad.txt' is not valid UTF-8\n", ran.stderr)...
  ]
)

# A file to embed that is missing ends the build with a message, as other failed steps do.
missing_embed_check := Check(name: 'build/build embed reports a file that is missing', run: ->
  ran := await run_command(
    BUILD_TOOL
    ['embed', 'embedded.lerta', 'missing.txt']
    new_cli_dir('build-tool-missing')
  )
  [
    expect_status(1, ran.status)...
    compare_output('stderr', b"cannot read file: missing.txt\n", ran.stderr)...
  ]
)

# Variables as make reads them: a value goes on past a `\` at the end of a line.
# A tab, a space at an end, no space around `:=`, an empty value, an indented comment and a line of
# blanks are as make reads them too.
DESCRIPTION := """
  # a comment \\
  that a `\\` goes on past
    # an indented comment
  \x20\t
  LIBUV_SOURCES := \\
    a.c \\
  \tb.c

  LIBUV_FLAGS := -x\x20\x20
  PLATFORM_SOURCES:=platform_p.c
  LIBUV_LIBRARIES :=
  """

description_check := Check(name: 'described_build takes the variables', run: ->
  build := described_build(DESCRIPTION, 'linux')
  [
    compare_text('platform', "['platform_p.c']", "#{build.platform_sources}")...
    compare_text('sources', "['a.c', 'b.c']", "#{build.libuv_sources}")...
    compare_text('flags', "['-x']", "#{build.libuv_flags}")...
    compare_text('libraries', '[]', "#{build.libraries}")...
    compare_text(
      'runtime'
      "['a.c', 'platform_p.c']"
      "#{runtime_c_names(['a.c', 'a.h', 'platform_p.c', 'platform_q.c', 'linux.mk'], build)}"
    )...
  ]
)

# The error that the description gives, or `no error`.
description_error := (description: String) ->
  try
    described_build description, 'linux'
    'no error'
  catch error: CompileError
    error.message

description_error_check := Check
  name: 'described_build reports a line that is no variable of the description'
  run: ->
    [
      compare_text(
        'no variable'
        'runtime/linux.mk: not a variable: LIBUV_SOURCES = a.c'
        description_error("LIBUV_SOURCES = a.c\n")
      )...
      compare_text(
        'two :='
        'runtime/linux.mk: not a variable: LIBUV_SOURCES := a.c := b.c'
        description_error("LIBUV_SOURCES := a.c := b.c\n")
      )...
      compare_text(
        'set again'
        'runtime/linux.mk: set again: LIBUV_SOURCES'
        description_error("LIBUV_SOURCES := a.c\nLIBUV_SOURCES := b.c\n")
      )...
      compare_text(
        'a reference'
        'runtime/linux.mk: a reference in LIBUV_FLAGS'
        description_error("LIBUV_FLAGS := -DX=$(Y)\n")
      )...
      compare_text(
        '+='
        'runtime/linux.mk: not a variable: LIBUV_SOURCES += a.c'
        description_error("LIBUV_SOURCES += a.c\n")
      )...
      compare_text(
        '::='
        'runtime/linux.mk: not a variable: LIBUV_SOURCES ::= a.c'
        description_error("LIBUV_SOURCES ::= a.c\n")
      )...
      compare_text(
        'export'
        'runtime/linux.mk: not a variable: export LIBUV_SOURCES := a.c'
        description_error("export LIBUV_SOURCES := a.c\n")
      )...
      compare_text(
        'a comment after a value'
        'runtime/linux.mk: a comment in LIBUV_SOURCES'
        description_error("LIBUV_SOURCES := a.c # b\n")
      )...
      compare_text(
        'no such variable'
        'runtime/linux.mk: not a variable of it: LIBUV_SOURCES_all'
        description_error("LIBUV_SOURCES_all := a.c\n")
      )...
      compare_text(
        '?='
        'runtime/linux.mk: not a variable: LIBUV_SOURCES ?= a.c'
        description_error("LIBUV_SOURCES ?= a.c\n")
      )...
      compare_text(
        'left out'
        'runtime/linux.mk: no PLATFORM_SOURCES'
        description_error("LIBUV_SOURCES := a.c\n")
      )...
      compare_text(
        'no platform file'
        'runtime/linux.mk: not a platform_*.c file: array.c'
        description_error("PLATFORM_SOURCES := array.c\n")
      )...
    ]

export checks :=
  usage_check('with no argument', 'build-tool-none', [], 'build: missing the command')
  usage_check(
    'with no such goal'
    'build-tool-goal'
    ['nonsense']
    "build: unknown command 'nonsense'"
  )
  usage_check(
    'with an option but --target'
    'build-tool-option'
    ['all', '-x', 'y']
    'build: unknown option -x'
  )
  usage_check(
    'with --target and no target'
    'build-tool-no-target'
    ['all', '--target']
    'build: --target needs a value'
  )
  usage_check(
    'test --target'
    'build-tool-test-target'
    ['test', '--target', 'x']
    'make test does not take TARGET: run bin/test --target <target>'
  )
  usage_check('embed with no output', 'build-tool-embed', ['embed'], 'build: missing <output>')
  usage_check(
    'with --target twice'
    'build-tool-target-twice'
    ['all', '--target', 'x', '--target', 'y']
    'build: --target is given twice'
  )
  usage_check(
    'with an argument after the goal'
    'build-tool-extra'
    ['all', 'extra']
    "build: unexpected argument 'extra'"
  )
  help_check(['--help'], 'usage: build <command> [<argument>...]')
  help_check(['all', '--help'], 'usage: build all [options]')
  help_check(['embed', '-h'], 'usage: build embed [options] <output> [<path>...]')
  help_check(['-h'], 'usage: build <command> [<argument>...]')
  help_check(['test-targets', '--help'], 'usage: build test-targets [options] [<target>...]')
  help_check(['test-target', '--help'], 'usage: build test-target [options] <target>')
  usage_check(
    'test-targets with an option'
    'build-tool-targets-option'
    ['test-targets', '-x']
    'build: unknown option -x'
  )
  usage_check(
    'test-target with no target'
    'build-tool-test-target-none'
    ['test-target']
    'build: missing <target>'
  )
  usage_check(
    'test-target of no short name'
    'build-tool-test-target-name'
    ['test-target', 'linux-i368']
    'no target linux-i368'
  )
  usage_check(
    'test-target with two targets'
    'build-tool-test-target-two'
    ['test-target', 'linux-i386', 'linux-amd64']
    "build: unexpected argument 'linux-amd64'"
  )
  settings_check('without settings', 'build-tool-no-settings', nil, [], SETTINGS_USAGE)
  settings_check('of no target', 'build-tool-no-targets', 'targets: Map()', [], SETTINGS_USAGE)
  example_check
  settings_check(
    'of a target of two places'
    'build-tool-two-places'
    "targets:\n  'linux-i386': { local: true, docker: 'linux' }\n"
    []
    'test-targets.llit: linux-i386 takes one of local, docker and ssh'
  )
  settings_check(
    'of a target of no place'
    'build-tool-no-place'
    "targets:\n  'linux-i386': { local: false }\n"
    []
    'test-targets.llit: linux-i386 takes one of local, docker and ssh'
  )
  settings_check(
    'of a target that the settings have not'
    'build-tool-unknown-target'
    "targets:\n  'linux-i386': { local: true }\n"
    ['windows-amd64']
    'test-targets.llit has no windows-amd64'
  )
  settings_check(
    'of a target of no short name'
    'build-tool-no-target-name'
    "targets:\n  'linux-i368': { docker: 'linux' }\n"
    []
    'test-targets.llit: no target linux-i368'
  )
  settings_check(
    'of an image that tools/docker has not'
    'build-tool-no-image'
    "targets:\n  'linux-i386': { docker: 'linx' }\n"
    []
    'test-targets.llit: no image linx, which is linux or wine'
  )
  settings_check(
    'of targets of which one the settings have not'
    'build-tool-unknown-of-two'
    "targets:\n  'linux-i386': { docker: 'linux' }\n"
    ['linux-i386', 'windows-amd64']
    'test-targets.llit has no windows-amd64'
  )
  settings_check(
    'of settings that are not llit'
    'build-tool-bad-settings'
    "targets:\n  'linux-i386': { dokcer: 'linux' }\n"
    []
    'test-targets.llit:2:19: no field dokcer'
  )
  usage_check(
    'seed --target'
    'build-tool-seed-target'
    ['seed', '--target', 'x']
    'make seed does not take TARGET'
  )
  batches_check('splits before the limit', ['aaa', 'bbb', 'c'], 8, "[['aaa', 'bbb'], ['c']]")
  batches_check(
    'gives a long argument a batch of its own'
    ['a', 'toolong', 'b']
    3
    "[['a'], ['toolong'], ['b']]"
  )
  batches_check('gives no batch of no argument', [], 8, '[]')
  Check(
    name: 'is_stale makes an output that is missing'
    run: -> compare_text('stale', 'true', "#{is_stale("#{root_dir}/build/no-such-output", [])}")
  )
  missing_input_check
  piped_check
  piped_failure_check(
    'the producer fails'
    ['sh', '-c', 'printf a; exit 3']
    ['cat']
    'sh exited with 3'
  )
  piped_failure_check(
    'the filter fails'
    ['printf', 'a']
    ['sh', '-c', 'cat; exit 4']
    'sh exited with 4'
  )
  # A producer that writes on past the filter is killed by SIGPIPE, which the filter's failure
  # comes before.
  piped_failure_check('the filter fails first', ['yes'], ['sh', '-c', 'exit 4'], 'sh exited with 4')
  piped_failure_check(
    'the filter cannot start'
    ['yes']
    ['no-such-command']
    'cannot run: no-such-command'
  )
  piped_failure_check(
    'the producer cannot start'
    ['no-such-command']
    ['cat']
    'cannot run: no-such-command'
  )
  piped_large_check
  order_check
  bootstrap_check
  not_utf8_check
  missing_embed_check
  description_check
  description_error_check
  Check(
    name: 'sorted_once sorts the paths and keeps each once'
    run: -> compare_text('paths', "['a', 'b', 'c']", "#{sorted_once(['c', 'a', 'b', 'a', 'c'])}")
  )
