# Formatter checks. Each tests/format/<name>.in is copied to <name>.lerta in a directory of its own,
# where `lerta fmt <name>.lerta` must report <name>.report on stderr, failing exactly when that is
# not empty (a missing file means empty); `lerta fmt --fix <name>.lerta` must then leave
# <name>.formatted (the input itself if it is missing) and report <name>.remaining, what it cannot
# fix, failing likewise; and `lerta fmt <name>.lerta` must then report that too. Then the command
# line: the paths it takes, and what it does with a file that does not parse. Whether the code of
# the repository is in the style is checked by `make check`.
import Check, select, SuiteChecks from './lib/report'
import compare_text, expect_status from './lib/expect'
import
  compiler, FileRun, read_text_or, read_text_or_throw, root_dir, run_file, SetupError, suite_dir
from './lib/lerta'
import list_dir, make_dir, stat, write_file from 'std:io'

work_dir := suite_dir('format')

fmt := (cwd: String, args: String[]) -> await run_file(compiler, ['fmt', args...], cwd)

# A case of tests/<cases>, which `lerta <command>` formats.
case_check := (cases: String, command: String, name: String) ->
  Check name: "tests/#{cases}/#{name}", run: ->
    cases_dir := "#{root_dir}/tests/#{cases}"
    dir := "#{work_dir}/#{cases}/#{name}"
    make_dir dir
    input := await read_text_or_throw("#{cases_dir}/#{name}.in")
    file := "#{name}.lerta"
    await write_file("#{dir}/#{file}", input)
    expected_report := await read_text_or("#{cases_dir}/#{name}.report", '')
    remaining := await read_text_or("#{cases_dir}/#{name}.remaining", '')
    remaining_status := remaining.is_empty() then 0 else 1
    run := (args: String[]) -> await run_file(compiler, [command, args...], dir)
    checked := await run([file])
    fixed := await run(['--fix', file])
    formatted := await read_text_or_throw("#{dir}/#{file}")
    rechecked := await run([file])
    [
      expect_run(checked, expected_report, expected_report.is_empty() then 0 else 1, 'report')...
      expect_run(fixed, remaining, remaining_status, '--fix stderr')...
      compare_text(
        'formatted'
        await read_text_or("#{cases_dir}/#{name}.formatted", input)
        formatted
      )...
      expect_run(rechecked, remaining, remaining_status, 'report on the formatted file')...
    ]

# A directory of files, made fresh for a check. Making each file's directory makes `dir` too, but
# it is made first for a tree of no files.
tree := (name: String, files: Map<String, String>) ->
  dir := "#{work_dir}/#{name}"
  make_dir dir
  for (path, text) in files.entries()
    parts := "#{dir}/#{path}".split('/')
    parent := parts[..(parts.length - 1)].join('/')
    make_dir parent
    await write_file("#{dir}/#{path}", text)
  dir

# The stderr of a run of `lerta fmt`, named `what` in a failure, and its exit status, as expected.
expect_run := (result: FileRun, stderr: String, status: Int, what = 'stderr') ->
  [compare_text(what, stderr, result.errors)..., expect_status(status, result.status)...]

expect_files := (dir: String, files: Map<String, String>) ->
  reasons: String[]
  for (file, text) in files.entries()
    reasons.append compare_text(file, text, await read_text_or_throw("#{dir}/#{file}"))
  reasons

# Sets the files back to 2000, so that a write shows even where times are kept in whole seconds.
make_old := (paths: String[]) ->
  result := await run_file('touch', ['-t', '200001010000', paths...], '.')
  throw SetupError("touch failed (#{result.failure}):\n#{result.errors}") unless result.status == 0

modified_time := (path: String) -> stat(path)!.modified_time

expect_unchanged := (path: String, time: Float): String[] ->
  modified_time(path) == time then [] else ["#{path} was written"]

unformatted := "print(1)\n"
# What `lerta fmt` reports on it.
calls_report := 'call without parentheses at the start of a statement, with them after `then` or ' +
  '`->` (Calls without parentheses)'

type_report := (at: String) ->
  "#{at}: leave out the type that can be inferred, or move it to the type arguments of its value " +
    "(Type annotations)\n"

command_checks: Check[] =
  { name: 'lerta fmt without a path is a usage error', run: ->
    expect_status 2, (await fmt(work_dir, [])).status
  }
  { name: 'lerta fmt reports a path that names nothing, and goes on with the others', run: ->
    dir := await tree('missing', { 'a.lerta': unformatted })
    result := await fmt(dir, ['missing.lerta', 'a.lerta'])
    expected := "'missing.lerta' is not a file or a directory\na.lerta:1:6: #{calls_report}\n"
    expect_run result, expected, 1
  }
  {
    name: 'lerta fmt takes the .lerta files of a directory, in order, but not in . directories'
    run: ->
      dir := await tree(
        'walk'
        {
          'src/b.lerta': unformatted
          'src/a.lerta': unformatted
          'src/notes.txt': unformatted
          'src/inner/c.lerta': unformatted
          'src/.hidden/d.lerta': unformatted
        }
      )
      result := await fmt(dir, ['src/'])
      paths := ['src/a.lerta', 'src/b.lerta', 'src/inner/c.lerta']
      expect_run result, ["#{path}:1:6: #{calls_report}\n" for path in paths].join(), 1
  }
  {
    name: 'lerta fmt leaves a file that is off throughout, and takes a file of a directory given ' +
      'too once'
    run: ->
      off := "# fmt: off\n#{unformatted}"
      dir := await tree('off', { 'src/a.lerta': unformatted, 'src/off.lerta': off })
      result := await fmt(dir, ['src', 'src/a.lerta'])
      expect_run result, "src/a.lerta:1:6: #{calls_report}\n", 1
  }
  { name: 'lerta fmt reports a file that is not valid UTF-8, in the order of the paths', run: ->
    dir := await tree('utf8', { 'a.lerta': unformatted, 'c.lerta': unformatted })
    bytes: Byte[] = [0x70, 0xff, 0x0a]
    await write_file("#{dir}/bad.lerta", bytes.to_binary())
    result := await fmt(dir, ['a.lerta', 'bad.lerta', 'c.lerta'])
    reports :=
      "a.lerta:1:6: #{calls_report}\n"
      "bad.lerta: the file is not valid UTF-8\n"
      "c.lerta:1:6: #{calls_report}\n"
    expect_run result, reports.join(), 1
  }
  {
    name: 'lerta fmt leaves out the types of the files that a program holds, checked once, or ' +
      'alone where it does not check'
    run: ->
      dir := await tree(
        'programs'
        {
          'lib.lerta': "export one := (): Int -> 1\n"
          'main.lerta': "import one from './lib'\ntwo: Int = one() + 1\nprint two\n"
          'broken.lerta': "import one from './lib'\nthree: String = one()\n"
        }
      )
      held := await fmt(dir, ['.'])
      alone := await fmt(dir, ['broken.lerta', 'lib.lerta'])
      [
        expect_run(held, type_report('./lib.lerta:1:17') + type_report('./main.lerta:2:4'), 1)...
        expect_run(alone, type_report('lib.lerta:1:17'), 1, 'stderr alone')...
      ]
  }
  {
    name: 'lerta fmt takes a file given twice once, files that import each other, and keeps the ' +
      'types where an import does not parse'
    run: ->
      dir := await tree(
        'cycles'
        {
          'a.lerta': "import b from './b'\nexport a := (): Int -> 1\nprint b()\n"
          'b.lerta': "import a from './a'\nexport b := (): Int -> a()\n"
          'c.lerta': "(\n"
          'd.lerta': "import c from './c'\nd: Int = 1\nprint d\n"
          # A comment before a `(` that is never closed, which may open parameters.
          'e.lerta': "# c\n(1\n"
        }
      )
      result := await fmt(dir, ['a.lerta', './a.lerta', 'b.lerta', 'c.lerta', 'd.lerta', 'e.lerta'])
      expected :=
        type_report('a.lerta:2:15')
        type_report('b.lerta:2:15')
        "c.lerta:1:1: '(' is never closed\n"
        "e.lerta:2:1: '(' is never closed\n"
      expect_run result, expected.join(), 1
  }
  {
    name: 'lerta fmt --fix leaves out the types of the files of one program, but one that alone ' +
      'uses an import'
    run: ->
      dir := await tree(
        'fix_program'
        {
          'lib.lerta': "export one := (): Int -> 1\n"
          'main.lerta': "import stdout, Writer from 'std:io'\nimport one from './lib'\n" +
            "out: Writer = stdout\ntwo: Int = one() + 1\nprint two\n"
        }
      )
      result := await fmt(dir, ['--fix', '.'])
      expected :=
        'lib.lerta': "export one := -> 1\n"
        'main.lerta': "import stdout, Writer from 'std:io'\nimport one from './lib'\n" +
          "out: Writer = stdout\ntwo := one() + 1\nprint two\n"
      [expect_run(result, '', 0)..., await expect_files(dir, expected)...]
  }
  {
    name: 'lerta fmt --fix writes the members of enums alone, through the checks of the calls ' +
      'that the checker rewrites, and reports the imports of the enums that it leaves unused'
    run: ->
      dir := await tree(
        'members'
        {
          'kinds.lerta': "export enum Kind\n  A\n  B\n\nexport struct Field\n  name: String\n" +
            "  kind: Kind\n\nexport count := (kinds: Kind...) -> kinds.length\n\n" +
            "export pick := (n: Int, options: { kind: Kind }) -> options.kind\n"
          'made.lerta': "import Field, Kind from './kinds'\n\n" +
            "export made := Field(name: 'a', kind: Kind.A)\n"
          'named.lerta': "import Field from './kinds'\nimport Kind from './kinds'\n\n" +
            "name := 'b'\nexport named := Field(name, kind: Kind.B)\n"
          'counted.lerta': "import count from './kinds'\nimport Kind from './kinds'\n\n" +
            "export counted := count(Kind.A, Kind.A)\n"
          'picked.lerta': "import Kind, pick from './kinds'\n\n" +
            "export picked := pick(1, kind: Kind.A)\n"
          'test.lerta': "import Kind from './kinds'\n\n" +
            "export is_b := (kind: Kind) -> kind == Kind.B\n"
          'unused.lerta': "import Kind from './kinds'\n\nexport one := 1\n"
          'typed.lerta': "import Kind, pick from './kinds'\n\nexport typed := (n: Int) ->\n" +
            "  kind: Kind = pick(n, kind: A)\n  kind\n"
          'parsed.lerta': "import Kind from './kinds'\nimport parse from 'std:enums'\n\n" +
            "export parsed := parse<Kind>('A')\n"
          'main.lerta': "import counted from './counted'\nimport made from './made'\n" +
            "import named from './named'\nimport picked from './picked'\n" +
            "import is_b from './test'\nimport one from './unused'\nimport typed from './typed'\n" +
            "import parsed from './parsed'\n\nprint is_b(made.kind).to_string()\nprint counted\n" +
            "print is_b(picked).to_string()\nprint named.name\nprint one\n" +
            "print is_b(typed(1)).to_string()\nprint parsed == nil\n"
        }
      )
      result := await fmt(dir, ['--fix', '.'])
      expected :=
        'made.lerta': "import Field from './kinds'\n\nexport made := Field(name: 'a', kind: A)\n"
        'named.lerta': "import Field from './kinds'\nimport Kind from './kinds'\n\nname := 'b'\n" +
          "export named := Field(name, kind: B)\n"
        'counted.lerta': "import count from './kinds'\nimport Kind from './kinds'\n\n" +
          "export counted := count(A, A)\n"
        'picked.lerta': "import pick from './kinds'\n\nexport picked := pick(1, kind: A)\n"
        'test.lerta': "import Kind from './kinds'\n\nexport is_b := (kind: Kind) -> kind == B\n"
        'unused.lerta': "import Kind from './kinds'\n\nexport one := 1\n"
        # A type that names an import stays, as leaving it out may leave the import unused.
        'typed.lerta': "import Kind, pick from './kinds'\n\nexport typed := (n: Int) ->\n" +
          "  kind: Kind = pick(n, kind: A)\n  kind\n"
        'parsed.lerta': "import Kind from './kinds'\nimport parse from 'std:enums'\n\n" +
          "export parsed := parse<Kind>('A')\n"
      # An import whose names are all unused is only reported (see Unused names).
      unused := (file: String) ->
        "./#{file}:#{file == 'unused.lerta' then 1 else 2}:1: leave out the names that are " +
          "never used, or write `import 'module'` for its code alone (Unused names)\n"
      reports := [unused(file) for file in ['counted.lerta', 'named.lerta', 'unused.lerta']]
      [expect_run(result, reports.join(), 1)..., await expect_files(dir, expected)...]
  }
  {
    name: 'lerta fmt checks once the files that a program holds through others, beside a file ' +
      'whose import is missing'
    run: ->
      dir := await tree(
        'chain'
        {
          'a.lerta': "import b from './b'\nprint b()\n"
          'b.lerta': "import c from './c'\nexport b := (): Int -> c()\n"
          'c.lerta': "export c := (): Int -> 1\n"
          'e.lerta': "import nope from './nope'\nimport c from './c'\nprint c()\n"
        }
      )
      result := await fmt(dir, ['a.lerta', 'b.lerta', 'c.lerta', 'e.lerta'])
      expect_run result, type_report('b.lerta:2:15') + type_report('c.lerta:1:15'), 1
  }
  {
    name: 'lerta fmt --fix writes only the files that change, and fails on one that does not parse'
    run: ->
      dir := await tree('fix', { 'a.lerta': unformatted, 'b.lerta': "print 1\n", 'c.lerta': "(\n" })
      (b, c) := ("#{dir}/b.lerta", "#{dir}/c.lerta")
      await make_old([b, c])
      (b_time, c_time) := (modified_time(b), modified_time(c))
      result := await fmt(dir, ['--fix', '.'])
      [
        expect_run(result, "./c.lerta:1:1: '(' is never closed\n", 1)...
        await expect_files(
          dir
          { 'a.lerta': "print 1\n", 'b.lerta': "print 1\n", 'c.lerta': "(\n" }
        )...
        expect_unchanged(b, b_time)...
        expect_unchanged(c, c_time)...
      ]
  }
  # Checking a program once for all of its files only saves time: the reports are those of each file
  # checked alone.
  {
    name: 'lerta fmt checks files that import each other as one program, and fixes them together'
    run: ->
      dir := await tree(
        'fix_cycles'
        {
          'a.lerta': "import b from './b'\nexport a := (): Int -> 1\nprint b()\n"
          'b.lerta': "import a from './a'\nexport b := (): Int -> a()\n"
        }
      )
      [
        expect_run(
          await fmt(dir, ['a.lerta', 'b.lerta'])
          type_report('a.lerta:2:15') + type_report('b.lerta:2:15')
          1
        )...
        expect_run(await fmt(dir, ['--fix', 'a.lerta', 'b.lerta']), '', 0)...
        await expect_files(
          dir
          {
            'a.lerta': "import b from './b'\nexport a := -> 1\nprint b()\n"
            'b.lerta': "import a from './a'\nexport b := -> a()\n"
          }
        )...
      ]
  }
  { name: 'lerta fmt checks a file alone where the program of one that imports it does not', run: ->
    files :=
      'a.lerta': "import b from './b'\nx: Int = 'a'\nprint b()\n"
      'b.lerta': "export b := (): Int -> 1\n"
    dir := await tree('alone', files)
    expect_run await fmt(dir, ['a.lerta', 'b.lerta']), type_report('b.lerta:1:15'), 1
  }

case_checks := (cases: String, command: String) ->
  files := list_dir("#{root_dir}/tests/#{cases}")
  [
    case_check(cases, command, file.without_suffix('.in')!)
    for file in files
    when file.ends_with('.in')
  ]

# The checks that the suite selected, if any.
export suite := ->
  title := 'format checks'
  all_checks := [case_checks('format', 'fmt')..., command_checks...]
  checks := select(title, all_checks) ? return nil
  SuiteChecks title, checks
