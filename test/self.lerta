# Self checks: the driver, bin/test, run as a program of its own, must report the tests of
# tests/harness, most of which must fail, each as it should (see run.lerta), and must take its
# arguments and keep the failed checks as main.lerta says.
import at_once, Check, run_checks, select from './lib/report'
import compare_text, expect_status, lines, reason_if from './lib/expect'
import host_triple from './lib/cli'
import OUTPUT_LIMIT, read_text_or_throw, root_dir, suite_dir from './lib/lerta'
import list_dir, write_file from 'std:io'
import run from 'std:process'

work_dir := suite_dir('self')
driver := "#{root_dir}/bin/test"
harness_dir := 'tests/harness'

struct DriverRun
  status: Int
  stdout: String
  stderr: String

var next_failed_file = 0

# A file of failed checks of its own for each run, holding `keys`, so that the runs neither meet one
# another nor build/test-failed.txt.
new_failed_file := (keys: String[]) ->
  next_failed_file += 1
  path := "#{work_dir}/failed-#{next_failed_file}.txt"
  await write_file(path, lines(keys).binary)
  path

# Runs the driver with the arguments, the run tests of tests/harness and the file of failed checks,
# two checks at once, as the checks run together, and with no retry unless `retry`, so that each
# test runs once and the failures are reported in order.
run_driver := (args: String[], failed_file: String, retry = false) ->
  stdout: Byte[]
  stderr: Byte[]
  no_retry: String[] = retry then [] else ['--no-retry']
  env := { 'LERTA_TEST_RUN_DIR': harness_dir, 'LERTA_TEST_FAILED_FILE': failed_file }
  ended := await run(
    driver
    '-j'
    '2'
    no_retry...
    args...
    cwd: root_dir
    env: env
    stdout: stdout
    stderr: stderr
    output_limit: OUTPUT_LIMIT
  )
  text := (bytes: Byte[]) -> bytes.to_binary().text() ? '(not valid UTF-8)'
  DriverRun status: ended.code, stdout: text(stdout), stderr: text(stderr)

run_key := (name: String) -> "run tests\t#{name}"

# A test of tests/harness and the reasons that the driver gives for its failure, none for a test
# that passes.
struct HarnessResult
  name: String
  reasons: String[]

passes := (name: String) -> HarnessResult(name, reasons: [])

stderr_differs := 'stderr differs from line 1'
threw := 'expected the run to succeed, but it exited with 1'
leaked := 'expected the run to succeed, but it exited with 23'
did_not_fail := 'expected the run to fail, but it did not'
killed := 'expected the run to succeed, but it was ended by signal 9'
did_not_compile := 'expected the run to succeed, but it did not compile'
needs_expected := (name: String) ->
  "needs #{name}.out or #{name}.err or #{name}.warn in tests/harness"

# How the driver reports each test of tests/harness, in order. The (-O) check of a test that fails
# to compile does not apply, so it is not reported; the optimized build does not report leaks, so
# the leak that the unoptimized one reports as expected makes it fail.
harness_results: HarnessResult[] =
  { name: 'tests/harness/stray.out', reasons: ['stray file: no test reads it'] }
  { name: 'tests/harness/aborts', reasons: [stderr_differs, threw] }
  { name: 'tests/harness/aborts (-O)', reasons: [stderr_differs, threw] }
  passes('tests/harness/compile_error')
  # The -O check waits for the unoptimized one (see optimized_check in run.lerta), which fails, so
  # it passes.
  { name: 'tests/harness/flaky', reasons: ['stdout differs from line 1', threw] }
  passes('tests/harness/flaky (-O)')
  { name: 'tests/harness/killed', reasons: [killed] }
  { name: 'tests/harness/killed (-O)', reasons: [killed] }
  passes('tests/harness/leaks')
  { name: 'tests/harness/leaks (-O)', reasons: [stderr_differs, did_not_fail] }
  { name: 'tests/harness/no_expected', reasons: [needs_expected('no_expected')] }
  { name: 'tests/harness/no_expected (-O)', reasons: [needs_expected('no_expected')] }
  passes('tests/harness/passes')
  passes('tests/harness/passes (-O)')
  { name: 'tests/harness/unexpected_compile_error', reasons: [stderr_differs, did_not_compile] }
  { name: 'tests/harness/unexpected_leak', reasons: [stderr_differs, leaked] }
  passes('tests/harness/unexpected_leak (-O)')
  { name: 'tests/harness/unexpected_success', reasons: [stderr_differs, did_not_fail] }
  { name: 'tests/harness/unexpected_success (-O)', reasons: [stderr_differs, did_not_fail] }
  { name: 'tests/harness/wrong_compile_error', reasons: [stderr_differs] }
  { name: 'tests/harness/wrong_stderr', reasons: [stderr_differs] }
  { name: 'tests/harness/wrong_stderr (-O)', reasons: [stderr_differs] }
  { name: 'tests/harness/wrong_stdout', reasons: ['stdout differs from line 1'] }
  { name: 'tests/harness/wrong_stdout (-O)', reasons: ['stdout differs from line 1'] }
  { name: 'tests/harness/wrong_warning', reasons: ['warnings differs from line 1'] }
  { name: 'tests/harness/wrong_warning (-O)', reasons: ['warnings differs from line 1'] }

failed_names := [result.name for result in harness_results when result.reasons.length > 0]

# A result as a line: `ok <name>`, or `FAIL <name>` and its reasons, each after ` | `.
result_line := (name: String, reasons: String[]) ->
  reasons.is_empty() then "ok #{name}" else ["FAIL #{name}", reasons...].join(' | ')

# The results that the driver printed, as result_line writes them. A result's line pads the name
# and ends with the time; the reasons follow, indented by 6, and what they show by more.
reported_results := (stdout: String) ->
  results: String[]
  var name: String?
  var reasons: String[] = []
  flush := ->
    results.push result_line(current, reasons) if current := name
    name = nil
    reasons = []
  for line in stdout.split("\n")
    if line.starts_with('ok    ') or line.starts_with('FAIL  ')
      flush()
      name = line.without_prefix(line.starts_with('ok') then 'ok    ' else 'FAIL  ')!.split('  ')[0]
    else if reason := line.without_prefix('      ')
      reasons.push reason if name != nil and not reason.starts_with(' ')
    else
      flush()
  flush()
  results

harness_check := Check
  name: 'bin/test reports each test of tests/harness as it should, and keeps those that failed'
  run: ->
    failed_file := await new_failed_file([])
    ran := await run_driver(['run'], failed_file)
    expected := [result_line(result.name, result.reasons) for result in harness_results]
    summary := "run tests: #{harness_results.length - failed_names.length} passed, #{failed_names.length} failed in "
    [
      compare_text('results', lines(expected), lines(reported_results(ran.stdout)))...
      reason_if(summary not in ran.stdout, "no summary `#{summary}...`")...
      expect_status(1, ran.status)...
      compare_text(
        'failed checks'
        lines([run_key(name) for name in failed_names])
        await read_text_or_throw(failed_file)
      )...
    ]

# Each source of tests/harness is in harness_results, so that a test added there is checked.
harness_listed_check := Check(name: 'every test of tests/harness has its expected result', run: ->
  listed := [result.name for result in harness_results]
  at_once [
    "tests/harness/#{file} is not in harness_results"
    for file in list_dir("#{root_dir}/#{harness_dir}")
    when file.ends_with('.lerta') and not listed.contains(
      "tests/harness/#{file.without_suffix('.lerta')!}"
    )
  ]
)

# The problem is the line that the usage follows.
usage_check := (args: String[], problem: String) ->
  Check name: "bin/test #{args.join(' ')} is a usage error", run: ->
    ran := await run_driver(args, await new_failed_file([]))
    [
      expect_status(2, ran.status)...
      reason_if(
        not ran.stderr.starts_with("#{problem}\nusage: bin/test ")
        "no #{problem} and usage on stderr: #{ran.stderr}"
      )...
    ]

# A check of the format suite, whose one case runs fast.
format_case := 'tests/format/calls'
format_key := "format checks\t#{format_case}"

driver_checks :=
  usage_check(['nothing'], 'not a suite: nothing (the suites: run, cli, format, runtime, self)')
  usage_check(['-k'], '-k needs a value')
  usage_check(['-j', '0'], '-j needs a count above 0: 0')
  usage_check(['cli', '--target', 'x86_64-w64-mingw32'], '--target is for the run suite alone')
  usage_check(['--target', 'x86_64-w64-mingw32', '--failed'], '--failed is for the host alone')
  Check(name: 'bin/test fails when no check is selected', run: ->
    ran := await run_driver(['format', '-k', 'no such check'], await new_failed_file([]))
    [
      compare_text('stderr', "no check is selected\n", ran.stderr)...
      expect_status(2, ran.status)...
    ]
  )
  Check(name: 'bin/test --list names the selected checks under their suites', run: ->
    ran := await run_driver(['format', '-k', format_case, '--list'], await new_failed_file([]))
    [
      compare_text('stdout', "format checks:\n  #{format_case}\n", ran.stdout)...
      expect_status(0, ran.status)...
    ]
  )
  Check(name: 'bin/test -q prints the checks that failed but none that passed', run: ->
    ran := await run_driver(['run', '-q'], await new_failed_file([]))
    expected := [
      result_line(result.name, result.reasons)
      for result in harness_results
      when result.reasons.length > 0
    ]
    [
      compare_text('results', lines(expected), lines(reported_results(ran.stdout)))...
      expect_status(1, ran.status)...
    ]
  )
  Check(name: "bin/test --target takes the host's triple for the run tests", run: ->
    name := 'tests/harness/passes'
    ran := await run_driver(['--target', host_triple, '-k', name], await new_failed_file([]))
    expected := [result_line(name, []), result_line("#{name} (-O)", [])]
    [
      compare_text('results', lines(expected), lines(reported_results(ran.stdout)))...
      expect_status(0, ran.status)...
    ]
  )
  Check(
    name: 'bin/test --failed runs the failed checks, and drops those that pass or that a suite no longer has'
    run: ->
      kept := "cli checks\ta check of a suite that does not run"
      failed_file :=
        await new_failed_file([format_key, "format checks\ta check that is gone", kept])
      ran := await run_driver(['--failed'], failed_file)
      [
        compare_text('results', "ok #{format_case}\n", lines(reported_results(ran.stdout)))...
        expect_status(0, ran.status)...
        compare_text('failed checks', lines([kept]), await read_text_or_throw(failed_file))...
      ]
  )
  Check(name: 'bin/test --failed -q keeps a check that fails again, and prints its failure', run: ->
    name := 'tests/harness/wrong_stdout'
    failed_file := await new_failed_file([run_key(name)])
    ran := await run_driver(['--failed', '-q'], failed_file)
    expected := result_line(name, ['stdout differs from line 1'])
    [
      compare_text('results', lines([expected]), lines(reported_results(ran.stdout)))...
      expect_status(1, ran.status)...
      compare_text(
        'failed checks'
        lines([run_key(name)])
        await read_text_or_throw(failed_file)
      )...
    ]
  )
  Check(
    name: 'bin/test passes and shows a check that fails, then passes when run once more'
    run: ->
      name := 'tests/harness/flaky'
      failed_file := await new_failed_file([])
      ran := await run_driver(['run', '-q', '-k', name], failed_file, true)
      # With -q, the -O check, which passed at once, is not shown.
      expected := [result_line(name, [])]
      [
        compare_text('results', lines(expected), lines(reported_results(ran.stdout)))...
        reason_if(not ran.stdout.contains("FAIL? #{name} "), "no `FAIL? #{name}`")...
        reason_if(
          'run tests: 2 passed, 0 failed, 1 flaky in ' not in ran.stdout
          'no summary with 1 flaky'
        )...
        expect_status(0, ran.status)...
        compare_text('failed checks', '', await read_text_or_throw(failed_file))...
      ]
  )
  Check(name: 'bin/test keeps a check that fails when run once more', run: ->
    name := 'tests/harness/wrong_stdout'
    failed_file := await new_failed_file([])
    ran := await run_driver(['run', '-q', '-k', name], failed_file, true)
    reasons := ['stdout differs from line 1']
    expected := [result_line(name, reasons), result_line("#{name} (-O)", reasons)]
    [
      compare_text('results', lines(expected), lines(reported_results(ran.stdout)))...
      reason_if(not ran.stdout.contains("FAIL? #{name} "), "no `FAIL? #{name}`")...
      reason_if(
        'run tests: running the 2 that failed once more, one at a time' not in ran.stdout
        'no retry of the 2 that failed'
      )...
      expect_status(1, ran.status)...
      compare_text(
        'failed checks'
        lines([run_key(name), run_key("#{name} (-O)")])
        await read_text_or_throw(failed_file)
      )...
    ]
  )
  Check(name: 'bin/test --failed says so when no check failed', run: ->
    ran := await run_driver(['--failed'], await new_failed_file([]))
    [
      compare_text('stdout', "no check failed when it last ran\n", ran.stdout)...
      expect_status(0, ran.status)...
    ]
  )

# The number of the checks that failed.
export suite := ->
  title := 'self checks'
  checks := select(title, [harness_check, harness_listed_check, driver_checks...]) ? return 0
  await run_checks(title, checks)
