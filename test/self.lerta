# Self checks: the driver, bin/test, run as a program of its own, must report the tests of
# tests/harness, most of which must fail, each as it should (see run.lerta), and must take its
# arguments and keep the failed checks as main.lerta says.
import
  at_once, Check, CheckFailed, posix_check, run_one, select, Slots, SuiteChecks
from './lib/report'
import compare_text, expect_status, lines, reason_unless from './lib/expect'
import host_target_name from './lib/cli'
import
  build_runtimes, cache_dir, exit_in_time, OUTPUT_LIMIT, read_text_or_throw, root_dir, shown_text,
  suite_dir
from './lib/lerta'
import all from 'std:async'
import Buffer, list_dir, write_file from 'std:io'
import platform, run from 'std:process'

work_dir := suite_dir('self')
driver := "#{root_dir}/bin/test"
harness_dir := 'tests/harness'

struct DriverRun
  status: Int
  stdout: String
  stderr: String

var next_failed_file = 0

# A file of failed checks of its own for each run, holding `keys`, so that the runs neither meet one
# another nor build/test-failed.txt.
new_failed_file := (keys: String[]) ->
  next_failed_file += 1
  path := "#{work_dir}/failed-#{next_failed_file}.txt"
  await write_file(path, lines(keys))
  path

# Runs the driver with the arguments, the run tests of tests/harness and the file of failed checks,
# two checks at once, as the checks run together, and with no retry unless `retry`, so that each
# test runs once.
run_driver := (
  args: String[]
  failed_file: String
  retry = false
  extra_env: Map<String, String> = Map()
) ->
  no_retry: String[] = retry then [] else ['--no-retry']
  # Two at once, unless the check gives its own count, as an option may not be given twice.
  gives_jobs := args.any((arg) -> arg in ['-j', '--jobs'] or arg.starts_with('--jobs='))
  jobs: String[] = gives_jobs then [] else ['-j', '2']
  env :=
    'LERTA_TEST_RUN_DIR': harness_dir
    'LERTA_TEST_FAILED_FILE': failed_file
    'LERTA_TEST_CACHE_DIR': cache_dir
  env[name] = value for (name, value) in extra_env.entries()
  output := Buffer(limit: OUTPUT_LIMIT)
  errors := Buffer(limit: OUTPUT_LIMIT)
  ran := run
    driver
    jobs...
    no_retry...
    args...
    cwd: root_dir
    env: env
    stdout: output
    stderr: errors
  ended := await exit_in_time(driver, ran)
  DriverRun status: ended.code, stdout: shown_text(output.binary), stderr: shown_text(errors.binary)

run_key := (name: String) -> "run tests\t#{name}"

# A test of tests/harness and the reasons that the driver gives for its failure, none for a test
# that passes.
struct HarnessResult
  name: String
  reasons: String[]

passes := (name: String) -> HarnessResult(name, reasons: [])

stderr_differs := 'stderr differs from line 1'
threw := 'expected the run to succeed, but it exited with 1'
leaked := 'expected the run to succeed, but it exited with 23'
did_not_fail := 'expected the run to fail, but it did not'
killed := 'expected the run to succeed, but it was ended by signal 9'
did_not_compile := 'expected the run to succeed, but it did not compile'

# How the driver reports each test of tests/harness, in order, those of tests/harness/posix last and
# not on Windows. The (-O) check of a test that fails to compile does not apply, so it is not
# reported; the optimized build does not report leaks, so the leak that the unoptimized one reports
# as expected makes it fail.
top_harness_results: HarnessResult[] =
  { name: 'tests/harness/stray.out', reasons: ['stray file: no test reads it'] }
  { name: 'tests/harness/aborts', reasons: [stderr_differs, threw] }
  { name: 'tests/harness/aborts (-O)', reasons: [stderr_differs, threw] }
  passes('tests/harness/compile_error')
  # The -O check waits for the unoptimized one (see optimized_check in run.lerta), which fails, so
  # it passes.
  { name: 'tests/harness/flaky', reasons: ['stdout differs from line 1', threw] }
  passes('tests/harness/flaky (-O)')
  passes('tests/harness/leaks')
  { name: 'tests/harness/leaks (-O)', reasons: [stderr_differs, did_not_fail] }
  { name: 'tests/harness/no_expected', reasons: ['stdout differs from line 1'] }
  { name: 'tests/harness/no_expected (-O)', reasons: ['stdout differs from line 1'] }
  passes('tests/harness/passes')
  passes('tests/harness/passes (-O)')
  { name: 'tests/harness/unexpected_compile_error', reasons: [stderr_differs, did_not_compile] }
  { name: 'tests/harness/unexpected_leak', reasons: [stderr_differs, leaked] }
  passes('tests/harness/unexpected_leak (-O)')
  { name: 'tests/harness/unexpected_success', reasons: [stderr_differs, did_not_fail] }
  { name: 'tests/harness/unexpected_success (-O)', reasons: [stderr_differs, did_not_fail] }
  { name: 'tests/harness/wrong_compile_error', reasons: [stderr_differs] }
  { name: 'tests/harness/wrong_stderr', reasons: [stderr_differs] }
  { name: 'tests/harness/wrong_stderr (-O)', reasons: [stderr_differs] }
  { name: 'tests/harness/wrong_stdout', reasons: ['stdout differs from line 1'] }
  { name: 'tests/harness/wrong_stdout (-O)', reasons: ['stdout differs from line 1'] }
  { name: 'tests/harness/wrong_warning', reasons: ['warnings differs from line 1'] }
  { name: 'tests/harness/wrong_warning (-O)', reasons: ['warnings differs from line 1'] }

posix_harness_results: HarnessResult[] =
  { name: 'tests/harness/posix/killed', reasons: [killed] }
  { name: 'tests/harness/posix/killed (-O)', reasons: [killed] }

harness_results := [
  top_harness_results...
  (platform == 'windows' then [] else posix_harness_results)...
]

failed_names := [result.name for result in harness_results when result.reasons.length > 0]

# A result as a line: `ok <name>`, or `FAIL <name>` and its reasons, each after ` | `.
result_line := (name: String, reasons: String[]) ->
  reasons.is_empty() then "ok #{name}" else ["FAIL #{name}", reasons...].join(' | ')

# The results that the driver printed, as result_line writes them. A result's line pads the name
# and ends with the time; the reasons follow, indented by 6, and what they show by more.
reported_results := (stdout: String) ->
  results: HarnessResult[]
  # Whether the lines that follow give reasons of the last result.
  var in_result = false
  for line in stdout.lines()
    if line.starts_with('ok    ') or line.starts_with('FAIL  ')
      name := line
        .without_prefix(line.starts_with('ok') then 'ok    ' else 'FAIL  ')!
        .split('  ')[0]
      results.push { name, reasons: [] }
      in_result = true
    else if reason := line.without_prefix('      ')
      results.last()!.reasons.push(reason) if in_result and not reason.starts_with(' ')
    else
      in_result = false
  [result_line(result.name, result.reasons) for result in results]

# The driver shows the results, and keeps the failed checks, as the checks finish, in an order that
# may change from run to run, so both are compared sorted.
expect_results := (expected: String[], stdout: String) ->
  compare_text 'results', lines(expected.sorted()), lines(reported_results(stdout).sorted())

expect_failed := (failed_file: String, expected_keys: String[]) ->
  kept := (await read_text_or_throw(failed_file)).lines()
  compare_text 'failed checks', lines(expected_keys.sorted()), lines(kept.sorted())

harness_check := Check
  name: 'bin/test reports each test of tests/harness as it should, and keeps those that failed'
  run: ->
    failed_file := await new_failed_file([])
    ran := await run_driver(['run'], failed_file)
    expected := [result_line(result.name, result.reasons) for result in harness_results]
    summary := "run tests: #{harness_results.length - failed_names.length} passed, " +
      "#{failed_names.length} failed in "
    [
      expect_results(expected, ran.stdout)...
      reason_unless(summary in ran.stdout, "no summary `#{summary}...`")...
      expect_status(1, ran.status)...
      await expect_failed(failed_file, [run_key(name) for name in failed_names])...
    ]

# Each source of tests/harness is in harness_results, so that a test added there is checked.
harness_listed_check := Check(name: 'every test of tests/harness has its expected result', run: ->
  listed := [result.name for result in [top_harness_results..., posix_harness_results...]]
  sources_in := (dir: String) ->
    [
      "#{dir}/#{file.without_suffix('.lerta')!}"
      for file in list_dir("#{root_dir}/#{dir}")
      when file.ends_with('.lerta')
    ]
  sources := [sources_in(harness_dir)..., sources_in("#{harness_dir}/posix")...]
  at_once
    ["#{source}.lerta is not in harness_results" for source in sources when source not in listed]
)

# A check that throws CheckFailed fails with its reasons; one that throws another error, with what
# it threw.
thrown_check := (thrown: Error, expected: String[]) ->
  Check name: "a check that throws #{thrown.message} fails with #{expected}", run: ->
    result := await run_one({ name: 'thrower', run: -> throw thrown })
    compare_text 'reasons', lines(expected), lines(result.reasons ? [])

thrown_checks :=
  thrown_check(CheckFailed(['x']), ['x'])
  thrown_check(ValueError('y'), ['threw:', '  y'])

# Slots are given no more than there are, and in the order that they were asked for.
slots_check := Check(name: 'slots are given in the order that they were asked for', run: ->
  slots := Slots(free: 1)
  taken: String[]
  take := (name: String) ->
    await slots.take()
    taken.push name
  await take('first')
  second := take('second')
  third := take('third')
  given_early := taken.length
  # Both given back before either is awaited, so that slots given in another order fail the check
  # rather than leave one waiting.
  slots.give_back()
  slots.give_back()
  await all([second, third])
  [
    reason_unless(given_early == 1, "#{given_early} slots given while one was held")...
    compare_text('order', 'first second third', taken.join(' '))...
  ]
)

# The problem is the line that the usage follows, after the program's name, as std:args writes it.
usage_check := (args: String[], problem: String) ->
  Check name: "bin/test #{args.join(' ')} is a usage error", run: ->
    ran := await run_driver(args, await new_failed_file([]))
    [
      expect_status(2, ran.status)...
      reason_unless(
        ran.stderr.starts_with("test: #{problem}\nusage: test ")
        "no #{problem} and usage on stderr: #{ran.stderr}"
      )...
    ]

# A run with `-h` or `--help` prints the usage and runs nothing.
help_check := (args: String[]) ->
  Check name: "bin/test #{args.join(' ')} prints the usage and runs nothing", run: ->
    ran := await run_driver(args, await new_failed_file([]))
    [
      expect_status(0, ran.status)...
      reason_unless(ran.stdout.starts_with('usage: test '), "no usage on stdout: #{ran.stdout}")...
      compare_text('stderr', '', ran.stderr)...
    ]

# A check of the format suite, whose one case runs fast.
format_case := 'tests/format/eof'
format_key := "format checks\t#{format_case}"

driver_checks: Check[] =
  usage_check(
    ['nothing']
    "<bootstrap|run|cli|format|runtime|leaks|self> takes a Suite, not 'nothing'"
  )
  usage_check(['-k'], '-k needs a value')
  help_check(['--help'])
  help_check(['-h'])
  help_check(['nothing', '--help'])
  help_check(['--target', 'x', 'cli', '--help'])
  usage_check(['--jobs=-1'], '--jobs takes a count above 0, not -1')
  usage_check(['-j', '2', '-j', '3'], '--jobs is given twice')
  usage_check(['-j', 'x'], "--jobs takes an Int, not 'x'")
  usage_check(['--nope'], 'unknown option --nope')
  { name: 'bin/test runs a suite given twice once', run: ->
    once := await run_driver(['format', '-k', format_case, '--list'], await new_failed_file([]))
    twice :=
      await run_driver(['format', 'format', '-k', format_case, '--list'], await new_failed_file([]))
    [expect_status(0, twice.status)..., compare_text('stdout', once.stdout, twice.stdout)...]
  }
  usage_check(['-j', '0'], '--jobs takes a count above 0, not 0')
  usage_check(['cli', '--target', 'x86_64-w64-mingw32'], '--target is for the run suite alone')
  usage_check(['--target', 'x86_64-w64-mingw32', '--failed'], '--failed is for the host alone')
  { name: 'bin/test fails when no check is selected', run: ->
    ran := await run_driver(['format', '-k', 'no such check'], await new_failed_file([]))
    [
      compare_text('stderr', "no check is selected\n", ran.stderr)...
      expect_status(2, ran.status)...
    ]
  }
  { name: 'bin/test --list names the selected checks under their suites', run: ->
    ran := await run_driver(['format', '-k', format_case, '--list'], await new_failed_file([]))
    [
      compare_text('stdout', "format checks:\n  #{format_case}\n", ran.stdout)...
      expect_status(0, ran.status)...
    ]
  }
  { name: 'bin/test --list names the check of the bootstrap suite', run: ->
    ran := await run_driver(['bootstrap', '--list'], await new_failed_file([]))
    [
      compare_text('stdout', "bootstrap:\n  the compiler builds itself\n", ran.stdout)...
      expect_status(0, ran.status)...
    ]
  }
  { name: 'bin/test -q prints the checks that failed but none that passed', run: ->
    ran := await run_driver(['run', '-q'], await new_failed_file([]))
    expected := [
      result_line(result.name, result.reasons)
      for result in harness_results
      when result.reasons.length > 0
    ]
    [expect_results(expected, ran.stdout)..., expect_status(1, ran.status)...]
  }
  { name: "bin/test --target takes the host's short name for the run tests", run: ->
    target := host_target_name ? return nil
    name := 'tests/harness/passes'
    ran := await run_driver(['--target', target, '-k', name], await new_failed_file([]))
    expected := [result_line(name, []), result_line("#{name} (-O)", [])]
    [expect_results(expected, ran.stdout)..., expect_status(0, ran.status)...]
  }
  {
    name: 'bin/test --failed runs the failed checks, and drops those that pass or that a suite ' +
      'no longer has'
    run: ->
      kept := "cli checks\ta check of a suite that does not run"
      failed_file :=
        await new_failed_file([format_key, "format checks\ta check that is gone", kept])
      ran := await run_driver(['--failed'], failed_file)
      [
        expect_results(["ok #{format_case}"], ran.stdout)...
        expect_status(0, ran.status)...
        await expect_failed(failed_file, [kept])...
      ]
  }
  { name: 'bin/test --failed -q keeps a check that fails again, and prints its failure', run: ->
    name := 'tests/harness/wrong_stdout'
    failed_file := await new_failed_file([run_key(name)])
    ran := await run_driver(['--failed', '-q'], failed_file)
    expected := result_line(name, ['stdout differs from line 1'])
    [
      expect_results([expected], ran.stdout)...
      expect_status(1, ran.status)...
      await expect_failed(failed_file, [run_key(name)])...
    ]
  }
  { name: 'bin/test passes and shows a check that fails, then passes when run once more', run: ->
    name := 'tests/harness/flaky'
    failed_file := await new_failed_file([])
    ran := await run_driver(['run', '-q', '-k', name], failed_file, true)
    # With -q, the -O check, which passed at once, is not shown.
    expected := [result_line(name, [])]
    [
      expect_results(expected, ran.stdout)...
      reason_unless(ran.stdout.contains("FAIL? #{name} "), "no `FAIL? #{name}`")...
      reason_unless(
        'run tests: 2 passed, 0 failed, 1 flaky in ' in ran.stdout
        'no summary with 1 flaky'
      )...
      expect_status(0, ran.status)...
      await expect_failed(failed_file, [])...
    ]
  }
  { name: 'bin/test runs the checks of two suites, and reports them with a summary each', run: ->
    name := 'tests/harness/wrong_stdout'
    failed_file := await new_failed_file([])
    ran := await run_driver(['run', 'leaks', '-k', name], failed_file)
    reasons := ['stdout differs from line 1']
    expected :=
      result_line(name, reasons)
      result_line("#{name} (-O)", reasons)
      result_line("#{name}.lerta", [])
    [
      expect_results(expected, ran.stdout)...
      reason_unless('run tests: 0 passed, 2 failed in ' in ran.stdout, 'no summary of run tests')...
      reason_unless('leak checks: 1 passed, 0 failed in ' in ran.stdout, 'no summary of leaks')...
      expect_status(1, ran.status)...
      await expect_failed(failed_file, [run_key(name), run_key("#{name} (-O)")])...
    ]
  }
  { name: 'bin/test keeps a check that fails when run once more', run: ->
    name := 'tests/harness/wrong_stdout'
    failed_file := await new_failed_file([])
    ran := await run_driver(['run', '-q', '-k', name], failed_file, true)
    reasons := ['stdout differs from line 1']
    expected := [result_line(name, reasons), result_line("#{name} (-O)", reasons)]
    [
      expect_results(expected, ran.stdout)...
      reason_unless(ran.stdout.contains("FAIL? #{name} "), "no `FAIL? #{name}`")...
      reason_unless(
        'running the checks that failed once more, one at a time: 2' in ran.stdout
        'no retry of the 2 that failed'
      )...
      expect_status(1, ran.status)...
      await expect_failed(failed_file, [run_key(name), run_key("#{name} (-O)")])...
    ]
  }
  { name: 'bin/test --failed says so when no check failed', run: ->
    ran := await run_driver(['--failed'], await new_failed_file([]))
    [
      compare_text('stdout', "no check failed when it last ran\n", ran.stdout)...
      expect_status(0, ran.status)...
    ]
  }

# The leak checks of tests/empty with a compiler that is a shell script of `body`, which must fail
# them exactly when `fails`.
leak_check := (what: String, body: String, fails: Bool) ->
  posix_check "bin/test leaks #{fails then 'fails' else 'passes'} #{what}", ->
    compiler := "#{work_dir}/compiler-#{what.replace(' ', '-')}"
    await write_file(compiler, b"#!/bin/sh\n#{body}\n")
    await run('chmod', '+x', compiler)
    ran := await run_driver(
      ['leaks', '-k', 'tests/empty.lerta']
      await new_failed_file([])
      false
      { 'LERTA_TEST_CHECKED_COMPILER': compiler }
    )
    expect_status fails then 1 else 0, ran.status

leak_checks :=
  leak_check('on a leak', 'exit 23', true)
  leak_check('on an abort', 'kill -ABRT $$', true)
  leak_check('on another signal', 'kill -SEGV $$', true)
  leak_check("on a source's error", 'exit 1', false)

# The checks that the suite selected, if any.
export suite := ->
  title := 'self checks'
  checks := select(
    title
    [
      harness_check
      harness_listed_check
      thrown_checks...
      slots_check
      driver_checks...
      leak_checks...
    ]
  ) ? return nil
  # The drivers that the checks run share the cache (see cache_dir), filled first, as each would
  # compile the runtimes otherwise.
  SuiteChecks title, checks, ready: build_runtimes(work_dir, [[], ['-O']])
