# Wine runs the Windows programs. One wineserver serves all the programs of a prefix, and serves
# them one request at a time, so that it limits how many run at once; concurrent runs are given
# prefixes of their own, each with its own wineserver.
import copy_file, list_dir, remove_tree from 'std:io'
import env, run from 'std:process'
import exit_in_time from './lerta'
import in_slot from './report'

# Wine starts its device service as it starts a prefix, whose kernel, ntoskrnl.exe, may fault when
# the machine is busy, as when the cross tests run, and writes so to the program's stderr. No
# tested program needs a device driver, so the service is not started. The tests give it to every
# program that Wine runs.
export WINE_DLL_OVERRIDES := 'winedevice.exe=d'

source_prefix := env('WINEPREFIX') else "#{env('HOME') else ''}/.wine"

# How long a wineserver outlives its last program, in seconds: long enough to serve every run, and
# short enough that one left by a killed test run goes away.
SERVER_LINGER := 60

# Prefixes that a run takes for itself and gives back when it ends. `take` gives none when none is
# free, and the run then uses the prefix of the environment, as all do with no prefixes.
export class WinePrefixes
  args
    prefixes: String[]
  private free: String[] = [prefix for prefix in @prefixes]

  take := -> not @free.is_empty() then @free.pop()
  give_back := (prefix: String) -> @free.push(prefix)
  stop := -> await stop_prefixes(@prefixes)

export no_wine_prefixes := -> WinePrefixes([])

# The error of a step of starting the prefixes.
struct WineError: Error

# `count` copies of the prefix in `dir`, started; none if the prefix cannot be copied, as when it
# is on another file system, which is reported.
export start_wine_prefixes := (dir: String, count: Int) ->
  prefixes := ["#{dir}/wine-#{i}" for i in 0..count]
  started: String[]
  try
    await update_source_prefix()

    # All of them end before any fails the whole, so that every wineserver started is stopped.
    starts := [in_slot(-> start_prefix(prefix, started)) for prefix in prefixes]
    var failure: Error?
    for each in starts
      try
        await each
      catch error
        failure = error if failure == nil
    throw error if error := failure
    WinePrefixes(prefixes)
  catch error
    await stop_prefixes(started)
    print "the runs share the Wine prefix #{source_prefix}: #{error.message}"
    no_wine_prefixes()

# A wineserver writes the registry back when it stops, so it stops before the caller removes its
# prefix. Stopping one in a directory where none runs would leave a directory of Wine's in /tmp.
stop_prefixes := (prefixes: String[]) ->
  stop := (prefix: String) ->
    try
      await run_wine(prefix, 'wineserver', '-k')
    catch _
      # One that does not run is stopped already.
      return
  await promise for promise in [stop(prefix) for prefix in prefixes]

# Wine updates a prefix made by another version of it as it starts, in place, which would change
# the files the copies link to; so the prefix is updated first, and its wineserver stops, writing
# the registry, before the copies are made.
update_source_prefix := ->
  await run_wine(nil, 'wine', 'cmd', '/c', 'exit')
  await run_wine(nil, 'wineserver', '--wait')

# The files are linked, but for the registry, which Wine rewrites in place: a test run leaves every
# other file of the prefix as it was, and the programs write only in their own directories. A
# wineserver that stays spares each run the start of one, and of Wine's services with it, which
# start with a first run. The prefix is added to `started` once its wineserver runs.
start_prefix := (prefix: String, started: String[]) ->
  await run_wine(nil, 'cp', '-al', source_prefix, prefix)
  for name in list_dir(prefix)
    continue unless name.ends_with('.reg')
    await remove_tree("#{prefix}/#{name}")
    await copy_file("#{source_prefix}/#{name}", "#{prefix}/#{name}")
  await run_wine(prefix, 'wineserver', "--persistent=#{SERVER_LINGER}")
  started.push prefix
  await run_wine(prefix, 'wine', 'cmd', '/c', 'exit')

# Runs a command of Wine's, in the prefix if given, and waits for it to exit. Its output, Wine's own
# messages, goes nowhere: not to this program's streams, which the wineserver that it may leave
# running would hold open after this program ends, nor to arrays, whose reads would wait for that
# wineserver to end.
run_wine := (prefix: String?, command: String, args: String...) ->
  env := { 'WINEDLLOVERRIDES': WINE_DLL_OVERRIDES }
  env['WINEPREFIX'] = prefix if prefix
  ran := run('sh', '-c', 'exec "$@" > /dev/null 2>&1', 'sh', command, args..., env: env)
  exit := await exit_in_time(command, ran)
  throw WineError("#{command} failed") if exit.code != 0
