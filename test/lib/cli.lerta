# Runs the compiler for CLI checks and gives each invocation isolated working and temporary
# directories.
import compare_text, lines from './expect'
import cache_dir, OUTPUT_LIMIT, root_dir, suite_dir from './lerta'
import is_file, list_dir, make_dir, read_file from 'std:io'
import platform, run from 'std:process'

export struct CliRun
  status: Int
  stdout: Binary
  stderr: Binary

export run_command := (
  command: String
  args: String[]
  cwd: String
  stdin: Binary = ''.binary
  env: Map<String, String> = Map()
  unset_env: String[] = []
) ->
  stdout: Byte[]
  stderr: Byte[]
  environment: Map<String, String>
  environment['LERTA_CACHE_DIR'] = cache_dir if not unset_env.contains('LERTA_CACHE_DIR')
  environment[key] = value for (key, value) in env.entries()
  result := await run(
    command
    args...
    cwd: cwd
    env: environment
    stdin: stdin
    stdout: stdout
    stderr: stderr
    unset_env: unset_env
    output_limit: OUTPUT_LIMIT
  )
  CliRun status: result.code, stdout: stdout.to_binary(), stderr: stderr.to_binary()

host_triple_run := await run_command('clang', ['-print-target-triple'], '.')
if host_triple_run.status != 0
  throw ValueError("clang -print-target-triple failed: #{host_triple_run.status}")
export host_triple := host_triple_run.stdout.text()!.split("\n")[0]
export runtime_flags: String[][] = [[], ['-O'], ['--target', host_triple]]
export host_platform := platform
export executable_suffix := platform == 'windows' then '.exe' else ''
export hello_output := await read_file("#{root_dir}/tests/examples/hello.out")
export cli_work_dir := suite_dir('cli')

var next_run_dir = 0

export new_cli_dirs := ->
  index := next_run_dir
  next_run_dir += 1
  (new_cli_dir("cwd-#{index}"), new_cli_dir("temp-#{index}"))

export new_cli_dir := (name: String) ->
  path := "#{cli_work_dir}/#{name}"
  make_dir path
  path

export run_in_dir := (
  compiler: String
  args: String[]
  cwd: String
  temp: String
  input: Binary = ''.binary
  env: Map<String, String> = Map()
  unset_env: String[] = []
) ->
  environment: Map<String, String>
  environment['TMPDIR'] = temp
  environment['TEMP'] = temp
  environment['TMP'] = temp
  environment[key] = value for (key, value) in env.entries()
  result := await run_command(compiler, args, cwd, input, environment, unset_env)
  { result, cwd, left: list_dir(cwd), left_in_temp: list_dir(temp) }

export run_in_new_dir := (
  compiler: String
  args: String[]
  input: Binary = ''.binary
  env: Map<String, String> = Map()
  unset_env: String[] = []
) ->
  (cwd, temp) := new_cli_dirs()
  await run_in_dir(compiler, args, cwd, temp, input, env, unset_env)

export expect_success := (what: String, result: CliRun): String[] ->
  return [] if result.status == 0
  stderr := result.stderr.text() ? '(not valid UTF-8)'
  ["#{what} failed (exit status #{result.status}), stderr:\n#{stderr}"]

export expect_left := (what: String, expected: String[], actual: String[]) ->
  compare_text what, lines(expected), lines(actual)

export read_optional := (path: String) -> not is_file(path) then nil else await read_file(path)
