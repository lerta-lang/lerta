# Runs the compiler for CLI checks and gives each invocation isolated working and temporary
# directories.
import compare_text, lines from './expect'
import CheckFailed from './report'
import
  at_import, cache_dir, exit_in_time, OUTPUT_LIMIT, root_dir, shown_text, suite_dir
from './lerta'
import is_file, list_dir, make_dir, read_file from 'std:io'
import platform, run from 'std:process'

export struct CliRun
  status: Int
  stdout: Binary
  stderr: Binary
  # The text of each stream, which every check that reads it as text expects to be UTF-8.
  stdout_text := -> @stdout.text()!
  stderr_text := -> @stderr.text()!

export run_command := (
  command: String
  args: String[]
  cwd: String
  stdin: Binary = b''
  env: Map<String, String> = Map()
  unset_env: String[] = []
) ->
  environment: Map<String, String>
  environment['LERTA_CACHE_DIR'] = cache_dir unless 'LERTA_CACHE_DIR' in unset_env
  environment[key] = value for (key, value) in env.entries()
  ran := run
    command
    args...
    cwd: cwd
    env: environment
    stdin: stdin
    stdout: CAPTURE
    stderr: CAPTURE
    unset_env: unset_env
    output_limit: OUTPUT_LIMIT
  result := await exit_in_time(command, ran)
  CliRun status: result.code, stdout: result.stdout!, stderr: result.stderr!

clang_host_triple := ->
  ran := await run_command('clang', ['-print-target-triple'], '.')
  throw ValueError("clang -print-target-triple failed: #{ran.status}") if ran.status != 0
  ran.stdout_text().split("\n")[0]

export host_triple := await at_import(clang_host_triple)
export runtime_flags: String[][] = [[], ['-O'], ['--target', host_triple]]
export host_platform := platform

# The host's target by its short name (see compiler/clang_flags), `<platform>-<architecture>`, or
# nil for an architecture that has none, where the checks of short names do not apply.
host_target_name_of := (triple: String) ->
  architecture :=
    case triple.split('-')[0]
      when 'x86_64' then 'amd64'
      when 'aarch64', 'arm64' then 'arm64'
      when 'i386', 'i486', 'i586', 'i686' then 'i386'
      else return nil
  "#{platform}-#{architecture}"
export host_target_name := host_target_name_of(host_triple)

export hello_output := await at_import(-> await read_file("#{root_dir}/tests/examples/hello.out"))
export cli_work_dir := suite_dir('cli')

var next_run_dir = 0

export new_cli_dirs := ->
  index := next_run_dir
  next_run_dir += 1
  (new_cli_dir("cwd-#{index}"), new_cli_dir("temp-#{index}"))

export new_cli_dir := (name: String) ->
  path := "#{cli_work_dir}/#{name}"
  make_dir path
  path

export run_in_dir := (
  compiler: String
  args: String[]
  cwd: String
  temp: String
  input: Binary = b''
  env: Map<String, String> = Map()
  unset_env: String[] = []
) ->
  environment := { 'TMPDIR': temp, 'TEMP': temp, 'TMP': temp }
  environment[key] = value for (key, value) in env.entries()
  result := await run_command(compiler, args, cwd, input, environment, unset_env)
  { result, cwd, left: list_dir(cwd), left_in_temp: list_dir(temp) }

export run_in_new_dir := (
  compiler: String
  args: String[]
  input: Binary = b''
  env: Map<String, String> = Map()
  unset_env: String[] = []
) ->
  (cwd, temp) := new_cli_dirs()
  await run_in_dir(compiler, args, cwd, temp, input, env, unset_env)

export expect_success := (what: String, result: CliRun): String[] ->
  return [] if result.status == 0
  stderr := shown_text(result.stderr)
  ["#{what} failed (exit status #{result.status}), stderr:\n#{stderr}"]

# Ends the check if the run failed, by throwing CheckFailed, which run_one reports as the check's
# reasons.
export succeed := (what: String, result: CliRun) ->
  reasons := expect_success(what, result)
  throw CheckFailed(reasons) unless reasons.is_empty()

export expect_left := (what: String, expected: String[], actual: String[]) ->
  compare_text what, lines(expected), lines(actual)

export read_optional := (path: String) -> not is_file(path) then nil else await read_file(path)
