# Selects the checks of each suite, runs those of every suite as one list, several at once, and
# prints each result in order as soon as it and those before it have finished; and keeps which
# checks ran and which failed, for the driver (see main).
import all, Signal from 'std:async'
import platform from 'std:process'
import monotonic from 'std:time'

# A check gives why it failed; an empty list means it passed, and nil means it does not apply, so
# it is neither shown nor counted. `wait` gives what to wait for before the check starts, which is
# not counted in its time.
export struct Check
  name: String
  run: () -> Promise<String[]?>
  wait: (() -> Promise)?

# Ends a check with the reasons it failed, from a step that cannot return them. They are not empty,
# as an empty list would read as a pass.
export struct CheckFailed: Error
  reasons: String[]
  message := @reasons.join("\n")

# The run of a check whose reasons are known at once.
export at_once := (reasons: String[]): Promise<String[]?> -> reasons

# A check that does not apply on Windows.
export posix_check := (name: String, run: () -> Promise<String[]?>) ->
  Check(name, run: -> platform == 'windows' then nil else await run())

# What the driver asks of the suites: the checks whose names hold `pattern`, and, unless `only` is
# nil, are among those it names by their keys (see key); whether to list them rather than run them;
# whether to print only the failures; how many checks run at once; and whether to run a
# failed check once more.
export struct Options
  pattern: String
  only: Set<String>?
  listing: Bool
  quiet: Bool
  jobs: Int
  retry: Bool

# Set by the driver before any suite selects its checks.
var given_options: Options?

export set_options := (given: Options) ->
  given_options = given
  slots = Slots(given.jobs)

options := -> given_options!

export jobs := -> options().jobs

# As many slots as checks run at once, each taken by a check as it runs, or by a process that a
# suite runs to get ready, so that those processes do not run beside as many checks; given in the
# order they were asked for, so that the checks start in their order.
export class Slots
  args
    var free: Int
  private waiting: Signal[] = []

  take := ->
    if @free > 0
      @free -= 1
      return
    signal := Signal()
    @waiting.push signal
    await signal.promise()

  give_back := ->
    if @waiting.is_empty()
      @free += 1
    else
      @waiting.remove_at(0).resolve()

var slots = Slots(1)

# Runs the task in a slot. A task that holds a slot, as a check, must not run another in one, which
# could wait for its own slot.
export in_slot := <T>(task: () -> Promise<T>) ->
  await slots.take()
  try
    await task()
  finally
    slots.give_back()

# The keys of the checks that the suites have, selected or not, of those that they selected, of
# those that ran, those that turned out not to apply too, and of those that failed.
export known_keys: Set<String>
export selected_keys: String[]
export ran_keys: String[]
export failed_keys: String[]

# What names a check among those of every suite: the suite's title and the check's name.
export key := (title: String, name: String) -> "#{title}\t#{name}"

# The checks to run of a suite, or nil if there are none, which is also the case when they are only
# listed, so that the suite skips what it would do before it runs them.
export select := (title: String, checks: Check[]) ->
  known_keys.add key(title, check.name) for check in checks
  selected := [
    check
    for check in checks
    when check.name.contains(options().pattern) and
      options().only?.contains(key(title, check.name)) ? true
  ]
  selected_keys.push key(title, check.name) for check in selected
  if options().listing
    print "#{title}:" unless selected.is_empty()
    print "  #{check.name}" for check in selected
    return nil
  not selected.is_empty() then selected

# Names are padded to align the times, but only up to this width, so that one long name does not
# push every line past the width of a terminal.
MAX_NAME_WIDTH := 72

struct Result
  reasons: String[]?
  duration: Float

milliseconds := -> monotonic() * 1000.0

# The code points of the text, which pad_end counts.
width := (text: String) -> text.count()

# Runs the check alone, as the retry does; its wait is not counted in its time.
export run_one := (check: Check) ->
  await wait() if wait := check.wait
  await run_started(check)

# The check, run once what it waits for has finished: in a slot, which it would hold idle while it
# waits.
run_in_slot := (check: Check) ->
  await wait() if wait := check.wait
  await in_slot(-> run_started(check))

run_started := (check: Check) ->
  started := milliseconds()
  reasons :=
    try
      await check.run()
    catch failed: CheckFailed
      failed.reasons
    catch error
      ['threw:', ("  #{line}" for line in error.message.split("\n"))...]
  Result(reasons, duration: milliseconds() - started)

# The unit is chosen after rounding, so that 999.6ms shows as 1.0s rather than 1000ms.
format_duration := (duration: Float) ->
  microseconds := (duration * 1000.0 + 0.5).to_int()!
  return "#{microseconds}µs" if microseconds < 1000
  rounded := (duration + 0.5).to_int()!
  return "#{rounded}ms" if rounded < 1000
  "#{(duration / 1000.0).to_fixed(1)}s"

# The checks that a suite selected, and what they wait for before any of them starts, such as the
# programs that they run: if it throws, the suite could not run its checks, which count as failed.
# `stop` is what the driver does after all the checks have run (see main).
export struct SuiteChecks
  title: String
  checks: Check[]
  ready: Promise?
  stop: (() -> Promise)?

struct Entry
  suite: Int
  check: Check

# How a suite's checks went: `started` and `finished` are when the first of them started, once the
# suite was ready, and when the last finished, before any ran once more.
class Tally
  private
    failed: String[] = []
    var run_count = 0
    var flaky_count = 0
    var started: Float? = nil
    var finished = 0.0
    var setup_error: String? = nil
    var setup_error_shown = false

# The run of the checks of every suite as one list: several at once, each result shown as soon as it
# has finished, then, with retry, those that failed, once more, one at a time; so the checks of a
# suite run while the last ones of the suite before it still do.
class ChecksRun
  args
    suites: SuiteChecks[]
    entries: Entry[]
    # Results are printed as they come, so the width also counts checks that turn out not to apply.
    name_width: Int
    tallies: Tally[]
  private
    retried: Entry[] = []
    var next_to_start = 0

    key_of := (entry: Entry) -> key(@suites[entry.suite].title, entry.check.name)

    show := (status: String, check: Check, result: Result, reasons: String[]) ->
      duration := format_duration(result.duration).pad_start(6)
      print "#{status.pad_end(5)} #{check.name.pad_end(@name_width)}  #{duration}"
      print "      #{reason}" for reason in reasons

    fail := (entry: Entry) ->
      @tallies[entry.suite].failed.push(entry.check.name)
      failed_keys.push @key_of(entry)

    report := (entry: Entry, result: Result) ->
      tally := @tallies[entry.suite]
      if error := tally.setup_error
        failed_keys.push @key_of(entry)
        unless tally.setup_error_shown
          tally.setup_error_shown = true
          print "#{@suites[entry.suite].title}: the suite could not run its checks: #{error}"
        return
      ran_keys.push @key_of(entry)
      reasons := result.reasons ? return
      tally.run_count += 1
      if reasons.is_empty()
        @show 'ok', entry.check, result, reasons unless options().quiet
      else if options().retry
        @retried.push entry
        @show 'FAIL?', entry.check, result, reasons
      else
        @fail entry
        @show 'FAIL', entry.check, result, reasons

    # The result of the check, or none if its suite could not get ready, which its tally then tells.
    run_entry := (entry: Entry) ->
      tally := @tallies[entry.suite]
      try
        await ready if ready := @suites[entry.suite].ready
      catch error
        tally.setup_error = tally.setup_error ? error.message
      return Result(reasons: nil, duration: 0.0) if tally.setup_error
      tally.started = tally.started ? milliseconds()
      result := await run_in_slot(entry.check)
      tally.finished = max(tally.finished, milliseconds())
      result

    # Runs the checks not started yet, one after another, and reports each as it finishes.
    work := ->
      while @next_to_start < @entries.length
        entry := @entries[@next_to_start]
        @next_to_start += 1
        @report entry, await @run_entry(entry)

    run_all := -> await all([@work() for _ in 0..jobs()])

    retry := ->
      unless @retried.is_empty()
        print "running the checks that failed once more, one at a time: #{@retried.length}"
      for entry in @retried
        result := await run_one(entry.check)
        # A check that does not apply now did not pass either.
        reasons := result.reasons ? ['did not apply when run once more']
        if reasons.is_empty()
          # Shown even with quiet, as the end of the FAIL? that was shown.
          @tallies[entry.suite].flaky_count += 1
          @show 'ok', entry.check, result, reasons
        else
          @fail entry
          @show 'FAIL', entry.check, result, reasons

    # Prints how each suite went, and gives the number of those that failed.
    summarize := ->
      var failed_suites = 0
      for suite at i in @suites
        tally := @tallies[i]
        if tally.setup_error
          failed_suites += 1
          # Why was shown where its checks would have been.
          print "#{suite.title}: the suite could not run its checks"
          print ''
          continue
        failed := tally.failed
        failed_suites += 1 unless failed.is_empty()
        total := format_duration(tally.finished - (tally.started ? tally.finished))
        flaky := tally.flaky_count > 0 then ", #{tally.flaky_count} flaky" else ''
        passed := tally.run_count - failed.length
        print "#{suite.title}: #{passed} passed, #{failed.length} failed#{flaky} in #{total}"
        print "  FAIL #{name}" for name in failed.sorted()
        print ''
      failed_suites

# Runs the checks that the suites selected, and gives the number of the suites that failed. With
# retry, a check that failed is shown as FAIL? and run once more after the others, alone, as a check
# that failed only because of the load of the others then passes; it is then counted as passed, and
# as flaky.
export run_checks := (suites: SuiteChecks[]) ->
  entries: Entry[] = [{ check, suite: i } for suite at i in suites for check in suite.checks]
  name_width := min((width(entry.check.name) for entry in entries).max() ? 0, MAX_NAME_WIDTH)
  tallies := [Tally() for _ in suites]
  run := ChecksRun(suites, entries, name_width, tallies)
  await run.run_all()
  await run.retry()
  run.summarize()
