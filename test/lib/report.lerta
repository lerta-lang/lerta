# Selects the checks of a suite, runs them, several at once, and prints each result in order as soon
# as it and those before it have finished; and keeps which checks ran and which failed, for the
# driver (see main).
import all, Deferred from 'std:async'
import time from 'std:time'

# A check gives why it failed; an empty list means it passed, and nil means it does not apply, so
# it is neither shown nor counted. `wait` gives what to wait for before the check starts, which is
# not counted in its time.
export struct Check
  name: String
  run: () -> Promise<String[]?>
  wait: (() -> Promise)? = default nil

# The run of a check whose reasons are known at once.
export at_once := (reasons: String[]): Promise<String[]?> ->
  deferred := Deferred<String[]?>()
  deferred.resolve reasons
  deferred.promise()

# What the driver asks of the suites: the checks whose names hold `pattern`, and, unless `only` is
# nil, are among those it names by their keys (see key); whether to list them rather than run them;
# whether to print only the failures; how many checks of a suite run at once; and whether to run a
# failed check once more.
export struct Options
  pattern: String
  only: Set<String>?
  listing: Bool
  quiet: Bool
  jobs: Int
  retry: Bool

# Set by the driver before any suite selects its checks.
var given_options: Options?

export set_options := (given: Options) -> given_options = given

options := -> given_options!

export jobs := -> options().jobs

# The keys of the checks that the suites have, selected or not, of those that they selected, of
# those that ran, those that turned out not to apply too, and of those that failed.
export known_keys: Set<String>
export selected_keys: String[]
export ran_keys: String[]
export failed_keys: String[]

# What names a check among those of every suite: the suite's title and the check's name.
export key := (title: String, name: String) -> "#{title}\t#{name}"

# The checks to run of a suite, or nil if there are none, which is also the case when they are only
# listed, so that the suite skips what it would do before it runs them.
export select := (title: String, checks: Check[]) ->
  known_keys.add key(title, check.name) for check in checks
  selected := [
    check
    for check in checks
    when check.name.contains(options().pattern) and options().only?.contains(
      key(title, check.name)
    ) ? true
  ]
  selected_keys.push key(title, check.name) for check in selected
  if options().listing
    print "#{title}:" if not selected.is_empty()
    print "  #{check.name}" for check in selected
    return nil
  not selected.is_empty() then selected

# Names are padded to align the times, but only up to this width, so that one long name does not
# push every line past the width of a terminal.
MAX_NAME_WIDTH := 72

struct Result
  reasons: String[]?
  duration: Float

milliseconds := -> time() * 1000.0

# The code points of the text, which pad_end counts.
width := (text: String) -> text.count()

run_one := (check: Check) ->
  await wait() if wait := check.wait
  started := milliseconds()
  reasons :=
    try
      await check.run()
    catch error
      ['threw:', ("  #{line}" for line in error.message.split("\n"))...]
  Result reasons, duration: milliseconds() - started

# The unit is chosen after rounding, so that 999.6ms shows as 1.0s rather than 1000ms.
format_duration := (duration: Float) ->
  microseconds := (duration * 1000.0 + 0.5).to_int()!
  return "#{microseconds}µs" if microseconds < 1000
  rounded := (duration + 0.5).to_int()!
  return "#{rounded}ms" if rounded < 1000
  "#{(duration / 1000.0).to_fixed(1)}s"

# Runs the checks that select gave, and gives the number of those that failed. With retry, a check
# that failed is shown as FAIL? and run once more after the others, alone, as a check that failed
# only because of the load of the others then passes; it is then counted as passed, and as flaky.
export run_checks := (title: String, checks: Check[]) ->
  # Results are printed as they come, so the width also counts checks that turn out not to apply.
  name_width := min((width(check.name) for check in checks).max() ? 0, MAX_NAME_WIDTH)
  started := milliseconds()
  failed: String[]
  retried: Check[]
  var flaky_count = 0
  var run_count = 0
  show := (status: String, check: Check, result: Result, reasons: String[]) ->
    duration := format_duration(result.duration).pad_start(6)
    print "#{status.pad_end(5)} #{check.name.pad_end(name_width)}  #{duration}"
    print "      #{reason}" for reason in reasons
  fail := (check: Check) ->
    failed.push check.name
    failed_keys.push key(title, check.name)
  report := (check: Check, result: Result) ->
    ran_keys.push key(title, check.name)
    reasons := result.reasons ? return
    run_count += 1
    if reasons.is_empty()
      show 'ok', check, result, reasons if not options().quiet
    else if options().retry
      retried.push check
      show 'FAIL?', check, result, reasons
    else
      fail check
      show 'FAIL', check, result, reasons
  results: Result?[] = [nil for _ in checks]
  var next_to_print = 0
  var next_to_start = 0
  worker := ->
    while next_to_start < checks.length
      index := next_to_start
      next_to_start += 1
      results[index] = await run_one(checks[index])
      while next_to_print < checks.length
        result := results[next_to_print] ? break
        report checks[next_to_print], result
        next_to_print += 1
  await all([worker() for _ in 0...jobs()])
  if not retried.is_empty()
    print "#{title}: running the #{retried.length} that failed once more, one at a time"
  for check in retried
    result := await run_one(check)
    # A check that does not apply now did not pass either.
    reasons := result.reasons ? ['did not apply when run once more']
    if reasons.is_empty()
      # Shown even with quiet, as the end of the FAIL? that was shown.
      flaky_count += 1
      show 'ok', check, result, reasons
    else
      fail check
      show 'FAIL', check, result, reasons
  total := format_duration(milliseconds() - started)
  flaky := flaky_count > 0 then ", #{flaky_count} flaky" else ''
  print "#{title}: #{run_count - failed.length} passed, #{failed.length} failed#{flaky} in #{total}"
  print "  FAIL #{name}" for name in failed
  print ''
  failed.length
