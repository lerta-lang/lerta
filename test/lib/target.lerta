# The target that the run tests build their programs for: the host, or another given by `--target`
# (see main), such as i686-linux-gnu for the 32-bit programs that an x86-64 host can run, or
# x86_64-w64-mingw32 for Windows programs, which Wine runs.
import executable_suffix, is_mingw from '../../compiler/clang_flags'

# The arguments to pass to the compiler's build, whether the programs are Windows ones, and what
# the name of one ends with.
export struct Target
  args: String[]
  windows: Bool
  executable_suffix: String

# The target of the triple, or the host's without one.
export target_of := (triple: String?) ->
  Target
    args: triple then ['--target', triple] else []
    windows: triple != nil and is_mingw(triple)
    executable_suffix: executable_suffix(triple)

export host_target := target_of(nil)
