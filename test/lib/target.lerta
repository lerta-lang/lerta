# `--target <triple>`, the one option of the run tests, has the compiler build the programs for
# another target than the host, such as i686-linux-gnu for the 32-bit programs that an x86-64 host
# can run, or x86_64-w64-mingw32 for Windows programs, which Wine runs.
import argv, exit from 'std:process'

# The arguments to pass to the compiler's build, and whether the programs are Windows ones.
export struct Target(args: String[], windows: Bool)

export const parse_target = (program: String) ->
  return Target(args: [], windows: false) if argv.length == 0
  if argv.length != 2 or argv[0] != '--target'
    print_error "usage: #{program} [--target <triple>]"
    exit 2
  Target args: ['--target', argv[1]], windows: argv[1].ends_with('-w64-mingw32')
