# The target that the run tests and the runtime checks build their programs for: the host, or
# another given by `--target` (see main), such as linux-i386 for the 32-bit programs that an x86-64
# host can run, or windows-amd64 for Windows programs, which Wine runs on a host other than Windows.
import executable_suffix, is_mingw, target_triple from '../../compiler/clang'
import platform from 'std:process'

# The triple, nil for the host's, the arguments to pass to the compiler's build, whether the
# programs are Windows ones, whether Wine runs them, and what the name of one ends with.
export struct Target
  triple: String?
  args: String[]
  windows: Bool
  wine: Bool
  executable_suffix: String

# The target of the short name or triple, or the host's without one.
export target_of := (target: String?) ->
  triple := target then target_triple(target)
  windows := triple then is_mingw(triple) else platform == 'windows'
  Target(
    triple
    windows
    args: triple then ['--target', triple] else []
    wine: windows and platform != 'windows'
    executable_suffix: executable_suffix(triple)
  )

export host_target := target_of(nil)
