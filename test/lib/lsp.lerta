# Sessions with the language server for the LSP checks: the messages they send, and what they
# make of the answers. The server speaks JSON-RPC messages framed by their UTF-8 byte length.
import compare_text from './expect'
import cli_work_dir, host_platform, run_command from './cli'
import compiler from './lerta'
import real_path from 'std:io'
import Codable from 'std:codable'
import decode_json, encode_json from 'std:json'

real_work_dir := host_platform == 'windows' then cli_work_dir else real_path(cli_work_dir).text()!

struct ResponseHeader
  id: Int | String

unreserved_marks := [mark for mark in b'-._~/:']

export uri_of := (path: String) ->
  in_work_dir := path.without_prefix(cli_work_dir)
  canonical_path := in_work_dir != nil then "#{real_work_dir}#{in_work_dir}" else path
  portable := canonical_path.replace('\', '/')
  hexadecimal := b'0123456789ABCDEF'
  bytes: Byte[]
  for byte in portable.binary
    if byte.is_letter() or byte.is_digit() or byte in unreserved_marks
      bytes.push byte
    else
      bytes.push b'%'
      bytes.push hexadecimal[byte.to_int() >> 4]
      bytes.push hexadecimal[byte.to_int() & 0xF]
  prefix := host_platform == 'windows' then 'file:///' else 'file://'
  "#{prefix}#{bytes.to_binary().text()!}"

export frame := (json: String) -> "Content-Length: #{json.binary.length}\r\n\r\n#{json}"

# The message, framed, of the fields.
framed_json := <T: Codable>(fields: T) -> frame(encode_json(fields))

export did_open := (uri: String, text: String) ->
  params := { textDocument: { uri, languageId: 'lerta', version: 1, text } }
  framed_json { jsonrpc: '2.0', method: 'textDocument/didOpen', params }

export did_change := (uri: String, text: String) -> did_change_at(uri, text, 2)

export did_change_at := (uri: String, text: String, version: Int) ->
  params := { textDocument: { uri, version }, contentChanges: [{ text }] }
  framed_json { jsonrpc: '2.0', method: 'textDocument/didChange', params }

export did_close := (uri: String) ->
  framed_json { jsonrpc: '2.0', method: 'textDocument/didClose', params: { textDocument: { uri } } }

export formatting_request := (uri: String, id: Int) ->
  params := { textDocument: { uri } }
  framed_json { jsonrpc: '2.0', id, method: 'textDocument/formatting', params }

# A request of the method about the place in the document.
position_request := (method: String, uri: String, line: Int, character: Int, id: Int) ->
  params := { textDocument: { uri }, position: { line, character } }
  framed_json { jsonrpc: '2.0', id, method: "textDocument/#{method}", params }

export completion_request := (uri: String, line: Int, character: Int, id = 1) ->
  position_request 'completion', uri, line, character, id

export definition_request := (uri: String, line: Int, character: Int, id: Int) ->
  position_request 'definition', uri, line, character, id

export hover_request := (uri: String, line: Int, character: Int, id: Int) ->
  position_request 'hover', uri, line, character, id

# The values of the expected answers, as structs, whose fields encode_json writes in the order that
# they are declared in, which is the server's.
struct Position
  line: Int
  character: Int

struct Range
  start: Position
  end: Position

struct Location
  uri: String
  range: Range

struct MarkupContent
  kind: String
  value: String

struct Hover
  contents: MarkupContent

struct Diagnostic
  range: Range
  severity: Int
  source: String
  message: String

# The members of a response but its "jsonrpc", given its result as JSON.
result_fragment := (id: Int, result: String) -> "\"id\":#{id},\"result\":#{result}"

export location_fragment := (id: Int, uri: String, line: Int, start: Int, end: Int) ->
  range := Range(start: { line, character: start }, end: { line, character: end })
  result_fragment id, encode_json(Location(uri, range))

export hover_fragment := (id: Int, text: String) ->
  value := "```lerta\n#{text}\n```"
  result_fragment id, encode_json(Hover(contents: { value, kind: 'markdown' }))

export initialize := '{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"capabilities":{}}}'
export finish :=
  frame('{"jsonrpc":"2.0","id":"end","method":"shutdown"}')
  frame('{"jsonrpc":"2.0","method":"exit"}')
.join('')

export session := (dir: String, messages: String) ->
  input := frame(initialize) + messages + finish
  await run_command(compiler, ['lsp'], dir, input.binary)

export excludes := (output: String, token: String, reason: String): String[] ->
  token in output then [reason] else []

export message_bodies := (output: String) ->
  parts := output.split("\r\n\r\n")
  messages: String[]
  var header = parts[0]
  for section in 1..parts.length
    length_text := header.without_prefix('Content-Length:') ? throw ValueError(
      "an LSP response without its Content-Length: #{header}"
    )
    length := length_text.trim().parse_int() ? throw ValueError(
      "an LSP response with an invalid length: #{header}"
    )
    chunk := parts[section].binary
    body := chunk[..length].text()!
    messages.push body
    header = chunk[length..].text()!
  messages

response_bodies := (output: String) ->
  [body for body in message_bodies(output) when body.starts_with('{"jsonrpc":"2.0","id":')]

export response_body := (output: String, id: Int) ->
  prefix := "{\"jsonrpc\":\"2.0\",\"id\":#{id},"
  response_bodies(output).find((each) -> each.starts_with(prefix)) ? throw ValueError(
    "no response with id #{id}"
  )

export response_ids := (output: String) ->
  ["#{decode_json<ResponseHeader>(body).id}" for body in response_bodies(output)]

export diagnostic_body := (line: Int, character: Int, severity: Int, message: String) ->
  position := Position(line, character)
  range := Range(start: position, end: position)
  encode_json Diagnostic(range, severity, message, source: 'lerta')

export published_diagnostics := (uri: String, diagnostics: String[]) ->
  '{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics",' +
    "\"params\":{\"uri\":#{encode_json(uri)},\"diagnostics\":[#{diagnostics.join(',')}]}}"

export initialize_response := (encoding: String) ->
  '{"jsonrpc":"2.0","id":0,' +
    "\"result\":{\"capabilities\":{\"positionEncoding\":\"#{encoding}\",\"textDocumentSync\":1," +
    '"documentFormattingProvider":true,"hoverProvider":true,"definitionProvider":true,' +
    '"completionProvider":{"triggerCharacters":["."]}},"serverInfo":{"name":"lerta"}}}'

export shutdown_response := '{"jsonrpc":"2.0","id":"end","result":null}'

response_from_fragment := (fragment: String) -> "{\"jsonrpc\":\"2.0\",#{fragment}}"

export exact_responses := (output: String, fragments: String[]) ->
  expected := [initialize_response('utf-16')]
  expected.append [response_from_fragment(fragment) for fragment in fragments]
  expected.push shutdown_response
  compare_text 'responses', expected.join("\n"), response_bodies(output).join("\n")

export exact_messages := (output: String, messages: String[]) ->
  expected := [initialize_response('utf-16'), messages..., shutdown_response]
  compare_text 'messages', expected.join("\n"), message_bodies(output).join("\n")
