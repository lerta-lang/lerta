# Where the tests find the repository and the compiler they check, bin/lerta, which `make` builds,
# how they run it, and what they need of it before they start. The tests run from the repository's
# root, as the Makefile runs them.
import is_file, make_dir, make_temp_dir, read_text, real_path, remove_tree, open from 'std:io'
import exit, platform, run from 'std:process'

export root_dir := real_path('.').text()!

if not is_file("#{root_dir}/test/main.lerta")
  print_error 'the tests run from the root of the repository'
  exit 2

# The systems, as third_party/libuv.txt names them, that the host takes: the runtime is built with
# libuv's files and platform_<systems>.c for them (see compiler/libuv.lerta).
export host_systems := platform == 'windows' then ['all', 'windows'] else ['all', 'posix', platform]

export compiler := "#{root_dir}/bin/lerta"
if not is_file(compiler)
  print_error "#{compiler} is missing: run make, or make test, which builds it first"
  exit 2

# The most output kept of each stream of a program that a test runs, far beyond what any test
# prints; the limit only stops runaway output.
export OUTPUT_LIMIT := 1024 * 1024

# Bytes as text in a message, whether they are UTF-8 or not.
export shown_text := (bytes: Binary) -> bytes.text() ? '(not valid UTF-8)'

# A file's text, which must be UTF-8.
export read_text_or_throw := (path: String) ->
  await read_text(path) ? throw ValueError("#{path} is not valid UTF-8")

# What the lines of third_party/libuv.txt for the host's systems give of the kind, as `source`,
# `flag` or `library`, by the rule of is_for in compiler/libuv.lerta.
export host_libuv_items := (kind: String) ->
  items: String[]
  for line in (await read_text_or_throw("#{root_dir}/third_party/libuv.txt")).split("\n")
    continue if line.is_empty() or line.starts_with('#')
    words := line.split(' ')
    continue if words.length != 3 or not host_systems.contains(words[0])
    items.push words[2] if words[1] == kind
  items

# The directory of what the tests make, made as they start and removed as they end (see
# remove_work_root); each suite works in a directory of its own in it.
work_root := make_temp_dir().text()!

export suite_dir := (name: String) ->
  path := "#{work_root}/#{name}"
  make_dir path
  path

export remove_work_root := -> await remove_tree(work_root)

# The compiler caches the runtime it compiles; the tests give it a new cache, which the compilers
# that the tests run inherit through LERTA_CACHE_DIR, so that no cache left by another build of the
# compiler takes part.
export cache_dir := suite_dir('cache')

# A run of a file to its end, whatever its exit status: `failure` tells how it ended, for messages.
export struct FileRun
  status: Int
  failure: String
  errors: String

null_device := platform == 'windows' then 'NUL' else '/dev/null'

export run_file := (file: String, args: String[], cwd: String) ->
  errors: Byte[]
  env := { 'LERTA_CACHE_DIR': cache_dir }
  exit := await run(
    file
    args...
    cwd: cwd
    env: env
    # Its standard output is dropped, as nothing that it would print there is checked.
    stdout: open(null_device, WRITE).writer
    stderr: errors
    output_limit: OUTPUT_LIMIT
  )
  failure :=
    if signal := exit.signal
      "signal #{signal}"
    else
      "exit status #{exit.code}"
  FileRun failure, status: exit.code, errors: shown_text(errors.to_binary())

# The error of a step that the tests need, such as a build, which fails the whole run.
export struct SetupError: Error

# Builds a program in `dir` with each of the sets of flags, so that the compiler caches each kind of
# runtime before the tests start. Otherwise the tests started together would each compile the same
# runtime, and each such compile runs as many clang processes as there are CPUs.
export build_runtimes := (dir: String, flag_sets: String[][]) ->
  build := (flags: String[], index: Int) ->
    args := ['build', 'tests/empty.lerta', '-o', "#{dir}/runtime#{index}", flags...]
    built := await run_file(compiler, args, root_dir)
    if built.status != 0
      what := "tests/empty with [#{flags.join(' ')}]"
      throw SetupError("the build of #{what} failed (#{built.failure}):\n#{built.errors}")
  await promise for promise in [build(flags, i) for flags, i in flag_sets]
