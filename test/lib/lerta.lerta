# Where the tests find the repository and the compiler they check, bin/lerta, which `make` builds,
# how they run it, and what they need of it before they start. The tests run from the repository's
# root, as the Makefile runs them.
import Buffer, is_file, make_dir, make_temp_dir, read_text, real_path, remove_tree from 'std:io'
import env, exit, Exit, platform, run from 'std:process'
import timeout, TimeoutError from 'std:async'
import described_build, description_path from '../../compiler/platform_description'
import cache_dir as compiler_cache_dir from '../../compiler/runtime_cache'
import in_slot from './report'

export root_dir := real_path('.')

unless is_file("#{root_dir}/test/main.lerta")
  print_error 'the tests run from the root of the repository'
  exit 2

# What the name of a program built for the host ends with.
export host_executable_suffix := platform == 'windows' then '.exe' else ''

export compiler := "#{root_dir}/bin/lerta#{host_executable_suffix}"
unless is_file(compiler)
  print_error "#{compiler} is missing: run make, or make test, which builds it first"
  exit 2

# The most output kept of each stream of a program that a test runs, beyond what any test prints:
# the disassembly of a Windows program (see test/cli/build.lerta) takes over 1 MiB, and
# test/runtime/write_non_blocking.c writes 1 MiB. The limit only stops runaway output.
export OUTPUT_LIMIT := 4 * 1024 * 1024

# Bytes as text in a message, whether they are UTF-8 or not.
export shown_text := (bytes: Binary) -> bytes.text() ? '(not valid UTF-8)'

# A file's text, which must be UTF-8.
export read_text_or_throw := (path: String) ->
  await read_text(path) ? throw ValueError("#{path} is not valid UTF-8")

# What the host's description gives it (see compiler/platform_description.lerta).
export host_build := ->
  system := platform.to_string()
  described_build(await read_text_or_throw("#{root_dir}/#{description_path(system)}"), system)

# A file's text, as read_text_or_throw gives it, or the fallback if there is no such file.
export read_text_or := (path: String, fallback: String) ->
  is_file(path) then await read_text_or_throw(path) else fallback

# The directory of what the tests make, made as they start and removed as they end (see
# remove_work_root); each suite works in a directory of its own in it.
work_root := make_temp_dir()

export suite_dir := (name: String) ->
  path := "#{work_root}/#{name}"
  make_dir path
  path

export remove_work_root := -> await remove_tree(work_root)

# Computes a value as a module of the tests is imported, and removes the work directory if that
# throws: imports run before main, whose `finally` removes it otherwise.
export at_import := <T>(compute: () -> Promise<T>) ->
  try
    await compute()
  catch error
    await remove_work_root()
    throw error

# The compiler caches the runtimes, the modules and the objects of the links that it compiles; the
# tests share its default cache, which the compilers that the tests run inherit through
# LERTA_CACHE_DIR, so that a new worktree starts with what earlier builds left. Each entry in it is
# keyed by what it is made from, so that a build of another compiler or with other flags never
# takes what an earlier one left. A driver that the self checks run uses the cache of the run that
# started it, given in LERTA_TEST_CACHE_DIR.
export cache_dir := env('LERTA_TEST_CACHE_DIR') ? real_path(compiler_cache_dir())

# A run of a file to its end, whatever its exit status: `failure` tells how it ended, for messages.
export struct FileRun
  status: Int
  failure: String
  errors: String

export run_file := (file: String, args: String[], cwd: String) ->
  env := { 'LERTA_CACHE_DIR': cache_dir }
  errors := Buffer(limit: OUTPUT_LIMIT)
  ran := run(
    file
    args...
    cwd: cwd
    env: env
    # Its standard output is dropped, as nothing that it would print there is checked.
    stdout: DISCARD
    stderr: errors
  )
  exit := await exit_in_time(file, ran)
  failure := exit.signal then "signal #{exit.signal}" else "exit status #{exit.code}"
  FileRun(failure, status: exit.code, errors: shown_text(errors.binary))

# The error of a step that the tests need, such as a build, or of a program that did not end in
# time: it fails the check that it is thrown in, or the whole run where no check holds it.
export struct SetupError: Error

# The longest that a program the tests run may take, far beyond what any check takes, so that one
# that does not end, as a compiler that loops, fails instead of holding up the run.
RUN_TIMEOUT_SECONDS := 300.0

# The exit of the run of `command`, which is stopped if it has not ended in `seconds`.
export exit_in_time := (
  command: String
  ran: Promise<Exit>
  seconds: Float = RUN_TIMEOUT_SECONDS
) ->
  try
    await timeout(ran, seconds)
  catch _: TimeoutError
    throw SetupError("#{command} did not end in #{seconds.to_fixed(0)}s")

# Fills the compiler's cache with the runtime of each of the sets of flags before the tests start,
# by building a program with each into `dir`. Otherwise the tests started together would each
# compile the same runtime, and each such compile runs as many clang processes as there are CPUs. A
# set that another suite has asked for is built once, into that suite's directory, as the suites get
# ready at the same time and share one cache (see cache_dir); so a failure of that build is reported
# by each of them.
export build_runtimes := (dir: String, flag_sets: String[][]) ->
  build := (flags: String[], index: Int) ->
    args := ['build', 'tests/empty.lerta', '-o', "#{dir}/runtime#{index}", flags...]
    built := await in_slot(-> run_file(compiler, args, root_dir))
    if built.status != 0
      what := "tests/empty with [#{flags.join(' ')}]"
      throw SetupError("the build of #{what} failed (#{built.failure}):\n#{built.errors}")
  for flags at i in flag_sets
    key := flags.join(' ')
    runtime_builds[key] = build(flags, i) unless key in runtime_builds
  await runtime_builds[flag_sets[i].join(' ')]! for _ at i in flag_sets

runtime_builds: Map<String, Promise>
