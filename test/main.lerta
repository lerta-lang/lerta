# The test driver, bin/test, which runs the suites, all of them by default, from the root of the
# repository:
#   bin/test [<suite>...] [-k <text>] [--target <target>] [--list] [--failed] [-j <count>] [-q]
#            [--no-retry]
#   <suite>            run (run.lerta), cli (cli.lerta), format (format.lerta), runtime
#                      (runtime.lerta), leaks (leaks.lerta) or self (self.lerta)
#   -k <text>          only the checks whose names hold the text
#   --target <target>  the run tests' programs built for another target (see lib/target); only the
#                      run suite takes it, which it then selects by default
#   --list             the names of the checks that would run, rather than running them
#   --failed           only the checks that failed when they last ran for the host (see FAILED_FILE)
#   -j <count>         how many checks of a suite run at once; by default, the number of CPUs
#   -q                 only the failures, the run once more of those that failed and how each
#                      ended, and the summaries
#   --no-retry         a failed check is not run once more (see run_checks in lib/report)
# It exits with 0 if no check failed, 1 if one did or a suite could not run them, and 2 for wrong
# arguments or when no check is selected, as when -k is mistyped. The self checks (self.lerta) run
# it with LERTA_TEST_RUN_DIR, which has the run tests be those of another directory (see run.lerta),
# and LERTA_TEST_FAILED_FILE, which names another file than FAILED_FILE.
import remove_work_root, root_dir from './lib/lerta'
import failed_keys, known_keys, Options, ran_keys, selected_keys, set_options from './lib/report'
import target_of from './lib/target'
import is_file, read_text, write_file from 'std:io'
import argv, cpu_count, env, exit from 'std:process'
import suite as run_suite from './run'
import suite as cli_suite from './cli'
import suite as format_suite from './format'
import suite as runtime_suite from './runtime'
import suite as leaks_suite from './leaks'
import suite as self_suite from './self'

SUITE_NAMES := ['run', 'cli', 'format', 'runtime', 'leaks', 'self']

# The keys of the checks that failed when they last ran, one per line (see key in lib/report);
# LERTA_TEST_FAILED_FILE names another file, for the self checks (see self.lerta).
FAILED_FILE := env('LERTA_TEST_FAILED_FILE') ? "#{root_dir}/build/test-failed.txt"

struct Arguments
  suites: String[]
  target: String?
  failed: Bool
  options: Options

usage := (problem: String) ->
  print_error problem
  print_error
    'usage: bin/test [<suite>...] [-k <text>] [--target <target>] [--list] [--failed] [-j ' +
      '<count>] [-q] [--no-retry]'
  await remove_work_root()
  exit 2

parse_arguments := ->
  suites: String[]
  var pattern = ''
  var target: String?
  var listing = false
  var failed = false
  var jobs = cpu_count
  var quiet = false
  var retry = true
  var i = 0
  # The value of the option at i, which it takes too.
  value := ->
    i += 1
    await usage("#{argv[i - 1]} needs a value") if i >= argv.length
    argv[i]
  while i < argv.length
    arg := argv[i]
    case arg
      when '-k' then pattern = await value()
      when '--target' then target = await value()
      when '--list' then listing = true
      when '--failed' then failed = true
      when '-j'
        text := await value()
        jobs = text.parse_int() ? 0
        await usage("-j needs a count above 0: #{text}") if jobs < 1
      when '-q' then quiet = true
      when '--no-retry' then retry = false
      else
        unless arg in SUITE_NAMES
          await usage("not a suite: #{arg} (the suites: #{SUITE_NAMES.join(', ')})")
        suites.push arg unless arg in suites
    i += 1
  if target
    await usage('--target is for the run suite alone') if suites.any((name) -> name != 'run')
    await usage('--failed is for the host alone') if failed
  chosen := not suites.is_empty() then suites else target then ['run'] else SUITE_NAMES
  options := Options(pattern, listing, jobs, quiet, retry, only: nil)
  Arguments target, failed, options, suites: chosen

read_failed_keys := (): Promise<String[]> ->
  return [] unless is_file(FAILED_FILE)
  text := await read_text(FAILED_FILE) ? ''
  [line for line in text.split("\n") when line != '']

# What failed now, and what failed before and did not run now, but not a check that a suite that ran
# no longer has.
write_failed_keys := (before: String[]) ->
  title_of := (key: String) -> key.split("\t")[0]
  ran_titles := Set([title_of(key) for key in known_keys])
  is_kept := (key: String) ->
    key not in ran_keys and (key in known_keys or title_of(key) not in ran_titles)
  kept := [key for key in before when is_kept(key)]
  await write_file(FAILED_FILE, ["#{key}\n" for key in [kept..., failed_keys...]].join(''))

# The number of suites that failed, each of which is reported. The checks that a suite selected but
# could not run count as failed.
run_suites := (names: String[], target: String?) ->
  var failed = 0
  for name in names
    first_selected := selected_keys.length
    failed_checks :=
      try
        case name
          when 'run' then await run_suite(target_of(target))
          when 'cli' then await cli_suite()
          when 'format' then await format_suite()
          when 'runtime' then await runtime_suite()
          when 'leaks' then await leaks_suite()
          else await self_suite()
      catch error
        print "#{name}: the suite could not run its checks: #{error.message}"
        print ''
        for key in selected_keys[first_selected..]
          failed_keys.push key unless key in ran_keys
        1
    failed += 1 if failed_checks > 0
  failed

main := ->
  arguments := await parse_arguments()
  before := await read_failed_keys()
  options := arguments.options
  if arguments.failed
    if before.is_empty()
      print 'no check failed when it last ran'
      return 0
    set_options { options..., only: Set(before) }
  else
    set_options options
  failed_suites := await run_suites(arguments.suites, arguments.target)
  # Only the host's runs are kept, so that the runs for other targets, which test_cross.sh runs at
  # the same time, neither overwrite them nor take one target's failures for another's.
  await write_failed_keys(before) if not options.listing and not arguments.target
  if failed_suites == 0 and selected_keys.is_empty()
    print_error 'no check is selected'
    return 2
  failed_suites > 0 then 1 else 0

status :=
  try
    await main()
  finally
    await remove_work_root()
exit status
