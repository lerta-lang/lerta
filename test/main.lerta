# The test driver, bin/test, which runs the suites, all of them by default, from the root of the
# repository:
#   bin/test [<suite>...] [-k <text>] [--target <triple>] [--list] [--failed] [-j <count>] [-q]
#   <suite>            run (run.lerta), cli (cli.lerta), format (format.lerta) or runtime
#                      (runtime.lerta)
#   -k <text>          only the checks whose names hold the text
#   --target <triple>  the run tests' programs built for another target (see lib/target); only the
#                      run suite takes it, which it then selects by default
#   --list             the names of the checks that would run, rather than running them
#   --failed           only the checks that failed when they last ran for the host (see FAILED_FILE)
#   -j <count>         how many checks of a suite run at once; by default, the number of CPUs
#   -q                 only the failures and the summaries
# It exits with 0 if no check failed, 1 if one did or a suite could not run them, and 2 for wrong
# arguments or when no check is selected, as when -k is mistyped.
import remove_work_root, root_dir from './lib/lerta'
import failed_keys, known_keys, Options, ran_keys, selected_keys, set_options from './lib/report'
import host_target, target_of from './lib/target'
import is_file, read_file, write_file from 'std:io'
import argv, cpu_count, exit from 'std:process'
import suite as run_suite from './run'
import suite as cli_suite from './cli'
import suite as format_suite from './format'
import suite as runtime_suite from './runtime'

const SUITE_NAMES = ['run', 'cli', 'format', 'runtime']

# The keys of the checks that failed when they last ran, one per line (see key in lib/report).
const FAILED_FILE = "#{root_dir}/build/test-failed.txt"

struct Arguments(suites: String[], triple: String?, failed: Bool, options: Options)

const usage = (problem: String) ->
  print_error problem
  print_error(
    'usage: bin/test [<suite>...] [-k <text>] [--target <triple>] [--list] [--failed] [-j <count>] [-q]'
  )
  await remove_work_root()
  exit 2

const parse_arguments = ->
  const suites: String[] = []
  var pattern = ''
  var triple: String?
  var listing = false
  var failed = false
  var jobs = cpu_count
  var quiet = false
  var i = 0
  # The value of the option at i, which it takes too.
  const value = ->
    i += 1
    await usage("#{argv[i - 1]} needs a value") if i >= argv.length
    argv[i]
  while i < argv.length
    const arg = argv[i]
    case arg
      when '-k' then pattern = await value()
      when '--target' then triple = await value()
      when '--list' then listing = true
      when '--failed' then failed = true
      when '-j'
        const text = await value()
        jobs = text.parse_int() ? 0
        await usage("-j needs a count above 0: #{text}") if jobs < 1
      when '-q' then quiet = true
      else
        await usage("not a suite: #{arg}") if not SUITE_NAMES.contains(arg)
        suites.push arg if not suites.contains(arg)
    i += 1
  if triple
    await usage('--target is for the run suite alone') if suites.any((name) -> name != 'run')
    await usage('--failed is for the host alone') if failed
  const chosen = suites.length > 0 then suites else triple then ['run'] else SUITE_NAMES
  const options = Options(pattern, listing, jobs, quiet, only: nil)
  Arguments suites: chosen, triple: triple, failed: failed, options: options

const read_failed_keys = (): Promise<String[]> ->
  return [] if not is_file(FAILED_FILE)
  const text = (await read_file(FAILED_FILE)).text() ? ''
  [line for line in text.split("\n") when line != '']

# What failed now, and what failed before and did not run now, but not a check that a suite that ran
# no longer has.
const write_failed_keys = (before: String[]) ->
  const title_of = (key: String) -> key.split("\t")[0]
  const ran_titles = Set([title_of(key) for key in known_keys])
  const is_kept = (key: String) ->
    not ran_keys.contains(key) and (known_keys.has(key) or not ran_titles.has(title_of(key)))
  const kept = [key for key in before when is_kept(key)]
  await write_file(FAILED_FILE, ["#{key}\n" for key in [kept..., failed_keys...]].join('').binary)

# The number of suites that failed, each of which is reported. The checks that a suite selected but
# could not run count as failed.
const run_suites = (names: String[], triple: String?) ->
  var failed = 0
  for name in names
    const first_selected = selected_keys.length
    const failed_checks =
      try
        case name
          when 'run' then await run_suite(triple then target_of(triple) else host_target)
          when 'cli' then await cli_suite()
          when 'format' then await format_suite()
          else await runtime_suite()
      catch error
        print "#{name}: the suite could not run its checks: #{error.message}"
        print ''
        for i in first_selected...selected_keys.length
          failed_keys.push selected_keys[i] if not ran_keys.contains(selected_keys[i])
        1
    failed += 1 if failed_checks > 0
  failed

const main = ->
  const arguments = await parse_arguments()
  const before = await read_failed_keys()
  const options = arguments.options
  if arguments.failed
    if before.length == 0
      print 'no check failed when it last ran'
      return 0
    const { pattern, listing, jobs, quiet } = options
    set_options Options(pattern, listing, jobs, quiet, only: Set(before))
  else
    set_options options
  const failed_suites = await run_suites(arguments.suites, arguments.triple)
  # Only the host's runs are kept, so that the runs for other targets, which test_cross.sh runs at
  # the same time, neither overwrite them nor take one target's failures for another's.
  await write_failed_keys(before) if not options.listing and not arguments.triple
  if failed_suites == 0 and selected_keys.length == 0
    print_error 'no check is selected'
    return 2
  failed_suites > 0 then 1 else 0

const status =
  try
    await main()
  finally
    await remove_work_root()
exit status
