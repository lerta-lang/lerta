# The test driver, bin/test, which runs the suites, all of them by default, from the root of the
# repository, as `bin/test --help` says (see SPEC): each suite is its module, as run.lerta, and
# --target is that of lib/target. It exits with 0 if no check failed, 1 if one did or a suite could
# not run them, and 2 for wrong arguments or when no check is selected, as when -k is mistyped.
# The self checks (self.lerta) run it with LERTA_TEST_RUN_DIR, which has the run tests be those of
# another directory (see run.lerta), LERTA_TEST_FAILED_FILE, which names another file than
# FAILED_FILE, and LERTA_TEST_CACHE_DIR, the compiler's cache that they use (see lib/lerta).
import remove_work_root, root_dir from './lib/lerta'
import
  failed_keys, known_keys, Options, ran_keys, run_checks, selected_keys, set_options, SuiteChecks
from './lib/report'
import target_of from './lib/target'
import is_file, read_text, write_file from 'std:io'
import ArgsError, decode_args, usage, wants_help from 'std:args'
import members from 'std:enums'
import argv, cpu_count, env, exit, program from 'std:process'
import suite as bootstrap_suite from './bootstrap'
import suite as run_suite from './run'
import suite as cli_suite from './cli'
import suite as format_suite from './format'
import suite as runtime_suite from './runtime'
import suite as leaks_suite from './leaks'
import suite as self_suite from './self'

# The keys of the checks that failed when they last ran, one per line (see key in lib/report);
# LERTA_TEST_FAILED_FILE names another file, for the self checks (see self.lerta).
FAILED_FILE := env('LERTA_TEST_FAILED_FILE') ? "#{root_dir}/build/test-failed.txt"

# The bootstrap first, as the longest check, so that no run ends waiting on it.
enum Suite
  bootstrap
  run
  cli
  format
  runtime
  leaks
  self

struct Arguments
  suites: Suite[] = default []
  pattern := default ''
  target: String?
  list: Bool
  failed: Bool
  jobs := default cpu_count
  quiet: Bool
  no_retry: Bool

# --failed reads FAILED_FILE, and --no-retry is the retry of run_checks in lib/report.
SPEC :=
  # The usage names the suites.
  {
    suites: { positional: true, value: [suite.to_string() for suite in members<Suite>()].join('|') }
    pattern: { short: 'k', value: 'text', help: 'only the checks whose names hold the text' }
    target: { value: 'target', help: "the run suite's programs built for it (see test/lib/target)" }
    list: { help: 'the names of the checks that would run, rather than running them' }
    failed: { help: 'only the checks that failed when they last ran for the host' }
    jobs: { short: 'j', value: 'count', help: 'how many checks run at once' }
    quiet: { short: 'q', help: 'only the failures, their run once more, and the summaries' }
    no_retry: { help: 'do not run a failed check once more' }
  }

# Prints the usage message, after the problem if any, removes the work directory, which the suites
# make as they are imported, and exits: with 2 for a problem.
exit_with_usage := (problem: String?) ->
  print_error "#{program}: #{problem}" if problem
  text := usage<Arguments>(SPEC)
  if problem
    print_error text
  else
    print text
  await remove_work_root()
  exit problem then 2 else 0

# The suites to run, with the options of the checks.
struct Run
  suites: Suite[]
  target: String?
  failed: Bool
  options: Options

parse_arguments := ->
  await exit_with_usage(nil) if wants_help<Arguments>(argv, SPEC)
  arguments :=
    try
      decode_args<Arguments>(argv, SPEC)
    catch error: ArgsError
      await exit_with_usage(error.message)
  { pattern, target, failed, jobs } := arguments
  await exit_with_usage("--jobs takes a count above 0, not #{jobs}") if jobs < 1
  given := [suite for suite at i in arguments.suites when suite not in arguments.suites[..i]]
  if target
    if given.any((suite) -> suite != run)
      await exit_with_usage('--target is for the run suite alone')
    await exit_with_usage('--failed is for the host alone') if failed
  suites := not given.is_empty() then given else target then [Suite.run] else members<Suite>()
  options := Options
    pattern
    jobs
    quiet: arguments.quiet
    listing: arguments.list
    retry: not arguments.no_retry
    only: nil
  Run(suites, target, failed, options)

read_failed_keys := (): Promise<String[]> ->
  return [] unless is_file(FAILED_FILE)
  text := await read_text(FAILED_FILE) ? ''
  [line for line in text.split("\n") when not line.is_empty()]

# What failed now, and what failed before and did not run now, but not a check that a suite that ran
# no longer has.
write_failed_keys := (before: String[]) ->
  title_of := (key: String) -> key.split("\t")[0]
  ran_titles := Set([title_of(key) for key in known_keys])
  is_kept := (key: String) ->
    key not in ran_keys and (key in known_keys or title_of(key) not in ran_titles)
  kept := [key for key in before when is_kept(key)]
  await write_file(FAILED_FILE, ["#{key}\n" for key in [kept..., failed_keys...]].join())

# Waits for the promise, whatever it ends with.
settled := (promise: Promise) ->
  try
    await promise
  catch _
    return

# The number of failures of suites, each of which is reported. A suite whose checks could not be
# gathered fails at once, and the checks that it selected count as failed; the others run their
# checks as one list (see run_checks), and a suite that then could not stop fails once more.
run_suites := (suites: Suite[], target: String?) ->
  var failed = 0
  gathered: SuiteChecks[]
  for suite in suites
    first_selected := selected_keys.length
    try
      checks :=
        case suite
          when bootstrap then bootstrap_suite()
          when run then await run_suite(target_of(target))
          when cli then await cli_suite()
          when format then format_suite()
          when runtime then runtime_suite()
          when leaks then leaks_suite()
          when self then self_suite()
      gathered.push checks if checks
    catch error
      print "#{suite}: the suite could not run its checks: #{error.message}"
      print ''
      failed_keys.push key for key in selected_keys[first_selected..]
      failed += 1
  try
    failed += await run_checks(gathered)
  finally
    for checks in gathered
      # Awaited here too, in case run_checks threw before its checks did, as a promise that throws
      # and is never awaited ends the program.
      await settled(ready) if ready := checks.ready
      try
        await stop() if stop := checks.stop
      catch error
        print "#{checks.title}: the suite could not stop: #{error.message}"
        print ''
        failed += 1
  failed

main := ->
  arguments := await parse_arguments()
  before := await read_failed_keys()
  options := arguments.options
  if arguments.failed
    if before.is_empty()
      print 'no check failed when it last ran'
      return 0
    set_options { options..., only: Set(before) }
  else
    set_options options
  failed_suites := await run_suites(arguments.suites, arguments.target)
  # Only the host's runs are kept, so that the runs for other targets, which make test-targets may
  # run at the same time, neither overwrite them nor take one target's failures for another's.
  await write_failed_keys(before) if not options.listing and not arguments.target
  if failed_suites == 0 and selected_keys.is_empty()
    print_error 'no check is selected'
    return 2
  failed_suites > 0 then 1 else 0

status :=
  try
    await main()
  finally
    await remove_work_root()
exit status
