# The command line: each invocation runs in an empty directory and checks its output and leftovers.
# The invocations given by the files in tests/cli must leave no file there, nor in the directory for
# temporary files:
#   <name>.args    the arguments, one per line
#   <name>.in      stdin; none means empty
#   <name>.status  the expected exit status; none means 0
#   <name>.out     the expected stdout; none means empty
#   <name>.err     the expected stderr; none means empty
#   status.txt     invocations checked only by their exit status, one per line: the status, then
#                  the arguments, separated by spaces
# Those of tests/cli/posix, but status.txt, are of what only POSIX systems have, such as signals,
# and are not run on Windows.
# In the files of arguments, empty lines are skipped and lines that start with `#` are comments,
# so no argument is empty or starts with `#`, and none in status.txt has a space. In the arguments
# and the expected output, <root> stands for the repository, <tmp> for the work directory and
# <host> for the host's triple.
import at_once, Check, select, SuiteChecks from './lib/report'
import compare_output, expect_status from './lib/expect'
import
  cli_work_dir, expect_left, host_triple, read_optional, runtime_flags, run_in_new_dir
from './lib/cli'
import build_runtimes, compiler, read_text_or, read_text_or_throw, root_dir from './lib/lerta'
import list_dir, make_dir from 'std:io'
import platform from 'std:process'
import checks as std_checks from './cli/std'
import checks as embed_checks from './cli/embed'
import checks as build_tool_checks from './cli/build_tool'
import checks as build_checks from './cli/build'
import checks as extern_checks from './cli/extern'
import checks as lsp_checks from './cli/lsp'
import checks as lsp_completion_checks from './cli/lsp_completion'
import checks as lsp_references_checks from './cli/lsp_references'
import checks as cache_checks from './cli/cache'
import checks as program_checks from './cli/programs'

cases_dir := "#{root_dir}/tests/cli"

expand := (text: String) ->
  text.replace('<root>', root_dir).replace('<tmp>', cli_work_dir).replace('<host>', host_triple)

content_lines := (text: String) ->
  [
    for line in text.split("\n") when not line.is_empty() and not line.starts_with('#')
      line
  ]

parse_status := (text: String, where: String) ->
  parts := text.split("\n")
  is_one_line := parts.length == 1 or (parts.length == 2 and parts[1].is_empty())
  status := is_one_line and parts[0].is_digits() then parts[0].parse_int()
  status else throw ValueError("not an exit status in #{where}: #{text}")

# The files of tests/cli, with those of tests/cli/posix as `posix/<file>`.
top_case_files := [file for file in list_dir(cases_dir) when file != 'posix']
posix_case_files := ["posix/#{file}" for file in list_dir("#{cases_dir}/posix")]
case_files := top_case_files + posix_case_files

case_names := [file.without_suffix('.args')! for file in case_files when file.ends_with('.args')]

applies := (name: String) -> platform != 'windows' or not name.starts_with('posix/')

struct FileCase
  # The invocation as the files give it, with <root> and the others unexpanded.
  title: String
  args: String[]
  input: Binary
  status: Int
  stdout: Binary
  stderr: Binary

read_expected_text := (name: String, extension: String) ->
  expand(await read_text_or("#{cases_dir}/#{name}.#{extension}", ''))

file_case := (name: String) ->
  args := content_lines(await read_text_or_throw("#{cases_dir}/#{name}.args"))
  input := await read_optional("#{cases_dir}/#{name}.in") else b''
  status_text := await read_text_or("#{cases_dir}/#{name}.status", '0')
  status := parse_status(status_text, "#{name}.status")
  FileCase(
    input
    status
    title: "lerta #{args.join(' ')}"
    args: [expand(arg) for arg in args]
    stdout: (await read_expected_text(name, 'out')).binary
    stderr: (await read_expected_text(name, 'err')).binary
  )

file_check := (test: FileCase) ->
  Check(name: test.title, run: ->
    { result, left, left_in_temp } := await run_in_new_dir(compiler, test.args, test.input)
    [
      expect_status(test.status, result.status)...
      compare_output('stdout', test.stdout, result.stdout)...
      compare_output('stderr', test.stderr, result.stderr)...
      expect_left('files left', [], left)...
      expect_left('files left in the temporary directory', [], left_in_temp)...
    ]
  )

status_checks := ->
  contents := await read_text_or_throw("#{cases_dir}/status.txt")
  checks: Check[]
  for line in content_lines(contents)
    parts := line.split(' ')
    status := parse_status(parts[0], 'status.txt')
    args := parts[1..]
    checks.push { name: "lerta #{args.join(' ')}", run: ->
      ran := await run_in_new_dir(compiler, [expand(arg) for arg in args])
      [
        expect_status(status, ran.result.status)...
        expect_left('files left', [], ran.left)...
        expect_left('files left in the temporary directory', [], ran.left_in_temp)...
      ]
    }
  checks

stray_files := ->
  [
    "stray file: tests/cli/#{file}"
    for file in case_files
    when file != 'status.txt' and
      not case_names.any((name) ->
        ['args', 'in', 'status', 'out', 'err'].any((extension) -> file == "#{name}.#{extension}")
      )
  ]

# The checks that the suite selected, if any. The runtimes are cached before the checks start,
# which a check of its own reports a failure of.
export suite := ->
  title := 'CLI checks'
  cases := [await file_case(name) for name in case_names when applies(name)]
  var runtime_setup_errors: String[]
  extras: Check[] =
    { name: 'CLI runtime setup', run: -> await at_once(runtime_setup_errors) }
    { name: 'tests/cli has no file that no case reads', run: -> await at_once(stray_files()) }
  file_checks := [file_check(test) for test in cases]
  all_checks := [
    file_checks...
    await status_checks()...
    std_checks...
    embed_checks...
    build_tool_checks...
    build_checks...
    program_checks...
    extern_checks...
    lsp_checks...
    lsp_completion_checks...
    lsp_references_checks...
    cache_checks...
    extras...
  ]
  checks := select(title, all_checks) else return nil
  set_up := ->
    try
      make_dir "#{cli_work_dir}/runtimes"
      await build_runtimes("#{cli_work_dir}/runtimes", runtime_flags)
    catch error
      runtime_setup_errors = ["building the CLI runtime cache failed: #{error.message}"]
  SuiteChecks(title, checks, ready: set_up())
