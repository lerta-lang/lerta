# The operands of an assertion are typed as the comparison types them: the right operand of `in`
# takes the type of the left one, what is not of a type is narrowed to the rest, and an operand
# converted to the type of the other is compared as converted.
small: Int8 = 2
assert small in [[1, 2]..., 3]
assert small not in [[4]..., 5]
number := 3
assert number in 1..=5
assert number not in 4..9
value: Int | String = 1
assert value is not String
assert value + 1 == 2
maybe: Int? = 4
twice := (n: Int) -> n * 2
assert twice(2) == maybe
assert maybe == twice(2)
print 'held'
