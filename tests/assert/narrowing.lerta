# What follows an assert sees what its condition tests narrowed where it holds, as after a guard;
# an operand that takes its type from the other takes it as in the comparison alone.
type Value = Int | String

struct Holder
  value: Value

m := { 'a': 1 }
found := m['a']
assert found
print found + 1
held := m['a']
assert held == 1
print held + 1
value: Value = 'text'
assert value is String
print value.to_upper()
holder := Holder(2)
assert holder.value is Int
print holder.value + 1
bytes: Byte[] = [1]
assert bytes == [1]
floats := [1.0]
assert floats == [1]
record: { x: Int8 } = { x: 1 }
assert record == { x: 1 }
small: Int8? = 1
assert small == 1
assert 'a' in ['a', 'b']

# The last statement of a function literal may be an assert.
check := (x: Int) -> assert(x > 0)
check 1
print 'done'
