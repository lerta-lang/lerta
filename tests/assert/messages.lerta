# A failed assert throws an AssertionError whose message tells where it is, quotes the call and
# gives the literals of the operands of a comparison or of `is` that are not written as literals.
enum Color
  RED
  GREEN

struct Point
  x: Int
  y: Int

class Box
  args
    item: Int

  check := -> assert(@item == 2)

type Value = Int | String

attempt := (f: () -> void) ->
  try
    f()
  catch e: AssertionError
    print e.message

twice := (x: Int) -> x * 2
xs := [1, 2, 3]
m := { 'a': 1 }
value: Value = 'text'
small: Int8 = 3
maybe_six: Int? = 6
color := Color.RED
point := Point(x: 1, y: 2)
attempt -> assert(twice(3) == 5)
attempt -> assert(xs != [1, 2, 3])
attempt -> assert(xs.length < 2)
attempt -> assert(4 in xs)
attempt -> assert(xs.is_empty())
# An optional operand shows nil, or what it holds.
attempt -> assert(m['b'] == 1)
attempt -> assert(m['a'] == 2)
attempt -> assert(value is Int)
# Those of a test that `not` negates are shown too, and so are the parts of a range after `in`.
attempt -> assert(value is not String)
attempt -> assert(small not in [[1]..., 3])
attempt -> assert(twice(1) in xs[2]..=5)
attempt -> assert(twice(1) in 1..=xs[0])
attempt -> assert(twice(1) in twice(2)..twice(3))
# nil, as the source writes it, is not shown.
attempt -> assert(maybe_six == nil)
# An operand converted to the type of the other shows its value as it is.
attempt -> assert(twice(2) == maybe_six)
# An operand that the source writes as a literal is not shown.
attempt -> assert(small == 4)
attempt -> assert(color == GREEN)
# A struct shows its literal, made of its fields'.
attempt -> assert(point == { x: 2, y: 2 })
attempt -> assert([point] == [])
attempt -> assert(point.x == 2)
attempt -> Box(1).check()
# A comment after the call is not quoted.
attempt -> assert(twice(1) > 2)  # not 2
# Each operand is evaluated once.
var calls = 0
counted := ->
  calls += 1
  calls
attempt -> assert(counted() == 5)
print calls
# The quote of a call over lines runs through the line that closes its brackets.
attempt ->
  assert(
    twice(1) == 3
  )  # fmt: skip
# A class, which has no to_literal, shows nothing.
attempt -> assert(Box(1) == Box(1))
