import spawn from 'std:async'
import sleep from 'std:time'

# A Float32 is a float of 32 bits, which a literal is where one is expected. Its arithmetic is in 32
# bits, and its text the fewest digits that read back as it.
tenth: Float32 = 0.1
three: Float32 = 3
print [tenth, three, tenth + three, tenth * three, three - tenth, three / 2, -tenth]
print [tenth == 0.1, tenth != 0.1, tenth < three, tenth >= three]

# The largest finite Float32, the least positive one, and both zeros.
edges: Float32[] = [3.4028234e38, -3.4028234e38, 1e-45, 0.0, -0.0]
print edges
largest: Float32 = 340282346638528859811704183484516925440
print [largest == edges[0]]

# A literal rounds to a Float32 at once: through a double, this one would round to the double
# halfway between 1.0 and the next Float32, and then down to 1.0.
rounded: Float32 = 1.0000000596046447753906250000001
print [rounded]

# -0.0 and 0.0 are one key, and one item of a set.
counts: Map<Float32, Int>
counts[0.0] = 1
counts[-0.0] = 2
print counts.keys().to_array()
print counts[0.0]!
halves := Set<Float32>([0.5, 0.5, 0.25])
print [x for x in halves]
pairs: Map<Float32[], String> = { [1.5, 2.5]: 'pair' }
print pairs[[1.5, 2.5]]!

# A C function takes and gives a Float32 as a float.
extern sqrtf as square_root: (Float32) -> Float32
print [square_root(0.25)]
print [square_root(2.25) == 1.5]
var total: Float32 = 1
total += 0.5
total *= tenth
print [total]

# A result too small for a Float32 rounds toward zero, without throwing.
least: Float32 = 1e-45
print [least / 2, -least / 4]

# Arrays hold a Float32 in 4 bytes, through each operation; a struct and an optional hold one too.
xs: Float32[] = [0.25]
xs.push -1.5
xs[0] += 1
print [xs.pop(), xs[0], [x * 2 for x in xs][0]]
struct Point
  x: Float32
maybe: Float32? = Point(2.5).x
print [maybe!]

# Just below the halfway point to the next power of two, a literal rounds to the largest Float32.
near: Float32 = 3.40282356e38
print [near == edges[0]]
hex: Float32 = 0x10
print [hex]

# A Float32 passes through functions, generics, optionals, tuples and structs, as a key too.
halve := (x: Float32): Float32 -> x / 2
first := <T>(items: T[]) -> items[0]
print [halve(first(xs))]
none: Float32? = nil
print [none == nil, maybe == 2.5, maybe != nil]
by_tuple: Map<(Float32, Int), String> = { (-0.0, 1): 'zero' }
print by_tuple[(0.0, 1)]!
by_point := { Point(0.5): 'half' }
print by_point[{ x: 0.5 }]!

extend Float32
  doubled = -> @ * 2
print [tenth.doubled()]

# A float literal takes its type from what it meets, as an integer literal does.
pick := <T>(x: T, y: T) -> y
print [1.5 + tenth, -1.5 * 2.0 + three, pick(three, 2.5)]
mixed := [1.5, tenth]
print [mixed[0], [x for x in xs][0]]
print [1.25 in xs, xs == [1.25], xs == [1.5]]
nested: Float32[][] = [[0.5], []]
print nested

# Too small for a Float32, a literal rounds to its least value, or to zero.
tiny: Float32[] = [8e-46, 7e-46, -1e-46]
print tiny

later := (): Promise<Float32> ->
  await sleep(0)
  0.75
main := -> print([await later()])
spawn main()

# Where nothing else decides, a float literal makes the integer literals it meets Floats.
struct Pair<T>
  first: T
  second: T
pair := Pair(first: 1, second: 2.5)
print [[1, 1.5][0], pick(1, 2.5), pair.first, 9223372036854775808 + 0.5]

# A Float32 is Comparable and Hashable, as a Float is.
print [tenth.compare(three), three.compare(tenth), tenth.compare(0.1)]
also_tenth: Float32 = 0.1
print [tenth.equals(0.1), tenth.hash() == also_tenth.hash()]
zero: Float32 = 0.0
negative_zero: Float32 = -0.0
negative: Float32 = -1.5
print [zero.compare(-0.0), negative.compare(-0.5)]
print [zero.equals(-0.0), zero.hash() == negative_zero.hash()]
