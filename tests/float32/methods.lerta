# A Float32 is written with the fewest digits that read back as it, and converts to and from a
# Float.
tenth: Float32 = 0.1
print tenth
print "#{tenth} of #{tenth.to_float()}"
third: Float32 = 1.0 / 3.0
print [third.to_string(), (1.0 / 3.0).to_string()]
edges: Float32[] = [3.4028234e38, 1e-45, -0.0, 16777216, 1e16, 0.0001]
print [x.to_string() for x in edges]

# A Float rounds to the nearest Float32, or to zero below the least.
print 0.1.to_float32() == tenth
print [1e-50.to_float32(), -1e-50.to_float32()]
print [3.4028235e38.to_float32(), 16777217.0.to_float32()]
print [(3.4028235e38 + 1e30).to_float32(), 3e-45.to_float32(), 1e-45.to_float32()]
