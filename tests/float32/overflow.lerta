# A Float32 result too large for a Float32 is an infinity, as it would not be for a Float, and so
# is a nonzero Float32 divided by zero; an array writes an infinity as a literal would.
zero: Float32 = 0
one: Float32 = 1
big: Float32 = 3.4028234e38
small: Float32 = 0.001
print "#{one / zero} #{-one / zero}"
print "#{3e38 / small} #{big * 3.5} #{big * 2} #{-big * 2} #{-big - big}"
cube := (big: Float32) -> big * big * big
print cube(1e30)
print [one / zero, 1.5]
