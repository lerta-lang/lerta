import base_name, dir_name, join, normalize, relative from 'std:path'

print dir_name('C:\a\b')
print dir_name('C:\a')
print dir_name('c:/a/b')
print dir_name('C:\')
print dir_name('C:a')
print dir_name('\\server\share\a\b')
print dir_name('\\server\share')
print dir_name('\\server')
print dir_name('\a\b')
print base_name('C:\a\b.lerta')
print base_name('\\server\share')
print join('C:\a', '..\..\b')
print join('\\server\share\a', '../../b')
print join('C:\a/b', 'c')
print relative('a', 'a\b', 'C:\w')
print relative('a', 'D:\b\c', 'C:\w')
print relative('\\s\t\a', '\\s\t\b', 'C:\w')
print relative('\\s\t\a', '\\s\u\a', 'C:\w')
print relative('a', 'c:\w\b', 'C:\w')
print dir_name('c:\a')
print join('C:\', '..\a')
print join('\\s\t', '..')
print base_name('C:\')
print relative('..\a', '..\..\b', 'C:\w')
print join('c:\a', 'b')
print join('\\s\t\a', '../../..')
print dir_name('/\server/share\a')

# A root alone, followed by names, which start no share, nor do those that a later path starts with;
# a first path that starts one keeps it, even with a server alone, but not two separators alone.
print join('/', 'a', 'b')
print join('\', 'a')
print join('/', '/s/t')
print join('C:\', '/a')
print join('\\s\t', 'a')
print join('\\s', 't', 'f')
print join('//', 'a', 'b')
print join('\\', 'a')

# A first path alone, normalized as it is, also when the rest add no names; and one that ends with
# separators of both kinds.
print join('C:')
print join('\\s\t', '/')
print join('C:\', '\')
print join('C:\a\/', 'b')

# A relative path whose first name starts with a drive is given `./`, without which it would start
# at that drive or its current directory, as one written so is, but not one whose later name does.
print normalize('./C:/x')
print join('.', 'C:/x')
print normalize('a/../C:/x')
print normalize('./C:')
print join('.', 'C:')
print normalize('./C:a/x')
print normalize('.\C:\x')
print normalize('./c:/x')
print normalize(normalize('./C:/x'))
print normalize('./a/C:/x')
print normalize('C:a/x')
print dir_name('./C:/x')
print relative('C:\w', 'C:\w\D:x')
