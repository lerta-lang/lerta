# A path's extension and stem, as its last name gives them; join of more paths; normalize; and the
# current directory, an absolute path to where the program runs.
import real_path from 'std:io'
import absolute, base_name, extension, is_absolute, join, normalize, relative, stem from 'std:path'
import cwd from 'std:process'

for path in [
  'a/b.lerta', 'a.tar.gz', 'a/.profile', 'a/b', 'a.', 'a/b.c/d', '.a.b', '..', 'a/..', '..a.b'
]
  print "#{path}: #{extension(path) ? '-'} #{stem(path)}"
print join('a', 'b/', '../c', './d')
print join('a')
print normalize('a/./b//../c/')
print normalize('../a/..')
here := cwd()
print is_absolute(here)
print real_path(here) == real_path('.')
print absolute('a') == join(here, 'a')
print relative(here, join(here, 'x/y'))
# Empty paths, and above the root; the same directory, and ones above it.
print [join('', 'a'), join('', ''), join('a', '', 'b'), join('a', '/b')]
print [normalize(''), normalize('/..'), normalize('/a/../..')]
print [relative('/a', '/a'), relative('/a/b', '/a/c'), relative('/a/b/c', '/a')]
# A relative base, from the current directory.
print relative('..', 'a', '.') == join(base_name(here), 'a')
