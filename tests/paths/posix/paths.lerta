import base_name, dir_name, join, normalize, relative from 'std:path'

print dir_name('/a/b/c')
print dir_name('/a')
print dir_name('/')
print dir_name('a')
print dir_name('a//b/')
print dir_name('a\b')
print base_name('a\b')
print base_name('/a/b/')
print base_name('/')
print join('/a/b', '../c/./d')
print join('a', '../../b')
print join('/', '../a')
print join('.', '.')
print relative('a/b', 'a/c/d', '/w')
print relative('/x', 'y', '/w')
print relative('a', 'a', '/w')
print dir_name('//a/b')
print relative('../a', '../../b', '/w/x')
print dir_name('')
print base_name('')
print relative('/', '/a', '/w')

# A first name that would start a drive on Windows is a name alone.
print normalize('./C:/x')
