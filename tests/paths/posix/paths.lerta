import basename, dirname, join, relative from '../../../compiler/paths'

print dirname('/a/b/c')
print dirname('/a')
print dirname('/')
print dirname('a')
print dirname('a//b/')
print dirname('a\b')
print basename('a\b')
print basename('/a/b/')
print basename('/')
print join('/a/b', '../c/./d')
print join('a', '../../b')
print join('/', '../a')
print join('.', '.')
print relative('/w', 'a/b', 'a/c/d')
print relative('/w', '/x', 'y')
print relative('/w', 'a', 'a')
print dirname('//a/b')
print relative('/w/x', '../a', '../../b')
print dirname('')
print basename('')
print relative('/w', '/', '/a')
