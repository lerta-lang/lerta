# A String's parts without positions: after its first code points, or those that hold; before or
# after a part; its byte count. An Iter skips likewise.
s := 'café au lait'
print s.skip(3)
print s.skip(100)
print "[#{s.skip(-1)}] [#{''.skip(2)}]"
print '  x y'.skip_while((c) -> c == ' ')
print s.skip_while((c) -> c != ' ')
print s.before(' ')!
print s.after(' ')!
print s.before('x') == nil
print "#{s.byte_count()} #{s.count()}"
print s.take(4).join()
print [1, 2, 3, 4].iter().skip(2).to_array()
print [1, 2, 3, 1].iter().skip_while((x) -> x < 3).to_array()
print [c for c in s].iter().skip(5).join()

# At the ends: all skipped, nothing to skip, a part at the end or empty, and multi-byte text.
all_skipped := 'aaa'.skip_while((c) -> c == 'a')
none_left := ''.skip_while((_) -> true)
print "[#{all_skipped}] [#{none_left}]"
print 'ééx'.skip_while((c) -> c == 'é')
print "[#{'abc'.after('c')!}] [#{'abc'.before('')!}] [#{'abc'.after('')!}]"
print "#{'naïve café'.before('é')!} #{'naïve café'.after('ï')!}"
print [1, 2].iter().skip(0).to_array()
print [1, 2].iter().skip(-3).to_array()
print [1, 2].iter().skip(5).to_array()
print [5, 1].iter().skip_while((x) -> x < 3).to_array()
print [1, 2].iter().skip_while((x) -> x < 3).to_array()

# The first occurrence; all the code points; an empty String's bytes; a predicate not called again.
print "#{'k = v = w'.before(' = ')!} #{'k = v = w'.after(' = ')!}"
print "[#{'café'.skip(4)}] #{''.byte_count()}"
var calls = 0
counted := (x: Int) ->
  calls += 1
  x < 2
print [1, 5, 1, 1].iter().skip_while(counted).to_array()
print calls
