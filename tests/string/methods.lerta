# contains, trim, trim_start, trim_end, replace, repeat and split_once, which take and give no
# positions.
print ['hello world'.contains('o w'), 'hello'.contains('z'), 'hello'.contains(''), ''.contains('')]
print ['café'.contains('é'), 'café'.contains('e')]

print ["  \t padded \r\n".trim(), '   '.trim(), ''.trim(), 'inner  space'.trim(), ' é '.trim()]
print ["\t a b \n".trim_start(), '   '.trim_start(), ''.trim_start(), ' é '.trim_start()]
print ["\t a b \r\n".trim_end(), '   '.trim_end(), ''.trim_end(), ' é '.trim_end()]

print ['a-b-c'.replace('-', '+'), 'aaa'.replace('aa', 'b'), 'none'.replace('x', 'y')]
print ['ab'.replace('ab', ''), 'é'.replace('é', 'e'), 'aXbX'.replace('X', 'XX')]

print ['ab'.repeat(3), 'x'.repeat(0), ''.repeat(5)]

(key, value) := 'key = value = more'.split_once(' = ')!
print [key, value]
print 'no separator'.split_once('=') == nil
(before, after) := '=edge='.split_once('=')!
print [before, after]
(last, empty) := 'a='.split_once('=')!
(left, right) := 'aéb'.split_once('é')!
print [last, empty, left, right]
print ['x  '.trim(), '  x'.trim(), 'a,b,,c'.replace(',', ''), 'ab'.repeat(1)]
