# parse_int takes an optional minus and decimal digits alone, within the range of Int.
print '-5'.parse_int()!
print '-0'.parse_int()!
print '007'.parse_int()!
print '9223372036854775807'.parse_int()!
print '-9223372036854775808'.parse_int()!
print '9223372036854775808'.parse_int() == nil
print '-9223372036854775809'.parse_int() == nil
print '+1'.parse_int() == nil
print ' 1'.parse_int() == nil
print ''.parse_int() == nil
print '-'.parse_int() == nil
print '1a'.parse_int() == nil
