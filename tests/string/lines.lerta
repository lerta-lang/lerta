# The lines without their line ends, \n or \r\n, and no empty line after a last \n.
print "a\nb\r\nc".lines()
print "a\n\nb\n".lines()
print "a\r\n".lines()
print "\r\n".lines()
print "a\r\n\r\n".lines()
print "\n".lines()
print ''.lines()

# A \r alone ends no line, and only the one before \n goes.
print "a\rb\r\r\n".lines()
print "a\r".lines()
print "a\nb\r".lines()
print "\r".lines()
