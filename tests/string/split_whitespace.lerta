# The pieces between runs of the spaces of Char.is_space, none empty, beyond ASCII too.
print "  a b\t\tc\r\nd  ".split_whitespace()
print 'one'.split_whitespace()
print ''.split_whitespace()
print " \t\n".split_whitespace()
print 'café été'.split_whitespace()
print "a\x0Bb\x0Cc　d\u{A0}\u{2000}é\u{2029}".split_whitespace()
print '　 　'.split_whitespace()
