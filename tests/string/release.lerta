# Heap strings from to_string are released after use; the debug runtime reports any leak.
3.to_string()
for i in 0...1000
  print case
    when i < 999 then 'small'
    else i.to_string()
print case
  when false then 1.to_string()
  else
    case
      when true then 2.to_string()
      else 'never'
