# Interpolation takes its parts, and may extend one that nothing else holds where it stands, first,
# last or between others, its bytes moved after those before it; it leaves a part that something
# else holds as it was. The output cannot tell an extended part from a copy, but the debug runtime
# reports a part released twice or not at all.
shared := 'shared'
print "a#{1.to_string()}"
print "#{12.to_string()}b"
print "a#{123.to_string()}b"
print "#{shared}#{4.to_string()}#{shared}"
print shared
print "#{5.to_string()}#{67.to_string()}"
# A part longer than those before it, moved over bytes of its own.
print "ab#{'xyz'.repeat(2)}"
# An empty part that nothing else holds, which the inner interpolation makes exactly, so that it is
# copied, not extended.
print "#{"#{''}"}y"
# Long results: no part's place has room for the first, and the room for the second depends on how
# its parts grew.
long := 'x'.repeat(300)
print b"#{long}#{10.to_string()}#{long}".length
print b"#{long}#{'z'.repeat(400)}".length
print long.binary.length
# Two parts that nothing else holds, of different lengths, either of which may have the room.
print b"#{14.to_string()}#{'w'.repeat(40)}".length
# A single part that nothing else holds, which is the result itself.
print "#{5.to_string()}"
# A part that something else holds once more, which is copied, and stays as it was.
held := 9.to_string()
print "a#{held}"
print held
# The same String twice is held twice, so neither is extended.
twice := 11.to_string()
print "#{twice}#{twice}"
print twice
# add, unlike +, goes through the same concatenation, of operands that something else holds.
print shared.add(shared)
print 13.to_string().add(shared)
print shared
bytes := b'b'
print b'a'.add(bytes).add(bytes).text()!
print bytes.text()!
