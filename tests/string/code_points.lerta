# A String gives its code points as CodePoints, the UInt32s that a string literal of one code point
# stands for where one is expected.
const text = 'aé€😀'
const points: CodePoint[] = [c for c in text]
print points
print points == ['a', 'é', '€', '😀']
const first: CodePoint = text.iter().next()
print first == 'a'

# Of each length of UTF-8 sequence, its first and last code points.
const edges = "\u{0}\u{7F}\u{80}\u{7FF}\u{800}\u{FFFF}\u{10000}\u{10FFFF}"
print [c.to_int() for c in edges]

const kind = (c: CodePoint) ->
  case c
    when 'é' then 'e acute'
    when 0x1F600 then 'grinning face'
    else 'other'
print [kind(c) for c in 'é😀x']

# Bitwise operators take a code point apart.
const plane = (c: CodePoint) -> (c >> 16).to_int()
print [plane('a'), plane('😀')]

# Where a CodePoint is expected: an optional, arithmetic, an argument and an escape.
const accent: CodePoint? = 'é'
const next: CodePoint = 'a' + 1
print [accent!.to_int(), next.to_int(), plane('😀')]
print kind("\u{1F600}")
const last: CodePoint = "\u{10FFFF}"
print last.to_int()

# Compared, and as a map key, a string literal stands for a code point.
print [c == '€' for c in 'x€']
const names: Map<CodePoint, String> = { 'é': 'e acute' }
print names['é']!
