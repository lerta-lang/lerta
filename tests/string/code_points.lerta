# A String is Iterable: it gives its code points, as Ints, from sequences of one to four bytes.
print c for c in 'aé€😀'
print 'héllo'.iter().to_array().length
print [c for c in ''].length
# The first and last code points of each length of sequence.
print c for c in '߿ࠀ￿𐀀􏿿'
print 'abc'.map((c) -> c + 1).to_array()[0]
const it = 'x'.iter()
print it.next()
print it.has_next()
