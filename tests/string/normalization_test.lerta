# Every line of the Unicode Character Database's NormalizationTest.txt, as its header says: of the
# columns c1 to c5, c2 is the NFC of c1, c2 and c3, and c4 that of c4 and c5; c3 is the NFD of c1,
# c2 and c3, and c5 that of c4 and c5; c4 is the NFKC of all five, and c5 their NFKD. And every
# character that its Part 1 does not list is its own normal form in each: a sample of them, as all
# would make the test slow.
import '../../third_party/ucd/NormalizationTest.txt' as TESTS: String

FORMS: NormalForm[] = [NFC, NFD, NFKC, NFKD]

# The text of the code points that the hexadecimal numbers stand for, separated by spaces.
text_of := (codes: String) ->
  var text = ''
  for hex in codes.split_whitespace()
    var code = 0
    for byte in hex.binary
      code = code * 16 + byte.hex_value()!
    text += code.to_char()!
  text

# The column of the normal form, in the form, of each column, counted from 0.
expected_columns := (form: NormalForm) ->
  case form
    when NFC then [1, 1, 1, 3, 3]
    when NFD then [2, 2, 2, 4, 4]
    when NFKC then [3, 3, 3, 3, 3]
    when NFKD then [4, 4, 4, 4, 4]

var lines = 0
var failures = 0
var in_part_1 = false
listed: Set<Char>
for line in TESTS.lines()
  continue if line.is_empty() or line.starts_with('#')
  if line.starts_with('@Part')
    in_part_1 = line.starts_with('@Part1')
    continue
  columns := [text_of(column) for column in line.split(';')[..5]]
  listed.add columns[0].iter().next() if in_part_1
  lines += 1
  for form in FORMS
    for column at i in columns
      expected := columns[expected_columns(form)[i]]
      continue if column.normalize(form) == expected
      failures += 1
      print "#{form}: #{line}" if failures <= 10

# A character of each 97 code points, past the surrogates, is a sample of those not listed.
var unlisted = 0
for code in 0..0x110000
  continue if code % 97 != 0
  c := code.to_char() else continue
  continue if c in listed
  unlisted += 1
  text := c.to_string()
  for form in FORMS
    continue if text.normalize(form) == text
    failures += 1
    print "#{form}: U+#{code.to_hex(4)} is not its own" if failures <= 10

print "#{lines} lines and #{unlisted} characters not listed, #{failures} failures"
