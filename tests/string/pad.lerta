# pad_start and pad_end fill a String to a width of code points, with spaces or one given character.
print ['7'.pad_start(3), '7'.pad_start(3, '0'), 'ab'.pad_end(4) + '|', 'ab'.pad_end(4, '.')]
# A String at the width or longer is left as it is.
print ['abc'.pad_start(3), 'abcd'.pad_start(2), 'abc'.pad_end(0), ''.pad_start(-1)]
# Code points, not bytes, are counted, of the String and of the fill.
print ['é'.pad_start(3, '·'), 'café'.pad_end(6, 'é'), ''.pad_end(2, 'é')]
