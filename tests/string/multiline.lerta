# fmt: off
show := (s: String) -> print "[#{s.split("\n").join('|')}]"

# The closing `"""` on a line of its own keeps the line feed before it.
show """
  one
  two
  """
show """
  one
  two"""

# The least indentation of the lines that are not blank is left out, wherever the closing is.
show """
    deeper
  shallow
      deepest
"""

# A blank line is empty, whatever spaces it has.
show """
  a

  b

  """

# Escapes, quotes and interpolations, which a line may hold anywhere.
name := 'app'
show """
  "#{name}" and ""
  \"""\t\u{41}\#{x}
  #{1 + 1}#{'"""'}
  """

# Lines with nothing but the closing quotes, and tabs, which are no indentation.
show """
"""
show """
  	tab
  """

# A line that starts with `#` is text, and so is any character before the closing `"""`.
show """
  # no comment
  é"""

# A `"` that ends the text is escaped, as the first `"""` closes.
show """
  say "hi\""""

# A second literal may open on the line where the first closes, and a comment may follow one.
pair := (a: String, b: String) -> show "#{a}+#{b}"
pair """
  a""", """
  b
  """  # after

# What follows the closing `"""` continues the line.
print ("""
  x
  """ + 'y').binary.length
