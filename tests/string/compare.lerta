# compare orders Strings by their bytes: a prefix first, and a non-ASCII character after ASCII ones.
const sign = (n: Int) -> n < 0 then -1 else n > 0 then 1 else 0
print sign('abc'.compare('abd'))
print sign('ab'.compare('abc'))
print sign('abc'.compare('ab'))
print sign('abc'.compare('abc'))
print sign(''.compare(''))
print sign('é'.compare('z'))
print ['b', 'é', 'a', 'ab'].sorted((a, b) -> a.compare(b)).join(' ')
