# `+` and `+=` append a Char to a String, as its UTF-8, and a Byte to a Binary.
var s = 'a'
kept := s
c: Char = 'é'
s += c
s += 'b'
print "#{s} #{kept} #{s + c}"
var wide = ''
wide += ch for ch in 'x€😀'
print wide

byte: Byte = 0x41
var b = 'x'.binary
held := b
b += byte
print "#{(b + byte).text()!} #{held.text()!}"
var bytes = ''.binary
for i in 0...300
  bytes += i.to_byte()! if i < 256
print bytes.length
print bytes[255]

prefixed := (ch: Char) -> 'p' + ch
print prefixed('é')
around := (ch: Char) -> "#{'' + ch} #{"#{ch}y" + ch} #{'p' + ch + ch}"
print around('q')
var calls = 0
next_char := (): Char ->
  calls += 1
  'z'
var once = 'y'
once += next_char()
print "#{once} #{calls}"

class Box
  text: String
box := Box('f')
box.text += c
texts := ['a']
texts[0] += c
binaries := ['b'.binary]
binaries[0] += byte
print "#{box.text} #{texts[0]} #{binaries[0].text()!}"

var doubled = 'ab'
doubled += doubled
var doubled_bytes = 'cd'.binary
doubled_bytes += doubled_bytes
print "#{doubled} #{doubled_bytes.text()!}"

# The code points where the UTF-8 grows by a byte, and the last.
var edges = ''
edges += code.to_char()! for code in [0x7F, 0x80, 0x7FF, 0x800, 0xFFFF, 0x10000, 0x10FFFF]
print edges.binary.to_array()
counts := { 'k': 'm' }
counts['k', default: ''] += c
counts['n', default: 'o'] += c
print "#{counts['k']!} #{counts['n']!}"
