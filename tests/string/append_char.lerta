# `+` and `+=` append a Char to a String, as its UTF-8, and a Byte to a Binary.
var s = 'a'
const kept = s
const c: Char = 'é'
s += c
s += 'b'
print "#{s} #{kept} #{s + c}"
var wide = ''
wide += ch for ch in 'x€😀'
print wide

const byte: Byte = 0x41
var b = 'x'.binary
const held = b
b += byte
print "#{(b + byte).text()!} #{held.text()!}"
var bytes = ''.binary
bytes += i.to_byte()! for i in 0...300 when i < 256
print bytes.length
print bytes[255]

const prefixed = (ch: Char) -> 'p' + ch
print prefixed('é')
const around = (ch: Char) -> "#{'' + ch} #{"#{ch}y" + ch} #{'p' + ch + ch}"
print around('q')
var calls = 0
const next_char = (): Char ->
  calls += 1
  'z'
var once = 'y'
once += next_char()
print "#{once} #{calls}"

class Box
  text: String
const box = Box(text: 'f')
box.text += c
const texts = ['a']
texts[0] += c
const binaries = ['b'.binary]
binaries[0] += byte
print "#{box.text} #{texts[0]} #{binaries[0].text()!}"

var doubled = 'ab'
doubled += doubled
var doubled_bytes = 'cd'.binary
doubled_bytes += doubled_bytes
print "#{doubled} #{doubled_bytes.text()!}"
