# `join` puts the Strings or the Chars of an array or an Iter one after another, as a String, with
# the separator, which may be left out, between each two; a Binary[] joins into a Binary.
text := 'a b c'
print text.filter((c) -> c != ' ').join()
print [c for c in text when c != ' '].join('-')
print ['x', 'y'].join()
print ['x', 'y'].join(', ')
print ['x', 'y'].map((w) -> w + '!').join(' ')
print Set(['p', 'q']).iter().join('|')
empty: String[]
print "[#{empty.join(', ')}] [#{[c for c in ''].join(',')}]"
print [b'a', b'b'].join(b',').text()!
print [b'a', b'b'].join().text()!
print 'héllo'.iter().join('.')
print ['é', '😀'].iter().join('·')
print ['one'].join(', ')
no_strings := ['a'].iter().filter((w) -> w == 'b')
print "[#{''.iter().join(',')}] [#{no_strings.join(',')}]"
print [b'a', b'b'].join().length
none: Binary[]
print none.join().length
print 'ab'.filter((c) -> c != ' ').join(', ')
