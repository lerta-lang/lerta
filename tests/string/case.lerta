# to_upper and to_lower map each letter by Unicode's full case mappings, and leave every other
# character as it is.
print ['Hello, World 123!'.to_upper(), 'Hello, World 123!'.to_lower()]
print ['azAZ@[`{'.to_upper(), 'azAZ@[`{'.to_lower()]
print ['café ÉTÉ ß'.to_upper(), 'café ÉTÉ ß'.to_lower()]
print [''.to_upper(), ''.to_lower()]
print ['a€b😀C'.to_upper(), 'a€b😀C'.to_lower()]
print ['€a€'.to_upper(), 'éAé'.to_lower()]

# A full mapping may give more than one character, or change the length in bytes: ß, ŉ and ﬃ give
# two or three, and İ lowered is i and a combining dot. ǅ, a title-case letter, has both cases.
print ['straße ŉ ﬃ'.to_upper(), 'İstanbul'.to_lower(), 'ǅ'.to_upper(), 'ǅ'.to_lower()]

# A capital sigma that ends a word, after a cased letter and before none, past case-ignorable
# characters as `'`, is lowered to ς, and any other to σ: alone, at the start, inside a word.
print ["ΟΔΟΣ ΟΔΟΣ. ΟΔΟΣ'. ΟΔΟΣ'Α".to_lower(), 'Σ ΣΑ ΑΣΑ'.to_lower(), "1Σ \u{301}Σ".to_lower()]

# A case-ignorable character beyond ASCII, a combining accent, before or after a sigma, which the
# search for a cased letter steps over by its bytes.
print ["Α\u{301}Σ".to_lower(), "ΑΣ\u{301}Α".to_lower()]

# A sigma before another is followed by a cased letter, and the last ends the word. U+0345, both
# cased and case-ignorable, is stepped over as case-ignorable.
print ['ΑΣΣ'.to_lower(), "Α\u{345}Σ".to_lower(), "ΑΣ\u{345}".to_lower()]

# A letter of no case before a sigma, as ア, is not cased.
print 'アΣ'.to_lower()

# A full mapping that overrides the simple one: ᾈ, whose simple upper case is itself, is uppered
# to Ἀ and Ι.
print "\u{1F88}".to_upper()
print "\u{1F88}".to_upper().count()

# A full mapping to three characters: ΐ uppered is Ι and two combining marks.
print [c.to_int().to_hex(4) for c in 'ΐ'.to_upper()]

# Characters beyond ASCII whose mappings are ASCII: the Kelvin sign is K lowered to k, and the long
# s is s uppered to S.
print ["\u{212A}".to_lower(), 'ſ'.to_upper()]
