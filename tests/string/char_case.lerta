# The case of a letter, by Unicode's simple mappings of one character to one, and the value of a
# hexadecimal digit, of a Char.
print [c.to_upper() for c in "aZ1\u{e9}"]
print [c.to_lower() for c in "Az1\u{c9}"]
print [c.is_upper() for c in "aZ1\u{c9}"]
print [c.is_lower() for c in "aZ1\u{e9}"]

# A letter whose full mapping is more than one character keeps its simple one, as ß has none; ǅ is
# of title case, which is neither.
print [c.to_upper() for c in 'ßǅﬃ'] + [c.to_lower() for c in 'ǅİ']
print [c.is_upper() or c.is_lower() for c in 'ǅ']
print [c.to_lower() for c in "\u{212A}"] + [c.to_upper() for c in 'ſ']

# None of a Char that is a Byte but not ASCII, nor of one beyond the Bytes.
print [c.hex_value() else -1 for c in "09afAFgG\u{e9}\u{ff}\u{ff10}"]
