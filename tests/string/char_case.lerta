# The case of an ASCII letter, and the value of a hexadecimal digit, of a Char.
print [c.to_upper() for c in "aZ1\u{e9}"]
print [c.to_lower() for c in "Az1\u{c9}"]
print [c.is_upper() for c in "aZ1\u{c9}"]
print [c.is_lower() for c in "aZ1\u{e9}"]

# None of a Char that is a Byte but not ASCII, nor of one beyond the Bytes.
print [c.hex_value() ? -1 for c in "09afAFgG\u{e9}\u{ff}\u{ff10}"]
