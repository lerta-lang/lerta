# A for over a String goes through its Chars, ASCII ones and those of longer sequences.
text := "a\u{e9}b\u{4e2d}c\u{1F600}d"
print c.to_int() for c in text
# With the place of each Char, counted in Chars rather than bytes.
print "#{i}:#{c}" for c at i in text
# break and continue go on from the right Char.
for c in text
  continue if c == 'b'
  break if c == 'd'
  print c
# A return from the body leaves the loop and the function.
first_wide := (s: String) ->
  for c in s
    return c if c.to_int() > 0xFFFF
  nil
print first_wide(text)!
print first_wide('plain') == nil
# A comprehension, and an empty String.
print [c.to_int() for c in "\x7F\u{80}\u{7ff}\u{800}\u{ffff}\u{10000}\u{10ffff}"]
print [c for c in ''].length
# A throw from the body leaves the loop.
try
  for c in text
    throw ValueError(message: "at #{c}") if c == 'c'
catch error: ValueError
  print error.message
# An explicit iter(), and a String that a call gives, evaluated once.
print [c.to_int() for c in text.iter()]
var made = 0
make := (n: Int) ->
  made += 1
  "\u{e9}".repeat(n)
print [c.to_int() for c in make(2)]
print made
# Nested loops, whose continue and break are their own.
for outer in "x\u{e9}y"
  for inner in "1\u{4e2d}2"
    continue if inner == '1'
    break if inner == '2'
    print "#{outer}#{inner}"
# A return and a throw out of a loop over a String made at run time.
first_of := (n: Int) ->
  return c for c in "#{n}\u{e9}"
  nil
print first_of(42)!
try
  for c in "#{made}\u{1F600}"
    throw ValueError(message: 'out') if c.to_int() > 0xFFFF
catch error: ValueError
  print error.message
# A lazy comprehension, a guard, an index of iter(), and a var assigned in the body, whose String
# the loop holds.
print (c.to_int() for c in "a\u{e9}b").to_array()
print [c for c in "a\u{e9}b" when c != 'a']
print "#{i}#{c}" for c at i in "x\u{e9}".iter()
var changing = "a\u{e9}b"
for c in changing
  changing = ''
  print c
