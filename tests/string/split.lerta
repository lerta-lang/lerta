const show = (s: String, separator: String) ->
  const pieces = s.split(separator)
  print "#{pieces.length}: [#{pieces.join('|')}]"

show 'a,b,c', ','
show 'a,,b', ','
show '', ','
show ',', ','
show 'abc', ','
show 'a--b---c', '--'
show 'naïve café', 'é'
show 'ab', 'abc'
show 'ééa', 'é'
show 'a,', ','
show 'a ab', 'ab'
show 'xa', 'ab'
show '--a', '--'
print part for part in 'x y'.split(' ')
