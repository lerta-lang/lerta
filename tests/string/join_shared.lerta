# join and repeat build a new String, also from parts that are the separator itself, and leave the
# parts as they were.
const s = 'q'
print [s, s].join(s)
print s
const none: String[] = []
print "[#{none.join(s)}] [#{[s].join(',')}]"
print s.repeat(3)
print s
const b = 'r'.binary
print [b, b].join(b).text()!
print b.text()!
