# fmt: off
show := (s: String) -> print "[#{s.split("\n").join('|')}]"

# The closing `'''` on a line of its own keeps the line feed before it.
show '''
  one
  two
  '''
show '''
  one
  two'''

# The common indentation is left out, and a blank line is empty, as in a `"""` literal.
show '''
    deeper
  shallow
    
'''

# No escapes and no interpolation: `\`, `#{`, `"` and `'` are text, and `"""` is too.
show '''
  \n \ #{x} "" ' '' """
  '''

# A tab is text, not indentation.
show '''
  	tab
  '''

# The first `'''` closes, even after a `\`.
show '''
  a\'''

# A second literal may open on the line where the first closes, and a comment may follow one.
pair := (a: String, b: String) -> show "#{a}+#{b}"
pair '''
  a''', '''
  b
  '''  # after
