# Literals joined by `+` make one String, joined by the compiler (see test/cli/build.lerta).
joined := ->
  'a text too long for a line of its own, which is split over lines, ' +
    "with an escape\t" +
    'and joined by the compiler'

print joined()
print 'x' + 'y' == 'xy'
print 'x' + ('y' + 'z')
name := 'z'
print 'x' + name + 'y'
