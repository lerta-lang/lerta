# `+=` appends to the String it holds alone, and leaves alone a String that something else holds.
var s = 'a'
kept := s
s += 'b'
copy := s
s += 'c'
print "#{s} #{kept} #{copy}"
s += s
print s

var digits = ''
digits += i.to_string() for i in 0..1000
print digits.binary.length
print digits.binary[985..1000].text()!

class Log
  args
    var text: String

  # Assigns the field that `+=` appends to while its value is evaluated, which `+=` then reads.
  replace := (text: String) ->
    @text = text
    '!'

log := Log('')
log.text += 'one'
log.text += log.replace('two')
print log.text

lines := ['x']
lines[0] += 'y'
line := lines[0]
lines[0] += 'z'
print "#{lines[0]} #{line}"

var counted = ''
add := (part: String) -> counted += part
add 'p'
add 'q'
print counted

var bytes = b'x'
held := bytes
bytes += b'yz'
print "#{bytes.text()!} #{held.text()!}"

var grown = b''
grown += b'abcdefgh' for i in 0..100
grown += b''
print grown.length

var shared = 'ab'
length_after_append := (text: String) ->
  shared += 'y'.repeat(100)
  text.binary.length
print length_after_append(shared)

var walked = 'cd'
for c in walked
  walked += 'z'.repeat(100)
  print c
print walked.binary.length

var text = 'ab'
var text_bytes = text.binary
text_bytes += b'c'
print "#{text} #{text_bytes.text()!}"

var keyed = 'k'
by_name: Map<String, String>
by_name['k'] = keyed
keyed += 'v'
print "#{by_name['k']!} #{keyed}"

var alone = 'x'.repeat(3)
alone += ''
print alone
