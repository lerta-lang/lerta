# Strings order by their bytes, as their compare does: by the first byte that differs, else by
# length, so a prefix goes first. Each operand is evaluated once, the left one first.
print 'a' < 'b'
s := 'ab'
print [s < 'abc', 'abc' <= s, s > 'a', s >= 'ab', 'é' > 'z', '' < s]
var calls = ''
named := (name: String) ->
  calls += name
  name
print named('x') < named('y')
print calls

# Operands that hold function literals, which the comparison's operands are typed through twice.
print ['a', 'c'].map((x) -> x + 'x').to_array()[1] < ['a', 'c'].map((y) -> y).to_array()[0]
