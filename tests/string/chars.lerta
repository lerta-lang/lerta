# The Chars of a String, ASCII ones and those of sequences of each length, in any order.
print [c.to_int() for c in "a\u{e9}b\u{4e2d}c\u{1F600}d"]
print [c.to_int() for c in "\u{1F600}\u{e9}z"]
print [c.to_int() for c in '']
# The least and the greatest code point of each length of sequence.
print [c.to_int() for c in "\x7F\u{80}\u{7ff}\u{800}\u{ffff}\u{10000}\u{10ffff}"]
