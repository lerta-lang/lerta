# min and max of numbers, Strings and a struct with its own compare, of one value or many and of a
# spread; of equal values, the first.
struct Version
  major: Int
  label: String
  compare = (other: Version) -> @major.compare(other.major)

print min(3, 1, 2)
print max(3, 1, 2)
print min(2.5)
print max('b', 'a', 'c')
const xs = [4, 9, 7]
print max(0, xs...)
print min(xs[0], xs...)
print(
  max(
    Version(major: 1, label: 'a')
    Version(major: 2, label: 'b')
    Version(major: 2, label: 'c')
  ).label
)
print min(Version(major: 1, label: 'first'), Version(major: 1, label: 'second')).label
print max(Version(major: 3, label: 'one'), Version(major: 3, label: 'two')).label
const none: Int[] = []
print min(5, none...)
print max(0, xs..., 10)
print max(-1.5, 2.25, 0.5)
print max(Version(major: 5, label: 'big'), Version(major: 1, label: 'small')).label
