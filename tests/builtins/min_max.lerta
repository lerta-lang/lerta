# min and max of numbers, Strings and a struct with its own compare; of equal values, the first.
struct Version
  major: Int
  label: String
  compare = (other: Version) -> @major.compare(other.major)

print [min(3, 1), min(1, 3), max(3, 1), max(1, 3)]
print [max(-1.5, 2.25), min(1.0, 2)]
print max('b', 'c')
print min(Version(major: 1, label: 'first'), Version(major: 1, label: 'second')).label
print max(Version(major: 3, label: 'one'), Version(major: 3, label: 'two')).label
print max(Version(major: 5, label: 'big'), Version(major: 1, label: 'small')).label
print min(Version(major: 5, label: 'big'), Version(major: 1, label: 'small')).label
