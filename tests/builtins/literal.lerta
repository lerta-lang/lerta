# to_literal gives the literal that gives the value: a String in quotes, single unless it holds a
# single quote or a control character, an enum's member as declared, and the others as to_string.
enum Bracket
  '('
  CLOSE
print 'plain é'.to_literal()
print "it's\ttabbed #{1}\u{7F}\u{1}\\\"#".to_literal()
print ''.to_literal()
const c: Char = 'x'
print c.to_literal()
print "'".to_literal()
const open: Bracket = '('
print open.to_literal()
print Bracket.CLOSE.to_literal()
print true.to_literal()
print -12.to_literal()
print 1.5.to_literal()
const big = 9223372036854775807.to_uint64()!.wrapping_mul(2)
print big.to_literal()
const byte: Byte = 7
print byte.to_literal()

# A class gives its own.
class Point
  x: Int
  to_literal = -> "Point(x: #{@x})"
const show = (value: Literal) -> value.to_literal()
print show(Point(x: 3))
print show('a')

enum Quote
  "'"
  "\r\0\u{1F}"
const quote: Quote = "'"
print quote.to_literal()
const escapes: Quote = "\r\0\u{1F}"
print escapes.to_literal()
enum Named
  FIRST
  SECOND
print Named.SECOND.to_literal()
const tab: Char = "\t"
const apostrophe: Char = "'"
print "#{tab.to_literal()} #{apostrophe.to_literal()}"
const small: Int8 = -8
const middle: Int16 = 16
const wide: Int32 = -32
const unsigned: UInt16 = 16
const unsigned_wide: UInt32 = 32
const single: Float32 = 0.5
print "#{small.to_literal()} #{middle.to_literal()} #{wide.to_literal()}"
print "#{unsigned.to_literal()} #{unsigned_wide.to_literal()} #{single.to_literal()}"
print -2.25.to_literal()
