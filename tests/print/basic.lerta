# print writes its argument and a newline
print 'hello, world'
# fmt: off
print('parenthesized')
print ('grouped')
print(('grouped twice'))
(print)('grouped callee')

print ''

# a comment at any indentation is ignored
# fmt: on
print 'UTF-8: é 😀'
print '# not a comment'  # but this is
print '"quotes\n are not escapes"'
