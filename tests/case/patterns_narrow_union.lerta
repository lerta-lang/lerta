# In an arm of several type patterns, the subject is narrowed to the union of their types, whose
# common fields it reads, and the else arm to the types that no arm names.
struct Point
  name: String
  x: Int

struct Circle
  name: String
  r: Int

class Label
  args
    name: String

type Shape = Point | Circle | Label | Int | Bool

type Round = Circle | Label

describe := (shape: Shape) ->
  case shape
    when Point, Circle then "a figure #{shape.name}"
    when Label, Int
      shape is Label then "a label #{shape.name}" else "a number #{shape + 1}"
    else "a flag #{not shape}"

# An alias among the patterns counts for each of its types.
named := (shape: Shape) ->
  case shape  # fmt: skip
    when Point, Round then shape.name
    else '-'

print describe(Point(name: 'p', x: 1))
print describe(Circle(name: 'c', r: 2))
print describe(Label('l'))
print describe(4)
print describe(true)
print [named(Circle(name: 'c', r: 1)), named(Label('l')), named(0)]
