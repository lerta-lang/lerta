struct Box(label: String)
struct Pair(left: Int, right: Int)
type Item = Box | Pair

describe := (item: Item) ->
  case item
    when Box
      prefix := 'box '
      prefix + item.label
    when Pair
      total := item.left + item.right
      "pair of #{total}"

first_even := (xs: Int[]) ->
  for x in xs
    case
      when x % 2 == 0  # fmt: skip
        return x
      else
        continue
  -1

log: String[]
record := (item: Item) ->
  case item
    when Box  # fmt: skip
      log.push(item.label)
    when Pair then log.push('pair')

sign := (n: Int) ->
  case
    when n < 0
      negative := -1
      negative
    when n == 0 then 0
    else
      positive := 1
      positive

print describe(Box(label: 'a'))
print describe(Pair(left: 1, right: 2))
print first_even([1, 3, 4, 5])
print first_even([1])
record Box(label: 'b')
record Pair(left: 0, right: 0)
print log.join(',')
print sign(-5) + sign(0) + sign(9)
# On the same line as `=`, which the grammar allows though the style puts it on the next.
# fmt: skip
label: String? = case 1
  when 1
    s := 'one'
    s
  else nil
print label ? '-'
