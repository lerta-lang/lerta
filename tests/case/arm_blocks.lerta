struct Box
  label: String
struct Pair
  left: Int
  right: Int
type Item = Box | Pair

const describe = (item: Item): String ->
  case item
    when Box
      const prefix = 'box '
      prefix + item.label
    when Pair
      const total = item.left + item.right
      "pair of #{total}"

const first_even = (xs: Array<Int>): Int ->
  for x in xs
    case
      when x % 2 == 0
        return x
      else
        continue
  -1

const log: Array<String> = []
const record = (item: Item) ->
  case item
    when Box
      log.push(item.label)
    when Pair then log.push('pair')

const sign = (n: Int): Int ->
  case
    when n < 0
      const negative = -1
      negative
    when n == 0 then 0
    else
      const positive = 1
      positive

print describe(Box(label: 'a'))
print describe(Pair(left: 1, right: 2))
print first_even([1, 3, 4, 5])
print first_even([1])
record(Box(label: 'b'))
record(Pair(left: 0, right: 0))
print log.join(',')
print sign(-5) + sign(0) + sign(9)
const label: String? = case 1
  when 1
    const s = 'one'
    s
  else nil
print label ? '-'
