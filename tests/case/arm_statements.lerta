var digits = 0
var others = 0
const seen: Array<String> = []
for c in ['1', 'a', '2', '(']
  case c
    when '1', '2' then digits += 1
    when '(' then seen.push c
    else others = others + 1
print digits
print others
print c for c in seen

const add_one = (n: Int) -> n + 1
const run = (f: () -> void) -> f()
for n in [1, 2]
  print case n
    when 1 then add_one 10
    else add_one n
  case n
    when 1 then run () ->
      print 'block argument'
    else print 'no block'
