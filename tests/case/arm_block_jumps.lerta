class Counter
  args
    n: Int

pick := (k: Int): Int ->
  case
    when k > 0
      if k > 5
        return 1
      else
        return 2
    else 3

first_long := (words: String[]) ->
  var found: String?
  for word in words
    case word.binary.length > 3
      when true
        found = word
        break
      else  # fmt: skip
        continue
  found

nested := (a: Int, b: Int) ->
  case
    when a > 0
      case
        when b > 0 then 'both'
        else 'a only'
    else 'neither'

count_of := (n: Int) ->
  case
    when n >= 0
      counter := Counter(n)
      counter.n
    else throw ValueError('negative')

labels := { 1: 'one' }
label_of := (k: Int) ->
  case
    when k > 0
      label := labels[k]
      return 'unknown' if label == nil
      label
    else 'zero'

var total = 0
for i in 0..10
  case
    when i % 3 == 0  # fmt: skip
      continue
    when i > 7
      break
    else
      total += i
print pick(9) + pick(1) + pick(0)
print first_long(['a', 'abcd', 'words']) ? '-'
print nested(1, 1)
print nested(1, 0)
print nested(0, 0)
print count_of(4)
print label_of(1)
print label_of(2)
print label_of(0)
print total
