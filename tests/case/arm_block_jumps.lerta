class Counter
  n: Int

const pick = (k: Int): Int ->
  case
    when k > 0
      if k > 5
        return 1
      else
        return 2
    else 3

const first_long = (words: String[]): String? ->
  var found: String? = nil
  for word in words
    case word.binary.length > 3
      when true
        found = word
        break
      else
        continue
  found

const nested = (a: Int, b: Int): String ->
  case
    when a > 0
      case
        when b > 0 then 'both'
        else 'a only'
    else 'neither'

const count_of = (n: Int): Int ->
  case
    when n >= 0
      const counter = Counter(n: n)
      counter.n
    else throw ValueError(message: 'negative')

const labels: Map<Int, String> = { 1: 'one' }
const label_of = (k: Int): String ->
  case
    when k > 0
      const label = labels[k]
      return 'unknown' if label == nil
      label
    else 'zero'

var total = 0
for i in 0...10
  case
    when i % 3 == 0
      continue
    when i > 7
      break
    else
      total += i
print pick(9) + pick(1) + pick(0)
print first_long(['a', 'abcd', 'words']) ? '-'
print nested(1, 1)
print nested(1, 0)
print nested(0, 0)
print count_of(4)
print label_of(1)
print label_of(2)
print label_of(0)
print total
