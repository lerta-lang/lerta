# A case that is a statement narrows in its arms as any case does, may leave out else where its arms
# take every type, and gives never when every arm jumps.
type Shape = Int | String

describe := (shape: Shape) ->
  case shape
    when Int then print(shape + 1)
    when String then print(shape.to_upper())

describe 1
describe 'ab'
for x in [1, 2, 3]
  print x
  case
    when x == 2 then continue
    else break
  print 'not reached'
print 'done'

# A function written void discards the value that it ends with.
seen := Set([1])
forget := (x: Int): void -> seen.remove(x)
forget 1
print seen.length

# One whose arms all return may end a function that gives a value.
sign := (x: Int?): Int ->
  case x  # fmt: skip
    when nil then return 0
    else return 1
print sign(nil) + sign(5)
