kind := (c: Byte) ->
  case c
    when b'+', b'-' then 'additive'
    when b'*', b'/' then 'multiplicative'
    else 'other'
ops := b'+*x'
print kind(op) for op in ops
word := (n: Int) ->
  case n
    when 1 then 'one'
    when 2, 3 then 'few'
    else 'many'
print word(1)
print word(3)
print word(9)
greet := (s: String) ->
  case s  # fmt: skip
    when 'hi' then 'hello'
    else s.to_string()
print greet('hi')
print greet('yo')
