type Shape = Circle | Square

struct Circle
  r: Int

struct Square
  side: Int

describe := (shape: Shape) ->
  case shape
    when Circle then print("circle #{shape.r}")
    else pass

describe Circle(1)
describe Square(2)
for c in ['a', ' ', 'b']
  case c
    when ' ' then pass
    else print(c)
var n = 0
case
  when n > 0 then print('positive')
  else pass
pass := 3
print pass

print_unless_empty := <T>(items: T[], item: T) ->
  case items.length
    when 0 then pass
    else print(item)

print_unless_empty [1], 2
print_unless_empty ['a'], 'b'
