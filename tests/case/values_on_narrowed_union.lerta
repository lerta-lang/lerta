f := (x: Int | String) ->
  if x is Int
    case x  # fmt: skip
      when 1 then print('one')
      else print('other')

g := (x: Int | String) ->
  case x  # fmt: skip
    when Int
      case x  # fmt: skip
        when 2 then print('two')
        else print('int')
    else print('string')

h := (x: Int | String) ->
  unless x is String
    case x  # fmt: skip
      when 3 then print('three')
      else print('int')

k := (x: Int | String) ->
  case x  # fmt: skip
    when String then print('string')
    else
      case x  # fmt: skip
        when 5 then print('five')
        else print('int')

f 1
f 2
f 'a'
g 2
g 3
g 'a'
h 3
h 4
k 5
k 'a'
