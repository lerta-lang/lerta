enum Kind
  A
  B
  'c'

struct P
  x: Int
struct Q
  y: String
type U = P | Q

of_int := (n: Int?) ->
  case n
    when nil then 'nil'
    when 1, 2 then "small #{n + 1}"
    else 'other'
of_string := (s: String?) ->
  case s
    when 'a' then s + '!'
    when nil then 'nil'
    else "other #{s}"
of_kind := (k: Kind?) ->
  case k
    when A then "a #{k.to_string()}"
    when B, 'c' then 'b or c'
    when nil then 'nil'
of_kind_else := (k: Kind?) ->
  case k
    when 'c' then 'c'
    else 'else'
of_union := (u: U?) ->
  case u
    when P then "p #{u.x}"
    when Q then "q #{u.y}"
    when nil then 'nil'

print "#{of_int(nil)} #{of_int(1)} #{of_int(2)} #{of_int(3)}"
print "#{of_string(nil)} #{of_string('a')} #{of_string('b')}"
print "#{of_kind(nil)} #{of_kind(A)} #{of_kind(B)} #{of_kind('c')}"
print "#{of_kind_else(nil)} #{of_kind_else('c')} #{of_kind_else(A)}"
print "#{of_union(nil)} #{of_union(P(x: 1))} #{of_union(Q(y: 'q'))}"
