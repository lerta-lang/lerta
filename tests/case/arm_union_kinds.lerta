class Point
  x: Int
  to_string = -> "Point(#{@x})"

const pick = (i: Int): Int | String -> i == 0 then 1 else 'one'
const maybe = (i: Int): Int? -> i == 0 then 2 else nil
const twice: Int | Int = 3
print twice + 1
for i in 0...3
  const merged =
    case i
      when 2 then true
      else pick(i)
  print merged
  const optional =
    case i
      when 1 then 'b'
      else maybe(i)
  print optional?.to_string() ? 'none'
  const object = i == 0 then Point(x: i) else i
  print object
type Either = Int | String
const either = (i: Int): Either? -> i == 0 then 1 else nil
for i in 0...2
  const value = i == 0 then either(i) else true
  print value?.to_string() ? 'none'
type Number = Int | Float
const measure = (i: Int): Number -> i == 0 then 1 else 2.5
for i in 0...2
  const value = i == 0 then measure(i) else 'none'
  print value
const maybe_measure = (i: Int): Number? -> i == 0 then 3 else nil
for i in 0...3
  const value =
    case i
      when 0, 1 then maybe_measure(i)
      else 2.5
  print value?.to_string() ? 'none'
for i in 0...2
  const value = i == 0 then measure(1) else 4
  print value
for i in 0...3
  const value =
    case i
      when 0 then 2
      when 1 then 3.5
      else measure(i)
  print value
const once: Int | Int? = 5
print (once ? 0) + 1
