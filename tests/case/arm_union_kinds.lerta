class Point
  x: Int
  to_string = -> "Point(#{@x})"

pick := (i: Int): Int | String -> i == 0 then 1 else 'one'
maybe := (i: Int): Int? -> i == 0 then 2 else nil  # fmt: skip
twice: Int | Int = 3  # fmt: skip
print twice + 1
for i in 0...3
  merged :=
    case i
      when 2 then true
      else pick(i)
  print merged
  optional :=
    case i
      when 1 then 'b'
      else maybe(i)
  print optional?.to_string() ? 'none'
  object := i == 0 then Point(i) else i
  print object
type Either = Int | String
either := (i: Int): Either? -> i == 0 then 1 else nil
for i in 0...2
  value := i == 0 then either(i) else true
  print value?.to_string() ? 'none'
type Number = Int | Float
measure := (i: Int): Number -> i == 0 then 1 else 2.5
for i in 0...2
  value := i == 0 then measure(i) else 'none'
  print value
maybe_measure := (i: Int): Number? -> i == 0 then 3 else nil
for i in 0...3
  value :=
    case i
      when 0, 1 then maybe_measure(i)
      else 2.5
  print value?.to_string() ? 'none'
for i in 0...2
  value := i == 0 then measure(1) else 4
  print value
for i in 0...3
  value :=
    case i
      when 0 then 2
      when 1 then 3.5
      else measure(i)
  print value
once: Int | Int? = 5
print (once ? 0) + 1
