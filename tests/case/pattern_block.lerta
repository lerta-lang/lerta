const kind = (word: String) ->
  # fmt: skip
  case word
    when
      'a', 'b',
      'c'
      # A comment between the patterns.
      'd'
    then 'letter'
    when
      'one'
    then
      const n = 1
      "number #{n}"
    when 'x' then 'x'
    else 'other'
print kind('c')
print kind('d')
print kind('one')
print kind('x')
print kind('z')
