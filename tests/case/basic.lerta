print case
  when 1 > 2 then 'first'
  when 2 > 1 then 'second'
  else 'otherwise'
print case
  when false then 1
  else 2
print case
  when false  # fmt: skip
    'block arm'
  when true
    'block arm taken'
  else
    'block else'
print case
  when false then false
  else true
print 'after'
case
  when 1 == 1 then print('void arms')
  else print('not taken')
print case
  when true then case  # fmt: skip
    when false then 'inner false'
    else 'nested'
  else 'outer else'
# Arms with overflow checks branch internally before merging.
print case
  when 1 / 1 == 1 then 10 + 1
  else 0
