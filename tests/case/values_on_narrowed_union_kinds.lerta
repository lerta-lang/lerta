enum Color
  red
  green

f := (x: Color | String | Float) ->
  return if x is Float
  if x is Color
    case x
      when red then print('red')
      when green then print('green')
  else
    case x  # fmt: skip
      when 'a' then print('a')
      else print('other')

g := (x: Int | String | Float) ->
  unless x is Float
    case x
      when Int then print('int')
      when String then print('string')

f red
f green
f 'a'
f 'b'
g 1
g 'a'
