# A run given stdout and stderr as its Writers ends them, which leaves them open, so that the
# program writes on to them after it. Only stdout is shown, as stderr is
# compared only for a failure.
import stderr, stdout from 'std:io'
import run from 'std:process'

await run('echo_input', stdin: "to stdout\n".binary, stdout: stdout, stderr: stderr)
await stdout.write("after, to stdout\n")
await stderr.write('')
# One taking both outputs is ended twice.
await run('echo_input', stdin: "both\n".binary, stdout: stdout, stderr: stdout)
await stdout.write("after both\n")
# A program that fails ends them so too; a print and a write after it keep their order.
await run('exit_with', '3', stdout: stdout, stderr: stderr)
print 'printed after a failure'
await stdout.write("written after a failure\n")
