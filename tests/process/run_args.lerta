# Each argument reaches the command as it is, whatever the system makes of spaces, quotes and
# backslashes on its command line.
import run from 'std:process'
args :=
  'plain'
  ''
  'two words'
  "tab\there"
  'say "hi"'
  'back\slash'
  'trailing\'
  'before quote\"'
  'héllo'
print (await run('print_args', args...)).code
