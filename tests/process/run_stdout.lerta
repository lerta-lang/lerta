# The command's standard output is appended to the array, after what it holds already, and its
# exit code is returned as without one.
import run from 'std:process'
const output: Byte[] = ['>']
print (await run('print_args', 'a', 'b c', stdout: output)).code
print (await run('exit_with', '3', stdout: output)).code
print output.to_binary().text()!

# A command that writes nothing appends nothing.
const empty: Byte[] = []
await run('exit_with', '0', stdout: empty)
print empty.length

# More output than a pipe holds at once.
const long_output: Byte[] = []
await run('repeat', '20000', 'abcdefghi', stdout: long_output)
print long_output.length

# A command that cannot start rejects the Promise, and leaves the array as it was.
const missing = run('lerta-no-such-command', stdout: output)
try
  await missing
catch error
  print error.message
print output.length
