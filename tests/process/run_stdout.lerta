# The command's standard output, captured, is in its Exit, as is its exit code.
import run from 'std:process'
printed := await run('print_args', 'a', 'b c', stdout: CAPTURE)
print printed.code
print printed.stdout!.text()!
print (await run('exit_with', '3', stdout: CAPTURE)).code

# A command that writes nothing captures nothing.
print (await run('exit_with', '0', stdout: CAPTURE)).stdout!.length

# More output than a pipe holds at once.
print (await run('repeat', '20000', 'abcdefghi', stdout: CAPTURE)).stdout!.length

# A command that cannot start rejects the Promise.
try
  await run('lerta-no-such-command', stdout: CAPTURE)
catch error
  print error.message
