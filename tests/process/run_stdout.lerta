# The command's standard output, kept in a Buffer, and its exit code.
import Buffer from 'std:io'
import run from 'std:process'
printed := Buffer()
print (await run('print_args', 'a', 'b c', stdout: printed)).code
print printed.text()!
print (await run('exit_with', '3', stdout: Buffer())).code

# A command that writes nothing captures nothing.
nothing := Buffer()
await run('exit_with', '0', stdout: nothing)
print nothing.binary.length

# More output than a pipe holds at once.
many := Buffer()
await run('repeat', '20000', 'abcdefghi', stdout: many)
print many.binary.length

# A command that cannot start rejects the Promise.
try
  await run('lerta-no-such-command', stdout: Buffer())
catch error
  print error.message
