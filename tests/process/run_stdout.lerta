# The command's standard output is appended to the array, after what it holds already, and its
# exit code is returned as without one.
import { run } from 'std:process'
const output: Array<Byte> = ['>']
print run('print_args', ['a', 'b c'], output)
print run('exit_with', ['3'], output)
print output.to_binary().text()!

# A command that writes nothing appends nothing.
const empty: Array<Byte> = []
run 'exit_with', ['0'], empty
print empty.length

# More output than a pipe holds at once.
const long_output: Array<Byte> = []
run 'repeat', ['20000', 'abcdefghi'], long_output
print long_output.length

# A command that cannot start leaves the array as it was.
try
  run 'lerta-no-such-command', [], output
catch error
  print error.message
print output.length
