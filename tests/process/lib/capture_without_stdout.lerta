# Writes to stderr whether it captured the output of clang --version, for a check that starts it
# with its own stdout closed, so that the pipe it captures through may be fd 1.
import stderr from 'std:io'
import run from 'std:process'
const output: Array<Byte> = []
run 'clang', ['--version'], output
stderr.write "#{output.length > 0}\n"
