# Waits to be stopped by a signal, for a check that sends it once the file `ready` is there. Its
# cleanup awaits too, for as many seconds as the argument says, and writes the file `cleaning`
# first.
import write_file from 'std:io'
import argv from 'std:process'
import sleep from 'std:time'

try
  await write_file('ready', '')
  await sleep(60.0)
  print 'not interrupted'
finally
  print 'finally'
  await write_file('cleaning', '')
  await sleep(argv[0].parse_float()!)
  print 'cleaned up'
