# Takes the CancelledError of a signal and goes on to its end, for a check that sends the signal
# once the file `ready` is there.
import write_file from 'std:io'
import sleep from 'std:time'

try
  await write_file('ready', '')
  await sleep(60.0)
catch error: CancelledError
  print "caught #{error.message}"
print 'went on'
