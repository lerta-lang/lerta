# Prints to stdout and stderr while listening on TCP, and then makes the file that its argument
# names, for a check that starts it with stdout and stderr closed. Were they taken by the pipe that
# libuv opens for signals, the prints would go into it, and the program would abort when libuv
# cleans up; kept closed, the prints are lost, and the program ends with 1 for the lost print.
import write_file from 'std:io'
import listen_tcp from 'std:net'
import argv from 'std:process'

listener := listen_tcp('127.0.0.1')
print 'lost'
print_error 'lost'
listener.close()
await write_file(argv[0], b'')
