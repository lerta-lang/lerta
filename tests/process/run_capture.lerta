# A Buffer keeps the output, DISCARD drops it, and stderr: STDOUT sends the errors where the output
# goes, in the order the program writes them.
import run from 'std:process'
import Buffer, Pipe, stdout from 'std:io'

shown := (buffer: Buffer) -> buffer.text()!.split("\n").join('|')

output := Buffer()
errors := Buffer()
print (await run('print_both', stdout: output, stderr: errors)).code
print "#{shown(output)} / #{shown(errors)}"
merged := Buffer()
await run('print_both', stdout: merged, stderr: STDOUT)
print shown(merged)
quiet := Buffer()
await run('print_both', stdout: DISCARD, stderr: quiet)
print shown(quiet)
await run('print_both', stdout: DISCARD, stderr: STDOUT)

# Errors sent to this program's own output, as the output is.
await run('print_both', stderr: STDOUT)

# Into a Pipe, which this program reads.
pipe := Pipe()
running := run('print_both', stdout: pipe, stderr: STDOUT)
print (await pipe.reader.read_all()).text()!.split("\n").join('|')
await running

# A program that writes nothing leaves the Buffer empty.
empty := Buffer()
await run('exit_with', '0', stdout: empty)
print empty.binary.length

# The errors where the output goes, as a Writer that this program copies it to.
await run('print_both', stdout: stdout, stderr: STDOUT)

# Errors dropped, the output kept.
kept := Buffer()
await run('print_both', stdout: kept, stderr: DISCARD)
print shown(kept)

# One Buffer may take both streams.
together := Buffer()
await run('print_both', stdout: together, stderr: together)
print together.binary.length
