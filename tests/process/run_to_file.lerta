# A run that writes a program's output to a file has written all of it, past the file's buffer, and
# closed the file, by the time it returns, so that the file can be read and renamed at once.
import create, read_file, rename from 'std:io'
import run from 'std:process'

output := 'x'.repeat(100001).binary
file := create('out.txt')
await run('echo_input', stdin: output, stdout: file)
rename 'out.txt', 'renamed.txt'
print await read_file('renamed.txt') == output

# One taking both outputs, ended twice, holds them both too.
both := create('both.txt')
await run('echo_input', stdin: output, stdout: both, stderr: both)
print await read_file('both.txt') == output
