# A program reads a Reader and writes to Writers, which get what it writes as it comes, and are
# ended after it, however the run ends; one that ends without reading its input fails no write; and
# the error of a Writer or of a Reader fails the run, once the program has ended.
import Buffer, Reader from 'std:io'
import Deferred from 'std:async'
import run from 'std:process'
import sleep from 'std:time'

# Writes down what it gets, and its end.
class Collected
  args
    name: String
  var written = b''
  var ended = false

  write := (data: String | Binary): Promise -> @written += data is String then data.binary else data

  end := (): Promise -> @ended = true

  report := -> "#{@name}: #{@written.text()!.trim()} (ended: #{@ended})"

var chunks = ['one ', 'two ', 'three']
input := Reader(->
  return nil if chunks.is_empty()
  chunk := chunks[0]
  chunks = chunks[1..]
  chunk.binary
)
output := Collected('stdout')
errors := Collected('stderr')
exit := await run('echo_input', 'argument', stdin: input, stdout: output, stderr: errors)
print exit.code
print output.report()
print errors.report()

# exit_with reads nothing of the input, which a pipe would not hold whole.
unread := 'x'.repeat(1000000).binary
print (await run('exit_with', '0', stdin: unread)).code

struct Refusing
  write := (data: String | Binary): Promise -> throw IOError('the writer refuses')
  end := (): Promise -> return

try
  await run('echo_input', stdin: b'refused', stdout: Refusing())
catch error: IOError
  print error.message
failing := Reader(-> throw IOError('the reader fails'))
try
  await run('echo_input', stdin: failing, stdout: Collected('unused'))
catch error: IOError
  print error.message

# A Writer that fails while the program writes more than a pipe holds stops the program, which
# would wait for ever, and is ended all the same.
struct RefusingCounted
  ends: Int[]
  write := (data: String | Binary): Promise -> throw IOError('refused again')
  end := (): Promise -> @ends.push(1)

ends: Int[]
try
  await run('repeat', '100000', 'many bytes', stdout: RefusingCounted(ends))
catch error: IOError
  print "#{error.message}, ended #{ends.length}"

# A Buffer of stdout past its limit stops the program, and the Writer of stderr is ended.
stderr_writer := Collected('stderr')
try
  await run(
    'echo_input'
    'a'
    stdin: 'b'.repeat(100).binary
    stdout: Buffer(limit: 10)
    stderr: stderr_writer
  )
catch error: IOError
  print error.message
print stderr_writer.ended

# A cancel ends the Writer too.
cancelled := Collected('cancelled')
running := run('repeat', '100000000', 'line', stdout: cancelled)
await sleep(0.1)
running.cancel()
try
  await running
catch error: CancelledError
  print "#{error.message}, ended: #{cancelled.ended}"

# A Reader may give an empty chunk, which writes nothing.
var given = ['', 'after an empty chunk']
gaps := Reader(->
  return nil if given.is_empty()
  chunk := given[0]
  given = given[1..]
  chunk.binary
)
gapped := Collected('gapped')
await run('echo_input', stdin: gaps, stdout: gapped)
print gapped.report()

# A command that cannot start leaves no pipe behind, and its Writer as it was.
unstarted := Collected('unstarted')
try
  await run('no-such-command', stdin: b'x', stdout: Buffer(), stderr: unstarted)
catch error: IOError
  print "#{error.message}, ended: #{unstarted.ended}"

# A Buffer and another Writer together.
mixed_errors := Collected('mixed')
mixed := Buffer()
await run('echo_input', 'to stderr', stdin: b'to stdout', stdout: mixed, stderr: mixed_errors)
print mixed.text()!
print mixed_errors.report()

# A program that ends while its Reader has yet to give a chunk ends the run all the same.
pending := Reader(-> await Deferred<Binary?>().promise())
print (await run('exit_with', '0', stdin: pending)).code

# The error of a Writer's end fails the run, and the first error is the one told.
struct FailingEnd
  write := (data: String | Binary): Promise -> return
  end := (): Promise -> throw IOError('the end fails')

try
  await run('echo_input', stdin: b'o', stdout: FailingEnd())
catch error: IOError
  print error.message
try
  await run('echo_input', 'e', stdin: b'o', stdout: FailingEnd(), stderr: Refusing())
catch error: IOError
  print error.message

# A CancelledError that a Writer throws is its failure, not a cancel of the run.
struct Cancelling
  write := (data: String | Binary): Promise -> throw CancelledError('of the writer')
  end := (): Promise -> return

try
  await run('echo_input', stdin: b'x', stdout: Cancelling())
catch error: CancelledError
  print "failed: #{error.message}"

# So is one that a Writer throws once the program has ended, and its input has been given up.
struct LateCancelling
  write := (data: String | Binary): Promise ->
    await sleep(0.2)
    throw CancelledError('of the writer, late')
  end := (): Promise -> return

# Its stderr, slower still, is given up and ended before the run fails, as it would not be if the
# CancelledError were taken for a cancel of the run.
class SlowCollected
  var ended = false
  write := (data: String | Binary) -> await sleep(0.5)
  end := (): Promise -> @ended = true

slow := SlowCollected()
try
  await run('echo_input', 'e', stdin: b'x', stdout: LateCancelling(), stderr: slow)
catch error: CancelledError
  print "failed: #{error.message}, stderr ended: #{slow.ended}"

# A cancel while a Writer's write waits ends the Writer, and rejects the run as cancelled.
class Waiting
  var ended = false
  write := (data: String | Binary): Promise -> await Deferred<Int>().promise()
  end := (): Promise -> @ended = true

waiting := Waiting()
cancelled_run := run('echo_input', stdin: b'x', stdout: waiting)
await sleep(0.1)
cancelled_run.cancel()
try
  await cancelled_run
catch error: CancelledError
  print "#{error.message}, ended: #{waiting.ended}"
