# A value longer than the first buffer that the runtime reads one into.
import Buffer from 'std:io'
import run from 'std:process'

value := 'v'.repeat(1000)
printed := Buffer()
await run('print_place', 'LERTA_TEST_LONG', env: { 'LERTA_TEST_LONG': value }, stdout: printed)
print printed.text()!.trim() == "LERTA_TEST_LONG=#{value}"
