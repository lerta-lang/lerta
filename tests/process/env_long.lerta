# A value longer than the first buffer that the runtime reads one into.
import run from 'std:process'

value := 'v'.repeat(1000)
output: Byte[]
await run('print_place', 'LERTA_TEST_LONG', env: { 'LERTA_TEST_LONG': value }, stdout: output)
print output.to_binary().text()!.trim() == "LERTA_TEST_LONG=#{value}"
