# A value longer than the first buffer that the runtime reads one into.
import run from 'std:process'

value := 'v'.repeat(1000)
printed :=
  await run('print_place', 'LERTA_TEST_LONG', env: { 'LERTA_TEST_LONG': value }, stdout: CAPTURE)
print printed.stdout!.text()!.trim() == "LERTA_TEST_LONG=#{value}"
