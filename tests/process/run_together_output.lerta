# Programs that run at the same time each capture their own output: two that each wait two seconds
# end well within four.
import run from 'std:process'
import monotonic from 'std:time'
started := monotonic()
runs :=
  run('print_after', '2', 'first', stdout: CAPTURE)
  run('print_after', '2', 'second', stdout: CAPTURE)
print (await each).stdout!.text()! for each in runs
print monotonic() - started < 3.5
