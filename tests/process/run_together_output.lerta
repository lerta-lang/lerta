# Programs that run at the same time each capture their own output: two that each wait two seconds
# end well within four.
import Buffer from 'std:io'
import run from 'std:process'
import monotonic from 'std:time'
started := monotonic()
outputs := [Buffer(), Buffer()]
runs :=
  run('print_after', '2', 'first', stdout: outputs[0])
  run('print_after', '2', 'second', stdout: outputs[1])
await each for each in runs
print output.text()! for output in outputs
print monotonic() - started < 3.5
