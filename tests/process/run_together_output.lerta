# Programs that run at the same time each append their output to their own array, or, sharing one,
# each its whole output when it ends.
import run from 'std:process'
const first: Array<Byte> = []
const second: Array<Byte> = []
const shared: Array<Byte> = []
const runs = [
  run('print_after', ['2', 'first'], first)
  run('print_after', ['0', 'second'], second)
  run('print_after', ['2', 'late'], shared)
  run('print_after', ['0', 'early'], shared)
]
await each for each in runs
print first.to_binary().text()!
print second.to_binary().text()!
print shared.to_binary().text()!
