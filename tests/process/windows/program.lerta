# `program` is the last name of the path that starts the program, by `\` or `/`, without `.exe` in
# any case. print_program of tests/bin, found on PATH, is copied here to start it by other paths.
import is_file, make_dir, read_file, write_file from 'std:io'
import env, run from 'std:process'

dirs := env('PATH')!.split(';')
dir := dirs.find((each) -> is_file("#{each}\\print_program.exe"))!
make_dir 'sub'
await write_file('sub\\Tool.EXE', await read_file("#{dir}\\print_program.exe"))

await run('print_program')
await run('.\\sub\\Tool.EXE')
await run('./sub\\Tool.exe')
await run('sub/Tool')
