# A batch file is refused, as cmd.exe would parse its arguments again (see std:process in std.md).
import write_file from 'std:io'
import run from 'std:process'

await write_file('t.bat', '@echo ran %1'.binary)
await write_file('T.CMD', '@echo ran %1'.binary)

try_run := (command: String) ->
  try
    await run(command, 'a&echo injected')
  catch e: IOError
    print e.message

await try_run('./t.bat')
await try_run('./T.CMD')
await try_run('./t.bat. ')
await try_run('.\t.bat')
