# A cancel stops the program with SIGTERM, and kills one that ignores it once kill_after has
# passed; the wait ends once the program has.
import run from 'std:process'
import monotonic, sleep from 'std:time'

started := monotonic()
stopped := run('sh', '-c', 'exec sleep 5')
stopped.cancel()
try
  await stopped
catch error: CancelledError
  print error.message
print monotonic() - started < 4

kept := run('sh', '-c', 'trap "" TERM; exec sleep 5', kill_after: 0.2)
kept.cancel()
try
  await kept
catch error: CancelledError
  print error.message
print monotonic() - started < 4

# The signal that ended a program is told apart from its exit code.
exit := await run('sh', '-c', 'kill -TERM $$')
print [exit.code, exit.signal ? 0]

# A cancel with kill_after of 0 kills at once, and the output read meanwhile is not given.
output: Byte[]
errors: Byte[]
script := 'echo out; echo err >&2; trap "" TERM; exec sleep 5'
killed := run('sh', '-c', script, stdout: output, stderr: errors, kill_after: 0.0)
await sleep(0.3)
killed.cancel()
try
  await killed
catch error: CancelledError
  print error.message
print [output.length, errors.length]
print monotonic() - started < 4

# A cancel after the program has exited, while a program it started holds its output open, ends
# the wait at once.
held: Byte[]
exited := run('sh', '-c', 'sleep 5 2> /dev/null & exit 0', stdout: held)
await sleep(0.3)
exited.cancel()
try
  await exited
catch error: CancelledError
  print error.message
print monotonic() - started < 4

# A program that ends by itself as it is stopped, with code 0, still has its wait cancelled; so
# does one that was given input.
ending := run('sh', '-c', 'trap "exit 0" TERM; sleep 5 & wait', stdin: b'input')
await sleep(0.3)
ending.cancel()
try
  await ending
catch error: CancelledError
  print error.message
print monotonic() - started < 4

# A program that ignores SIGTERM as it writes past the limit of its output is killed after
# kill_after.
flood: Byte[]
try
  await run(
    'sh'
    '-c'
    'trap "" TERM; yes 2> /dev/null'
    stdout: flood
    output_limit: 10
    kill_after: 0.5
  )
catch error: IOError
  print error.message
print flood.length
print monotonic() - started < 6
