# Runs that a shell scripts, of what tests/process/run_streams does not reach: one Writer for both
# outputs, a Reader cut short, and the output of a program that the program started, which goes
# on after it, read to its end or cancelled.
import Reader from 'std:io'
import run from 'std:process'
import sleep from 'std:time'

# Writes down what it gets, and its end.
class Collected
  name: String
  var written = b''
  var ended = false

  write := (data: String | Binary): Promise -> @written += data is String then data.binary else data

  end := (): Promise -> @ended = true

  report := -> "#{@name}: #{@written.text()!.trim()} (ended: #{@ended})"

# One Writer may take both outputs, as `2>&1` does, and is ended once both have ended, so the
# output that ends later is not cut short.
class Merged
  var written = b''
  var ends = 0
  var late_writes = 0

  write := (data: String | Binary): Promise ->
    @late_writes += 1 if @ends > 0
    @written += data is String then data.binary else data

  end := (): Promise -> @ends += 1

merged := Merged()
script := 'echo first >&2; exec 2>&-; sleep 0.3; echo second'
await run('sh', '-c', script, stdout: merged, stderr: merged)
print
  "#{merged.written.text()!.split("\n").join(' ')}ends: #{merged.ends}, late: #{merged.late_writes}"

# A Reader that fails after it has given some of the input stops the program, which would go on
# with an input that seems whole though it is cut short.
var parts = 1
cut := Reader(->
  throw IOError('the input is cut short') if parts == 0
  parts -= 1
  b'a part'
)
went_on := Collected('went on')
try
  await run('sh', '-c', 'cat > /dev/null; sleep 1; echo went on', stdin: cut, stdout: went_on)
catch error: IOError
  print "#{error.message}, #{went_on.report()}"

# An output that a program it started writes after it has ended is read to its end.
late := await run('sh', '-c', '(sleep 0.3; echo written late) &', stdout: CAPTURE)
print late.stdout!.text()!.trim()

# A cancel while a program that the program started still writes, after it has ended, ends the
# Writer, and rejects the run as cancelled.
still := Collected('still')
going_on := run('sh', '-c', 'echo before; (sleep 2; echo after) &', stdout: still)
await sleep(0.5)
going_on.cancel()
try
  await going_on
catch error: CancelledError
  print "#{error.message}, #{still.report()}"
