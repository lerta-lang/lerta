# A program run with input, its output and errors read apart, in a directory and with variables
# of its own.
import run from 'std:process'
import make_dir from 'std:io'

input := b"input\nlines"
exit := await run('echo_input', 'a', 'b', stdin: input, stdout: CAPTURE, stderr: CAPTURE)
print exit.code
print exit.signal == nil
print exit.stdout!.text()!
print exit.stderr!.text()!

# Without input, the program reads this one's standard input, which is empty here.
print (await run('echo_input', stdout: CAPTURE)).stdout!.length

make_dir 'place'
await run('print_place', cwd: 'place')

# The outer with_env sets the variables that the inner one, through run, keeps, replaces and
# removes; a value holding `=` is kept whole.
outer := ['LERTA_TEST_KEPT=kept=1', 'LERTA_TEST_REPLACED=old', 'LERTA_TEST_REMOVED=removed']
inner := ['-u', 'LERTA_TEST_REMOVED', 'LERTA_TEST_REPLACED=new', 'LERTA_TEST_SET=set']
names := ['LERTA_TEST_KEPT', 'LERTA_TEST_REPLACED', 'LERTA_TEST_REMOVED', 'LERTA_TEST_SET']
await run('with_env', outer..., 'with_env', inner..., 'print_place', names...)

# Errors alone are read, and an input larger than a pipe holds, or an empty one, is read whole.
print (await run('echo_input', 'e', stdin: b'', stderr: CAPTURE)).stderr!.text()!
large := 'abcdefghij'.repeat(100000).binary
print (await run('echo_input', stdin: large, stdout: CAPTURE)).stdout!.length

# A program that ends with an exit code other than 0 has no signal.
failed := await run('exit_with', '3')
print [failed.code, failed.signal ? 0]
