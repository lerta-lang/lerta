# Output up to a Buffer's limit is kept; past it, on either stream, the program is stopped and the
# run fails.
import Buffer, Writer from 'std:io'
import run from 'std:process'

within := Buffer(limit: 1000)
await run('repeat', '100', 'abcdefghi', stdout: within)
print within.binary.length

# The Buffer keeps what it took before the write that would pass the limit.
past := Buffer(limit: 1000)
try
  await run('repeat', '20000', 'abcdefghi', stdout: past)
catch error: IOError
  print error.message
print not past.binary.is_empty() and past.binary.length <= 1000

# One byte past the limit, on stderr alone, fails the run.
try
  input := 'a'.repeat(1000)
  await run('echo_input', input, stdout: Buffer(limit: 1000), stderr: Buffer(limit: 1000))
catch error: IOError
  print error.message

# A limit of 0 lets a program that writes nothing run, and stops one that writes.
print (await run('exit_with', '0', stdout: Buffer(limit: 0))).code
try
  await run('print_args', 'a', stdout: Buffer(limit: 0))
catch error: IOError
  print error.message

# Both streams at the limit pass; and stderr past it stops the program while stdout is shared.
output := Buffer(limit: 1000)
errors := Buffer(limit: 1000)
input := 'b'.repeat(1000).binary
at_limit := await run('echo_input', 'a'.repeat(999), stdin: input, stdout: output, stderr: errors)
print [at_limit.code, output.binary.length, errors.binary.length]
try
  await run('echo_input', 'a'.repeat(1000), stderr: Buffer(limit: 1000))
catch error: IOError
  print error.message

# The errors merged into the output count toward its limit.
try
  await run('print_both', stdout: Buffer(limit: 12), stderr: STDOUT)
catch error: IOError
  print error.message

# The error of an output past the limit fails the run, not that of a Writer that fails after it.
class FailingEnd: Writer
  write := (data: String | Binary): Promise -> return
  end := (): Promise -> throw IOError('cannot end')
try
  await run('repeat', '20000', 'abcdefghi', stdout: Buffer(limit: 1000), stderr: FailingEnd())
catch error: IOError
  print error.message
