# Output up to the limit is read; past it, on either stream, the program is stopped, the output of
# both dropped, and the run fails.
import Writer from 'std:io'
import run from 'std:process'

output: Byte[]
await run('repeat', '100', 'abcdefghi', stdout: output, output_limit: 1000)
print output.length

too_much: Byte[]
try
  await run('repeat', '20000', 'abcdefghi', stdout: too_much, output_limit: 1000)
catch error: IOError
  print error.message
print too_much.length

# One byte past the limit, on stderr alone, drops stdout too.
kept_output: Byte[]
errors: Byte[]
try
  await run('echo_input', 'a'.repeat(1000), stdout: kept_output, stderr: errors, output_limit: 1000)
catch error: IOError
  print error.message
print [kept_output.length, errors.length]

# A limit of 0 lets a program that writes nothing run, and stops one that writes.
nothing: Byte[]
print (await run('exit_with', '0', stdout: nothing, output_limit: 0)).code
try
  await run('print_args', 'a', stdout: nothing, output_limit: 0)
catch error: IOError
  print error.message
print nothing.length

# The limit is of each stream: both at it pass; and stderr past it stops the program while stdout
# is shared.
both_output: Byte[]
both_errors: Byte[]
input := 'b'.repeat(1000).binary
at_limit := await run(
  'echo_input'
  'a'.repeat(999)
  stdin: input
  stdout: both_output
  stderr: both_errors
  output_limit: 1000
)
print [at_limit.code, both_output.length, both_errors.length]
only_errors: Byte[]
try
  await run('echo_input', 'a'.repeat(1000), stderr: only_errors, output_limit: 1000)
catch error: IOError
  print error.message

# The error of an output past the limit fails the run, not that of a Writer that fails after it.
class FailingEnd: Writer
  write = (data: String | Binary): Promise -> return
  end = (): void -> throw IOError('cannot end')
past_limit: Byte[]
try
  await run(
    'repeat'
    '20000'
    'abcdefghi'
    stdout: past_limit
    stderr: FailingEnd()
    output_limit: 1000
  )
catch error: IOError
  print error.message
