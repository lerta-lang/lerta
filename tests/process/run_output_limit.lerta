# Output up to the limit is captured; past it, on either stream, the program is stopped and the
# run fails.
import Writer from 'std:io'
import run from 'std:process'

print (await run('repeat', '100', 'abcdefghi', stdout: CAPTURE, output_limit: 1000)).stdout!.length

try
  await run('repeat', '20000', 'abcdefghi', stdout: CAPTURE, output_limit: 1000)
catch error: IOError
  print error.message

# One byte past the limit, on stderr alone, fails the run.
try
  await run('echo_input', 'a'.repeat(1000), stdout: CAPTURE, stderr: CAPTURE, output_limit: 1000)
catch error: IOError
  print error.message

# A limit of 0 lets a program that writes nothing run, and stops one that writes.
print (await run('exit_with', '0', stdout: CAPTURE, output_limit: 0)).code
try
  await run('print_args', 'a', stdout: CAPTURE, output_limit: 0)
catch error: IOError
  print error.message

# The limit is of each stream: both at it pass; and stderr past it stops the program while stdout
# is shared.
input := 'b'.repeat(1000).binary
at_limit := await run(
  'echo_input'
  'a'.repeat(999)
  stdin: input
  stdout: CAPTURE
  stderr: CAPTURE
  output_limit: 1000
)
print [at_limit.code, at_limit.stdout!.length, at_limit.stderr!.length]
try
  await run('echo_input', 'a'.repeat(1000), stderr: CAPTURE, output_limit: 1000)
catch error: IOError
  print error.message

# The error of an output past the limit fails the run, not that of a Writer that fails after it.
class FailingEnd: Writer
  write := (data: String | Binary): Promise -> return
  end := (): Promise -> throw IOError('cannot end')
try
  await run(
    'repeat'
    '20000'
    'abcdefghi'
    stdout: CAPTURE
    stderr: FailingEnd()
    output_limit: 1000
  )
catch error: IOError
  print error.message
