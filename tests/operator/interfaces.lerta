# Add and the like name the methods of the operators, which a generic function asks of its type
# parameters. The numbers have them, applying the operators, and String has add.
struct Money
  cents: Int

extend Money
  add := (other: Money) -> Money(@cents + other.cents)
  neg := -> Money(-@cents)
  to_string := -> "#{@cents} cents"

total := <T: Add<T, T>>(items: T[], zero: T) ->
  var sum = zero
  sum += item for item in items
  sum
print total([1, 2, 3], 0)
print total([1.5, 2.25], 0.0)
print total(['a', 'b', 'c'], '')
print total([Money(150), Money(275)], Money(0))

opposite := <T: Neg<T>>(x: T) -> -x
print [opposite(5), opposite(-2)]
print opposite(Money(99))

# The numbers' methods apply their operators, and throw as they do.
small: Int8 = 100
print [3.add(4), 10.sub(3), 6.mul(7), 7.div(2), 7.rem(2), 5.neg()]
print [6.bit_and(3), 6.bit_or(3), 6.bit_xor(3), 1.shl(4), 16.shr(2)]
print 1.5.mul(2.0)
print 'ab'.add('cd')
values := <T: Sub<T, T>>(a: T, b: T) -> a - b
print values(small, small)

# A String's add through a bound keeps its operands, which stay usable.
word := 'ab'
var joined = word
joined = total([joined, word, joined], '')
print [word, joined]
halves: Float32[] = [0.5, 0.25]
print total(halves, 0)

# An operand of an interface type calls the member through the interface.
plus_five := (u: Add<Int, Money>) -> u + 5
opposite_money := (u: Neg<Money>) -> -u
struct Coins
  count: Int

extend Coins
  add := (more: Int) -> Money((@count + more) * 25)
print plus_five(Coins(3))
print opposite_money(Money(40))

# `**` calls pow on every type, Int and Float too, and `~` calls bit_not on those that it does not
# invert otherwise.
struct Word
  text: String

extend Word
  pow := (n: Int) -> Word(@text.repeat(n))
  bit_not := -> Word(@text.reversed())

print (Word('ab') ** 3).text
squared := <T: Pow<Int, T>>(x: T) -> x ** 2
print [squared(7), squared(-3)]
print squared(Word('xy')).text
print [3.pow(4), 5.bit_not()]
print 2.0.pow(0.5)
inverted := <T: BitNot<T>>(x: T) -> ~x
print [(~Word('abc')).text, inverted(Word('xyz')).text]
print inverted(0)
var word_power = Word('o')
word_power **= 4
print word_power.text
