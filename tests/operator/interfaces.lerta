# Add and the like name the methods of the operators, which a generic function asks of its type
# parameters. The numbers have them, applying the operators, and String has add.
struct Money(cents: Int)

extend Money
  add = (other: Money) -> Money(cents: @cents + other.cents)
  neg = -> Money(cents: -@cents)
  to_string = -> "#{@cents} cents"

const total = <T: Add<T, T>>(items: T[], zero: T) ->
  var sum = zero
  sum += item for item in items
  sum
print total([1, 2, 3], 0)
print total([1.5, 2.25], 0.0)
print total(['a', 'b', 'c'], '')
print total([Money(cents: 150), Money(cents: 275)], Money(cents: 0))

const opposite = <T: Neg<T>>(x: T) -> -x
print [opposite(5), opposite(-2)]
print opposite(Money(cents: 99))

# The numbers' methods apply their operators, and throw as they do.
const small: Int8 = 100
print [3.add(4), 10.sub(3), 6.mul(7), 7.div(2), 7.rem(2), 5.neg()]
print [6.bit_and(3), 6.bit_or(3), 6.bit_xor(3), 1.shl(4), 16.shr(2)]
print (1.5).mul(2.0)
print 'ab'.add('cd')
const values = <T: Sub<T, T>>(a: T, b: T) -> a - b
print values(small, small)

# A String's add through a bound keeps its operands, which stay usable.
const word = 'ab'
var joined = word
joined = total([joined, word, joined], '')
print [word, joined]
const halves: Float32[] = [0.5, 0.25]
print total(halves, 0)

# An operand of an interface type calls the member through the interface.
const plus_five = (u: Add<Int, Money>) -> u + 5
const opposite_money = (u: Neg<Money>) -> -u
struct Coins(count: Int)

extend Coins
  add = (more: Int) -> Money(cents: (@count + more) * 25)
print plus_five(Coins(count: 3))
print opposite_money(Money(cents: 40))
