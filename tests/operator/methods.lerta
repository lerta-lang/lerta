# An arithmetic or bitwise operator on a value of a type that it does not apply to otherwise calls
# the type's method of its name, `a + b` as `a.add(b)`, and `-a` as `a.neg()`.
struct Vec(x: Int, y: Int)

extend Vec
  add = (other: Vec) -> Vec(x: @x + other.x, y: @y + other.y)
  sub = (other: Vec) -> Vec(x: @x - other.x, y: @y - other.y)
  mul = (k: Int) -> Vec(x: @x * k, y: @y * k)
  div = (k: Int) -> Vec(x: @x / k, y: @y / k)
  rem = (k: Int) -> Vec(x: @x % k, y: @y % k)
  neg = -> Vec(x: -@x, y: -@y)
  to_string = -> "(#{@x}, #{@y})"

const a = Vec(x: 1, y: 2)
const b = Vec(x: 10, y: 20)
print a + b
print b - a
# The right operand takes its type from the method's parameter, as an argument does.
print a * 3
print b / 3
print b % 3
print -a
# Precedence is that of the operators.
print a + b * 2 - -a

# The bitwise operators and the shifts call bit_and and the like.
class Flags(bits: Int)

extend Flags
  bit_and = (other: Flags) -> Flags(bits: @bits & other.bits)
  bit_or = (other: Flags) -> Flags(bits: @bits | other.bits)
  bit_xor = (other: Flags) -> Flags(bits: @bits ^ other.bits)
  shl = (n: Int) -> Flags(bits: @bits << n)
  shr = (n: Int) -> Flags(bits: @bits >> n)

const f = Flags(bits: 6)
const g = Flags(bits: 3)
print [(f & g).bits, (f | g).bits, (f ^ g).bits, (f << 2).bits, (f >> 1).bits]

# The result may be of another type than the operands.
class Meters(value: Float)

extend Meters
  div = (other: Meters) -> @value / other.value
print Meters(value: 3.0) / Meters(value: 2.0)

# A compound assignment assigns the method's result: to a variable, a field and an item.
var c = a
c += b
c *= 2
c -= a
print c
class Holder(var vec: Vec)
const holder = Holder(vec: a)
holder.vec += b
print holder.vec
const vecs = [a, b]
vecs[1] += a
print vecs[1]
# The target's index may be arithmetic, which calls nothing.
var i = 0
vecs[i + 1] += a
vecs[-i] -= a
print "#{vecs[0]} #{vecs[1]}"

# A method may have parameters with defaults beyond the operand.
class Scaled(value: Int)

extend Scaled
  mul = (k: Int, offset = 0) -> Scaled(value: @value * k + offset)
print (Scaled(value: 4) * 3).value

# Compound shifts and bitwise assignments call their methods too.
var flags = f
flags <<= 1
flags &= Flags(bits: 12)
flags |= g
print flags.bits

# Inside a method, a field reached through @ is a target too.
class Account(var balance: Vec)

extend Account
  settle = ->
    @balance -= Vec(x: 1, y: 1)
    @balance /= 2
const account = Account(balance: Vec(x: 9, y: 5))
account.settle()
print account.balance

# The left operand is evaluated once, though it is a call.
var made = 0
const make = ->
  made += 1
  a
print make() + b
print [made]

# A field that holds a function is read as the method, as an interface member is.
class Doubler(add: (Int) -> Int)
print Doubler(add: (k) -> k * 2) + 5

# A literal operand takes the type of the method's parameter; results chain.
class Gauge(value: Float32)

extend Gauge
  mul = (factor: Float32) -> Gauge(value: @value * factor)
  add = (amount: Int) -> Gauge(value: @value + amount.to_float().to_float32()!)
print (Gauge(value: 1.5) * 2).value
print (Gauge(value: 1.0) + 3 + 4).value
print (Gauge(value: 1.0) + -3).value
