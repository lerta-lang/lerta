# The builtin methods after which no exception is pending, each in a function of its own: those that
# call nothing that throws, and a number's operator, which throws by unwinding at once, to a catch
# where there is one.
enum Color
  RED
  GREEN

code := (c: Char) -> c.to_int()
char_of := (n: Int) -> n.to_char()
small := (n: Int) -> n.to_int8()
as_float := (n: Int) -> n.to_float()
wrapped := (n: Int) -> n.wrapping_add(1)
compared := (a: Int, b: Int) -> a.compare(b)
float_compared := (a: Float, b: Float) -> a.compare(b)
char_compared := (a: Char, b: Char) -> a.compare(b)
named := (color: Color) -> color.to_string()
literal := (color: Color) -> color.to_literal()
added := (n: Int8, m: Int8) -> n.add(m)
negated := (n: Int8) -> n.neg()
float_quotient := (a: Float, b: Float) -> a.div(b)
# The operator of a String or a Binary calls the runtime, so a check follows it.
joined := (a: String, b: String) -> a.add(b)
bytes_joined := (a: Binary, b: Binary) -> a.add(b)

# The text held while the operator throws is released on the way to the catch.
caught_sum := (n: Int8, m: Int8) ->
  try
    text := "#{n}"
    "#{text} #{n.add(m)}"
  catch e: ArithmeticError
    e.message

caught_quotient := (n: Int, m: Int) ->
  try
    text := "#{n}"
    "#{text} #{n.div(m)}"
  catch e: ArithmeticError
    e.message

caught_remainder := (n: Int, m: Int) ->
  try
    text := "#{n}"
    "#{text} #{n.rem(m)}"
  catch e: ArithmeticError
    e.message

caught_negation := (n: Int) ->
  try
    text := "#{n}"
    "#{text} #{n.neg()}"
  catch e: ArithmeticError
    e.message

caught_float_quotient := (a: Float, b: Float) ->
  try
    text := "#{a}"
    "#{text} #{a.div(b)}"
  catch e: ArithmeticError
    e.message

caught_float_product := (a: Float, b: Float) ->
  try
    text := "#{a}"
    "#{text} #{a.mul(b)}"
  catch e: ArithmeticError
    e.message

print code('a')
print char_of(98)!
print small(1000) == nil
print as_float(3)
print wrapped(INT_MAX)
print compared(1, 2)
print float_compared(2.0, 1.0)
print char_compared('a', 'a')
print named(GREEN)
print literal(RED)
print added(1, 2)
print negated(5)
print float_quotient(1.0, 4.0)
print caught_sum(1, 2)
print caught_sum(100, 100)
print joined('a', 'b')
print bytes_joined('a'.binary, 'b'.binary).length
print caught_quotient(6, 3)
print caught_quotient(6, 0)
print caught_quotient(INT_MIN, -1)
print caught_remainder(7, 3)
print caught_remainder(7, 0)
print caught_remainder(INT_MIN, -1)
print caught_negation(5)
print caught_negation(INT_MIN)
print caught_float_quotient(1.0, 0.0)
print caught_float_quotient(0.0, 0.0)
print caught_float_product(2.0, 1e308)
