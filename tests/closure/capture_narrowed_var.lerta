optional := ->
  var x: Int? = 5
  if x != nil
    f := -> print(x ? 0)
    f()

union := ->
  var x: Int | String = 1
  if x is Int
    f := -> print(x is Int)
    f()

comprehension := ->
  var x: Int? = 2
  if x != nil
    doubled := (item * (x ? 0) for item in [1, 2])
    print doubled.to_array()

nested := ->
  var x: Int? = 5
  if x != nil
    outer := ->
      inner := -> print(x ? 0)
      inner()
      x = nil
      inner()
    outer()

optional()
union()
comprehension()
nested()
