class Counter
  count = 0
  items = [1, 2, 3]
  step = 10

  add_all = ->
    add := (x: Int) -> @count += x * @step
    add x for x in @items

  doubler = (): ((Int) -> Int) -> (x) -> x * @step

  nested = (): (() -> String) ->
    label := 'n'
    read := -> @count
    -> label + [read() for _ in 0...1][0].to_string()

counter := Counter()
counter.add_all()
print counter.count
double := counter.doubler()
print double(3)
print counter.nested()()

struct Box
  n: Int
  bump = -> @n + 1
  get = (): (() -> Int) -> -> @bump() * 10
print Box(4).get()()
