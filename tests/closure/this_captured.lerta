class Counter
  count = 0
  items: Array<Int> = [1, 2, 3]
  step = 10

  add_all = ->
    const add = (x: Int) ->
      @count += x * @step
    add(x) for x in @items

  doubler = (): (Int) -> Int -> (x) -> x * @step

  nested = (): () -> String ->
    const label = 'n'
    const read = -> @count
    -> label + [read() for _ in 0...1][0].to_string()

const counter = Counter()
counter.add_all()
print counter.count
const double = counter.doubler()
print double(3)
print counter.nested()()

struct Box
  n: Int
  bump = (): Int -> @n + 1
  get = (): () -> Int -> -> @bump() * 10
print Box(n: 4).get()()
