apply := (f: (Int) -> Int, x: Int) -> f(x)
map := (xs: Int[], f: (Int) -> Int) ->
  result: Int[]
  result.push f(x) for x in xs
  result
make_adder := (n: Int): ((Int) -> Int) -> (x) -> x + n
make_greeter := (greeting: String): ((String) -> String) ->
  suffix := '!'
  (name) -> "#{greeting}, #{name}#{suffix}"
twice := (f: (Int) -> Int): ((Int) -> Int) -> (x) -> f(f(x))

print apply((x) -> x * 10, 4)
print map([1, 2, 3], (x) -> x * x)[2]
add5 := make_adder(5)
print add5(1)
print make_greeter('hello')('ann')
print twice(make_adder(3))(1)
base: Int? = 7
if base
  add_base := (x: Int) -> x + base
  print add_base(1)
nested := (a: Int) ->
  outer := (b: Int) ->
    inner := (c: Int) -> a + b + c
    print inner(3)
  outer 2
nested 1
var total = 0
total += x for x in map([1, 2], (x) -> x + 1)
print total
compute := ->
  label := 'computed'
  show := -> print(label)
  show()
  show
compute()()
