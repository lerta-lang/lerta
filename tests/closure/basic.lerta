const apply = (f: (Int) -> Int, x: Int) -> f(x)
const map = (xs: Int[], f: (Int) -> Int) ->
  const result: Int[]
  result.push f(x) for x in xs
  result
const make_adder = (n: Int): ((Int) -> Int) -> (x) -> x + n
const make_greeter = (greeting: String): ((String) -> String) ->
  const suffix = '!'
  (name) -> "#{greeting}, #{name}#{suffix}"
const twice = (f: (Int) -> Int): ((Int) -> Int) -> (x) -> f(f(x))

print apply((x) -> x * 10, 4)
print map([1, 2, 3], (x) -> x * x)[2]
const add5 = make_adder(5)
print add5(1)
print make_greeter('hello')('ann')
print twice(make_adder(3))(1)
const base: Int? = 7
if base
  const add_base = (x: Int) -> x + base
  print add_base(1)
const nested = (a: Int) ->
  const outer = (b: Int) ->
    const inner = (c: Int) -> a + b + c
    print inner(3)
  outer 2
nested 1
var total = 0
total += x for x in map([1, 2], (x) -> x + 1)
print total
const compute = ->
  const label = 'computed'
  const show = -> print(label)
  show()
  show
compute()()
