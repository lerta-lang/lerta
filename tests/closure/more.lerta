struct Leaf(name: String)
struct Pair(left: Int, right: Int)
type Node = Leaf | Pair

class Registry
  handlers: ((String) -> String)[] = []

var calls = 0
counted := (s: String) ->
  count_call := -> calls += 1
  count_call()
  s

describers := (node: Node): (() -> String) ->
  case node
    when Leaf then -> 'leaf ' + node.name
    when Pair then -> "pair #{node.left + node.right}"

optional_greeting := (name: String?): (() -> String) ->
  if name
    return -> 'hi ' + name
  -> 'nobody'

make_registry := ->
  registry := Registry()
  prefix := '> '
  registry.handlers.push (s) -> prefix + s
  registry.handlers.push (s) -> counted(s)
  registry

shadowing := (x: Int) ->
  f := (x: Int) -> x * 100
  f x + 1

mixed := (f: (Int, String) -> String) -> f(2, 'b')
fails := (f: (Int) -> Int) -> f(1)

registry := make_registry()
print handler('text') for handler in registry.handlers
print calls
print describers(Leaf(name: 'x'))()
print describers(Pair(left: 1, right: 2))()
print optional_greeting('ann')()
print optional_greeting(nil)()
print shadowing(1)
print mixed((n, s: String) -> s + n.to_string())  # fmt: skip
print fails((x) -> throw ValueError(message: 'boom'))
