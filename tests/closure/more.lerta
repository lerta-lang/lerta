struct Leaf
  name: String
struct Pair
  left: Int
  right: Int
type Node = Leaf | Pair

class Registry
  handlers: Array<(String) -> String> = []

var calls = 0
const counted = (s: String): String ->
  const count_call = ->
    calls += 1
  count_call()
  s

const describers = (node: Node): () -> String ->
  case node
    when Leaf then -> 'leaf ' + node.name
    when Pair then -> "pair #{node.left + node.right}"

const optional_greeting = (name: String?): () -> String ->
  if name
    return -> 'hi ' + name
  -> 'nobody'

const make_registry = (): Registry ->
  const registry = Registry()
  const prefix = '> '
  registry.handlers.push((s) -> prefix + s)
  registry.handlers.push((s) -> counted(s))
  registry

const shadowing = (x: Int): Int ->
  const f = (x: Int): Int -> x * 100
  f(x + 1)

const mixed = (f: (Int, String) -> String): String -> f(2, 'b')
const fails = (f: (Int) -> Int): Int -> f(1)

const registry = make_registry()
for handler in registry.handlers
  print handler('text')
print calls
print describers(Leaf(name: 'x'))()
print describers(Pair(left: 1, right: 2))()
print optional_greeting('ann')()
print optional_greeting(nil)()
print shadowing(1)
print mixed((n, s: String) -> s + n.to_string())
print fails((x) -> throw 'boom')
