var global_count = 0
bump_global := -> global_count += 1

early := (stop: Bool) ->
  var n = 1
  read := -> n
  return 0 if stop
  read()

in_loop := ->
  var total = 0
  for i in 0..5
    var seen = i
    add := -> total += seen
    continue if i == 1
    break if i == 4
    add()
  total

never_called := ->
  var unused_by_call = 5
  _later := -> unused_by_call
  unused_by_call

optional_var := ->
  var maybe: Int?
  set := (x: Int) -> maybe = x
  set 7
  maybe ? -1

text_after := ->
  var text = 'a'
  append := (s: String) -> text = text + s
  append 'b' + 'c'
  append 'd'
  text

while_rounds := ->
  var made: (() -> Int)[] = []
  var i = 0
  while i < 3
    var value = i * 2
    made.push -> value
    i += 1
  var sum = 0
  sum += f() for f in made
  sum

bump_global()
bump_global()
print global_count
print early(true)
print early(false)
print in_loop()
print never_called()
print optional_var()
print text_after()
print while_rounds()
