const make_counter = (): (() -> Int) ->
  var count = 0
  ->
    count += 1
    count

const sum_with = (xs: Int[]): Int ->
  var total = 0
  const add = (x: Int) ->
    total += x
  add(x) for x in xs
  total

const collect = (): String[] ->
  var names: String[] = []
  var last = 'none'
  const remember = (name: String) ->
    names.push(name)
    last = name
  remember('a' + 'b')
  remember('c')
  names.push(last)
  names

const nested = (): Int ->
  var n = 1
  const outer = ->
    const inner = ->
      n *= 10
    inner()
    inner()
  outer()
  n

const counter = make_counter()
counter()
counter()
print counter()
const other = make_counter()
print other()
print sum_with([1, 2, 3])
print collect().join(',')
print nested()
var handlers: (() -> Int)[] = []
for i in 0...3
  var seen = i * 10
  const bump = ->
    seen += 1
    seen
  handlers.push(bump)
print [handler().to_string() for handler in handlers].join(',')
print handlers[1]() + handlers[1]()
