make_counter := (): (() -> Int) ->
  var count = 0
  ->
    count += 1
    count

sum_with := (xs: Int[]) ->
  var total = 0
  add := (x: Int) -> total += x
  add x for x in xs
  total

collect := ->
  var names: String[]
  var last = 'none'
  remember := (name: String) ->
    names.push name
    last = name
  remember 'a' + 'b'
  remember 'c'
  names.push last
  names

nested := ->
  var n = 1
  outer := ->
    inner := -> n *= 10
    inner()
    inner()
  outer()
  n

counter := make_counter()
counter()
counter()
print counter()
other := make_counter()
print other()
print sum_with([1, 2, 3])
print collect().join(',')
print nested()
var handlers: (() -> Int)[]
for i in 0..3
  var seen = i * 10
  bump := ->
    seen += 1
    seen
  handlers.push bump
print [handler().to_string() for handler in handlers].join(',')
print handlers[1]() + handlers[1]()
