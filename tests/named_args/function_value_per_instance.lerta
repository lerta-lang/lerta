# A call through a function value that leaves out or names the argument of a type parameter is
# checked per instance, which tells whether it is a struct.
struct O
  n := 1
left_out := <T>(f: (Int, T) -> Int) -> f(1)
print left_out((x: Int, o: O) -> x + o.n)
print left_out((x: Int, n: Int) -> x + n)
