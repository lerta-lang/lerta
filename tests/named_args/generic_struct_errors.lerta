# A generic call gathers named arguments with the errors of any call: a field of another type, an
# optional struct or an anonymous one left out, or a last parameter of no struct type.
struct Options
  count := default 1
f := <T>(x: T, o: Options) -> x
print f(1, count: 'x')
maybe := <T>(x: T, o: Options?) -> x
print maybe(true)
anonymous := <T>(x: T, o: { n: Int }) -> x
print anonymous(1)
plain := <T>(x: T, n: Int) -> x
print plain(1, k: 2)
