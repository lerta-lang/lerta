# A call in a generic function, checked once for each instance, gives a struct each time.
struct Options
  count = default 1

plain := (x: Int, options: Options) -> x + options.count
variadic := (xs: Int..., options: Options) -> xs.length + options.count

twice := <T>(value: T) ->
  print [plain(1), plain(1, count: 2), variadic(), variadic(1, 2, count: 3)]
  value

twice 1
twice 'a'
