# A call in a generic function, checked once for each instance, gives a struct each time.
struct Options(count = default 1)

const plain = (x: Int, options: Options) -> x + options.count
const variadic = (xs: Int..., options: Options) -> xs.length + options.count

const twice = <T>(value: T) ->
  print [plain(1), plain(1, count: 2), variadic(), variadic(1, 2, count: 3)]
  value

twice 1
twice 'a'
