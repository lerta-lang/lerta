# A last parameter of a struct type is constructed from the named arguments of the call, or from
# none where the call leaves it out; after a variadic parameter, named arguments alone give it.
struct Options
  cwd: String?
  count := default 1
  # Computed, so not an argument.
  twice := @count * 2

run := (command: String, args: String..., options: Options) ->
  print "#{command} #{args} #{options.cwd ? '-'} #{options.count} #{options.twice}"

run 'a'
run 'b', 'x', 'y', cwd: '/tmp'
xs := ['p', 'q']
run 'c', xs..., count: 3

show := (name: String, options: Options) -> print("#{name} #{options.count}")
show 'd'
show 'e', count: 5
show 'f', Options(count: 6)  # fmt: skip
shown := show
shown 'g', count: 7

class Shell
  log: String[] = default []
  run := (command: String, options: Options) -> @log.push("#{command}:#{options.count}")
shell := Shell()
shell.run 'h'
shell.run 'i', count: 8
print shell.log

struct Pair<T>
  first: T
  second: T?
pair := (label: String, p: Pair<Int>) -> print("#{label} #{p.first} #{p.second ? 0}")
pair 'j', first: 1
pair 'k', second: 3, first: 2

maybe := (o: Options?) -> print(o?.count ? 0)
maybe count: 9
maybe nil
