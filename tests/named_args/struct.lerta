# A last parameter of a struct type is constructed from the named arguments of the call, or from
# none where the call leaves it out; after a variadic parameter, named arguments alone give it.
struct Options
  cwd: String? = default nil
  count = default 1
  # Computed, so not an argument.
  twice = @count * 2

const run = (command: String, args: String..., options: Options) ->
  print "#{command} #{args} #{options.cwd ? '-'} #{options.count} #{options.twice}"

run 'a'
run 'b', 'x', 'y', cwd: '/tmp'
const xs = ['p', 'q']
run 'c', xs..., count: 3

const show = (name: String, options: Options) -> print("#{name} #{options.count}")
show 'd'
show 'e', count: 5
show 'f', Options(count: 6)
const shown = show
shown 'g', count: 7

class Shell
  log: String[] = default []
  run = (command: String, options: Options) -> @log.push("#{command}:#{options.count}")
const shell = Shell()
shell.run 'h'
shell.run 'i', count: 8
print shell.log

struct Pair<T>(first: T, second: T? = default nil)
const pair = (label: String, p: Pair<Int>) -> print("#{label} #{p.first} #{p.second ? 0}")
pair 'j', first: 1
pair 'k', second: 3, first: 2

const maybe = (o: Options?) -> print(o?.count ? 0)
maybe count: 9
maybe nil
