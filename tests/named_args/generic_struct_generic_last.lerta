# A generic function takes no named arguments for a last struct parameter whose type names a type
# parameter, as instances may differ in it.
struct Options<T>
  value: T?
f := <T>(x: T, o: Options<T>) -> x
f 1, value: 2
anonymous := <T>(x: T, o: { n: Int, m: T }) -> x
anonymous 1, n: 2, m: 3
class Box<T>
  args
    item: T
  put := <U>(u: U, o: Options<T>) -> u
box := Box(1)
box.put 'a', value: 2
box.put 'a'
