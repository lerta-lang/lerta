# Each instance of a generic function constructs the struct of its own parameter.
struct O
  n = default 1
struct P
  n = default 2
left_out := <T>(f: (T) -> Int) -> f()
named := <T>(f: (T) -> Int) -> f(n: 5)
print [left_out((o: O) -> o.n), left_out((p: P) -> p.n)]
print [named((o: O) -> o.n), named((p: P) -> p.n + 1)]

struct B<T>
  value: T
  extra: T? = default nil
maybe := (b: B<Int>?) -> b == nil then 0 else b.value + (b.extra ? 0)
print [maybe(value: 2), maybe(value: 1, extra: 3)]
