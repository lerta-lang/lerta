# The calls in a body that the instances of a generic function share pass their arguments as each
# instance checks them: packed for a variadic parameter, gathered into a struct, and named alone.
struct Scale
  by := default 1
total := (first: Int, rest: Int..., options: Scale) -> (first + rest.sum()) * options.by
struct Box<T>
  value: T
unbox := (box: Box<Int>) -> box.value
struct P
  x: Int
  y: Int

each := <T: Stringable>(value: T) ->
  x := 1
  y := 2
  print [total(1), total(1, 2, 3, by: 10), total(x, [y, 3]..., by: 2)]
  print value
  print unbox(value: 7)
  p := P(x, y)
  print [p.x, p.y]
each 1
each 'a'
