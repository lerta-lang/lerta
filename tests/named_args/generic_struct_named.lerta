# A generic function or method takes named arguments for a last parameter of a struct type that is
# not generic, as any function does, and leaves it out unless it is optional.
struct Options
  count := 1

repeat := <T>(x: T, o: Options) -> [x for _ in 0..o.count]
print repeat('a', count: 2)
print repeat(3)

maybe := <T>(x: T, o: Options?) -> o then [x for _ in 0..o.count] else [x]  # fmt: skip
print maybe(true, count: 3)

struct Limits<T>
  most: T?

clamp := <T>(x: T, limits: Limits<Int>) -> (x, limits.most)
print clamp('d', most: 4)

class Box<T>
  args
    item: T
  fill := <U>(other: U, o: Options) -> [(@item, other) for _ in 0..o.count]

print Box(1).fill('b', count: 2)
print Box(1).fill('c')

extend Int
  paired := <U>(other: U, o: Options) -> [(@, other) for _ in 0..o.count]

print 5.paired('e', count: 2)
print 5.paired('f')
