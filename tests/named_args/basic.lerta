const draw = (label: String, at: { x: Int, y: Int }) -> "#{label} at #{at.x},#{at.y}"
const options = (o: { verbose: Bool, name: String? }) -> o.verbose then o.name ? '-' else 'quiet'

class Canvas
  count = 0
  plot = (p: { x: Int, y: Int }) -> @count += p.x + p.y

print draw('a', x: 1, y: 2)
print draw('b', y: 4, x: 3)
print options(verbose: true, name: nil)
print options(verbose: true, name: 'n')
const canvas = Canvas()
canvas.plot x: 1, y: 1
# fmt: off
canvas.plot(
  x: 2
  y: 3
)
# fmt: on
print canvas.count
const moved = (d: { dx: Int }) -> d.dx * 2
print moved(dx: 5)
