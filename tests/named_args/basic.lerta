const draw = (label: String, at: { x: Int, y: Int }): String -> "#{label} at #{at.x},#{at.y}"
const options = (o: { verbose: Bool, name: String? }): String -> o.verbose then o.name ? '-' else 'quiet'

class Canvas
  var count = 0
  plot = (p: { x: Int, y: Int }) ->
    @count += p.x + p.y

print draw('a', x: 1, y: 2)
print draw('b', y: 4, x: 3)
print options(verbose: true, name: nil)
print options(verbose: true, name: 'n')
const canvas = Canvas()
canvas.plot(x: 1, y: 1)
canvas.plot(
  x: 2
  y: 3
)
print canvas.count
const moved = (d: { dx: Int }): Int -> d.dx * 2
print moved(dx: 5)
