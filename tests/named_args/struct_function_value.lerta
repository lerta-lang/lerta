# A function value whose last parameter is a struct may leave it out or give it by name.
struct Options(count = default 1)

const variadic = (xs: Int..., options: Options) -> xs.length + options.count
const v = variadic
print v([2])
print v([2], count: 5)

const apply = (f: (Int, Options) -> Int) -> [f(2), f(2, count: 3)]
print apply((x, options) -> x * options.count)
