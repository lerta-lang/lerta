# A function value whose last parameter is a struct may leave it out or give it by name.
struct Options
  count := default 1

variadic := (xs: Int..., options: Options) -> xs.length + options.count
v := variadic
print v([2])
print v([2], count: 5)

apply := (f: (Int, Options) -> Int) -> [f(2), f(2, count: 3)]
print apply((x, options) -> x * options.count)
