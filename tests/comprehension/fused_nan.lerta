# A local that may hold a NaN, which the functions of a lazy comprehension read in place, throws
# where they use it, as where the closures would capture it.
f := (big: Float) ->
  nan := big * big - big * big
  try
    print x for x in (nan * 0.0 + 1.0 for _ in 0..2)
  catch e: ArithmeticError
    print "caught: #{e.message}"
  try
    print x for x in (i for i in 0..2 when nan < 1.0)
  catch e: ArithmeticError
    print "guard caught: #{e.message}"
f 1e300
