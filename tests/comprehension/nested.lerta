xs := [1, 2, 3]
ys := ['a', 'b']
print ["#{x}#{y}" for x in xs for y in ys]
print [x * y for x in xs when x != 2 for y in xs when y > x]
print [(x, y, z) for x in 0..2 for y in 0..2 for z in 0..2 when x + y + z == 1]
rows := [[1, 2], [3], []]
print [item for row in rows for item in row]
print ["#{i}:#{j}:#{v}" for row at i in rows for v at j in row]
pairs := [(1, [10, 20]), (2, [30])]
print [k + v for (k, vs) in pairs for v in vs]
names: String[] = [s for s in ys for _ in 0..2]
print names
bytes: Byte[] = [1 for _ in xs for _ in ys]
print bytes
none: Int[][]
print [x for row in none for x in row]
words := ['ab', 'c']
print [c for word in words when word.count() > 1 for c in word]
print [0, [x * y for x in xs for y in xs when y > x]..., 9]
adders := [-> x * 10 + y for x in xs for y in xs when x == y]
print [add() for add in adders]
print [x for x in xs for x in [x * 10]]
maybe: Int?[] = [1, nil]
print [x + y for x in maybe for y in xs when x and y == x]
print pair for pair in [(x, y) for x in xs for y in xs when x < y]
print [x + y for x in xs for y in xs].sum()
print [x + n for x in xs for n in (x * 10 for _ in 0..2)]
