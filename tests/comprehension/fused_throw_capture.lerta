# A for over filter given a function literal that throws while it captures a local, which the loop's
# function still holds after the exception.
f := (n: Int) ->
  label := "x#{n}"
  try
    for y in [1, 2].filter((x) ->
      throw ValueError(label) if x > 1
      true
    )
      print y
  catch e: ValueError
    print e.message
  print label

f 1
