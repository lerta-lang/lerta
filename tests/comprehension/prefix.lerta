# A comprehension written with its `for` first: the block's statements, `at`, `when` and the item
# taken apart; `continue` and `break`; a `return` from the function; a `for` that ends the block,
# whose elements it takes; and in parentheses, an Iter.
pairs := [('a', 1), ('b', 2), ('c', 3), ('d', 4)]
labels := [
  for (key, value) at i in pairs when value != 2
    label := key + key
    "#{i}:#{label}=#{value}"
]
print labels
odd_until_five := [
  for n in 1..10
    continue if n % 2 == 0
    break if n > 5
    n
]
print odd_until_five
first_large := (items: Int[]) ->
  kept := [
    for item in items
      return item if item > 2
      item
  ]
  kept.length
print [first_large([1, 5, 2]), first_large([1, 2])]
grid := [
  for row in 1..=2
    for column in ['x', 'y']
      continue if row == 2 and column == 'y'
      "#{column}#{row}"
]
print grid
lazy := (
  for n at i in [10, 20, 30, 40, 50] when n != 20
    break if n == 50
    n + i
)
print lazy.to_array()
nested_lazy := (
  for a in [1, 2]
    for b in [3, 4]
      a * b
)
print nested_lazy.to_array()
inner_return := (rows: Int[][]) ->
  flat := [
    for row in rows
      limit := row.length
      for cell in row
        return -cell if cell > 8
        break if cell > limit
        cell
  ]
  inner := [
    for row in rows
      sizes := [
        for cell in row
          return 100 if cell == 7
          cell
      ]
      sizes.length
  ]
  flat.length * 10 + inner.length
print [inner_return([[1, 5, 2], [9]]), inner_return([[1, 2], [3]]), inner_return([[7]])]
first_long := (words: String?[]) ->
  shouted := [
    for word in words when word != nil
      loud := word + '!'
      return loud if loud.count() > 4
      loud
  ]
  shouted.join(' ')
print [first_long(['ab', nil, 'cd']), first_long(['ab', 'long'])]
evens := (
  for n in 1..=6
    continue if n % 2 == 1
    n
)
print evens.to_array()
entries := [
  for row in [[('a', 1), ('b', 2)], [('c', 3)]]
    for (key, value) at j in row
      "#{key}#{value * 10 + j}"
]
print entries
var total = 0.5
scaled := [
  for n in [1, 2]
    total = total * 2.0
    total + n.to_float()
]
print "#{scaled} #{total}"
makers := (
  for n in [1, 2]
    give := ->
      return n * 3
    give()
)
print makers.to_array()
