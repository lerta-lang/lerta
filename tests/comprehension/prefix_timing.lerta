# An Iter comprehension with its `for` first evaluates its iterable where it is, as one on a line
# does, whether its block is one value or holds statements, and a range's bounds and step too; its
# block runs for each item as the Iter is consumed.
source := (name: String) ->
  print "#{name}: source"
  [1, 2]
bound := (name: String, value: Int) ->
  print "#{name}: bound #{value}"
  value
on_line := (x * 2 for x in source('on a line'))
one_value := (
  for x in source('one value')
    x * x + 1
)
with_statements := (
  for x in source('with statements')
    print "with statements: element #{x}"
    x * 2
)
ranged := (
  for n in bound('ranged', 1)..=bound('ranged', 3) by bound('ranged', 2)
    print "ranged: element #{n}"
    n
)
nested := (
  for a in source('nested')
    for b in [10, 20]
      a + b
)
print 'made'
print on_line.to_array()
print one_value.to_array()
print with_statements.to_array()
print ranged.to_array()
print nested.to_array()
for round in 1..=2
  placed := (
    for word at i in ['a', 'b'] when i < round
      label := word + word
      "#{round}.#{i}:#{label}"
  )
  print placed.to_array()
ages := Map([('ann', 3), ('bo', 5)])
described := (
  for (name, age) in ages
    older := age + 1
    "#{name}:#{older}"
)
print described.to_array()
counted := (
  for n in 1..bound('exclusive', 4)
    continue if n == 2
    n
)
print counted.to_array()
class Shelf
  args
    items: Int[]

  doubled := ->
    (
      for item in @items
        twice := item * 2
        twice
    )
print Shelf([1, 2]).doubled().to_array()
