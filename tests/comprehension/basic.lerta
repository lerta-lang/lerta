const show = (xs: Array<Int>): String -> [x.to_string() for x in xs].join(',')

print show([x * x for x in 0...5])
print show([x for x in [5, 6, 7, 8] when x % 2 == 0])
const names: Array<String?> = ['ann', nil, 'bob']
print [name + '!' for name in names when name].join(' ')
const empty: Array<Int> = []
const offsets = [x + 1 for x in empty]
print offsets.length
const nested = [[y for y in 0...x] for x in 1...4]
print nested[2].length
const base = 10
const shifted = (xs: Array<Int>): Array<Int> -> [x + base for x in xs]
print show(shifted([1, 2]))
print x for x in [1, 2, 3] when x != 2
var total = 0
total += x for x in 0...4
print total
const words = [
  word + '?'
  for word in ['a', 'b']
]
print words.join('')
