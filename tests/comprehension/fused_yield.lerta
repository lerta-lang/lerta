# A for over map given a function literal that yields, which is not taken in place: each item is the
# Iter of its own call.
xs := [1, 2, 3]
print it.next() for it in xs.map((x) -> yield x)
# One whose source is a map that a loop can take in place.
print it.next() for it in xs.map((x) -> x * 10).map((x) -> yield x)
