# A lazy comprehension that a loop does not go through in place keeps its Iter, and gives the same
# items: one that captures weakly, one with bindings, and a for with an index over one. A guard that
# throws, in a loop that calls it in place, is caught as from the Iter.
class Box
  args
    n: Int
  weakly := ->
    weak me := @
    [x for x in (i + (me?.n else 0) for i in 0..3)]

print Box(2).weakly()
print x for x in (a + b for (a, b) in [(1, 2), (3, 4)])
print "#{place}: #{x}" for x at place in (i * 2 for i in 0..3)

failing := (x: Int) ->
  throw ValueError('guard') if x == 1
  true
try
  print x for x in (i for i in 0..3 when failing(i))
catch e: ValueError
  print "caught #{e.message}"
