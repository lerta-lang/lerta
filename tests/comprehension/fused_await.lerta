# A for over map given a function literal that awaits, or settles its Promise without awaiting,
# which is not taken in place: each item is the Promise of its own call.
import Deferred from 'std:async'

d := Deferred<Int>()
d.resolve 5
xs := [1, 2, 3]
print await y for y in xs.map((x) -> x + await d.promise())
# fmt would leave out the type of `x`, which a literal with a result type needs.
# fmt: skip
print await y for y in xs.map((x: Int): Promise<Int> -> x * 2)
