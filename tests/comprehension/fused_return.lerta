# A for over map and filter given a function literal with a return, which ends the literal's call,
# not the loop's function, and releases what the literal holds.
class Noisy
  name: String
  deinit = -> print("drop #{@name}")

f := ->
  print y for y in [1, 2, 3].map((x) ->
    noisy := Noisy("n#{x}")
    return x * 10 if x > 1 and not noisy.name.is_empty()
    x
  )
  print y for y in [1, 2, 3].filter((x) ->
    return false if x == 2
    true
  )
  print 'end'

f()
