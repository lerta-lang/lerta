make := -> ['a' + 'b', 'c']
offset: Int? = 5
print [x + offset for x in [1, 2] when offset][1]
print [y + 'q' for y in make()].join(',')
maybes: String?[] = [nil for x in 0..2]
print maybes.length
first_long := (groups: String[][]): String[] ->
  for group in groups
    continue if group.is_empty()
    break if group[0] == 'stop'
    return [word + '!' for word in group]
  []
print first_long([[], ['hi', 'yo']]).join(' ')
print first_long([['stop']]).length
print x for x in [1, 2, 3] if true  # fmt: skip
var n = 0
n += 1 for x in [1, 2] while n < 1  # fmt: skip
print n
lambdas := [(a: Int) -> a + x for x in [1, 2]]
print lambdas[1](10)
