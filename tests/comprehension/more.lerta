const make = (): Array<String> -> ['a' + 'b', 'c']
const offset: Int? = 5
print [x + offset for x in [1, 2] when offset][1]
print [y + 'q' for y in make()].join(',')
const maybes: Array<String?> = [nil for x in 0...2]
print maybes.length
const first_long = (groups: Array<Array<String>>): Array<String> ->
  for group in groups
    continue if group.length == 0
    break if group[0] == 'stop'
    return [word + '!' for word in group]
  []
print first_long([[], ['hi', 'yo']]).join(' ')
print first_long([['stop']]).length
print x for x in [1, 2, 3] if true
var n = 0
n += 1 for x in [1, 2] while n < 1
print n
const lambdas = [(a: Int): Int -> a + x for x in [1, 2]]
print lambdas[1](10)
