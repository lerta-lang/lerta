# A for over a lazy comprehension goes through its source, calling the guard and the element in
# place for each item, as the Iter would: over a range, an array, a function that yields and
# another lazy comprehension; with a break, a continue and a return in the loop's body; with a var
# that the body changes and the functions read; with @ in a method; and the loop's names are its
# own where the comprehension's variable has the same.
class Noisy
  name: String
  deinit = -> print("drop #{@name}")

numbers := (n: Int) -> yield i for i in 0...n

print x for x in (i * i for i in 0...4 when i != 2)
print word for word in (w + '!' for w in ['a', 'b'])
print x for x in (i + 1 for i in numbers(3))
print x for x in (j * 10 for j in (i + 1 for i in 0...3) when j > 1)

for name in (n.name for n in [Noisy('first'), Noisy('second')])
  print name
  break
print 'after break'

for x in (i for i in 0...5 when i % 2 == 0)
  continue if x == 2
  print "kept #{x}"

first_big := ->
  for x in (i * 3 for i in 0...10)
    return x if x > 10
  0
print first_big()

var limit = 2
for x in (i for i in 0...6 when i < limit)
  print "under #{limit}: #{x}"
  limit += 1

class Scaled
  factor: Int
  values = -> [x for x in (i * @factor for i in 0...3)]
print Scaled(factor: 5).values()

i := 'the loop'
print "#{x}, #{i}" for x in (i for i in 0...2)
