# An exception that the block of an Iter comprehension with its `for` first throws, in a loop that
# takes its function in place, has the trace that it has through the Iter.
numbers := (n: Int) -> yield i for i in 0..n
check := (x: Int) ->
  throw ValueError('bad') if x == 2
  x

f := ->
  checked := (
    for x in numbers(5)
      y := check(x)
      y
  )
  print value for value in checked
f()
