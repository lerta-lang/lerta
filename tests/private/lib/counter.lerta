export class Counter
  label: String
  private var count = 0
  private log: String[] = []
  private weak previous: Counter? = nil

  step := (by: Int) ->
    @count += by
    @note "#{@label} +#{by}"
    @count

  private note := (text: String) -> @log.push(text)
  private apply := <T>(f: (Int) -> T): T -> f(@count)
  private on_step: () -> Int = -> 1

export struct Secret
  name: String
  private key := 'k'

export interface Counted
  count: Int
