export class Counter
  args
    label: String
  private
    var count = 0
    log: String[] = []
    weak previous: Counter? = nil

  step := (by: Int) ->
    @count += by
    @note "#{@label} +#{by}"
    @count

  private
    note := (text: String) -> @log.push(text)
    apply := <T>(f: (Int) -> T): T -> f(@count)
    on_step: () -> Int = -> 1

export class Secret
  args
    name: String
  private key := 'k'

export interface Counted
  count: Int
