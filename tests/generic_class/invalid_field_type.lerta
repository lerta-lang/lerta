import count from './lib/invalid_instance'
class Box<T>
  items: T[] = []
  put := (v: T) -> @items.push(v)

class Table<K, V>
  entries: Map<K, V> = Map()

class Node<T>
  next: Node<T>? = nil
  values: T[] = []

class Outer<T>
  inner: Box<T>? = nil

struct Holder<T>
  item: T
  items: T[] = []

maybe_int: Int? = 1
maybe_bool: Bool? = true
written: Box<Int?>? = nil
again := Box<Int?>()
nested := (b: Box<Box<Float?>>) -> b.items.length
inferred := Holder(item: maybe_int)
keys := Table<Int?, Int>()
values := Table<Int, Bool?>()
funcs := Table<() -> void, Int>()
node := Node<Int?>()
outer := Outer<Byte?>()
g := <T>(x: T) -> Box<T>()
g maybe_bool
fine := Box<Int>()
holder := Holder(item: 'a')
type Floats = Node<Float?>
type Strings = Table<Int, String?>
boxes := (): Box<Holder<Byte?>>[] -> []
print fine.items.length + holder.items.length
