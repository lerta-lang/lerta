import count from './lib/invalid_instance'
class Box<T>
  items: T[] = []
  put = (v: T) -> @items.push v

class Table<K, V>
  entries: Map<K, V> = Map()

class Node<T>
  next: Node<T>? = nil
  values: T[] = []

class Outer<T>
  inner: Box<T>? = nil

struct Holder<T>
  item: T
  items: T[] = []

const maybe_int: Int? = 1
const maybe_bool: Bool? = true
const written: Box<Int?>? = nil
const again = Box<Int?>()
const nested = (b: Box<Box<Float?>>) -> b.items.length
const inferred = Holder(item: maybe_int)
const keys = Table<Int?, Int>()
const values = Table<Int, Bool?>()
const funcs = Table<() -> void, Int>()
const node = Node<Int?>()
const outer = Outer<Byte?>()
const g = <T>(x: T) -> Box<T>()
g maybe_bool
const fine = Box<Int>()
const holder = Holder(item: 'a')
type Floats = Node<Float?>
type Strings = Table<Int, String?>
const boxes = (): Box<Holder<Byte?>>[] -> []
print fine.items.length + holder.items.length
