# Instances of generic classes and structs run init and deinit, may refer to themselves, satisfy
# interfaces, compare by contents and are members of unions.
class Node<T>
  value: T
  next: Node<T>?
  init := -> print("made #{@value}")
  deinit := -> print("freed #{@value}")
  describe := (): String -> "node #{@value}"

struct Box<T>
  value: T

extend<T> Box<T>
  get := (): T -> @value

interface Describable
  describe: () -> String

show := <X: Describable>(x: X) -> print(x.describe())
wrap := <T>(value: T): Box<T> -> Box(value)

n := Node(value: 1, next: Node(value: 2, next: nil))
show n
print wrap('x').get()
print Box(1) == { value: 1 }
counts: Map<Box<Int>, Int> = { { value: 3 }: 1 }
print counts[{ value: 3 }] ? 0
d: Describable = Node(value: 'v', next: nil)
print d.describe()
either: Box<Int> | Box<String> = Box('b')
print either is Box<String>

# A generic method of a generic class takes the class's type arguments and its own.
class Stack<T>
  items: T[] = []
  push := (item: T) -> @items.push(item)
  map := <R>(f: (T) -> R): Stack<R> ->
    mapped := Stack<R>()
    mapped.push f(item) for item in @items
    mapped
numbers := Stack<Int>()
numbers.push 4
print numbers.map((x) -> "#{x}!").items[0]
