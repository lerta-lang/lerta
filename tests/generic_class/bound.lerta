class Least<T: Comparable>
  item: T
  offer = (other: T) -> @item = other if other < @item

# A bound may name the other type parameters.
struct Source<T, I: Iterable<T>>
  items: I
  first = (): T? -> @items.iter().next()

interface Named
  name: () -> String

struct Labeled<T: Named>
  item: T
  label = -> "<#{@item.name()}>"

# An extend may give what a bound asks for.
extend Int
  name = -> "number #{@}"

least: Least<Int> = Least(item: 3)
least.offer n for n in [5, 1, 2]
print least.item

print Labeled(item: 7).label()

# Written before the extends are in effect.
struct Tagged
  labeled: Labeled<Int>

print Tagged(labeled: { item: 8 }).labeled.label()

print Source<String, String[]>(items: ['a', 'b']).first()!
