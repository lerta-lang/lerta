# A generic class or struct has an instance for each set of type arguments, written or inferred.
class Stack<T>
  items: T[] = []
  push = (item: T) -> @items.push(item)
  pop = (): T -> @items.pop()
  size = -> @items.length

struct Pair<A, B>(first: A, second: B)

s := Stack<Int>()
s.push 1
s.push 2
print s.pop()
print s.size()
p := Pair(first: 1, second: 'a')
print p.second
words: Stack<String> = Stack()
words.push 'w'
print words.pop()
