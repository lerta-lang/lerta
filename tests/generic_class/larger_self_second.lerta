# A type argument that holds a type parameter in a larger type is no error where it leads back to
# no instance: the B of a Pair holds no Pair, so Pair<Int, Int[]> holds a Pair<Int, Int[]> again.
struct Pair<A, B>
  first: A
  more: Pair<A, A[]>?
inner := Pair<Int, Int[]>(first: 2, more: nil)
print Pair<Int, String>(first: 1, more: inner).more!.first
