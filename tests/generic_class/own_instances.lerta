# A member of a generic class or struct may be of an instance of it whose type arguments are its
# type parameters alone, in any order, or hold none of them.
class Node<T>
  value: T
  next: Node<T>?
  cache: Node<Int>?
  size = (): Int -> @next == nil then 1 else 2
  # A method's own type parameter may be in a larger instance: the method has an instance for each.
  count = <U>(items: Node<U[]>): Int -> items.value.length
  # A local's type in a method's body is not a member's: the instance is made only if it is used.
  unused = ->
    deeper: Node<Node<T>>? = nil
    print deeper == nil

struct Pair<A, B>
  first: A
  second: B
  swap = (): Pair<B, A> -> Pair(first: @second, second: @first)

node := Node(value: 'a', next: Node(value: 'b'))
print node.size()
print node.count(Node(value: [1, 2]))
node.unused()
pair := Pair(first: 1, second: 'one').swap()
print pair.first
print pair.swap().first
