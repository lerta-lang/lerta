# A generic struct of another module, whose initializer uses its type parameter.
import Box from './lib/box'
box := Box(value: 'a')
print box.items.length
ints: Box<Int> = Box(value: 2)
print ints.items[1]

# An imported generic class with a deinit, of a class of this module.
import Holder from './lib/holder'
class Local
  name = 'local'
held := Holder(value: Local())
print held.value.name
