# The value of a destructuring may take the lines below its `=`, as that of a declaration.
pair := -> (1, 2)

(a, b) :=
  try
    pair()
  catch e
    (0, 0)
print a + b
{ x, y } :=
  case a
    when 1 then { x: 3, y: 4 }
    else { x: 0, y: 0 }
print x * y
var { p, q } =  # fmt: skip
  p: 5
  q: 6
p += q
print p
