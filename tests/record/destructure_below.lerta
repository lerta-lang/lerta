# The value of a destructuring may take the lines below its `=`, as that of a declaration.
const pair = -> (1, 2)

const (a, b) =
  try
    pair()
  catch e
    (0, 0)
print a + b
const { x, y } =
  case a
    when 1 then { x: 3, y: 4 }
    else { x: 0, y: 0 }
print x * y
var { p, q } =
  p: 5
  q: 6
p += q
print p
