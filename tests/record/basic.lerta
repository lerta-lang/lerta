struct Point
  x: Int
  y: Int

divide := (a: Int, b: Int): { quotient: Int, remainder: Int } ->
  { quotient: a / b, remainder: a % b }

name_and_age := (): { name: String, age: Int? } -> { name: 'ann', age: nil }

result := divide(17, 5)
print result.quotient
print result.remainder
{ quotient, remainder } := divide(9, 4)
print quotient + remainder
person := name_and_age()
print person.name
print person.age else -1
