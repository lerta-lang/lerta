struct Point(x: Int, y: Int)

const divide = (a: Int, b: Int): { quotient: Int, remainder: Int } ->
  { quotient: a / b, remainder: a % b }

const name_and_age = (): { name: String, age: Int? } -> { name: 'ann', age: nil }

const result = divide(17, 5)
print result.quotient
print result.remainder
const { quotient, remainder } = divide(9, 4)
print quotient + remainder
const person = name_and_age()
print person.name
print person.age ? -1
const x = 3
const y = 4
const pair = { y, x }
const same: { x: Int, y: Int } = pair  # fmt: skip
print same.x * 10 + same.y
const nested = { inner: { text: 'deep' }, items: [1, 2] }
print nested.inner.text
print nested.items.length
const records = [{ n: 1 }, { n: 2 }]
var total = 0
total += record.n for record in records
print total
