# A name alone for a field may be on a line of its own, the first too, as may a field after `{`.
x := 1
y := 2
record := {  # fmt: skip
  x
  y
  z: 3
}
print record.x + record.y + record.z

# So may the first field after `{` inside the brackets of a call.
sum := (r: { a: Int, b: Int }) -> r.a + r.b
# fmt: skip
print sum(
  {
    a: 1
    b: 2
  }
)
