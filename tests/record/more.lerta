import make_pair, Pair from './lib/pairs'

# fmt: skip
point :=
  x: 1
  y: 2
print point.x + point.y
by_name: Map<String, { age: Int }> = { 'ann': { age: 31 } }
print by_name['ann']!.age
maybe: { a: Int? }? = { a: nil }
print maybe then (maybe.a else 0) else -1
offset := { dx: 10 }
shift := (x: Int) -> x + offset.dx
print shift(1)
nested: { outer: { b: Int, c: Int } } = { outer: { c: 3, b: 2 } }
print nested.outer.b * 10 + nested.outer.c
pair: Pair = make_pair(4)
print pair.first + pair.second
var total = 0
for item in [{ n: 1, m: 2 }, { m: 3, n: 4 }]
  { n, m } := item
  total += n * m
print total
calc := { twice: (x: Int) -> x * 2 }
print calc.twice(21)
