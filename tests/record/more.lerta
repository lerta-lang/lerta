import { make_pair, Pair } from './lib/pairs'

const point = {
  x: 1
  y: 2
}
print point.x + point.y
const by_name: Map<String, { age: Int }> = { 'ann': { age: 31 } }
print by_name['ann']!.age
const maybe: { a: Int? }? = { a: nil }
print maybe then maybe.a ? 0 else -1
const offset = { dx: 10 }
const shift = (x: Int): Int -> x + offset.dx
print shift(1)
const nested: { outer: { b: Int, c: Int } } = { outer: { c: 3, b: 2 } }
print nested.outer.b * 10 + nested.outer.c
const pair: Pair = make_pair(4)
print pair.first + pair.second
var total = 0
for item in [{ n: 1, m: 2 }, { m: 3, n: 4 }]
  const { n, m } = item
  total += n * m
print total
const calc = { twice: (x: Int): Int -> x * 2 }
print calc.twice(21)
