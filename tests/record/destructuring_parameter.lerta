struct Point
  x: Int
  y: Int

points: Point[] = [{ x: 1, y: 2 }, { x: 3, y: 4 }]
print points.map(({ x, y }) -> x * y).to_array()
print [(1, 'a'), (2, 'b')].map(((k, v)) -> "#{v}#{k}").to_array()
x_of := ({ x }: Point) -> x
print x_of({ x: 9, y: 0 })
second := ((_, b): (Int, Int), scale: Int) -> b * scale
print second((1, 2), 10)
sum := ({ x, y }: Point): Int? -> x + y
print sum({ x: 1, y: 2 })!
mixed := ((a, b): (Int, Int), { y }: Point, c: Int) -> a + b + y + c
print mixed((1, 2), { x: 0, y: 3 }, 4)
adder := (p: Point) -> ({ x }: Point) -> x + p.y
print adder({ x: 0, y: 5 })({ x: 1, y: 0 })
