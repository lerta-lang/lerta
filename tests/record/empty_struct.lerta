# An anonymous struct of no fields, and `{}` where a struct whose fields all have defaults is
# expected.
struct Defaults
  size := default 1

nothing := (r: {}) -> r

empty := {}
assert empty == {}
typed: {} = {}
assert nothing(typed) == empty
assert [{}, {}].length == 2
maybe: {}? = nil
assert maybe == nil
spread := { empty..., size: 2 }
assert spread.size == 2
either: Map<String, Int> | {} = {}
assert either is {}
defaults: Defaults = {}
assert defaults.size == 1
print defaults.size
