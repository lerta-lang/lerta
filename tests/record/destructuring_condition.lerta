struct Point
  x: Int
  y: Int

point_of := (n: Int): Point? -> n > 0 then { x: n, y: n * 2 }  # fmt: skip
pair_of := (n: Int) -> n > 0 then (n, "#{n}")

print x + y if { x, y } := point_of(3)
if { x } := point_of(0)
  print x
else
  print 'no point'
print "#{count} #{text}" if (count, text) := pair_of(4)
var n = 2
while (_, text) := pair_of(n)
  print text
  n -= 1
print y if { y } := point_of(5)
var left = 2
take := ->
  left -= 1
  left >= 0 then (left, 'taken')
print text while (_, text) := take()
pairs := [(1, 2), (3, 4)]
var i = 0
while (first, second) := pairs.get(i)
  print first + second
  i += 1
