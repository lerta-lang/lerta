# A spread of a class or struct into a construction of its type, or into a record where it is
# expected, gives the arguments not written, read from it, and the fields that are no arguments are
# computed again; a class gives a new object. A spread of an anonymous struct into one gives a new
# anonymous struct of its fields and those written, which may take other types.
struct Point
  x: Int
  y: Int
  label = default 'p'
  sum = @x + @y

class Box
  size: Int
  name: String
  var opened = false

struct Pair<T>(first: T, second: T)

p := Point(x: 1, y: 2)
q := Point(p..., x: 10)
print [q.x, q.y, q.sum]
print q.label
moved: Point = { p..., y: 20 }
print moved.y
b := Box(size: 1, name: 'a')
b.opened = true
c := Box(b..., name: 'c')
print [c.size, b.size]
print c.name
print c.opened
pair := Pair(first: 1, second: 2)
print Pair(pair..., second: 5).second
r := { a: 1, b: 'x' }
s := { r..., b: 2.5, c: true }
print [s.a]
print [s.b]
print [s.c]
holder := { point: p }
print Point(holder.point..., y: 0).x
shift := (point: Point): Point -> { point..., x: point.x + 1 }
print shift(p).x
long := Point  # fmt: skip
  p...
  y: 7
print long.y
