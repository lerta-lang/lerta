# A spread in a generic function, of `@` and of a field of `@`, of a local narrowed from an
# optional, alone, into an optional struct expected, as the first line of a block, of `@` of a
# class, into an anonymous struct type expected, and with type arguments written.
struct Pair<T>
  first: T
  second: T

swap := <T>(pair: Pair<T>) -> Pair(pair..., first: pair.second, second: pair.first)

struct Point
  x: Int
  y: Int
  moved := (by: Int) -> Point(@..., x: @x + by)

class Line
  args
    start: Point
    end: Point
  shifted := -> Point(@start..., y: @end.y)
  reversed := -> Line(@..., start: @end, end: @start)

print swap(Pair(first: 1, second: 2)).first
print swap(Pair(first: 'a', second: 'b')).first
p := Point(x: 1, y: 2)
print p.moved(4).x
print Line(start: p, end: { x: 0, y: 9 }).shifted().y
maybe: Point? = p
print Point(maybe..., y: 7).y if maybe
same := Point(p...)
copied: Point = { p... }
r := { a: 1 }
again := { r... }
print [same.y, copied.x, again.a]
optional: Point? = { p..., x: 8 }
print optional!.x
block: Point =  # fmt: skip
  p...
  x: 3
print block.x
line := Line(start: p, end: { x: 5, y: 6 })
print [line.reversed().start.x, line.start.x]
r2 := { a: 1, b: 2 }
typed: { a: Int, b: String } = { r2..., b: 's' }
print typed.b
pair := Pair(first: 3, second: 4)
print Pair<Int>(pair..., first: 0).second
