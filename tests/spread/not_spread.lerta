# A spread inside the brackets of an item, or on a line that continues one, does not make the item
# a spread: a map's key holding one, a field's value holding one, and a block's item continued by a
# call whose argument is one stay what they are.
# fmt: off
xs := [1, 2]
keyed := { [xs...].length: 'two' }
print keyed[2]!
inside := { a: [xs..., 3] }
print inside.a
f := (items: Int...) -> items.length
block :=
  first: f(xs...)
  second: 0
print block.first
g := (items: Int...) -> [item * 2 for item in items]
doubled: Int[] =
  g
    xs...
print doubled
