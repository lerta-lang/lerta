# The architecture of the short name of the host's target, by the triple that clang prints for it,
# after the host's system; none for an architecture that has no short name.
import target_name_of_host from '../../compiler/clang'

triples :=
  'x86_64-pc-linux-gnu'
  'i686-pc-linux-gnu'
  'aarch64-unknown-linux-gnu'
  'arm64-apple-darwin25.6.0'
  'armv7l-unknown-linux-gnueabihf'
  'armv6kz-unknown-linux-gnueabihf'
  'arm-unknown-linux-gnueabi'
  'armeb-unknown-linux-gnueabihf'
  'armebv7-unknown-linux-gnueabihf'
  'riscv64-unknown-linux-gnu'
for triple in triples
  architecture := target_name_of_host(triple)?.split('-')[1]
  print "#{triple}: #{architecture else 'none'}"
