# A Deferred's promise waits until resolve or reject settles it; the first of them settles it.
import Deferred from 'std:async'
import sleep from 'std:time'

const resolved = Deferred<Int>()
const later = ->
  await sleep(0.01)
  resolved.resolve 1
  resolved.resolve 2
  resolved.reject ValueError(message: 'too late')
const _resolving = later()
print await resolved.promise()

const rejected = Deferred<String>()
rejected.reject ValueError(message: 'refused')
rejected.resolve 'too late'
try
  print await rejected.promise()
catch error: ValueError
  print error.message

const optional = Deferred<String?>()
optional.resolve nil
print await optional.promise() == nil

const optional_int = Deferred<Int?>()
optional_int.resolve 3
print (await optional_int.promise())!

# promise() gives one promise, however many times it is asked for.
const twice = Deferred<Int>()
const first_ask = twice.promise()
twice.resolve 4
print await first_ask + await twice.promise()

# A Deferred that is never settled, or whose promise is never asked for, leaves nothing waiting.
const _unsettled = Deferred<Int>()
const unasked = Deferred<String>()
unasked.resolve 'unasked'

# nil settles a Deferred of an optional too, and a later value changes nothing.
const nil_first = Deferred<Int?>()
nil_first.resolve nil
nil_first.resolve 5
print await nil_first.promise() == nil
