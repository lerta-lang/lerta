# race cancels the promises that lose, timeout the promise that runs out of time, and all, race and
# timeout cancel the promises they were given once they are cancelled, with a value or without one.
import all, race, timeout, TimeoutError from 'std:async'
import sleep, time from 'std:time'

const started = time()
const slow = ->
  try
    await sleep(5)
    'slow'
  finally
    print 'slow cleaned up'
const slow_void = (): Promise ->
  try
    await sleep(5)
  finally
    print 'slow_void cleaned up'
const fast = ->
  await sleep(0.01)
  'fast'

print await race([slow(), fast()])
await race([slow_void(), sleep(0.01)])

try
  await timeout(slow(), 0.01)
catch error: TimeoutError
  print error.message
try
  await timeout(slow_void(), 0.01)
catch error: TimeoutError
  print error.message
print await timeout(fast(), 1)
await timeout(sleep(0.01), 1)
try
  await timeout(slow(), -1)
catch error: ValueError
  print error.message

# The error of one of all leaves the others going on.
const failing = (): Promise<String> ->
  await sleep(0.01)
  throw ValueError(message: 'failed')
const going_on = ->
  await sleep(0.3)
  'went on'
const others = going_on()
try
  await all([failing(), others])
catch error: ValueError
  print error.message
print await others

const cancelled = <T>(promise: Promise<T>) ->
  await sleep(0.01)
  promise.cancel()
  try
    await promise
    'settled'
  catch error: CancelledError
    error.message
print await cancelled(all([slow(), slow()]))
print await cancelled(race([slow(), slow()]))
print await cancelled(timeout(slow(), 5))
const waiting_all = -> await all([slow_void()])
print await cancelled(waiting_all())
print time() - started < 4
