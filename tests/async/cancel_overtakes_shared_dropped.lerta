# A rejection that a cancel overtook is given up for good once no other await takes it, though the
# program held the promise too: dropping it then ends nothing (see
# cancel_overtakes_shared_rejection).
import Deferred from 'std:async'

gate := Deferred<Int>()

failing := (): Promise<Int> ->
  await gate.promise()
  throw IOError('given up for good')

shared := failing()
awaiting := ->
  try
    await shared
    'resolved'
  catch error: CancelledError
    error.message

task := awaiting()
cancelling := ->
  await gate.promise()
  task.cancel()
cancelled := cancelling()
gate.resolve 0
await cancelled
print await task
