# A cancel reaches the deepest body that a promise waits for, which a CancelledError throws in,
# through its finally blocks, and stops the work it waits for; a promise cancelled and dropped ends
# nothing.
import Deferred from 'std:async'
import Buffer, read_file, write_file from 'std:io'
import run from 'std:process'
import monotonic, sleep from 'std:time'

started := monotonic()

outcome := <T: Stringable>(promise: Promise<T>) ->
  try
    "#{await promise}"
  catch error: CancelledError
    error.message

nap := (seconds: Float) ->
  try
    await sleep(seconds)
    'woke'
  finally
    print 'nap cleaned up'
inner := nap(5)
outer := -> await inner
waiting := outer()
await sleep(0.01)
waiting.cancel()
print await outcome(waiting)

# A body whose promise is settled but which has not resumed yet throws once it does.
gate := Deferred<Int>()
resuming := -> "#{await gate.promise()}"
late := resuming()
gate.resolve 1
late.cancel()
print await outcome(late)

# So does one whose promise is rejected, the error of which is dropped then.
failing_gate := Deferred<Int>()
failing := -> "#{await failing_gate.promise()}"
failed := failing()
failing_gate.reject ValueError('failed')
failed.cancel()
print await outcome(failed)

deferred := Deferred<Int>()
deferred_promise := deferred.promise()
deferred_promise.cancel()
print await outcome(deferred_promise)

write_file('big.txt', b'x').cancel()
await write_file('a.txt', b'a')
reading := -> (await read_file('a.txt')).length
read := reading()
read.cancel()
print await outcome(read)

# A body may take the CancelledError and give a value; a second cancel finds it settled.
stubborn := ->
  try
    await sleep(5)
    'slept'
  catch _: CancelledError
    'stayed'
staying := stubborn()
staying.cancel()
staying.cancel()
print await outcome(staying)

# A promise that two bodies await is cancelled for both.
shared := nap(5)
first := -> await shared
second := -> await shared
first_waiting := first()
second_waiting := second()
first_waiting.cancel()
print await outcome(first_waiting)
print await outcome(second_waiting)

# The wait of a program that captures its output may be cancelled.
capturing := -> (await run('print_after', '0', 'captured', stdout: Buffer())).code
captured := capturing()
captured.cancel()
print await outcome(captured)
await sleep(0.5)

# Settled and resumed ones are not changed.
done := nap(0)
print await done
done.cancel()
print await outcome(done)

sleep(5).cancel()
print monotonic() - started < 4

# The program run is stopped, and the wait for it ends once it has, before it would print.
exit_code := -> (await run('print_after', '1', 'printed')).code
running := exit_code()
running.cancel()
print await outcome(running)
