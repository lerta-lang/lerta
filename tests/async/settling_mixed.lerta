# A function that returns a Promise without awaiting either returns Promises or settles it, as its
# first result tells, and the results after it must agree. One that returns Promises must end with
# one, and a Promise that an arm of its last statement, an `if`, a `case` or a `try`, gives is not
# dropped when it settles. A
# function value converts to one that returns a Promise only with the same parameters.
import sleep from 'std:time'

pick := (wait: Bool): Promise ->
  return sleep(0.01) if wait
  print 'no wait'

name := (wait: Bool): Promise<String> ->
  return 'now' unless wait
  later()

later := (): Promise<String> ->
  await sleep(0.01)
  'later'

maybe := (wait: Bool): Promise -> return sleep(0.01) if wait

dropped := (wait: Bool): Promise ->
  if wait
    sleep 0.01
  else
    print 'no wait'

cased := (n: Int): Promise ->
  case n
    when 0 then sleep(0.01)
    else print('other')

tried := (): Promise ->
  try
    sleep 0.01
  catch _
    print 'failed'

run := (f: (Int) -> Promise<String>) -> await f(1)
text := (n: Float) -> "#{n}"
await run(text)
