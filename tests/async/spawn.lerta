# spawn lets a promise's work go on without awaiting it: it runs as the code that spawned it goes on
# and waits, whether it gives a value or not, is spawned in a loop, or ends before anything waits.
import Signal, spawn from 'std:async'
import sleep from 'std:time'

done := Signal()
work := (name: String) ->
  await sleep(0.01)
  print "#{name} done"
  done.resolve()
spawn work('spawned')
print 'went on'
await done.promise()

# Of a value, in a loop, each ending before the spawner waits.
var sum = 0
add := (n: Int): Promise<Int> ->
  sum += n
  n
spawn add(n) for n in [1, 2, 3]
await sleep(0.01)
print sum
