import render_markdown from '../../site/markdown'

page := render_markdown('''
  # The *title* of `x`

  A paragraph with `code`, ``a ` b``, **bold** and [a link](types.md#a).
  On two lines, with \* and a < b.

  ## Lists

  - one
  - two
    - nested
  - three

    with a paragraph

  3. third
  4. fourth

  | Name | `a \| b` |
  |---|---|
  | x | y |

  ```lerta
  x := 1
  ```

  ```
  make <target>
  ```

  ## Lists
  ''', (target) -> "[#{target}]")
print page.title
print page.html
print page.links

more := render_markdown('''
  # A

  ## A

  ## A-1

  - loose

  - list

  1. ordered
  - then unordered

  - with code:

    ```
    x
    ```

  \a, *unclosed, [unclosed and **unclosed
  ''', (target) -> target)
print more.html

tight := render_markdown('''
  # T

  - a
    ```
    x

    y
    ```
  - b

  1. c
  ''', (target) -> target)
print tight.html

nested := render_markdown('''
  # T

  ## !!

  *[a link](x) in emphasis* and [**emphasis** in a link](y)

  **`**` in strong** and [`]` in a link](z)

  9. nine
  10. ten
  ''', (target) -> target)
print nested.html

ordered := render_markdown('''
  # T

  The year was
  1999. It rained.

  Then
  1. a list
  2. starts
  ''', (target) -> target)
print ordered.html
