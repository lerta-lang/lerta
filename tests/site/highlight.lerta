import highlight from '../../site/highlight'

print highlight('''
  # A circle.
  struct Circle
    r: Float
    area := @r * @r * PI

  print "area: #{Circle(r: 2).area}" if true
  ''')!
print highlight("x := '''\n  a\n  '''\ny := 1")!
print highlight("\tx") == nil
print highlight('') == ''
print highlight("x := 1  # one\ny := 2")!
print highlight('MAX_SIZE := Circle(IO, x) if not done')!
print highlight("s := 'é日本' + x  # ü\nT")!
print highlight('x  # last')!
