import lay_out from '../../site/layout'
import Page from '../../site/markdown'

page := (title: String, links: String[] = []) ->
  Page(title, links, html: "<p>#{title}</p>", samples: [], warnings: [])

pages :=
  'index.md': page('Lerta {{content}}')
  'philosophy.md': page('Philosophy')
  'reference/README.md': page
    'Language reference'
    [
      'types.md'
      'syntax.md'
      'types.md'
      '../roadmap/README.md'
      'missing.md'
      'sub/nested.md'
      './errors.md#a'
      'modules.md#b'
    ]
  'reference/syntax.md': page('Syntax')
  'reference/errors.md': page('Errors & <panics>')
  'reference/sub/nested.md': page('Nested')
  'reference/modules.md': page('Modules')
  'reference/types.md': page('Types')
  'reference/unlisted.md': page('Unlisted')
  'reference/reindex.md': page('Reindex')
  'tour/README.md': page('Tour')
template := '<title>{{title}}</title>|{{navigation}}|{{sidebar}}|{{content}}'
for path in ['index.md', 'reference/types.md']
  print lay_out(template, path, pages)
print lay_out('{{sidebar}}', 'philosophy.md', pages).is_empty()

# The address of a page, its directory's for a README, and what else the head of a page names.
# Only a README's: a page whose name ends as an index's keeps it.
for path in ['index.md', 'reference/README.md', 'reference/types.md', 'reference/reindex.md']
  print lay_out('{{url}}', path, pages)
print lay_out('{{site}}|{{repository}}|{{description}}', 'reference/types.md', pages)

# The pages before and after a page in its section: none before the first or after the last, and
# neither for a page that its section does not list, that is alone in it or that is in no section.
for path in ['reference/README.md', 'reference/syntax.md', 'reference/modules.md']
  print lay_out('{{pager}}', path, pages)
for path in ['reference/unlisted.md', 'tour/README.md', 'philosophy.md', 'index.md']
  print lay_out('{{pager}}', path, pages).is_empty()

for broken in ['{{title', '{{unknown}}']
  try
    lay_out broken, 'index.md', pages
  catch error: ValueError
    print error.message
