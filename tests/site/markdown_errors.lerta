import MarkdownError, render_markdown from '../../site/markdown'

sources :=
  'no heading'
  "# T\n\n  indented"
  "# T\n\n```\nnot closed"
  "# T\n\n```python\nx = 1\n```"
  "# T\n\n#no space"
  "# T\n\n| a |\n| b |"
  "# T\n\n| a |\n|---|\n| b"
for source in sources
  try
    render_markdown source, (target) -> target
    print 'rendered'
  catch error: MarkdownError
    print error.message
print render_markdown("# T\n\n```lerta\nx :=\tlater\n```", (target) -> target).warnings
for source in ["# T\n\n####### seven", "# T\n\n| a |\n|:-:|\n| b |"]
  try
    render_markdown source, (target) -> target
  catch error: MarkdownError
    print error.message
unsupported :=
  '> quote'
  '* star'
  '+ plus'
  '---'
  "Setext\n==="
  '## Closed ##'
  '![image](a.png)'
  '<b>bold</b>'
  'a _word_'
  '[text][ref]'
  '[ref]: https://lerta.org'
  '[x](https://en.wikipedia.org/wiki/Foo_(bar))'
  '<https://lerta.org>'
  'a &copy; entity'
  "a hard\\\nbreak"
  "a hard  \nbreak by spaces"
  '[x](https://lerta.org "title")'
for text in unsupported
  try
    render_markdown "# T\n\n#{text}", (target) -> target
    print 'rendered'
  catch error: MarkdownError
    print error.message
print render_markdown("# T\n\nIter<T, U>, snake_case and a < b", (target) -> target).html
try
  render_markdown "# T\n\n[x](far)", (target) -> throw ValueError("cannot link: #{target}")
catch error: MarkdownError
  print error.message
