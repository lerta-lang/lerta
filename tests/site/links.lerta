import link_target from '../../site/links'

paths := Set(['index.md', 'philosophy.md', 'reference/README.md', 'reference/types.md'])
links :=
  ('reference/types.md', 'https://example.com/')
  ('reference/types.md', '#int')
  ('reference/types.md', 'README.md')
  ('reference/types.md', 'types.md#int')
  ('reference/types.md', '../philosophy.md#why')
  ('reference/types.md', '../reference/')
  ('reference/types.md', '../issues.md')
  ('reference/types.md', '../../README.md#getting-started')
  ('reference/types.md', '../../compiler/')
  ('reference/types.md', '../..')
  ('index.md', 'reference/README.md')
  ('index.md', './philosophy.md')
  ('index.md', '../README.md#getting-started')
  ('reference/types.md', '../internals/')
print "#{from} #{target} -> #{link_target(from, target, paths)}" for (from, target) in links
print link_target('index.md', '../site/', paths)
try
  link_target 'reference/types.md', '../../../x.md', paths
catch error: ValueError
  print error.message
