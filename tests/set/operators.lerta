# `|`, `&`, `-` and `^` give the union, the intersection, the difference and the symmetric
# difference of two sets, as new sets whose items keep the order of the left one, then of the right
# one.
a := Set([1, 2, 3, 4])
b := Set([6, 4, 2])
print [x for x in a | b]
print [x for x in a & b]
print [x for x in a - b]
print [x for x in b - a]

# The operands are left as they were.
print [[x for x in a], [x for x in b]]

empty: Set<Int>
print [[x for x in a | empty], [x for x in a & empty], [x for x in empty - a]]

# A compound assignment replaces the set.
var seen = Set(['x'])
seen |= Set(['y', 'x'])
seen -= Set(['x'])
print [x for x in seen]

print [Set([2, 4]).is_subset(a), b.is_subset(a), empty.is_subset(empty)]

print [x for x in a ^ b]
var common = Set([1, 2, 3])
common &= Set([3, 2, 9])
print [x for x in common]

# A set with itself.
print [[x for x in a | a], [x for x in a & a], [x for x in a - a], [x for x in a ^ a]]
print a.is_subset(empty)

# Items compare by their own equality: words of the same length are equal here.
struct Word
  text: String
  equals := (other: Word) -> @text.binary.length == other.text.binary.length
  hash := -> @text.binary.length

short := Set([Word('ab'), Word('abc')])
other := Set([Word('xy'), Word('wxyz')])
print [w.text for w in short | other]
print [w.text for w in short & other]
print [w.text for w in short ^ other]

# `^` keeps the order of its left operand, then of the right one.
print [[x for x in b ^ a], [x for x in a ^ empty], [x for x in empty ^ a]]
var toggled = Set([1, 2])
toggled ^= Set([2, 3])
print [x for x in toggled]
