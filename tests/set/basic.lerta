class Node(name: String)

const seen: Set<String> = Set()  # fmt: skip
seen.add 'a'
seen.add 'b'
seen.add 'a'
print "#{seen.length} #{seen.has('a')} #{seen.has('z')}"
seen.remove 'a'
seen.remove 'z'
print seen.length

const numbers = Set([3, 1, 3, 2])
print [n * 10 for n in numbers].length
print n for n in numbers

const empty: Set<Int> = Set([])  # fmt: skip
print empty.length

# The items there when the Iter is made, in order: one removed before it is reached is skipped, and
# one added meanwhile is not given.
const letters = Set(['x', 'y'])
for letter in letters
  letters.remove 'y'
  letters.add 'z'
  print letter
print letters.length

# Objects of a class are the same item only when they are the same object.
const a = Node(name: 'a')
const nodes = Set([a, Node(name: 'a'), a])
print nodes.length

const flags = Set([true, false, true])
const bytes = Set(['a'.binary[0], 'b'.binary[0]])
const floats = Set([0.5, 0.5, 1.5])
print "#{flags.length} #{bytes.length} #{floats.length}"

const lazy = (n * 2 for n in numbers)
print lazy.next()

extend<T> Set<T>
  is_empty = -> @length == 0
print "#{empty.is_empty()} #{numbers.is_empty()}"

# A set in generic code, and from an alias.
const size = <T>(s: Set<T>) -> s.length
class Bag<T>(items: Set<T>)
type Names = Set<String>
const names: Names = Set(['a'])
print "#{size(numbers)} #{size<String>(names)} #{Bag<Int>(items: Set([1])).items.length}"

# The expected type gives the items' type, and the first of equal items is kept.
const halves: Set<Float> = Set([1, 0.0, -0.0])  # fmt: skip
print [x for x in halves].length
print x for x in halves

# An array held by a name stays its own, and the expected type gives the items' type.
const words = ['b', 'a', 'b']
const word_set: Set<String> = Set(words)  # fmt: skip
print "#{word_set.length} #{words.length}"

# An Iter made before an add does not give the item added.
const growing = Set([1])
const items = growing.iter()
growing.add 2
print "#{items.next()} #{items.has_next()}"

# Many removals, which compact the entries.
const many: Set<Int>
many.add i for i in 0...1000
for i in 0...1000
  many.remove i if i % 10 != 0
print "#{many.length} #{[i for i in many][99]}"

const with_default = (s: Set<Int> = Set()) -> s.length
const made = (): Set<String> -> Set()
print "#{with_default()} #{made().length}"

const maybe: Set<Int>? = Set([1])
print maybe?.has(1) == true

# The type arguments give the type, and an optional set type is expected too.
const written = Set<String>()  # fmt: skip
written.add 'w'
const floats_written = Set<Float>([1, 2])
const optional_set: Set<Int>? = Set()
print "#{written.length} #{floats_written.has(2.0)} #{optional_set?.length == 0}"
