# Sets compare by their items, in any order.
print Set([1, 2]) == Set([2, 1])
print Set([1, 2]) == Set([1])
print Set([1]) != Set([2])
print Set<String>() == Set()
print [Set(['a'])] == [Set(['a'])]
print Set([1, 2]) == Set([1, 3])
print Set(['a', 'b']) == Set(['b', 'a'])
struct Bag
  items: Set<Int>
bag := Bag(Set([1, 2]))
print bag == { items: Set([2, 1]) }
maybe: Set<Int>? = nil
print maybe == nil
print maybe == Set([1])
