# `add` tells whether the item was new to the set, which holds it once either way, of items of each
# kind, and where nothing reads it.
s: Set<String>
print [s.add('a'), s.add('b'), s.add('a')]
s.add 'c'
print s.length
seen: Set<Int>
for x in [1, 2, 1, 3, 2]
  continue if not seen.add(x)
  print x
struct Point
  x: Int
  y: Int
points: Set<Point>
print [points.add({ x: 1, y: 2 }), points.add({ x: 1, y: 2 })]
pairs: Set<(Int, String)>
print [pairs.add((1, 'a')), pairs.add((1, 'a'))]
floats: Set<Float>
print [floats.add(0.5), floats.add(0.5)]
words: Set<String>
add_all := (each: (String) -> void) -> each('w')
add_all (word) -> words.add(word)
print words.length
