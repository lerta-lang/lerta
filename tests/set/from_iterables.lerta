# Set() takes the items of anything that a loop goes through, the first of equal ones kept.
class Countdown
  from: Int
  iter := (): Iter<Int> -> (@from - i for i in 0..@from)

show := (items: Set<Int>) -> print([item for item in items])
show Set((x % 3 for x in 0..10))
show Set(0..4)
show Set(Countdown(3))
show Set(Countdown(0))
show Set({ 5: 'a', 6: 'b' }.keys())
print [c for c in Set('hello')]
print [b for b in Set(b'aba')]
typed := Set<Int>([])
print typed.length
