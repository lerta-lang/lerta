import Enum, members from 'std:enums'

enum Light
  ON
  OFF

# A parameter that Enum bounds compares and satisfies Equatable, as every enum does.
same := <E: Enum>(a: E, b: E) -> a == b
same_by_method := <E: Enum>(a: E, b: E) -> a.equals(b)
place := <E: Enum>(member: E) -> members<E>().index_of(member)!

print same(Light.ON, Light.OFF)
print same(Light.OFF, Light.OFF)
print same_by_method(Light.ON, Light.ON)
print place(Light.OFF)
