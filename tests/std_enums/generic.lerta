import Enum, members, parse from 'std:enums'

enum Light
  ON
  OFF

# An Enum-bounded parameter gives the members and their texts.
texts := <E: Enum>() -> [member.to_string() for member in members<E>()]
first := <E: Enum>(text: String) -> parse<E>(text) ? members<E>()[0]

print texts<Light>()
print first<Light>('OFF')
print first<Light>('x')
