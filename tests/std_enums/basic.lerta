import members, parse from 'std:enums'

enum Kind
  IDENTIFIER
  '('
  ''

show := (kind: Kind?) -> kind then kind.to_string() else 'nil'

print show(parse<Kind>('('))
print show(parse<Kind>('IDENTIFIER'))
print show(parse<Kind>(''))
print show(parse<Kind>('identifier'))
text := 'IDENTIFIER'
print parse<Kind>(text)! == IDENTIFIER
print members<Kind>()
print members<Ordering>()
