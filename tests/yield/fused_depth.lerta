# A chain of functions that yield, each over the next, past the depth to which loops take them in
# place, gives its items all the same.
one := (n: Int) -> yield i for i in 0..n
two := (n: Int) -> yield i * 2 for i in one(n)
three := (n: Int) -> yield i + 1 for i in two(n)
four := (n: Int) -> yield i * 3 for i in three(n)
five := (n: Int) -> yield i - 1 for i in four(n)
six := (n: Int) -> yield i * 10 for i in five(n)

print x for x in six(3)
