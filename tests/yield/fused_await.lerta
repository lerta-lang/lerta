# A loop in a function that awaits takes a function that yields in place, with an await in its
# body.
import sleep from 'std:time'
early := (n: Int) ->
  for i in 0..n
    return if i == 2
    yield i
done := -> yield 7
af := ->
  for i in early(5)
    await sleep(0)
    print i
  print j for j in done()
  'result'
main := -> print(await af())
_p := main()
