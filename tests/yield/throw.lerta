# An exception thrown in the body reaches the code that asks for the item, and ends the Iter; one
# caught in the body does not.
struct Odd(message: String)

check := (n: Int) ->
  throw Odd(message: "#{n} is odd") if n % 2 == 1
  n

halves := (numbers: Int[]) ->
  for n in numbers
    half :=
      try
        check(n) / 2
      catch e: Odd
        yield e.message
        continue
    yield "#{half}"
print halves([4, 3, 8]).to_array().join(', ')

fail_second := (): Iter<String> ->
  yield 'one'
  throw Odd(message: 'no second')

items := fail_second()
print items.next()
try
  print items.next()
catch e: Odd
  print "caught #{e.message}"
print items.has_next()
print item for item in fail_second()
