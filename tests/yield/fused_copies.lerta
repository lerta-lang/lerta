# Functions with many yields, each over the last, which would copy the loop's body as many times
# over as their yields multiply if loops took them all in place, are taken in place only within
# MOST_COPIES, so that the program builds in a moment; and so are loops nested in the body of one,
# and in function literals there. A function with a yield in an expression is never taken in place,
# as it may hold temporaries there, and copies nothing.
a := ->
  yield 0
  yield 1
  yield 2
  yield 3
  yield 4
  yield 5
  yield 6
  yield 7
  yield 8
  yield 9
  yield 10
  yield 11
b := ->
  yield x + 0 for x in a()
  yield x + 1 for x in a()
  yield x + 2 for x in a()
  yield x + 3 for x in a()
  yield x + 4 for x in a()
  yield x + 5 for x in a()
  yield x + 6 for x in a()
  yield x + 7 for x in a()
  yield x + 8 for x in a()
  yield x + 9 for x in a()
  yield x + 10 for x in a()
  yield x + 11 for x in a()
c := ->
  yield x + 0 for x in b()
  yield x + 1 for x in b()
  yield x + 2 for x in b()
  yield x + 3 for x in b()
  yield x + 4 for x in b()
  yield x + 5 for x in b()
  yield x + 6 for x in b()
  yield x + 7 for x in b()
  yield x + 8 for x in b()
  yield x + 9 for x in b()
  yield x + 10 for x in b()
  yield x + 11 for x in b()
d := ->
  yield x + 0 for x in c()
  yield x + 1 for x in c()
  yield x + 2 for x in c()
  yield x + 3 for x in c()
  yield x + 4 for x in c()
  yield x + 5 for x in c()
  yield x + 6 for x in c()
  yield x + 7 for x in c()
  yield x + 8 for x in c()
  yield x + 9 for x in c()
  yield x + 10 for x in c()
  yield x + 11 for x in c()
var total = 0
for x in d()
  total += x
  total += x * 2 if total > 5
print total

eight := ->
  yield 0
  yield 1
  yield 2
  yield 3
  yield 4
  yield 5
  yield 6
  yield 7
var nested = 0
for x0 in eight()
  for x1 in eight()
    for x2 in eight()
      for x3 in eight()
        for x4 in eight()
          nested += x0 + x1 + x2 + x3
print nested

var in_literals = 0
for a in eight()
  f := ->
    for b in eight()
      g := ->
        for c in eight()
          h := ->
            for d in eight()
              k := ->
                for e in eight()
                  in_literals += a + b + c + d
              k()
          h()
      g()
  f()
print in_literals

in_expression := ->
  second :=
    case 1
      when 1
        yield 1
        2
      else 3
  print "second: #{second}"

var around = 0
for w in in_expression()
  for x0 in eight()
    for x1 in eight()
      for x2 in eight()
        for x3 in eight()
          for x4 in eight()
            around += x0 + x1 + x2 + x3 + w
print around
