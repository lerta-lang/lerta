# A function that yields returns an Iter of what it yields; its body runs as items are asked for.
const countdown = (n: Int) ->
  var i = n
  while i > 0
    yield i
    i -= 1
for x in countdown(3)
  print x

const lazy = (): Iter<String> ->
  print 'started'
  yield 'first'
  print 'resumed'
  yield 'second'
const items = lazy()
print 'made'
print items.next()
print items.next()
print items.has_next()

# return ends the Iter early; the item type is inferred from the yielded values, nil included.
const until_blank = (lines: String[]) ->
  for line in lines
    return if line == ''
    yield line
  yield nil
print until_blank(['a', 'b', '', 'c']).to_array().length
for line in until_blank(['x'])
  print line ? 'nil'

# A function literal captures as any other; a var it shares is read as it is when resumed.
var step = 10
const steps = (count: Int): Iter<Int> ->
  for i in 0...count
    yield i * step
const by_step = steps(3)
print by_step.next()
print by_step.next()
step = 100
print by_step.next()

class Counter
  limit: Int
  up_to = -> yield i for i in 1...@limit
print Counter(limit: 4).up_to().map((n) -> "#{n}").to_array().join(' ')

const pairs = <T>(a: T, b: T) ->
  yield a
  yield b
print pairs('p', 'q').to_array().join('')

const greeting = (name: String, punctuation = '!') -> yield "hi #{name}#{punctuation}"
print greeting('ann').next()

# Items of any type: interface values, Bools and optional values, and the items of another Iter,
# of the same function too.
interface Shape
  area: Int
struct Square
  side: Int
  area = @side * @side
const shapes = (): Iter<Shape> ->
  yield Square(side: 2)
  yield Square(side: 3)
print shapes().map((s) -> "#{s.area}").to_array().join(' ')
const parities = (n: Int) -> yield i % 2 == 0 for i in 0...n
print parities(3).to_array().length
const maybe = (): Iter<String?> ->
  yield 'some'
  yield nil if true
print maybe().map((s) -> s ? 'none').to_array().join(' ')
const ones = (n: Int): Iter<Int> ->
  return if n == 0
  yield n
  yield x for x in ones(n - 1)
print ones(3).map((n) -> "#{n}").to_array().join(' ')
