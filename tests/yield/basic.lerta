# A function that yields returns an Iter of what it yields; its body runs as items are asked for.
countdown := (n: Int) ->
  var i = n
  while i > 0
    yield i
    i -= 1
print x for x in countdown(3)

lazy := (): Iter<String> ->
  print 'started'
  yield 'first'
  print 'resumed'
  yield 'second'
items := lazy()
print 'made'
print items.next()
print items.next()
print items.has_next()

# return ends the Iter early; the item type is inferred from the yielded values, nil included.
until_blank := (lines: String[]) ->
  for line in lines
    return if line.is_empty()
    yield line
  yield nil
print until_blank(['a', 'b', '', 'c']).to_array().length
print line ? 'nil' for line in until_blank(['x'])

# A function literal captures as any other; a var it shares is read as it is when resumed.
var step = 10
steps := (count: Int): Iter<Int> -> yield i * step for i in 0..count
by_step := steps(3)
print by_step.next()
print by_step.next()
step = 100
print by_step.next()

class Counter
  limit: Int
  up_to := -> yield i for i in 1..@limit
print Counter(4).up_to().map((n) -> "#{n}").to_array().join(' ')

pairs := <T>(a: T, b: T) ->
  yield a
  yield b
print pairs('p', 'q').to_array().join('')

greeting := (name: String, punctuation = '!') -> yield "hi #{name}#{punctuation}"
print greeting('ann').next()

# Items of any type: interface values, Bools and optional values, and the items of another Iter,
# of the same function too.
interface Shape
  area: Int
struct Square
  side: Int
  area := @side * @side
shapes := (): Iter<Shape> ->
  yield Square(2)
  yield Square(3)
print shapes().map((s) -> "#{s.area}").to_array().join(' ')
parities := (n: Int) -> yield i % 2 == 0 for i in 0..n
print parities(3).to_array().length
maybe := (): Iter<String?> ->
  yield 'some'
  yield nil if true
print maybe().map((s) -> s ? 'none').to_array().join(' ')
ones := (n: Int): Iter<Int> ->
  return if n == 0
  yield n
  yield x for x in ones(n - 1)
print ones(3).map((n) -> "#{n}").to_array().join(' ')
