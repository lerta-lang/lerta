# A break out of a loop that takes a function in place, while the function waits in a for over
# another Iter, a generator's or a lazy map's, releases that Iter.
class D
  args
    name: String
  deinit := -> print("drop #{@name}")

src := (): Iter<Int> ->
  _d := D('src')
  yield 1
  yield 2

f := ->
  yield a for a in src()
  yield b for b in [1, 2, 3].map((x) -> x)

for v in f()
  print v
  break if v == 1
print 'after'
for v in f()
  print v
  break if v == 3
print 'end'
