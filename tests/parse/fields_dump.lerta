import 'std:math' as math
import sleep from 'std:time'
class Box
  size := default 1
  watch := ->
    weak var me = @
    print me?.size ? 0
    run weak -> print(@size)
f := (a = 1, b: Int? = nil) -> a + (b ? 0)
g := (rest: Int...) -> rest
run := (g: () -> void) -> g()
var b: Box?
b?.watch()
m: Map<Int, Int>
print m.length
print math.PI
numbers := -> yield 1
print [n for n in numbers()]
wait := -> await sleep(0.001)
await wait()
