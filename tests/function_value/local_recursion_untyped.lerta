# A local function whose return type is not written does not see itself, in its body nor in a
# function literal in it.
direct := ->
  fact := (n: Int) -> n <= 1 then 1 else n * fact(n - 1)
  print fact(3)

nested := ->
  outer := (n: Int) ->
    inner := (): Int -> outer(n - 1)
    inner()
  print outer(1)
