const double = (x: Int): Int -> x * 2
const square = (x: Int): Int -> x * x
const shout = (s: String): String -> s + '!'
const announce = (s: String) -> print s

const apply = (f: (Int) -> Int, x: Int): Int -> f(x)
const pick = (big: Bool): ((Int) -> Int) -> big then square else double

struct Button
  label: String
  on_press: (String) -> void

const f = double
print f(3)
print apply(square, 4)
print pick(true)(5)
print pick(false)(5)
const steps: Array<(Int) -> Int> = [double, square, double]
var n = 1
n = step(n) for step in steps
print n
const by_name = { 'shout': shout }
print by_name['shout']!('hey')
const button = Button(label: 'ok', on_press: announce)
button.on_press(button.label)
const maybe: ((Int) -> Int)? = nil
print maybe then maybe(1) else 0
