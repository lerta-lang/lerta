double := (x: Int) -> x * 2
square := (x: Int) -> x * x
shout := (s: String) -> s + '!'
announce := (s: String) -> print(s)

apply := (f: (Int) -> Int, x: Int) -> f(x)
pick := (big: Bool): ((Int) -> Int) -> big then square else double  # fmt: skip

struct Button(label: String, on_press: (String) -> void)

f := double
print f(3)
print apply(square, 4)
print pick(true)(5)
print pick(false)(5)
steps: ((Int) -> Int)[] = [double, square, double]  # fmt: skip
var n = 1
n = step(n) for step in steps
print n
by_name := { 'shout': shout }
print by_name['shout']!('hey')
button := Button(label: 'ok', on_press: announce)
button.on_press button.label
maybe: ((Int) -> Int)? = nil
print maybe then maybe(1) else 0
