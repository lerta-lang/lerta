# A local function read before its declaration needs what it captures of the block declared where
# it is read, or where the function literal reading it is made; one whose type is not written is
# not seen before its declaration.
read_early := ->
  print later(2)
  base := 100
  later := (n: Int): Int -> n + base

made_early := ->
  early := -> after(1)
  base := 100
  after := (n: Int): Int -> n + base
  print early()

untyped := ->
  print plain(1)
  plain := (n: Int) -> n

through_another := ->
  early := -> first(1)
  base := 100
  first := (n: Int): Int -> second(n)
  second := (n: Int): Int -> n + base
