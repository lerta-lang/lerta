import { triple, triple as times_three } from './lib/triple'

const double = (x: Int): Int -> x * 2
const is_even = (x: Int): Bool -> x % 2 == 0
const low_byte = (x: Int): Byte -> 7
const fail = (s: String): Int -> throw ValueError(message: s)
const adder = (): (Int) -> Int -> double

class Holder
  f: (Int) -> Int

const use = (double: (Int) -> Int): Int -> double(10)

print use(triple)
const g = times_three
print g(2)
const even: (Int) -> Bool = is_even
print even(4)
const byte: (Int) -> Byte = low_byte
print byte(1).to_int()
var h = double
h = triple
print h(1)
const holder = Holder(f: double)
holder.f = times_three
print holder.f(5)
print adder()(8)
const failing = fail
print failing('stopped')
