import triple, triple as times_three from './lib/triple'

double := (x: Int) -> x * 2
is_even := (x: Int) -> x % 2 == 0
low_byte := (x: Int): Byte -> 7
fail := (s: String): Int -> throw ValueError(s)
adder := (): ((Int) -> Int) -> double  # fmt: skip

class Holder
  f: (Int) -> Int

use := (double: (Int) -> Int) -> double(10)

print use(triple)
g := times_three
print g(2)
even: (Int) -> Bool = is_even  # fmt: skip
print even(4)
byte: (Int) -> Byte = low_byte  # fmt: skip
print byte(1).to_int()
var h = double
h = triple
print h(1)
holder := Holder(double)
holder.f = times_three
print holder.f(5)
print adder()(8)
failing := fail
print failing('stopped')
