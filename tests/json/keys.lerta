import decode_json, encode_json, JsonKeys from 'std:json'

# Only the keys of fields change, not those of maps.
struct Position(line: Int, character: Int)

class Params
  text_document: { uri: String }
  position: Position
  line_2: Int
  _private: Bool
  a__b: Int
  trailing_: Int
  by_name: Map<String, Int>

const params = Params(
  text_document: { uri: 'file:///a' }
  position: Position(line: 1, character: 2)
  line_2: 3
  _private: true
  a__b: 4
  trailing_: 5
  by_name: { 'snake_key': 6 }
)
const text = encode_json(params, JsonKeys.CAMEL_CASE)
print text
print encode_json(params)
const back = decode_json<Params>(text, JsonKeys.CAMEL_CASE)
print encode_json(back, JsonKeys.CAMEL_CASE) == text
print decode_json<Params>(encode_json(params)).text_document.uri

const read = (text: String) ->
  try
    print(
      decode_json<{ text_document: { uri: String } }>(text, JsonKeys.CAMEL_CASE).text_document.uri
    )
  catch e
    print e.message

read '{"textDocument": {"uri": "x"}}'
read '{"text_document": {"uri": "x"}}'
read '{"textDocument": {}}'
read '{"textDocument": {"uri": 1}}'

const read_as_written = (text: String) ->
  try
    print decode_json<{ text_document: { uri: String } }>(text).text_document.uri
  catch e
    print e.message

# An uppercase letter or a digit after `_`, keys nested in arrays, camel case read as written, and
# an optional field left out.
struct Edit(new_text: String, a_B: Int, x_1: Int, old_text: String?)

print encode_json([(1, Edit(new_text: 'n', a_B: 2, x_1: 3, old_text: nil))], JsonKeys.CAMEL_CASE)
const edits = decode_json<{ edits: Edit[] }[]>(
  '[{"edits": [{"newText": "t", "a_B": 1, "x_1": 2}]}]'
  JsonKeys.CAMEL_CASE
)
print "#{edits[0].edits[0].new_text} #{edits[0].edits[0].old_text == nil}"
read_as_written '{"textDocument": {"uri": "x"}}'

# Both forms of a key in camel case: the field's is read, and the other skipped.
read '{"text_document": {"uri": "skipped"}, "textDocument": {"uri": "read"}}'

# A class that holds itself, in camel case.
class Tree(child_trees: Tree[])

const tree = Tree(child_trees: [Tree(child_trees: [])])
const tree_text = encode_json(tree, JsonKeys.CAMEL_CASE)
print tree_text
print(
  encode_json(decode_json<Tree>(tree_text, JsonKeys.CAMEL_CASE), JsonKeys.CAMEL_CASE) == tree_text
)
