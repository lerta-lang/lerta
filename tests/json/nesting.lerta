import decode_json from 'std:json'

struct Point
  x: Int

# Arrays nested `depth` deep as the value of a key that Point has no field for, within the object.
try_nested := (depth: Int) ->
  text := "{\"x\": 1, \"skipped\": #{'['.repeat(depth)}#{']'.repeat(depth)}}"
  try
    print decode_json<Point>(text).x
  catch e
    print e.message.ends_with(': nesting deeper than 128')

try_nested 127
try_nested 128
try_nested 1000000

class Node
  args
    children: Node[]

# Objects nested `depth` deep, each in an array, read as Nodes.
try_nodes := (depth: Int) ->
  text := "#{'{"children": ['.repeat(depth)}#{']}'.repeat(depth)}"
  try
    print decode_json<Node>(text).children.length
  catch e
    print e.message.ends_with(': nesting deeper than 128')

try_nodes 64
try_nodes 65
try_nodes 1000000
