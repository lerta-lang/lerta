import decode_json from 'std:json'

enum Color
  RED

class Item
  args
    name: String
    color: Color
    sizes: Int[] = []

for text in [
  '{"name": "x"}'
  '{"name": "x", "color": "BLUE"}'
  '{"name": "x", "name": "y"}'
  '{"name": 1}'
  '[1]'
  '{"name": "x", "color": "RED", "sizes": [1, true]}'
  '{"name": "x" "color": "RED"}'
  '{"name": "x", 1: 2}'
  '{"name" 1}'
  '{"skipped": [1, {"a": tru}]}'
  '{"skipped": {"a": 1, "a": 2}}'
]
  try
    item := decode_json<Item>(text)
    print item.name
  catch e
    print e.message

for text in ['[1]', '[1, "a", 2]', '{}']
  try
    (number, _) := decode_json<(Int, String)>(text)
    print number
  catch e
    print e.message

try
  nested :=
    decode_json<Map<String, Item[]>>('{"a": [{"name": "x", "color": "RED"}, {"name": "y"}]}')
  print nested.length
catch e
  print e.message
