import decode_json, encode_json from 'std:json'

enum Color
  RED
  GREEN

struct Position
  line: Int
  character: Int

# Fields with a default, of an optional type, and given by an initializer alone.
class Item
  name: String
  color: Color
  tags = default ['new']
  note: String?
  count = 0

class Box<T>
  value: T

print encode_json(Item(name: 'a', color: GREEN, note: nil))
item := decode_json<Item>('{"color": "RED", "count": 5, "extra": [1, {"x": null}], "name": "b"}')
print "#{item.name} #{item.color} #{item.tags} #{item.note == nil} #{item.count}"
tagged := decode_json<Item>('{"name": "c", "color": "GREEN", "tags": [], "note": "n"}')
print "#{tagged.tags.length} #{tagged.note!}"
print encode_json(Position(line: 1, character: 2))
position := decode_json<Position>(' { "line" : 3 , "character" : 4 } ')
print "#{position.line} #{position.character}"
print encode_json(Box([Color.RED]))
print decode_json<Box<Position?>>('{"value": null}').value == nil

counts: Map<String, Int[]>
counts['x'] = [1]
counts['y'] = []
print encode_json(counts)
read_counts := decode_json<Map<String, Int>>('{"b": 2, "a": 1}')
print read_counts.keys().to_array()
print encode_json(Map<String, Bool>())

print encode_json((1, 'a', [true]))
(number, text) := decode_json<(Int, String)>('[2, "b"]')
print "#{number} #{text}"

print encode_json({ a: 1, b: 'x' })
record := decode_json<{ a: Int, b: String? }>('{"a": 5}')
print "#{record.a} #{record.b == nil}"
print encode_json([Color.RED, GREEN])
print decode_json<Color[]>('["GREEN"]')[0]
