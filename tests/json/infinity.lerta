# JSON holds no infinity, so writing one throws, by the path of the value, of a Float or a Float32.
import encode_json from 'std:json'
import INFINITY from 'std:math'

struct Reading
  value: Float
  small: Float32

print encode_json(Reading(value: 1.5, small: 2.5))
try
  print encode_json(Reading(value: -INFINITY, small: 2.5))
catch e
  print e.message
try
  print encode_json([Reading(value: 1.5, small: INFINITY.to_float32())])
catch e
  print e.message
