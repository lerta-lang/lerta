import decode_json, encode_json from 'std:json'

enum Color
  RED

struct Point(x: Int, y: Int)

class Message(id: Int | String, value: Bool | Float | Color | Point, extra: Int | Point?)

message := Message(id: 1, value: Point(x: 1, y: 2), extra: nil)
print encode_json(message)
print encode_json(Message(id: 'a', value: Color.RED, extra: 3))
print encode_json([Message(id: 'b', value: 1.5, extra: Point(x: 0, y: 0))])

read := (text: String) ->
  try
    decoded := decode_json<Message>(text)
    print encode_json(decoded)
  catch e
    print e.message

read '{"id": 2, "value": true}'
read '{"id": "x", "value": 2.5, "extra": {"x": 1, "y": 2}}'
read '{"id": "x", "value": 3, "extra": null}'
read '{"id": "x", "value": "RED", "extra": 4}'
read '{"id": [1], "value": true}'
read '{"id": null, "value": true}'
read '{"id": 1, "value": "BLUE"}'
read '{"id": 1, "value": {"x": 1}}'
read '{"id": 1, "value": true, "extra": "a"}'
