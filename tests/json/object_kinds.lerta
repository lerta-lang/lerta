import decode_json, encode_json from 'std:json'

# Fields of a declared interface, a constructor that throws, and a cycle through a struct.
struct Failure: Error
  code: Int

class Checked
  value: Int
  init := -> throw ValueError("a negative value, #{@value}") if @value < 0

struct Tree
  items: Tree[]

failure := decode_json<Failure>('{"code": 2, "message": "m"}')
print "#{failure.code} #{failure.message}"
print encode_json(failure)
print decode_json<Checked>('{"value": 1}').value
try
  checked := decode_json<Checked[]>('[{"value": 1}, {"value": -1}]')
  print checked.length
catch e
  print e.message
tree := Tree([])
tree.items.push tree
try
  print encode_json(tree)
catch e
  print e.message
tree.items.pop()

# A constructor that throws after it has taken a field that holds a reference.
class Named
  names: String[]
  init := -> throw ValueError(message: 'no names') if @names.is_empty()

try
  print decode_json<Named[]>('[{"names": ["a"]}, {"names": []}]').length
catch e
  print e.message

# A default left out by the text, before an object whose init throws.
class Labeled
  label := default 'none'
  names: String[]
  init := -> throw ValueError(message: 'no names') if @names.is_empty()

try
  print decode_json<Labeled[]>('[{"names": ["a"]}, {"names": []}]').length
catch e
  print e.message
