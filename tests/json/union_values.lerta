import decode_json, encode_json from 'std:json'

class Node(name: String, var next: Node | Int?)

const read = (text: String) ->
  try
    print encode_json(decode_json<Bool | Int>(text))
  catch e
    print e.message

# A union at the top level, and malformed values that the first byte takes for a member.
read ' 7'
read "\ntrue "
read 'tru'
read '-x'
read ''
read '[1]'

const node = Node(name: 'a', next: 1)
print encode_json(node)
node.next = node
try
  print encode_json(node)
catch e
  print e.message
node.next = nil

enum Mode
  ON

# Unions read in an array, in a map, and optional at the top level; a Bool read from false.
const flags = decode_json<(Bool | Mode)[]>('[false, "ON", true]')
print encode_json(flags)
const ids = decode_json<Map<String, Int | String>>('{"a": 1, "b": "x"}')
print encode_json(ids)
print decode_json<Int | String?>('null') == nil
print encode_json(decode_json<Int | String?>('"y"'))
