import Codable from 'std:codable'
import decode_json, encode_json, JsonError from 'std:json'

# A Char is written as a string of it alone, a set as an array of its items, and a map of other keys
# than Strings as an array of its entries, each an array of its key and its value.
letter: Char = 'é'
print encode_json(letter)
print decode_json<Char>('"x"')
print encode_json(Set(['b', 'a']))
print decode_json<Set<Char>>('["a","b"]').length
by_id := { 1: 'one', 2: 'two' }
text := encode_json(by_id)
print text
print decode_json<Map<Int, String>>(text)[2]!
by_pair := { (1, 'a'): true }
print encode_json(by_pair)
print decode_json<Map<(Int, String), Bool>>('[[[1,"a"],true]]')[(1, 'a')]!
nested := decode_json<Map<Int, Set<Int>>>('[[1,[2,3]]]')
print nested[1]!.length

enum Color
  RED
  GREEN

by_color := { Color.GREEN: 1 }
print encode_json(by_color)
print decode_json<Map<Color, Int>>('[["RED",2]]')[RED]!
by_letter: Map<Char, Int> = { 'a': 1 }
print encode_json(by_letter)
print decode_json<Map<Char, Int>>('[["b",2]]')['b']!
quote: Char = '"'
far: Char = '😀'
print encode_json([quote, far])
print decode_json<Char[]>(encode_json([quote, far])) == [quote, far]
print encode_json(Set<Int>())
print encode_json(Map<Int, Int>())
print decode_json<Set<Int>>('[]').length
print decode_json<Map<Int, Int>>('[]').length

# A cycle in the value of an entry is found as in any other value.
class Node
  var next: Node?

node := Node()
node.next = node
try
  print encode_json({ 1: node })
catch error: JsonError
  print error.message
node.next = nil

failing := <T: Codable>(text: String) ->
  try
    _value := decode_json<T>(text)
  catch error: JsonError
    print error.message

failing<Char>('"ab"')
failing<Char>('""')
failing<Set<Int>>('[3,1,3]')
failing<Set<String>>('["a",1]')
failing<Set<String>>('["a","a"]')
failing<Map<Int, String>>('[[1,"a"],[1,"b"]]')
failing<Map<Int, String>>('[[1]]')
failing<Map<Int, String>>('[[1,"a",2]]')
failing<Map<Int, String>>('[[1,2]]')
failing<Map<(Int, String), String>>('[[[1,"a"],2]]')
failing<Map<Int, String>>('{"1":"a"}')
