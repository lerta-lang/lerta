import decode_json from 'std:json'

const try_decode = (text: String) ->
  try
    decode_json<Int[][]>(text)
  catch e
    print e.message

try_decode ''
try_decode '[[1, 2.5]]'
try_decode '[[1], [2, 99999999999999999999]]'
try_decode '[[1]'
try_decode '[[1] 2]'
try_decode '[[1,]]'
try_decode '[[1]] x'
try_decode '{}'
try_decode '[[tru]]'
try_decode '[[01]]'

const try_string = (text: String) ->
  try
    print decode_json<String>(text)
  catch e
    print e.message

try_string '"abc'
try_string '"a\qb"'
try_string '"\u12"'
try_string '"\ud800"'
try_string '"\udc00\udc00"'
try_string "\"a\tb\""
try_string '5'

try
  decode_json<Bool>('nul')
catch e
  print e.message
try
  decode_json<Float>('1e400')
catch e
  print e.message
try_string '"\ud800A"'
for number in ['+1', '.5', '1.', '-']
  try
    decode_json<Float>(number)
  catch e
    print e.message
try_decode '[[1], 2]'
try_decode '[[9223372036854775807, -9223372036854775808, 9223372036854775808]]'
try_decode '[[-01]]'
try_decode '[[-]]'
try
  decode_json<Int[]?[]>('[[1], null, [x]]')
catch e
  print e.message
