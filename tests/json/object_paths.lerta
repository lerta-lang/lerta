import decode_json, encode_json from 'std:json'

enum Color
  RED

class A(name: String, b: B?)

class B(a: A?)

struct Point(x: Int, y: Int)

# Cycles through a map value, a tuple item and an anonymous struct's field, and between two classes.
class Holder
  by_name: Map<String, Holder> = default Map()
  pairs: (Int, Holder?)[] = default []
  records: { holder: Holder? }[] = default []

const try_encode = (write: () -> String) ->
  try
    print write()
  catch e
    print e.message

const a = A(name: 'a', b: nil)
const b = B(a)
a.b = b
try_encode -> encode_json(a)
a.b = nil
const holder = Holder()
holder.by_name['self'] = holder
try_encode -> encode_json(holder)
holder.by_name.remove 'self'
holder.pairs.push (1, holder)
try_encode -> encode_json(holder)
holder.pairs.pop()
holder.records.push { holder }
try_encode -> encode_json(holder)
holder.records.pop()

# A map of objects.
const points = { 'a': Point(x: 1, y: 2), 'b': Point(x: 3, y: 4) }
print encode_json(points)

const try_decode = (read: () -> String) ->
  try
    print read()
  catch e
    print e.message

# Skipped values of every kind, and keys with escapes.
const skipped = '{"s": "x\"y", "n": -1.5e3, "t": true, "f": false, "z": null, "a": [], "o": {}, "\u0078": 1, "\u0079": 2}'
try_decode -> "#{decode_json<Point>(skipped).x}"
try_decode -> "#{decode_json<{ c: Color? }[]>('[{"c": null}, {"c": "BLUE"}]')[0].c == nil}"
try_decode -> "#{decode_json<Map<String, Color>>('{"k": "BLUE"}').length}"
const read_nested = ->
  const text = '[{"x": 1, "y": 2}, {"p": {"x": 3, "y": 4}}]'
  const (point, record) = decode_json<(Point, { p: Point })>(text)
  "#{point.x} #{record.p.y}"
try_decode read_nested
const read_missing = ->
  const (first, _) = decode_json<(Point, Point)>('[{"x": 1, "y": 2}, {"x": 3}]')
  "#{first.x}"
try_decode read_missing
try_decode -> "#{decode_json<Point>('{"x": 1, 2}').x}"
