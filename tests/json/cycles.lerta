import encode_json from 'std:json'

class Node
  args
    name: String
    children: Node[] = []
  var parent: Node? = nil

root := Node('root')
child := Node('child')
root.children.push child
# One object reached twice without a cycle is written twice.
root.children.push child
print encode_json(root)
child.parent = root
try
  print encode_json(root)
catch e
  print e.message
child.parent = child
try
  print encode_json([root])
catch e
  print e.message
child.parent = nil
