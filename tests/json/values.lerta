import decode_json, encode_json from 'std:json'

print encode_json(42)
print encode_json(-1.5)
print encode_json(1e21)
print encode_json(true)
print encode_json("\x01é😀\x1F")
print encode_json("quote \" backslash \\ newline \n tab \t control \x01 é")
xs: String?[] = ['a', nil, 'c']
print encode_json(xs)
nested: String[][] = [['a'], [], ['b', 'c']]
print encode_json(nested)
none: Int? = nil
print encode_json(none)

print decode_json<Int>(' -7 ')
print decode_json<Float>('3')
print decode_json<Float>('-0.25e2')
print decode_json<Bool>('false')
escaped := decode_json<String>('"\u00e9 \ud83d\ude00 \/ \b\f\n\r\t \" \\"')
print escaped == "é 😀 / \x08\x0C\n\r\t \" \\"
print decode_json<Int?>('null') == nil
print decode_json<Int?>('5')!
read := decode_json<String?[][]>(" [ [\"x\" , null], [ ] ]\n")
print read.length
print read[0][0]!
print read[0][1] == nil
print read[1].length
print decode_json<String[][]>(encode_json(nested)) == nested

print decode_json<String>('"a\u0000b"').binary.length
print decode_json<Float>('-0')
print decode_json<Float>('1E2')
print decode_json<Float>(encode_json(1e21)) == 1e21
maybe_texts: String[]? = nil
print encode_json(maybe_texts)
print decode_json<String[]?>('null') == nil
print decode_json<String[]?>('["a"]')![0]
print decode_json<String?[]>('[null, "b"]')[1]!
no_ints: Int[]
optional_arrays: Int[]?[] = [[1], nil, no_ints]
print encode_json(optional_arrays)
print decode_json<Int[]?[]>(encode_json(optional_arrays))[1] == nil
