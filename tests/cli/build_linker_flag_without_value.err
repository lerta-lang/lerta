usage: lerta build <source> [<file>...] [-o <output>] [-O] [--memory-checks] [-Werror]
                   [--no-trace] [--source-lines] [--eager-nan-checks] [--target <target>]
                   [--linker-flag <flag>...]
       lerta run <source> [<file>...] [-O] [--memory-checks] [-Werror] [--no-trace]
                 [--source-lines] [--eager-nan-checks] [--linker-flag <flag>...] [-- <arg>...]
       lerta fmt [--fix] <path>...
       lerta lsp
       lerta clean
       lerta dump-tokens <source>
       lerta dump-ast <source>
       lerta dump-checked <source>
       lerta dump-llvm <source>
