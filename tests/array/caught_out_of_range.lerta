# An index out of range throws before the item is read or written, so a caught throw leaves the
# array and the value as they were.
const words = ['a'.to_string()]
const flags = [true]
const values: Stringable[] = ['v'.to_string()]
try
  print values[1].to_string()
catch e
  print e.message
try
  print words[1]
catch e
  print e.message
try
  words[-1] = 'b'.to_string()
catch e
  print e.message
try
  flags[1] = false
catch e
  print e.message
words[0] = 'c'.to_string()
print words[0]
print flags[0]
