import sleep from 'std:time'

# Arrays, maps, sets and promises hold each integer type at its own size: the items keep their
# bounds and signs through each operation.
const int8s: Int8[] = [-128, -1, 0, 127]
const int16s: Int16[] = [-32768, -1, 0, 32767]
const int32s: Int32[] = [-2147483648, -1, 0, 2147483647]
const uint16s: UInt16[] = [0, 1, 65535]
const uint32s: UInt32[] = [0, 1, 4294967295]
print int8s
print int16s
print int32s
print uint16s
print uint32s

int16s.push -2
int16s[0] = 12345
print [int16s.pop(), int16s[0], int16s[1]]
print int16s.length
print int8s == [-128, -1, 0, 127]
print int8s == [-128, -1, 0, 126]
print [x.to_int() * 2 for x in int32s]
print [x for x in uint32s when x > 1]

const counts = Map<Int16, Int8>()
counts[-300] = -5
counts[300] = 5
print [counts[-300]!, counts[300]!]
print counts[1] == nil
print counts.keys().to_array()
const seen = Set<UInt16>()
seen.add 65535
seen.add 1
print [seen.has(65535), seen.has(0)]
print [x for x in seen]
const by_array: Map<Int8[], String> = { [-1, 2]: 'pair' }
print by_array[[-1, 2]]!

const later = (): Promise<Int16> ->
  await sleep(0)
  -32768
const main = (): Promise ->
  print await later()
const _done = main()

# Keys of each width and sign come back from keys() as they went in, through removals and the
# rebuild that compacts the entries.
const wide = Map<UInt32, Int32>()
wide[4294967295] = -2147483648
wide[0] = 1
print [wide[4294967295]!, wide[0]!]
print wide.keys().to_array()
const small = Map<Int8, Int32>()
const edges: Int8[] = [-128, -1, 0, 1, 127]
const middle: Int8[] = [-1, 0, 1]
small[k] = k.to_int32() * -1000 for k in edges
small.remove k for k in middle
small[i.to_int8()!] = -i.to_int32()! for i in 2...40
print [small[-128]!, small[127]!, small[39]!]
print small.keys().to_array().length
print ["#{k}: #{v}" for (k, v) in small.entries() when k < 0]
const negatives = Set<Int32>([-2147483648, -7, 7])
negatives.remove 7
print [x for x in negatives]
