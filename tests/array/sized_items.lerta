import spawn from 'std:async'
import sleep from 'std:time'

# Arrays, maps, sets and promises hold each integer type at its own size: the items keep their
# bounds and signs through each operation.
int8s: Int8[] = [-128, -1, 0, 127]
int16s: Int16[] = [-32768, -1, 0, 32767]
int32s: Int32[] = [-2147483648, -1, 0, 2147483647]
uint16s: UInt16[] = [0, 1, 65535]
uint32s: UInt32[] = [0, 1, 4294967295]
print int8s
print int16s
print int32s
print uint16s
print uint32s

int16s.push -2
int16s[0] = 12345
print [int16s.pop(), int16s[0], int16s[1]]
print int16s.length
print int8s == [-128, -1, 0, 127]
print int8s == [-128, -1, 0, 126]
print [x.to_int() * 2 for x in int32s]
print [x for x in uint32s when x > 1]

counts: Map<Int16, Int8>
counts[-300] = -5
counts[300] = 5
print [counts[-300]!, counts[300]!]
print counts[1] == nil
print counts.keys().to_array()
seen: Set<UInt16>
seen.add 65535
seen.add 1
print [65535 in seen, 0 in seen]
print [x for x in seen]
by_array: Map<Int8[], String> = { [-1, 2]: 'pair' }
print by_array[[-1, 2]]!

later := (): Promise<Int16> ->
  await sleep(0)
  -32768
main := -> print(await later())
spawn main()

# Keys of each width and sign come back from keys() as they went in, through removals and the
# rebuild that compacts the entries.
wide: Map<UInt32, Int32>
wide[4294967295] = -2147483648
wide[0] = 1
print [wide[4294967295]!, wide[0]!]
print wide.keys().to_array()
small: Map<Int8, Int32>
edges: Int8[] = [-128, -1, 0, 1, 127]
middle: Int8[] = [-1, 0, 1]
for k in edges
  small[k] = k.to_int32() * -1000
small.remove k for k in middle
small[i.to_int8()!] = -i.to_int32()! for i in 2..40
print [small[-128]!, small[127]!, small[39]!]
print small.keys().to_array().length
print ["#{k}: #{v}" for (k, v) in small when k < 0]
negatives := Set<Int32>([-2147483648, -7, 7])
negatives.remove 7
print [x for x in negatives]
