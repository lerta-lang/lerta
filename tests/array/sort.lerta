# sort orders the array itself, equal items keeping their order, after an even number of merges
# and after an odd one, whose result is copied back.
for count in [4, 5]
  pairs := [[2, 0], [1, 1], [2, 2], [1, 3], [1, 4]].take(count).to_array()
  pairs.sort (a, b) -> a[0].compare(b[0])
  print ["#{p[0]}:#{p[1]}" for p in pairs].join(' ')
numbers := [3, 1, 2]
numbers.sort()
print numbers
numbers.sort (a, b) -> b.compare(a)
print numbers
names := ['b', 'c', 'a']
names.sort()
print names
empty: Int[]
empty.sort()
print empty
one := [1]
one.sort()
print one
# Past many merges, of an odd number of them and of an even one, as the last may leave the
# items in the other array.
for count in [100, 200]
  many := [i % 7 * 1000 + (count - i) for i in 0...count]
  many.sort()
  ascending := [many[i] < many[i + 1] for i in 0...(count - 1)].all((x) -> x)
  # The items are distinct, so that as many distinct ones are all of them.
  print ascending and Set<Int>(many).length == count
words := ['dd', 'a', 'ccc', 'bb']
words.sort_by (word) -> word.binary.length
print words
# A compare that throws leaves the items in some order, none lost or repeated, also when it
# throws while the merges write into the array itself.
for failing_call in 1...5
  falling := [4, 3, 2, 1]
  var calls = 0
  try
    falling.sort (a, b) ->
      calls += 1
      throw ValueError(message: 'compare') if calls == failing_call
      a.compare b
  catch _: ValueError
    print falling.sorted()
