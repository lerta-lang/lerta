# An array that Array(n, v) makes is indexed in loops that run to n, a constant and a value known
# only as the program runs, empty too, as it would be by any other bound.
marked := (n: Int, step: Int) ->
  flags := Array(n, false)
  var j = 0
  while j < n
    flags[j] = true
    j += step
  var count = 0
  for i in 0...n
    count += 1 if flags[i]
  count

print marked(10, 3)
print marked(0, 1)
print marked(['a', 'b', 'c', 'd', 'e'].length * 1000, 7)
