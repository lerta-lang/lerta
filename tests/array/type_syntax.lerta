# `T[]` is an array of T, and `T[]?` an optional array.
class A(x: Int)

class B(y: Int)

extend<T> T[]
  second = (): T -> @[1]

const first = <T>(xs: T[]): T -> xs[0]

const ints: Int[] = [1, 2]  # fmt: skip
const absent: Int[]? = nil
const nested: Int[][]? = [[6]]
const optional_lists: Int[]?[] = [nil, [8]]
const grid: Int[][] = [[1], [2, 3]]  # fmt: skip
const pairs: (Int, String)[] = [(1, 'one')]  # fmt: skip
const doubles: ((Int) -> Int)[] = [(n) -> n * 2]
const triple = (n: Int) -> n * 3
const maybe_functions: ((Int) -> Int)?[] = [nil, triple]
const members: (A | B)[] = [A(x: 4), B(y: 5)]
const to_list = (n: Int): Int[] -> [n]  # fmt: skip

print ints.second()
print absent?.length ? -1
print nested?.length ? -1
print optional_lists[1]?.length ? -1
print grid[1].second()
print "#{n} #{name}" for (n, name) in pairs
print doubles[0](21)
print function(2) if const function = maybe_functions[1]
for member in members
  print case member
    when A then member.x
    when B then member.y
print to_list(7)[0]
print first<String[]>([['a']])[0]
