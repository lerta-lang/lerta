# `T[]` is an array of T, and `T[]?` an optional array.
class A(x: Int)

class B(y: Int)

extend<T> T[]
  second = (): T -> @[1]

first := <T>(xs: T[]): T -> xs[0]

ints: Int[] = [1, 2]  # fmt: skip
absent: Int[]? = nil
nested: Int[][]? = [[6]]
optional_lists: Int[]?[] = [nil, [8]]
grid: Int[][] = [[1], [2, 3]]  # fmt: skip
pairs: (Int, String)[] = [(1, 'one')]  # fmt: skip
doubles: ((Int) -> Int)[] = [(n) -> n * 2]
triple := (n: Int) -> n * 3
maybe_functions: ((Int) -> Int)?[] = [nil, triple]
members: (A | B)[] = [A(x: 4), B(y: 5)]
to_list := (n: Int): Int[] -> [n]  # fmt: skip

print ints.second()
print absent?.length ? -1
print nested?.length ? -1
print optional_lists[1]?.length ? -1
print grid[1].second()
print "#{n} #{name}" for (n, name) in pairs
print doubles[0](21)
print function(2) if function := maybe_functions[1]
for member in members
  print case member
    when A then member.x
    when B then member.y
print to_list(7)[0]
print first<String[]>([['a']])[0]
