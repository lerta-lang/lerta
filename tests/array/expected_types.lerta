# `[]` takes its type from wherever an expected type is known.
const sizes = (xs: Array<Int>) -> xs.length
print sizes([])
const make = (): Array<Int> -> []
print make().length
const make_early = (b: Bool): Array<String> ->
  return [] if b
  ['x']
print make_early(true).length
print make_early(false)[0]
var v = [1]
v = []
print v.length
const grid = [[1]]
grid[0] = []
grid.push([])
print grid.length
const chosen: Array<Int> =
  case
    when true then []
    else [1]
print chosen.length
const nested = (): Array<Array<Int>> -> [[], [1]]
print nested()[1][0]
