# `[]` takes its type from wherever an expected type is known.
sizes := (xs: Int[]) -> xs.length
print sizes([])
make := (): Int[] -> []
print make().length
make_early := (b: Bool): String[] ->
  return [] if b
  ['x']
print make_early(true).length
print make_early(false)[0]
var v = [1]
v = []
print v.length
grid := [[1]]
grid[0] = []
grid.push []
print grid.length
chosen: Int[] =
  case
    when true then []
    else [1]
print chosen.length
nested := (): Int[][] -> [[], [1]]
print nested()[1][0]
