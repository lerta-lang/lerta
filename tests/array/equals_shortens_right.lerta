# An item's `equals` that empties the right array, as `==` compares two arrays, leaves the item it
# is given alive, and `==` finds the arrays unequal at the next item.
class K
  args
    s: String
  equals := (other: K) ->
    ys.clear()
    for i in 0..100
      spray.push Other(a: 0x41414141, b: 0x42424242)
    print other.s
    true

class Other
  args
    a: Int
    b: Int

spray: Other[]
xs := [K('a0'), K('a1')]
ys := [K('b0'), K('b1')]
print xs == ys
print ys.length
