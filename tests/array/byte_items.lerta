# Byte and Bool items take one byte each; they are read and written as any other item, past the
# growth of the array and through a map's keys and values.
const bytes: Byte[] = []
bytes.push i.to_byte() for i in 250...256
bytes.push 0
bytes[1] = 7
print bytes.pop()
print b for b in bytes
print bytes.to_binary().length
const flags = [true, false, true, true, false]
flags[0] = false
print flags.pop()
print flag for flag in flags
print [true] == [true]
const counts: Map<Byte, Bool> = { 'a': true, 'b': false }
print key for key in counts.keys()
print counts['b'] ? true
const flag_keys: Map<Bool, Byte> = { true: 1, false: 2 }
print key for key in flag_keys.keys()
const by_bytes: Map<Byte[], Int> = Map()
const bytes_of = (text: String) -> [b for b in text.binary]
by_bytes[bytes_of('ab')] = 1
by_bytes[bytes_of('ac')] = 2
print by_bytes[bytes_of('ac')] ? 0
print bytes_of('ab') == bytes_of('ac')
print [[true, false]] == [[true, true]]
