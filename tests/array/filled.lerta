# `Array(n, value)` makes an array of n copies of the value, of the expected item type or else of
# the value's type: items of each size, values that may be shared, and none; a negative n throws.
enum Suit
  CLUBS
  HEARTS

class Node
  value := 0

struct Link
  value: Int
  next: Link?

struct Point
  x: Int
  y: Int

flags := Array(4, false)
flags[1] = true
print flags
counts := Array(3, 7)
counts[0] += 1
print counts
halves: Float[] = Array(2, 1)
print halves
small: Int32[] = Array(3, -2)
print small
bytes: Byte[] = Array(2, 0xFF)
print bytes
thirds: Float32[] = Array(2, 0.25)
print thirds
sized := Array(counts.length * 2, 'x')
print sized.length
for round in 0..3
  fresh := Array(2, round)
  fresh[0] += 10
  print fresh
names := Array(3, 'a')
names[2] = 'b'
print names
print [point.x + point.y for point in Array(2, Point(x: 1, y: 2))]
print [word for (_, word) in Array(2, (1, 'one'))]
print [line.x + line.y for line in Array(2, { x: 3, y: 4 })]
print [link.value for link in Array(2, Link(value: 1, next: { value: 2, next: nil }))]
print Array(2, Suit.HEARTS)
maybe: String?[] = Array(2, nil)
nodes: Node?[] = Array(2, nil)
nodes[0] = Node()
print [node then node.value else -1 for node in nodes]
print [word else 'nil' for word in maybe]
none := Array(0, 'x')
print none.length
none.push 'y'
print none
grown := Array(1, 5)
grown.push 6 for _ in 0..3
print grown
maybe_counts: Int[]? = Array(2, 0)
print maybe_counts!
nines: Iterable<Int> = Array(2, 9)
print [nine for nine in nines]
suffix := names[0]
built := Array(0, 'x' + suffix)
print built.length
try
  print Array(-1, 'x' + suffix)
catch e: ValueError
  print e.message
try
  print Array(-1, 0)
catch e: ValueError
  print e.message
