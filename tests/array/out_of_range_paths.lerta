# An index out of range throws where the item is read or set while other values are held, and on
# an array that is itself a temporary; an operator assignment that overflows with the index in
# range throws too. Each holds and releases what it should.
show := (label: String, index: Int) -> "#{label} #{index}"
make := -> ['a'.to_string(), 'b'.to_string()]

words := make()
try
  print show(words[0] + 'held', words[9].binary.length)
catch e: IndexError
  print e.message
try
  print make()[5]
catch e: IndexError
  print e.message
try
  words[2] = 'c'.to_string()
catch e: IndexError
  print e.message
counts := [9223372036854775807]
try
  counts[0] += 1
catch e: ArithmeticError
  print e.message
print [words.join(','), counts[0].to_string()]
