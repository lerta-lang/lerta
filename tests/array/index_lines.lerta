# fmt: off
# Line ends inside an index continue it; one before `default` separates a map's default from the
# key, as a comma does.
xs := [1, 2, 3, 4]
a := 1
print xs[a +
  1]
print xs[
  a
]
print xs[a
  + 2]
m: Map<String, Int>
m[
  'k'
  default: 3
] += 1
print m['k']!
print m['k'
  + '', default: 0]
