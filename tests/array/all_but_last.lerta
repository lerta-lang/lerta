# A new array of the items but the last, none for one item or none.
xs := [1, 2, 3]
print [xs.all_but_last(), xs]
empty: Int[]
print [[1].all_but_last(), empty.all_but_last()]
# The array given is a new one: a push onto it leaves the receiver as it was.
kept := xs.all_but_last()
kept.push 9
print [kept, xs]
