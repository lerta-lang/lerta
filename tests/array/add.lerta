# `+` makes a new array, so `+=` leaves another name for the old one as it was.
print [1] + [2, 3]
empty: String[]
print [empty + empty, empty + ['a'], ['a'] + empty]
var xs = [1]
ys := xs
xs += [2]
print [xs, ys]
sum := <T: Add<T, T>>(a: T, b: T) -> a + b
print sum([[1]], [[2, 3]])
xs += xs
print xs
