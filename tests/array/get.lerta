# get gives the item at an index, or nil for one out of range, where indexing throws; of an array
# and of a Binary.
xs := [10, 20, 30]
print xs.get(0) ? -1
print xs.get(2) ? -1
print xs.get(3) ? -1
print xs.get(-1) ? -1
empty: String[]
print empty.get(0) ? 'none'
names := ['a', 'b']
print names.get(1) ? 'none'
bytes := b'ab'
print bytes.get(1) ? 0
print bytes.get(2) ? 0
print bytes.get(-1) ? 0

# A Byte, even with the default: it wraps around.
print (bytes.get(1) ? 0).wrapping_add(250)

print b''.get(0) ? 0
