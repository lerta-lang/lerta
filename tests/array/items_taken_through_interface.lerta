# An array's `pop` through an interface value that the array converts to takes its items out, as a
# direct call does, so that a loop over the array holds the item that it frees.
class Box
  args
    s: String

class Other
  args
    a: Int
    b: Int

interface Popper
  pop: () -> Box

drain := (p: Popper) -> p.pop()

xs := [Box('hello world, this is a string')]
spray: Other[]
for x in xs
  drain xs
  for i in 0..100
    spray.push Other(a: 0x41414141, b: 0x42424242)
  print x.s
