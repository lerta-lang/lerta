# Items of every kind are read, written and pushed in place: Floats, enums, objects, and interface
# values, which the array retains and releases as they are replaced, even by themselves.
enum Color
  RED
  GREEN

interface Named
  name: String

class Tag
  args
    name: String

struct Label
  name: String

floats := [1.5, -2.0]
floats[1] = floats[0] * 2.0
print floats[0]
print floats[1]

colors := [Color.RED]
colors[0] = GREEN
print colors[0] == GREEN

tags := [Tag('a'.to_string())]
tags[0] = tags[0]
print tags[0].name
tags[0] = Tag('b'.to_string())
print tags[0].name

names: Named[] = [Tag('c'.to_string()), Label('d'.to_string())]
names[1] = names[1]
names[0] = names[1]
print names[0].name + names[1].name

floats.push floats[1] + 1.0
colors.push RED
tags.push tags[0]
names.push tags[0]
names.push Label('q'.to_string())
names.push Label("#{i}") for i in 0..10
print floats[2]
print colors[1] == RED
print tags[1].name + names[2].name + names[3].name
print floats.length + colors.length + tags.length + names.length
