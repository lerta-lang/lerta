# Items of every kind are read and written in place: Floats, enums, objects, and interface values,
# which the array retains and releases as they are replaced, even by themselves.
enum Color
  RED
  GREEN

interface Named
  name: String

class Tag
  name: String

struct Label
  name: String

const floats = [1.5, -2.0]
floats[1] = floats[0] * 2.0
print floats[0]
print floats[1]

const colors = [Color.RED]
colors[0] = Color.GREEN
print colors[0] == Color.GREEN

const tags = [Tag(name: 'a'.to_string())]
tags[0] = tags[0]
print tags[0].name
tags[0] = Tag(name: 'b'.to_string())
print tags[0].name

const names: Array<Named> = [Tag(name: 'c'.to_string()), Label(name: 'd'.to_string())]
names[1] = names[1]
names[0] = names[1]
print names[0].name + names[1].name
