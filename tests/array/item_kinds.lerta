# Items of every kind are read, written and pushed in place: Floats, enums, objects, and interface
# values, which the array retains and releases as they are replaced, even by themselves.
enum Color
  RED
  GREEN

interface Named
  name: String

class Tag
  name: String

struct Label
  name: String

const floats = [1.5, -2.0]
floats[1] = floats[0] * 2.0
print floats[0]
print floats[1]

const colors = [Color.RED]
colors[0] = Color.GREEN
print colors[0] == Color.GREEN

const tags = [Tag(name: 'a'.to_string())]
tags[0] = tags[0]
print tags[0].name
tags[0] = Tag(name: 'b'.to_string())
print tags[0].name

const names: Array<Named> = [Tag(name: 'c'.to_string()), Label(name: 'd'.to_string())]
names[1] = names[1]
names[0] = names[1]
print names[0].name + names[1].name

floats.push(floats[1] + 1.0)
colors.push(Color.RED)
tags.push(tags[0])
names.push(tags[0])
names.push(Label(name: 'q'.to_string()))
names.push(Label(name: "#{i}")) for i in 0...10
print floats[2]
print colors[1] == Color.RED
print tags[1].name + names[2].name + names[3].name
print floats.length + colors.length + tags.length + names.length
