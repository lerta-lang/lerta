# An item's `equals` that removes the last item of the left array, as `==` compares two arrays,
# leaves `==` to find the arrays unequal where the left one ends.
class K
  args
    s: String
  equals := (other: K) ->
    xs.pop() if xs.length > 1
    print @s
    @s == other.s

xs := [K('a'), K('b'), K('c')]
print xs == [K('a'), K('b'), K('c')]
print xs == [K('a')]
