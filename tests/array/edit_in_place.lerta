# `reverse` reverses the items in place, `insert` puts one at a place in `0..=length`, `remove_at`
# removes one and gives it, and `clear` removes all; a place out of range throws an IndexError.
xs := [1, 2, 3, 4, 5]
xs.reverse()
print xs
pair := ['a', 'b']
pair.reverse()
print pair
none: Int[]
none.reverse()
print none
one := [7]
one.reverse()
print one
xs.insert 0, 9
xs.insert xs.length, 8
xs.insert 3, 7
print xs
print xs.remove_at(0)
print xs.remove_at(xs.length - 1)
print xs
xs.clear()
print xs
try
  xs.insert 1, 0
catch e: IndexError
  print e.message
try
  xs.insert -1, 0
catch e: IndexError
  print e.message
try
  xs.remove_at 0
catch e: IndexError
  print e.message
try
  xs.remove_at -1
catch e: IndexError
  print e.message
items := [1, 2]
try
  items.insert 3, 0
catch e: IndexError
  print e.message
print items
# Of Strings, which the array holds by reference, as they move.
words := ['a', 'b', 'c', 'd', 'e']
words.reverse()
words.insert 2, 'x'
print words.remove_at(0)
print words
four := ['p', 'q', 'r', 's']
four.reverse()
print four
