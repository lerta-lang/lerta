# A set checks the index and finds the items after its value is computed, and releases the old item
# after storing the new one, so the array may grow or shrink meanwhile, even by a deinit that the
# release runs.
class Item
  args
    grows: Bool
  deinit := ->
    if @grows
      items.push Item(false) for _ in 0..10

grow := (xs: Int[]) ->
  xs.push i for i in 0..100
  7

xs := [1]
xs[0] = grow(xs)
print xs[0] + xs.length

items := [Item(true)]
items[0] = Item(false)
print items.length

words := ['a'.to_string()]
try
  words[1] += 'b'
catch e
  print e.message
print words[0]
