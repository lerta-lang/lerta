# sorted keeps equal items in their order and leaves the array as it is.
const pairs = [[2, 0], [1, 1], [2, 2], [1, 3]]
const by_first = pairs.sorted((a, b) -> a[0].compare(b[0]))
print "#{p[0]}:#{p[1]}" for p in by_first
print pairs[0][0]
const empty: Int[] = []
print empty.sorted((a, b) -> a.compare(b)).length
# Past many merges: a group of each item, taken from i % 7, with the items falling in each group.
const group = (n: Int) -> n / 1000
const many = [i % 7 * 1000 + (99 - i) for i in 0...100]
const ascending = many.sorted((a, b) -> a.compare(b))
print [ascending[i] < ascending[i + 1] for i in 0...99].all((x) -> x)
const by_group = many.sorted((a, b) -> group(a).compare(group(b)))
const in_order = (a: Int, b: Int) -> group(a) < group(b) or (group(a) == group(b) and a > b)
print [in_order(by_group[i], by_group[i + 1]) for i in 0...99].all((x) -> x)
