# sorted keeps equal items in their order and leaves the array as it is.
pairs := [[2, 0], [1, 1], [2, 2], [1, 3]]
by_first := pairs.sorted((a, b) -> a[0].compare(b[0]))
print "#{p[0]}:#{p[1]}" for p in by_first
print pairs[0][0]
empty: Int[]
print empty.sorted().length

# Past many merges: a group of each item, taken from i % 7, with the items falling in each group.
group := (n: Int) -> n / 1000
many := [
  for i in 0..100
    i % 7 * 1000 + (99 - i)
]
ascending := many.sorted()
rising := [
  for i in 0..99
    ascending[i] < ascending[i + 1]
]
print rising.all((x) -> x)
by_group := many.sorted((a, b) -> group(a).compare(group(b)))
in_order := (a: Int, b: Int) -> group(a) < group(b) or (group(a) == group(b) and a > b)
grouped := [
  for i in 0..99
    in_order(by_group[i], by_group[i + 1])
]
print grouped.all((x) -> x)
