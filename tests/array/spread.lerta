const first = [1, 2]
const rest = [3]
print [first..., 0, rest...].length
print ["#{n}" for n in [first..., rest...]].join(',')
const words = ['b', 'c']
print ['a', words..., 'd'].join(',')
print [(w for w in words when w != 'b')..., 'x'].join(',')
const bytes: Byte[] = ['a'.binary..., 0x21]
print bytes.to_binary().text()!
const nested = [[1], [2, 3]]
print [nested..., [4]].length
const empty: Int[] = []
print [empty...].length
const ranged = [
  first...
  rest...
]
print ranged.length
const xs = [1, 2]
print [[xs...]..., 9].length
class Countdown
  from: Int
  iter = -> (@from - i for i in 0...@from)
print ["#{n}" for n in [Countdown(from: 3)..., 0]].join(',')
const make = (more: Int[]) -> [xs..., more...]
print make([5]).length
interface Named
  name: String
struct Dog: Named
  name = 'dog'
const named: Named[] = [[Dog()]...]
print named[0].name
