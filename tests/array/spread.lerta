first := [1, 2]
rest := [3]
print [first..., 0, rest...].length
print ["#{n}" for n in [first..., rest...]].join(',')
words := ['b', 'c']
print ['a', words..., 'd'].join(',')
print [(w for w in words when w != 'b')..., 'x'].join(',')  # fmt: skip
bytes: Byte[] = [b'a'..., 0x21]
print bytes.to_binary().text()!
nested := [[1], [2, 3]]
print [nested..., [4]].length
empty: Int[]
print [empty...].length
ranged := [  # fmt: skip
  first...
  rest...
]
print ranged.length
xs := [1, 2]
print [[xs...]..., 9].length
class Countdown
  args
    from: Int
  iter := -> (@from - i for i in 0..@from)
print ["#{n}" for n in [Countdown(3)..., 0]].join(',')
make := (more: Int[]) -> [xs..., more...]
print make([5]).length
interface Named
  name: String
struct Dog: Named
  name := 'dog'
named: Named[] = [[Dog()]...]
print named[0].name
small: Int8[] = [[1, 2]..., 3]
print small.length
n: Int8 = 2
print n in [[1, 2]..., 3]
print [[2.5]..., 1][1] / 2
print [[1]..., 2.5][0] / 2
deep: Int8[] = [[1, [2]...]..., 3]
print deep.length
give := (): Int8[] -> [[1, 2]...]
print give().length
print n in [[]..., 2]
c: Byte = 3
before: Byte[] = [c, [1, 2]...]
print [[1, 2]..., c].length + before.length
print c in [[b'a']..., 3]
print [[1, 2]..., 3][0] + 1000
