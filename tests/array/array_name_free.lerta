# `Array` is a free name: a class may take it, beside the arrays and their methods.
class Array(size: Int)

extend Array
  map = (f: (Int) -> Int) -> f(@size)

const a: Array = Array(size: 2)  # fmt: skip
print a.map((n) -> n * 10)
const items: Array[] = [a]  # fmt: skip
print items.length
print x for x in [1, 2].map((n) -> n + 1)
