# Arrays of optional values that are not references: numbers, Bool, Char and enums.
enum Color
  RED
  GREEN

shown := <T: Stringable>(items: T?[]) -> [item?.to_string() else 'nil' for item in items]

ints: Int?[] = [1, nil, 3]
print shown(ints)
ints.push nil
ints[0] = nil
ints[1] = 7
print shown(ints)
print ints.pop() == nil
print shown(ints)
print n else -1 for n in ints
print [n else 0 for n in ints]
print shown([byte.hex_value() for byte in b'0x'])
bytes: Byte?[] = [1, nil]
print shown(bytes)
bools: Bool?[] = [true, nil, false]
print shown(bools)
chars: Char?[] = ['a', nil]
print shown(chars)
floats: Float?[] = [1.5, nil]
print shown(floats)
colors: Color?[] = [nil, GREEN]
print shown(colors)

# Equality, hashing, and the methods of std written over arrays.
a: Int?[] = [1, nil]
b: Int?[] = [1, nil]
c: Int?[] = [nil, 1]
print a == b
print a == c
print a.hash() == b.hash()
print ints.contains(nil)
print 5 in ints
print shown(ints.sorted((x, y) -> (x else -1).compare(y else -1)))
seen: Set<Int?[]>
seen.add a
print b in seen
print c in seen
