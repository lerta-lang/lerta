# Arrays and map values compare and hash their items through the runtime, which gives each form of
# item as its word or by its address: integers, words, references, optional values, values in place
# and in a box.
print [1, 2] == [1, 2]
print [1, 2] == [2, 1]
print [1.5] == [1.5]
print [b'a'] == [b'a']
print ['a', 'b'] == ['a', 'b']
print ['a'] == ['b']
small: Int8[] = [3, -1]
print small == [3, -1]
optionals: Int?[] = [1, nil]
print optionals == [1, nil]
print optionals == [nil, 1]
pairs := [(1, 'a')]
print pairs == [(1, 'a')]
print pairs == [(1, 'b')]
flagged: (Int, Int)?[] = [(1, 2), nil]
print flagged == [(1, 2), nil]

print Set([[1, 2], [1, 2], [2]]).length
print Set([['a'], ['a'], ['b']]).length
print Set([optionals, [1, nil]]).length
print Set([pairs, [(1, 'a')]]).length

counts := { 'a': 1 }
print counts == { 'a': 1 }
print counts == { 'a': 2 }
names := { 1: 'x' }
print names == { 1: 'x' }
print names == { 1: 'y' }
maybe: Map<String, Int?> = { 'a': nil }
print maybe == { 'a': nil }
pairs_by_name := { 'a': (1, 'b') }
print pairs_by_name == { 'a': (1, 'b') }
flagged_by_name: Map<String, (Int, Int)?> = { 'a': nil }
print flagged_by_name == { 'a': nil }
small_by_name: Map<String, Int8> = { 'a': -1 }
print small_by_name == { 'a': -1 }

print Set([flagged, [(1, 2), nil]]).length
print [true, false] == [true, false]
print [true] == [false]
nil_by_null: (String, Int)?[] = [('c', 1), nil]
print nil_by_null == [('c', 1), nil]
print Set([nil_by_null, [('c', 1), nil]]).length
print [1] == [1, 2]
empty: Int[]
print empty == []

interface Shape
  area: () -> Int
struct Square: Shape
  side: Int
  area := -> @side * @side
shapes: Shape[] = [Square(2), Square(3)]
shapes.push Square(4)
shapes[0] = Square(5)
print [shape.area() for shape in shapes]
print shapes.pop().area()
