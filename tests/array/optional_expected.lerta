# An array literal takes its item type from an optional array expected: as a declaration's, an
# argument's or a return's type, with items empty, nested or spread.
bytes: Byte[]? = [1, 255]
print (bytes ? []).length
none: Int[]? = []
print (none ? [1]).length
nested: Int[][]? = [[], [1]]
print (nested ? []).length
spread: Byte[]? = [bytes!..., 2]
print (spread ? []).length
count := (xs: Byte[]?) -> (xs ? []).length
print count([3])
made := (): Byte[]? -> [4]
print (made() ? []).length
