# An array literal takes its item type from an optional array expected: as a declaration's, an
# argument's or a return's type, with items empty, nested or spread.
bytes: Byte[]? = [1, 255]
print (bytes else []).length
none: Int[]? = []
print (none else [1]).length
nested: Int[][]? = [[], [1]]
print (nested else []).length
spread: Byte[]? = [bytes!..., 2]
print (spread else []).length
count := (xs: Byte[]?) -> (xs else []).length
print count([3])
made := (): Byte[]? -> [4]
print (made() else []).length
