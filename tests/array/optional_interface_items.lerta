# Arrays of optional interface values, nil among them, written, read, sliced and filled.
interface Named
  name: String

struct Person
  name: String

shown := (items: Named?[]) -> [item?.name else 'nil' for item in items].join(',')

var people: Named?[] = [nil, Person('Ann')]
people.push nil
people.push Person('Bob')
people[0] = Person('Cy')
print shown(people)
print people.pop()?.name else 'nil'
print shown(people[1..])
print [person for person in people when person != nil].length
filled: Named?[] = Array(3, nil)
filled[1] = Person('Di')
print shown(filled)
people.insert 1, nil
print "#{i} #{person?.name else 'nil'}" for person at i in people
nested: Named?[][] = [people, filled]
print nested[1][1]?.name else 'nil'
print people.iter().map((person) -> person != nil).to_array()
found := (name: String): Named? -> name.is_empty() then nil else Person(name)
named := [found(name) for name in ['Ed', '']]
print shown(named)
