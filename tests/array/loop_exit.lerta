# Leaving a loop over an array early releases the array and the current item.
first_long := (words: String[]) ->
  for word in words
    return word if word != 'a'
  'none'
print first_long(['a', 'bb'.to_string(), 'c'])
for word in ['x', 'y'.to_string()]
  break if word == 'x'
var count = 0
for xs in [[1], [2, 3]]
  count += 1
  continue if xs.length < 2
  print xs[1]
print count
