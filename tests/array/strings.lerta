# Arrays of Strings retain their items and release them when dropped or replaced.
const words = ['a', 'b'.to_string(), 3.to_string()]
words.push("#{4}")
words[0] = 'z'.to_string()
print words.join('-')
print words.pop()
print words.join('')
const lines: String[] = []
lines.push("line #{i}") for i in 0...3
print line for line in lines
print lines.join(', ')
const copy = lines
copy.push('shared')
print lines.length
const grid: String[][] = [[], ['x']]
grid[0].push('y')
print grid[0][0] + grid[1][0]
const parts: String[] = []
print parts.join(',') == ''
