# An item's `hash` that empties the array that it is hashed in, as the array is a map key, leaves
# the item alive, and the array's hash ends where the array does.
class K
  args
    s: String
  equals := (other: K) -> @s == other.s
  hash := ->
    ys.clear()
    for i in 0..100
      spray.push Other(a: 0x41414141, b: 0x42424242)
    print @s
    0

class Other
  args
    a: Int
    b: Int

spray: Other[]
ys := [K('b0'), K('b1')]
m: Map<K[], Int>
m[ys] = 1
print m.length
