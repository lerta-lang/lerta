enum Color
  red
  'light blue'
enum Size
  small
  large
enum Mark
  "it's"
  '('

print [1, 2, 3]
# A String is written as a literal that gives it: '...' if it can be, and otherwise "..." with
# escapes.
print ['a', "it's", "a\nb\tc\r", 'back\\slash', 'x#{1}y', "q\"", "\u{1}\u{7F}\0", 'é']  # fmt: skip
print [[1, 2], [], [3]]
print [true, false]
print [0.5, -1.0]
print ['a'.binary[0]]
print [Color.red, Color.parse('light blue')!]
empty: Int[]
print empty
print "#{[1]} and #{['s']}"
print [1, 2].to_string().binary.length

# The items of a type with a to_literal of its own are written by it.
struct P
  v: Int
  to_literal = -> "P(v: #{@v})"
print [P(1)]

print [1e300, 1e-300, 0.1 + 0.2]
print ['a'.binary[0], 255.to_byte()!]
nested_empty: Int[][] = [[]]
print nested_empty
print [["it's"], ['b']]
print [Size.small, large]
print [[Size.large]]
print [Mark.parse("it's")!, Mark.parse('(')!]
print [[Color.red], [Color.parse('light blue')!]]
print [[true], [false]]
print [[0.5]]
print [['a'.binary[0]]]
# The same item type again, whose function is defined once.
print [3, 4]
