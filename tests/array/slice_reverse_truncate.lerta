# A part of an array as a new one, the items in the reverse order, and an array cut to a length.
xs := [1, 2, 3, 4]
print [xs.slice(1), xs.slice(1, 3), xs.slice(4), xs.slice(0, 0), xs.slice(2, 2)]
part := xs.slice(0, 2)
part.push 9
print [xs, part]
print xs.reversed()
