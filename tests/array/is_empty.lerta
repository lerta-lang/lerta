# Whether an array, a map, a set, a String or a Binary holds nothing.
none: Int[]
nothing: Map<String, Int>
print [none.is_empty(), [1].is_empty()]
print [nothing.is_empty(), { 'a': 1 }.is_empty(), Set<Int>().is_empty(), Set([1]).is_empty()]
print [''.is_empty(), 'a'.is_empty(), b''.is_empty(), b'a'.is_empty()]
