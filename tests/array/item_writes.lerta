# Writing the items of an array or the values of a map in a loop leaves the array's length and its
# other items as they were, for items of each size: a Bool, an Int32, a Float32, an Int, a String
# and an interface value.
interface Named
  name: () -> String

struct Cat
  id: Int
  name := -> "cat #{@id}"

flags := [false for _ in 0..6]
for i in 0..flags.length
  if flags.length == 6
    flags[i] = i % 2 == 0
print flags
small: Int32[] = [0, 0, 0]
for i in 0..small.length
  small[i] = (i * 3).to_int32()!
print small
halves: Float32[] = [0.0, 0.0]
for i in 0..halves.length
  halves[i] = (i.to_float() / 2.0).to_float32()
print halves
counts := [0, 0, 0, 0]
for i in 0..10
  counts[i % 4] += i
print counts
words := ['a', 'b']
for i in 0..words.length
  words[i] = words[i] + words[1 - i]
print words
named: Named[] = [Cat(1), Cat(2)]
for i in 0..named.length
  named[i] = Cat(named.length + i)
print [each.name() for each in named]
totals := { 'x': 0, 'y': 0 }
for word in ['x', 'y', 'x']
  totals[word] = totals[word]! + totals.length
print "#{word}=#{total}" for (word, total) in totals
