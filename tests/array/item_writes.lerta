# Writing the items of an array or the values of a map in a loop leaves the array's length and its
# other items as they were, for items of each size: a Bool, an Int32, a Float32, an Int, a String
# and an interface value.
interface Named
  name: () -> String

struct Cat
  id: Int
  name := -> "cat #{@id}"

flags := [false for _ in 0..6]
for i in 0..flags.length
  flags[i] = i % 2 == 0 if flags.length == 6
print flags
small: Int32[] = [0, 0, 0]
small[i] = (i * 3).to_int32()! for i in 0..small.length
print small
halves: Float32[] = [0.0, 0.0]
halves[i] = (i.to_float() / 2.0).to_float32() for i in 0..halves.length
print halves
counts := [0, 0, 0, 0]
counts[i % 4] += i for i in 0..10
print counts
words := ['a', 'b']
words[i] = words[i] + words[1 - i] for i in 0..words.length
print words
named: Named[] = [Cat(1), Cat(2)]
named[i] = Cat(named.length + i) for i in 0..named.length
print [each.name() for each in named]
totals := { 'x': 0, 'y': 0 }
totals[word] = totals[word]! + totals.length for word in ['x', 'y', 'x']
print "#{word}=#{total}" for (word, total) in totals
