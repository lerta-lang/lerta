# An item's `equals` that adds an item to the right array, as `==` compares two arrays, leaves `==`
# to find the arrays unequal, though each pair of items is equal.
class K
  args
    s: String
  equals := (other: K) ->
    ys.push K('c')
    @s == other.s

xs := [K('a'), K('b')]
ys := [K('a'), K('b')]
print xs == ys
print ys.length
