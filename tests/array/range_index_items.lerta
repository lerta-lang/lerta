# A part of an array of references holds the same items, each counted once more, as do parts of
# interface values and of optional ones.
interface Named
  name: String
struct Item
  name: String
names := ['a' + 'b', 'c' + 'd', 'e' + 'f']
print names[1..]
lists := [[1], [2]]
first := lists[...1]
first[0].push(3)
print lists
named: Named[] = [Item(name: 'x'), Item(name: 'y')]
print [each.name for each in named[1..]]
optional: String?[] = ['g', nil]
print optional[..0][0] ? 'none'
empty: Int[]
print [empty[0..], empty[...0]]
print names[3..]
a := 'x'
print [a + 'y', a + 'z'][1..]
struct Pair
  key: String
  value: Int
pairs := [Pair(key: a + '1', value: 1), Pair(key: a + '2', value: 2)]
print [pair.key for pair in pairs[1..]]
tuples := [(a + '3', 3), (a + '4', 4)]
print [key for (key, _) in tuples[..0]]
print [1, 2, 3][...(-1 + 2)]
print names[(1 + 1)..]
print names[1..]
