# The items from a place on are removed and returned, in order; at either end, none or all.
xs := [1, 2, 3, 4]
print [xs.split_off(2), xs]
print [xs.split_off(2), xs]
print [xs.split_off(0), xs]
# The array given is a new one: a push onto it leaves the receiver as it was.
ys := [1, 2, 3]
taken := ys.split_off(1)
taken.push 4
print [taken, ys]
