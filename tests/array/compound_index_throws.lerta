# An array that only the assignment holds is released when its operator throws, and one that a name
# holds is left as it was.
get := -> [9223372036854775807]
try
  get()[0] += 1
catch e: ArithmeticError
  print e.message
xs := get()
try
  xs[0] += 1
catch e: ArithmeticError
  print e.message
print xs[0]
