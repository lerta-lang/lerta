keywords := ['if', 'else', 'while']
var count = 0
limit := 2

is_keyword := (word: String): Bool -> keywords.any((keyword) -> keyword == word)

bump := -> count += 1

maybe: String? = 'x'
first_letter := -> maybe then maybe else '-'

print is_keyword('else')
print is_keyword('for')
bump()
bump()
print count
print count >= limit
print first_letter()

struct Counter
  step: Int
  next = (n: Int) -> n + @step * limit
print Counter(3).next(1)
