const keywords = ['if', 'else', 'while']
var count = 0
const limit: Int = 2

const is_keyword = (word: String): Bool -> keywords.any((keyword) -> keyword == word)

const bump = ->
  count += 1

const maybe: String? = 'x'
const first_letter = (): String -> maybe then maybe else '-'

print is_keyword('else')
print is_keyword('for')
bump()
bump()
print count
print count >= limit
print first_letter()

struct Counter
  step: Int
  next = (n: Int): Int -> n + @step * limit
print Counter(step: 3).next(1)
