# A const whose value is a literal of its own type, a Bool, a number of any size or a String, is
# initialized from the start: a function reads it before the top-level code reaches it, and a
# deinit after it is released at the end, here of `_keeper`, initialized before it, so released
# after it. One of another type, as an optional or a Char, or whose value is no literal throws as
# any other value does.
import EDGE from './lib/literal_consts'

class Keeper
  deinit = -> print("at the end: #{show()}")

_keeper := Keeper()

show := (): String -> "#{LIMIT} #{RATE} #{HALF} #{ON} #{NAME} #{EDGE} #{sized()}"

sized := -> "#{BYTE} #{SMALL} #{SINGLE} #{WHOLE}"

read_maybe := (): void ->
  try
    print MAYBE ? 0
  catch e: InitError
    print e.message

read_sum := (): void ->
  try
    print SUM
  catch e: InitError
    print e.message

read_letter := (): void ->
  try
    print LETTER
  catch e: InitError
    print e.message

print show()
read_maybe()
read_sum()
read_letter()
LIMIT := 3
RATE := 2.5
HALF: Float = 1
ON := true
NAME := 'name'
BYTE: Byte = 200
SMALL: Int8 = -5
SINGLE: Float32 = 1.5
WHOLE: Float32 = 2
MAYBE: Int? = 4
SUM := 1 + 2
LETTER: Char = 'c'
read_maybe()
read_sum()
read_letter()
