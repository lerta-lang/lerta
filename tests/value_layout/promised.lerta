# A Promise holds a value that is its result in a box, as an item, and gives it back once settled.
import spawn from 'std:async'
import sleep from 'std:time'

work := (n: Int): Promise<{ n: Int, s: String }> ->
  await sleep(0)
  { n, s: "x#{n}" }

maybe := (n: Int): Promise<(String?, Int)?> ->
  await sleep(0)
  n > 0 then ('m', n)

main := ->
  print await work(2)
  (letter, count) := (await maybe(3))!
  print "#{letter!} #{count} #{await maybe(0) == nil}"

spawn main()
