# An optional value with a reference that is not optional, or an interface value, is nil by its
# null, in the size of the value, through nested values and optional type arguments too.
pair := (n: Int) -> (n, "x#{n}")

var nested: { inner: (Int, String), flag: Bool }? = { inner: pair(1), flag: true }
print nested!.inner
nested = nil
print nested == nil

var shown: { text: Stringable }? = { text: 'shown' }
print shown!.text.to_string()
shown = nil
print shown == nil

first_of := <T>(items: T[]): T? -> items.first()
maybes: (Int, String)?[] = [nil, pair(2)]
print first_of(maybes[1..])!

# The niche may be a field other than the first, and compares as nil only where it is null.
second: { a: String?, b: String }? = { a: nil, b: 'b' }
other: { a: String?, b: String }? = { a: nil, b: 'b' }
print "#{second == other} #{second != nil} #{second == nil}"

var maybe: (Int, String)? = pair(3)
print maybe else pair(0)
maybe = nil
print maybe else pair(0)

# Inside a generic function, a present nil of an optional type argument stays apart from nil.
count_some := <T>(items: T[]) ->
  var count = 0
  for item in items
    held: T? = item
    count += 1 if held != nil
  count
pairs: (Int, String)?[] = [nil, pair(4), nil]
texts: { text: Stringable }?[] = [nil, { text: 't' }]
print "#{count_some(pairs)} #{count_some(texts)}"
