# A search passes over the bytes that no match may start with, where no thread is alive, and finds
# what it would without: a start beyond ASCII, by its lead byte; a start after an assertion, which
# may hold; a class that holds code points beyond ASCII; a fold beyond ASCII; and a pattern that
# matches the empty text, which may start anywhere, the end too.
cases := [
  (/é+/, 'abc déé x')
  (/[à-ê]x/, 'aaa êx')
  (/(?i)k+/, "ab \u{212A}k")
  (/\bfoo/, 'xfoo foo')
  (/(?m)^b/, "ab\nb")
  (/\Ab/, 'ab')
  (/x*/, 'abc')
  (/x*$/, 'abc')
  (/(a|b)?c/, 'zzc')
  (/[^a]/, 'aaé')
  (/\P{L}/, 'abc1')
  (/z/, 'abc')
  (/[\u{10000}-\u{10FFFF}]/, 'ab😀')
  (/\B./, 'ab c')
  (/(?i)ſ/, 'xS')
  (/(|a)b/, 'zzab')
]
for (re, text) in cases
  result :=
    if found := re.find(text)
      "#{found.text().to_literal()} after #{found.before().count()}"
    else
      '-'
  print "#{re.pattern}: #{result}"
print [m.text() for m in /é|b/.find_all('aébxé')]
print [m.text() for m in /x*/.find_all('ab')]
print [m.text() for m in /a|/.find_all('ba')]
