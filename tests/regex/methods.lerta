# The methods of a Regex and of a Match. find_all goes on after an empty match a code point on, and
# after another at its end, where an empty match may follow it, as JavaScript does; split, as
# JavaScript's, splits nothing off at an empty match at the end or where a piece starts; replace
# takes its text as it is. A pattern that backtracking takes exponential time over is matched in
# linear time.

all := (pattern: String, text: String) -> [m.text for m in Regex(pattern).find_all(text)]
print all('\d+', 'a1b22c333')
print all('a*', 'baaac')
print all('x*', 'aé')
print all('x*', '')
print all('\b', 'ab cd')
print all('(?m)^', "a\nb\n")

split := (pattern: String, text: String) -> Regex(pattern).split(text)
print split(',', 'a,b,,c')
print split(',', ',a,')
print split(',', '')
print split('x*', 'abc')
print split('x*', 'aé')
print split('\s+', '  a b  ')
print split('', 'ab')
print split('b*', 'abba')
print split('x*', '')
print split('[\d-]', 'a1-b')

re := Regex('(\w)(\d)?')
print re.replace('a1 b c2', '[$1]')
print re.replace('a1 b c2', (m) -> "<#{m.groups[2] else '-'}#{m.groups[1]!}>")
print Regex('x*').replace('ab', '-')
print Regex('a*').replace('baaac', (m) -> "<#{m.text}>")
print Regex('\d').replace('none here', '#')

found := Regex('(?<word>[a-z]+)(?<number>\d+)?').find('42 ab end')!
print "#{found.text} [#{found.before()}] [#{found.after()}]"
print found.named('word') else 'nil'
print found.named('number') else 'nil'
try
  print found.named('other') else 'nil'
catch e: ValueError
  print e.message
print Regex('é').find('aéb')!.after()

print Regex('b+').test('abbc')
print Regex('^b').test('abbc')
print Regex('(?i)K').pattern
print Regex('('.repeat(1000) + 'a' + ')'.repeat(1000)).find('xa')!.groups.length
print Regex('(a*)*b').test('a'.repeat(5000))
print Regex('(a|aa)*c').test('a'.repeat(5000))

# Flags apply to the whole pattern, as `(?ims)` before it would.
flagged := Regex(pattern: '^b.c$', flags: 'ms')
print "#{flagged.pattern} #{flagged.flags} #{flagged.test("a\nb\nc")}"
print Regex(pattern: 'hello', flags: 'i').test('HELLO')
print Regex(pattern: '(?-i)h', flags: 'i').test('H')
print Regex(pattern: '^b$', flags: 'm').test("a\nb")
print Regex(pattern: 'a.b', flags: 's').test("a\nb")
print Regex(pattern: 'a', flags: '').flags.is_empty()
print Regex(pattern: 'A.B', flags: 'si').flags
for flags in ['x', 'ii']
  try
    print Regex(flags, pattern: 'a').flags
  catch e: ValueError
    print e.message
try
  print Regex(pattern: 'é', flags: 'i').pattern
catch e: ValueError
  print e.message
try
  print Regex(pattern: '(', flags: 'x').pattern
catch e: ValueError
  print e.message
