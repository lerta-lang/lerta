# The methods of a Regex and of a Match. find_all goes on after an empty match a code point on, and
# after another at its end, where an empty match may follow it, as JavaScript does; split, as
# JavaScript's, splits nothing off at an empty match at the end or where a piece starts; replace
# takes its text as it is. A pattern that backtracking takes exponential time over is matched in
# linear time.
import compile from 'std:regex'

all := (pattern: String, text: String) -> [m.text for m in compile(pattern).find_all(text)]
print all('\d+', 'a1b22c333')
print all('a*', 'baaac')
print all('x*', 'aé')
print all('x*', '')
print all('\b', 'ab cd')
print all('(?m)^', "a\nb\n")

split := (pattern: String, text: String) -> compile(pattern).split(text)
print split(',', 'a,b,,c')
print split(',', ',a,')
print split(',', '')
print split('x*', 'abc')
print split('x*', 'aé')
print split('\s+', '  a b  ')
print split('', 'ab')
print split('b*', 'abba')
print split('x*', '')
print split('[\d-]', 'a1-b')

re := compile('(\w)(\d)?')
print re.replace('a1 b c2', '[$1]')
print re.replace_with('a1 b c2', (m) -> "<#{m.groups[2] else '-'}#{m.groups[1]!}>")
print compile('x*').replace('ab', '-')
print compile('a*').replace_with('baaac', (m) -> "<#{m.text}>")
print compile('\d').replace('none here', '#')

found := compile('(?<word>[a-z]+)(?<number>\d+)?').find('42 ab end')!
print "#{found.text} [#{found.before()}] [#{found.after()}]"
print found.named('word') else 'nil'
print found.named('number') else 'nil'
try
  print found.named('other') else 'nil'
catch e: ValueError
  print e.message
print compile('é').find('aéb')!.after()

print compile('b+').test('abbc')
print compile('^b').test('abbc')
print compile('(?i)K').pattern
print compile('('.repeat(1000) + 'a' + ')'.repeat(1000)).find('xa')!.groups.length
print compile('(a*)*b').test('a'.repeat(5000))
print compile('(a|aa)*c').test('a'.repeat(5000))
