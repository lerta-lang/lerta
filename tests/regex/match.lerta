# What each pattern matches first in the text, and its groups, nil for a group that took no part;
# `-` where nothing matches. The leftmost match wins, and among those at one place the one that
# backtracking would find first: alternatives in order, greedy repeats as long as they go, lazy
# ones as short. Code points beyond ASCII are matched whole.
import compile from 'std:regex'

shown := (groups: String?[]) -> [g?.to_literal() else 'nil' for g in groups].join(' ')

cases :=
  ('abc', 'xabcx')
  ('a.c', 'abc')
  ('a.c', "a\nc")
  ('(?s)a.c', "a\nc")
  ('\.', 'a.b')
  ('[a-c]+', 'xxbcay')
  ('[^a-c]+', 'abxyc')
  ('[]a]+', 'x]a]')
  ('[a-]+', 'x-a-')
  ('[\d.]+', 'v1.25x')
  ('\d+', 'ab123')
  ('\D+', '12ab3')
  ('\w+', '..a_1..')
  ('\W+', 'ab.,cd')
  ('\s+', "a \t\u{3000}b")
  ('\S+', '  ab  ')
  ('\x41\x{263A}', 'xA☺')
  ('\n', "a\nb")
  ('é+', 'aéééb')
  ('[α-ω]+', 'abγδεz')
  ('.', '☺')
  ('[^a]', '☺')
  ('^a', 'ba')
  ('a$', 'ab')
  ('a$', "a\n")
  ('(?m)^b$', "a\nb\nc")
  ('(?m)^', 'x')
  ('\Aa', 'aa')
  ('a\z', 'aa')
  ('\bfoo\b', 'a foo b')
  ('\bfoo\b', 'afoob')
  ('\Boo\B', 'afoob')
  ('\b', 'é')
  ('a|ab', 'ab')
  ('ab|a', 'ab')
  ('(a|ab)(c|bcd)(d*)', 'abcd')
  ('a*', 'baaa')
  ('a+', 'baaa')
  ('a+?', 'aaa')
  ('a*?b', 'aaab')
  ('a??b', 'ab')
  ('a{2}', 'aaaa')
  ('a{2,}', 'aaaa')
  ('a{2,3}', 'aaaa')
  ('a{2,3}?', 'aaaa')
  ('a{0}b', 'ab')
  ('x{2', 'x{2')
  ('a{,2}', 'a{,2}')
  ('(a*)*', 'b')
  ('(a*)+', 'b')
  ('(|a)*', 'aa')
  ('(a|)*', 'aa')
  ('(a?)*?b', 'aab')
  ('(a)(b)?', 'a')
  ('(?:ab)+', 'abab')
  ('(?P<x>a)(?<y>b)', 'ab')
  ('((a)|(b))+', 'ab')
  ('(a)|(b)', 'b')
  ('(?i)hello', 'HeLLo')
  ('(?i)[a-c]+', 'xAbC')
  ('(?i)k', "\u{212A}")
  ('(?i)S', "\u{17F}")
  ('(?i:a)b', 'AB')
  ('(?i:a)b', 'Ab')
  ('a(?i)b|c', 'C')
  ('(?i)a(?-i)b', 'AB')
  ('(?i)a(?-i)b', 'Ab')
  ('(?ms)^a.b$', "x\na\nb")
  ('[\x41-\x5A]+', 'aMZb')
  ('(?i)[\x41-\x5A]+', '1mZb2')
  ('(?i)[a-\x7A]+', '1MZ2')
  ('(?i)[\.k]+', "x.K\u{212A}y")
  ('(?i)\x41', 'a')
  ('[\d-]+', 'a1-2b')
for (pattern, text) in cases
  found := compile(pattern).find(text)
  print "#{pattern} #{text.to_literal()}: #{found then shown(found.groups) else '-'}"
