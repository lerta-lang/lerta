# A regular expression literal is a Regex, compiled as the program is: its pattern as written, a
# `\/` too, and its flags, the letters right after it. A `/` starts one where no value is before it,
# and after a value where whitespace is before it and none after, as a call's argument; any other
# `/` divides.
re := /(?<key>\w+)\s*=\s*(\d+)/
found := re.find('width = 42')!
print "#{found.named('key')!} #{found.groups[2]!} #{re.pattern} [#{re.flags}]"
print /a\/b/.test('xa/by')
print /a\/b/.pattern
print /[\/]+/.find('a//b')!.text
print /a\\/.test('a\')
print /hello/i.test('HELLO')
print /^b.c$/ms.test("a\nb\nc")
print /^b.c$/ms.flags
print [m.text for m in /\d/.find_all('a1b2')]
print [/a/, /b/i].map((r) -> r.test('AB')).to_array()
print /\d+/.find('ab12')!.text
show := (r: Regex) -> print(r.pattern)
show /x+y/
print /x/.find('axb')!.groups
print /a\\\/b/.test('a\/b')
print "#{/a/.test('cat')} #{/é+/.find('aéé')!.text}"
words := ['ab', 'b']
print [
  words[0]
  /b/.pattern
]
many := (texts: String[]) ->
  [
    for text in texts
      /b+/.find(text)?.text else '-'
  ]
print many(['abb', 'c', 'bbb'])

# Division, spaced and not, and after a value as `x / y` is.
total := 10
count := 2
print total / count
print total / count / 1
print (total + 0) / count
print [total][0] / count

# A literal is made once, where it is first evaluated, and is the same Regex each time after.
same := -> /once/
print same() == same()
regexes := [/in loop/ for _ in 0..3]
print regexes[0] == regexes[1] and regexes[1] == regexes[2]
