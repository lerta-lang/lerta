# A Regex searches again and again with the same threads: a search after another, of any outcome,
# on a longer or a shorter text, or within the loop of its own find_all, finds what a Regex of its
# own would.
re := /(\w+)=(\d+)?/
show := (text: String) ->
  found := re.find(text) else return print("#{text.to_literal()}: -")
  print "#{text.to_literal()}: #{[g else 'nil' for g in found.groups]}"
show 'a long text with key=42 in it'
show 'none'
show 'k='
show 'x=7'
print "#{re.test('...')} #{re.test('y=1')}"
for found in re.find_all('a=1 b= c=3')
  inner := re.find('z=9')!
  print "#{found.text} #{inner.text} #{re.test('-')}"

# A SAVE in a loop gives its slot back across alternatives, and assertions read the text at hand.
loop := /((a)|b)*c\b/
print [g else 'nil' for g in loop.find('xabac abc')!.groups]
print [g else 'nil' for g in loop.find('bbc')!.groups]
edge := /^\w+$/
print "#{edge.test('long word here')} #{edge.test('ab')} #{edge.test('a b')} #{edge.test('abc')}"
