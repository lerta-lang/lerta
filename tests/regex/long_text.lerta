# A long text, past what backtracking searches, is searched by the Pike VM, and a short one by
# backtracking: both find the same matches and groups.
patterns :=
  /(\w+)=(\d+)?/
  /\b(?:GET|POST) \/(\w+)/
  /(a|ab)(c|bcd)(d*)/
  /x*/
  /é+/
  /zz/
  /(a*)*/
  /(|a)+/
  /(a|)+b/
  /(a|ab)*?(b*)/
  /(a*?)(a*)/
  /((a)|b)*c/
  /[a-zé]+/
  /[^\s\d.]+/
  /[=-é]+/
  /(ab|cd)+?d?/
  /(\b(a)|b)+c/
short := 'k= GET /items abcd x=42 éé aab abbc'
padding := 300000
long := '.'.repeat(padding) + short
shown := (re: Regex, text: String) ->
  if found := re.find(text)
    groups := [g else 'nil' for g in found.groups()]
    "#{groups} after #{found.before().count() % padding}"
  else
    '-'
for re in patterns
  print "#{re.pattern}: #{shown(re, short)} #{shown(re, long)}"
  short_texts := [m.text() for m in re.find_all(short)]
  long_texts := [m.text() for m in re.find_all(long)]
  print short_texts == long_texts[(long_texts.length - short_texts.length)..]

# Texts right at the most pairs that backtracking follows and just past it, where either search
# finds the same: the program of `(a|b)+c` has 6 joins, so a text of 43689 bytes is the longest
# that backtracking searches, and that of `c`, a literal, has the start alone, so one of 262143.
for (re, longest) in [(/(a|b)+c/, 43689), (/c/, 262143)]
  for length in [longest - 1, longest, longest + 1]
    text := 'b'.repeat(length - 3) + 'abc'
    print [m.text().count() for m in re.find_all(text)]

# Classes at the edges of ASCII and between the two words of its bits, on a short text and on a
# long one.
edges := "a?@AB\x7F\u{80}é"
for re in [/[?-A]+/, /[\u{7F}-\u{80}]+/, /[^a-z?.]+/]
  for text in [edges, '.'.repeat(padding) + edges]
    print [m.text() for m in re.find_all(text)]

# A nested loop over a short text with no match, which backtracking ends.
print /(a*)*b/.test('a'.repeat(5000))
