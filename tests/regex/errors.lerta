# An invalid pattern throws a ValueError that says why and at which column, counted in code points:
# what RE2 rejects, what it has and Regex does not (lookaround, backreferences, POSIX classes,
# scripts), and its other forms of what Regex writes one way (`\pL`, `\p{^L}`, `\x{...}`). A
# message is cut to its first 100 code points, as the pattern of one nested too deeply is long.
patterns :=
  '('
  'a(b'
  ')'
  'a)'
  '[a'
  '[]'
  '*'
  'a|*'
  'a**'
  'a*+'
  'a{2}{3}'
  'a{1001}'
  'a{2,1001}'
  'a{3,2}'
  '(?=a)'
  '(?!a)'
  '(?<=a)'
  '(?<!a)'
  '\1'
  '\k<x>'
  '\pL'
  '\p{^L}'
  '\PL'
  '\P{^L}'
  '\p{Xx}'
  '\p{Greek}'
  '\p{}'
  '\p{L'
  '\p{Cn}'
  '[\p{L}-z]'
  '[a-\p{L}]'
  '[\pL]'
  '[\p{Xx}]'
  '\q'
  'a\'
  '\x'
  '\xZ1'
  '\x4'
  '\x80'
  '\xFF'
  '\x{41}'
  '\u'
  '\u41'
  '\u{}'
  '\u{41'
  '\u{4G}'
  '\u{110000}'
  '\u{D800}'
  '[z-a]'
  '[a-\d]'
  '[[:alpha:]]'
  '(?<n>a)(?<n>b)'
  '(?<>a)'
  '(?<a-b>c)'
  '(?<é>c)'
  '(?P=n)'
  '(?x)'
  '(?)'
  '(?i-)'
  '(?--i)'
  '(?'
  '(?i'
  '[\b]'
  'é('
  '(a{1000}){1000}'
  '[\d-z]'
  '[\d-'
  '[a\w-z]'
  '('.repeat(1001)
  '(?:'.repeat(1001)
for pattern in patterns
  try
    Regex pattern
    print "#{pattern}: accepted"
  catch e: ValueError
    print e.message.take(100).join()
