# Leaks only a cycle whose objects are of many types, as test/cli.lerta runs it: the debug runtime
# reports each type's objects once, by its name, and nothing else, since all that is left is
# unreachable.
import Deferred from 'std:async'

class Node
  weak parent: Node? = nil
  children: Map<String, Node> = Map()
  values: (Int | Node)[] = []
  label = ''
  count: (() -> Int)? = nil
  first: (() -> Int)? = nil
  names: Iter<String>? = nil
  settled = Deferred<Node>()

make_cycle := (n: Int) ->
  root := Node()
  child := Node()
  child.parent = root
  child.label = "child #{n}"
  root.children['child'] = child
  child.values.push n
  child.values.push root
  var calls = n
  root.count = ->
    calls += 1
    calls
  child.first = -> n
  child.names = root.children.keys()
  child.settled.resolve root
  _promise := child.settled.promise()

make_cycle 1
