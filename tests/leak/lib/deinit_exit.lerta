# Exits from a deinit while other objects are queued to be dropped, as test/cli.lerta runs it: the
# debug runtime reports none of them, since they are released, not leaked.
import exit from 'std:process'

class Ender
  deinit = ->
    try
      exit 5
    catch error
      print error.message

class Plain
  name = 'plain'

drop_both := ->
  _objects: (Ender | Plain)[] = [Plain(), Plain(), Ender()]

drop_both()
