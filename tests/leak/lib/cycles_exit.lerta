# Leaks a cycle, then exits from a function that awaits while another waits, holding a cycle of its
# own, as test/cli.lerta runs it: the debug runtime reports only the objects of the leaked cycle,
# and not those still in use, as the waiting function's.
import exit from 'std:process'
import sleep from 'std:time'

class Node
  var next: Node? = nil
  name: String

make_cycle := ->
  a := Node('a')
  b := Node('b')
  a.next = b
  b.next = a
  a

wait_long := ->
  held := make_cycle()
  await sleep(1000.0)
  print held.name

exit_soon := (node: Node): Promise ->
  await sleep(0.01)
  exit 3

make_cycle()
kept := Node('kept')
kept.next = Node('also kept')
_waiting := wait_long()
await exit_soon(kept)
