# Leaks two cycles, of objects and of a closure that captures @, and a function that awaits a
# promise that is never settled, as test/cli.lerta runs it: the debug runtime reports the objects
# that only the cycles hold, by type, and the rest left alive.
import Deferred from 'std:async'

class Node
  next: Node? = nil

class Button
  listeners: (() -> void)[] = []
  count = 0

  watch = -> @listeners.push(-> @count += 1)

make_cycles := ->
  a := Node()
  b := Node()
  a.next = b
  b.next = a
  Button().watch()

wait := (deferred: Deferred<Int>): Promise -> await deferred.promise()

make_cycles()
_waiting := wait(Deferred<Int>())
