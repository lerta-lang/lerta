# An exception releases what the code holds on its way: the values of the expression it leaves,
# the locals of the functions it leaves, and the fields of an object being constructed.
struct Oops
  message: String

class Resource
  name: String
  deinit = -> print "closing #{@name}"

const fail = (): String -> throw Oops(message: 'oops')
const join = (a: String, b: String) -> a + b

class Built
  first = Resource(name: 'first')
  second: String = fail()
  deinit = -> print 'never built'

const attempt = (label: String, run: () -> void) ->
  try
    run()
  catch e
    print "#{label}: #{e.message}"

attempt 'arguments', -> print join('a' + 'b', fail())
attempt 'array', -> print ['x', 'y' + 'z', fail()].length
attempt 'map', -> print { 'k' + '1': 'v', 'k2': fail() }.length
attempt 'record', -> print { a: 'a' + 'b', b: fail() }.a
attempt 'interpolation', -> print "#{'a' + 'b'} #{fail()}"
attempt 'concatenation', -> print ('a' + 'b') + fail()
attempt 'index', -> print [['a' + 'b']][fail().binary.length].length
attempt 'local', ->
  const held = Resource(name: 'local')
  print held.name + fail()
attempt 'constructor', -> print Built().second
attempt 'comprehension', -> print [x + fail() for x in ['a', 'b']].length
attempt 'map closure', -> print ['a'].map((x) -> x + fail()).to_array().length
attempt 'filter closure', -> print ['a'].filter((x) -> fail() == x).to_array().length
