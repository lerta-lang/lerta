# An init that lets its object escape and throws, in a constructor that a deinit calls, during a
# drop, stops the program as anywhere else.
struct Stop: Error
  message: String

const kept: Node[] = []

class Node
  init = ->
    kept.push @
    throw Stop(message: 'in drop')

class Cleaner
  deinit = ->
    try
      const _n = Node()
    catch e: Stop
      print e.message

const make_cleaner = -> Cleaner()
make_cleaner()
