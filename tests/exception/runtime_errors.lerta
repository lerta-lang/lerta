# The runtime's errors are of types of std:builtins, one for each kind, which catch takes.
import read_file, write_file from 'std:io'

attempt := (label: String, run: () -> void) ->
  try
    run()
  catch e: IndexError
    print "#{label}: IndexError #{e.message}"
  catch e: ArithmeticError
    print "#{label}: ArithmeticError #{e.message}"
  catch e: NilError
    print "#{label}: NilError #{e.message}"
  catch e: CastError
    print "#{label}: CastError #{e.message}"
  catch e: IterError
    print "#{label}: IterError #{e.message}"
  catch e: WeakError
    print "#{label}: WeakError #{e.message}"

xs := [1, 2]
attempt 'index', -> print(xs[5])
attempt 'index assignment', -> xs[4] = 1
attempt 'compound assignment', -> xs[4] += 1
attempt 'binary index', -> print(b'ab'[7])
attempt 'slice', -> print(b'abc'[2..9].length)
attempt 'pop', ->
  empty: Int[]
  print empty.pop()
attempt 'overflow', -> print(9223372036854775807 + xs[0])
attempt 'zero', -> print(1 / (xs[0] - 1))
attempt 'nil', ->
  n: Int? = nil
  print n!
struct A
  name: String
struct B
  name: String
attempt 'cast', ->
  value: A | B = A('a')
  print (value as B!).name
attempt 'second traversal', ->
  it := (x for x in xs)
  print x for x in it
  print x for x in it
attempt 'next past the end', ->
  it := (x for x in xs)
  it.next()
  it.next()
  print it.next()
class Node
  next: Node?
class Holder
  weak node: Node!
holder := ->
  node := Node(next: nil)
  Holder node
attempt 'weak', -> print(holder().node.next == nil)
# Files are read and written on the event loop, so their errors come through await.
try
  print (await read_file('/no/such/file')).length
catch e: IOError
  print "read: IOError #{e.message}"
try
  await write_file('/no/such/dir/file', b'x')
catch e: IOError
  print "write: IOError #{e.message}"
