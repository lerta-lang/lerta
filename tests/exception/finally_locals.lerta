# A finally block is a scope of its own, on the normal path and on that of an exception that goes
# on, wherever the try is; its locals are released at its end.
import sleep from 'std:time'

struct Oops: Error

const run = (label: String, body: () -> void) ->
  try
    body()
  catch e
    print "#{label} outside: #{e.message}"

run 'normal', ->
  try
    print 'body'
  finally
    const note = ['done']
    print note[0]
run 'unwinding', ->
  try
    throw Oops(message: 'a')
  finally
    const note = ['unwinding']
    print note[0]
run 'throws', ->
  try
    print 'body'
  finally
    const note = ['thrown']
    throw Oops(message: note[0])
run 'captured', ->
  try
    throw Oops(message: 'c')
  catch e: Oops
    const caught = [e.message]
    print "caught #{caught[0]}"
  finally
    var n = ['n']
    n = ['m']
    const k = -> n[0]
    print k()
run 'captured unwinding', ->
  try
    throw Oops(message: 'd')
  finally
    var n = ['n']
    n = ['m']
    const k = -> n[0]
    print k()
run 'loop', ->
  for i in 0...2
    try
      print "iteration #{i}"
    finally
      const note = "#{['after'][0]} #{i}"
      print note
run 'value', ->
  const value =
    try
      ['value']
    finally
      const note = ['kept']
      print note[0]
  print value[0]

const numbers = () ->
  yield 1
  try
    print 'generator body'
  finally
    const note = ['generator done']
    print note[0]
  yield 2
print n for n in numbers()

const later = ->
  await sleep(0)
  try
    print 'async body'
  finally
    const note = ['async done']
    print note[0]
await later()

const note = 'outer'
try
  print 'top level'
finally
  const note = ['inner']
  print note[0]
print note
