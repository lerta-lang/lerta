# A finally block is a scope of its own, on the normal path and on that of an exception that goes
# on, wherever the try is; its locals are released at its end.
import sleep from 'std:time'

struct Oops: Error

run := (label: String, body: () -> void) ->
  try
    body()
  catch e
    print "#{label} outside: #{e.message}"

run 'normal', ->
  try
    print 'body'
  finally
    note := ['done']
    print note[0]
run 'unwinding', ->
  try
    throw Oops('a')
  finally
    note := ['unwinding']
    print note[0]
run 'throws', ->
  try
    print 'body'
  finally
    note := ['thrown']
    throw Oops(note[0])
run 'captured', ->
  try
    throw Oops('c')
  catch e: Oops
    caught := [e.message]
    print "caught #{caught[0]}"
  finally
    var n = ['n']
    n = ['m']
    k := -> n[0]
    print k()
run 'captured unwinding', ->
  try
    throw Oops('d')
  finally
    var n = ['n']
    n = ['m']
    k := -> n[0]
    print k()
run 'loop', ->
  for i in 0...2
    try
      print "iteration #{i}"
    finally
      note := "#{['after'][0]} #{i}"
      print note
run 'value', ->
  value :=
    try
      ['value']
    finally
      note := ['kept']
      print note[0]
  print value[0]

numbers := ->
  yield 1
  try
    print 'generator body'
  finally
    note := ['generator done']
    print note[0]
  yield 2
print n for n in numbers()

later := ->
  await sleep(0)
  try
    print 'async body'
  finally
    note := ['async done']
    print note[0]
await later()

note := 'outer'
try
  print 'top level'
finally
  note := ['inner']
  print note[0]
print note
