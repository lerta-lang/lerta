# throw takes a value of a type that satisfies Error; catch takes it back by its type, by a union of
# types, or any; try gives a value.
struct NotFound
  message: String

class Fail
  message: String

const find = (key: String): Int ->
  throw NotFound(message: "no #{key}") if key != 'a'
  1

const r =
  try
    find('b')
  catch e: NotFound
    print e.message
    0
print r
try
  throw Fail(message: 'boom')
catch e: NotFound | Fail
  print "caught #{e.message}"
finally
  print 'finally'
try
  find('c')
catch e
  print "any #{e.message}"
