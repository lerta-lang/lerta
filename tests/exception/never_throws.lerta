const fail = (message: String): never -> throw IndexError(message)  # fmt: skip
const pick = (n: Int) -> n > 0 then n else fail('not positive')
const call_value = (f: (String) -> never) -> f('through a value')

try
  print pick(2)
  print pick(0)
catch e: IndexError
  print e.message
try
  call_value fail
catch e: IndexError
  print e.message
