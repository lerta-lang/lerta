# A deinit that runs while an exception is on its way, as an argument is released after the call
# that threw, runs its code in full.
class E: Error
class R
  name: String
  deinit = -> print("deinit #{@name}")
use := (r: R): Int -> throw E(message: 'x')
try
  print use(R(name: 'arg'))
catch e
  print e.message
