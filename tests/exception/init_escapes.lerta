# An init that throws after it let its object escape, here through a method, stops the program,
# since freeing the object would leave what holds it with a freed one.
struct Stop(message: String): Error

class Registry
  items: Node[] = []

const registry = Registry()

class Node
  name: String
  register = -> registry.items.push(@)
  init = ->
    @register()
    throw Stop(message: "cannot finish #{@name}")
  deinit = -> print('deinit')

try
  const _n = Node(name: 'n1')
catch e: Stop
  print e.message
print registry.items.length
