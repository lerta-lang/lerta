struct Oops: Error
f := (fails: Bool) ->
  throw Oops('oops') if fails
  1
for fails in [false, true]
  x :=
    try
      f fails
    catch e
      'a'
  print x
for fails in [false, true]
  x :=
    try
      f(fails) == 1 then 'one'  # fmt: skip
    catch e
      2
  print x?.to_string() else 'none'
