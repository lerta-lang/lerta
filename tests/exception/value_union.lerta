struct Oops: Error
f := (fails: Bool) ->
  throw Oops(message: 'oops') if fails
  1
for fails in [false, true]
  x :=
    try
      f fails
    catch e
      'a'
  print x
for fails in [false, true]
  x :=
    try
      f(fails) == 1 then 'one' else nil
    catch e
      2
  print x?.to_string() ? 'none'
