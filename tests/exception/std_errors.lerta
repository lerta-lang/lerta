import sqrt from 'std:math'
import exit from 'std:process'

empty: Int[]
try
  print empty[0]
catch e: IndexError
  print e.message
try
  print 'a,b'.split('').length
catch e: ValueError
  print e.message
try
  print sqrt(-1.0)
catch e: ArithmeticError
  print e.message
try
  exit 256
catch e: ValueError
  print e.message
checked := (n: Int) -> n > 0 then n else exit(300)
try
  print checked(0)
catch e: ValueError
  print "in a value: #{e.message}"
exit 0
