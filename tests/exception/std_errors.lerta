import { exit } from 'std:process'

const empty: Array<Int> = []
try
  print empty.last()
catch e: IndexError
  print e.message
try
  print 'a,b'.split('').length
catch e: ValueError
  print e.message
try
  print 300.to_byte()
catch e: ArithmeticError
  print e.message
try
  exit 256
catch e: ValueError
  print e.message
const checked = (n: Int): Int -> n > 0 then n else exit(300)
try
  print checked(0)
catch e: ValueError
  print "in a value: #{e.message}"
exit 0
