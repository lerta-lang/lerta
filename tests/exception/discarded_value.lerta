# A try that gives no value, as a catch that gives none makes it, releases the value of its last
# statement.
class Item
  args
    name: String
  deinit := -> print("drop #{@name}")

make := (name: String) -> Item(name)
fail := (name: String): Item -> throw ValueError("no #{name}")

try
  make 'body'
catch e
  print e.message
try
  print fail('body').name
catch e
  make 'catch'
try
  make 'with finally'
catch e
  print e.message
finally
  print 'finally'
print 'end'

# At the end of a function, nested, before a jump, and in a catch that throws again.
at_end := ->
  try
    make 'at end'
  catch e
    print e.message
at_end()
try
  try
    make 'nested'
  catch e
    print e.message
  make 'outer'
catch e
  print e.message
for name in ['before continue']
  try
    make name
    continue
  catch e
    print e.message
try
  try
    print fail('inner').name
  catch e
    make 'rethrown'
    throw e
  finally
    print 'inner finally'
catch e
  print e.message
