class Child
  name: String
  deinit = -> print("child #{@name}")

class Holder
  n = 1
  child: Child? = Child('first')
  left = Child('left')
  right = Child('right')
  deinit = ->
    show := -> print("holder #{@n}")
    show()
    items := [@]
    record := { holder: @ }
    print items.length + record.holder.n
    @child = Child('second')

make := ->
  _holder := Holder()
make()
keep := (c: Child): (() -> String) -> -> c.name
_closures := [keep(Child('in closure'))]
_by_name := { 'a': Child('in map') }
_record := { c: Child('in record') }
print 'end'
