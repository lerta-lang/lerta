class Child
  name: String
  deinit = -> print("child #{@name}")

class Holder
  n = 1
  child: Child? = Child(name: 'first')
  left = Child(name: 'left')
  right = Child(name: 'right')
  deinit = ->
    show := -> print("holder #{@n}")
    show()
    items := [@]
    record := { holder: @ }
    print items.length + record.holder.n
    @child = Child(name: 'second')

make := ->
  _holder := Holder()
make()
keep := (c: Child): (() -> String) -> -> c.name
_closures := [keep(Child(name: 'in closure'))]
_by_name := { 'a': Child(name: 'in map') }
_record := { c: Child(name: 'in record') }
print 'end'
