class Child
  name: String
  deinit = -> print "child #{@name}"

class Holder
  n = 1
  var child: Child? = Child(name: 'first')
  left: Child = Child(name: 'left')
  right: Child = Child(name: 'right')
  deinit = ->
    const show = -> print "holder #{@n}"
    show()
    const items = [@]
    const record = { holder: @ }
    print items.length + record.holder.n
    @child = Child(name: 'second')

const make = ->
  const _holder = Holder()
make()
const keep = (c: Child): () -> String -> -> c.name
const _closures = [keep(Child(name: 'in closure'))]
const _by_name = { 'a': Child(name: 'in map') }
const _record = { c: Child(name: 'in record') }
print 'end'
