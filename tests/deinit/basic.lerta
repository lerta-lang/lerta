class Resource
  args
    name: String
    log: String[]
  deinit := ->
    @log.push "closed #{@name}"
    @report()
  report := -> print("releasing #{@name}")

class Node
  args
    value: Int
    next: Node?
  deinit := -> print("node #{@value}")

log: String[]
use := ->
  _a := Resource(log, name: 'a')
  print 'using a'
print 'start'
use()
var _b: Resource? = Resource(log, name: 'b')
_b = nil
print log.join(', ')
_chain := Node(value: 1, next: Node(value: 2, next: Node(value: 3, next: nil)))
print 'end'
