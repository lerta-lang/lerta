class Resource
  name: String
  log: Array<String>
  deinit = ->
    @log.push("closed #{@name}")
    @report()
  report = -> print "releasing #{@name}"

class Node
  value: Int
  next: Node?
  deinit = -> print "node #{@value}"

const log: Array<String> = []
const use = ->
  const _a = Resource(name: 'a', log: log)
  print 'using a'
print 'start'
use()
var _b: Resource? = Resource(name: 'b', log: log)
_b = nil
print log.join(', ')
const _chain = Node(value: 1, next: Node(value: 2, next: Node(value: 3, next: nil)))
print 'end'
