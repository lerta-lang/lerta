# A deinit run at exit that catches the failed read of a released `var` goes on, and the values
# declared before its object are still there.
class Name
  args
    text: String

class N
  deinit := ->
    try
      print later[0]
    catch e
      print e.message
    print name.text

name := Name('kept')
_n := N()
var later = ['gone']
print 'end'
