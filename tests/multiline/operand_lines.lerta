# fmt: off
# Where an operand or an item is to come, the lines indented deeper continue the line, as do the
# lines after them at their indentation, where an operand is to come.
total := 1 +
  2 *
  3 +
  4
print total
ready := true and
  not
    false
print ready
show := (label: String, value: Int) -> print "#{label} #{value}"
show 'a',
  1
sizes := [
  1 +
  2
  10
]
print sizes
show(
  case total
    when 11 then 'eleven'
    else 'other'
  sizes[
    0
  ]
)
words := ['x', 'yy', 'zzz']
print [
  word.binary.length
  for word in words
  when word != 'yy'
]
nested := 1 +
  2 *
    3 +
  4
print nested
doubled := [1, 2].map((x) ->
  y := x +
    1
  y * 2
)
print doubled.to_array()
print [
  1,
    2,
  3
]
