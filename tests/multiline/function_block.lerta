# Inside brackets, a line that ends with `->` and a line indented deeper after it open the body of a
# function as an indented block, which a line no deeper than the one with `->`, or a closing bracket
# of the brackets around it, ends.
const xs = [1, 2, 3]
const ys = xs.map((x) ->
  const y = x * 2
  y + 1
).to_array()
print ys

# The block is laid out as any other: a case, a loop, brackets and another such body inside it.
const labels = xs.map((x) ->
  # A comment inside the body.
  case x
    when 1 then 'one'
    else
      const words = ['two', 'three'].map((word) ->
        const upper = "#{word}!"
        upper
      )
      words.to_array()[x - 2]
)
print labels.to_array()

# A closing bracket ends the block on the line of its last statement.
const positive = xs.all((x) ->
  const doubled = x * 2
  doubled > 0)
print positive

# Each item of a list may hold such a body, on a line of its own.
const handlers = [
  (x: Int) ->
    const half = x / 2
    half
  (x: Int) -> x * 3
]
print [handler(4) for handler in handlers]

const run = (on_item: (Int) -> void, on_end: () -> void) ->
  on_item x for x in xs
  on_end()
run(
  (x) ->
    if x > 1
      print x
  -> print 'done'
)

# A comment after `->`, a blank line and a comment line before the body, and a closing bracket on
# a line of its own at the body's indentation.
const commented = xs.map((x) ->  # the next value

  # one more
  x + 1
  ).to_array()
print commented

# A body inside the brackets of a body inside brackets, ended by indentation, and one ended by a
# closing bracket that also closes the brackets around the outer body.
const nested = xs.map((x) ->
  const inner = [x].map((y) ->
    y * 10
  )
  inner.to_array()[0]
).to_array()
print nested
const tight = xs.map((x) ->
  [x].map((y) ->
    y + x)).to_array()
print [inner.to_array() for inner in tight]

# A closing bracket that starts a line deeper than the body closes it too.
const deeper = xs.map((x) ->
  x * 3
    ).to_array()
print deeper
