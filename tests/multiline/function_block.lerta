# fmt: off
# Inside brackets, a line that ends with `->` and a line indented deeper after it open the body of a
# function as an indented block, which a line no deeper than the one with `->`, or a closing bracket
# of the brackets around it, ends.
xs := [1, 2, 3]
ys := xs.map((x) ->
  y := x * 2
  y + 1
).to_array()
print ys

# The block is laid out as any other: a case, a loop, brackets and another such body inside it.
labels := xs.map((x) ->
  # A comment inside the body.
  case x
    when 1 then 'one'
    else
      words := ['two', 'three'].map((word) ->
        upper := "#{word}!"
        upper
      )
      words.to_array()[x - 2]
)
print labels.to_array()

# Each item of a list may hold such a body, on a line of its own.
handlers := [
  (x: Int) ->
    half := x / 2
    half
  (x: Int) -> x * 3
]
print [handler(4) for handler in handlers]

run := (on_item: (Int) -> void, on_end: () -> void) ->
  on_item x for x in xs
  on_end()
run(
  (x) ->
    if x > 1
      print x
  -> print 'done'
)

# A comment after `->`, and a blank line and a comment line before the body.
commented := xs.map((x) ->  # the next value

  # one more
  x + 1
).to_array()
print commented

# A body inside the brackets of a body inside brackets.
nested := xs.map((x) ->
  inner := [x].map((y) ->
    y * 10
  )
  inner.to_array()[0]
).to_array()
print nested
