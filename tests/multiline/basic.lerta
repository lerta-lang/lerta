import {
  stdout
  stderr
} from 'std:io'

const keywords = [
  'const'
  'var', 'if'
  ''
  # a comment line
  'else'
]
print keywords.length
print keywords.join('|')

const precedence = {
  'or': 1
  'and': 2
  '+': 4, '-': 4
}
print precedence['+'] ? 0

const add = (a: Int, b: Int): Int -> a + b
print add(
  1
  2
)
const total = (1 +
    2 +
  3)
print total
const grid = [
  [1, 2]
  [
    3
    4
  ]
]
print grid[1][1]
print keywords[
  1
]
struct Token
  kind: String
  text: String
const t = Token(
  kind: 'name'
  text: 'x'
)
print t.text
stdout.write("done\n")
stderr.flush()
const sum = (
  a: Int
  b: Int
): Int -> a + b
if sum(
  1
  2
) == 3
  print 'block after brackets'
var n = 0
while (n <
    3)
  n += 1
print n
print 'postfix' if sum(
  1, 1
) == 2
print [
  1
  -2
  sum(
    3
    4
  )
  (10 +
    20)
  # before the closing bracket

][1]
