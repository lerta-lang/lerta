# fmt: off
# The `for` and the `when` of a comprehension and the `default:` of an index may start a line
# indented deeper, which continues the line before it.
xs := [1, 2, 3]
a := [x * 2
  for x in xs
  when x > 1]
print a
b := (x for x in xs
  when x > 1).to_array()
print b
m: Map<String, Int>
print m['k'
  default: 3]
