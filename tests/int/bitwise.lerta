print [12 & 10, 12 | 10, 12 ^ 10, 12 ^ -1]
print [1 << 4, 256 >> 4, -16 >> 2, -1 >> 63, -1 << 63]
# `&`, `<<` and `>>` bind as `*` does, and `|` and `^` as `+` does, both tighter than comparisons.
print [3 + 4 & 1, 1 << 2 + 1, 2 * 3 << 1, 1 | 2 ^ 3]
print [6 & 3 == 2, 0xF0 >> 4 == 15]
var x = 1
x <<= 3
x |= 1
x &= 0xF
x ^= 2
x >>= 1
print x
const flags = [1, 2, 4]
print [flags[1] << 1, (flags[0] | flags[2]) & 5]
# A shift may continue on the next line inside brackets, and `>>` may end type arguments.
const continued = (1 <<
  2)
const sets = Map<String, Set<Int>>()
print [continued, sets.length]
const items = [1, 2]
items[0] <<= 3
items[1] &= 3
class Mask
  bits = 6
const mask = Mask()
mask.bits >>= 1
mask.bits |= 8
mask.bits &= 0xA
mask.bits ^= 4
print [items[0], items[1], mask.bits]
# Shifts of names followed by `(` are no type arguments.
const one = 1
const two = 2
print one<<two>>(one)
