# The least and the largest literal of each sized type.
a: Int8 = -128
b: Int8 = 127
c: Int16 = -32768
d: Int16 = 32767
e: Int32 = -2147483648
f: Int32 = 2147483647
g: Byte = 0
h: Byte = 255
i: UInt16 = 65535
j: UInt32 = 4294967295
k: UInt64 = 0
l: UInt64 = 18446744073709551615
m: UInt64 = 0xFFFFFFFFFFFFFFFF
n: UInt64 = 18_446_744_073_709_551_615
print [a.to_int(), b.to_int(), c.to_int(), d.to_int(), e.to_int(), f.to_int()]
print [g.to_int(), h.to_int(), i.to_int(), j.to_int()]
print "#{k} #{l} #{m} #{n}"
