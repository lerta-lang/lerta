# `~` inverts the bits of each integer type, of the type that the context gives a literal, and is
# a prefix operator, which a call without parentheses takes.
b: Byte = 0x0F
small: Int8 = 5
wide: UInt64 = 0
print [~5, ~0, ~-1, ~INT_MIN]
print [(~b).to_int(), (~small).to_int(), ~b.to_int()]
print ~wide
mask: Byte = ~0x80
print mask
MASK := ~0xFF
print MASK
print -~1
sized := (a: Int16, b: Int32, c: UInt16, d: UInt32) -> "#{~a} #{~b} #{~c} #{~d}"
print sized(1, -2, 0, 1)
