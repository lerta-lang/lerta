# An Int in lower-case hexadecimal, with zeros before it to a width, and the value of a hex digit.
print [255.to_hex(), 0.to_hex(), 10.to_hex(4), 0x1F600.to_hex().to_upper(), 4096.to_hex(2)]
print [9223372036854775807.to_hex(), 5.to_hex(-1), 0.to_hex(3), 255.to_hex(2)]
print [9.to_hex(), 10.to_hex(), 15.to_hex(), 16.to_hex(), 0xABCDEF.to_hex(), 0x9A.to_hex()]
digits := '09afAFg/G@`:'.binary
print [digit.hex_value() ? -1 for digit in digits]
print [0xC0.to_byte()!.hex_value() == nil, 0xFF.to_byte()!.hex_value() == nil]
