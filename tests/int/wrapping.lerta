# The wrapping methods wrap around where the operators throw.
max := 9223372036854775807
print [max.wrapping_add(1), (-max - 1).wrapping_sub(1), max.wrapping_mul(2)]
print [3.wrapping_add(4), 3.wrapping_sub(4), 3.wrapping_mul(4)]
b: Byte = 250
print [b.wrapping_add(10), b.wrapping_sub(251), b.wrapping_mul(2)]
small: Byte = 3
print [small.wrapping_add(4), small.wrapping_sub(1), small.wrapping_mul(4)]
print (-max - 1).wrapping_mul(-1)
maybe: Int? = 3
print maybe?.wrapping_add(1) ? 0
bytes: Byte[] = [1, 255]
print bytes.iter().map((x) -> x.wrapping_add(255)).to_array()
