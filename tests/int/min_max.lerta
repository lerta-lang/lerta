print INT_MIN
print INT_MAX
print INT_MIN == -0x8000000000000000
print INT_MAX == -(INT_MIN + 1)
greatest := (values: Int[]) -> values.fold(INT_MIN, (a, b) -> max(a, b))
print greatest([3, -5, 7])
smallest := (values: Int[]) ->
  var least = INT_MAX
  least = min(least, value) for value in values
  least
print smallest([3, -5, 7])
