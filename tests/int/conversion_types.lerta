# A conversion that every value fits gives the type itself, with no nil to take apart: to more
# bits of the same sign, or from unsigned to more bits; one of equal bits across signs does not.
const small: Int8 = -1
const unsigned_half: UInt16 = 40000
const wide: UInt32 = 4294967295
const byte: Byte = 255
const as_int32: Int32 = small.to_int32()
const as_int: Int = wide.to_int()
const as_uint64: UInt64 = byte.to_uint64()
const from_uint16: Int32 = unsigned_half.to_int32()
const as_char: Char = byte.to_char()
print [as_int32.to_int(), as_int, as_uint64.to_int()!, from_uint16.to_int(), as_char.to_int()]
const minus_one: Int32 = -1
print [wide.to_int32() == nil, minus_one.to_uint32() == nil]
# Only a Byte is always a Char: a UInt16 may be a surrogate.
print [unsigned_half.to_char() == nil, 0xD800.to_uint16()!.to_char() == nil]
