# An Int's bits as a UInt64, and a UInt64 in hexadecimal, which shows them.
print [
  0.to_bits()
  255.to_bits()
  0x7FFFFFFFFFFFFFFF.to_bits()
  -1.to_bits()
  (-9223372036854775807 - 1).to_bits()
]
print [-1.to_bits().to_hex(), -2.to_bits().to_hex(20), 0x123456789.to_bits().to_hex(16)]
print [0.to_uint64()!.to_hex(), 255.to_uint64()!.to_hex(4), 0x123.to_uint64()!.to_hex(1)]
