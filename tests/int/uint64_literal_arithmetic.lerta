# Literals beyond Int where a UInt64 is expected: in arithmetic, as an argument, in a comparison, a
# pattern, a default value, an array and an optional.
x: UInt64 = 0xFFFFFFFFFFFFFFFF - 1
f := (n: UInt64) -> n ^ 0x8000000000000000
print "#{x} #{f(1)}"
print [x == 18446744073709551614, x > 0x8000000000000000]
kind := (n: UInt64) ->
  case n
    when 18446744073709551615 then 'largest'
    else 'other'
print [kind(x + 1), kind(x)]
largest := (n: UInt64 = 18446744073709551615) -> n
print largest()
values: UInt64[] = [1, 18446744073709551615]
print values
maybe: UInt64? = 18446744073709551615
print maybe!
