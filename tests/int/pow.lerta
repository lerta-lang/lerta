# `**` of Ints is exact up to the edges of Int, the least a power of -2, and groups to the right.
print [2 ** 10, 3 ** 0, 0 ** 0, 0 ** 5, (-3) ** 3, (-1) ** INT_MAX]
print [2 ** 62, (-2) ** 63, INT_MAX ** 1, INT_MIN ** 1, 1 ** INT_MAX, 0 ** INT_MAX]
print [2 ** 3 ** 2, (2 ** 3) ** 2, 2 * 3 ** 2, -(2 ** 2)]
var x = 3
x **= 2
print x
power := (base: Int, exponent: Int) -> base ** exponent
print [power(3, 4), power(-2, 63), power(7, 0)]
print power(2, 63)
