# Each count of digits, with and without a sign, the ends of Int and UInt64, and hexadecimal.
print [0.to_string(), 9.to_string(), -9.to_string(), 10.to_string(), -10.to_string()]
print [99.to_string(), 100.to_string(), -100.to_string(), 1234567890.to_string()]
print [INT_MAX.to_string(), INT_MIN.to_string(), (INT_MIN + 1).to_string()]
print "w#{42}" == 'w42'
print [-1.to_string(), (INT_MAX.to_uint64()! * 2 + 1).to_string(), 0.to_uint64()!.to_string()]
print [0.to_hex(), 255.to_hex(4), INT_MAX.to_hex()]
print [15.to_hex(), 16.to_hex(), 4095.to_hex(), 65536.to_hex()]
