# A narrowing conversion gives nil for a value that does not fit the target.
big: UInt64 = 9223372036854775807
minus_one_int8: Int8 = -1
minus_one_int32: Int32 = -1
byte: Byte = 200
narrow := 70000
max_uint32: UInt32 = 4294967295
uint16: UInt16 = 40000
print [
  (big + big).to_uint32() == nil
  minus_one_int8.to_uint32() == nil
  minus_one_int32.to_uint32() == nil
  byte.to_int8() == nil
  narrow.to_uint16() == nil
  minus_one_int8.to_uint64() == nil
  max_uint32.to_int32() == nil
  (big + 1).to_int() == nil
  uint16.to_int16() == nil
  -1.to_byte() == nil
]

# The largest value of the target just fits.
print [big.to_int() == nil, 255.to_byte() == nil]
