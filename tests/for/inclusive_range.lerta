# `a..b` includes its end, in a `for`, a comprehension, a lazy one and with an index.
print i for i in 1..=3
print 'empty range' for _ in 5..=4
print [i for i in 3..=1]
print (i for i in 3..=1).to_array()
print [i for i in 3..=3]
print (i * 2 for i in 1..=3).to_array()
print "#{i}: #{n}" for n at i in 5..=6
print i for i in 9223372036854775805..=9223372036854775806
