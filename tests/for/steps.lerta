# `by` and `reversed`: the items of a range by a step, and in the other order, at the ends of
# Int too.
n := 10
negative := -1
print [i for i in 0..n by 2]
print [i for i in 0..=n by 5]
print [i for i in 0..n by 3 reversed]
print [i for i in 0..=10 by 3 reversed]
print [i for i in 0..=10 by 5 reversed]
print [i for i in 0..5 reversed]
print [i for i in 5..5 reversed]
print [i for i in 5..=5 by 7 reversed]
print [i for i in 6..2 by 2]
print ["#{k}:#{i}" for i at k in 3..9 by 2 reversed]
print i for i in -4..=4 by 4
print i * 10 for i in 1..4 reversed
largest := 9223372036854775807
print [i for i in (largest - 4)..=largest by 2]
print [i for i in (-9223372036854775807 - 1)..(-9223372036854775807 + 4) by 3 reversed]
step := 0
try
  print [i for i in 0..3 by step]
catch error: ValueError
  print error.message
try
  print [i for i in 0..3 by negative]
catch error: ValueError
  print error.message
print [(i, j) for i in 0..3 reversed for j in i..3 by 2]
smallest := -largest - 1
wide: Int[]
for i in -5..largest by 1
  wide.push i
  break if i == -3
for i in smallest..=largest by 2
  wide.push i
  break
for i in smallest..largest reversed
  continue if i % 2 == 1
  wide.push i
  break
print wide
print Set(0..10 by 3)
print [(0..4 reversed)...]
order := (what: String, n: Int) ->
  print what
  n
print [i for i in order('start', 0)..order('end', 4) by order('step', 2)]
try
  print [i for i in 5..5 by step]
catch error: ValueError
  print 'empty: ' + error.message
for x at k in 0..10 by 3 reversed
  continue if x == 6
  print "#{k}:#{x}"
