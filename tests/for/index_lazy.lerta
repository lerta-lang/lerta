# A lazy comprehension names the index too: the place of each item in the iterable, counted before
# the condition, which narrows the item as an `if` would, in the element and the condition.
words: String?[] = ['a', nil, 'bb', 'ccc']
labeled := ("#{i}:#{w}" for w at i in words when w != nil and i > 0)
print labeled.to_array()
print (n * 10 + i for n at i in 5..8).to_array()
print each for each in (i for _ at i in ['x', 'y'])
print (s for s at i in ['p', 'q', 'r'] when i > 0).to_array()
print (s for s at i in ['p', 'q']).to_array()
print (s for s at i in ['p', 'q', 'r'] when s.count() > 5).to_array()
pairs := [('a', 1), ('b', 2)]
print ("#{i}#{key}#{value}" for (key, value) at i in pairs when value > 1).to_array()
print ("#{i}#{c}" for c at i in 'xyz' when c != 'y').to_array()
inner := (n * 2 for n at i in [1, 2, 3] when i != 1)
print (m + j for m at j in inner).to_array()
checked := (n * 10 for n at i in [1, 0] when 10 / n > i)
try
  print checked.to_array()
catch error: ArithmeticError
  print 'divided by zero'
held := ("#{i}#{w}" for w at i in ['a', 'b', 'c'] when w != 'b')
print held.has_next() and held.has_next()
print held.next()
dropped := ("#{i}#{w}" for w at i in ['d', 'e'])
print dropped.has_next()
suffix := '!'
shout := (words: String[]) -> (w + suffix for w at i in words when i < 2).to_array()
print shout(['x', 'y', 'z'])
