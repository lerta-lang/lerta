const words = ['a', 'b', 'c']
for word, i in words
  print "#{i}: #{word}"
for n, i in 10...13
  print "#{i} #{n}"
for byte, i in 'xy'.binary
  print "#{i} #{byte.to_int()}"
for word, i in words.filter((w) -> w != 'b')
  continue if i == 0
  print "iter #{i}: #{word}"
print ["#{i}#{w}" for w, i in words when i != 1].join(',')
print "#{w}" for w, i in words when i == 2
print ["#{i * 10 + n}" for n, i in 5...8].join(',')
print ["#{i}" for w, i in words.filter((w) -> w != 'a')].join(',')
const readers = [(() -> i) for w, i in words]
print ["#{read()}" for read in readers].join(',')
for w, i in words.filter((w) -> w == 'c')
  const later = () -> "#{w}#{i}"
  print later()
