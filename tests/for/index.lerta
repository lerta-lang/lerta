# fmt: off
words := ['a', 'b', 'c']
for word at i in words
  print "#{i}: #{word}"
for n at i in 10..13
  print "#{i} #{n}"
for byte at i in 'xy'.binary
  print "#{i} #{byte.to_int()}"
for word at i in words.filter((w) -> w != 'b')
  continue if i == 0
  print "iter #{i}: #{word}"
print ["#{i}#{w}" for w at i in words when i != 1].join(',')
print "#{w}" for w at i in words when i == 2
print ["#{i * 10 + n}" for n at i in 5..8].join(',')
print ["#{i}" for w at i in words.filter((w) -> w != 'a')].join(',')
readers := [(-> i) for w at i in words]
print ["#{read()}" for read in readers].join(',')
for w at i in words.filter((w) -> w == 'c')
  later := -> "#{w}#{i}"
  print later()
# `at` is no keyword, so it stays usable as a name.
at := [5]
for x at i in at
  print "#{x} #{i}"
