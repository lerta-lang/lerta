# A method of an extend of maps and one of the same name of an extend of sets do not overlap, as
# a set is no map that an extend of maps applies to, whether the types are generic or not.
extend<K, V> Map<K, V>
  kind := -> 'map'

extend<T> Set<T>
  kind := -> 'set'

extend<K, V> Map<K, V>
  size_text := -> "#{@length} entries"

extend Set<Int>
  size_text := -> "#{@length} numbers"

extend Map<Int, Int>
  first_text := -> 'a map of numbers'

extend<T> Set<T>
  first_text := -> 'a set'

m: Map<String, Int>
print m.kind()
print Set([1]).kind()
print m.size_text()
print Set([1, 2]).size_text()
numbers: Map<Int, Int>
print numbers.first_text()
print Set(['a']).first_text()
