# A to_string from a generic extend makes the types it matches Stringable, but for the arrays that
# have one of their own.
struct P
  v: Int
  to_string = -> "p#{@v}"

extend<T> T[]
  to_string = (): String -> "<#{(x.to_string() for x in @).to_array().join(' ')}>"

print [P(v: 1), P(v: 2)]
print "#{[[P(v: 3)]]} and #{['a', 'b']}"
