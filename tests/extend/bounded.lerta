# An extend's type parameter may have a bound, which the type argument that the receiver gives must
# satisfy where a method of the extend is used.
extend<T: Comparable> Iterable<T>
  least = (): T? ->
    var found: T?
    for x in @
      found = x if found == nil or x < found
    found

extend<T: Comparable> T[]
  greatest = (): T? ->
    var found: T?
    for x in @
      found = x if found == nil or x > found
    found

print [[3, 1, 2].least() ? 0, [3, 1, 2].greatest() ? 0, Set([5, 4]).least() ? 0]
const none: Int[]
print ['b', 'a'].least() ? ''
print none.least() == nil

# A class or struct with its own compare satisfies the bound.
struct Version
  number: Int
  compare = (other: Version) -> @number.compare(other.number)
print [Version(number: 3), Version(number: 2)].least()!.number

# A bound that names another type parameter.
extend<K, V: Comparable> Map<K, V>
  key_of_least = (): K? ->
    var found: K?
    var least: V?
    for (key, value) in @entries()
      if least == nil or value < least
        found = key
        least = value
    found
print { 'a': 3, 'b': 1 }.key_of_least() ? ''

# A generic method of a bounded extend, with a type parameter of its own.
extend<T: Comparable> T[]
  least_with = <U>(label: U): (T?, U) -> (@first(), label)
const (least, label) = [2, 9].least_with('two')
print [least ? 0, 0].to_string() + label
