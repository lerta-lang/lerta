# An extend of a generic type with its type arguments written, or a pattern of them, gives the
# methods to the types that it matches only.
extend Int[]
  total = (): Int ->
    var sum = 0
    sum += x for x in @
    sum

extend<T> T[][]
  flattened = (): T[] ->
    const items: T[] = []
    for xs in @
      items.push(x) for x in xs
    items

extend<V> Map<String, V>
  key_kind = (): String -> 'String'

extend<V> Map<Int, V>
  key_kind = (): String -> 'Int'

print [1, 2, 3].total()
print [[1], [2, 3]].flattened().length
print [['a', 'b'], ['c']].flattened()[2]
const by_name = { 'a': 1 }
const by_number = { 1: 'a' }
print by_name.key_kind()
print by_number.key_kind()
