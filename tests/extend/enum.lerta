# An extend adds methods to an enum, with `@` as the member.
enum Direction
  NORTH
  EAST
  SOUTH
  WEST
extend Direction
  is_vertical := -> @ == NORTH or @ == SOUTH
  opposite := (): Direction ->
    case @
      when NORTH then SOUTH
      when EAST then WEST
      when SOUTH then NORTH
      when WEST then EAST
print Direction.NORTH.is_vertical()
print Direction.EAST.opposite()
directions: Direction[] = [NORTH, WEST]
print [d for d in directions when not d.is_vertical()]
extend Direction
  label := -> "#{@to_string().to_lower()}#{@is_vertical() then ' |' else ' -'}"
print Direction.SOUTH.label()
interface Labeled
  label: () -> String
show := <T: Labeled>(item: T) -> print(item.label())
show Direction.EAST
