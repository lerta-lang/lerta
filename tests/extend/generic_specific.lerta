# An extend of a type without type parameters gives that type its method before a generic extend
# of the same module that matches it gives one of the same name, as the generic extend's other
# methods call it too.
extend<T> T[]
  head = (): T -> @[0]
  twice = (): T[] -> [@head(), @head()]

extend Int[]
  head = -> 0

print [5, 6].head()
print ['a', 'b'].head()
print [5, 6].twice()
print ['a', 'b'].twice()
