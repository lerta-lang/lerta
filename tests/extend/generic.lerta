# The methods of a generic extend are instantiated per receiver type.
extend<T> T[]
  second = (): T -> @[1]
  count_where = (keep: (T) -> Bool): Int ->
    var count = 0
    count += 1 for x in @ when keep(x)
    count
  paired = <U>(others: U[]): { left: T, right: U }[] ->
    [{ left: @[i], right: others[i] } for i in 0...@length]

extend<K, V> Map<K, V>
  get_or = (key: K, fallback: V): V -> @[key] ? fallback

extend<T> Iter<T>
  count = (): Int ->
    var count = 0
    count += 1 for _ in @
    count

print [1, 2, 3].second()
print ['a', 'b'].second()
print [1, 2, 3, 4].count_where((x) -> x % 2 == 0)
const pairs = [1, 2].paired(['one', 'two'])
print "#{pairs[1].left} #{pairs[1].right}"
const ages = { 'ann': 31 }
print ages.get_or('ann', 0)
print ages.get_or('bob', 0)
const names: Map<Int, String> = { 1: 'one' }
print names.get_or(2, 'none')
print (x for x in 0...5 when x > 1).count()
