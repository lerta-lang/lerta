# The methods of a generic extend are instantiated per receiver type.
extend<T> T[]
  second := (): T -> @[1]
  count_where := (keep: (T) -> Bool): Int ->
    var count = 0
    for x in @
      count += 1 if keep(x)
    count
  paired := <U>(others: U[]): { left: T, right: U }[] ->
    [
      for i in 0..@length
        { left: @[i], right: others[i] }
    ]

extend<K, V> Map<K, V>
  get_or := (key: K, fallback: V): V -> @[key] else fallback

extend<T> Iter<T>
  size := (): Int ->
    var count = 0
    count += 1 for _ in @
    count

print [1, 2, 3].second()
print ['a', 'b'].second()
print [1, 2, 3, 4].count_where((x) -> x % 2 == 0)
pairs := [1, 2].paired(['one', 'two'])
print "#{pairs[1].left} #{pairs[1].right}"
ages := { 'ann': 31 }
print ages.get_or('ann', 0)
print ages.get_or('bob', 0)
names := { 1: 'one' }
print names.get_or(2, 'none')
print (x for x in 0..5 when x > 1).size()
