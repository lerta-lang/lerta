extend String
  shout = (): String -> @ + '!'
  twice = (): String -> @shout() + ' ' + @shout()

extend Int
  doubled = (): Int -> @ * 2
  adder = (): (Int) -> Int -> (n: Int) -> n + @
  describe = (): String -> "#{@} doubled is #{@doubled().to_string()}"

struct Point
  x: Int
  y: Int

class Counter
  count = 0
  increment = -> @count += 1

extend Point
  sum = (): Int -> @x + @y
  moved = (dx: Int): Point -> Point(x: @x + dx, y: @y)

extend Counter
  increment_twice = ->
    @increment()
    @increment()

print 'hi'.twice()
print 21.doubled()
print 3.adder()(4)
print 5.describe()
print Point(x: 1, y: 2).moved(10).sum()
const counter = Counter()
counter.increment_twice()
print counter.count
