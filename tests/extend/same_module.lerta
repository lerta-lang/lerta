extend String
  shout = -> @ + '!'
  twice = -> @shout() + ' ' + @shout()

extend Int
  doubled = -> @ * 2
  adder = (): ((Int) -> Int) -> (n) -> n + @
  describe = -> "#{@} doubled is #{@doubled().to_string()}"

struct Point
  x: Int
  y: Int

class Counter
  count = 0
  increment = -> @count += 1

extend Point
  sum = -> @x + @y
  moved = (dx: Int) -> Point(x: @x + dx, y: @y)

extend Counter
  increment_twice = ->
    @increment()
    @increment()

print 'hi'.twice()
print 21.doubled()
print 3.adder()(4)
print 5.describe()
print Point(x: 1, y: 2).moved(10).sum()
counter := Counter()
counter.increment_twice()
print counter.count
