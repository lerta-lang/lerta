# Byte division never overflows.
const b: Byte = 255
print [b / 2, b % 7, b / 255]
# A wrapping method reached through a type parameter and from a closure.
const identity = <T>(x: T) -> x
const bump = (y: Byte) -> y.wrapping_add(10)
print [identity<Byte>(b).wrapping_mul(2), bump(250)]
const items: Byte[] = [1]
items[0] = items[0].wrapping_sub(2)
print items[0]
