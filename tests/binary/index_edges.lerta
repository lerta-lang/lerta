# A Binary's index below 0 or at its length throws an IndexError, which can be caught, from a Binary
# that a local holds or that an expression makes, as does an index that throws itself; every index
# in range reads its byte.
bytes := b'abc'
attempt := (name: String, f: () -> Byte) ->
  try
    print "#{name}: #{f()}"
  catch e
    print "#{name}: #{e.message}"
refuse := (): Int -> throw ValueError('no index')

attempt 'first', -> bytes[0]
attempt 'last', -> bytes[2]
attempt 'negative', -> bytes[-1]
attempt 'at the length', -> bytes[3]
attempt 'of an empty one', -> b''[0]
attempt 'far past the end', -> bytes[1 << 40]
attempt 'at the least Int', -> bytes[-9223372036854775807 - 1]
attempt 'made', -> (b'x' + bytes)[4]
attempt 'made negative', -> (b'x' + bytes)[-1]
attempt 'index throws', -> bytes[1 + refuse()]
class Holder
  args
    data: Binary
holder := Holder(b'xy')
attempt 'of a field', -> holder.data[1]
attempt 'of a field, past the end', -> holder.data[2]
var sum = 0
sum += bytes[i].to_int() for i in 0..bytes.length
print sum
print [b for b in b''].length
print [b.to_int() for b in b'ab']
made := b'x' + bytes
print "#{made.length} #{[b.to_int() for b in made]}"

# A loop's condition that keeps the index below the length leaves a negative index to throw still,
# where it is the index itself, whose comparison with the length the condition has made, and where
# it is another, as is one past the end.
sum_direct := (from: Int) ->
  var total = 0
  var i = from
  while i < bytes.length
    total += bytes[i].to_int()
    i += 1
  total
for from in [0, 1, -1]
  try
    print "from #{from}: #{sum_direct(from)}"
  catch e
    print "from #{from}: #{e.message}"
sum_from := (from: Int, ahead: Int) ->
  var total = 0
  var i = from
  while i < bytes.length
    total += bytes[i + ahead].to_int()
    i += 1
  total
for (from, ahead) in [(0, 0), (-1, 0), (0, 1), (1, -1)]
  try
    print "from #{from}, ahead #{ahead}: #{sum_from(from, ahead)}"
  catch e
    print "from #{from}, ahead #{ahead}: #{e.message}"

# A position that adds a literal to another, or takes one from it, reads the byte at their sum,
# where the other alone is out of range too, and throws as any other where the sum is out of range
# or overflows; so do those of a Binary that an expression makes. The bytes read at one place and
# its neighbours make a word.
at := (i: Int) -> i
attempt 'stepped on', -> bytes[at(0) + 2]
attempt 'stepped back', -> bytes[at(2) - 2]
attempt 'stepped by none', -> bytes[at(1) + 0]
attempt 'stepped into range', -> bytes[at(-1) + 1]
attempt 'stepped back into range', -> bytes[at(3) - 1]
attempt 'stepped past the end', -> bytes[at(1) + 2]
attempt 'stepped below 0', -> bytes[at(1) - 2]
attempt 'stepped beyond Int', -> bytes[at(9223372036854775807) + 1]
attempt 'stepped from a throw', -> bytes[refuse() + 1]
attempt 'stepped in a made one', -> (b'x' + bytes)[at(2) + 1]
attempt 'stepped past a made one', -> (b'x' + bytes)[at(2) + 2]
start := 2
attempt 'stepped from a local in a made one', -> (b'x' + bytes)[start + 1]
attempt 'stepped from a literal', -> bytes[1 + 1]
word_at := (data: Binary, index: Int) ->
  start := index * 4
  data[start].to_int() |
    data[start + 1].to_int() << 8 |
    data[start + 2].to_int() << 16 |
    data[start + 3].to_int() << 24
words: Byte[] = [0x01, 0x02, 0x03, 0x04, 0xFF, 0xFF, 0xFF, 0xFF]
print word_at(words.to_binary(), 0).to_hex()
print word_at(words.to_binary(), 1).to_hex()
