ab := 'ab'.binary
print ab == 'ab'.binary
print ab == 'abc'.binary.slice(0, 2)
print ab != 'ac'.binary
print ab == 'a'.binary
print ''.binary == 'x'.binary.slice(0, 0)
print ab.occurs_at(0, 'a'.binary)
print ab.occurs_at(1, 'b'.binary)
print ab.occurs_at(1, 'bc'.binary)
print ab.occurs_at(-1, 'a'.binary)
print ab.occurs_at(2, ''.binary)
print ab.occurs_at(3, ''.binary)
print ab.occurs_at(9223372036854775807, 'a'.binary)
