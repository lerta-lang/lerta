# starts_with and ends_with compare the bytes at the ends; an empty part is at both ends.
bytes := 'abc'.binary
print bytes.starts_with('ab'.binary)
print bytes.starts_with('bc'.binary)
print bytes.ends_with('bc'.binary)
print bytes.ends_with('ab'.binary)
print bytes.ends_with('zabc'.binary)
print bytes.starts_with('abcd'.binary)
print bytes.ends_with(''.binary)
print ''.binary.starts_with(''.binary)
print ''.binary.ends_with('a'.binary)
