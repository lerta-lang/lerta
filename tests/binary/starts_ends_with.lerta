# starts_with and ends_with compare the bytes at the ends; an empty part is at both ends.
bytes := b'abc'
print bytes.starts_with(b'ab')
print bytes.starts_with(b'bc')
print bytes.ends_with(b'bc')
print bytes.ends_with(b'ab')
print bytes.ends_with(b'zabc')
print bytes.starts_with(b'abcd')
print bytes.ends_with(b'')
print b''.starts_with(b'')
print b''.ends_with(b'a')
