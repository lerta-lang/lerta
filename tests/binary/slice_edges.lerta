# A slice may be empty at either end and may be the whole Binary, which keeps every byte; a start
# below 0 throws, as an end beyond the length and a start after the end do.
bytes := 'héllo'.binary
print bytes[bytes.length...bytes.length].length
print bytes[0...0].length
whole := bytes[0...bytes.length]
print whole.length
print whole == bytes
print whole.text()!
try
  print bytes[-1...1].length
catch e: IndexError
  print e.message
