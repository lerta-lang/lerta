# A Binary built a byte at a time, from an empty literal, keeps every byte as it grows past the size
# of each place it is in; one that something else holds is copied by `+=`, which leaves the other
# as it was.
var built = b''
built += (i % 251).to_byte()! for i in 0..300
print built.length
print [i for i in 0..300 when built[i] != (i % 251).to_byte()!].length

seven: Byte = 7
kept := built
built += seven
print [kept.length, built.length, built[300].to_int()]

eight: Byte = 8
held := [built]
built += eight
print [held[0].length, built.length, built[301].to_int()]

# Past the largest size class, into a region of its own, which then grows too.
var large = b''
large += (i % 256).to_byte()! for i in 0..300000
print large.length
print [i for i in 0..300000 when i % 997 == 0 and large[i] != (i % 256).to_byte()!].length
