# The UInt32s of a Binary are read little-endian, counted in UInt32s, the last whole one included;
# an index below 0, at or past the whole ones, into bytes left over that make no whole one, or so
# large that its bytes' place overflows throws an IndexError.
bytes: Byte[] = [0x01, 0x02, 0x03, 0x04, 0xFF, 0xFF, 0xFF, 0xFF, 0x00, 0x00, 0x00, 0x80, 0xAA, 0xBB]
words := bytes.to_binary()
attempt := (name: String, data: Binary, index: Int) ->
  try
    print "#{name}: #{data.uint32_at(index).to_int().to_hex()}"
  catch e: IndexError
    print "#{name}: #{e.message}"

attempt 'first', words, 0
attempt 'all ones', words, 1
attempt 'last whole one', words, 2
attempt 'into the bytes left over', words, 3
attempt 'past the end', words, 4
attempt 'negative', words, -1
attempt 'huge', words, 1 << 62
attempt 'of an empty one', b'', 0
attempt 'of three bytes', b'abc', 0
print words.uint32_at(0) + 1
