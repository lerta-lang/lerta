# The expected type reaches literals inside arithmetic, case arms, arrays and return values.
const c: Byte = 200
print c == 1 + 2
print c < 100 + 101
const d: Byte = case
  when c == 1 then 2
  else 3
print d
print [3, c][1]
const as_byte = (): Byte -> 3
const letter = (b: Bool): Byte ->
  return 'y' if b
  'z'
print as_byte()
print letter(true)
print letter(false)
print 200 / 3 == c / 3
var k: Byte = 3
k *= 100
print k
print c % 7
print c / 3
const ys: Array<Byte> = [10]
ys[0] += 250
print ys[0]
print -c
