c: Byte = b'a'
print c
d: Byte? = b"\xFF"
print d!
print c == b'a' and c in b'0'..=b'z'
print [b'x', b'y', c]
xs: Byte[] = [b"\n", 0x20]
print xs
print c in [b'a', b'b']
case c
  when b'a' then print('a')
  else print('other')
print b'ab'.length
print (b'ab' + c).length
print (b'a' + c).length
m: Byte? = nil
print m else b'q'
length_of := (bytes: Binary) -> bytes.length
print length_of(b'a')
tab: Byte = b"\t"
print tab
print (b'a' + b'b').length
takes_byte := (b: Byte) -> b
print takes_byte(b'z')
five: Byte = b'5'
print five - b'0'
print b'9' - five
print b'a' == c and b'a' <= c
print [b'a', five]
byte_of := (): Byte -> b'a'
print byte_of()
print five + b'a'
print five * b"\x02"
sum: Byte = 1 + b'a'
print sum
maybe: Byte? = 1
print maybe == b'a'
print [five].contains(b'5')
answer: Byte = five > 0 then b'y' else b'n'
print answer
counts: Map<Byte, Int>
counts[b'a'] = 1
print counts[b'a']!
print b'x'[0] == b'x'
print b'a' - five
print b"\x02" * five
first := <T>(x: T, y: T) -> x
print first(five, b'a')
either: Byte | Binary = b'a'
print either is Byte
print five + b'a' + b"\x02"
