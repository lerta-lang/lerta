# Binary literals: `b'...'` as written, `b"..."` with the escapes and interpolations of `"..."`.
empty := b''
print empty.length
raw := b'a\n#{x}'
print raw.length
bytes := b"\xFF\0\n\u{E9}"
print [byte.to_int() for byte in bytes]
name := 'hi'
count := 3
joined := b"<#{raw}|#{name}|#{count}>"
print joined.text()!
print b'hi' == name.binary
var grown = b'ab'
grown += b'c'
print grown.text()!
print b'ab'.length
TABLE := b'0123456789abcdef'
print TABLE[10]
