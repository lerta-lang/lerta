# `+` joins two Binarys into a new one, as it joins Strings, and `+=` appends to one; join joins a
# Binary[], whatever its bytes are.
invalid: Byte[] = [0xff, 0xfe]
left := b'ab'
joined := left + invalid.to_binary()
print joined.length
print joined[2]
print left.length
var built = b''
built += b'x'
built += b'yz'
print built.text()!
parts := [b'a', invalid.to_binary(), b'', b'c']
print parts.join(b', ').length
print parts.join(b'')[1]
none: Binary[]
print none.join(b'-').length
print [b'one'].join(b'-').text()!
print none.join(b'').length
print [b'only'].join(b'').text()!
print (b'p' + b'q').text()!
