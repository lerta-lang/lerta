# `+` joins two Binarys into a new one, as it joins Strings, and `+=` appends to one; join joins a
# Binary[], whatever its bytes are.
const invalid: Byte[] = [0xff, 0xfe]
const left = 'ab'.binary
const joined = left + invalid.to_binary()
print joined.length
print joined[2]
print left.length
var built = ''.binary
built += 'x'.binary
built += 'yz'.binary
print built.text()!
const parts = ['a'.binary, invalid.to_binary(), ''.binary, 'c'.binary]
print parts.join(', '.binary).length
print parts.join(''.binary)[1]
const none: Binary[]
print none.join('-'.binary).length
print ['one'.binary].join('-'.binary).text()!
print none.join(''.binary).length
print ['only'.binary].join(''.binary).text()!
print ('p'.binary + 'q'.binary).text()!
