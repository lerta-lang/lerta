b: Byte = 0xF0
print [b & 0x3C, b | 0x0F, b ^ 0xFF, b >> 4, b >> 7]
# `<<` of a Byte drops the bits shifted out.
print [b << 1, b << 4, b << 7]
var c: Byte = 1
c <<= 7
c |= 1
print c
bytes: Byte[] = [0xFF]
bytes[0] ^= 0x0F
bytes[0] &= 0x3C
print bytes[0]
# A shift whose type comes from the context.
top: Byte = 1 << 7
print top
