# The place of the first occurrence of bytes or a byte, from a place on, or nil.
b := b'abcabc'
print [b.index_of(b'c')!, b.index_of(b'c', 3)!, b.index_of(b'b'[0])!]
print [b.index_of(b'bc', 2)!, b.index_of(b'', 6)!, b.index_of(b'')!]
print [b.index_of(b'x') == nil, b.index_of(b'abcd', 4) == nil]
print [b.index_of(b'a', 7) == nil, b.index_of(b'a'[0], 9) == nil]
print b.index_of(b'c'[0], 3)!
print b.index_of(b'', 7) == nil
print b.index_of(b'a'[0], 6) == nil
print b.index_of(b'b'[0], 1)!
print [b.index_of(b'ab')!, b'abc'.index_of(b'bc', 1)!]
# A part of one byte, at the last place, and from the end, past which nothing is.
print b.index_of(b'c', 5)!
print b.index_of(b'c', 6) == nil
print 'aaa'.split('aa')
print ',a,'.split(',')
