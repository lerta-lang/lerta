# The place of the first occurrence of bytes or a byte, from a place on, or nil.
b := 'abcabc'.binary
print [b.index_of('c'.binary)!, b.index_of('c'.binary, 3)!, b.index_of('b'.binary[0])!]
print [b.index_of('bc'.binary, 2)!, b.index_of(''.binary, 6)!, b.index_of(''.binary)!]
print [b.index_of('x'.binary) == nil, b.index_of('abcd'.binary, 4) == nil]
print [b.index_of('a'.binary, 7) == nil, b.index_of('a'.binary[0], 9) == nil]
print b.index_of('c'.binary[0], 3)!
print b.index_of(''.binary, 7) == nil
print b.index_of('a'.binary[0], 6) == nil
print b.index_of('b'.binary[0], 1)!
print [b.index_of('ab'.binary)!, 'abc'.binary.index_of('bc'.binary, 1)!]
# A part of one byte, at the last place, and from the end, past which nothing is.
print b.index_of('c'.binary, 5)!
print b.index_of('c'.binary, 6) == nil
print 'aaa'.split('aa')
print ',a,'.split(',')
