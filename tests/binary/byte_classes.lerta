# The edges of each class, and a byte of a non-ASCII character.
classes := (c: Byte) -> "#{c.is_digit()} #{c.is_letter()} #{c.is_alphanumeric()} #{c.is_space()}"
print "#{c}: #{classes(c)}" for c in b'/09:@AZ[`az{_ '
print classes(b"\t"[0]) + ' ' + classes(b"\n"[0]) + ' ' + classes(b"\r"[0])
print classes(b'é'[0])
edges: Byte[] = [0x7F, 0x80, 0xBF, 0xC0]
print "#{b}: #{b.is_utf8_continuation()}" for b in edges
print [b.is_utf8_continuation() for b in b'é'] == [false, true]
print "#{c}: #{c.is_lower()} #{c.is_upper()}" for c in b'@AZ[`az{1'
print [b.is_lower() or b.is_upper() for b in b'é']
