# The edges of each class, and a byte of a non-ASCII character.
const classes = (c: Byte): String ->
  "#{c.is_digit()} #{c.is_letter()} #{c.is_space()}"
print "#{c}: #{classes(c)}" for c in '/09:@AZ[`az{_ '.binary
print classes("\t".binary[0]) + ' ' + classes("\n".binary[0]) + ' ' + classes("\r".binary[0])
print classes('é'.binary[0])
const edges: Array<Byte> = [0x7F, 0x80, 0xBF, 0xC0]
print "#{b}: #{b.is_utf8_continuation()}" for b in edges
print [b.is_utf8_continuation() for b in 'é'.binary] == [false, true]
