# `b[start...end]` copies the bytes from `start` up to `end` into a new Binary: empty, whole or in
# between, evaluating each end once; a range not in the Binary throws an IndexError.
bytes := 'héllo'.binary
print bytes[1...3] == 'é'.binary
print [bytes[0...0].length, bytes[bytes.length...bytes.length].length]
print bytes[0...bytes.length].text()!
var calls = 0
at := (place: Int) ->
  calls += 1
  place
print bytes[at(3)...at(6)].text()!
print calls
attempt := (name: String, f: () -> Binary) ->
  try
    print "#{name}: #{f().length}"
  catch e: IndexError
    print "#{name}: #{e.message}"
attempt 'past the end', -> bytes[2...9]
attempt 'reversed', -> bytes[3...1]
attempt 'negative', -> bytes[-1...2]
attempt 'made', -> ('ab'.binary + bytes)[1...4]
fail := (): Int -> throw IndexError('from the end')
attempt 'end throws', -> bytes[0...fail()]
print [byte for byte in bytes[3...5]]
attempt 'made, end throws', -> ('ab'.binary + bytes)[0...fail()]
attempt 'end of Int', -> bytes[0...9223372036854775807]
calls = 0
attempt 'start, then end', -> bytes[at(1)...fail()]
print calls
