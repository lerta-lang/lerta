# Bytes that are not UTF-8 give no text: a lone continuation, a lead without its continuations,
# an overlong form, a surrogate and a code point above U+10FFFF.
text_of := (bytes: Byte[]) -> bytes.to_binary().text() ? 'nil'

print text_of([0xE2, 0x82, 0xAC])
print text_of([0x82])
print text_of([0xE2, 0x82])
print text_of([0xC0, 0xAF])
print text_of([0xE0, 0x80, 0xAF])
print text_of([0xED, 0xA0, 0x80])
print text_of([0xF4, 0x90, 0x80, 0x80])
print text_of([0xF0, 0x9F, 0x98, 0x80])
# The leads 0xC1 and 0xF5 start no sequence, an overlong 4-byte form and a cut one are no UTF-8,
# and the last code point below the surrogates and the highest one are.
print text_of([0xC1, 0xBF])
print text_of([0xF5, 0x80, 0x80, 0x80])
print text_of([0xF0, 0x8F, 0xBF, 0xBF])
print text_of([0xF0, 0x9F, 0x98])
print text_of([0xED, 0x9F, 0xBF]).binary.length
print text_of([0xF4, 0x8F, 0xBF, 0xBF]).binary.length
# Only the bytes asked for are checked.
mixed: Byte[] = [0xFF, b'o', b'k', 0xFF]
print mixed.to_binary().text(1, 3)!
# A range that cuts a sequence gives no text; the bounds default to the whole.
bytes := b'héllo'
print bytes.text(0, 2) == nil
print bytes.text(0, 3)!
print bytes.text(3, 6)!
print bytes.text(2, 2)!.is_empty()
print bytes.text(3)!
print bytes.text(6)!.is_empty()
print bytes.text()!
print b''.text()!.is_empty()
# The runtime takes 8 ASCII bytes at a time: a byte that is no UTF-8 at the first or the last place
# of such a run is still found, and so is a cut sequence after the runs, and a character between
# them is read.
eight := b'abcdefgh'.to_array()
for place in [0, 7, 8, 15]
  run := [eight..., eight...]
  run[place] = 0xFF
  print text_of(run) == 'nil'
print text_of([eight..., eight..., 0xC3])
print text_of([eight..., 0xC3, 0xA9, eight...])
# Past the runs, the bytes left are checked one at a time.
tail := [eight..., b'x', b'y', b'z', 0xC3, 0xA9]
print text_of(tail)
tail[11] = 0xFF
print text_of(tail)
# A continuation is checked at each place: second, third and fourth.
print text_of([0xC3, 0x41])
print text_of([0xE2, 0x82, 0x41])
print text_of([0xF0, 0x9F, 0x98, 0x41])
