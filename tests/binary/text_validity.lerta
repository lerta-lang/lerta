# Bytes that are not UTF-8 give no text: a lone continuation, a lead without its continuations,
# an overlong form, a surrogate and a code point above U+10FFFF.
const text_of = (bytes: Array<Byte>) -> bytes.to_binary().text() ? 'nil'

print text_of([0xE2, 0x82, 0xAC])
print text_of([0x82])
print text_of([0xE2, 0x82])
print text_of([0xC0, 0xAF])
print text_of([0xE0, 0x80, 0xAF])
print text_of([0xED, 0xA0, 0x80])
print text_of([0xF4, 0x90, 0x80, 0x80])
print text_of([0xF0, 0x9F, 0x98, 0x80])
# Only the bytes asked for are checked.
const mixed: Array<Byte> = [0xFF, 'o', 'k', 0xFF]
print mixed.to_binary().text(1, 3)!
