# Constant expressions are evaluated as the program would, and their values written in place.
import KB, UNIT from './lib/sizes'

SIZE := 64 * KB
LABEL := "#{SIZE}" + ' ' + UNIT
MASK: Byte = 0xF0 | 0x0F
SHIFTED: Int8 = 1 << 6
SMALLEST: Int16 = -32767 - 1
QUOTIENT := -7 / 2
REMAINDER := -7 % 2
NEGATED := -(KB >> 2)
WIDEST: UInt64 = 9223372036854775807
LARGEST := WIDEST * 2 + 1
BEFORE := INT_MAX - 1
JOINED := 'con' + 'stant' + UNIT

show := -> "#{SIZE} #{MASK} #{SHIFTED} #{SMALLEST} #{QUOTIENT} #{REMAINDER} #{NEGATED}"

print show()
print LABEL
print LARGEST
print BEFORE
print JOINED
print 3 * 5 ^ 1
POWER := 2 ** 3 ** 2
INVERTED: Byte = ~0x0F
WIDE_INVERTED: UInt64 = ~0
print [POWER, ~POWER, ~(2 ** 12 - 1)]
print INVERTED
print WIDE_INVERTED
