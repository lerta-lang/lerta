# What is no constant expression throws as the program runs: a const that converts its value, a
# const in a function, a local that takes a top-level const's name, and a float.
LEAST: Int8 = -128
MAYBE: Int? = INT_MAX - 1 + 1
WHOLE: Float = 3 + 4

attempt := (run: () -> Int) ->
  try
    print run()
  catch e: ArithmeticError
    print e.message

attempt -> (MAYBE else 0) + 1
attempt ->
  most := INT_MAX
  most + 1
attempt ->
  LEAST := INT_MAX
  LEAST + 1
print WHOLE
print LEAST
