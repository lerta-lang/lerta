interface Labeled
  label: String
  describe: () -> String

struct Tag
  label: String

class Sign
  args
    var label: String

extend Tag
  describe := -> "tag #{@label}"

extend Sign
  describe := -> "sign #{@label}"

pick := (i: Int): Tag | Sign -> i == 0 then Tag('red') else Sign('stop')
for i in 0..3
  labeled: Labeled? = i < 2 then pick(i)
  print "#{labeled?.label else 'none'}: #{labeled?.describe() else '-'}"
