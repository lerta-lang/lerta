interface Labeled
  label: String
  describe: () -> String

struct Tag
  label: String

class Sign
  var label: String

extend Tag
  describe = -> "tag #{@label}"

extend Sign
  describe = -> "sign #{@label}"

const pick = (i: Int): Tag | Sign -> i == 0 then Tag(label: 'red') else Sign(label: 'stop')
for i in 0...3
  const labeled: Labeled? = i < 2 then pick(i) else nil
  print "#{labeled?.label ? 'none'}: #{labeled?.describe() ? '-'}"
