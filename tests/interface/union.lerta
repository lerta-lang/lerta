# A union satisfies an interface by the fields that all its members have, of the same type, as
# they are read and called through it.
struct Square
  name: String
  area: () -> Int
class Circle
  name: String
  area: () -> Int

interface Shape
  name: String
  area: () -> Int

const pick = (square: Bool): Square | Circle ->
  square then Square(name: 'square', area: -> 4) else Circle(name: 'circle', area: -> 3)
const describe = <T: Shape>(shape: T) -> print "#{shape.name}: #{shape.area()}"

describe pick(true)
describe pick(false)
const shape = pick(false)
print shape.area()
