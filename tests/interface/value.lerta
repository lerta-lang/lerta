# Values of interface types: a value converts to one where it is expected, and its members are
# read and called through it.
interface Shape
  area: () -> Int
  name: String
struct Square
  side: Int
  name = 'square'
  area = -> @side * @side
class Circle
  r: Int
  name = 'circle'
  area = -> 3 * @r * @r
shapes: Shape[] = [Square(side: 2), Circle(r: 1)]
print "#{s.name}: #{s.area()}" for s in shapes
one: Shape = Square(side: 3)
print one.area()
