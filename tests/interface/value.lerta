# Values of interface types: a value converts to one where it is expected, and its members are
# read and called through it.
interface Shape
  area: () -> Int
  name: String
struct Square
  side: Int
  name := 'square'
  area := -> @side * @side
class Circle
  args
    r: Int
  name := 'circle'
  area := -> 3 * @r * @r
shapes: Shape[] = [Square(2), Circle(1)]
print "#{s.name}: #{s.area()}" for s in shapes
one: Shape = Square(3)
print one.area()
