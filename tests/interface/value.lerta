# Values of interface types: a value converts to one where it is expected, and its members are
# read and called through it.
interface Shape
  area: () -> Int
  name: String
struct Square
  side: Int
  name = 'square'
  area = (): Int -> @side * @side
class Circle
  r: Int
  name = 'circle'
  area = (): Int -> 3 * @r * @r
const shapes: Array<Shape> = [Square(side: 2), Circle(r: 1)]
for s in shapes
  print "#{s.name}: #{s.area()}"
const one: Shape = Square(side: 3)
print one.area()
