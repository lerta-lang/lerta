# An extend of an interface gives its methods to the types that satisfy it, Self to those that
# name it; in them, @ is of the satisfying type.
interface Source<T>
  next_value: () -> T
  name: String

extend<T> Source<T>
  take_two = (): T[] -> [@next_value(), @next_value()]
  describe = -> "source #{@name}"

class Counter
  var n = 0
  name = 'counter'
  next_value = ->
    @n += 1
    @n

interface Equatable
  equals: (Self) -> Bool

extend Equatable
  differs = (other: Self) -> not @equals(other)

struct Point
  x: Int
  equals = (other: Point) -> @x == other.x

c := Counter()
pair := c.take_two()
print pair[0] + pair[1]
print c.describe()
print Point(x: 1).differs(Point(x: 2))

# Interface values satisfy their interface, and a method may have type parameters of its own.
extend<T> Source<T>
  mapped = <U>(f: (T) -> U): U -> f(@next_value())

source: Source<Int> = Counter()
print source.describe()
print source.mapped((n) -> n * 10)
