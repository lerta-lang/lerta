# A generic interface bounds type parameters, whose type arguments the members of a type give, and
# is a type of values; Self stands for the type that satisfies an interface.
interface Source<T>
  next_value: () -> T
  name: String

class Counter
  var n = 0
  name = 'counter'
  next_value = ->
    @n += 1
    @n

struct Words
  name: String
  next_value: () -> String

first := <T, S: Source<T>>(source: S): T -> source.next_value()
second := <T>(source: Source<T>): T ->
  source.next_value()
  source.next_value()

print first(Counter())
print second(Counter())
print first(Words(name: 'w', next_value: -> 'hi'))
sources: Source<Int>[] = [Counter(), Counter()]
print "#{s.name} #{s.next_value()}" for s in sources

interface Equatable
  equals: (Self) -> Bool

struct Point
  x: Int
  equals = (other: Point) -> @x == other.x

same := <T: Equatable>(a: T, b: T) -> a.equals(b)
print same(Point(1), Point(1))
print same(Point(1), Point(2))
