# A generic interface bounds type parameters, whose type arguments the members of a type give, and
# is a type of values; Self stands for the type that satisfies an interface.
interface Source<T>
  next_value: () -> T
  name: String

class Counter
  var n = 0
  name = 'counter'
  next_value = (): Int ->
    @n += 1
    @n

struct Words
  name: String
  next_value: () -> String

const first = <T, S: Source<T>>(source: S): T -> source.next_value()
const second = <T>(source: Source<T>): T ->
  source.next_value()
  source.next_value()

print first(Counter())
print second(Counter())
print first(Words(name: 'w', next_value: -> 'hi'))
const sources: Source<Int>[] = [Counter(), Counter()]
print "#{s.name} #{s.next_value()}" for s in sources

interface Equatable
  equals: (Self) -> Bool

struct Point
  x: Int
  equals = (other: Point) -> @x == other.x

const same = <T: Equatable>(a: T, b: T) -> a.equals(b)
print same(Point(x: 1), Point(x: 1))
print same(Point(x: 1), Point(x: 2))
