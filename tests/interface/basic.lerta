# A type satisfies an interface by having each member: a method, a field or a property of exactly
# the member's type.
interface Shape
  area: () -> Int
  name: String

class Square
  side: Int
  name = 'square'
  area = -> @side * @side

struct Circle(name: String, area: () -> Int)

describe := <T: Shape>(shape: T) -> print("#{shape.name}: #{shape.area()}")

describe Square(side: 3)
describe Circle(name: 'circle', area: -> 12)
describe { name: 'record', area: -> 1 }
