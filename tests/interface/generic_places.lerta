# Generic interface types as parts of other types, recursive ones, and optional parameters.
interface Box<T>
  get: () -> T

struct IntBox
  value: Int
  get = () -> @value

interface Node<T>
  value: T
  next: () -> Node<T>?

class Link
  value: Int
  rest: Link?
  next = (): Node<Int>? ->
    const rest = @rest ? return nil
    rest

const boxes: Array<Box<Int>> = [IntBox(value: 1), IntBox(value: 2)]
const by_name: Map<String, Box<Int>> = { 'a': IntBox(value: 3) }
print box.get() for box in boxes
print by_name['a']?.get() ? 0
const unwrap = <T>(box: Box<T>?): T? -> box?.get()
print unwrap(IntBox(value: 4)) ? 0
var node: Node<Int>? = Link(value: 5, rest: Link(value: 6, rest: nil))
while const each = node
  print each.value
  node = each.next()
