# Generic interface types as parts of other types, recursive ones, and optional parameters.
interface Box<T>
  get: () -> T

struct IntBox
  value: Int
  get := -> @value

interface Node<T>
  value: T
  next: () -> Node<T>?

class Link
  args
    value: Int
    rest: Link?
  next := (): Node<Int>? ->
    rest := @rest else return nil
    rest

boxes: Box<Int>[] = [IntBox(1), IntBox(2)]
by_name: Map<String, Box<Int>> = { 'a': IntBox(3) }
print box.get() for box in boxes
print by_name['a']?.get() else 0
unwrap := <T>(box: Box<T>?): T? -> box?.get()
print unwrap(IntBox(4)) else 0
var node: Node<Int>? = Link(value: 5, rest: Link(value: 6, rest: nil))
while each := node
  print each.value
  node = each.next()
