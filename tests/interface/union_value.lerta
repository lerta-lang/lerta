interface Shape
  area: () -> Int
  name: String

class Square
  side: Int
  name = 'square'
  area = -> @side * @side

struct Circle
  radius: Int
  name: String
  area = -> 3 * @radius * @radius

const show = (s: Stringable) -> print "<#{s.to_string()}>"
const values: (Int | String | Float)[] = [1, 'a', 2.5]
show v for v in values

const shapes: Shape[] = []
const pick = (i: Int): Square | Circle -> i == 0 then Square(side: 2) else Circle(radius: 1, name: 'circle')
shapes.push pick(i) for i in 0...2
print "#{s.name} #{s.area()}" for s in shapes
