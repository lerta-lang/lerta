# An interface value holds its data as any reference does: it is released with the last value
# that holds it.
interface Named
  name: String

class Resource
  name: String
  deinit = -> print("closing #{@name}")

var held: Named? = Resource('a')
all: Named[] = [Resource('b')]
print 'replacing'
held = Resource('c')
print held?.name ? 'none'
print 'clearing'
held = nil
all.pop()
print 'done'

# Replaced and removed items, items that a filter holds, and a captured var are released too.
make := (name: String): Named -> Resource(name)
items := [make('d')]
items[0] = make('e')
by_key := { 1: make('f') }
by_key[1] = make('g')
by_key.remove 1
kept := [item.name for item in items.iter().filter((item) -> item.name == 'e')]
print kept.length
var captured = make('h')
read := -> captured.name
captured = make('i')
print read()
print 'end'
