# An interface value holds its data as any reference does: it is released with the last value
# that holds it.
interface Named
  name: String

class Resource
  name: String
  deinit = -> print "closing #{@name}"

var held: Named? = Resource(name: 'a')
const all: Named[] = [Resource(name: 'b')]
print 'replacing'
held = Resource(name: 'c')
print held?.name ? 'none'
print 'clearing'
held = nil
all.pop()
print 'done'

# Replaced and removed items, items that a filter holds, and a captured var are released too.
const make = (name: String): Named -> Resource(name)
const items: Named[] = [make('d')]
items[0] = make('e')
const by_key: Map<Int, Named> = { 1: make('f') }
by_key[1] = make('g')
by_key.remove 1
const kept = [item.name for item in items.iter().filter((item) -> item.name == 'e')]
print kept.length
var captured = make('h')
const read = -> captured.name
captured = make('i')
print read()
print 'end'
