interface Runner
  run: (Int) -> String
  stop: () -> void

struct Stopped(message: String)

class Machine
  name: String
  run = (times: Int) -> @name.repeat(times)
  stop = (): void -> throw Stopped(message: "#{@name} stopped")

extend Int
  run = (times: Int) -> (@ * times).to_string()
  stop = -> print("#{@} stops")

pick := (i: Int): Machine | Int -> i == 0 then Machine(name: 'ab') else 7
for i in 0...2
  runner: Runner = pick(i)
  print runner.run(3)
  try
    runner.stop()
  catch e: Stopped
    print "caught #{e.message}"
  maybe: Runner? = i == 0 then pick(i) else nil
  print maybe?.run(2) ? 'none'
