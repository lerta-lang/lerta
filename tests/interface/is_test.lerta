# is and as tell whether an interface value holds an object of a class or struct, to which is
# narrows the value.
struct Bad: Error
  message: String
  code: Int

class Odd: Error
  args
    message: String

interface Named
  name: String

e: Error? = Bad(message: 'm', code: 3)
print e.code if e is Bad
print e is Odd
f: Error = Odd('o')
print f is Bad
assert f is Odd
print f.message
print (f as Bad?)?.code else -1
g: Error = Bad(message: 'x', code: 7)
print (g as Bad!).code
none: Error? = nil
print none is Bad
try
  print (f as Bad!).code
catch error: CastError
  print error.message
try
  print [1][4]
catch error
  print error is IndexError
  assert error is IndexError
  print error.message

# A nil optional interface value holds no object.
print (none as Bad?) == nil

# A value narrowed by `is` is cast as the object it is.
print (e as Bad?)!.code if e is Bad

# Where `is` does not hold, the value is still of the interface.
if f is Bad
  print 'no'
else
  print f.message

# A guard narrows as an if does, an optional value too.
code_of := (error: Error?) ->
  return -1 unless error is Bad
  error.code
print code_of(e)
print code_of(nil)

# `as T!` of nil throws.
try
  print (none as Bad!).code
catch error: CastError
  print error.message
