# An instance of a generic interface whose type arguments make a member type invalid is an error
# where it is first written, as an instance of a generic class is.
interface Source<T>
  items: () -> Map<Int, T>

interface Table<K, V>
  entries: Map<K, V>

interface Sink<T>
  put: (Map<Int, T>) -> void

interface Node<T>
  value: T
  next: () -> Node<T>?

type Maybes = Source<Float?>
written: Source<Int?>? = nil
again: Source<Int?>? = nil
keys: Table<Int?, Int>? = nil
values: Table<Int, Bool?>? = nil
funcs: Table<() -> void, Int>? = nil
sink: Sink<Bool?>? = nil
bounded := <T: Source<Byte?>>(source: T) -> source.items().length
node: Node<Int?>? = nil
valid: Source<Int>? = nil
