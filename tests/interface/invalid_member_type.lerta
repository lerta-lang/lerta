# An instance of a generic interface whose type arguments make a member type invalid is an error
# where it is first written, as an instance of a generic class is.
interface Source<T>
  items: () -> T[]

interface Table<K, V>
  entries: Map<K, V>

interface Sink<T>
  put: (T[]) -> void

interface Node<T>
  value: T
  next: () -> Node<T>?

type Maybes = Source<Float?>
const written: Source<Int?>? = nil
const again: Source<Int?>? = nil
const keys: Table<Int?, Int>? = nil
const values: Table<Int, Bool?>? = nil
const funcs: Table<() -> void, Int>? = nil
const sink: Sink<Bool?>? = nil
const bounded = <T: Source<Byte?>>(source: T) -> source.items().length
const node: Node<Int?>? = nil
const valid: Source<Int>? = nil
