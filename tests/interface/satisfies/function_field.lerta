# A field that holds a function, declared, stands for a method of the interface, which the
# constructor then takes; so does a method. A member that a type argument makes a function, or that
# is an optional function, is no method, and is a field that the constructor takes.
interface Handler
  handle: (Int) -> Int

struct Doubler: Handler
  handle: (Int) -> Int

struct Adder: Handler
  handle := (x: Int) -> x + 1

interface Box<T>
  value: T

struct Thunk: Box<() -> Int>

interface Hooked
  hook: (() -> Int)?

struct Unhooked: Hooked

handlers: Handler[] = [Doubler(handle: (x) -> x * 2), Adder()]
print [handler.handle(20) for handler in handlers]
print Thunk(value: -> 3).value()
print Unhooked(hook: nil).hook == nil
