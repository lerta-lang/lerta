struct NotFound: Error

class Shape: Stringable
  args
    name: String
  to_string := -> "shape #{@name}"

interface Source<T>
  next_value: () -> T
  label: String

class Counter: Source<Int>
  args
    label: String
  var count = 0
  next_value := ->
    @count += 1
    @count

struct Boxed<T>: Source<T>
  value: T
  next_value := -> @value

class Labeled: Error
  args
    message: String
    code := 1

try
  throw NotFound('missing')
catch e: NotFound
  print e.message
print Shape('a')
counter := Counter('counter')
counter.next_value()
print "#{counter.label} #{counter.next_value()}"
print Boxed(value: 'x', label: 'boxed').next_value()
labeled := Labeled('m')
print "#{labeled.message} #{labeled.code}"
