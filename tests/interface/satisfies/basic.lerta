struct NotFound: Error

class Shape: Stringable
  name: String
  to_string = -> "shape #{@name}"

interface Source<T>
  next_value: () -> T
  label: String

class Counter: Source<Int>
  count = 0
  next_value = ->
    @count += 1
    @count

struct Boxed<T>: Source<T>
  value: T
  next_value = -> @value

class Labeled: Error
  code = default 1

try
  throw NotFound(message: 'missing')
catch e: NotFound
  print e.message
print Shape(name: 'a')
const counter = Counter(label: 'counter')
counter.next_value()
print "#{counter.label} #{counter.next_value()}"
print Boxed(value: 'x', label: 'boxed').next_value()
const labeled = Labeled(message: 'm')
labeled.message = 'changed'
print "#{labeled.message} #{labeled.code}"
