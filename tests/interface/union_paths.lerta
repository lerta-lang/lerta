interface Runner
  run: () -> String

interface Narrow
  to_byte: () -> Byte?

struct Failed
  message: String

class Fails
  run := (): String -> throw Failed('failed')

class Works
  run := -> 'ran'

runners: Runner[]
pick := (i: Int): Works | Fails -> i == 0 then Works() else Fails()
runners.push pick(i) for i in 0..2
for runner in runners
  try
    print runner.run()
  catch e: Failed
    print "caught #{e.message}"

narrow := (n: Int | Int32): Narrow -> n
print value.to_byte()?.to_string() ? 'too big' for value in [narrow(7), narrow(300)]
print narrow(400.to_int32()!).to_byte()!
