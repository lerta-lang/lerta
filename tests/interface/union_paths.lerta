interface Runner
  run: () -> String

interface Narrow
  to_byte: () -> Byte?

struct Failed
  message: String

class Fails
  run = (): String -> throw Failed(message: 'failed')

class Works
  run = (): String -> 'ran'

const runners: Runner[] = []
const pick = (i: Int): Works | Fails -> i == 0 then Works() else Fails()
runners.push pick(i) for i in 0...2
for runner in runners
  try
    print runner.run()
  catch e: Failed
    print "caught #{e.message}"

const narrow = (n: Int | Int32): Narrow -> n
for value in [narrow(7), narrow(300)]
  print value.to_byte()?.to_string() ? 'too big'
print narrow(400.to_int32()!).to_byte()!
