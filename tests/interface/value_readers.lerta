# Interface values read the members of the types they hold through readers: a field that holds a
# function, and the lengths of maps and Binaries.
interface Sized
  length: Int

interface Greeter
  greet: (String) -> String

struct Polite
  greet: (String) -> String

const sizes: Sized[] = [{ 'a': 1, 'b': 2 }, 'abc'.binary, [1]]
print size.length for size in sizes
const greeter: Greeter = Polite(greet: (name) -> "hello, #{name}")
print greeter.greet('you')
