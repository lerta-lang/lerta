# A member is read through an interface value however the type satisfies it: by a method of its
# own, of an extend or of a generic extend, by a builtin method, by a field that holds a function,
# or by a field or a property.
interface Counter
  count: () -> Int
  push: (Int) -> void
  length: Int

extend Int[]
  count = -> @length

interface Greeter
  greet: (String) -> String
  name: String

struct Fixed(name: String, greet: (String) -> String)

class Polite
  name: String
  greet = (other: String) -> "hello #{other}, I am #{@name}"

interface Last
  last: () -> Int?

counter: Counter = [1, 2]
counter.push 3
print counter.count()
print counter.length
greeters: Greeter[] =
  Polite(name: 'ann')
  Fixed(name: 'bot', greet: (other) -> "hi #{other}")
  { name: 'record', greet: (other: String) -> "yo #{other}" }
print "#{g.name}: #{g.greet('you')}" for g in greeters
last: Last = [7, 8, 9]
print last.last()!
