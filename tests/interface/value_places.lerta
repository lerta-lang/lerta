# Interface values as parameters, results, fields, optional values, map values and items, and
# a bound satisfied by an interface type.
interface Shape
  area: () -> Int
  name: String

struct Square
  side: Int
  name := 'square'
  area := -> @side * @side

class Holder
  args
    shape: Shape
  var spare: Shape?

interface Sized
  length: Int
interface Last
  last: () -> Int?

describe := (s: Shape) -> "#{s.name}=#{s.area()}"
make := (n: Int): Shape -> Square(n)
twice := <T: Shape>(s: T) -> s.area() * 2

print describe({ name: 'rec', area: -> 7 })
print describe(make(4))
print twice(make(5))
h := Holder(make(1))
print h.shape.area()
print h.spare == nil
h.spare = make(2)
print s.name if s := h.spare
shapes := { 'a': make(3) }
print shapes['a']?.area() ? 0
sizes: Sized[] = [[1, 2, 3], b'abcd', { 'k': 1 }]
print s.length for s in sizes
l: Last = [4, 5, 6]
print l.last()!
things: Stringable[] = ['x', make(1).name]
print "#{t}" for t in things
