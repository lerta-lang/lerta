# Interface values as parameters, results, fields, optional values, map values and items, and
# a bound satisfied by an interface type.
interface Shape
  area: () -> Int
  name: String

struct Square
  side: Int
  name = 'square'
  area = (): Int -> @side * @side

class Holder
  shape: Shape
  var spare: Shape? = nil

interface Sized
  length: Int
interface Last
  last: () -> Int?

const describe = (s: Shape): String -> "#{s.name}=#{s.area()}"
const make = (n: Int): Shape -> Square(side: n)
const twice = <T: Shape>(s: T) -> s.area() * 2

print describe({ name: 'rec', area: -> 7 })
print describe(make(4))
print twice(make(5))
const h = Holder(shape: make(1))
print h.shape.area()
print h.spare == nil
h.spare = make(2)
if const s = h.spare
  print s.name
const shapes: Map<String, Shape> = { 'a': make(3) }
print shapes['a']?.area() ? 0
const sizes: Sized[] = [[1, 2, 3], 'abcd'.binary, { 'k': 1 }]
print s.length for s in sizes
const l: Last = [4, 5, 6]
print l.last()!
const things: Stringable[] = ['x', make(1).name]
print "#{t}" for t in things
