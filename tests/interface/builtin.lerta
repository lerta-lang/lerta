# Builtin types satisfy interfaces by their properties and methods, and by extends in effect where
# the bound is checked.
interface Sized
  length: Int

interface Doubled
  doubled: () -> Int

extend Int
  doubled := -> @ * 2

size := <T: Sized>(x: T) -> x.length
double := <T: Doubled>(x: T) -> x.doubled()

print size([1, 2, 3])
print size({ 'a': 1 })
print size(b'ab')
print double(21)
