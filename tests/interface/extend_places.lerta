# A method of an extend of an interface is found for a bounded type parameter, a union, and
# through `@` in another such method and in a class's own method.
interface Named
  name: String

extend Named
  greet := -> "hi #{@name}"
  shout := -> @greet() + '!'

struct A
  name: String

class B
  args
    name: String
  hello := -> @greet()

greet_any := <X: Named>(x: X) -> x.greet()
print greet_any(A('a'))
either: A | B = B('b')
print either.greet()
print A('c').shout()
print B('d').hello()
