# An instance with an invalid member type is reported for each instance of a generic function or
# method that makes it, and an extend of the interface leaves the check as it is.
interface Source<T>
  items: () -> T[]

extend<T> Source<T>
  count = (): Int -> @items().length

class Box<T>
  v: T
  items = (): T[] -> [@v]
  convert = <U>(u: U): Source<U?>? -> nil

wrap := <T>(x: T) ->
  source: Source<T?>? = nil
  source

print Box(v: 1).count()
wrap 1
Box(v: 1).convert(true)
