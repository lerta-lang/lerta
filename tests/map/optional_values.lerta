# A map's values may be optional. A nil value and a missing key both read as nil; `in` tells them
# apart.
names: Map<Int, String?> = { 1: 'ann', 2: nil }
print names[1] else '-'
print names[2] else '-'
print names[3] else '-'
print 2 in names
print 3 in names
print names.length
print names
ages: Map<String, Int?> = { 'ann': nil }
ages['bob'] = 27
print ages['ann'] else -1
print ages['bob'] else -1
print [age else 0 for age in ages.values()]
print "#{name}=#{age else 0}" for (name, age) in ages
value: Int? = 1
counts := Map([('a', value), ('b', nil)])
print counts == { 'a': 1, 'b': nil }
print counts == { 'a': 1, 'b': 2 }
print counts.get_or_add('c', -> nil) else -1
print counts.length
print counts.get_or_add('b', -> 5) else -1
print counts['b'] else -1
labels: Map<Int, String?> = { 1: nil, 2: 'b' }
print labels.remove(1)
print labels.remove(1)
print [label else '-' for label in labels.values()]
