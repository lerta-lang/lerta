# A key's `hash` that places a key in the map that it is placed in ends the program, as the map
# would write the value in the entries that the placing moved.
class K
  args
    s: String
  equals := (other: K) -> @s == other.s
  hash := ->
    if @s.count() < 3
      m[K(@s + '+')] = 0
    0

m: Map<K, Int>
m[K('a')] = 1
print m.length
