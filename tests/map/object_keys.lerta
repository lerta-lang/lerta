class Node(name: String)

class Edge(from: Node)

type Element = Node | Edge

a := Node(name: 'a')
b := Node(name: 'a')
depths: Map<Node, Int>
depths[a] = 1
depths[b] = 2
print depths[a]!
print depths[b]!
print depths.length
depths.remove a
print depths.has(a)
print depths.has(b)
print key.name for key in depths.keys()
labels: Map<Element, String> = { (a): 'node', Edge(from: b): 'edge' }
element: Element = a
print labels[element]!
# The map holds its key, so a key made only for it lives as long as the map.
kept: Map<Node, Int>
kept[Node(name: 'temporary')] = 1
print key.name for key in kept.keys()
