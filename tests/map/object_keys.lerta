class Node
  args
    name: String

class Edge
  args
    from: Node

type Element = Node | Edge

a := Node('a')
b := Node('a')
depths: Map<Node, Int>
depths[a] = 1
depths[b] = 2
print depths[a]!
print depths[b]!
print depths.length
depths.remove a
print a in depths
print b in depths
print key.name for key in depths.keys()
labels: Map<Element, String> = { (a): 'node', Edge(b): 'edge' }
element: Element = a
print labels[element]!

# The map holds its key, so a key made only for it lives as long as the map.
kept: Map<Node, Int>
kept[Node('temporary')] = 1
print key.name for key in kept.keys()
