class Node
  name: String

class Edge
  from: Node

type Element = Node | Edge

const a = Node(name: 'a')
const b = Node(name: 'a')
const depths: Map<Node, Int> = Map()
depths[a] = 1
depths[b] = 2
print depths[a]!
print depths[b]!
print depths.length
depths.remove(a)
print depths.has(a)
print depths.has(b)
for key in depths.keys()
  print key.name
const labels: Map<Element, String> = { (a): 'node', (Edge(from: b)): 'edge' }
const element: Element = a
print labels[element]!
# The map holds its key, so a key made only for it lives as long as the map.
const kept: Map<Node, Int> = Map()
kept[Node(name: 'temporary')] = 1
for key in kept.keys()
  print key.name
