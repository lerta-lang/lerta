struct Point(x: Int)
m: Map<Point, Int>
m[{ x: 1 }] = 2
print m[{ x: 1 }] ? 0

struct Key(name: String?, point: Point?, tags: String[]?, pair: { a: Int }?)
keys: Map<Key, Int>
keys[{ name: nil, point: nil, tags: nil, pair: nil }] = 1
keys[{ name: 'n', point: { x: 1 }, tags: ['t'], pair: { a: 1 } }] = 2
print keys[{ name: nil, point: nil, tags: nil, pair: nil }] ? 0
print keys[{ name: 'n', point: { x: 1 }, tags: ['t'], pair: { a: 1 } }] ? 0
print keys.length
