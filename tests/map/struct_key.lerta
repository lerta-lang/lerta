struct Point
  x: Int
const m: Map<Point, Int> = Map()
m[Point(x: 1)] = 2
print m[Point(x: 1)] ? 0

struct Key
  name: String?
  point: Point?
  tags: Array<String>?
  pair: { a: Int }?
const keys: Map<Key, Int> = Map()
keys[Key(name: nil, point: nil, tags: nil, pair: nil)] = 1
keys[Key(name: 'n', point: Point(x: 1), tags: ['t'], pair: { a: 1 })] = 2
print keys[Key(name: nil, point: nil, tags: nil, pair: nil)] ? 0
print keys[Key(name: 'n', point: Point(x: 1), tags: ['t'], pair: { a: 1 })] ? 0
print keys.length
