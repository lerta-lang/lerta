const ages = { 'ann': 31, 'bob': 27 }
print ages.length
print ages['ann'] ? -1
print ages['eve'] ? -1
ages['eve'] = 40
ages['ann'] = 32
print ages.length
print "#{name} #{ages[name]!}" for name in ages.keys()
print ages.has('bob')
ages.remove('bob')
ages.remove('nobody')
print ages.has('bob')
print ages.keys().to_array().join(',')

const squares: Map<Int, Int> = Map()
squares[i] = i * i for i in 0...100
squares.remove(i) for i in 0...90
print squares.length
print squares[95] ? 0
print squares[5] ? 0
squares[5] = 1
print squares.keys().to_array()[10]

const names: Map<Int, String> = { 1: 'one', 2: 'two' }
const name = names[2]
if name
  print name
print names[3] ? 'none'
const k = 1
print { (k): true }[1] ? false
