# Map() takes (key, value) tuples from anything that a loop goes through; of the same key, the last
# one wins, in the place of the first.
show := (m: Map<String, Int>) -> print("#{key}=#{value}") for (key, value) in m.entries()
show Map([('a', 1), ('b', 2), ('a', 3)])
words := ['x', 'yy']
show Map(((word, word.binary.length) for word in words))
show Map({ 'c': 4 }.entries())
typed := Map<String, Int>([])
print typed.length
