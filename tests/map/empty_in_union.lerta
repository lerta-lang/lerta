# Where a map is expected, as an optional one, a member of a union, a set or a map's value, `{}`
# is no map.
optional: Map<String, Int>? = {}
union: Map<String, Int> | Int = {}
set: Set<Int> = {}
nested: Map<String, Map<String, Int>> = { 'a': {} }
print "#{optional == nil} #{union} #{set.length} #{nested.length}"
