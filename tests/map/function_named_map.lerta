# Functions of the names of Map and Set are called where Map() and Set() would make a map and a
# set: a top-level one, a generic one and a local one.
const Map = (n: Int) -> [n]

const Set = <T>(x: T) -> [x, x]

const local = ->
  const Set = (n: Int) -> n + 1
  Set(1)

print Map(2)
print Set<Int>(3)
print Set('a')
print local()
