# remove releases the rest of the entry it removes even when the release of its key, or of the first
# reference of its value, runs a deinit that adds enough to the map to move its entries.
class Key
  args
    id: Int
    grows: Bool
  equals := (other: Key) -> @id == other.id
  hash := -> @id
  deinit := ->
    return unless @grows
    for i in 100..150
      by_key[Key(id: i, grows: false)] = Probe('filler')

class Probe
  args
    name: String
  deinit := -> print("released #{@name}") unless @name == 'filler'

class Grows
  args
    grows: Bool
  deinit := ->
    return unless @grows
    for i in 100..150
      pairs[i] = (Grows(false), Probe('filler'))

by_key: Map<Key, Probe>
pairs: Map<Int, (Grows, Probe)>

by_key[Key(id: 1, grows: true)] = Probe('value of a key')
print by_key.remove(Key(id: 1, grows: false))
pairs[1] = (Grows(true), Probe('second of a value'))
print pairs.remove(1)
print 'done'
