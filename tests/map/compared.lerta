# Maps compare by their keys and values, in any order, the values as == compares them.
print { 'a': 1, 'b': 2 } == { 'b': 2, 'a': 1 }
print { 'a': 1 } == { 'a': 2 }
print { 'a': 1 } == { 'b': 1 }
print { 'a': 1 } != { 'a': 1, 'b': 2 }
struct Point
  x: Int
  y: Int
points := { 1: Point(x: 1, y: 2) }
print points == { 1: { x: 1, y: 2 } }
print { 'a': [1, 2] } == { 'a': [1, 2] }
print { 'a': { 'b': 1 } } == { 'a': { 'b': 1 } }
print { 1: 0.5 } == { 1: 0.25 }
bytes: Map<Byte, Int8> = { 1: -1 }
print bytes == { 1: -1 }
print Map<String, Int>() == Map()
print { [1, 2]: 'a', [3]: 'b' } == { [3]: 'b', [1, 2]: 'a' }
print points == { 1: { x: 1, y: 3 } }
either: Map<String, Int> | Int = { 'a': 1 }
print either == { 'a': 1 }
print either == 1
print { 1: Set([1, 2]) } == { 1: Set([2, 1]) }
removed := { 'a': 1, 'b': 2, 'c': 3 }
removed.remove 'a'
removed['a'] = 1
print removed == { 'a': 1, 'b': 2, 'c': 3 }
removed.remove 'b'
print removed == { 'c': 3, 'a': 1 }
