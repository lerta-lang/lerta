# A map goes through the entries there when it is made, in insertion order, but those removed since;
# the map does not compact its entries while an Iter of them is alive.
counts := { 'a': 1, 'b': 2, 'c': 3 }
print "#{key}=#{count}" for (key, count) in counts
for (key, _) in counts
  counts.remove 'b' if key == 'a'
  counts["#{key}#{key}"] = 0
  print key
print [key for (key, _) in counts].join(' ')

# Removed and added past the room for them while traversed: the positions stay.
many: Map<Int, String>
many[i] = "#{i}" for i in 0..6
var seen = 0
for (number, _) in many
  many.remove number + 1
  for _ in 0..1
    many[number + 100] = 'new'
  seen += 1
print seen
print many.length
print [number for (number, _) in many].length
flags: Map<Byte, Bool> = { b'x': true, b'y': false }
print "#{key}: #{flag}" for (key, flag) in flags

# An Iter left before its end lets the map compact again.
early := { 'p': [1], 'q': [2] }
for (key, list) in early
  print "#{key}#{list[0]}"
  break
early.remove 'p'
early["r#{i}"] = [i] for i in 0..20
print early.length
empty: Map<String, Int>
print empty.to_array().length

# values gives the values of the entries, as entries does.
scores := { 'a': 1, 'b': 2 }
values := scores.values()
scores.remove 'b'
scores['b'] = 3
print value for value in values
