# A default adds its key, so it is only for a value written; a read is an error, as an operand, an
# argument, or the object of a property or a field that is read.
counts: Map<String, Int>
print counts['a', default: 0]
x := counts['b', default: 0] + 1
boxes: Map<String, (Int, Int)>
n := boxes['c', default: (1, 2)]
lists: Map<String, Int[]>
length := lists['d', default: []].length
show := (value: Int) -> value
show counts['e', default: 0]
var total = 0
total += counts['f', default: 0]
fill := (items: Int[]) -> items.push(1)
fill lists['g', default: []]
