# A map takes changes again once a comparison by the program's own `equals` is done, whether `==`
# finds the maps equal, or stops at a missing key or at values that differ.
class V
  args
    n: Int
  equals := (other: V) -> @n == other.n

a := { 'k': V(1) }
print a == a
a['j'] = V(2)
print a == { 'k': V(1), 'h': V(2) }
a['i'] = V(3)
print a == { 'k': V(1), 'j': V(2), 'i': V(4) }
a.remove 'i'
print a.length
