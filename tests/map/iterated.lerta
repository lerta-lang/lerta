# A map is Iterable: it goes through its entries, in the order of insertion.
m := { 'a': 1, 'b': 2 }
print "#{key}=#{value}" for (key, value) in m
print [key for (key, _) in m]
print m.map((entry) -> entry).to_array()
print m.iter().next()
total := <I: Iterable<(String, Int)>>(entries: I) ->
  var sum = 0
  sum += value for (_, value) in entries
  sum
print total(m)
