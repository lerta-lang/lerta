# keys() is an Iter of the keys, in the order they were first added, of the entries there when it
# is made, as iter() and values() are; it gives no array, and leaves the values held by the map.
lists: Map<String, Int[]>
lists['b'] = [1]
lists['a'] = [2, 3]
lists['c'] = []
print [key for key in lists.keys()]
keys := lists.keys()
lists.remove 'a'
lists['d'] = [4]
print [key for key in keys]
print lists['b']!

# A key that is a tuple is given as itself.
pairs := { (1, 'x'): true, (2, 'y'): false }
print "#{number}#{letter}" for (number, letter) in pairs.keys()
print pairs.keys().to_array().length

# Stopped partway, the Iter leaves the values it has not reached with the map.
break for key in lists.keys()
print lists['d']!
print [key for key in Map<Int, String>().keys()]

# A key removed and added again meanwhile counts as new, and is not given.
keys_now := lists.keys()
lists.remove 'b'
lists['b'] = [5]
print [key for key in keys_now]

key_list := <K, V>(m: Map<K, V>): K[] -> [key for key in m.keys()]
print [key_list(lists), key_list({ 'x': 1 })]

# The keys outlive the map they came from; values of other kinds stay with it.
var ages = { 'ann': 31, 'bob': 27 }
names := ages.keys().to_array()
ages = Map()
print names
flags := { 'on': true, 'off': false }
small: Int8 = 1
tiny := { (small): small }
print [key for key in flags.keys()]
print [key.to_int() for key in tiny.keys()]
shown: Map<String, Stringable> = { 'one': 'uno' }
print [key for key in shown.keys()]
print [flags.keys().all((key) -> not key.is_empty()), flags.keys().all((key) -> key == 'on')]
print flags.keys().map((key) -> key.binary.length).to_array()
