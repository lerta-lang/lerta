# A key's `hash` and `equals` may look up keys, of the map that they are compared in and of others,
# which changes none.
class K
  args
    s: String
  equals := (other: K) ->
    seen[@s] = (seen[@s] else 0) + 1
    print m.length
    @s == other.s
  hash := ->
    print other_keys[K2(@s)] else 0
    0

class K2
  args
    s: String
  equals := (other: K2) -> @s == other.s
  hash := -> 0

seen: Map<String, Int>
other_keys := { K2('a'): 5 }
m: Map<K, Int>
m[K('a')] = 1
print m[K('a')] else -1
print seen['a'] else 0
