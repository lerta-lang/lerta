# A key's `equals` that `==` of two maps calls as it looks up a key of the left map in the right,
# and that removes a key of either, ends the program, as the comparison would go on with the entry
# freed.
class K
  args
    s: String
  equals := (other: K) ->
    b.remove other
    @s == other.s
  hash := -> 0

a := { K('k'): 1 }
b := { K('k'): 1 }
print a == b
