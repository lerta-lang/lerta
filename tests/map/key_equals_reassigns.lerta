# A key's `equals` may assign another map to the variable of the map that it is compared in, which
# the lookup holds until it is done.
class K
  args
    s: String
  equals := (other: K) ->
    m = Map()
    @s == other.s
  hash := -> 0

var m: Map<K, Int>
m[K('stored')] = 1
print m[K('stored')] else -1
