struct Point
  x: Int
class Box
  value: String

const boxes: Map<String, Box> = Map()
const b = Box(value: 'a')
boxes['one'] = b
boxes['one'] = b
boxes['two'] = Box(value: 'b')
const key = 'tw' + 'o'
print boxes.has(key)
boxes[key] = Box(value: 'c')
print boxes['two']!.value
boxes.remove('one')
print b.value
boxes.remove('t' + 'wo')
print boxes.length
boxes['three'] = Box(value: 'd')

const nested: Map<Int, Map<String, Point>> = Map()
nested[1] = { 'p': Point(x: 7) }
nested[1]!['q'] = Point(x: 8)
print nested[1]!['q']!.x
const grid = [{ 1: 'a' }, { 2: 'b' }]
print grid[1][2] ? '?'

const spread: Map<Int, Int> = Map()
spread[i * 1048576] = i for i in 0...2000
spread.remove(i * 1048576) for i in 0...1990
print spread.length
print spread.keys().to_array().length
print spread[1995 * 1048576] ? -1
print spread.keys().to_array()[0] == 1990 * 1048576
