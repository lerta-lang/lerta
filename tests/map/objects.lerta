struct Point
  x: Int
class Box
  value: String

boxes: Map<String, Box>
b := Box('a')
boxes['one'] = b
boxes['one'] = b
boxes['two'] = Box('b')
key := 'tw' + 'o'
print key in boxes
boxes[key] = Box('c')
print boxes['two']!.value
boxes.remove 'one'
print b.value
boxes.remove 't' + 'wo'
print boxes.length
boxes['three'] = Box('d')

nested: Map<Int, Map<String, Point>>
nested[1] = { 'p': { x: 7 } }
nested[1]!['q'] = { x: 8 }
print nested[1]!['q']!.x
grid := [{ 1: 'a' }, { 2: 'b' }]
print grid[1][2] ? '?'

spread: Map<Int, Int>
spread[i * 1048576] = i for i in 0..2000
spread.remove i * 1048576 for i in 0..1990
print spread.length
print spread.keys().to_array().length
print spread[1995 * 1048576] ? -1
print spread.keys().to_array()[0] == 1990 * 1048576
