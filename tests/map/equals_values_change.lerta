# A value's `equals` that `==` of two maps calls, and that removes a key of one of them, ends the
# program, as the comparison would go on with the entry freed.
class V
  args
    n: Int
  equals := (other: V) ->
    a.remove 'k'
    @n == other.n

a := { 'k': V(1) }
b := { 'k': V(1) }
print a == b
