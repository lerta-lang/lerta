# Map() and Set() hold heap keys and values, made as they read them, and release the ones they
# replace or drop, also when the Iter throws after some entries.
class Box
  label: String

entries := (count: Int) -> yield ("key #{i % 2}", Box("box #{i}")) for i in 0..count

boxes := Map(entries(3))
print "#{key}: #{box.label}" for (key, box) in boxes.entries()
names := Set(("name #{i % 2}" for i in 0..4))
print [name for name in names]

failing := ->
  yield ('a', Box('a'))
  yield ('b', Box('b'))
  throw ValueError(message: 'no more')

try
  print Map(failing()).length
catch error: ValueError
  print error.message

nested := Map([(name, Set([name, name + '!'])) for name in ['x', 'y']])
print [item for item in nested['y']!]
print Set((Map([(i, i)]).length for i in 0..3)).length
