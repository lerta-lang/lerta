# Without an expected type, a map literal's key type and value type come each from an anchor, as an
# array's element type does: a key or a value that decides its own type, else one that holds a float
# literal, else the first.
ratios := { 'a': 1, 'b': 2.5 }
print [ratios['a']!, ratios['b']!]
small: Int8 = 3
by_small := { 1: 'one', (small): 'three' }
print [by_small[1]!, by_small[small]!]
mixed := { 1: 2.5, (small): 3 }
print [mixed[1]!, mixed[small]!]

# An expected type still decides both.
counts: Map<Int, Float> = { 1: 1, 2: 2 }
print [counts[1]!, counts[2]!]

# A throw gives no value, so the anchor is another value.
failing := -> { 'a': throw ValueError('never made'), 'b': 2.5 }
_typed: () -> Map<String, Float> = failing  # fmt: skip

# A float literal key is an anchor as a float literal value is.
by_float := { 1: 'one', 2.5: 'two and a half' }
print [by_float[1.0]!, by_float[2.5]!]
