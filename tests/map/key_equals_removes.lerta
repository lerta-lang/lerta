# A key's `equals` that removes a key of the map that it is compared in ends the program, as the
# map's search would go on with the entry freed.
class K
  args
    s: String
  equals := (other: K) ->
    m.remove other
    @s == other.s
  hash := -> 0

m: Map<K, Int>
m[K('stored')] = 1
print m[K('stored')] else -1
