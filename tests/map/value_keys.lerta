enum Color
  RED
  BLUE

struct Pixel
  on: Bool
  level: Byte
  data: Binary
  color: Color

struct Circle
  r: Int

struct Square
  r: Int

class Label
  text: String

type Shape = Circle | Square
type Mark = Label | Circle

pixels: Map<Pixel, Int>
pixels[{ on: true, level: 3, data: 'ab'.binary, color: RED }] = 1
print pixels[{ on: true, level: 3, data: 'ab'.binary, color: RED }] ? 0
print pixels[{ on: true, level: 3, data: 'ab'.binary, color: BLUE }] ? 0

shapes: Map<Shape, String>
shapes[Circle(1)] = 'circle'
shapes[Square(1)] = 'square'
print shapes.length
print shapes[Circle(1)] ? '-'

label := Label('a')
marks: Map<Mark, Int>
marks[label] = 1
marks[Circle(2)] = 2
print marks[label] ? 0
print marks[Label('a')] ? 0
print marks[Circle(2)] ? 0

flags := { true: 1 }
bytes: Map<Binary, Int>
bytes['x'.binary] = 2
print flags[true] ? 0
print bytes['x'.binary] ? 0

print [1, 2] != [1, 3]
print [Circle(1), Circle(2)].contains(Circle(2))

struct Node
  next: Node[]
node := Node([])
node.next.push node
print node == node
# The node holds itself; letting go of it ends the cycle.
node.next.pop()
