enum Color
  RED
  BLUE

struct Pixel
  on: Bool
  level: Byte
  data: Binary
  color: Color

struct Circle
  r: Int

struct Square
  r: Int

class Label
  text: String

type Shape = Circle | Square
type Mark = Label | Circle

const pixels: Map<Pixel, Int> = Map()
pixels[Pixel(on: true, level: 3, data: 'ab'.binary, color: RED)] = 1
print pixels[Pixel(on: true, level: 3, data: 'ab'.binary, color: RED)] ? 0
print pixels[Pixel(on: true, level: 3, data: 'ab'.binary, color: BLUE)] ? 0

const shapes: Map<Shape, String> = Map()
shapes[Circle(r: 1)] = 'circle'
shapes[Square(r: 1)] = 'square'
print shapes.length
print shapes[Circle(r: 1)] ? '-'

const label = Label(text: 'a')
const marks: Map<Mark, Int> = Map()
marks[label] = 1
marks[Circle(r: 2)] = 2
print marks[label] ? 0
print marks[Label(text: 'a')] ? 0
print marks[Circle(r: 2)] ? 0

const flags: Map<Bool, Int> = { true: 1 }
const bytes: Map<Binary, Int> = Map()
bytes['x'.binary] = 2
print flags[true] ? 0
print bytes['x'.binary] ? 0

print [1, 2] != [1, 3]
print [Circle(r: 1), Circle(r: 2)].contains(Circle(r: 2))

struct Node
  next: Array<Node>
const node = Node(next: [])
node.next.push node
print node == node
# The node holds itself; letting go of it ends the cycle.
node.next.pop()
