# One statement of an `if` without `else`, an `unless`, a `while`, an `until` or a `for` takes the
# postfix form if it fits on its line, and the block form otherwise; a postfix form follows no other.
xs := [1, 2]
var n = 0
print n if n > 0
print 'none' unless n > 0
n += 1 while n < 3
n += 1 until n > 5
print x for x in xs
print i for x at i in xs
print n if n > 0
if n > 1000
  print 'a statement in its postfix form that does not fit on its line, as it is long, too'
if n > 1000
  print 'a statement whose postfix form would not fit on its line, as it is long, so long!!'
print 'a statement whose postfix form fits on its line exactly, to its hundredth column' if n > 1000
if n > 0
  m := n
if n > 0
  xs.each (x) -> print(x)
if n > 0
  print n
else
  print 0
if n > 0
  print n
else if n < 0
  print -n
if n > 0
  # a comment
  print n
while n < 10
  n += 1 for x in xs
for x in xs
  print x if x > 1
f := -> print(n) if n > 0
g := (h: () -> void, k: Int) -> h()
g(
  ->
    print 1 if n > 0
  2
)
if n > 0
  print n  # a comment after the statement
if n > 1
  print n
else if n > 0
  print 1
while n < 3
  xs.each (x) -> print(x)
unless n
  print 'an unless that is too long for its line, so that it goes in a block, as it is long!!'
until n > 'an until whose condition is too long for its line, so that it goes in a block, too'
  n += 1
print n if n > 0 and n < 3
print [x, x] for x in xs
if n > 0
  print 1 if n > 1
if n > 0
  print 3  # a comment after a postfix form long enough not to fit on its line, by far, far away
case n
  when 1
    print n if n > 0
  when 2
    n += 1 while n < 3
  else print(2)
if n > 0
  print 1
else
  n += 1 while n < 3
if n > 0
  print 1
else
  unless n < 0
    print 0
h := (k: Int) ->
  return if k > 0
  print k
break while n < 3
for x at i in xs
  print i if i > 0
if n > 0
  print n

  # a comment after a blank line
for x in xs
  print x if x > 0 and x < 3
if n > 0
  print
    g(
      1  # a comment
      2
    )
if n > 0
  print '''
    text
    '''
if n > 0
  pass
if n > 0  # a comment after the head
  print n
print n if f(-> 1) > 0
if n > 0
  f -> 1
