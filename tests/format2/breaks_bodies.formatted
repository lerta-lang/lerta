xs := [1, 2, 3]
positive := xs.all((x) -> x > 0)
ys := xs.map((x) ->
  y := x * 2
  y + 1
).to_array()
total := [1].map((x) ->
  x + 1000000000000000000 + 1000000000000000000 + 100000000000000000 + 99 + 2 + 3
).to_array()
declared := ->
  _x := 1
f := -> print('one statement')
g := ->
  print 'a call without parentheses'
h := (x) -> x + 1000000000000000000 + 1000000000000000000 + 100000000000000000 + 99 + 2 + 3 + 4 + 5
commented := ->
  1  # a comment
trailing := ->
  2
  # a comment in the block
