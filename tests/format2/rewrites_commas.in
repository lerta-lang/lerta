# Items on one line take commas, and so do those on lines of their own that share them; those that
# do not share them take none, a comment among them staying where it is, and their call keeping
# its parentheses.
short := [
  1
  2
]
mixed := f(
  first, second
  third
)
names := ['a name long enough', 'another name long enough', 'a third name long enough', 'a fourth']
shared := f(
  first_value_of_them
  second_value_of_them
  third_value_of_them
  fourth_value_of_them
  fifth_value_of_them
)
commented := f(1,  # one
  2)
print(1, # c
    2)
