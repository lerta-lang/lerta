# Negated is tests, Negated in tests and Negated conditions; `not` of an `and` or an `or` is reported
# but kept.
f := (x: Int?, a: Int | String, xs: Int[], b: Bool) ->
  print not (a is Int), not(x in xs), not x in xs, not (a is not Int)
  return 0 if not x
  return 1 if not (x != 2)
  return 2 unless x == nil
  return 3 if not not (x > 9)
  return 4 unless a is not Int
  return 5 if x not in xs
  if not (a is Int)
    print 'is'
  else
    print 'not'
  if b
    pass
  else if not (x == 1)
    print 'else if'
  var n = 0
  n += 1 while not (n > 3)
  return 6 if not (b and x == 1)
  return 7 unless b or x == 1
  n
