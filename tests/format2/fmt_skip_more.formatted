# A comment that the formatter cannot place is not reported in a kept statement, but is elsewhere.
x := 1
# fmt: skip
y := -  # c
  x
z := -  # c
  x
if x > 0  # fmt: skip
  w := -  # c
    x
  print( w )

# A block statement before a marked one, exported or after an `else`.
if x > 0
  print(1)
export e := [ 1 ]  # fmt: skip
if x > 0
  print(2)
else
  print(3)
f := [ 1 ]  # fmt: skip

# The comment that ends a kept statement, or an unhandled one, keeps its place.
g := [ 1 ] # fmt: skip
h := [ 1 ]   # fmt: skip
import stdout from 'std:io'   # unhandled
print(y + z + e[0] + f[0] + g[0] + h[0])
