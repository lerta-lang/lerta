# Types go on one line, with a space around `|` and `->` and after a comma, and spaces inside
# the braces of a record type; the parentheses that group a type stay.
struct P
  x: Int
a: Int|String = 1
b: (Int)->Int = (n) -> n
c: (Int ,String) = (1, 'a')
d: {x:Int,  y: Int} = { x: 1, y: 2 }
e: ((Int) -> Int)? = nil
f: (Int | String)[] = [1]
g := (r: {a: Int}) -> r.a
h: (P | Int)? = nil
k: () -> Int = -> 1
m: (Int ,String)? = nil
n: {a:Int}? = nil
o: {x:Int}[] = [{ x: 1 }]
p: (((Int) -> Int))[] = []
q := (f: ((Int) -> Int) -> Int) -> f((x) -> x)
r: () -> (Int,Int) = -> (1, 2)
s: (Int, (String|Int)?) = (1, nil)
t := (r: {
  a: Int
}) -> r.a
u := (r: {
  a: Int,
  b: Int
}) -> r.a + r.b
x: Map< Int , Int >? = nil
y: Map<Int,(Int,String)>? = nil
print [a.to_string(), b(1).to_string(), c[0].to_string(), d.x.to_string(), (e == nil).to_string(), f.length.to_string(), g({ a: 1 }).to_string(), (h == nil).to_string(), k().to_string()]
