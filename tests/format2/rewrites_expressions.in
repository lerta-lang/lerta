# Parentheses that change nothing, Ranges, but not those that index, Cast fallbacks, Else nil,
# Shorthand and Functions without parameters.
struct A
  x: Int

f := (v: A | Int, xs: Int[], n: Int, flag: Bool) ->
  print (n + 1) * 2, (n * 2) + 1, ((n)), not (n == 1), -(1), (n > 0 and flag) or flag
  print flag then (flag then 1 else 2) else 3, (await later()) ? 0, 0..(n - 1)
  print xs[0..n], xs[1..xs.length], xs[0..xs.length], xs[0..(n + 1)], [i for i in 1..(n + 1)]
  print n in 0..(n + 1)
  a := (v as A?) ? A(x: 1)
  print a.x, (v as A ? A(x: 2)).x
  print flag then 1 else nil, flag then 1 else (nil), flag then nil else 2
  print { n: n, flag }, { n: n + 1 }
  g := () -> n
  h := weak () -> n
  print g(), h(), (): Int -> n

later := -> 1
