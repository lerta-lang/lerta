# An arm whose body is one statement that fits on its line takes `then` and goes there; one that does
# not takes no `then` before its block, unless its patterns are on lines of their own.
kind := (word: String) ->
  case word
    when 'x' then 'one'
    when 'y'
      'a value long enough that the arm does not fit on the line of its patterns at all, no'
    when 'z' then 'two'
    when
      'first pattern of the arm', 'second pattern of the arm', 'third pattern of the arm', 'fourth'
    then 'three'
    when 'w'
      pass
    when 'r'
      print 1, 2
    when 'c'  # a comment after the patterns
      'four'
    when 'd'  # a comment after then
      'five'
    when
      'first pattern of the arm', 'second pattern of the arm', 'third pattern of the arm', 'fifth'
    then
      g := 1
      g
    else 'name'
