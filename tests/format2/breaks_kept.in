# Forms that only a rewrite of their tokens lays out, which format2 leaves as written for now.
numbers := [1000000, 2000000, 3000000, 4000000, 5000000, 6000000, 7000000, 8000000, 9000000, 10000000]
kind := (word: String) ->
  case word
    when 'x' then 'a value long enough that the arm does not fit on the line of its patterns at all'
    else 'name'
