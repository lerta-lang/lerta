# `try`, each `catch` and `finally` start lines at one depth, their blocks below them, and one that
# gives a value goes on the line below what takes it, one level deeper.
class Oops
  message: String

risky := (n: Int) ->
  throw Oops(message: 'no') if n > 1
  n

try
  print risky(1)
catch e: Oops
  print e.message
catch other
  print 'other'  # a comment
finally
  print 'done'

value :=
  try
    risky 2
  catch _
    0
print value

# a comment before
try
  risky 0
finally
  print 'end'

g := ->
  try
    risky 3
  catch _: Oops | Error
    1

h := (n: Int) ->
  return
    try
      risky n
    # between
    catch _
      2
    finally  # after finally
      print 'h'

if true
  only :=
    try
      risky 0
    finally
      print 'f'
  try
    risky 1
  catch _
    print 'deep'

print [
  try
    risky 0
  catch _
    1
]

# A block that ends with a statement skipped leaves the clauses after it laid out.
try
  print 1
  id := <T>(v: T) ->
    v
catch _
  print 2
  id2 := <T>(v: T) ->
    v

finally
  print 3

print(
  try
    risky 0
  catch _
    1
)
u :=
  a: try
    risky 0
  catch _
    1
print u.a
w := 1 + try
  risky 0
catch _
  1
print w
