# A call at the start of a statement takes its arguments without parentheses, in a block below the
# callee where they do not fit on its line; one on the line of `->` or `then` takes them in
# parentheses, and so does a value that fits on its line or on the next.
xs := [1, 2]
print xs
print xs.length, 'two'
point.move 1, 2
print -count
print -count
print(  # a comment
  1
)
print f(1), 2
fs[0](1)
print
  'the first argument'
  'the second argument of a call that does not fit on the line it is on, no'
print 1, 2
print 'the first argument of a call whose last argument is a literal that opens after it', [
  1, 2, 3, 4
]
g := -> print('x')
h := ->
  print 'a call that fits on its own line, but not on the line of the arrow before it, by one'
k := ->
  print 'a call on the line of the arrow that does not fit there, so it goes in a block below'
v := f(1, 2)
w := f(1, 2)
next :=
  f('the first argument', 'the second argument of a value that fits on the next line, not its')
long := f
  'the first argument'
  'the second argument of a value that fits neither on its line nor on the next'
mapped := xs.map((x) ->
  y := x + 1
  y
)
case xs.length
  when 1 then print('one')
  else print('other')
case xs.length
  when 2 then print(1, 2)
near := ->
  print 'a call that fits on the arrow line until its parentheses count there, by just one'
x := 1
print x
blocked := f
  'the first argument of a value whose arguments fit neither on its line nor on the next'
  'the second'
if x > 0
  print x
else
  print -x
xs.each (x) -> print('a call whose last argument is a function, whose body goes below it', x)
print 'the first argument of a long call', 'the second argument, which a comment follows'  # c
mixed := ->
  print
    f(1)
    'the second argument of a call that does not fit on its line, with a call before it here'
