# Nested parentheses that change nothing go at once, all but the innermost where one is needed, and
# those around a function literal go where they change nothing.
a := 1
print ((((((((((((a))))))))))))
print ((((a + 1)))) * 2
print ((-> 1))()
g := (() -> 1)
class C
  h := -> (weak () -> 1)
print g(), C().h()()
