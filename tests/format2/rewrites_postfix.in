# One statement of an `if` without `else`, an `unless`, a `while`, an `until` or a `for` takes the
# postfix form if it fits on its line, and the block form otherwise; a postfix form follows no other.
xs := [1, 2]
var n = 0
if n > 0
  print n
unless n > 0
  print 'none'
while n < 3
  n += 1
until n > 5
  n += 1
for x in xs
  print x
for x, i in xs
  print i
print  n  if  n > 0
print 'a statement in its postfix form that does not fit on its line, as it is long, too' if n > 1000
if n > 1000
  print 'a statement whose postfix form would not fit on its line, as it is long, so long!!'
if n > 1000
  print 'a statement whose postfix form fits on its line exactly, to its hundredth column'
if n > 0
  m := n
if n > 0
  xs.each (x) -> print x
if n > 0
  print n
else
  print 0
if n > 0
  print n
else
  if n < 0
    print -n
if n > 0
  # a comment
  print n
n += 1 for x in xs while n < 10
print x for x in xs when x > 1
f := -> print n if n > 0
g := (h: () -> void, k: Int) -> h()
g(->
  if n > 0
    print 1
, 2)
