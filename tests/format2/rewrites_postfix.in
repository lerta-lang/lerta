  print n  # a comment after the statement
if n > 1
  print n
else if n > 0
  print 1
while n < 3
  xs.each (x) -> print x
print 'an unless that is too long for its line, so that it goes in a block, as it is long!!' unless n
n += 1 until n > 'an until whose condition is too long for its line, so that it goes in a block, too'
print n if n > 0 and
  n < 3
for x in xs
  print [
    x, x
  ]
if n > 0
  if n > 1
    print 1
print 3 if n > 0  # a comment after a postfix form long enough not to fit on its line, by far, far away
case n
  when 1
    if n > 0
      print n
  when 2
    while n < 3
      n += 1
  else
    print 2
if n > 0
  print 1
else
  while n < 3
    n += 1
if n > 0
  print 1
else
  unless n < 0
    print 0
h := (k: Int) ->
  if k > 0
    return
  print k
while n < 3
  break
print i for x, i in xs when i > 0
if n > 0
  print n

  # a comment after a blank line
