# A cast that throws, of a value of the type it casts to already, as narrowing makes it, is left
# out; the casts that narrow are kept, as are those in a generic function.
struct Point
  x: Int

struct Circle
  radius: Int

type Shape = Point | Circle

class Holder
  shape: Shape = Point(x: 1)

size := (shape: Shape) ->
  return shape.x if shape is Point
  shape.radius

forced := (shape: Shape) -> (shape as Point!).x
maybe := (shape: Shape) -> (shape as Point?)?.x ? 0
twice := (shape: Shape) ->
  if shape is Circle
    print 'circle'
    return shape.radius
  0
field := (holder: Holder) -> holder.shape is Point then holder.shape.x else 0
generic := <T>(shape: Shape, other: T) -> shape is Point then (shape as Point!).x else 0
listed := (shapes: Shape[]) -> [shape.x for shape in shapes when shape is Point]
chosen := (shape: Shape) -> shape is Point then shape else Point(x: 0)
bound := (shape: Shape) ->
  return 0 unless shape is Point
  point := shape
  later := -> shape.x
  point.x + later()
optional := (shape: Shape): Point? ->
  return nil unless shape is Point
  shape
take := (point: Point) -> point.x
passed := (shape: Shape) ->
  return 0 unless shape is Point
  print take(shape)
  take shape
reassigned := (shape: Shape) ->
  var current = shape
  if current is Point
    current = Circle(radius: 2)
    return (current as Circle!).radius
  0
shown := (shape: Shape) -> shape is Point then "#{(shape as Point!).x}" else ''
negated := (shape: Shape) -> shape is Point then -shape.x else 0
nested := (shape: Shape) -> shape is Point then Point(x: shape.x + 1).x else 0
inferred := (shape: Shape) ->
  return 0 unless shape is Point
  points := [shape]
  var point = shape
  point = Point(x: point.x + 1)
  points[0].x + point.x
class Box<T>
  value: T
boxed := (box: Box<Int> | Int) -> box is Box<Int> then box.value else 0
listed_points := (points: Point[] | Int) -> points is Point[] then points.length else 0
skipped := (shape: Shape) -> shape is Point then (shape as Point!).x else 0  # fmt: skip
print size(Point(x: 2)) + size(Circle(radius: 3)) + forced(Point(x: 4)) + maybe(Circle(radius: 5))
print twice(Circle(radius: 6)) + field(Holder()) + generic(Point(x: 7), 1)
print listed([Point(x: 8)])[0]
print chosen(Point(x: 9)).x + bound(Point(x: 10)) + (optional(Circle(radius: 1))?.x ? 11)
print passed(Point(x: 12)) + reassigned(Point(x: 1))
print inferred(Point(x: 1)) + boxed(Box(value: 1)) + listed_points([Point(x: 1)])
print skipped(Point(x: 1))
print shown(Point(x: 1)) + negated(Point(x: 2)).to_string() + nested(Point(x: 3)).to_string()
