# `weak` before a local, `<<=` and `>>=`, a type through a module alias, and a function type in the
# parentheses that group it as a result type each take the spaces of their kind.
import 'std:json' as json

class Box
  value: Int

box := Box(value: 1)
weak held := box
weak var later: Box?
print held.value, later == nil
c := 1
c <<= 7
c >>= 2
print c
keys: json.JsonKeys = json.JsonKeys.AS_WRITTEN
same := <T: json.Encodable>(x: T) -> x
print keys, same(1)
make_counter := (): (() -> Int) ->
  var n = 0
  -> n
make_adder := (n: Int): ((Int) -> Int) -> (x) -> x + n
print make_counter()(), make_adder(1)(2)
h: ((Int) -> Int) -> Int = (g) -> g(3)
k: ((Int) -> Int, Int) -> Int = (g, n) -> g(n)
twice := (): ((() -> Int)) -> -> 1
c >>= 1
print h((x) -> x), k((x) -> x, 1), twice()(), c
pair := (x: Int): (Int, Int?) -> (x, nil)
print pair(1)
export weak shared := box
spaced: json.JsonKeys = json.JsonKeys.AS_WRITTEN
maybe := (): ((Int) -> Int)? -> nil
mixed := (): (Int, (Int) -> Int) -> (1, (x) -> x)
weak quick := weak -> 1
print spaced, maybe(), mixed(), quick()
