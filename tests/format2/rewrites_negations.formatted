# Negated is tests, Negated in tests and Negated conditions; `not` of an `and` or an `or` is reported
# but kept.
f := (x: Int?, a: Int | String, xs: Int[], b: Bool) ->
  print a is not Int, x not in xs, x not in xs, not (a is not Int)
  return 0 unless x
  return 1 if x == 2
  return 2 if x != nil
  return 3 if x > 9
  return 4 if a is Int
  return 5 unless x in xs
  if a is not Int
    print 'is'
  else
    print 'not'
  if b
    pass
  else if not x == 1
    print 'else if'
  var n = 0
  n += 1 until n > 3
  return 6 if not (b and x == 1)
  return 7 unless b or x == 1
  n
print not 1 not in [1]
