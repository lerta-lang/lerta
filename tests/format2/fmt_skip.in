# The statement whose line `# fmt: skip` ends, or the next one, keeps its gaps as written.
identity := [  # fmt: skip
  1, 0,   0
  0, 1,   0
]
# fmt: skip

pair := [ 1,2 ]
other := [ 1,2 ]
export exported := [ 1,2 ]   # fmt: skip
x := [ 1 ]; y := [ 2 ]  # fmt: skip

# The innermost statement on lines of its own that holds the line, indented as its block is, with
# its lines after the first as much deeper as they were.
if identity != []
    print( identity )  # fmt: skip
    print( pair )
    for z in pair
        print(   # fmt: skip
            z
        )
if other != [ ]  # fmt: skip
  print( other )
f := (a: Int) ->
  a  +  1  # fmt: skip
print( f(x[0] + y[0]) )
