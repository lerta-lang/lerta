size := (n: Int) ->
  label :=
    case n
      when 1 then 'one'
      when 2
        'two'
      else 'many'
  label
kind := (word: String) ->
  case word
    when 'a', 'b' then 'short'
    when
      'const', 'var', 'if', 'else', 'while', 'for', 'break', 'continue', 'return', 'case', 'throw',
      'try'
    then 'keyword'
    else
      'a value long enough that the arm does not fit on the line of its else at all, not at all, no'
sign := (n: Int) ->
  case
    when n < 0 then 'negative'
    else 'other'
if a
  print 1
else if b
  print 2
else
  print 3
if a
  print 1
else
  # before the if
  if b
    print 2
print case 'a'
  when 'a' then 1
  else 2
