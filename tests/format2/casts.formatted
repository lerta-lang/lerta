# A cast takes one space on each side of `as`, its `!` none, and the `?` of its fallback one on each
# side; `?.` takes no space, and the type parameters of a function literal none before `(`.
class Box
  value: Int
  next: Box?

values: (Int | String)[] = [1, 'a']
for value in values
  print value as Int?
  print value as Int ? 0
  print value as String?
n: Int | String = 2
print n as Int!

box := Box(value: 1, next: Box(value: 2))
print box.next?.value
print box.next?.next?.value ? 0
box.next?.value

identity := <T>(v: T) -> v
pick := <A, B: Box>(a: A, b: B) -> b.value
print identity(1), pick(1, box)

class Node
  value: Int
  f := (n: Int) -> Box(value: n)
xs: Int[] | String = [1]
print xs as Int[]?, xs as Int[] ? [], xs as Int[]!
b: Box | Int = box
print b as Box?, (b as Box?)?.value, (b as Box!).value
print n as Int ? 0
node: Node? = Node(value: 1)
print node?.f(1).next?.value
long := node?.f(
  1
).next?.next?.next?.next?.next?.next?.next?.next?.next?.next?.next?.next?.next?.next?.next?.value
twice := <T>(v: T): T -> v
print [1].map(<U>(v: U) -> v)
g := (s: String) -> s
s := g("""
  a
  """) as String?
class Pair<T>
  first: T
c: Pair<Int> | Int = 1
print c as Pair<Int>?

one := <T> -> 1
two := <T> -> 2
u := b as Box ? Box(value: 1)
print box.next?.next!.value
print (b as Box ? Box(value: 1)).value
