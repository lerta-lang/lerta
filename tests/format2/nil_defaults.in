# A field of an optional type leaves out `= default nil`, as its argument may be left out without
# it; but not one whose type an alias or a member of a union makes optional, nor one whose value is
# not a default.
type MaybeInt = Int?

class Node
  value: Int
  parent: Node? = default nil
  var next: Node? = default nil
  weak owner: Node? = default nil
  aliased: MaybeInt = default nil
  either: (Int | String)? = default nil
  member: Int | String? = default nil
  numbers: Int[]? = default nil
  callback: (() -> Int)? = default nil
  counts: Map<String, Int>? = default nil  # kept as a comment
  fixed: Int? = nil
  counted: Int? = default 1
  wrapped: Int? = default (nil)

struct Leaf
  label: String? = default  nil

struct Box<T>
  item: T? = default nil

node := Node(value: 1)
print "#{node.parent == nil} #{node.next == nil} #{node.counted ? 0}"
print "#{Leaf().label ? '-'} #{Box<Int>().item ? 0}"
