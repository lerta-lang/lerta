# A field of an optional type leaves out `= default nil`, as its argument may be left out without
# it; but not one whose type an alias or a member of a union makes optional, nor one whose value is
# not a default.
type MaybeInt = Int?

class Node
  value: Int
  parent: Node?
  var next: Node?
  weak owner: Node?
  aliased: MaybeInt = default nil
  either: (Int | String)?
  member: Int | String? = default nil
  numbers: Int[]?
  callback: (() -> Int)?
  counts: Map<String, Int>?  # kept as a comment
  fixed: Int? = nil
  counted: Int? = default 1
  wrapped: Int?

struct Leaf
  label: String?

struct Box<T>
  item: T?

node := Node(value: 1)
print "#{node.parent == nil} #{node.next == nil} #{node.counted ? 0}"
print "#{Leaf().label ? '-'} #{Box<Int>().item ? 0}"
