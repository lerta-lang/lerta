# The items of an array literal take the type of the item tested, without nil, as the other
# operand of `==` does, when they all take their type from the context and that item does not.
enum TokenKind
  '('
  '['
  'x'

kind: TokenKind = '['
c: Char = 'b'
b: Byte = 'a'
small: Int8 = 3
half := 0.5
var maybe: TokenKind? = 'x'
print [kind in ['(', '['], kind not in ['(', '[']]
print [c in ['a', 'b'], b in ['a', 'b'], b not in [], small in [[small]..., 1], half in [1, 2]]
print [maybe! in ['x'], 3 in [small], '(' in [kind, '('], [] in [[1]]]

is_open := (k: TokenKind) -> k in ['(', '[']
print [is_open('('), is_open('x')]
