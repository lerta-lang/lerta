# A container that throws after the item is evaluated releases the item; contains may throw.
class Picky
  contains = (text: String): Bool -> throw ValueError("no #{text}")

failing := (): String[] -> throw ValueError('no container')

try
  print "#{'it'}em" in failing()
catch error: ValueError
  print error.message
try
  print "#{'it'}em" in Picky()
catch error: ValueError
  print error.message

struct Strict
  contains: (Int) -> Bool

try
  print 1 in Strict((n) -> throw ValueError("no #{n}"))
catch error: ValueError
  print error.message
