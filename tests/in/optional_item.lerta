# An optional item is not tested by `in`, as an array holds no nil, with array literals too.
enum Kind
  'a'
  'b'
m: Map<Int, Kind>
kinds: Kind[] = ['a']
print m[1] in kinds
counts: Map<Int, Int>
print [1].contains(counts[1])
names: Map<Int, String>
print names[1] in ['a']
print counts[1] in Set([1])
var maybe: Kind? = 'a'
print maybe in ['a', nil]
w: Int8? = 1
print w in [1]
letter: Char? = 'a'
print letter in 'abc'
print w not in [1]
