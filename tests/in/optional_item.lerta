# An optional item does not widen the item type of the array, which holds no nil.
enum Kind
  'a'
  'b'
m: Map<Int, Kind>
kinds: Kind[] = ['a']
print m[1] in kinds
counts: Map<Int, Int>
print [1].contains(counts[1])
names: Map<Int, String>
print names[1] in ['a']
print counts[1] in Set([1])
var maybe: Kind? = 'a'
print maybe in ['a', nil]
