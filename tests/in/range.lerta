n := 5
print [n in 1..=5, n in 1..5, n in 5..=9, n in 6..=9, n not in 1..5, -n in -5..=0]
byte: Byte = b'q'
print [byte in b'a'..=b'z', byte in b'A'..=b'Z']
char: Char = 'é'
print char in 'a'..='z'
ratio := 0.5
print [ratio in 0.0..=1.0, ratio in 0.0..0.5]
small: Int32 = 3
print [3 in small..=10, small in 0..=3, 0 in 0.0..=1.0, 1.0 in 0..1]
single: Float32 = 0.25
print [single in 0.0..0.25, single in 0..=1]
