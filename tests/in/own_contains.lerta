# A type with contains takes `in`, and a type parameter bound by Contains does.
class Evens
  contains = (n: Int) -> n % 2 == 0

has_any := <T, C: Contains<T>>(items: T[], container: C) -> items.any((item) -> item in container)

print [2 in Evens(), 3 in Evens(), 3 not in Evens()]
print [has_any([1, 3], Evens()), has_any([1, 4], Evens())]
print [has_any(['x', 'b'], 'abc'), has_any([5], [1, 2]), has_any(['k'], { 'k': 0 })]
