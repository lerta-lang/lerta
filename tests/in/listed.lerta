# A test of a list of literals and members of enums makes no array (see test/cli/build.lerta).
enum Color
  RED
  GREEN
  BLUE
listed := (color: Color, c: Char, s: String) ->
  color in [RED, BLUE] or c not in ['a', 'b'] or s in ['x', 'y']
print [
  listed(GREEN, 'a', 'z')
  listed(GREEN, 'z', 'z')
  listed(BLUE, 'a', 'z')
  listed(GREEN, 'a', 'y')
]
