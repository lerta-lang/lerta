# A contains that is a field holding a function, of a struct or a class, takes `in` as a method
# does; so does a value of the interface, and `in` binds as comparisons do.
struct Fixed
  contains: (Int) -> Bool

class Window
  low: Int
  high: Int
  contains := (n: Int) -> n in @low..=@high

counted := (c: Contains<Int>) -> [n for n in 0..5 when n in c]

fixed := Fixed((n) -> n == 1)
var text: String?
print [1 in fixed, 2 in fixed, 2 not in fixed]
print [counted(Window(low: 1, high: 3)), counted([0, 4])]
print ['a' in text ? 'abc', 'a' in text ? '']
print [1 in [1] and 2 in [1], 1 in [1] or 2 in [1], 2 not in [1]]
