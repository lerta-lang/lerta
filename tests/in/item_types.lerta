# The item takes the type of contains' parameter, as an argument does, so that `[]` needs no type;
# a container made where it is tested is released after the test.
struct Fixed
  contains: (Int) -> Bool

lists := [[1]]
print [[] in lists, [1] in lists]
print [1 in Fixed((n) -> n == 1), 1 not in Fixed((n) -> n == 2)]
in := [1, 2]
print [x for x in [0, 1, 2, 3] when x not in in]
