# `x in xs` and `x not in xs` test `xs.contains(x)`: of arrays, sets, maps by their keys, and
# Strings, by their parts or a Char.
c: Char = 'b'
print [2 in [1, 2, 3], 4 in [1, 2, 3], 4 not in [1, 2, 3]]
print [3 in Set([1, 3]), 2 in Set([1, 3]), 'k' in { 'k': 1 }, 'v' in { 'k': 1 }]
print ['ell' in 'hello', '' in 'hello', c in 'abc', c not in 'xyz', 'é' in 'café']
print [c in 'abc', c in 'xyz']
xs := [1, 2]
print [x for x in [0, 1, 2, 3] when x in xs]
print [x for x in [0, 1, 2, 3] when x not in xs]
