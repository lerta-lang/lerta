# A test of a list of literals, members of enums or constants, which makes no array, gives what a
# test of an array does: of an enum, a Char, a Byte, an Int, a Bool and a String, of a String made
# then, and with `not in`; and so does one whose items run code, which makes one.
enum Color
  RED
  GREEN
  BLUE
LIMIT := 7
pick := (n: Int) -> n
check := (color: Color, c: Char, b: Byte, n: Int, flag: Bool, s: String) ->
  print [
    color in [RED, BLUE]
    color in [Color.GREEN]
    c in ['a', 'b', 'c']
    b in [b'x', 0x20]
    n in [1, LIMIT]
    flag in [true]
    color not in [GREEN, BLUE]
    n in [pick(3), 4]
    s in ['a', 'b']
    "#{s}?" in ['a?', 'c?']
    "#{s}!" in ['a!', 'b!', 'c!']
  ]
check GREEN, 'b', 0x20, 7, true, 'b'
check RED, 'z', b'y', 3, false, 'c'
