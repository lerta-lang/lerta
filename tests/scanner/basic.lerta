import scan from 'std:scanner'

s := scan('aé😀 b-cd')
print [s.done(), s.peek() == 'a', s.next() == 'a', s.next() == 'é', s.next() == '😀']
print s.take_while((c) -> c == ' ') == ' '
print [s.take('b-'), s.take('x'), s.peek() == 'c']
taken := s.mark()
s.skip_while (c) -> c != 'd'
print taken()
print s.rest()
print [s.done(), s.next() == nil, s.peek() == nil, s.rest().is_empty()]
# A mark taken earlier still gives all that was passed over since.
print taken()

empty := scan('')
print [empty.done(), empty.peek() == nil, empty.take(''), empty.take_while((c) -> true).is_empty()]
print empty.mark()().is_empty()

# A prefix of several bytes, and one longer than what is left, which leaves the position.
accent := scan('éa')
print [accent.take('éx'), accent.take('é')]
print accent.rest()

# An empty prefix, which every text starts with, leaves the position; a test stops at a code point
# of several bytes, or runs to the end; marks live at once, and one at the end gives ''.
several := scan('ab日本')
whole := several.mark()
print [several.take(''), several.peek() == 'a']
print several.take_while((c) -> c != '日')
after := several.mark()
print several.take_while((c) -> true)
at_end := several.mark()
print [whole(), after(), at_end()]

# A test that fails at once and a prefix that does not match pass over nothing; rest takes all.
fresh := scan('xy')
before := fresh.mark()
print [fresh.take_while((c) -> c == 'y').is_empty(), fresh.take('y'), before().is_empty()]
print fresh.rest()
print fresh.next() == nil
