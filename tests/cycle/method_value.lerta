# A method of @ used as a value captures @, as the literal that calls it would, so storing it where
# @ holds it is warned about. The cycle is broken by hand before the object goes.
class Counter
  on_press: (() -> Int)? = nil
  count = 1
  next = -> @count + 1
  init = -> @on_press = @next
  release = -> @on_press = nil

counter := Counter()
print counter.on_press!()
counter.release()
