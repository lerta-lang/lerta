# More places and values that make the cycle: an array item, a field reached through fields, a
# tuple, an array or a map stored in a field, and a literal whose inner literal captures @; and two
# that make none: a function call's argument, and an array that @ does not hold.
class Inner
  f: (() -> Int)? = nil

class Middle
  inner = Inner()

class Holder
  handlers: Array<() -> Int> = [-> 0]
  middle = Middle()
  pair: (Int, () -> Int)? = nil
  list: Array<() -> Int> = []
  table: Map<String, () -> Int> = Map()
  outer: (() -> () -> Int)? = nil
  plain: Int? = nil
  n = 1
  init = ->
    @handlers[0] = -> @n
    @middle.inner.f = -> @n
    @pair = (1, -> @n)
    @list = [-> @n]
    @table = { 'a': -> @n }
    @outer = -> -> @n
    @plain = apply(-> @n)
    const local: Array<() -> Int> = []
    local.push -> @n
    @handlers = []
    @middle.inner.f = nil
    @pair = nil
    @list = []
    @table = Map()
    @outer = nil

const apply = (f: () -> Int) -> f()

print Holder().plain ? 0
