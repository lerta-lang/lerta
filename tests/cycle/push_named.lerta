# A struct that push is given by its named arguments is kept as one given by a call: a field's
# literal that captures @ makes the cycle where @ holds the array, as one nested in a field does,
# and an anonymous struct's too; a weak literal, one that does not capture @, and an array that @
# does not hold make none.
struct Inner
  g: () -> Int

struct Item
  n: Int
  f: () -> Int

struct Nested
  inner: Inner

struct Hook
  run: () -> void

class Holder
  items: Item[] = []
  nested: Nested[] = []
  hooks: Hook[] = []
  records: { n: Int, f: () -> Int }[] = []
  n = 1
  init = ->
    @items.push n: 1, f: -> @n
    @items.push n: 2, f: -> 2
    @hooks.push run: weak -> print(@n)
    @nested.push inner: { g: -> @n }
    @records.push n: 4, f: -> @n
    local: Item[]
    local.push n: 5, f: -> @n
    @items = []
    @nested = []
    @hooks = []
    @records = []

items: Item[]
items.push n: 6, f: -> 6
print "#{items.length} #{Holder().n}"
