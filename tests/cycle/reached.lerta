# A place reached from @ through `!` makes the cycle too, as a map's array does; a literal given to
# a method of a class is not seen, since the method may not keep it.
class Inner
  var f: (() -> Int)?
  listen := (f: () -> Int) -> f()

class Outer
  var inner: Inner? = Inner()
  var lists: Map<String, (() -> Int)[]> = { 'a': [] }
  n := 1
  init := ->
    @inner!.f = -> @n
    @lists['a']!.push(-> @n)
    print @inner!.listen(-> @n)
    @inner = nil
    @lists = Map()

_outer := Outer()
