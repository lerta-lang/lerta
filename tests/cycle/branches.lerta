# The literal may be a value that `?` or `then`/`else` gives; a place reached through a weak field
# is not held, nor is an array that a method of @ returns.
class Parent
  f: (() -> Int)? = nil
  callbacks: (() -> Int)[] = []

class Child
  weak parent: Parent?
  g: (() -> Int)? = nil
  n = 1
  init = ->
    @g = @g ? (-> @n)  # fmt: skip
    @g = @n > 0 then (-> @n) else (-> 0)  # fmt: skip
    @parent!.f = -> @n
    @parent!.callbacks.push(-> @n)
    @fresh().push(-> @n)
    @g = nil
  fresh = (): (() -> Int)[] -> []

parent := Parent()
_child := Child(parent)
print parent.f!() + parent.callbacks[0]()
