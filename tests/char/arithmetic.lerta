# A Char moves by an Int to another, as hiragana to katakana, and throws where no Char is.
const katakana = (c: Char) -> c >= 'ぁ' and c <= 'ゖ' then c + 0x60 else c
print [katakana(c).to_string() for c in 'ひらがな!'].join('')
const z: Char = 'z'
print [(z - 25).to_string(), (z + 1).to_string()]
const surrogate_edge: Char = "\u{D7FF}"
try
  print (surrogate_edge + 1).to_int()
catch e: ValueError
  print e.message

# Back below 0 or into the surrogates from above; and assigned back to a variable.
const zero: Char = "\u{0}"
const above: Char = "\u{E000}"
const back = (label: String, c: Char) ->
  try
    print "#{label}: #{(c - 1).to_int()}"
  catch e: ValueError
    print "#{label}: #{e.message}"
back 'below zero', zero
back 'into the surrogates', above
var c: Char = 'a'
c += 2
c -= 1
print c.to_string()

# Beyond the last Char, and past what an Int holds.
const last: Char = "\u{10FFFF}"
try
  print (last + 1).to_int()
catch e: ValueError
  print e.message
try
  print (last + 9223372036854775807).to_int()
catch e: ArithmeticError
  print e.message
