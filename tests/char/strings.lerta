# A String gives its code points as Chars, which a string literal of one code point is where one
# is expected, and which a Char gives back as its text.
text := 'aé€😀'
chars: Char[] = [c for c in text]
print [c.to_string() for c in chars]
print chars == ['a', 'é', '€', '😀']
first := text.iter().next()
print [first == 'a', "#{first}" == 'a']
print chars.map((c) -> c.to_string()).to_array().join('') == text

# Of each length of UTF-8 sequence, its first and last code points, there and back.
edges := "\0\x7F\u{80}\u{7FF}\u{800}\u{FFFF}\u{10000}\u{10FFFF}"
print [c.to_int() for c in edges]
print [c.to_string() for c in edges].join('') == edges

# Each ASCII character's text, which is made once, holds that character alone.
print [code for code in 0..0x80 when [c for c in code.to_char()!.to_string()] != [code.to_char()!]]  # fmt: skip

kind := (c: Char) ->
  case c
    when 'é' then 'e acute'
    when "\u{1F600}" then 'grinning face'
    else 'other'
print [kind(c) for c in 'é😀x']

# Where a Char is expected: an optional, an argument and an escape.
accent: Char? = 'é'
print accent!.to_int()
print kind("\u{1F600}")
last: Char = "\u{10FFFF}"
print last.to_int()

# Compared, and as a map key, a string literal stands for a Char.
print [c == '€' for c in 'x€']
names: Map<Char, String> = { 'é': 'e acute' }
print names['é']!
