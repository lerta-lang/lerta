# A Char is a string literal of one code point where one is expected, compares and orders by its
# number, and is a map key, a case pattern, an item and a member of a union.
const a: Char = 'a'
const accent: Char = 'é'
print [a == 'a', a != accent, a < accent, accent <= 'é', '😀' > accent]
print [a.to_int(), accent.to_int(), 0x3042.to_char().to_int()]

const names = Map<Char, String>()
names['é'] = 'e acute'
names['😀'] = 'grinning face'
print [names['é'] ? '-', names['😀'] ? '-', names['x'] ? '-']

const kind = (c: Char) ->
  case c
    when 'a', 'b' then 'early'
    when '😀' then 'face'
    else 'other'
print [kind('a'), kind('😀'), kind('z')]

const chars: Char[] = ['x', 'é', '😀']
print [c.to_int() for c in chars]

const either: Char | Int = accent
print either is Char

# Each edge of the scalar values, from Int and from narrower types.
const byte: Byte = 'a'
print [0.to_char().to_int(), 0xD7FF.to_char().to_int(), 0xE000.to_char().to_int()]
print [0x10FFFF.to_char().to_int(), byte.to_char().to_int()]
