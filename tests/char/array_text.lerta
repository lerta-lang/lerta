# An array of Chars is written with each as the literal that gives it, as a String is: in single
# quotes, or in double quotes with escapes for a quote and a control character; of each length of
# UTF-8 sequence, and nested.
chars: Char[] = ['a', 'é', '€', '😀', "'", "\n", "\0", '"']
print chars
print "#{chars.length} #{[c for c in 'xy']}"
nested: Char[][] = [['a'], []]
print nested
empty: Char[]
print empty
# The first and last Char of each length of UTF-8 sequence, by the bytes of each one's text in the
# array's; U+007F is a control character.
edges: Char[] = ["\x7F", "\u{80}", "\u{7FF}", "\u{800}", "\u{FFFF}", "\u{10000}", "\u{10FFFF}"]
print edges.to_string().binary.length
print [[c].to_string().binary.length - 4 for c in edges]
