# The edges of each class, and characters beyond ASCII, which are in no class but that of spaces,
# as those whose low byte is in one: İ, Ł and Ġ end in 0x30, 0x41 and 0x20.
classes := (c: Char) -> "#{c.is_digit()} #{c.is_letter()} #{c.is_alphanumeric()} #{c.is_space()}"
print "#{c.to_int()}: #{classes(c)}" for c in "/09:@AZ[`az{_ \x08\t\n\x0B\x0C\r\x0E\x1F!"
print classes(c) for c in 'é０アİŁĠ'

# The spaces of Unicode's White_Space beyond ASCII, at the edges of their ranges, and those next to
# them, which are none.
spaces := [0x85, 0xA0, 0x1680, 0x2000, 0x200A, 0x2028, 0x2029, 0x202F, 0x205F, 0x3000]
others := [0x84, 0x86, 0x9F, 0xA1, 0x167F, 0x1681, 0x1FFF, 0x200B, 0x2027, 0x202A, 0x2030, 0x3001]
print [code.to_char()!.is_space() for code in spaces]
print [code.to_char()!.is_space() for code in others]

print [c.is_ascii() for c in "\0a\x7F\u{80}é　"]
