# The edges of each class, and characters beyond ASCII, which are in none, as those whose low
# byte is in one: İ, Ł and Ġ end in 0x30, 0x41 and 0x20.
classes := (c: Char) -> "#{c.is_digit()} #{c.is_letter()} #{c.is_space()}"
print "#{c.to_int()}: #{classes(c)}" for c in "/09:@AZ[`az{_ \t\n\r"
print classes(c) for c in 'é０ア　İŁĠ'
