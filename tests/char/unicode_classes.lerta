# The classes of characters beyond ASCII, by Unicode's tables, at the edges of their ranges and next
# to them, and past the last rows of the tables.
codes := (c: Char) -> c.to_int().to_hex(4)
classes := (code: Int) ->
  c := code.to_char()!
  "#{codes(c)}: #{c.is_letter()} #{c.is_numeric()} #{c.is_lower()} #{c.is_upper()}"

# U+0080, the first past ASCII, is in no class. ª and º are letters of lower case without an upper
# one; « between them is none. The ideographs from U+3400 to U+4DBF are one range of the database,
# which U+4DC0, a symbol, ends.
print classes(code) for code in [0x80, 0xA9, 0xAA, 0xAB, 0xBA, 0x33FF, 0x3400, 0x4DBF, 0x4DC0]

# Numbers that are no digits: Arabic-Indic, Roman, a fraction, and a mathematical digit. Ⅰ, a Roman
# numeral, is of upper case though it is no letter.
print classes(code) for code in [0x663, 0x2160, 0x2170, 0xBD, 0x1D7CE]

# A code point of the private use planes, and the last one.
print classes(code) for code in [0xF0000, 0x10FFFF]

print [c.is_alphanumeric() for c in '٣ア½_—']
