# A string literal of one character on the left of + or - is a String, as nothing expects a Char
# there, and the error tells how to move a Char by an integer, whichever operand is typed first;
# one on the left of a String is appended to, and others get the error of their types alone.
n := 2
m: Int? = 1
print 'a' + 'b'
print 'a' + 1
print 'b' - 1
print 'a' + n
print 'a' - m
print 'a' - 'b'
print 'a' + 1.0
print 'a' - []
print 'é' + 1
c: Char = 'a' + 1
