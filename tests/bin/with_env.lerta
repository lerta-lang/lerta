# Runs a command with environment variables removed and set, as `with_env -u NAME NAME=VALUE
# command args...` does, as env(1) would, and exits with its exit code.
import exit, run from 'std:process'
import argv from 'std:process'

var i = 0
const unset_env: String[]
const env: Map<String, String>
while argv[i] == '-u'
  unset_env.push argv[i + 1]
  i += 2
while const pair = argv[i].split_once('=')
  const (name, value) = pair
  env[name] = value
  i += 1
const command = argv[i]
const args = [argument for argument, j in argv when j > i]
exit (await run(command, args..., env: env, unset_env: unset_env)).code
