# Cancels a read of a line of stdin, then reads the lines, for the tests of `lerta run` in
# test/cli.ts: what the cancelled read would have read is kept for the next.
import stdin from 'std:io'

const reading = stdin.read_line()
reading.cancel()
try
  await reading
catch error: CancelledError
  print error.message
while const line = await stdin.read_line()
  print line
