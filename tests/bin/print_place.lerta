# Prints the variables that the arguments name, or `unset`, or without arguments, the name of the
# current directory.
import argv, env from 'std:process'
import real_path from 'std:io'

print "#{name}=#{env(name) ? 'unset'}" for name in argv
if argv.length == 0
  path := real_path('.').text()!
  print path.split('/').last()!.split('\').last()!
