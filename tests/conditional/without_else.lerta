# Without else, then gives nil where the condition does not hold.
const name: String? = 'ann'
const none: String? = nil
const greeting = name then "hi #{name}"
print greeting ? 'nobody'
print (none then "hi #{none}") ? 'nobody'
print (false then 1) ? 0
const already: Int? = 5
print (true then already) ? 0
const checked: Int? = none then throw ValueError(message: 'never')
print checked ? -1
# Else goes with the nearest then.
print (true then false then 1 else 2) ? 3
