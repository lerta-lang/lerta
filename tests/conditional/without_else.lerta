# Without else, then gives nil where the condition does not hold.
name: String? = 'ann'
none: String? = nil
greeting := name then "hi #{name}"
print greeting else 'nobody'
print (none then "hi #{none}") else 'nobody'
print (false then 1) else 0
already: Int? = 5
print (true then already) else 0
checked: Int? = none then throw ValueError('never')
print checked else -1

# Else goes with the nearest then.
print (true then false then 1 else 2) else 3  # fmt: skip
