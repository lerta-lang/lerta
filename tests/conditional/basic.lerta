sign := (n: Int) -> n < 0 then 'negative' else n == 0 then 'zero' else 'positive'
print sign(-5)
print sign(0)
print sign(7)

describe := (name: String?) -> name then "hello #{name}" else 'nobody'
print describe('ann')
print describe(nil)

length_or_zero := (s: String?) -> not s then 0 else s.binary.length
print length_or_zero('abc')
print length_or_zero(nil)

pick := (flag: Bool) -> flag then 'yes' else nil
print pick(true) ? '-'
print pick(false) ? '-'

checked := (n: Int) -> n >= 0 then n else throw ValueError(message: 'negative')
print checked(3)

var total = 0
total += i % 2 == 0 then i else 0 for i in 0...10
print total
c: Byte = true then 'a' else 'b'
print c
print 1 + 2 > 2 and true then 'and binds tighter' else 'no'
values := [true then 1 else 2, false then 1 else 2]
print values[0] + values[1]
print case 3
  when 3 then false then 'x' else 'y'
  else 'z'
struct P
  n: Int
struct Q
  n: Int
show := (v: P | Q) -> v is P then "P #{v.n}" else 'Q'
print show(P(n: 4))
print show(Q(n: 4))
size := (s: String?) -> s == nil then 0 else s.binary.length
print size('four')
print (true then false else true) then 'nested' else 'flat'
maybe: Int? = nil
maybe_flag: Bool? = nil
print maybe_flag ? true then 'a' else 'b'
p := true then P(n: 9) else nil
print p!.n
fail := (flag: Bool): Int -> flag then throw ValueError(message: 'a') else throw ValueError(message: 'b')  # fmt: skip
print case
  when maybe then maybe + 1
  else 0
