const sign = (n: Int): String -> n < 0 then 'negative' else n == 0 then 'zero' else 'positive'
print sign(-5)
print sign(0)
print sign(7)

const describe = (name: String?): String -> name then "hello #{name}" else 'nobody'
print describe('ann')
print describe(nil)

const length_or_zero = (s: String?): Int -> not s then 0 else s.binary.length
print length_or_zero('abc')
print length_or_zero(nil)

const pick = (flag: Bool): String? -> flag then 'yes' else nil
print pick(true) ? '-'
print pick(false) ? '-'

const checked = (n: Int): Int -> n >= 0 then n else throw 'negative'
print checked(3)

var total = 0
total += i % 2 == 0 then i else 0 for i in 0...10
print total
const c: Byte = true then 'a' else 'b'
print c
print 1 + 2 > 2 and true then 'and binds tighter' else 'no'
const values = [true then 1 else 2, false then 1 else 2]
print values[0] + values[1]
print case 3
  when 3 then false then 'x' else 'y'
  else 'z'
struct P
  n: Int
struct Q
  n: Int
const show = (v: P | Q): String -> v is P then "P #{v.n}" else 'Q'
print show(P(n: 4))
print show(Q(n: 4))
const size = (s: String?): Int -> s == nil then 0 else s.binary.length
print size('four')
print (true then false else true) then 'nested' else 'flat'
const maybe: Int? = nil
const maybe_flag: Bool? = nil
print maybe_flag ? true then 'a' else 'b'
const p: P? = true then P(n: 9) else nil
print p!.n
const fail = (flag: Bool): Int -> flag then throw 'a' else throw 'b'
print case
  when maybe then maybe + 1
  else 0
