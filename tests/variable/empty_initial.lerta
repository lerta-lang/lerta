names: String[]
counts: Map<String, Int>
seen: Set<Int>
by_items: Map<Int[], String>
names.push 'a'
counts['a'] = 1
seen.add 1
by_items[[1]] = 'one'
print "#{names} #{counts['a'] ? 0} #{seen.contains(1)} #{by_items[[1]] ? '-'}"

# A const in a loop starts empty in each round.
for i in 0..2
  round: Int[]
  round.push i
  print round

# In a generic function, the type of each instance.
first_of := <T>(x: T) ->
  items: T[]
  indexes: Map<T, Int>
  items.push x
  indexes[x] = 0
  "#{items.length} #{indexes.length}"
print first_of(1)
print first_of('a')

# A local that takes the name of Map or Set does not hide the builtin, as it does not hide the type.
shadowed := (Map: () -> Int, Set: () -> Int) ->
  counts: Map<String, Int>
  seen: Set<Int>
  counts['a'] = Map()
  seen.add Set()
  "#{counts['a'] ? 0} #{seen.contains(2)}"
print shadowed(-> 1, -> 2)
