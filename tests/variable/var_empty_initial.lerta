# A var whose type is written as an array, a map or a set, without a value, starts empty, a new one
# each time, as a const does, also in a loop and in a generic function, and can be assigned again;
# one of an optional type, of an array too, starts at nil.
var names: String[]
names.push 'a'
var seen: Set<String>
seen.add 'b'
var counts: Map<String, Int>
counts['c'] = 1
var maybe: Int?
print "#{names} #{seen} #{counts} #{maybe == nil}"
f := ->
  var local: Int[]
  local.push 1
  local
print f()
print f()
for i in 0..2
  var round: Int[]
  round.push i
  print round
indexed := <T>(items: T[]) ->
  var places: Map<T, Int>
  places[item] = i for item at i in items
  places
print indexed(['x', 'y'])
var replaced: Map<String, Int>
replaced = { 'r': 1 }
print replaced
var none: Int[]?
print none == nil
var groups: Map<String, Int[]>
groups['g'] = [1]
print groups
