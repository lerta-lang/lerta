class Node
  name: String

var found: String?
print found == nil
found = 'a'
print found ? '-'

first_long := (names: String[]) ->
  var long: String?
  for name in names
    long = name if long == nil and name.binary.length > 1
  long

print first_long(['a', 'bc', 'de']) ? '-'
print first_long([]) ? '-'

var node: Node?
var nodes: Node[]?
var pair: (Int, Int)?
var callback: ((Int) -> Int)?
node = Node('n')
print "#{node?.name ? '-'} #{nodes == nil} #{pair == nil} #{callback == nil}"

# A var in a loop starts at nil in each round.
for i in 0..2
  var seen: Int?
  print seen == nil
  seen = i

# A weak local without a value.
hold := ->
  weak var held: Node?
  held = node
  held?.name ? '-'
print hold()

# An alias of an optional type is optional too.
type MaybeInt = Int?
var aliased: MaybeInt
print aliased == nil
