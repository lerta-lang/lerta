# A const is declared with `:=`, or with its type and `=`, or with its type alone when it starts
# empty; a destructuring and the name of an `if` or a `while` are declared with `:=` too.
class Node
  args
    label: String

struct Pair
  left: Int
  right: Int

TOP := 'top'
export twice := (n: Int) -> n * 2

answer := twice(21)
widened: Int? = answer
names: String[]
names.push 'first'
counts: Map<String, Int>
counts['a'] = 1
{ left, right } := Pair(left: 1, right: 2)
(first, second) := (3, 4)
print "#{TOP} #{answer} #{names} #{counts['a']!} #{left} #{right} #{first} #{second}"
print found if found := widened
var rest: Int? = 2
while n := rest
  print n
  rest = n > 1 then n - 1
watch := (held: Node) ->
  weak seen := held
  print seen?.label else 'gone'
watch Node('held')

# A const of an inner scope shadows the one of the same name outside it.
if answer > 0
  answer := 'inner'
  print answer
print answer
