# `+=` evaluates its value before it reads its target: a value that assigns the target is seen, a
# value that throws leaves the target as it was, and an index out of range throws once the value is
# made, which is then released.
refuse := (): String -> throw ValueError(message: 'no value')

var s = 'a'.to_string()
grow := ->
  s += 'b'
  'x'
s += grow()
print s

class Holder(text: String)

holder := Holder(text: 'kept'.to_string())
try
  s += refuse()
catch e: ValueError
  print "#{e.message}: #{s}"
try
  holder.text += refuse()
catch e: ValueError
  print "#{e.message}: #{holder.text}"

words := ['one'.to_string()]
try
  words[3] += 'made'.to_string()
catch e: IndexError
  print "#{e.message}: #{words[0]}"

# The array is evaluated before the value, so the old one takes the append, even where the value
# replaces it.
var lines = ['p'.to_string(), 'q'.to_string()]
old := lines
replace := ->
  lines = ['z'.to_string()]
  'w'
lines[1] += replace()
print "#{old[1]} #{lines[0]}"

# So is a field's object: the old holder takes the append where the value replaces it.
var target = Holder(text: 'a'.to_string())
first := target
swap := ->
  target = Holder(text: 'z'.to_string())
  'b'
target.text += swap()
print "#{first.text} #{target.text}"

# A Binary and a number take the same order.
var bytes = 'a'.binary
more := ->
  bytes += 'b'.binary
  'c'.binary
bytes += more()
print bytes.text()!

class Counter(var count: Int)

counter := Counter(count: 10)
reset := ->
  counter.count = 100
  1
counter.count -= reset()
print counter.count
counter.count *= reset() + 1
print counter.count
