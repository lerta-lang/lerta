class Log
  text = ''
var s = 'a'
s += 'b'
s += s
print s
log := Log()
log.text += 'log: '
log.text += "#{s}!"
print log.text
words := ['one', 'two']
words[1] += 's'
print words[1]
class Replacing
  text = 'start'
  next = ->
    @text = 'replaced'
    '!'
replacing := Replacing()
replacing.text += replacing.next()
print replacing.text
