import is_file, make_dir, read_file, real_path, rename, write_file from 'std:io'

fails := (f: () -> void) ->
  try
    f()
    'no failure'
  catch error
    error.message

make_dir 'a/b//c/'
await write_file('a/b/c/f.txt', b'f')
print is_file('a/b/c/f.txt')
# A directory that is there already is no failure.
make_dir 'a/b'
make_dir 'a/b/c/'
print fails(-> make_dir('a/b/c/f.txt'))
print fails(-> make_dir('a/b/c/f.txt/d'))
print fails(-> make_dir(''))
absolute := "#{real_path('.')}/abs/dir"
make_dir absolute
await write_file("#{absolute}/f.txt", b'f')
print is_file('abs/dir/f.txt')
print fails(-> make_dir("a\0"))

rename 'a/b/c/f.txt', 'g.txt'
print "#{is_file('a/b/c/f.txt')} #{is_file('g.txt')}"
await write_file('h.txt', b'h')
# A file at the destination is replaced.
rename 'h.txt', 'g.txt'
print "#{(await read_file('g.txt')).text()!} #{is_file('h.txt')}"
await write_file('a/b/c/k.txt', b'k')
rename 'a/b', 'moved'
print "#{is_file('a/b/c/k.txt')} #{is_file('moved/c/k.txt')}"
print fails(-> rename('missing.txt', 'other.txt'))
print fails(-> rename('g.txt', "other\0"))
print fails(-> rename("g\0.txt", 'other.txt'))
make_dir 'full'
await write_file('full/x.txt', b'x')
print fails(-> rename('moved', 'full'))

print fails(-> rename('missing.txt', 'other.txt'))
