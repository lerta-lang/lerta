# A read of 0 bytes waits as any read does, past empty chunks, and gives an empty Binary, taking
# nothing, or nil at the end; a negative count is a ValueError.
import Reader from 'std:io'

chunks := ['', 'ab', '']
var next = 0
reader := Reader(->
  return nil if next == chunks.length
  next += 1
  chunks[next - 1].binary
)
print (await reader.read(0))!.length
print (await reader.read_exactly(0))!.length
print (await reader.read(5))!.text()!
print await reader.read(0) == nil
print await reader.read_exactly(0) == nil
try
  await reader.read(-1)
catch error: ValueError
  print error.message
try
  await reader.read_exactly(-1)
catch error: ValueError
  print error.message
