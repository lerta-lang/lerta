# A file in a missing directory, or at a path that holds a NUL byte, cannot be created, and a writer
# that has ended takes no more.
import create from 'std:io'

for path in ['missing/out.txt', "a\0"]
  try
    await create(path).end()
  catch error: IOError
    print error.message
file := create('ended.txt')
await file.end()
try
  await file.write('more')
catch error: IOError
  print error.message
