# A copy of a directory fails, and leaves the file at its destination as it was.
import copy_file, make_dir, stat, write_file from 'std:io'

make_dir 'dir'
await write_file('kept.txt', 'kept'.binary)
try
  await copy_file('dir', 'kept.txt')
catch error: IOError
  print error.message
print stat('kept.txt')!.size
try
  await copy_file('dir', 'new.txt')
catch error: IOError
  print error.message
print stat('new.txt') == nil
