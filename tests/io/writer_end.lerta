# The end of stdout or stderr only flushes: writes after it go on, in the order of the buffer, and a
# flush and print still work. Only stdout is shown, as stderr is compared only for a failure.
import stderr, stdout, Writer from 'std:io'

write_after_end := (writer: Writer, writes: (String | Binary)[]) ->
  await writer.end()
  await writer.end()
  await writer.write(data) for data in writes

await stdout.write("before the end\n")
await write_after_end(stdout, ['after the end, ', b"bytes\n"])
await write_after_end(stderr, ['', b''])
await stdout.flush()
print 'flushed and printed'
