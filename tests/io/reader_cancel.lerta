# A cancelled read of a Reader leaves what it took from the chunks for the next read, of a line, of
# a count of bytes or of all that is left.
import Deferred from 'std:async'
import Reader from 'std:io'
import sleep from 'std:time'

var requested = Deferred<Binary?>()
reader := Reader(read_chunk: ->
  requested = Deferred<Binary?>()
  await requested.promise()
)

# Gives the chunk that the reader asked for last, and lets the read take it.
give := (chunk: Binary?) ->
  requested.resolve chunk
  await sleep(0)

outcome := (promise: Promise<String?>) ->
  try
    await promise ? 'nil'
  catch error: CancelledError
    error.message

line := reader.read_line()
await give('ab'.binary)
line.cancel()
print await outcome(line)
next_line := reader.read_line()
await give("cd\nef".binary)
print await outcome(next_line)

bytes := -> (await reader.read(4))?.text()
four := bytes()
await give('g'.binary)
four.cancel()
print await outcome(four)
next_four := bytes()
await give('hij'.binary)
print await outcome(next_four)
rest := -> (await reader.read_all()).text()
all := rest()
await give('k'.binary)
await give('l'.binary)
all.cancel()
print await outcome(all)

# So does one that the chunk's error rejects.
failing_line := reader.read_line()
await give('m'.binary)
requested.reject IOError(message: 'broken')
try
  await failing_line
catch error: IOError
  print error.message
recovered := rest()
await give('n'.binary)
await give(nil)
print await outcome(recovered)
