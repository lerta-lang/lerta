# A file in a missing directory, or at a path that holds a NUL byte, cannot be opened, and a writer
# that has ended takes no more.
import open from 'std:io'

for path in ['missing/out.txt', "a\0"]
  try
    await open(path, WRITE).writer.end()
  catch error: IOError
    print error.message
file := open('ended.txt', WRITE)
await file.writer.end()
try
  await file.writer.write('more')
catch error: IOError
  print error.message
