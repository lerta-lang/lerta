# remove_tree rejects a path whose last part is `.` or `..`, past the separators at its end, before
# anything is removed, but not one whose last part only starts with dots.
import is_dir, make_dir, remove_tree from 'std:io'

make_dir 'a/b'
for path in ['a/b/..', 'a/.', 'a/b/../', '.', '..', '../']
  try
    await remove_tree(path)
  catch error: IOError
    print error.message
print is_dir('a/b')
make_dir 'a/..b'
make_dir 'a/.x'
await remove_tree('a/..b')
await remove_tree('a/.x')
print is_dir('a/..b')
print is_dir('a/.x')
