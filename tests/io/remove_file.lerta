# remove_file removes a file; it refuses a directory, which stays, a path that names nothing, an
# empty one and one that holds a NUL byte.
import is_dir, is_file, make_dir, remove_file, write_file from 'std:io'

await write_file('f.txt', b'f')
remove_file 'f.txt'
print is_file('f.txt')
make_dir 'd'
for path in ['d', 'missing', "x\0y", '']
  try
    remove_file path
  catch e: IOError
    print e.message
print is_dir('d')
