# A file that open opens for writing gets what is written, in order, once flushed, beyond its
# buffer too; it is emptied first, and Strings and Binarys are written alike.
import open, read_file, read_text, write_file from 'std:io'

await write_file('out.txt', b'old contents')
file := open('out.txt', WRITE)
await file.writer.write('first ')
await file.writer.write('x'.repeat(70000).binary)
await file.writer.write(' last')
await file.writer.flush()
text := (await read_text('out.txt'))!
print text.binary.length
print [text.starts_with('first x'), text.ends_with('x last')]
# A flush with nothing more to write waits for nothing.
await file.writer.flush()
print (await read_file('out.txt')).length
