# A Pipe's reader reads what its writer writes, in order, and nil once the writer has ended; a write
# is resolved once its chunk is taken, and one that is cancelled before writes nothing, and one
# cancelled after is done.
import all from 'std:async'
import Pipe, Reader from 'std:io'
import run from 'std:process'
import sleep from 'std:time'

pipe := Pipe()
var taken = false
first := pipe.writer.write('one')
second := pipe.writer.write(b'two')
waited := ->
  await first
  print "first resolved after the read: #{taken}"
_watching := waited()
await sleep(0.05)
taken = true
print (await pipe.reader.read_chunk())!.text()!
print (await pipe.reader.read_chunk())!.text()!
await second
await pipe.writer.end()
await pipe.writer.end()
print await pipe.reader.read_chunk() == nil

try
  await pipe.writer.write('late')
catch error: IOError
  print error.message

# An empty chunk is resolved at once, and is not read as the end.
empty := Pipe()
await empty.writer.write('')
after := empty.writer.write('after')
print (await empty.reader.read_chunk())!.text()!
await after

# A cancelled write is not read.
cancelled := Pipe()
dropped := cancelled.writer.write('dropped')
kept := cancelled.writer.write('kept')
dropped.cancel()
try
  await dropped
catch error: CancelledError
  print 'cancelled'
print (await cancelled.reader.read_chunk())!.text()!
await kept

# A write cancelled once its chunk is taken, before it goes on, is done.
late := Pipe()
late_write := late.writer.write('taken')
reading_late := late.reader.read_chunk()
late_write.cancel()
await late_write
print "#{(await reading_late)!.text()!}, and written"
# The pipe goes on, with nothing of that write left.
next_write := late.writer.write('next')
print (await late.reader.read_chunk())!.text()!
await next_write
# A write whose chunk the reader's close rejects, cancelled before it goes on, fails as cancelled.
closing_late := Pipe()
rejected := closing_late.writer.write('rejected')
closing_late.reader.close()
rejected.cancel()
try
  await rejected
catch error: Error
  print error.message

# A read that waits is woken by a write, and by the end.
waiting := Pipe()
reading := waiting.reader.read_chunk()
await sleep(0.05)
_writing := waiting.writer.write('woken')
print (await reading)!.text()!
ending := waiting.reader.read_chunk()
await sleep(0.05)
await waiting.writer.end()
print await ending == nil

# One program writes what another reads.
between := Pipe()
first_program := run('echo_input', stdin: b'through a pipe', stdout: between.writer)
second_program := run('echo_input', stdin: between.reader, stdout: CAPTURE)
await all([first_program, second_program])
print (await second_program).stdout!.text()!

# Two reads that wait at once are each woken.
shared := Pipe()
one_read := shared.reader.read_chunk()
other_read := shared.reader.read_chunk()
await sleep(0.05)
_shared_x := shared.writer.write('x')
_shared_y := shared.writer.write('y')
print "#{(await one_read)!.text()!}#{(await other_read)!.text()!}"

# A read that waits may be cancelled, and the one waiting with it is still woken.
left_waiting := Pipe()
cancelled_read := left_waiting.reader.read_chunk()
still_waiting := left_waiting.reader.read_chunk()
await sleep(0.05)
cancelled_read.cancel()
_left_write := left_waiting.writer.write('still woken')
print (await still_waiting)!.text()!

# The chunks written before the end are read before it, and their writes resolved then.
ended := Pipe()
before_end := ended.writer.write("a line\nsplit ")
ended_after := ended.writer.write("across chunks\n")
await ended.writer.end()
print await ended.reader.read_line() ? 'nil'
print await ended.reader.read_line() ? 'nil'
await before_end
await ended_after
print await ended.reader.read_line() ? 'nil'

# One Pipe may take both outputs of a program.
both := Pipe()
both_run :=
  run('echo_input', 'to stderr', stdin: b"to stdout\n", stdout: both.writer, stderr: both.writer)
both_text := both.reader.read_all()
await both_run
lines := (await both_text).text()!.trim().split("\n")
print lines.sorted((a, b) -> a.compare(b)).join(', ')

# A read cancelled while it waits leaves the next read to take the next write.
given_up := Pipe()
gone := given_up.reader.read_chunk()
await sleep(0.05)
gone.cancel()
try
  await gone
catch error: CancelledError
  print 'read cancelled'
_after_cancel := given_up.writer.write('ü and more')
print (await given_up.reader.read(2))!.text()!

# A closed reader fails the writes that wait, and later ones, and reads nil.
closed := Pipe()
waiting_write := closed.writer.write('never read')
closed.reader.close()
for write in [waiting_write, closed.writer.write('later')]
  try
    await write
  catch error: IOError
    print error.message
print await closed.reader.read_chunk() == nil

# A program that ends without reading its input closes the reader, so the program that writes to
# the pipe fails, as it would by SIGPIPE, rather than waiting for ever.
unread := Pipe()
writer_run := run('repeat', '100000', 'line', stdout: unread.writer)
print (await run('exit_with', '0', stdin: unread.reader)).code
try
  await writer_run
catch error: IOError
  print error.message

# A read that waits when the reader is closed reads what is left, and a Reader with nothing to tell
# closes without a word.
closing := Pipe()
_closing_write := closing.writer.write('taken before')
all_read := closing.reader.read_all()
await sleep(0.05)
closing.reader.close()
print (await all_read).text()!
Reader(-> nil).close()
print 'closed'

# A program that cannot start leaves the Reader as it was.
not_started := Pipe()
try
  await run('no-such-command', stdin: not_started.reader)
catch error: IOError
  print error.message
_still_open := not_started.writer.write('still read')
print (await not_started.reader.read_chunk())!.text()!

# A writer that fails is read to its end, after which every read throws its error in place of nil;
# an end or a fail after it does nothing, and a write is rejected.
failed := Pipe()
_before_failure := failed.writer.write('before the failure')
failing_read := failed.reader.read_chunk()
print (await failing_read)!.text()!
waiting_for_failure := failed.reader.read_chunk()
await sleep(0.05)
failed.writer.fail ValueError('the source failed')
await failed.writer.end()
failed.writer.fail ValueError('a second failure')
for read in [waiting_for_failure, failed.reader.read_chunk()]
  try
    await read
  catch error: ValueError
    print error.message
try
  await failed.writer.write('late')
catch error: IOError
  print error.message

# A fail after the end, or once the reader has closed, leaves the reader reading nil.
ended_first := Pipe()
await ended_first.writer.end()
ended_first.writer.fail ValueError('too late')
print await ended_first.reader.read_chunk() == nil
closed_first := Pipe()
closed_first.reader.close()
closed_first.writer.fail ValueError('unread')
print await closed_first.reader.read_chunk() == nil

# A chunk queued before the fail is read first, a read of the Reader that reaches the error throws
# it however much it has buffered, and a take cancelled before the fail
# leaves the others to throw it.
queued_first := Pipe()
queued_write := queued_first.writer.write("a line\nand a part")
queued_first.writer.fail ValueError('cut short')
print (await queued_first.reader.read_line())!
await queued_write
try
  await queued_first.reader.read_line()
catch error: ValueError
  print error.message
try
  await queued_first.reader.read_all()
catch error: ValueError
  print error.message
takes := Pipe()
cancelled_take := takes.reader.read_chunk()
other_take := takes.reader.read_chunk()
await sleep(0.05)
cancelled_take.cancel()
takes.writer.fail ValueError('failed after a cancel')
try
  await other_take
catch error: ValueError
  print error.message

# A write that waits when the writer fails, cancelled before it is taken, writes nothing.
cancelled_before := Pipe()
pending_write := cancelled_before.writer.write('never taken')
cancelled_before.writer.fail ValueError('failed with a write pending')
pending_write.cancel()
try
  await pending_write
catch error: CancelledError
  print 'cancelled'
try
  await cancelled_before.reader.read_chunk()
catch error: ValueError
  print error.message

# A write after a fail, once the reader has closed, is rejected as one after an end is.
closed_then_failed := Pipe()
closed_then_failed.reader.close()
closed_then_failed.writer.fail ValueError('unread')
try
  await closed_then_failed.writer.write('late')
catch error: IOError
  print error.message

# A program whose input fails is stopped, and the run is rejected with the error.
failures: Error[] = [IOError('the input failed'), ValueError('the input was wrong')]
for failure in failures
  failing_input := Pipe()
  _input := failing_input.writer.write("a line\n")
  failing_input.writer.fail failure
  try
    await run('echo_input', stdin: failing_input.reader)
  catch error: Error
    print error.message
