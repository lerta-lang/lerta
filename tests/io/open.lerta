# open gives a Reader of a file, read in chunks: by lines, by counts, or whole, past the size of a
# chunk too, and an empty file gives its end at once.
import open, write_file from 'std:io'

await write_file('lines.txt', "first\nsecond\r\nlast")
lines := open('lines.txt')
print line while line := await lines.read_line()

big := 'x'.repeat(200000) + 'end'
await write_file('big.txt', big)
whole := await open('big.txt').read_all()
print whole.length
print whole.text()!.ends_with('end')

counted := open('big.txt')
print (await counted.read_exactly(3))!.text()!
print (await counted.read(70000))!.length

await write_file('empty.txt', '')
print await open('empty.txt').read_chunk() == nil
