# A file that is missing, at a path that holds a NUL byte, or that is a directory, cannot be opened;
# a Reader that is closed gives its end.
import make_dir, open, write_file from 'std:io'

make_dir 'dir'
for path in ['missing.txt', "a\0", 'dir']
  try
    open path
  catch error: IOError
    print error.message

await write_file('closed.txt', 'unread')
closed := open('closed.txt')
closed.close()
print await closed.read_all() == b''
