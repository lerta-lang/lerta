# Files are read and written on the event loop, so many can be under way at once.
import read_file, write_file from 'std:io'

const names = ["#{i}.txt" for i in 0...50]
const writes = [write_file(name, name.binary) for name in names]
await write for write in writes
const reads = [read_file(name) for name in names]
var same = 0
for read, i in reads
  same += 1 if (await read).text()! == names[i]
print same
