import { is_file, real_path, write_file } from 'std:io'

write_file('a.txt', 'a'.binary)
print is_file('a.txt')
print is_file('missing.txt')
print is_file('.')
print is_file("a.txt\0")
const absolute = real_path('a.txt')
const name = '/a.txt'.binary
print absolute.occurs_at(0, '/'.binary) and absolute.occurs_at(absolute.length - name.length, name)
print real_path('./././a.txt') == absolute
# The test runs in a directory inside another, so `..` gives a shorter path.
print real_path('./..').length < real_path('.').length
