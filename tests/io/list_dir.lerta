import is_dir, is_file, list_dir, make_dir, write_file from 'std:io'

fails := (f: () -> void) ->
  try
    f()
    'no failure'
  catch error
    error.message

make_dir 'top/sub'
make_dir 'top/empty'
await write_file('top/b.txt', b'b')
await write_file('top/a.txt', b'a')
await write_file('top/a', b'a')
await write_file('top/Z.txt', b'Z')
print list_dir('top').join(' ')
print list_dir('top/').join(' ')
print list_dir('top/empty').length
print "#{is_dir('top')} #{is_dir('top/sub')} #{is_dir('top/a.txt')} #{is_dir('missing')}"
print "#{is_file('top/sub')} #{is_dir('')} #{is_dir("top\0")}"
print fails(-> list_dir('missing'))
print fails(-> list_dir('top/a.txt'))
print fails(-> list_dir(''))
print fails(-> list_dir("top\0"))
try
  list_dir 'missing'
catch error: IOError
  print "IOError: #{error.message}"
