# An end made while the first is under way resolves only once the first has written out the rest
# and closed the file; a write made then is rejected.
import create from 'std:io'

writer := create('out.txt')
await writer.write('held in the buffer')
ended := (name: String) ->
  await writer.end()
  print name
first := ended('first')
second := ended('second')
try
  await writer.write('more')
catch error: IOError
  print error.message
await first
await second
