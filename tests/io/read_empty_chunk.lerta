# An empty chunk gives no read of its own: after it, the end gives nil.
import Reader from 'std:io'

chunks: Binary?[] = [b'a', b'', nil]
var next = 0
reader := Reader(->
  chunk := chunks[next]
  next += 1
  chunk
)
print (await reader.read(10))?.length ? -1
print (await reader.read(10))?.length ? -1
