# A FileWriter is made only by create: its file can be neither given as an address nor taken from
# another FileWriter, by reading it or by spreading that FileWriter.
import create, FileWriter from 'std:io'

other := create('elsewhere')
FileWriter file: 0x4141414140, path: 'nowhere'
FileWriter file: other.file, path: 'nowhere'
FileWriter(other..., path: 'nowhere')
