# Reads messages of a count on a line and that many bytes, as LSP's are read, and prints how many
# bytes each body has, or the error of one cut short, for a check that pipes a body longer than a
# chunk and one cut short.
import stdin from 'std:io'

try
  while header := await stdin.read_line()
    print (await stdin.read_exactly(header.parse_int()!))!.length
catch error: IOError
  print error.message
