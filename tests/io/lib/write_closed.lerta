# Reports the errors of writes to stdout, for a check that starts it with stdout closed: of one
# whose bytes fail to be written out, and of one after that failure.
import stdout from 'std:io'

try
  await stdout.write('lost')
  await stdout.flush()
catch error: IOError
  print_error error.message
try
  await stdout.write('lost again')
catch error: IOError
  print_error error.message
