# Writes more than the buffer holds to a reader that waits before it reads, and tells whether a
# timer fired on time meanwhile, for a check that pipes stdout to such a reader.
import stdout from 'std:io'
import monotonic, sleep from 'std:time'

started := monotonic()
tick := ->
  await sleep(0.1)
  print_error monotonic() - started < 0.5 then 'on time' else 'late'

ticking := tick()
var text = 'x'
text = text + text for i in 0...20
await stdout.write(text)
await ticking
