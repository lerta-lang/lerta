# Reads a count on a line, that many bytes, then at most the largest Int of bytes, and the rest, as
# a message with a header is read, for a check that pipes such a message to it.
import stdin from 'std:io'

count := (await stdin.read_line())!.parse_int()!
print (await stdin.read_exactly(count))!.text()!
print (await stdin.read(9223372036854775807))!.text()!
print (await stdin.read_all()).length
print await stdin.read(1) == nil
print await stdin.read_line() == nil
