# Reads a count on a line, that many bytes, and the rest, as a message with a header is read, for
# a check that pipes such a message to it.
import stdin from 'std:io'

const count = (await stdin.read_line())!.parse_int()!
print (await stdin.read(count))!.text()!
print (await stdin.read_all()).text()!
print await stdin.read(1) == nil
print await stdin.read_line() == nil
