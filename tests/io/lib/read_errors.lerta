# Reports the errors of reads of stdin: a negative count, for `read` and for `read_exactly`, a read
# while another waits, and a line that is not UTF-8, then reads the rest, for a check that pipes
# such a line and more to it.
import stdin from 'std:io'

try
  print await stdin.read(-1) == nil
catch error: ValueError
  print error.message
try
  print await stdin.read_exactly(-1) == nil
catch error: ValueError
  print error.message
first := stdin.read_line()
try
  print await stdin.read_line() == nil
catch error: ValueError
  print error.message
try
  print await first == nil
catch error: ValueError
  print error.message
print (await stdin.read_all()).text()!
