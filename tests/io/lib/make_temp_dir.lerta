# Makes a temporary directory, for a check that sets the variables that tell where, and tells
# whether it is in /tmp, which is /private/tmp on macOS, and removes it.
import make_temp_dir, remove_tree from 'std:io'

dir := make_temp_dir().text()!
print dir.starts_with('/tmp/') or dir.starts_with('/private/tmp/')
await remove_tree(dir)
