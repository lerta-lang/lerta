# A read that `timeout` ends has ended once the TimeoutError comes, so the next read may start
# right after it.
import timeout, TimeoutError from 'std:async'
import Reader from 'std:io'
import sleep from 'std:time'

reader := Reader(read_chunk: ->
  await sleep(0.05)
  'ab'.binary
)
try
  await timeout(reader.read(10), 0.01)
catch _: TimeoutError
  print 'timed out'
print (await reader.read(10))?.length ? -1
