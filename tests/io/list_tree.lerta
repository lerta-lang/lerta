import list_tree, make_dir, write_file from 'std:io'

make_dir 'top/sub/deeper'
make_dir 'top/sub/.cache'
make_dir 'top/.hidden'
make_dir 'top/empty'
await write_file('top/b.txt', 'b')
await write_file('top/a.txt', 'a')
await write_file('top/.f.txt', 'f')
await write_file('top/sub/c.txt', 'c')
await write_file('top/sub/deeper/d.txt', 'd')
await write_file('top/sub/.cache/g.txt', 'g')
await write_file('top/.hidden/e.txt', 'e')
print list_tree('top').join(' ')
print list_tree('top/').join(' ')

# `enters` takes the names of the directories under the path, not the path itself or its files.
not_hidden := (name: String) -> not name.starts_with('.')
print list_tree('top', not_hidden).join(' ')
print list_tree('top/.hidden', not_hidden).join(' ')
print list_tree('top/empty').length
try
  list_tree 'missing'
catch error: IOError
  print error.message
