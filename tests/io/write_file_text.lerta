# write_file takes a String as its UTF-8, as well as a Binary.
import make_temp_dir, read_file, remove_tree, write_file from 'std:io'

dir := make_temp_dir()
path := "#{dir}/out.txt"
await write_file(path, "caf\u{e9}\n")
print await read_file(path) == b"caf\xC3\xA9\n"
await write_file(path, '')
print (await read_file(path)).length
await write_file(path, b'ab')
print (await read_file(path)).text()!
await remove_tree(dir)
