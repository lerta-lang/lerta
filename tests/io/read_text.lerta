import read_text, write_file from 'std:io'

await write_file('read_text.txt', b"héllo\n")
print await read_text('read_text.txt') ? 'not UTF-8'
await write_file('read_text.txt', b"\xFF")
print await read_text('read_text.txt') ? 'not UTF-8'
await write_file('read_text.txt', b'')
print (await read_text('read_text.txt'))!.is_empty()
