import read_text, write_file from 'std:io'

await write_file('read_text.txt', "héllo\n".binary)
print await read_text('read_text.txt') ? 'not UTF-8'
await write_file('read_text.txt', [0xFF.to_byte()!].to_binary())
print await read_text('read_text.txt') ? 'not UTF-8'
await write_file('read_text.txt', ''.binary)
print (await read_text('read_text.txt'))!.is_empty()
