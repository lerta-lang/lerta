# A drive alone names its current directory, whose entries list_dir lists, not those of the drive's
# root. The tests run on a drive letter.
import list_dir, real_path, write_file from 'std:io'

await write_file('a.txt', 'a'.binary)
drive := real_path('.').text(0, 2)!
print list_dir(drive) == list_dir('.')
