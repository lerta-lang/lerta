# On Windows, a backslash separates directories too, and make_dir makes the parents of a path that
# starts with a drive, which it cannot make itself.
import is_dir, make_dir, real_path from 'std:io'

make_dir 'a\b\\c\'
print is_dir('a/b/c')
make_dir "#{real_path('.').text()!}\\d\\e"
print is_dir('d/e')
