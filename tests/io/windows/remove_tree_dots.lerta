# remove_tree takes `\` for a separator, and a drive's `:` for the end of the part before, in
# rejecting a path whose last part is `.` or `..`, before anything is removed.
import is_dir, make_dir, remove_tree from 'std:io'

make_dir 'a\b'
for path in ['a\b\..', 'a\.\', 'C:.', 'C:..']
  try
    await remove_tree(path)
  catch error: IOError
    print error.message
print is_dir('a\b')
