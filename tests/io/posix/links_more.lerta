# A relative target is read from the link's directory; a dangling link is neither a file nor a
# directory; a loop of links cannot be read; and a copy of a private file onto an open one leaves it
# private.
import copy_file, is_dir, is_file, make_dir, make_link, stat, write_file from 'std:io'
import run from 'std:process'

make_dir 'sub'
await write_file('sub/target.txt', b'in sub')
make_link 'target.txt', 'sub/link'
print stat('sub/link')!.size
make_link 'missing', 'dangling'
print [is_file('dangling'), is_dir('dangling')]
make_link 'loop_b', 'loop_a'
make_link 'loop_a', 'loop_b'
print [is_file('loop_a'), is_dir('loop_a'), stat('loop_a') == nil]
try
  make_link 'target', "a\0"
catch error: IOError
  print error.message
try
  make_link "target\0", 'a'
catch error: IOError
  print error.message

await write_file('private.txt', b'private')
await run('chmod', '600', 'private.txt')
await write_file('open.txt', b'open')
await run('chmod', '644', 'open.txt')
await copy_file('private.txt', 'open.txt')
listing := await run('ls', '-l', 'open.txt', stdout: CAPTURE)
print listing.stdout!.text()!.split(' ')[0]
print stat('open.txt')!.size

# A copy through a dangling link makes its target.
make_link 'made.txt', 'to_made'
await copy_file('private.txt', 'to_made')
print stat('made.txt')!.size
