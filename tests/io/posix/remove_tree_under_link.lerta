# remove_tree removes a directory through a link to its parent, in the directory linked to.
import is_dir, make_dir, make_link, remove_tree, write_file from 'std:io'

make_dir 'real/sub'
await write_file('real/sub/f.txt', b'f')
make_link 'real', 'link'
await remove_tree('link/sub')
print is_dir('real/sub')
print is_dir('link')
