# A link, to a file, a directory or nothing, which stat follows; a copy of a program keeps it
# runnable.
import copy_file, is_dir, is_file, make_dir, make_link, read_file, stat, write_file from 'std:io'
import run from 'std:process'

await write_file('a.txt', 'hello'.binary)
make_dir 'dir'
make_link 'a.txt', 'to_file'
make_link 'dir', 'to_dir'
make_link 'missing', 'dangling'
print is_file('to_file')
print stat('to_file')!.size
print [is_dir('to_dir'), stat('to_dir')!.kind == DIR]
print stat('dangling') == nil
print stat('/dev/null')!.kind == OTHER
print (await read_file('to_file')).text()!

await write_file('script', "#!/bin/sh\necho ran\n".binary)
await run('chmod', '+x', 'script')
await copy_file('script', 'copied')
await run('./copied')
