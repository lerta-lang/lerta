# remove_file removes a link, not what it links to: a file, a directory, or nothing.
import is_dir, is_file, make_dir, make_link, remove_file, write_file from 'std:io'

await write_file('target.txt', b't')
make_link 'target.txt', 'link'
remove_file 'link'
print is_file('link')
print is_file('target.txt')
make_dir 'dir'
make_link 'dir', 'dir_link'
remove_file 'dir_link'
print is_dir('dir_link')
print is_dir('dir')
make_link 'missing', 'dangling'
remove_file 'dangling'
make_link 'missing', 'dangling'
print 'made again'
