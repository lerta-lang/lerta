# A name that is not UTF-8 is refused. macOS cannot make one, so there the test checks nothing.
import list_dir, make_dir from 'std:io'
import run from 'std:process'

make_dir 'top'
made := (await run('sh', '-c', "touch \"top/$(printf 'a\\377')\" 2> /dev/null")).code == 0
try
  list_dir 'top'
  print made then 'no failure' else 'ValueError: a name is not valid UTF-8 in the directory: top'
catch error: ValueError
  print "ValueError: #{error.message}"
