# A new copy takes the permissions of the file less the umask, as a file that the shell makes, and
# a file that a copy replaces keeps those of its own that the file has.
# The umask is the one the tests run with, which tells the new copy from one that ignores it
# unless it is 0.
import copy_file, write_file from 'std:io'
import run from 'std:process'

await write_file('a.txt', b'hello')
await write_file('kept.txt', b'')
await run('chmod', '666', 'a.txt')
await run('chmod', '600', 'kept.txt')
await copy_file('a.txt', 'new.txt')
await copy_file('a.txt', 'kept.txt')
same_mode := 'test "$(ls -l made.txt | cut -c1-10)" = "$(ls -l new.txt | cut -c1-10)"'
print (await run('sh', '-c', ": > made.txt && #{same_mode}")).code
await run('sh', '-c', 'ls -l kept.txt | cut -c1-10')
