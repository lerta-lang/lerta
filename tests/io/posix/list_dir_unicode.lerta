# The names are UTF-8, in the order of their bytes. Wine, which runs the Windows tests, cannot make
# a file of such a name.
import list_dir, make_dir, write_file from 'std:io'

make_dir 'top'
await write_file('top/名前.txt', b'n')
await write_file('top/z.txt', b'z')
await write_file('top/é.txt', b'e')
print list_dir('top').join(' ')
