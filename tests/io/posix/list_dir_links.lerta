import is_dir, list_dir, make_dir from 'std:io'
import run from 'std:process'

# Links are followed, and one that leads nowhere is no directory.
make_dir 'top/sub'
await run('ln', ['-s', 'sub', 'top/link'])
await run('ln', ['-s', 'missing', 'top/dangling'])
print list_dir('top').join(' ')
print list_dir('top/link').length
print "#{is_dir('top/link')} #{is_dir('top/dangling')}"
try
  list_dir 'top/dangling'
catch error: IOError
  print error.message
