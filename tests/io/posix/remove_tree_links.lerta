# remove_tree removes a link to a directory, in the directory or given itself, not what it links to.
import is_dir, is_file, make_dir, make_link, remove_tree, write_file from 'std:io'

make_dir 'kept'
await write_file('kept/f.txt', b'f')
make_dir 'top'
make_link '../kept', 'top/link'
make_link 'kept', 'link'
await remove_tree('top')
await remove_tree('link')
print is_dir('top')
print is_dir('link')
print is_file('kept/f.txt')
