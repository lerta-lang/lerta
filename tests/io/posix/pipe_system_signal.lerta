# A program that writes to a system pipe whose reader has ended is ended by SIGPIPE, as in a shell.
import Pipe from 'std:io'
import run from 'std:process'

pipe := Pipe()
writing := run('repeat', '1000000', 'line', stdout: pipe)
print (await run('exit_with', '0', stdin: pipe)).code
exit := await writing
print "#{exit.code} #{exit.signal else 0}"

# So is one whose reader is this program, once it closes the reader.
closed := Pipe()
writing_on := run('repeat', '1000000', 'line', stdout: closed)
_first := await closed.reader.read_chunk()
closed.reader.close()
print (await writing_on).signal else 0
