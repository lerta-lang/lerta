# A file that is not regular, such as a FIFO without a writer or a device without an end, fails at
# once rather than block or fill the memory, through a link too, as does a directory.
import make_link, read_file from 'std:io'
import run from 'std:process'

await run('mkfifo', 'fifo')
make_link '/dev/zero', 'zero'
for path in ['fifo', '/dev/zero', 'zero', '.']
  try
    await read_file(path)
  catch error: IOError
    print error.message
