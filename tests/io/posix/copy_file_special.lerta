# A copy onto the file itself through a link, or from or to a FIFO, fails at once, and leaves the
# files as they were.
import copy_file, make_link, stat, write_file from 'std:io'
import run from 'std:process'

await write_file('a.txt', b'hello')
make_link 'a.txt', 'link'
await run('ln', 'a.txt', 'hard')
await run('mkfifo', 'fifo')
for (from, to) in [
  ('a.txt', 'link')
  ('a.txt', 'hard')
  ('fifo', 'b.txt')
  ('a.txt', 'fifo')
  ('a.txt', '/dev/null')
]
  try
    await copy_file(from, to)
  catch error: IOError
    print error.message
print stat('a.txt')!.size
print stat('b.txt') == nil
