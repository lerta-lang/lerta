import list_tree, make_dir, write_file from 'std:io'
import run from 'std:process'

# Links are followed, but not one back to a directory being listed, and one that leads nowhere is a
# file.
make_dir 'top/sub'
await write_file('top/sub/a.txt', 'a')
await run('ln', '-s', 'sub', 'top/link')
await run('ln', '-s', '..', 'top/sub/up')
await run('ln', '-s', 'missing', 'top/dangling')
print list_tree('top').join(' ')

# A link is entered by its own name.
print list_tree('top', (name) -> name != 'link').join(' ')
