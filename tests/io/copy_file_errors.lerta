# A copy into a missing directory, or from a path that holds a NUL byte, fails.
import copy_file, write_file from 'std:io'

await write_file('a.txt', 'hello'.binary)
for (from, to) in [('a.txt', 'missing/b.txt'), ("a\0", 'b.txt')]
  try
    await copy_file(from, to)
  catch error: IOError
    print error.message
