import { is_file, make_temp_dir, remove_tree, write_file } from 'std:io'

const dir = make_temp_dir().text()!
const other = make_temp_dir().text()!
print dir != other
const file = "#{dir}/a.txt"
write_file file, 'a'.binary
print is_file(file)
remove_tree dir
print is_file(file)
remove_tree other
# A file alone is removed too.
write_file 'b.txt', ''.binary
remove_tree 'b.txt'
print is_file('b.txt')
