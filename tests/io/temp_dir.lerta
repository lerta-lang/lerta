import is_file, make_temp_dir, remove_tree, write_file from 'std:io'

dir := make_temp_dir().text()!
other := make_temp_dir().text()!
print dir != other
file := "#{dir}/a.txt"
await write_file(file, 'a'.binary)
print is_file(file)
await remove_tree(dir)
print is_file(file)
await remove_tree(other)
# A file alone is removed too.
await write_file('b.txt', ''.binary)
await remove_tree('b.txt')
print is_file('b.txt')
