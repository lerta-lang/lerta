enum TokenKind
  IDENTIFIER
  INTEGER
  '('
  ')'
  "->"
  'const'
  "\t"

struct Token
  kind: TokenKind
  text: String

const describe = (kind: TokenKind): String ->
  case kind
    when IDENTIFIER then 'a name'
    when INTEGER then 'an integer'
    when '(', ')' then 'a parenthesis'
    when '->' then 'an arrow'
    when 'const' then 'a keyword'
    when "\t" then 'a tab'

const closing = (kind: TokenKind): TokenKind -> kind == '(' then ')' else kind

const pick = <T>(first: T, second: T): T -> second

const annotated: TokenKind = '('
const optional: TokenKind? = 'const'
var assigned = TokenKind.IDENTIFIER
assigned = '->'
const token = Token(kind: ')', text: ')')
const kinds: TokenKind[] = ['(', INTEGER, ')']
const counts: Map<TokenKind, Int> = { ('('): 1, (IDENTIFIER): 2 }
counts[')'] = 3

print annotated
print optional!
print assigned
print token.kind
print closing('(')
print kinds[2]
print counts['(']!
print counts[')']!
print counts.has('->')
print annotated == '('
print '(' == annotated
print annotated != ')'
print pick(annotated, ')')
print [describe(kind) for kind in kinds].join(', ')
print describe("\t")
print "[#{TokenKind.INTEGER}] [#{token.kind}] [#{assigned.to_string()}]"

# Where a String or nothing is expected, a string literal is a String.
const text = '('
print text == '('
print text
