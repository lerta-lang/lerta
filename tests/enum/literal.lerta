enum TokenKind
  IDENTIFIER
  INTEGER
  '('
  ')'
  "->"  # fmt: skip
  'const'
  "\t"

struct Token(kind: TokenKind, text: String)

describe := (kind: TokenKind) ->
  case kind
    when IDENTIFIER then 'a name'
    when INTEGER then 'an integer'
    when '(', ')' then 'a parenthesis'
    when '->' then 'an arrow'
    when 'const' then 'a keyword'
    when "\t" then 'a tab'

closing := (kind: TokenKind): TokenKind -> kind == '(' then ')' else kind

pick := <T>(first: T, second: T): T -> second

annotated: TokenKind = '('
optional: TokenKind? = 'const'
var assigned = TokenKind.IDENTIFIER
assigned = '->'
token := Token(kind: ')', text: ')')
kinds: TokenKind[] = ['(', INTEGER, ')']
counts: Map<TokenKind, Int> = { '(': 1, (IDENTIFIER): 2 }
counts[')'] = 3

print annotated
print optional!
print assigned
print token.kind
print closing('(')
print kinds[2]
print counts['(']!
print counts[')']!
print counts.has('->')
print annotated == '('
print '(' == annotated
print annotated != ')'
print pick(annotated, ')')
print [describe(kind) for kind in kinds].join(', ')
print describe("\t")
print "[#{TokenKind.INTEGER}] [#{token.kind}] [#{assigned.to_string()}]"

# Where a String or nothing is expected, a string literal is a String.
text := '('
print text == '('
print text
