import Light from './lib/colors'

enum TokenKind
  IDENTIFIER
  '('
  '->'
  ''

show := (kind: TokenKind?) -> kind then kind.to_string() else 'nil'

print show(TokenKind.parse('('))
print show(TokenKind.parse('->'))
print show(TokenKind.parse('IDENTIFIER'))
print show(TokenKind.parse(''))
print show(TokenKind.parse('-'))
print show(TokenKind.parse('identifier'))
print TokenKind.parse('(')! == '('
name := 'IDENTIFIER'
print TokenKind.parse(name)! == IDENTIFIER
print Light.parse('ON')! == ON
print Light.parse('on') == nil
