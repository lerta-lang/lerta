enum Command
  RUN
  'parse'
  ''

const show = (command: Command?): String ->
  const present = command ? return 'none'
  case present
    when '' then 'empty'
    when 'parse' then 'parse'
    when RUN then 'run'

const first = (commands: Array<Command>): Command? -> commands.length > 0 then '' else nil

const optional: Command? = ''
print optional! == ''
print optional! != 'parse'
print show('')
print show('parse')
print show(Command.parse('parse'))
print show(Command.parse('RUN'))
print show(nil)
print show(first([RUN]))
print "[#{optional!}]"
