enum Command
  RUN
  'parse'
  ''

show := (command: Command?) ->
  present := command ? return 'none'
  case present
    when '' then 'empty'
    when 'parse' then 'parse'
    when RUN then 'run'

first := (commands: Command[]): Command? -> not commands.is_empty() then '' else nil

optional: Command? = ''
print optional! == ''
print optional! != 'parse'
print show('')
print show('parse')
print show(Command.parse('parse'))
print show(Command.parse('RUN'))
print show(nil)
print show(first([RUN]))
print "[#{optional!}]"
