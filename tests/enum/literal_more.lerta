import parse from 'std:enums'

enum Command
  RUN
  'parse'
  ''

show := (command: Command?) ->
  present := command else return 'none'
  case present
    when '' then 'empty'
    when 'parse' then 'parse'
    when RUN then 'run'

first := (commands: Command[]): Command? -> not commands.is_empty() then ''

optional: Command? = ''
print optional! == ''
print optional! != 'parse'
print show('')
print show('parse')
print show(parse<Command>('parse'))
print show(parse<Command>('RUN'))
print show(nil)
print show(first([RUN]))
print "[#{optional!}]"
