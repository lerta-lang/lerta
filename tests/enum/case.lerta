enum Color
  RED
  GREEN
  BLUE

# Every member handled: no else needed.
const name = (color: Color) ->
  case color
    when RED then 'red'
    when GREEN, Color.BLUE then 'other'  # fmt: skip

const warm = (color: Color) ->
  case color
    when RED then true
    else false

const favorite = Color.GREEN
const report = (color: Color) ->
  case color
    when favorite then print('favorite')
    when RED then pass
    else print('plain')

print name(RED)
print name(BLUE)
print warm(RED)
print warm(GREEN)
report GREEN
report RED
report BLUE
