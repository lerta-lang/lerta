# Where a union that holds one enum is expected, or an optional one, a member of that enum stands
# alone, as where the enum itself is.
enum Color
  RED
  GREEN
  '('

struct Point
  x: Int

describe := (value: Color | Point | String) ->
  case value
    when Color then "color #{value}"
    when Point then "point #{value.x}"
    when String then "text #{value}"

print describe(GREEN)
print describe(Point(2))

# A literal stays a String where the union holds String too.
print describe('(')
maybe: (Color | Point)? = RED
print maybe is Color
values: (Color | Point)[] = [GREEN, Point(1), '(']
print values.length
print values[2] is Color

# The other operand of == and of `in`, where the union is the operand's type.
v: Color | Int = 3
print v == RED
print v in [RED, '(']

# A union of an optional String holds a String too.
text: Color | String? = '('
print text is String
print v != GREEN

# A default of a parameter of the union, and a key of a map of it.
painted := (color: Color | Int = GREEN) -> color is Color
print painted()
counts: Map<Color | Int, Int>
counts[RED] = 1
print counts[RED]!
