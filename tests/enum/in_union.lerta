# A union holds an enum's member as it holds a struct, and tells them apart.
enum Color
  RED
  GREEN

struct Point(x: Int)

type Value = Color | Point

const describe = (value: Value) ->
  case value
    when Color then value.to_string()
    when Point then "point #{value.x}"

print describe(Color.GREEN)
print describe(Point(x: 2))
