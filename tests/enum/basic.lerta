enum TokenKind
  IDENTIFIER
  INTEGER
  STRING

struct Token(kind: TokenKind, text: String)

describe := (kind: TokenKind) ->
  case kind
    when IDENTIFIER then 'a name'
    when INTEGER, STRING then 'a literal'

kind_of := (text: String): TokenKind ->
  return INTEGER if text == '1'
  IDENTIFIER

qualified := TokenKind.STRING
elided: TokenKind = INTEGER
optional: TokenKind? = STRING
var assigned = TokenKind.IDENTIFIER
assigned = STRING
token := Token(kind: IDENTIFIER, text: 'x')
kinds: TokenKind[] = [IDENTIFIER, STRING]
counts: Map<TokenKind, Int> = { (INTEGER): 1, (STRING): 2 }
counts[IDENTIFIER] = 3

print qualified
print elided
print optional!
print assigned
print token.kind
print describe(INTEGER)
print kind_of('1')
print kinds[1]
print counts[IDENTIFIER]!
print counts[TokenKind.STRING]!  # fmt: skip
print counts.has(INTEGER)
print "#{token.kind}: #{token.text}"
print token.kind.to_string()
print token.kind == IDENTIFIER
print IDENTIFIER == token.kind
print token.kind != TokenKind.INTEGER  # fmt: skip
print elided == qualified
print [describe(kind) for kind in kinds].join(', ')

# An enum value is Stringable for a bound, a field's default, and a key of a map that is iterated.
show := <T: Stringable>(value: T) -> "<#{value.to_string()}>"
class Lexer
  last: TokenKind = STRING
lengths: Map<TokenKind, Int> = { (IDENTIFIER): 1, (STRING): 2 }
print show(TokenKind.INTEGER)
print Lexer().last
print "#{kind} #{lengths[kind]!}" for kind in lengths.keys()
