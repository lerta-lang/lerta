# Enum members order as declared, by `<` and the like, compare, sorting, min and max.
enum Size
  SMALL
  MEDIUM
  LARGE
print Size.SMALL < LARGE
print Size.LARGE <= MEDIUM
print Size.MEDIUM > SMALL
print Size.LARGE.compare(LARGE)
print Size.SMALL.compare(MEDIUM)
print Size.LARGE.compare(MEDIUM)
sizes: Size[] = [LARGE, SMALL, MEDIUM]
print sizes.sorted()
print sizes.min()!
print sizes.max()!
greatest := <T: Comparable>(a: T, b: T) -> a < b then b else a
print greatest(Size.LARGE, SMALL)
# As declared, not by their texts.
enum Level
  'low'
  'high'
low: Level = 'low'
print low < 'high'
