# A weak function literal captures @ without keeping it alive, so that @ may hold it: called while
# the object lives, it runs with @ as usual; called once it is gone, it does nothing.
import sleep from 'std:time'

class Button
  name: String
  on_press: (() -> void)? = nil
  on_load: (() -> Promise)? = nil
  presses = 0
  init = ->
    const step = 2
    @on_press = weak -> @presses += step
    @on_load = weak ->
      print "#{@name} loading"
      await sleep(0)
      print "#{@name} loaded after #{@presses} presses"
  deinit = -> print("drop #{@name}")

const press = ->
  const button = Button(name: 'kept')
  button.on_press!()
  button.on_press!()
  print button.presses
press()

# One that awaits holds @ until its body ends, though the object's last other holder lets go.
var loading: Promise?
const start = ->
  const button = Button(name: 'loading')
  loading = button.on_load!()
start()
await loading!

# Called once the object is gone, it runs none of its body; one that awaits gives a settled Promise.
var press_later: (() -> void)?
var load_later: (() -> Promise)?
const keep_callbacks = ->
  const button = Button(name: 'gone')
  press_later = button.on_press
  load_later = button.on_load
keep_callbacks()
press_later!()
await load_later!()
print 'nothing ran'

# A literal inside a weak one captures @ from it, strongly while it runs.
class Counter
  count = 0
  on_tick: (() -> void)? = nil
  init = -> @on_tick = weak ->
    const add = (n: Int) -> @count += n
    add 3
const counter = Counter()
counter.on_tick!()
print counter.count

# With parameters, given as an argument without parentheses, and nested in another weak one.
class Source
  listeners: ((Int) -> void)[] = []
  listen = (f: (Int) -> void) -> @listeners.push(f)
  emit = (n: Int) -> f(n) for f in @listeners

class View
  total = 0
  source = Source()
  init = ->
    @source.listen weak (n) -> @total += n
    @source.listen weak (n) ->
      const later = weak -> @total += n * 10
      later()
const view = View()
view.source.emit 2
print view.total

# Inside a plain literal, with a return of its own; stored in a field of @, it gives no warning.
class Panel
  shown = 0
  on_show: (() -> void)? = nil
  make = -> weak -> @shown += 1
  init = -> @on_show = weak ->
    return if @shown > 0
    @shown = 10
const panel = Panel()
panel.make()()
panel.on_show!()
print panel.shown

# In a generic class too; and `weak` stays a name, called without parentheses.
class Box<T>
  value: T
  count = 0
  bump = -> weak -> @count += 1
const box = Box(value: 'x')
box.bump()()
print box.count
const call_weak = ->
  const weak = (n: Int) -> print(n + 1)
  weak 1
call_weak()
