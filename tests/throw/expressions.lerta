pick := (n: Int) ->
  case
    when n == 0 then 'zero'
    when n > 0 then 'positive'
    else throw ValueError(message: "negative: #{n}")
must := (s: String?) -> s ? throw ValueError(message: 'missing')
check := (s: String?) ->
  throw ValueError(message: 'nil given') if s == nil
  print s + '!'
fail := (): Int -> throw ValueError(message: 'always')
print pick(0)
print pick(5)
print must('x')
check 'ok'
print pick(-2)
