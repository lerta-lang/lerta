const pick = (n: Int): String ->
  case
    when n == 0 then 'zero'
    when n > 0 then 'positive'
    else throw "negative: #{n}"
const must = (s: String?): String -> s ? throw 'missing'
const check = (s: String?) ->
  throw 'nil given' if s == nil
  print s + '!'
const fail = (): Int -> throw 'always'
print pick(0)
print pick(5)
print must('x')
check('ok')
print pick(-2)
