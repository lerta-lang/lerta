const pick = (n: Int): String ->
  case
    when n == 0 then 'zero'
    when n > 0 then 'positive'
    else throw ValueError(message: "negative: #{n}")
const must = (s: String?): String -> s ? throw ValueError(message: 'missing')
const check = (s: String?) ->
  throw ValueError(message: 'nil given') if s == nil
  print s + '!'
const fail = (): Int -> throw ValueError(message: 'always')
print pick(0)
print pick(5)
print must('x')
check('ok')
print pick(-2)
