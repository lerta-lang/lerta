pick := (n: Int) ->
  case
    when n == 0 then 'zero'
    when n > 0 then 'positive'
    else throw ValueError("negative: #{n}")
must := (s: String?) -> s ? throw ValueError('missing')
check := (s: String?) ->
  throw ValueError('nil given') if s == nil
  print s + '!'
fail := (): Int -> throw ValueError('always')
print pick(0)
print pick(5)
print must('x')
check 'ok'
print pick(-2)
