# An exception that leaves a function that awaits settles its Promise with it, and an await of the
# Promise throws it again, each time; an exception that nothing awaits ends the program once its
# Promise is dropped.
import spawn from 'std:async'
import sleep from 'std:time'

struct Failure
  message: String

fail_after := (seconds: Float): Promise<Int> ->
  await sleep(seconds)
  throw Failure("failed after #{seconds}")

fail_at_once := (fail: Bool) ->
  throw Failure('failed at once') if fail
  await sleep(0)
  1

main := ->
  later := fail_after(0)
  for _ in 0...2
    try
      print await later
    catch e: Failure
      print "caught: #{e.message}"
  try
    print await fail_at_once(true)
  catch e: Failure
    print "caught: #{e.message}"
  try
    await sleep(-0.5)
  catch e: ValueError
    print "caught: #{e.message}"
  # A body may wait in a catch and in a finally; an exception that the finally sets aside meanwhile
  # goes on after it.
  try
    try
      await fail_after(0)
    catch e: Failure
      await sleep(0)
      print "caught after waiting: #{e.message}"
      throw Failure('thrown again')
    finally
      await sleep(0)
      print 'finally after waiting'
  catch e: Failure
    print "caught: #{e.message}"
  _ignored := fail_after(0)
  await sleep(0)
  print 'main done'

spawn main()
