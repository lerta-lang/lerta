# A function that awaits returns a Promise and runs at once, up to an await of a pending promise;
# the event loop resumes it after the top-level code, once the promise is settled.
import sleep from 'std:time'

const after = (seconds: Float, name: String) ->
  print "#{name} waits"
  await sleep(seconds)
  print "#{name} done"
  name

# The shorter sleep ends first, though it began later; equal sleeps end in the order they began.
const race = ->
  const slow = after(1, 'slow')
  const fast = after(0, 'fast')
  const also_fast = after(0, 'also fast')
  print "#{await slow}, #{await fast}, #{await also_fast}"

# A promise can be awaited again once settled, which gives its value without waiting.
const twice = (n: Int): Promise<Int> ->
  return n * 2 if n == 0
  await sleep(0)
  n * 2
const values = ->
  const settled = twice(0)
  print await settled
  const later = twice(4)
  print await later
  print await later

# Values of any type: nil, an interface value, a function, a Bool, and none.
interface Named
  name: String
struct Cat
  name: String
const maybe = (name: String): Promise<String?> ->
  await sleep(0)
  return nil if name == ''
  name
const pet = (): Promise<Named> ->
  await sleep(0)
  Cat(name: 'tom')
const adder = (n: Int): Promise<(Int) -> Int> ->
  await sleep(0)
  (x) -> x + n
const is_even = (n: Int) ->
  await sleep(0)
  n % 2 == 0
const nothing = (): Promise ->
  await sleep(0)
  print 'nothing'
const kinds = ->
  print (await maybe('')) ? 'nil'
  print (await pet()).name
  print (await adder(2))(3)
  print await is_even(4)
  await nothing()
  # Awaited for its effect only, its value unused.
  await twice(1)

# Promises held in an array, all waiting at once, then awaited in order.
const many = ->
  const waiting = [after(0, "#{n}") for n in 0...3]
  print [await each for each in waiting].join(' ')

# @ and what a function literal captures stay alive while the body waits.
class Counter
  count = 0
  bump = ->
    await sleep(0)
    @count += 1
const counting = ->
  const counter = Counter()
  const label = 'count'
  const show = ->
    await counter.bump()
    print "#{label} #{counter.count}"
  await show()
  # An await in a string belongs to the function around it, here a literal's.
  const describe = (n: Int) -> "twice #{n} is #{await twice(n)}"
  print await describe(3)

const main = ->
  await race()
  await values()
  await kinds()
  await many()
  await counting()

const _done = main()
print 'top-level code done'
