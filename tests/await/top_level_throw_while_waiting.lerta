# An exception that leaves the top-level code after an await ends the program at once, though an
# accept that nothing awaits would keep it waiting.
import listen_tcp from 'std:net'
import sleep from 'std:time'

accept_one := (port: Int) ->
  listener := listen_tcp('127.0.0.1', port)
  _socket := await listener.accept()

_accepting := accept_one(0)
await sleep(0)
print 'awaited'
throw ValueError('stopped while accepting')
