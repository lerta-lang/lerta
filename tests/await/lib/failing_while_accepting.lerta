# A module whose top-level code throws once it has waited, while an accept that nothing awaits
# would keep the program waiting.
import listen_tcp from 'std:net'
import sleep from 'std:time'

accept_one := (port: Int) ->
  listener := listen_tcp('127.0.0.1', port)
  _socket := await listener.accept()

_accepting := accept_one(0)
await sleep(0)
throw ValueError('failing while accepting')
