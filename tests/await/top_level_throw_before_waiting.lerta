# An exception that leaves the top-level code before its first await ends the program at once,
# though an accept that nothing awaits would keep it waiting.
import listen_tcp from 'std:net'
import sleep from 'std:time'

accept_one := (port: Int) ->
  listener := listen_tcp('127.0.0.1', port)
  _socket := await listener.accept()

stop := (when: Bool) -> throw ValueError(message: 'stopped before waiting') if when

_accepting := accept_one(0)
stop true
await sleep(0)
