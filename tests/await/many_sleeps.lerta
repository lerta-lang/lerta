# Many sleeps that end at the same time end in the order they began, and the event loop resumes
# each body that waits for one, then ends once none is left.
import sleep from 'std:time'

finished: Int[]
wait := (n: Int) ->
  await sleep(0)
  finished.push n

waiting := [wait(n) for n in 0..100]
await each for each in waiting
var in_order = finished.length == 100
for n in 0..finished.length
  in_order = in_order and finished[n] == n
print in_order
