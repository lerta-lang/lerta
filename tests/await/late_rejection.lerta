# A Promise dropped while still pending is held by its body, which ends the program once it rejects
# the Promise with an exception that nothing will take.
import sleep from 'std:time'

struct Late
  message: String

fail_later := (): Promise<Int> ->
  await sleep(0)
  print 'about to throw'
  throw Late(message: 'late')

start := ->
  _dropped := fail_later()
  print 'dropped while pending'

main := ->
  start()
  await sleep(0)
  print 'never printed'

_done := main()
