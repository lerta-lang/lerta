# The top-level code may await, as may that of a module it imports, which it waits for; the event
# loop runs the bodies that wait meanwhile, and the top-level values are released after it.
import name from './lib/settings'
import sleep from 'std:time'

increment := (n: Int) ->
  await sleep(0)
  n + 1

print "main: #{name}"
started := increment(0)
one := await started
print one
if one > 0
  two := await increment(one)
  print two
# In loops and in try blocks too.
for n in 0...2  # fmt: skip
  print await increment(n * 10)
struct Refused
  message: String
refuse := (): Promise<Int> ->
  await sleep(0)
  throw Refused(message: 'refused')
try
  print await refuse()
catch e: Refused
  print "caught: #{e.message}"
late := ->
  await sleep(0)
  print "late: #{name}"
_running := late()
print 'main: done'
