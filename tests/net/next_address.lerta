# A connect tries each address of the host in turn: localhost, which may give ::1 first, reaches a
# listener of 127.0.0.1 alone.
import connect_tcp, listen_tcp from 'std:net'

listener := listen_tcp('127.0.0.1')
connecting := connect_tcp('localhost', listener.port)
server := await listener.accept()
client := await connecting
await client.write("through localhost\n")
print await server.reader.read_line() else 'end'
