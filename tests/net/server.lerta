# A server serves each connection in a function of its own, which it does not await, so that the
# clients are served at once.
import all, spawn from 'std:async'
import connect_tcp, Listener, listen_tcp, Socket from 'std:net'

serve := (socket: Socket) ->
  try
    name := await socket.reader.read_line() ? ''
    await socket.write("hello, #{name}\n")
  catch error: IOError
    print error.message
  finally
    socket.close()

run_server := (listener: Listener, count: Int) ->
  spawn serve(await listener.accept()) for _ in 0...count

# Each client waits to send its name until all are connected, so the server must hold them all.
ask := (client: Socket, name: String) ->
  await client.write("#{name}\n")
  await client.reader.read_line() ? 'end'

listener := listen_tcp('localhost')
names := ['a', 'b', 'c']
server := run_server(listener, names.length)
clients := await all([connect_tcp('localhost', listener.port) for _ in names])
print reply for reply in await all([ask(client, name) for (client, name) in clients.zip(names)])
await server
