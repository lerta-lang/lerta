# Datagrams between two sockets on the loopback, over IPv4 and IPv6, by a numeric address and by
# a name, which the sends after the first take from the cache; a String, a Binary and an empty one.
import bind_udp from 'std:net'

for host in ['127.0.0.1', '::1']
  a := bind_udp(host)
  b := bind_udp(host)
  await a.send('hello', host, b.port)
  datagram := await b.receive()
  print "#{datagram.data.text()!} #{datagram.host} #{datagram.port == a.port}"
  await b.send(b'bytes', host, a.port)
  print (await a.receive()).data.text()!
  await a.send('', host, b.port)
  print (await b.receive()).data.length
  a.close()
  b.close()

a := bind_udp('localhost')
b := bind_udp('localhost')
await a.send("#{i}", 'localhost', b.port) for i in 0..3
print (await b.receive()).data.text()! for _ in 0..3
