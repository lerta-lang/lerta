# A socket closes once nothing holds it, which its peer reads as the end; a listener and a socket
# left open do not keep the program running.
import connect_tcp, listen_tcp from 'std:net'

listener := listen_tcp('127.0.0.1')
connecting := connect_tcp('127.0.0.1', listener.port)

# The server's socket is released as the function returns.
greet := ->
  socket := await listener.accept()
  await socket.write("hello\n")

await greet()
client := await connecting
print await client.reader.read_line() ? 'end'
print await client.reader.read_line() ? 'end'

# Left open.
_other := await connect_tcp('127.0.0.1', listener.port)
print 'done'
