# The end is read again after it has been read once, and a write after `end` fails.
import connect_tcp, listen_tcp from 'std:net'

listener := listen_tcp('127.0.0.1')
port := listener.port
connecting := connect_tcp('127.0.0.1', port)
server := await listener.accept()
client := await connecting
await client.end()
print await server.reader.read_line() ? 'end'
print await server.reader.read_line() ? 'end'
try
  await client.write('late')
catch error: IOError
  print error.message.replace(":#{port}", ':PORT')
