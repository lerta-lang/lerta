# A Socket is a Writer, whose end its peer reads as the end, and which fails a write after it.
import Writer from 'std:io'
import connect_tcp, listen_tcp from 'std:net'

send := (writer: Writer) ->
  await writer.write('through ')
  await writer.write(b"a Writer\n")
  await writer.end()
  await writer.end()
  try
    await writer.write('late')
  catch _: IOError
    print 'a write after the end fails'

listener := listen_tcp('127.0.0.1')
connecting := connect_tcp('127.0.0.1', listener.port)
server := await listener.accept()
await send(await connecting)
print await server.reader.read_line() else 'end'
print await server.reader.read_line() else 'end'
