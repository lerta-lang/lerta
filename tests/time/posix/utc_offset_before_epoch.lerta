# Times before the epoch, which Windows does not convert. New York's summer time of 1969 started at
# 1969-04-27T07:00:00Z: the time half a second before is taken down to the second before, still
# before it. A rule of TZ itself, as `EST5EDT,M3.2.0,M11.1.0`, starts summer time only from 1970, so
# the zone is the one of that name that the system holds.
import run from 'std:process'

times := ['-21488401', '-21488400.5', '-21488400']
await run('print_utc_offset', times..., env: { 'TZ': 'EST5EDT' })
