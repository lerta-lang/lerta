# A sleep longer than an Int of milliseconds holds waits as long as one can: it has not ended after
# a while, and is cancelled then.
import INFINITY from 'std:math'
import sleep from 'std:time'

for seconds in [INFINITY, 1e300]
  sleeping := sleep(seconds)
  await sleep(0.05)
  sleeping.cancel()
  try
    await sleeping
    print 'ended'
  catch _: CancelledError
    print 'cancelled'
