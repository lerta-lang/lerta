# The Unix time in seconds, with a fraction, which a sleep moves on by at least its time; a sleep
# takes a fraction of a second too.
import sleep, time from 'std:time'

const start = time()
print start > 1.7e9
await sleep(0.05)
print time() - start >= 0.05
await sleep(0.0001)
await sleep(0)
print 'done'
