# The Unix time in seconds, with a fraction, which a sleep moves on by at least its time, as it
# does the monotonic clock, which never goes back; a sleep takes a fraction of a second too.
import monotonic, sleep, time from 'std:time'

start := time()
start_monotonic := monotonic()
print start > 1.7e9
await sleep(0.05)
print time() - start >= 0.05
print monotonic() - start_monotonic >= 0.05
await sleep(0.0001)
await sleep(0)
print 'done'
