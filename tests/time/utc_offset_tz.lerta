# The offset follows TZ, and the time: New York's summer time starts at 2026-03-08T07:00:00Z, after
# 2026-01-01T00:00:00Z and before 2026-07-01T00:00:00Z. At the epoch, it is still 1969 in New York.
import run from 'std:process'

times := ['0', '1767225600', '1772953199', '1772953200', '1782864000']
for tz in ['UTC0', 'JST-9', 'EST5EDT']
  print tz
  await run('print_utc_offset', times..., env: { 'TZ': tz })
