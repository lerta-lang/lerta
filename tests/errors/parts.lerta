# An error in a method's body, or in the initializers of an instance of a generic class, ends that
# part; what needs it later is not checked, and an object whose initializers have one is not
# checked to satisfy its interface.
interface Named
  name: String

class Counter
  count := 0
  next := -> @count + 'a'
  doubled := -> @next() * 2

class Box<T>
  args
    value: T
  twice := @value + nil
  get := -> @twice

struct Label: Named
  name := missing

var total = 1 + nil
total = 2
read_total := -> total
print read_total()
print Counter().doubled()
print Box(value: 1).get()
print Box(value: 1).twice
print Label().name
print 1 + true
