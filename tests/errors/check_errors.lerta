# An error ends the part of the program it is in: a top-level statement, a function's body, the
# initializers of a class or struct, or an instance of a generic function. What needs the type of
# a part with an error is not checked, and has no error of its own.
const x: Int = 'a'
const y = x + 1
print y

const annotated = (n: Int): Int -> n + 'a'
print annotated(1) + 1

const inferred = (n: Int) -> undefined_name
const caller = -> inferred(1) + 1
print caller()

struct Point
  x = missing
print Point().x

const first = <T>(items: T[]) -> items[0] + true
print first([1])
print first([1])

for i in [1]
  const unused = i
  print 1 + nil

const fine = ->
  const unused = 1
  print 2
fine()
