# An error ends the part of the program it is in: a top-level statement, a function's body, the
# initializers of a class or struct, or an instance of a generic function. What needs the type of
# a part with an error is not checked, and has no error of its own.
x: Int = 'a'
y := x + 1
print y

annotated := (n: Int): Int -> n + 'a'
print annotated(1) + 1

inferred := (n: Int) -> undefined_name
caller := -> inferred(1) + 1
print caller()

struct Point
  x = missing
print Point().x

first := <T>(items: T[]) -> items[0] + true
print first([1])
print first([1])

for i in [1]
  unused := i
  print 1 + nil

fine := ->
  unused := 1
  print 2
fine()
