# What test/cli checks the line tables of, built with --source-lines: a method and a function
# literal, each with a body on lines of its own.
struct Counter
  step: Int
  next = (n: Int) -> n + @step

const apply = (f: (Int) -> Int, n: Int) -> f(n)

const xs = [1, 2]
const run = ->
  const get = (i: Int) ->
    const item = xs[i]
    item
  apply get, 1
print run()
print Counter(step: 3).next(4)
