# An exception that leaves a function that awaits goes on, where its Promise is awaited, with its
# trace: the functions that awaited each other, and the awaits it went through.
import sleep from 'std:time'

struct Failure: Error

const fetch = (): Promise<Int> ->
  await sleep(0)
  throw Failure(message: 'fetch failed')

const load = ->
  const value = await fetch()
  value + 1

const main = ->
  const loaded = load()
  try
    await loaded
  catch e
    print "first await: #{e.message}"
  await loaded

const _done = main()
