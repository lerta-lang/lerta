# A deinit that throws and catches an exception of its own, as an exception going through releases
# its object, leaves the trace of the one going through as it was.
struct Failure: Error

const inner = -> throw Failure(message: 'inner')

class Resource
  deinit = ->
    try
      inner()
    catch e
      print "deinit caught #{e.message}"

const use = (r: Resource) -> throw Failure(message: 'outer')

const run = -> use(Resource())

run()
