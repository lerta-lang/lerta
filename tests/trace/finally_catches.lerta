# A finally block that throws and catches an exception of its own, while one goes through it, leaves
# the trace of the one going through as it was.
struct Failure: Error

const inner = -> throw Failure(message: 'inner')
const outer = -> throw Failure(message: 'outer')

const run = ->
  try
    outer()
  finally
    try
      inner()
    catch e
      print "finally caught #{e.message}"

run()
