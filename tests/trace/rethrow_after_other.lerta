# An exception thrown and caught between the catch and the throw again replaces the trace: the
# caught one, thrown again, starts a trace of its own rather than going on with the other's.
struct Failure: Error

fail := (message: String) -> throw Failure(message)

retry := ->
  try
    fail 'first'
  catch e
    try
      fail 'second'
    catch other
      print "caught #{other.message}"
    throw e

retry()
