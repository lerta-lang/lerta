# Each new exception starts its own trace, even where it takes the place of one that was caught and
# freed, which the allocator may give it.
struct Failure: Error

deep := (n: Int): void ->
  throw Failure("at #{n}") if n == 0
  deep n - 1

shallow := -> throw Failure('shallow')

for _ in 0...3
  try
    deep 3
  catch e
    print "caught #{e.message}"
shallow()
