# A longer trace keeps the 32 entries nearest to the throw and the 32 outermost, in order, and tells
# how many it leaves out between them.
struct Failure: Error

odd := (n: Int): void ->
  throw Failure('bottom') if n == 0
  even n - 1

even := (n: Int): void ->
  throw Failure('bottom') if n == 0
  odd n - 1

# 61 levels of odd and even below 10 of down: the ring of the outermost holds both.
down := (n: Int): void ->
  return odd(60) if n == 0
  down n - 1

down 9
