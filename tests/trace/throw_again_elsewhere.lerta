# A throw of an exception that is not the one its catch has taken starts a new trace, even of an
# object thrown before: kept from a catch, or shared as a top-level value.
struct Failure: Error

shared := Failure('shared')
fail := -> throw shared
throw_it := (e: Error) -> throw e

try
  fail()
catch e
  print "caught #{e.message}"
throw_it shared
