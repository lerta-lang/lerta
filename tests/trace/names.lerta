# A trace names a function by its name, a method by its type and its name, a generic one by the
# type it is for, and a function literal by the function it is in.
struct Failure: Error

class Box<T>
  item: T
  open = (check: (T) -> void) -> check(@item)

extend String
  shout = -> Box(item: @).open((text) -> throw Failure(message: "#{text}!"))

class Reader
  read = (text: String) -> text.shout()

const first = <T>(items: T[], f: (T) -> void) -> f(items[0])

first ['hi'], (text) -> Reader().read(text)
