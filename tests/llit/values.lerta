import decode_llit from '../../compiler/llit'
import Codable from 'std:codable'
import encode_json from 'std:json'

# A text of llit read as values of each type, shown as JSON.
enum Color
  RED
  GREEN

struct Target
  ssh: String?
  jobs := default 1

struct Settings
  name: String
  ratio: Float
  offset: Int8
  big: UInt64
  enabled: Bool
  color: Color
  letter: Char
  data: Binary
  pair: (Int, String)
  tags: String[]
  ids: Set<Int>
  by_id: Map<Int, String>
  targets: Map<String, Target>
  nothing: Int?

show := <T: Codable>(text: String) -> print(encode_json(decode_llit<T>(text, 'settings.llit')))

show<Settings>("""
  # A comment.
  name: 'all'
  ratio: -1.5
  offset: -8
  big: 4000000000
  enabled: true
  color: GREEN
  letter: 'é'
  data: b'ab'
  pair: (1, 'one')
  tags: ['a', 'b']
  ids: [3, 1]
  by_id: { 1: 'one' }
  targets:
    'windows-amd64': { ssh: 'ts1@windows' }
    'linux-386':
      jobs: 2
  nothing: nil
  """)
show<Target>('')
show<Int[]>("""
  1
  2
  """)
show<(Int, Float, Int, Float)>('(0x10, 0x10, -9223372036854775808, -0)')
show<Map<String, Int>>('Map()')
show<(Int | String | Target)[]>("""
  1
  'one'
  { ssh: 'host' }
  """)
show<Target>("""
  # Only a comment.

  """)
show<Target>('ssh: "a", jobs: 3')
show<(Float, Float32)>('(9223372036854775808, 1.5)')
