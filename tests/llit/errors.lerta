import decode_llit, LlitError from '../../compiler/llit'
import Codable from 'std:codable'

# Each error names where it is in the text.
enum Color
  RED
  GREEN

struct Point
  x: Int8
  y: Int8 = 0

failing := <T: Codable>(text: String) ->
  try
    _value := decode_llit<T>(text, 'bad.llit')
    print 'no error'
  catch error: LlitError
    print error.message

failing<Point>('x: ')
failing<Point>('x: 1 + 2')
failing<Point>('x: f()')
failing<Point>('x: 300')
failing<Point>("x: 'one'")
failing<Point>('y: 1')
failing<Point>("""
  x: 1
  x: 2
  """)
failing<Point>("""
  x: 1
  z: 2
  """)
failing<String>('"a#{1}"')
failing<Char>("'ab'")
failing<Color>('BLUE')
failing<(Int, Int)>('(1, 2, 3)')
failing<Map<String, Int>>('{ 1: 2 }')
failing<Map<String, Int>>("""
  'a': 1
  'a': 2
  """)
failing<Set<Int>>('[1, 1]')
failing<Int[]>("""
  1
  2
  )
  """)
failing<Int>('9223372036854775808')
failing<Float32>('1e39')
failing<UInt64>('-1')
failing<UInt64>('18446744073709551616')
failing<UInt64>('0x10000000000000000')
failing<UInt64>('1.5')
failing<Binary>('b"a#{1}"')
failing<Binary>("'a'")
failing<Int>('nil')
failing<Color>("'RED'")
failing<Map<String, Point>>("""
  'a':
    x: 1
    w: 2
  """)
failing<Map<Int, Int>>('{ 1: 2, 1: 3 }')
failing<Int?>('')
failing<Int[]>('(1, 2)')
failing<(Int | String)[]>('[true]')
failing<Map<String, Int>>('Map<String, Int>()')
failing<Float>('0x10000000000000000')
failing<Point>('x: 1.5')
failing<Map<String, Int>>("Map({ 'a': 1 })")
failing<Map<String, (Int, Int)[]>>("""
  'a': [(1, 2), (3, 4, 5)]
  """)
failing<(Int, Int)>("'x'")
failing<Point>("""
  x: 1
    y: 2
  """)
failing<Point>("x: 'a")
failing<Bool>('1')
failing<Set<Int>>('(1, 2)')
failing<Map<String, Int>>('{ "a#{1}": 1 }')
failing<Point>('  x: 1')
