# An Encoder that writes each call it is given as a word, for the checks of what the generated code
# calls.
export class Trace
  var calls: String[] = []

  write_nil := -> @calls.push('nil')
  write_bool := (value: Bool) -> @calls.push("bool:#{value}")
  write_int := (value: Int) -> @calls.push("int:#{value}")
  write_uint64 := (value: UInt64) -> @calls.push("uint64:#{value}")
  write_float := (value: Float) -> @calls.push("float:#{value}")
  write_float32 := (value: Float32) -> @calls.push("float32:#{value}")
  write_string := (value: String) -> @calls.push("string:#{value}")
  write_binary := (value: Binary) -> @calls.push("binary:#{value.length}")
  write_char := (value: Char) -> @calls.push("char:#{value}")
  write_member := (enum_name: String, member: String) ->
    @calls.push "member:#{enum_name}.#{member}"
  begin_array := -> @calls.push('[')
  next_item := -> @calls.push(',')
  end_array := -> @calls.push(']')
  begin_tuple := (count: Int) -> @calls.push("(#{count}")
  end_tuple := -> @calls.push(')')
  begin_set := -> @calls.push('set[')
  end_set := -> @calls.push(']')
  begin_entries := -> @calls.push('entries[')
  next_entry := -> @calls.push('entry(')
  entry_value := -> @calls.push(':')
  end_entry := -> @calls.push(')')
  end_entries := -> @calls.push(']')
  begin_map := -> @calls.push('map{')
  write_key := (key: String) -> @calls.push("key:#{key}")
  end_map := -> @calls.push('}')
  begin_record := -> @calls.push('{')
  write_field := (name: String) -> @calls.push("field:#{name}")
  end_record := -> @calls.push('}')
  enter := (address: Int) -> @calls.push('enter')
  leave := -> @calls.push('leave')

  text := -> @calls.join(' ')
