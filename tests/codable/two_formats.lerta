# Each format reads and writes a type through its own methods, though another format reads and
# writes the same type in the program: the type's function, and those of the types it holds.
import decode, encode from 'std:codable'
import decode_json, encode_json from 'std:json'
import Script from './lib/script'
import Trace from './lib/trace'

struct Point
  x: Int
  y: Int

struct Line
  from: Point
  to: Point

show := (line: Line) -> "#{line.from.x} #{line.from.y} #{line.to.x} #{line.to.y}"

print show(decode_json<Line>('{"from":{"x":1,"y":2},"to":{"x":3,"y":4}}'))
words := '{ field:from { field:x int:5 field:y int:6 } field:to { field:x int:7 field:y int:8 } }'
print show(decode<Line>(Script(words: words.split(' '))))
line := Line(from: { x: 1, y: 2 }, to: { x: 3, y: 4 })
print encode_json(line)
trace := Trace()
encode trace, line
print trace.text()
