import Codable, encode from 'std:codable'
import Trace from './lib/trace'

# The generated code writes each type through the methods of the encoder that it is given.
enum Color
  RED
  GREEN

struct Point
  x: Int8
  label: String?
  color: Color

class Node
  name: String
  children: Node[]

show := <T: Codable>(value: T) ->
  trace := Trace()
  encode trace, value
  print trace.text()

show [1, 2]
show Point(x: 1, label: nil, color: GREEN)
show (2.5, true, b'ab')
show { 'a': 1 }
show { id: 7 }
show Node(name: 'root', children: [Node(name: 'leaf', children: [])])
values: (Int | String)[] = [1, 'one']
show values
# Fields that camel case writes as one key are data, which only std:json's camel case refuses.
show { a_b: 1, aB: 2 }
big: UInt64 = 4000000000
show (big, 1.5.to_float32())
none: Int? = nil
show none
