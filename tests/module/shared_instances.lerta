# Each module emits the instances that it uses, which the linker keeps one of: those that two
# modules use, those that another instance uses, those reached by an entry for defaults, and those
# that hold lambdas.
import boxed, repeat from './lib/shared_generic'
import user_box, user_repeat from './lib/shared_user'

print boxed('from the entry').value
print user_box()
print repeat(1).length
print user_repeat().length
print repeat('a', 3).length
