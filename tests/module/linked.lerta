# Each module is an LLVM module of its own: this one reads the fields of another's class, and the
# instance of the other's generic function, which that module emits, takes this one's class.
import Counter, each_twice from './lib/linked'

class Item
  name: String
  deinit = -> print("dropped #{@name}")

const counter = Counter(count: 0)
const count = (item: Item) ->
  counter.count += 1
  print item.name
each_twice [Item(name: 'a')], count
print counter.count
