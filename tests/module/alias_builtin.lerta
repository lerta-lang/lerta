# A name imported under a builtin's name hides it, as a declaration does: an enum, an interface, a
# type, a type alias, and a function called where Set() would make a set.
import Color as Iter, Count as never, Named as Map from './lib/kinds'
import pair as Set from './lib/numbers'
import Token as String from './lib/word'

const c: Iter = Iter.red
print c

struct Cat: Map
  name = 'tama'

const m: Map = Cat()
print m.name

const t: String = String(text: 'a')
print t.text

const n: never = 1
print n

print Set(4)
