# Names of other modules: a function used as a value, a value narrowed in a function, and a value
# that holds a function, called.
import origin from './lib/geometry'
import maybe_point from './lib/points'
import add_two from './lib/adders'

const make = origin
print make().x
const x_of_maybe = -> maybe_point then maybe_point.x else -1
print x_of_maybe()
print add_two(1)
const adds_two = -> add_two(5)
print adds_two()
if maybe_point
  const h = -> maybe_point.x
  print h()
const captures_import = ->
  if maybe_point
    const k = -> maybe_point.x + 1
    k()
  else
    0
print captures_import()
