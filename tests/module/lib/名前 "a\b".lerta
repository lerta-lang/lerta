export struct Box
  value: Int
  doubled = -> @value * 2

export class Resource
  name: String
  deinit = -> print("closing #{@name}")

export enum Color
  RED
  GREEN

export interface Named
  name: String

export const label = 'box'

var count = 0

export const calls = -> count

export const describe = (box: Box) -> "#{label} #{box.value}"

export const first = <T>(items: T[]) -> items[0]

export const counter = ->
  var n = 0
  ->
    n += 1
    count += 1
    n

extend Int
  tripled = -> @ * 3

export const greet = (name: String, greeting = 'hi') -> "#{greeting} #{name}"

export struct Pair<T>
  left: T
  right: T
  swapped = -> Pair(left: @right, right: @left)
