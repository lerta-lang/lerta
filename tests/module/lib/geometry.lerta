import announce from './log'

export struct Point
  x: Int
  y: Int
  norm1 = -> abs(@x) + abs(@y)

export class Circle(center: Point, r: Int)

export type Shape = Point | Circle

const abs = (n: Int) ->
  return -n if n < 0
  n

export const describe = (s: Shape) ->
  case s
    when Point then "point #{s.x},#{s.y}"
    when Circle then "circle r=#{s.r}"

export const origin = -> Point(x: 0, y: 0)

announce 'geometry'
