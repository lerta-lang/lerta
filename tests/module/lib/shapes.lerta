export struct Point(x: Int, y: Int)

export ORIGIN := Point(x: 0, y: 0)

export distance := (a: Point, b: Point) -> (a.x - b.x).abs_value() + (a.y - b.y).abs_value()

export largest := <T: Comparable>(a: T, b: T) -> a < b then b else a

export enum Color
  RED
  GREEN

export interface Shaped
  area: () -> Int

extend Int
  abs_value = -> @ < 0 then -@ else @
