export initial := (): Char -> 'a'
export class Bag
  items: Int[]
  iter = (): Iter<Int> -> (x * 10 for x in @items)
export bag := -> Bag(items: [1, 2])
export BAG := Bag(items: [3])
export struct Scale(by = default 1)
export total := (first: Int, rest: Int..., options: Scale) -> (first + rest.sum()) * options.by
