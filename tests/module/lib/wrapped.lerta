export const initial = (): Char -> 'a'
export class Bag
  items: Int[]
  iter = (): Iter<Int> -> (x * 10 for x in @items)
export const bag = -> Bag(items: [1, 2])
export const BAG = Bag(items: [3])
export struct Scale(by = default 1)
export const total = (first: Int, rest: Int..., options: Scale) -> (first + rest.sum()) * options.by
