import keywords, limit, names as table, greeting, add_name from './lib/tables'

is_keyword := (word: String): Bool -> keywords.any((keyword) -> keyword == word)

print is_keyword('else')
print limit * 2
add_name 'b'
print table['b'] else 0
print table.length
print greeting else '-'
keywords.push 'while'
print keywords.join(',')
