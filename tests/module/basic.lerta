import Point, Circle, Shape, describe, origin from './lib/geometry'
import announce from './lib/log'

const abs = (n: Int) -> 'mine'

announce 'main'
const shapes: Shape[] = [Point(x: 3, y: -4), Circle(center: origin(), r: 2)]
print describe(s) for s in shapes
const p = Point(x: -1, y: 2)
print p.norm1()
print abs(1)
const s: Shape = Circle(center: p, r: 5)
print s is Circle
print case s
  when Point then 'p'
  when Circle then 'c'
