# Symbols name a module by its path, which may hold characters that they escape.
import
  Box, calls, Color, counter, describe, first, greet, label, Named, Pair, Resource
from './lib/名前 "a\b"'

box := Box(value: 4)
print describe(box)
print box.doubled()
print label
print first(['a', 'b'])
print first([Color.GREEN])
print 5.tripled()
describing := describe
print describing(Box(value: 1))  # fmt: skip
next := counter()
next()
print next()
print calls()
print greet('you')
print Pair(left: 'a', right: 'b').swapped().left
named: Named = Resource(name: 'file')
print named.name
