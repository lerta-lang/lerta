# `import 'module' as name` gives the exports of the module as `name.export`: values, functions,
# types, enums and interfaces, alongside names imported from the same module.
import './lib/shapes' as geo
import sqrt from 'std:math'
import 'std:math' as math

p: geo.Point = geo.Point(x: 3, y: -4)  # fmt: skip
print geo.distance(p, geo.ORIGIN)
print geo.largest(2, 5)
print geo.largest<String>('a', 'b')
c := geo.Color.GREEN
print c
colors: geo.Color[] = [geo.Color.RED]  # fmt: skip
print colors
print [math.sqrt(16.0), sqrt(9.0)]
print math.floor(2.5)
struct Square
  side: Int
extend Square
  area = -> @side * @side
s: geo.Shaped = Square(side: 3)
print s.area()
show := <T: geo.Shaped>(x: T) -> x.area()
print show(Square(side: 2))

# A local of the name hides the module, as it hides any other name.
shadowed := (geo: Int) -> geo + 1
print shadowed(1)

# An extend of a type, a case pattern, a function as a value.
extend geo.Point
  sum = -> @x + @y
print p.sum()
label := (color: geo.Color) ->
  case color
    when geo.Color.RED then 'red'  # fmt: skip
    else 'other'
print label(geo.Color.RED)  # fmt: skip
measure := geo.distance
print measure(p, geo.ORIGIN)

# Members of a qualified value, and qualified types in other places.
print [geo.ORIGIN.x, geo.ORIGIN.sum()]
type Spot = geo.Point
maybe: geo.Point? = nil
pick := (q: geo.Point): Int -> q.y  # fmt: skip
spot: Spot = p  # fmt: skip
print geo.largest<String>('x', 'y')
print maybe == nil
print pick(spot)
points: geo.Point[] = [p]  # fmt: skip
print points.length
