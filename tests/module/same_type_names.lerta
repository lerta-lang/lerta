import Token, lex, hidden from './lib/lex_token'
import Token as ParseToken, hidden as other_hidden from './lib/parse_token'
import stdout as out from 'std:io'

struct Hidden
  n: Int

type Any = Token | ParseToken

describe := (t: Any) ->
  case t  # fmt: skip
    when Token then t.show()
    when ParseToken then t.show()

print describe(lex('a'))
print describe(ParseToken(3))
items: Any[] = [ParseToken(1), lex('b')]
print items[0] is ParseToken
print items[1] is ParseToken
print hidden() + other_hidden() + Hidden(4).n
await out.write("done\n")
