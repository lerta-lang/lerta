# `name.export` is the export, also where the checker makes a call of it: of the `to_string()` of a
# Char that `+` appends, and of the `iter()` of an Iterable that `for` goes through; and a call of
# it packs and gathers its arguments as a call of the name does.
import './lib/wrapped' as w

print 'x' + w.initial()
var text = 'y'
text += w.initial()
print text
print x for x in w.bag()
print [x + 1 for x in w.BAG]
print [w.total(1), w.total(1, 2, 3, by: 10)]
