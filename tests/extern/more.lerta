import float_text, exit_with from './lib/conversions'
import float_text as as_text from './lib/conversions'

extern lerta_string_equals as equal: (String, String) -> Bool
extern lerta_binary_get as byte_at: (Binary, Int) -> Byte

print equal('a' + 'b', 'ab')
print byte_at('A'.binary, 0).to_int()
float_text(5.0)
print as_text(6.0)
print case 'x'
  when 'x' then 'matched'
  else 'no'
exit_with(0)
print 'not reached'
