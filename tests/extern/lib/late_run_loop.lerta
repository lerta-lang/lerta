# Loads another library after its first wait, and CoreFoundation after its second, through
# late_run_loop.c, which test/cli/extern.lerta links, and has the main run loop run a block during a
# later sleep: 1 when it ran.
import sleep from 'std:time'

extern load_other: () -> void
extern load_and_post: () -> void
extern block_ran: () -> Int

await sleep(0.01)
load_other()
await sleep(0.01)
load_and_post()
await sleep(0.2)
print block_ran()
