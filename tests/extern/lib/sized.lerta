# Sized integers given to C functions and taken from them, as their C types (see sized.c).
extern negate8: (Int8) -> Int8
extern half16: (Int16) -> Int16
extern add32: (Int32, Int32) -> Int32
extern top16: () -> UInt16
extern top32: () -> UInt32
extern top64: () -> UInt64
extern widen8: (Int8) -> Int
extern widen_u16: (UInt16) -> Int
extern narrow16: (Int16) -> Int
extern widen_u32: (UInt32) -> UInt64

print [negate8(-127).to_int(), half16(-30000).to_int(), add32(-2147483647, -1).to_int()]
print [top16().to_int(), top32().to_int(), widen8(-128), widen_u16(65535)]
print top64().to_string()
print [narrow16(-32768), widen_u32(4294967295).to_int(), add32(2147483647, -2147483647).to_int()]
