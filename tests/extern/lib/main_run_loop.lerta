# Has the main run loop run a block and a timer during a sleep, which test/cli/extern.lerta links
# from main_run_loop.m: 3 when both ran on the main thread. It ends though a timer that repeats is
# left on the run loop.
import sleep from 'std:time'

extern schedule_on_main: () -> void
extern ran_on_main: () -> Int

schedule_on_main()
await sleep(0.5)
print ran_on_main()
