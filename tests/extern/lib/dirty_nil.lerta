# Compares nils that hold different values, from a C function of its own, which test/cli.lerta links
# from dirty_nil.c.
extern dirty_nil: (Int) -> Int?

const clean: Int? = nil
print "#{dirty_nil(7) == clean} #{clean == dirty_nil(7)} #{dirty_nil(7) == dirty_nil(8)}"
print "#{dirty_nil(7) != dirty_nil(8)} #{dirty_nil(7) == 7}"
