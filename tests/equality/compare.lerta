# A class or struct that has its own compare orders by it, and its == is compare's EQUAL; the
# numbers order by their builtin compare, and the builtin types have equals and hash.
struct Version
  major: Int
  minor: Int
  compare := (other: Version) ->
    return @major.compare(other.major) if @major != other.major
    @minor.compare other.minor

a := Version(major: 1, minor: 2)
b := Version(major: 1, minor: 10)
print a < b
print a <= b
print a > b
print a >= b
print a == { major: 1, minor: 2 }
print a != b

largest := <T: Comparable>(xs: T[]) ->
  var best = xs[0]
  for x in xs
    best = x if x > best
  best
print largest([3, 9, 2])
print largest([1.5, -2.0])
print largest([a, b]).minor

print 2.compare(3) == LESS
print 3.0.compare(3.0) == EQUAL
print 255.to_byte()!.compare(1.to_byte()!) == GREATER
print 'a'.equals('a')
print 'a'.hash() == 'a'.hash()
print 1.equals(2)

same := <T: Equatable>(x: T, y: T) -> x.equals(y)
print same(true, true)
print same(a, Version(major: 1, minor: 2))

versions := [b, a, Version(major: 0, minor: 9)]
print "#{v.major}.#{v.minor}" for v in versions.sorted((x, y) -> x.compare(y))
