# The own equality of the types of another module, and of an instance of a generic one; a type
# whose own compare gives its equals, called directly; and `>` through a Comparable bound.
import Box, Rank from './lib/ranks'

print Rank(n: 1) < Rank(n: 2)
print Rank(n: 1) == Rank(n: 1)
print Set([Rank(n: 1), Rank(n: 1)]).length
print Box<String>(v: 1) == Box<String>(v: 1)
print Set([Box<String>(v: 1), Box<String>(v: 1)]).length
print Rank(n: 3).equals(Rank(n: 3))
print Rank(n: 3).hash()
largest := <T: Comparable>(xs: T[]) ->
  var best = xs[0]
  for x in xs
    best = x if x > best
  best
print largest([Rank(n: 2), Rank(n: 5), Rank(n: 1)]).n
