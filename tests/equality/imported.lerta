# The own equality of the types of another module, and of an instance of a generic one; a type
# whose own compare gives its equals, called directly; and `>` through a Comparable bound.
import Box, Rank from './lib/ranks'

print Rank(1) < { n: 2 }
print Rank(1) == { n: 1 }
print Set([Rank(1), Rank(1)]).length
print Box<String>(1) == Box<String>(1)
print Set([Box<String>(1), Box<String>(1)]).length
print Rank(3).equals({ n: 3 })
print Rank(3).hash()
largest := <T: Comparable>(xs: T[]) ->
  var best = xs[0]
  for x in xs
    best = x if x > best
  best
print largest([Rank(2), Rank(5), Rank(1)]).n
