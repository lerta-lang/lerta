# A union satisfies Equatable and Hashable by the equals and hash that == and map keys give it,
# though its members' own are each of their own type.
class A
  args
    n: Int
  equals := (other: A) -> @n == other.n
  hash := -> @n

class B
  args
    n: Int

same := <T: Equatable>(a: T, b: T) -> a.equals(b)
hashes_alike := <T: Hashable>(a: T, b: T) -> a.hash() == b.hash()

u: A | B = A(1)
w: A | B = A(1)
b: A | B = B(1)
print same(u, w)
print same(u, b)
print hashes_alike(u, w)
print hashes_alike(u, A(2))
print u.equals(w)
print u.hash() == A(1).hash()
print Set<A | B>([u, w, b]).length

# Members without equals of their own.
v: A | Int = 3
print same(v, 3)
print same(v, 4)
print hashes_alike(v, 3)

# Members with equals and hash of their own, each of its own type.
class C
  args
    n: Int
  equals := (other: C) -> @n == other.n
  hash := -> @n

x: A | C = C(5)
print same(x, C(5))
print same(x, A(5))
counts: Map<A | C, Int> = { A(1): 1, C(1): 2 }
print counts[C(1)]!
print counts[A(1)]!
