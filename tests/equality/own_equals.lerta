# A class or struct that has its own equals compares by it, as a whole and as a part of a struct,
# an array or an optional value; a class without one compares as the same object.
class Name
  text: String
  note: String
  equals = (other: Name) -> @text == other.text
  hash = -> @text.hash()

class Plain(text: String)

struct Tagged(name: Name, count: Int)

print Name(text: 'Ann', note: '') == Name(text: 'Ann', note: 'again')
print Name(text: 'Ann', note: '') != Name(text: 'Bob', note: '')
print Plain(text: 'a') == Plain(text: 'a')
print
  Tagged(name: Name(text: 'a', note: ''), count: 1) == Tagged(
    name: Name(text: 'a', note: 'n')
    count: 1
  )
print [Name(text: 'a', note: '')] == [Name(text: 'a', note: 'n')]
const maybe: Name? = Name(text: 'x', note: '')
print maybe == Name(text: 'x', note: 'n')
const names =
  Set([Name(text: 'a', note: ''), Name(text: 'a', note: 'n'), Name(text: 'b', note: '')])
print names.length
const counts: Map<Name, Int>
counts[Name(text: 'k', note: '')] = 1
print counts[Name(text: 'k', note: 'n')] ? 0
print Name(text: 'q', note: '').equals(Name(text: 'q', note: 'n'))
