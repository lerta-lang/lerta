# Every type that == compares has equals, and every one that can be a map key has hash, so they
# satisfy Equatable and Hashable; numbers and Strings have compare, and order by it.
struct Point(x: Int)

class Node(n: Int)

enum Color
  RED
  GREEN

alike := <T: Hashable>(a: T, b: T) -> a.equals(b) and a.hash() == b.hash()
print alike(Point(x: 1), Point(x: 1))
node := Node(n: 1)
print alike(node, node)
print alike(Node(n: 1), Node(n: 1))
print alike((1, 'a'), (1, 'a'))
print alike([1, 2], [1, 2])
print alike(Color.RED, Color.RED)
print alike('ab'.binary, 'ab'.binary)

print 'a' < 'b'
print 'b' <= 'a'
print 'ab' > 'a'
print 'a' >= 'a'
largest := <T: Comparable>(xs: T[]) ->
  var best = xs[0]
  for x in xs
    best = x if x > best
  best
print largest(['b', 'c', 'a'])
print 65535.to_uint16()!.compare(1.to_uint16()!)
print -1.to_int8()!.compare(1.to_int8()!)
print -0.0.compare(0.0)
