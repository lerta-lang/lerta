# A struct whose own compare gives its == is a map key with its own hash.
struct Version
  major: Int
  compare = (other: Version) -> @major.compare(other.major)
  hash = -> @major

names: Map<Version, String>
names[{ major: 1 }] = 'one'
names[{ major: 1 }] = 'uno'
print names.length
print names[{ major: 1 }] ? '-'
