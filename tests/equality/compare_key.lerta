# A struct whose own compare gives its == is a map key with its own hash.
struct Version
  major: Int
  compare = (other: Version) -> @major.compare(other.major)
  hash = -> @major

const names = Map<Version, String>()
names[Version(major: 1)] = 'one'
names[Version(major: 1)] = 'uno'
print names.length
print names[Version(major: 1)] ? '-'
