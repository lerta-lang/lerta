# A type whose own compare gives its ==, as a part of a struct, an array or a union; an instance of a
# generic one, ordered and as a map key; and one with a hash as Hashable.
struct Rank
  n: Int
  compare = (other: Rank) -> @n.compare(other.n)
  hash = -> @n

struct Card
  rank: Rank
  suit: String

class Joker
  name: String

print Card(rank: { n: 1 }, suit: 'a') == { rank: { n: 1 }, suit: 'a' }
print [Rank(n: 2)] == [{ n: 2 }]
any: Rank | Joker = Rank(n: 3)
print any == Rank(n: 3)

class Box<T>
  v: Int
  compare = (other: Box<T>) -> @v.compare(other.v)
  hash = -> @v

print Box<String>(v: 1) < Box<String>(v: 2)
boxes: Map<Box<String>, Int>
boxes[Box<String>(v: 1)] = 10
print boxes[Box<String>(v: 1)] ? 0

distinct := <T: Hashable>(xs: T[]) -> Set(xs).length
print distinct([Rank(n: 1), Rank(n: 1), Rank(n: 2)])
