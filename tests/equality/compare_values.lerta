# A struct whose own compare gives its ==, as an optional value, in a tuple, in an array that
# contains it and in a union with a class.
struct Rank
  n: Int
  compare := (other: Rank) -> @n.compare(other.n)
  hash := -> @n

class Joker
  name: String

none: Rank? = nil
print none == nil
print none == { n: 1 }
some: Rank? = { n: 1 }
print some == { n: 1 }
print (Rank(1), 'a') == ({ n: 1 }, 'a')
print Set([(Rank(1), 'a'), (Rank(1), 'a')]).length
print [Rank(1), Rank(2)].contains(Rank(2))
card: Rank | Joker = Rank(3)
print card == Rank(3)
joker: Rank | Joker = Joker('j')
print joker == card
