# A struct whose own compare gives its ==, as an optional value, in a tuple, in an array that
# contains it and in a union with a class.
struct Rank
  n: Int
  compare = (other: Rank) -> @n.compare(other.n)
  hash = -> @n

class Joker(name: String)

none: Rank? = nil
print none == nil
print none == { n: 1 }
some: Rank? = { n: 1 }
print some == { n: 1 }
print (Rank(n: 1), 'a') == ({ n: 1 }, 'a')
print Set([(Rank(n: 1), 'a'), (Rank(n: 1), 'a')]).length
print [Rank(n: 1), Rank(n: 2)].contains(Rank(n: 2))
card: Rank | Joker = Rank(n: 3)
print card == Rank(n: 3)
joker: Rank | Joker = Joker(name: 'j')
print joker == card
