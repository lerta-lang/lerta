# A union holding a class with its own equals compares by it, and a member without one as the same
# object; a generic class's own equals and hash are those of its instance; a compare names the
# members of Ordering.
class A
  n: Int
  equals := (other: A) -> @n == other.n
  hash := -> @n

class B
  n: Int

u: A | B = A(1)
w: A | B = A(1)
print u == w
print u == A(1)
b1: A | B = B(1)
print b1 == B(1)
print b1 == b1
print Set<A | B>([u, w, b1]).length

class Box<T: Equatable>
  v: T
  equals := (other: Box<T>) -> @v == other.v
  hash := -> 7

print Box(1) == Box(1)
print Set([Box('a'), Box('a')]).length

struct V
  n: Int
  compare := (other: V) ->
    @n < other.n then Ordering.LESS else @n == other.n then Ordering.EQUAL else Ordering.GREATER
print V(1) < { n: 2 }
