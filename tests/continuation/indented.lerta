# fmt: off
# Member lines one level deeper than the line where the value starts continue it too, as those at
# its indentation do, which a value that ends with a block takes after it.
items := ['alpha', 'beta', 'gamma']
names := items
  .map((x) -> x.to_upper())
  .filter((x) -> x != 'BETA')
  .to_array()
print names
first := (xs: String[]) ->
  return xs
    .iter()
    .skip(1)
    .join('-')
print first(items)
maybe: String? = 'x'
upper := maybe
  ?.to_upper()
print upper else '-'
text :=
  'one'
  'two'
.join(' ')
print text
# Deeper lines, then a line at the value's indentation, which follows their block.
mixed := items
  .map((x) -> x.to_upper())
.to_array()
print mixed
# The value of a compound assignment, with a comment between the lines.
var joined = ''
joined += items
  .iter()
  # The last two.
  .skip(1)
  .join('+')
print joined
