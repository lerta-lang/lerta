# fmt: off
words := ['b', 'a']
joined := ["#{w}!" for w in words]
.join('-')
print joined
text :=
  'x'
  'y'
.join('')
print text
named: String? = 'ann'
length := named
?.binary.length
print length ? 0
kind := case words.length
  when 2 then 'two'
  else 'other'
.binary.length
print kind
loud := (parts: String[]) ->
  return
    parts[0]
    parts[1]
  .join('+')
print loud(words)
b := 'x'
c := 'yz'
sum := b + c
.binary.length
print sum
chosen :=
  if sum > 2
    'ab'
  else
    'c'
.binary.length
print chosen
spaced := ['p', 'q']
# a comment between

.join('')
print spaced
items :=
  'abc'
  .binary.length
  5
print items[0] + items[1]
measure := (point: { x: Int }) -> print point.x
measure
  x: 'ab'
  .binary.length
count := (n: Int) ->
  for i in 0...n
    yield 'ab'
    .binary.length
var total = 0
total += each for each in count(2)
print total
var size = 'n'
size = 'abcd'
.binary.length.to_string()
size += 'xy'
.binary.length.to_string()
print size
class Box
  var label = 'old'
box := Box()
box
.label = 'new'
print box.label
maybe: String? = 'abc'
after_if :=
  if true
    maybe
  else
    nil
?.binary.length
print after_if ? 0
describe := (n: Int) -> n
.to_string()
print describe(7) + '!'
label := (n: Int) ->
  case n
    when 1 then 'one'
    .binary.length
    else 0
print label(1)
