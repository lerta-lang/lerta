const words = ['b', 'a']
const joined = ["#{w}!" for w in words]
.join('-')
print joined
const text =
  'x'
  'y'
.join('')
print text
const named: String? = 'ann'
const length = named
?.binary.length
print length ? 0
const kind = case words.length
  when 2 then 'two'
  else 'other'
.binary.length
print kind
const loud = (parts: String[]) ->
  return
    parts[0]
    parts[1]
  .join('+')
print loud(words)
const b = 'x'
const c = 'yz'
const sum = b + c
.binary.length
print sum
const chosen =
  if sum > 2
    'ab'
  else
    'c'
.binary.length
print chosen
const spaced = ['p', 'q']
# a comment between

.join('')
print spaced
const items =
  'abc'
  .binary.length
  5
print items[0] + items[1]
const measure = (point: { x: Int }) -> print point.x
measure
  x: 'ab'
  .binary.length
const count = (n: Int) ->
  for i in 0...n
    yield 'ab'
    .binary.length
var total = 0
total += each for each in count(2)
print total
var size = 'n'
size = 'abcd'
.binary.length.to_string()
size += 'xy'
.binary.length.to_string()
print size
class Box
  var label = 'old'
const box = Box()
box
.label = 'new'
print box.label
const maybe: String? = 'abc'
const after_if =
  if true
    maybe
  else
    nil
?.binary.length
print after_if ? 0
const describe = (n: Int) -> n
.to_string()
print describe(7) + '!'
const label = (n: Int) ->
  case n
    when 1 then 'one'
    .binary.length
    else 0
print label(1)
