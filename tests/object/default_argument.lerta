class Local
  name: String
  mutable = default false
  label = "#{@name}#{@mutable then ' (var)' else ''}"
  tags = default ["#{@name} tag"]
  note: String? = default 'none'
  count = default @tags.length

default := 'name'
struct Pair<T>(first: T, second: T = default @first)

show := (local: Local) ->
  print "#{local.label} #{local.tags.join(',')} #{local.note ? 'nil'} #{local.count}"

show Local(name: 'a')
show Local(name: 'b', mutable: true, tags: ['x'], note: nil, count: 7)
name := default
show Local(name, count: 0)
print Pair(first: 1).second
print Pair(first: 'p', second: 'q').second
