class Local
  args
    name: String
    mutable := false
    tags := ["#{@name} tag"]
    note: String? = 'none'
    count := @tags.length
  label := "#{@name}#{@mutable then ' (var)' else ''}"

default := 'name'
struct Pair<T>
  first: T
  second: T = @first

show := (local: Local) ->
  print "#{local.label} #{local.tags.join(',')} #{local.note else 'nil'} #{local.count}"

show Local('a')
show Local(name: 'b', mutable: true, tags: ['x'], note: nil, count: 7)
name := default
show Local(name, count: 0)
print Pair(1).second
print Pair(first: 'p', second: 'q').second
