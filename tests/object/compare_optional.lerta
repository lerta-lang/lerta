class Node(name: String)
class Other(id: Int)
type Item = Node | Other

a := Node(name: 'a')
b := Node(name: 'b')
none: Node? = nil
also_none: Node? = nil
maybe_a: Node? = a
maybe_b: Node? = b
print none == also_none
print none != also_none
print none == maybe_a
print maybe_a == none
print maybe_a == a
print a == maybe_a
print maybe_a != a
print maybe_a == maybe_b
print maybe_a != maybe_b

item: Item? = a
no_item: Item? = nil
print item == a
print item == b
print no_item == a
print a != no_item
print item == maybe_a
print no_item == none

found := maybe_a
print found.name if found == a
if found != b
  print 'not b'
else
  print found.name

# An optional struct, which compares by its fields.
struct P(x: Int)
p: P? = P(x: 1)
print p == P(x: 1)
