# A computed field of a class that reads a `var` field keeps the value it had at construction,
# which a warning tells, once for each such field, wherever in its initializer it reads it; a
# field that cannot change, a `var` field, a default and a function literal read as they should.
class Counter
  args
    var count = 0
    start := @count
  name := 'counter'
  double := @count * 2
  twice := @count + @count
  sign := @count > 0 then 'positive' else 'none'
  label := "#{@name}!"
  var seeded = @count + 1
  read_later := -> @count * 3
  increment := -> @count += 1

counter := Counter()
counter.increment()
print counter.double
print counter.twice
print counter.sign
print counter.label
print counter.seeded
print counter.start
print counter.read_later()
