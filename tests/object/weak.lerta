class Parent
  name: String
  children: Child[] = []
  deinit = -> print("parent #{@name} gone")

class Child
  weak! parent: Parent
  name: String
  describe = -> "#{@name} of #{@parent.name}"
  deinit = -> print("child #{@name} gone")

# The children hold their parent weakly, so the two do not keep each other alive.
family := ->
  parent := Parent('p')
  parent.children.push Child(parent, name: 'a')
  parent.children.push Child(parent, name: 'b')
  print parent.children[1].describe()
family()

# A child that goes first lets go of the box it shares with its siblings.
parent := Parent('q')
first := -> print(Child(parent, name: 'c').describe())
first()
parent.children.push Child(parent, name: 'd')
print parent.children[0].describe()
