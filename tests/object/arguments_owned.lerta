interface Named
  name: String

class Tag
  args
    name: String
  deinit := -> print("tag #{@name} gone")

fail := (): String -> throw IndexError('no default')

class Holder
  args
    tag: Tag
    named: Named?
    extra: Tag?
    note := fail()

class Checked
  args
    tag: Tag
  init := -> throw IndexError('init failed')

class Watcher
  args
    weak tag: Tag?

# A new value is taken over by the object, and goes with it.
made := -> Holder(tag: Tag('new'), named: Tag('named'), note: 'n')
made()
print 'made gone'

# A local's value is shared with the object, and stays with the local.
shared := ->
  tag := Tag('shared')
  var other = Tag('var')
  holder := Holder(tag, named: other, extra: other, note: 'n')
  other = Tag('replaced')
  print holder.named?.name else ''
  print 'holder dropped'
shared()

# The arguments given go with the object when an initializer or init throws.
try
  Holder tag: Tag('thrown'), named: nil, extra: Tag('extra')
catch e: IndexError
  print e.message
try
  Checked tag: Tag('checked')
catch e: IndexError
  print e.message

# A weak field given a new value lets it go at once.
watcher := Watcher(tag: Tag('weak'))
print watcher.tag == nil

# A weak field given a local's object leaves it with the local.
kept := Tag('kept')
print Watcher(tag: kept).tag?.name else 'gone'

# A struct given from a local is shared, with the reference it holds.
struct Pair
  tag: Tag

class PairHolder
  args
    pair: Pair

pair_shared := ->
  pair := Pair(Tag('pair'))
  holder := PairHolder(pair)
  print holder.pair.tag.name
pair_shared()

# A runtime error's message is shared with the error.
try
  print [1][2]
catch e: IndexError
  print e.message

# A weak field given nil, and fields of other kinds given a local's value.
class Box<T>
  args
    value: T

class Mixed
  args
    weak tag: Tag?
    either: Tag | String
    pair: (Tag, Int)
    describe: () -> String

kinds := ->
  none: Tag? = nil
  tag := Tag('kinds')
  either: Tag | String = tag
  pair := (tag, 1)
  describe := -> tag.name
  mixed := Mixed(either, pair, describe, tag: none)
  box := Box(tag)
  print "#{mixed.tag == nil} #{mixed.describe()} #{box.value.name} #{Box(value: 'new').value}"
kinds()
