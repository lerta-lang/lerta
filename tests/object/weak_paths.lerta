class Owner
  args
    name: String

class Weak
  args
    weak owner: Owner!
  label := "weak #{@owner.name}"

class Strong
  args
    owner: Owner
  label := "strong #{@owner.name}"

type Holder = Weak | Strong

owner := Owner('o')
holders: Holder[] = [Weak(owner), Strong(owner)]
print holder.owner.name for holder in holders
print holders[0].label
owner_of := (weak: Weak) ->
  { owner } := weak
  owner.name
print owner_of(Weak(owner))
