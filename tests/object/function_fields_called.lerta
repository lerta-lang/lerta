# Members called through what they are: a field that holds a function, read by interpolation as
# to_string, and one that every member of a union has.
struct Label
  to_string: () -> String

struct Circle
  area: () -> Int

struct Square
  area: () -> Int

label := Label(-> 'a label')
print "#{label}"
shapes: (Circle | Square)[] = [Circle(-> 3), Square(-> 4)]
print shape.area() for shape in shapes
