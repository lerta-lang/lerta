struct Token(kind: String, text: String, line: Int, note: String?)

const make = (kind: String, text: String) -> Token(kind, text, line: 1)
const token = make('word', 'hi')
print "#{token.kind} #{token.text} #{token.line} #{token.note ? '-'}"
const note = 'noted'
const line = 2
print Token(note, line, kind: 'number', text: '7').note!

# Each instance of a generic function checks the shorthand again.
struct Label(text: String)
const label = <T: Stringable>(x: T): Label ->
  const text = x.to_string()
  Label text
print label(1).text + label(true).text
