# Assigning reference-typed fields, also when the right side changes the same field.
class V
  n: Int
class C
  var v: V
  var label: String
  change := ->
    @v = V(2)
    V 3
c := C(v: V(1), label: 'a')
c.v = c.change()
print c.v.n
c.label = c.label + 'b'
c.label = 'c'.to_string()
print c.label
class Holder
  name: String
  copy := @name
h := Holder('x'.to_string())
print h.copy
