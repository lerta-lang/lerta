# Assigning reference-typed fields, also when the right side changes the same field.
class V
  n: Int
class C
  v: V
  label: String
  change = (): V ->
    @v = V(n: 2)
    V(n: 3)
const c = C(v: V(n: 1), label: 'a')
c.v = c.change()
print c.v.n
c.label = c.label + 'b'
c.label = 'c'.to_string()
print c.label
class Holder
  name: String
  copy = @name
const h = Holder(name: 'x'.to_string())
print h.copy
