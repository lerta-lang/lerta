import encode_json from 'std:json'

# Fields laid out by alignment rather than as declared still read, write, compare, hash and print
# as declared.
class Counter
  args
    done: Bool
    var count: Int
    label: String
    weak var parent: Counter?
    small: Int16

  deinit := -> print("dropped #{@label}")

struct Mixed
  done: Bool
  name: String
  count: Int32
  kind: Kind

enum Kind
  FIRST
  SECOND

class Box<T>
  args
    flag: Bool
    item: T
    count: Int

struct Point
  near: Bool
  x: Int

counter := Counter(done: true, count: 1, label: 'a', parent: nil, small: 7)
counter.count += 2
print "#{counter.done} #{counter.count} #{counter.label} #{counter.small}"
child := Counter(done: false, count: 0, label: 'b', parent: counter, small: 8)
print child.parent!.label

mixed := Mixed(done: true, name: 'x', count: 3, kind: SECOND)
print mixed
print encode_json(mixed)
print mixed == { done: true, name: 'x', count: 3, kind: SECOND }
by_mixed := { (mixed): 1 }
print by_mixed[{ done: true, name: 'x', count: 3, kind: SECOND }]!

record := { flag: true, total: 10, letter: 'q' }
print "#{record} #{record.total}"

tuples := [(2, 'b', 3), (1, 'z', 9), (2, 'a', 1)]
print tuples.sorted()
print (true, 2, 'b') == (true, 2, 'b')

flags := Box<Bool>(flag: true, item: false, count: 3)
names := Box<String>(flag: false, item: 'n', count: 4)
print "#{flags.flag} #{flags.item} #{flags.count} #{names.flag} #{names.item} #{names.count}"

nested := { point: Point(near: true, x: 2), last: false }
print "#{nested.point.near} #{nested.point.x} #{nested.last}"
