class Node
  name: String

class Edge
  from: Node

type Element = Node | Edge

const a = Node(name: 'a')
const b = Node(name: 'a')
print a == a
print a == b
print a != b
const element: Element = a
const other: Element = Edge(from: a)
print element == a
print a == element
print element != b
print element == other

# A union that holds a struct.
struct Leaf
  value: Int
type Tree = Node | Leaf
const tree: Tree = Node(name: 'a')
print tree == tree

# Unions that share a member.
class A
  x: Int
class B
  x: Int
class C
  x: Int
type AB = A | B
type BC = B | C
const shared = B(x: 1)
const ab: AB = shared
const bc: BC = shared
print ab == bc
const not_b: BC = C(x: 1)
print ab == not_b
