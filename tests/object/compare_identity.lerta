class Node
  name: String

class Edge
  from: Node

type Element = Node | Edge

a := Node('a')
b := Node('a')
print a == a
print a == b
print a != b
element: Element = a
other: Element = Edge(a)
print element == a
print a == element
print element != b
print element == other

# A union that holds a struct.
struct Leaf
  value: Int
type Tree = Node | Leaf
tree: Tree = Node('a')
print tree == tree

# Unions that share a member.
class A
  x: Int
class B
  x: Int
class C
  x: Int
type AB = A | B
type BC = B | C
shared := B(1)
ab: AB = shared
bc: BC = shared
print ab == bc
not_b: BC = C(1)
print ab == not_b
