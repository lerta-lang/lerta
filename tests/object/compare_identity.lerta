class Node
  name: String

class Edge
  from: Node

type Element = Node | Edge

const a = Node(name: 'a')
const b = Node(name: 'a')
print a == a
print a == b
print a != b
const element: Element = a
const other: Element = Edge(from: a)
print element == a
print a == element
print element != b
print element == other
