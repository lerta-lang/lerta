struct Point(x: Int, y = default 2)

# fmt: skip
class Counter(
  label: String
  count = default 0
  note: String?
)

struct Failure(code: Int): Error

struct Pair<A, B>(first: A, second: B)

const counter = Counter(label: 'clicks')
counter.count += 1
print "#{Point(x: 1).y} #{counter.label} #{counter.count} #{counter.note ? 'none'}"
print Failure(code: 3, message: 'failed').message
print Pair(first: 1, second: 'a').second

interface Holder<T>
  value: T

struct Box<T>(label: String): Holder<T>

print Box(value: 4, label: 'four').value
