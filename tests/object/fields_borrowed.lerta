class Tag
  name: String
  deinit := -> print("tag #{@name} gone")

class Inner
  tag: Tag
  tags: Tag[]
  by_name: Map<String, Tag>
  maybe: Tag?

class Outer
  var inner: Inner
  replace := ->
    @inner = Inner(tag: Tag('replaced'), tags: [], by_name: Map(), maybe: nil)
    0

make := (name: String) ->
  tag := Tag(name)
  by_name: Map<String, Tag>
  by_name[name] = tag
  Inner(tag, by_name, tags: [tag], maybe: tag)

# A field read through fields, indexed and tested against nil.
outer := Outer(make('a'))
print outer.inner.tag.name
print outer.inner.tags.length
print outer.inner.tags[0].name
print outer.inner.by_name['a']!.name
print outer.inner.maybe != nil

# An index whose position calls a function that replaces the field: the array is held meanwhile.
position := -> outer.replace()
print outer.inner.tags[position()].name
print outer.inner.tag.name

# A field given to a call that replaces it stays held for the call.
show := (tag: Tag) ->
  outer.replace()
  print tag.name
outer.inner = make('b')
show outer.inner.tag
print 'done'

# A key's own hash that replaces the field: the map is held while the key is found.
struct Key
  n: Int
  equals := (other: Key) -> @n == other.n
  hash := ->
    keyed.replace() if armed
    @n

class Keyed
  var by_key: Map<Key, Tag>
  replace := -> @by_key = Map()

keyed := Keyed(Map())
var armed = false
keyed.by_key[{ n: 1 }] = Tag('keyed')
key := Key(1)
armed = true
print keyed.by_key[key]?.name ? 'not found'
armed = false

# Fields left owned: weak, narrowed out of a union's box, read with a default, or from a var.
class Parts
  weak tag: Tag?
  counts: Map<String, Int>

struct Either
  value: Tag | Int

kept := Tag('kept')
parts := Parts(tag: kept, counts: Map())
print parts.tag?.name ? 'gone'
either := Either(kept)
print either.value.name if either.value is Tag
parts.counts['x', default: 0] += 1
print parts.counts['x']!
var current = outer
print current.inner.tag.name

# A chain from `@` whose index position replaces the field, and literal positions of a Binary.
class Owner
  var inner: Inner
  var data: Binary
  first_after_replace := ->
    at := -> @replace_own()
    @inner.tags[at()].name
  replace_own := ->
    @inner = make('own')
    0

owner := Owner(inner: make('c'), data: b'xyz')
print owner.first_after_replace()
print "#{owner.data[0]} #{owner.data[2]}"

# Fields that hold the same value while their object lives, of a struct or `const` ones of a class,
# given to a call or as its object: one under a var field stays held while the call replaces it.
struct Fixed
  inner: Inner

class Holder
  fixed: Fixed
  var swappable: Fixed

holder := Holder(fixed: { inner: make('d') }, swappable: { inner: make('e') })
describe := (tag: Tag) ->
  holder.swappable = { inner: make('f') }
  print "#{tag.name} after the swap"
describe holder.fixed.inner.tag
describe holder.swappable.inner.tag
print holder.fixed.inner.tag.name.starts_with('d')

# A struct field under a var field from `@`, and an assignment to an index of a const field's array,
# which releases the item it replaces.
class Keeper
  var held: Fixed
  items: Tag[]
  show_after_swap := -> @describe_own(@held.inner.tag)
  describe_own := (tag: Tag) ->
    @held = { inner: make('h') }
    print "#{tag.name} after the own swap"

keeper := Keeper(held: { inner: make('g') }, items: [Tag('old item')])
keeper.show_after_swap()
keeper.items[0] = Tag('new item')
print keeper.items[0].name
