class Local
  args
    name: String
    mutable := false
    tags := ["#{@name} tag"]
    note: String? = 'none'
    count := @tags.length
    private secret := 's'
  label := "#{@name}#{@mutable then ' (var)' else ''}"
  reveal := -> @secret

class Fixed
  args
    value: Int

show := (local: Local) ->
  print
    "#{local.label} #{local.tags.join(',')} #{local.note ? 'nil'} #{local.count} #{local.reveal()}"

show Local('a')
show Local(name: 'b', mutable: true, tags: ['x'], note: nil, count: 7, secret: 't')
print Fixed(3).value
