# The value of an init's last expression is released, as a statement's is.
class Window
  title := 'main'

class Root
  var windows: Window[] = []
  add := (window: Window) ->
    @windows.push window
    window

class Desktop
  root := Root()
  window: Window
  init := -> @root.add @window

desktop := Desktop(Window())
print desktop.root.windows[0].title
