struct P
  x: Int
print P(1).x

# The one argument that must be given, beside those with defaults or of optional types.
class Failure
  args
    message: String
    code := 1
    cause: String?
f := Failure('failed')
print "#{f.message} #{f.code} #{f.cause else 'none'}"

# A name that is no field's is a value alone; one that is, the argument of its name.
text := 'named'
print Failure(text).message
message := 'shorthand'
print Failure(message).message

# A generic one infers its type arguments from the value.
struct Box<T>
  value: T
print Box([1, 2]).value.length
