struct Point
  x: Int
  y: Int

struct Tree
  label: String
  children: Tree[]

class Box
  n: Int

struct Holder
  box: Box
  note: String?

type Shape = Point | Tree

print Point(x: 1, y: 2) == Point(x: 1, y: 2)
print Point(x: 1, y: 2) != Point(x: 1, y: 3)
print [1, 2] == [1, 2]
print [1, 2] == [1, 2, 3]
print ['a'] == ['b']
const leaf = Tree(label: 'leaf', children: [])
print Tree(label: 'r', children: [leaf]) == Tree(label: 'r', children: [Tree(label: 'leaf', children: [])])
const box = Box(n: 1)
print Holder(box, note: nil) == Holder(box, note: nil)
print Holder(box, note: 'a') == Holder(box: Box(n: 1), note: 'a')
const a: Shape = Point(x: 0, y: 0)
const b: Shape = Point(x: 0, y: 0)
const c: Shape = leaf
print a == b
print a == c
print { x: 1, y: 'a' } == { x: 1, y: 'a' }
const p: Point? = nil
print p == Point(x: 1, y: 1)
const counts: Map<Point, Int> = Map()
counts[Point(x: 1, y: 2)] = 5
counts[Point(x: 1, y: 2)] = 6
print counts.length
print counts[Point(x: 1, y: 2)] ? -1
const by_list: Map<String[], Int> = { ['a', 'b']: 1 }
print by_list[['a', 'b']] ? -1
print by_list[['b']] ? -1
