struct Point(x: Int, y: Int)

struct Tree(label: String, children: Tree[])

class Box(n: Int)

struct Holder(box: Box, note: String?)

type Shape = Point | Tree

print Point(x: 1, y: 2) == { x: 1, y: 2 }
print Point(x: 1, y: 2) != { x: 1, y: 3 }
print [1, 2] == [1, 2]
print [1, 2] == [1, 2, 3]
print ['a'] == ['b']
leaf := Tree(label: 'leaf', children: [])
print
  Tree(label: 'r', children: [leaf]) == { label: 'r', children: [{ label: 'leaf', children: [] }] }
box := Box(n: 1)
print Holder(box, note: nil) == { box, note: nil }
print Holder(box, note: 'a') == { box: Box(n: 1), note: 'a' }
a: Shape = Point(x: 0, y: 0)
b: Shape = Point(x: 0, y: 0)
c: Shape = leaf
print a == b
print a == c
print { x: 1, y: 'a' } == { x: 1, y: 'a' }
p: Point? = nil
print p == { x: 1, y: 1 }
counts: Map<Point, Int>
counts[{ x: 1, y: 2 }] = 5
counts[{ x: 1, y: 2 }] = 6
print counts.length
print counts[{ x: 1, y: 2 }] ? -1
by_list := { ['a', 'b']: 1 }
print by_list[['a', 'b']] ? -1
print by_list[['b']] ? -1
