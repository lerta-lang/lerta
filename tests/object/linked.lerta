# Self-referential types and objects holding objects and strings.
class Node(value: String, next: Node?)

const list = Node(value: 'a', next: Node(value: 'b', next: Node(value: 'c')))
var node: Node? = list
var text = ''
while const n = node
  text = text + n.value
  node = n.next
print text

class Stack
  items: Node[] = []
  push = (value: String) -> @items.push(Node(value: value))
  pop = -> @items.pop().value

const stack = Stack()
stack.push 'x'
stack.push 'y'.to_string()
print stack.pop()
print stack.items.length
const nodes = [Node(value: '1'), Node(value: '2')]
nodes[0] = nodes[1]
print nodes[0].value
