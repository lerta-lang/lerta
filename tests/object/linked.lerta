# Self-referential types and objects holding objects and strings.
class Node
  value: String
  next: Node?

list := Node(value: 'a', next: Node(value: 'b', next: Node('c')))
var node: Node? = list
var text = ''
while n := node
  text = text + n.value
  node = n.next
print text

class Stack
  items: Node[] = []
  push := (value: String) -> @items.push(Node(value))
  pop := -> @items.pop().value

stack := Stack()
stack.push 'x'
stack.push 'y'.to_string()
print stack.pop()
print stack.items.length
nodes := [Node('1'), Node('2')]
nodes[0] = nodes[1]
print nodes[0].value
