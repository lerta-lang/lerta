struct Point
  x: Int
  y: Int
  sum := @x + @y
  scaled := (k: Int) -> Point(x: @x * k, y: @y * k)

p := Point(x: 1, y: 2)
print p.x
print p.sum
q := p.scaled(10)
print "#{q.x} #{q.y} #{q.sum}"

class Counter
  var label: String
  note: String?
  var count = 0
  doubled := @count * 2
  history: Int[] = []
  init := -> @history.push(-1)
  increment := ->
    @count += 1
    @history.push @count
  total := ->
    var sum = 0
    sum += h for h in @history
    sum

c := Counter('clicks')
print c.note == nil
c.increment()
c.increment()
print c.count
print c.doubled
print c.total()
c.label = c.label + '!'
print c.label
named := Counter(note: 'n', label: 'x')
print named.note!
