struct Point
  x: Int
  y: Int
  sum = @x + @y
  scaled = (k: Int) -> Point(x: @x * k, y: @y * k)

const p = Point(x: 1, y: 2)
print p.x
print p.sum
const q = p.scaled(10)
print "#{q.x} #{q.y} #{q.sum}"

class Counter
  label: String
  note: String?
  count = 0
  doubled = @count * 2
  var history: Array<Int> = []
  init = -> @history.push(-1)
  increment = ->
    @count += 1
    @history.push(@count)
  total = (): Int ->
    var sum = 0
    sum += h for h in @history
    sum

const c = Counter(label: 'clicks')
print c.note == nil
c.increment()
c.increment()
print c.count
print c.doubled
print c.total()
c.label = c.label + '!'
print c.label
const named = Counter(note: 'n', label: 'x')
print named.note!
