# Called before its declaration: top-level functions are visible everywhere.
print square(7)
square := (x: Int) -> x * x
greet := -> print('hello')
greet()
is_even := (n: Int) -> n % 2 == 0
print is_even(4)
print is_even(7)
twice := (s: String) ->
  copy := s
  copy
print twice('kept')
name := (n: Int) -> n.to_string()
label := name(42)
print label
print name(-1)
nothing := (): void -> return
nothing()
