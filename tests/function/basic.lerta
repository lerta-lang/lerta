# Called before its declaration: top-level functions are visible everywhere.
print square(7)
const square = (x: Int) -> x * x
const greet = -> print('hello')
greet()
const is_even = (n: Int) -> n % 2 == 0
print is_even(4)
print is_even(7)
const twice = (s: String) ->
  const copy = s
  copy
print twice('kept')
const name = (n: Int) -> n.to_string()
const label = name(42)
print label
print name(-1)
const nothing = (): void -> return
nothing()
