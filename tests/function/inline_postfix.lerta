const seen: Set<String> = Set()
const mark = (name: String) -> seen.add name if not seen.has(name)
mark 'a'
mark 'a'
mark 'b'
print seen.length
const total = (xs: Int[]) ->
  var sum = 0
  const add = (x: Int) -> sum += x for _ in 0...2
  add x for x in xs
  sum
print total([1, 2])
# Inside brackets, the `for` is the comprehension's.
const fs = [(x: Int) -> x + 1 for _ in 0...3]
print fs.length
var n = 0
const grow = -> n += 1 while n < 3
grow()
print n
const m = { 'a': 1 }
const show = (key: String) -> print v if const v = m[key]
show 'a'
show 'b'
case
  when n > 0 then n -= 1 while n > 1
  else pass
print n
