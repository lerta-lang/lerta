seen: Set<String>
mark := (name: String) -> seen.add name if not seen.contains(name)  # fmt: skip
mark 'a'
mark 'a'
mark 'b'
print seen.length
total := (xs: Int[]) ->
  var sum = 0
  add := (x: Int) -> sum += x for _ in 0...2
  add x for x in xs
  sum
print total([1, 2])
# Inside brackets, the `for` is the comprehension's.
fs := [(x: Int) -> x + 1 for _ in 0...3]
print fs.length
var n = 0
grow := -> n += 1 while n < 3
grow()
print n
m := { 'a': 1 }
show := (key: String) -> print v if v := m[key]  # fmt: skip
show 'a'
show 'b'
case
  when n > 0 then n -= 1 while n > 1
  else pass
print n
