# A const that holds @ is bound as @ is, so storing its method where @ holds it is warned about.
class Keys
  names := ['b']
  var on_check: ((String) -> Bool)?
  has := (name: String) -> name in @names
  pick := (xs: String[]) ->
    me := @
    xs.filter(me.has).to_array()
  init := ->
    me := @
    @on_check = me.has
  release := -> @on_check = nil

keys := Keys()
print keys.pick(['a', 'b'])
keys.release()
