interface Named
  name: () -> String
class A
  name = -> 'a'
class B
  name = -> 'b'

named: Named = A()
of_interface: () -> String = named.name
either: A | B = B()
of_union: () -> String = either.name
print [of_interface(), of_union()]
other := ['b']
pick: (String) -> Bool = not other.is_empty() then other.contains else (_) -> false
print pick('b')
