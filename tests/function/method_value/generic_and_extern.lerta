import '../../module/lib/shapes' as geo

extern lerta_string_equals: (String, String) -> Bool

same := <T>(x: T) -> x
apply := (f: (Int) -> Int, x: Int) -> f(x)
print apply(same, 3)
larger: (Int, Int) -> Int = geo.largest
print larger(1, 2)
equals: (String, String) -> Bool = lerta_string_equals
print [equals('a', 'a'), equals('a', 'b')]
