class Walker
  limit := 2
  reaches := (n: Int) -> n > @limit
  any_reaches := (xs: Int[]) -> xs.any(@reaches)

other := ['b', 'c']
print ['a', 'b'].filter(other.contains).to_array()
name := 'lerta'
print ['ta', 'x'].map(name.ends_with).to_array()
print [Walker().any_reaches([1, 3]), Walker().any_reaches([1])]
contains: (String) -> Bool = other.contains
print contains('c')
optional: ((String) -> Bool)? = other.contains
print optional!('a')
