struct Span
  start: Int
  unused: Bool

class Node
  name: String
  var visits = 0

struct Action
  run: () -> String

spans: Span[] = [{ start: 1, unused: false }, { start: 5, unused: true }]
print spans.find(Span.unused)!.start
print spans.map(Span.start).to_array()
print spans.any(Span.unused)
nodes := [Node('b'), Node('a')]
print nodes.sorted_by(Node.name).map(Node.name).to_array()
print nodes.map(Node.visits).to_array()
# A field that holds a function is called, as a method is.
actions: Action[] = [{ run: -> 'ran' }]
print actions.map(Action.run).to_array()
struct Handler
  handle: (Int) -> String
  fallback: (() -> String)?

handle: (Handler, Int) -> String = Handler.handle
handler := Handler(handle: (n) -> "#{n}", fallback: nil)
print handle(handler, 7)
# One that holds an optional function is read, as it could not be called.
print [handler].map(Handler.fallback).to_array().length
node := nodes[0]
node.visits = 3
print nodes.map(Node.visits).to_array()
type Step = (Int) -> Int
struct Stepper
  step: Step
step: (Stepper, Int) -> Int = Stepper.step
print step(Stepper((n) -> n + 1), 1)
