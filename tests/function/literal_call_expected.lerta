# A function literal called where it is written takes the type expected of the call as that of its
# result.
x: Float = ((n) -> 1)(1)
print x
# An Iter comprehension with its `for` first and statements is such a call (see prefix_iter).
ys: Iter<Float> = (
  for n in 0..2
    print n
    1
)
print ys.to_array()
o: Float? = ((n) -> 1)(1)
print o else 0.0
halved := (xs: Float[]) -> xs.map((x) -> x / 2).to_array()
print halved(((n) -> [1])(1))
given := (): Float -> ((n) -> 1)(1)
print given()
taken := (x: Float) -> x
print taken(((n) -> 1)(1))
