# A function whose `return` alone makes its result void discards the value that it ends with.
seen := Set([1])
forget := (x: Int) ->
  return if x < 0
  seen.remove x
forget 1
print seen.length

# So does one that ends with a case whose arms give values of no type in common, releasing a
# discarded String.
label := (x: Int) ->
  return if x < 0
  case x  # fmt: skip
    when 0 then seen.add(x)
    else print("#{x}".to_upper())
label 0
label 7
print seen.length
