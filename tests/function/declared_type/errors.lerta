# The declared type of a top-level function is a function type that the literal fits: its written
# parameter types, its written return type and its number of parameters agree, and it is not
# variadic and has no defaults, which a function type cannot tell.
given: (String) -> String = (name = 'you') -> name

all: (Int[]) -> Int = (xs: Int...) -> xs.length

wrong_param: (Int) -> Int = (x: String) -> 1

wrong_result: () -> Int = (): Int? -> 1

too_few: (Int, Int) -> Int = (x) -> x

too_many: (Int) -> Int = (x, y) -> x

narrower: (Int) -> Int? = (n: Int): Int -> n

partly_wrong: (Int, Int) -> Int = (x: String, y) -> y

wider_param: (Int) -> Int = (x: Int?) -> 1

not_promise: () -> Promise<Int> = (): Int -> 1
