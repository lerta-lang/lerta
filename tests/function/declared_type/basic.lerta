# A top-level function whose declaration writes its type has that type, as a local does: its
# literal is checked as the type, whose parameter types it may leave out, whose return type it
# gives, wider than its results, and whose Promise it settles. It can be used before its
# declaration and call itself, as any top-level function.
import square from './lib/declared'

type Handler = (String) -> Promise<String>

print await greet('you')

greet: Handler = (name) -> "hello, #{name}"

find: (Int) -> Int? = (n) -> n > 0 then n

countdown: (Int) -> Int = (n) ->
  if n == 0
    0
  else
    countdown(n - 1)

var found = find(1)
print found else 0
found = nil
print found else 0
print countdown(3)
handlers := [greet]
print await handlers[0]('all')

written: () -> Promise<Int> = (): Promise<Int> -> 1
print await written()
print square(4)

# Some parameter types written and others left out, and two functions that call each other.
add: (Int, Int) -> Int = (x, y) -> x + y
print add(1, 2)
is_even: (Int) -> Bool = (n) ->
  if n == 0
    true
  else
    is_odd(n - 1)
is_odd: (Int) -> Bool = (n) ->
  if n == 0
    false
  else
    is_even(n - 1)
print is_even(4)
