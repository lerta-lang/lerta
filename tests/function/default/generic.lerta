repeat := <T>(item: T, count = 2): T[] -> [item for _ in 0..count]

print repeat('x').join(',')
print repeat(1, 3).length

extend<T> T[]
  first_or := (fallback: T? = nil): T? -> @length > 0 then @[0] else fallback

empty: Int[]
print [1].first_or() else 0
print empty.first_or(7) else 0
print empty.first_or() else 0
