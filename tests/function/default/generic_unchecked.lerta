# A default of a generic function or method is checked for an instance only where a call leaves it
# out, so that it need not fit every type argument: `zero = 0` serves the numbers, and other types
# give their zero.
total := <T: Add<T, T>>(xs: T[], zero: T = 0): T ->
  var sum = zero
  sum += x for x in xs
  sum
print total([1, 2, 3])
print total([1.5, 2.0])
print total(['a', 'b'], '')

extend<T: Add<T, T>> Iterable<T>
  added = (zero: T = 0): T ->
    var sum = zero
    sum += x for x in @
    sum
small: Int8[] = [1, 2]
print [small.added(), small.added(10)]
print ['x', 'y'].added('>')
# The same instance with the default left out and given.
print [total([4]), total([4], 1)]

# Defaults that use an earlier parameter, or capture one, and explicit type arguments.
later := <T>(x: T, d: () -> T = -> x): T -> d()
copies := <T>(x: T, n = 2, d: T[] = [x for _ in 0...n]): Int -> d.length
print [later(5), copies('a'), copies('a', 3)]
print later<String>('s')

# A default that reads `@`, of a generic class's method and of an extend's.
class Box<T>
  v: T

extend<T> Box<T>
  get = (d: T = @v): T -> d
print [Box(v: 3).get(), Box(v: 3).get(4)]
