class Tag
  args
    name: String
  deinit := -> print("drop #{@name}")

fail := (): Tag -> throw IndexError('no tag')

show := (first: Tag, second: Tag = Tag("#{first.name}2"), third: Tag = fail()) ->
  print "#{first.name} #{second.name} #{third.name}"

show Tag('a'), Tag('b'), Tag('c')
try
  show Tag('x')
catch e: IndexError
  print e.message
