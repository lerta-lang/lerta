class Tag
  name: String
  deinit = -> print("drop #{@name}")

fail := (): Tag -> throw IndexError(message: 'no tag')

show := (first: Tag, second: Tag = Tag(name: "#{first.name}2"), third: Tag = fail()) ->
  print "#{first.name} #{second.name} #{third.name}"

show Tag(name: 'a'), Tag(name: 'b'), Tag(name: 'c')
try
  show Tag(name: 'x')
catch e: IndexError
  print e.message
