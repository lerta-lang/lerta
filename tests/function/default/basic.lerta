const greet = (name: String, greeting = 'hello', mark: String = '!'): String ->
  "#{greeting}, #{name}#{mark}"

const range_sum = (start: Int, end: Int = start + 3) -> [i for i in start...end].length

print greet('a')
print greet('b', 'hi')
print greet('c', 'yo', '?')
print range_sum(1)
print range_sum(1, 2)
const as_value: (String, String, String) -> String = greet
print as_value('d', 'hey', '.')
