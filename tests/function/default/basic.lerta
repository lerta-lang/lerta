greet := (name: String, greeting = 'hello', mark: String = '!'): String ->  # fmt: skip
  "#{greeting}, #{name}#{mark}"

range_sum := (start: Int, end: Int = start + 3) -> [i for i in start...end].length

print greet('a')
print greet('b', 'hi')
print greet('c', 'yo', '?')
print range_sum(1)
print range_sum(1, 2)
as_value: (String, String, String) -> String = greet  # fmt: skip
print as_value('d', 'hey', '.')

count_from := (start = 1, step: Int = 1): Int -> start + step  # fmt: skip
print count_from()
print count_from(5, 10)
