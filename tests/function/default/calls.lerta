const draw = (label: String, at: { x: Int, y: Int } = { x: 0, y: 0 }) ->
  print "#{label} #{at.x} #{at.y}"

const scaled = (x: Int, scale: (Int) -> Int = (v) -> v * x) -> scale(10)

const sum = (n: Int, total = 0): Int -> n == 0 then total else sum(n - 1, total + n)

draw 'origin'
draw 'point', x: 1, y: 2
print scaled(3)
print scaled(3, (v) -> v + 1)
print sum(4)
