class Counter
  count = 0
  add = (by = 1, times: Int = @count + 1) ->
    @count += by * times
    @count

struct Box<T>
  value: T
  get = (fallback: T? = nil): T -> @value

extend Int
  clamp = (low = 0, high = 9) -> @ < low then low else @ > high then high else @

const counter = Counter()
print counter.add()
print counter.add(2)
print counter.add(1, 10)
print Box(value: 3).get()
print 12.clamp()
print 12.clamp(0, 20)
