# A function literal called where it is written takes the types of the parameters that leave them
# out from its arguments.
doubled := ((x) -> x * 2)(3)
print doubled
joined := ((a: String, b) -> "#{a}-#{b}")('x', 4)
print joined
names := ((xs) -> xs.map((s) -> s.count()).to_array())(['ab', 'cde'])
print names
print ((x: Float, y) -> x + y)(1, 2.5)
print ((xs: Int[], n) -> xs.length + n)([], 1)
print ((f: (Int) -> Int, n) -> f(n))((y) -> y + 1, 2)
print ((o: Int?, y) -> o else y)(nil, 3)
print ((x: Float) -> x)(1)
print ((f, n) -> f(n))((y: Int) -> y * 3, 2)
