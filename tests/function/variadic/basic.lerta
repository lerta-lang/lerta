# A variadic parameter takes the arguments after the others as an array, none or many, and a
# spread among them gives the items of what it spreads, copied; so do those of a generic function
# and of a method.
sum := (first: Int, rest: Int...) ->
  var total = first
  total += x for x in rest
  total

print sum(1)
print sum(1, 2, 3)
xs := [4, 5]
print sum(1, xs...)
print sum(1, xs..., 10, xs...)

clear := (items: Int...) ->
  items.pop() while not items.is_empty()
  items.length
print clear(xs...)
print xs.length

smallest := <T: Comparable>(first: T, rest: T...): T ->
  var best = first
  for x in rest
    best = x if x < best
  best
print smallest(3, 1, 2)
print smallest('b', 'a')
print smallest(2.5)

struct Logger
  prefix: String
  log = (parts: String...) -> print("#{@prefix}#{parts.join(' ')}")
logger := Logger(prefix: '> ')
logger.log 'a', 'b'
logger.log()
