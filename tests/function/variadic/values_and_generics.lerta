# A variadic function as a value takes its array; a generic function whose body makes a variadic
# call has instances that share it; a generic class has a variadic method; and an interface reads
# a variadic method as the function of an array.
sum := (first: Int, rest: Int...) ->
  var total = first
  total += x for x in rest
  total

add := sum
print add(1, [2, 3])

count := <T>(x: T) -> counted(x, x)
counted := <T>(items: T...) -> items.length
print count(1)
print count('a')

class Box<T>
  items: T[] = []
  add = (more: T...) -> @items.append(more)
box := Box<String>()
box.add 'a', 'b'
box.add()
print box.items.length

interface Totals
  total: (Int[]) -> Int

class Adder
  total = (values: Int...) -> values.length
totals: Totals = Adder()
print totals.total([1, 2])
