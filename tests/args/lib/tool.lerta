# A program of two commands, whose arguments parse_command and parse_args read, for the CLI checks
# of how they print their usage and errors and exit (see test/cli/programs.lerta).
import parse_args, parse_command from 'std:args'
import argv from 'std:process'

enum Command
  greet
  count

COMMAND_SPEC := { greet: { help: 'greet someone' }, count: { help: 'count the arguments' } }

struct Greet
  loud: Bool
  name: String

GREET_SPEC := { loud: { short: 'l', help: 'greet loudly' }, name: { positional: true } }

(command, args) := parse_command<Command>(argv, COMMAND_SPEC)
case command
  when greet
    greet := parse_args<Greet>(args, GREET_SPEC, 'greet')
    print greet.loud then "HELLO, #{greet.name}!" else "hello, #{greet.name}"
  when count then print(args.length)
