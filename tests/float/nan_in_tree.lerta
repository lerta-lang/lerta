# A NaN anywhere in a tree of `+ - * /` of locals, their fields, calls and literals throws, as it
# stays a NaN up to the root, which alone checks it; an overflow is an infinity, which throws only
# where it makes a NaN.
# A tree with a call in it throws after the call, at its root. tests/cli/eager_nan_checks runs this
# with `--eager-nan-checks`, where each operation is checked where it is, before the call.
attempt := (name: String, f: () -> Float) ->
  try
    print "#{name}: #{f()}"
  catch e: ArithmeticError
    print "#{name}: #{e.message}"

trees := (big: Float) ->
  attempt 'product', -> big * big * 2.0
  attempt 'difference of infinities', -> big * big - big * big
  attempt 'zero times infinity', -> 0.0 * (big * big)
  attempt 'negated sum', -> -(big * big) + big * big
  attempt 'fine', -> big * 0.5 - big * 0.25 + 1.0
  attempt 'integer literal', -> big * big * 2 - big * big
  attempt 'negated leaf', -> big * -big + big * big
  attempt 'negated root', -> -(big * big - big * big)
  attempt 'infinity by infinity', -> big * big / (big * big) + 1.0
  attempt 'zero by zero', -> (big - big) / (big - big) * 2.0
  attempt 'by infinity', -> 1.0 / (big * big) + 1.0

calls := (big: Float) ->
  note := ->
    print 'called'
    1.0
  attempt 'with a call', -> big * big - big * big + note()

narrow := (big: Float32) ->
  try
    print big * big - big * big
  catch e: ArithmeticError
    print "Float32: #{e.message}"
  print 1.0 + big * big * 0.5

# A var that a closure captures lives in a cell, which a tree reads as it reads any local.
captured := ->
  var big = 1.0
  grow := -> big = big * 1e300
  grow()
  attempt 'captured', -> big * big - big * big

# Fields of a local, of `@` and of a struct field are leaves too.
struct Size
  big: Float

class Holder
  args
    var big: Float
    size: Size
  spread := -> @big * @big - @size.big * @size.big

fields := (big: Float) ->
  holder := Holder(big, size: { big })
  attempt 'field', -> holder.big * holder.big - holder.big * holder.big
  attempt 'field of a field', -> holder.size.big * holder.size.big - big * big
  attempt 'field of @', -> holder.spread()
  measure := (size: Size) -> size.big * size.big - size.big * size.big
  attempt 'field of a struct', -> measure(holder.size)

trees 1e300
fields 1e300
calls 1e300
narrow 3e38
captured()

# `x += e` and the like, where e is a tree, is one whose root is the combining operation, which
# alone checks it; the target keeps its value when it throws.
compound := (big: Float) ->
  holder := Holder(big, size: { big })
  try
    holder.big -= big * big - big * big
  catch e: ArithmeticError
    print "compound tree: #{e.message}, #{holder.big}"
  try
    holder.big *= big * big * 0.0
  catch e: ArithmeticError
    print "compound root: #{e.message}, #{holder.big}"
  var total = big * big
  try
    total -= big * big
  catch e: ArithmeticError
    print "compound local: #{e.message}, #{total}"
  var small: Float32 = 3e38
  try
    small -= small * small
    small += small * small
  catch e: ArithmeticError
    print "compound Float32: #{e.message}, #{small}"
  var ratio = big - big
  try
    ratio /= big - big
  catch e: ArithmeticError
    print "compound zero by zero: #{e.message}, #{ratio}"
  ratio = big * big
  try
    ratio /= big * big
  catch e: ArithmeticError
    print "compound infinity by infinity: #{e.message}, #{ratio}"
  holder.big += big * 0.5 - big * 0.25
  print "compound fine: #{holder.big}"

compound 1e300
