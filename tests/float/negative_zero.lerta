# `-0` where a Float is expected is -0.0, as `-(0)` is; as an Int it is 0.
c: Float = -0
print c
hex: Float = -0x0
print hex
parenthesized: Float = -(0)
print parenthesized
default := (x: Float = -0) -> x
print default()
xs: Float[] = [-0, 0]
print "#{xs[0]} #{xs[1]}"
i := -0
print i
print -9223372036854775808
product: Float = -0 * 1.0
print product
