# `-0` where a Float is expected is -0.0, as `-(0)` is; as an Int it is 0.
const c: Float = -0
print c
const hex: Float = -0x0
print hex
const parenthesized: Float = -(0)
print parenthesized
const default = (x: Float = -0) -> x
print default()
const xs: Float[] = [-0, 0]
print "#{xs[0]} #{xs[1]}"
const i = -0
print i
print -9223372036854775808
const product: Float = -0 * 1.0
print product
