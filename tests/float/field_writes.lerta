# Reading and writing the Float and Float32 fields of objects in a loop leaves the top-level values
# that hold the objects, the objects' other fields and the pending exception as they were.
import sqrt from 'std:math'

class Point
  id: Int
  x: Float
  y: Float32

points := [Point(id: i, x: i.to_float(), y: 0.0) for i in 0...4]
var total = 0.0

move := (dx: Float) ->
  for i in 0...points.length
    point := points[i]
    point.x += dx * sqrt(point.x)
    point.y += (point.x + point.id.to_float()).to_float32()
    total += point.x

move 1.0 for _ in 0...3
print "#{point.id}: #{point.x} #{point.y}" for point in points
print total
