# An overflow anywhere in a tree of `+ - *` of locals and literals throws, as an infinity there gives
# an infinity or a NaN at its root: an infinity less an infinity, and zero times one, too. A tree
# with a call in it throws before the call, as each of its operations is checked where it is.
attempt := (name: String, f: () -> Float) ->
  try
    f()
    print "#{name}: no error"
  catch e: ArithmeticError
    print "#{name}: #{e.message}"

trees := (big: Float) ->
  attempt 'product', -> big * big * 2.0
  attempt 'difference of infinities', -> big * big - big * big
  attempt 'zero times infinity', -> 0.0 * (big * big)
  attempt 'negated sum', -> -(big * big) + big * big
  attempt 'fine', -> big * 0.5 - big * 0.25 + 1.0
  attempt 'integer literal', -> big * big * 2
  attempt 'negated leaf', -> big * -big + 1.0
  attempt 'negated root', -> -(big * big)
  # A division is no part of a tree: what it divides is checked on its own.
  attempt 'division', -> big * big / 2.0 + 1.0

calls := (big: Float) ->
  note := ->
    print 'called'
    1.0
  attempt 'before a call', -> big * big + note()

narrow := (big: Float32) ->
  try
    print big * big - big * big
  catch e: ArithmeticError
    print "Float32: #{e.message}"
  try
    print 1.0 + big * big * 0.5
  catch e: ArithmeticError
    print "Float32 deep: #{e.message}"

# A var that a closure captures lives in a cell, which a tree reads as it reads any local.
captured := ->
  var big = 1.0
  grow := -> big = big * 1e300
  grow()
  attempt 'captured', -> big * big - 1.0

trees 1e300
calls 1e300
narrow 3e38
captured()
