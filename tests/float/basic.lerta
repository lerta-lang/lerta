# Floats: literals with a fraction or an exponent, and integer literals where a Float is expected;
# arithmetic, comparisons and equality as IEEE doubles give them. Floats cannot be printed yet, so
# the results show as Bools.
const half = 0.5
const three: Float = 3
print three * half == 1.5
print 1e3 == 1000.0 and 2.5e-1 == 0.25 and 1_000.000_1 > 1000.0
print 0.1 + 0.2 == 0.3
print 0.1 + 0.2 > 0.3
print -three < 0.0 and -three == 0 - three
print 7.0 / 2.0 == 3.5 and 1.0 - 4 == -3.0
print three >= 3 and three <= 3 and three != 3.000_000_001

# A value in a variable, a compound assignment, a field and an optional value.
var total = 0.0
total += 1.5
total *= 4
total -= 1
total /= 2
print total == 2.5
struct Point
  x: Float
  y: Float
const p = Point(x: 1.5, y: -2)
print p.y == -2.0 and p == Point(x: 1.5, y: -2.0)
const maybe: Float? = 2.0
const none: Float? = nil
print maybe == 2.0 and none != maybe

# Items of arrays and maps, keys too, where -0.0 is the key 0.0, as they are equal.
const xs = [1.5, 2.5, -0.5]
print xs[1] - xs[0] == 1.0 and xs.contains(-0.5)
const names: Map<Float, String> = Map()
names[-0.0] = 'zero'
names[0.5] = 'half'
print names[0.0] ? 'none'
print names.length
const by_point: Map<Point, Int> = Map()
by_point[Point(x: 0.0, y: 1)] = 1
print by_point[Point(x: -0.0, y: 1)] ? 0
