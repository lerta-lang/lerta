# Floats through the other ways values go: arrays compared by their items, tuple keys, a map's
# keys read back, a generic function, an interface's member, an Iter and an extend; and a division
# by -0.0, which is zero too.
print [-0.0, 1.5] == [0.0, 1.5]
by_pair: Map<(Float, Int), String>
by_pair[(-0.0, 1)] = 'pair'
print by_pair[(0.0, 1)] ? 'none'
halves: Map<Float, Int>
halves[0.5] = 1
halves[-0.0] = 2
print halves.keys().to_array()[0] == 0.5 and halves.keys().to_array()[1] == 0.0

largest := <T>(xs: T[], bigger: (T, T) -> Bool): T ->
  var best = xs[0]
  for x in xs
    best = x if bigger(x, best)
  best
print largest([1.5, 3.5, 2.5], (a, b) -> a > b) == 3.5

interface Measured
  size: Float
struct Box
  size: Float
total := (items: Measured[]) ->
  var sum = 0.0
  sum += item.size for item in items
  sum
print total([Box(size: 1.5), Box(size: 2)]) == 3.5

doubled := (x * 2 for x in [0.25, 0.5])
print doubled.to_array() == [0.5, 1.0]

extend Float
  is_positive = -> @ > 0.0
print 0.5.is_positive() and not -0.5.is_positive()

negative_zero := -0.0
by_zero :=
  try
    1.0 / negative_zero
  catch e: ArithmeticError
    print e.message
    0.0
print by_zero == 0.0

# A negative literal takes a member as a positive one does; an optional -0.0 equals 0.0.
print -1.5.is_positive() == false and -1.5 == -(1.5)
optional_zero: Float? = -0.0
print optional_zero == 0.0
