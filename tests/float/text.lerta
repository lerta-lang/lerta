# A Float's text is the fewest digits that read back as it: positional from 1e-4 up to 1e16, with
# `.0` for a whole number, and scientific beyond.
print 1.5
print 1.0
print -0.0
print 0.1 + 0.2
print 123456789.125
print 9999999999999998.0
print 1e16
print 0.0001
print 0.000_099
print 5e-324
print 1.797_693_134_862_315_7e308
print 1e15 + 0.5
print 1e15
print 0.0001
print 0.00009999999999999999
print 9999999999999999.0
print -1e16
print -1e-5
print 9223372036854775807.to_float()
print 123456789012345.67
print "#{0.5} and #{-2.0}"
values := [0.1, 1 / 3.0, 2e-300, 6.02e23]
print [value.to_string() for value in values].join(' ')
print values.iter().all((value) -> value.to_string().parse_float() == value)

# Conversions, truncated toward zero, and parsing, of a decimal number that a Float holds.
print 3.7.to_int()!
print (-3.7).to_int()!  # fmt: skip
print 7.to_float()
print -9223372036854775808.to_float().to_int()!
print (-0.0).to_int()!  # fmt: skip
print 9223372036854774784.0.to_int()!
print '1e-999'.parse_float() ? -1.0
print '-1e-999'.parse_float() ? -1.0
print '0.1000000000000000055511151231257827'.parse_float() == 0.1
for text in ['1.5', '-2', '3E-4', '1e+2', '0.5e1', '-0', '00001.5', '-1.5e-3', '0e99999', '1.5e+3']
  print text.parse_float() ? -1.0
for text in [
  '', '-', '1.', '.5', '+1', 'nan', 'Infinity', 'inf ', '1e', '1e+', '1e-', '-e5', '1e999',
  '-1e999', ' 1', '1_0', '0x10'
]
  print "#{text}: #{text.parse_float() == nil}"
# An infinity reads back as to_string writes it.
print ['inf'.parse_float()!, '-inf'.parse_float()!]
