# The edges of doubles: an integer literal at Int's limits as a Float, which rounds to a power of
# two; the smallest positive double, and a literal so small that it rounds to zero; and the
# largest double, which overflows by addition too.
const lowest: Float = -9223372036854775808
const highest: Float = 9223372036854775807
print lowest == -9.223_372_036_854_775_808e18 and highest == 9.223_372_036_854_775_808e18
const tiny = 5e-324
print tiny > 0.0 and tiny / 2 == 0.0
print 1e-400 == 0.0 and -1e-400 == 0.0
const largest = 1.797_693_134_862_315_7e308
const doubled = try
  largest + largest
catch e: ArithmeticError
  print e.message
  0.0
print doubled == 0.0
