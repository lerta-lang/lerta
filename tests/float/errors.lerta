# Arithmetic that would give a NaN throws; a result too large is an infinity, and so is a nonzero
# number divided by zero, of the sign of the two.
import INFINITY from 'std:math'

big := 1e308
zero := 0.0
attempt := (name: String, f: () -> Float) ->
  try
    print "#{name}: #{f()}"
  catch e: ArithmeticError
    print "#{name}: #{e.message}"
attempt 'overflow', -> big * 10.0
attempt 'negative overflow', -> -big - big
attempt 'division by zero', -> 1.0 / zero
attempt 'division by negative zero', -> 1.0 / -zero
attempt 'zero by zero', -> zero / zero
attempt 'infinity less infinity', -> INFINITY - INFINITY
attempt 'infinity plus negative infinity', -> INFINITY + -INFINITY
attempt 'zero times infinity', -> zero * INFINITY
attempt 'infinity by infinity', -> INFINITY / INFINITY
attempt 'number by infinity', -> 1.0 / INFINITY
attempt 'infinity plus a number', -> INFINITY + big
attempt 'fine', -> big / 10.0
