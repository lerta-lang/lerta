# Float.to_int gives nil beyond Int's range, and Float.to_float32 where the Float32 would be
# infinite.
const big = 9223372036854775808.0
const below = -9223372036854777856.0
print [big.to_int() == nil, below.to_int() == nil]
print [3.5e38.to_float32() == nil, -3.5e38.to_float32() == nil]
# Halfway past the largest Float32 rounds to infinity.
print 3.4028235677973366e38.to_float32() == nil
# Int's smallest value and the largest Float32 just fit.
print [(-big).to_int() == nil, 3.4028234663852886e38.to_float32() == nil]
