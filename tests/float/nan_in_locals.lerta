# A local whose value, a tree of float arithmetic, is NaN holds it unchecked, and throws where the
# value leaves it: as the argument of a call, which is not made, into a field, in a comparison, as
# a return value, and in a tree whose root gives no NaN of its own, as an infinity plus one, which
# checks its result for the locals' NaNs, after the calls in it. A NaN that never leaves its local
# throws nowhere, but a local that a loop or a comprehension reads, declared outside of it, throws
# where it is declared, before the loop, even one that never turns; one declared in the loop stays
# unchecked.
# tests/cli/eager_nan_locals runs this with `--eager-nan-checks`, where each throws at the
# subtraction, the unused one too.
class Box
  var x: Float

attempt := (name: String, f: () -> void) ->
  try
    f()
    print "#{name}: fine"
  catch e: ArithmeticError
    print "#{name}: #{e.message}"

show := (x: Float) -> print("shown: #{x}")

counted := ->
  print 'counted'
  1

pass_on := (x: Float) ->
  print "passed on: #{x}"
  x

locals := (big: Float) ->
  box := Box(x: 1.0)
  attempt 'unused', ->
    _nan := big * big - big * big
  attempt 'argument', ->
    nan := big * big - big * big
    show nan
  attempt 'field', ->
    nan := big * big - big * big
    box.x = nan
  attempt 'comparison', ->
    nan := big * big - big * big
    print nan < 1.0
  attempt 'return', ->
    give := ->
      nan := big * big - big * big
      nan
    give()
  attempt 'tree that gives no NaN', ->
    nan := big * big - big * big
    _one_more := nan + 1.0
  attempt 'after a call in a tree that gives no NaN', ->
    nan := big * big - big * big
    half := 0.5
    _sum := (half * half).to_int()!.to_float() + nan
  attempt 'compound assignment of a field', ->
    nan := big * big - big * big
    box.x += nan
    box.x += 1.0
  attempt 'batch of field writes', ->
    nan := big * big - big * big
    box.x += 1.0
    box.x *= nan
    box.x += 1.0
  attempt 'negated in a tree that gives no NaN', ->
    nan := big * big - big * big
    _sum := -nan + 1.0
  attempt 'argument in a tree that gives no NaN', ->
    nan := big * big - big * big
    _sum := pass_on(nan) + 1.0
  attempt 'nested in a tree that gives no NaN', ->
    nan := big * big - big * big
    _sum := 2.0 + (nan + 1.0)
  attempt 'sum of squares of locals', ->
    dx := big * big - big * big
    dy := big - 1.0
    _sum := dx * dx + dy * dy
  attempt 'before a call in a tree that gives no NaN', ->
    nan := big * big - big * big
    _sum := nan + counted().to_float()
  attempt 'string', ->
    nan := big * big - big * big
    print "#{nan}"
  attempt 'conversion', ->
    nan := big * big - big * big
    print nan.to_int() == nil
  attempt 'item', ->
    nan := big * big - big * big
    _items := [nan]
  attempt 'capture', ->
    nan := big * big - big * big
    _later := -> nan
  attempt 'compound assignment', ->
    nan := big * big - big * big
    var total = 1.0
    total += nan
    print total
  attempt 'negated argument', ->
    nan := big * big - big * big
    show -nan
  attempt 'read in a loop that never runs', ->
    nan := big * big - big * big
    var total = 1.0
    total += nan for _ in 0..0
    print total
  attempt 'read in a loop', ->
    nan := big * big - big * big
    var total = 1.0
    for i in 0..3
      print "turn #{i}"
      total += nan
    print total
  attempt 'read in a while condition', ->
    nan := big * big - big * big
    var turns = 0
    turns += 1 while turns < 3 and nan < 1.0
    print turns
  attempt 'read in an inner loop', ->
    for i in 0..2
      nan := big * big - big * big
      print "outer #{i}"
      var total = 1.0
      total += nan for _ in 0..0
      print total
  attempt 'read in a comprehension of no items', ->
    nan := big * big - big * big
    print [nan + 1.0 for _ in 0..0].length
  attempt 'read in the guard of a comprehension', ->
    nan := big * big - big * big
    print [1.0 for _ in 0..0 when nan < 1.0].length
  attempt 'read in a while body', ->
    nan := big * big - big * big
    var turns = 0
    while turns < 2
      print "turn #{turns}"
      show nan
      turns += 1
  attempt 'read in an if in a loop', ->
    nan := big * big - big * big
    for i in 0..2
      print "turn #{i}"
      show nan if i > 5
  attempt 'declared in the loop that reads it', ->
    for i in 0..2
      _nan := big * big - big * big
      print "turn #{i}"
  print "box: #{box.x}"

locals 1e300
