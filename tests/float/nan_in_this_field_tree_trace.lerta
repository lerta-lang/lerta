# A NaN in a tree of `+ - * /` of fields of `@` and of its struct field is reported where the tree
# is, as its root checks it.
struct Size
  big: Float

class Box
  big: Float
  size: Size
  square_less = -> 1.0 + (@big * @big - @size.big * @size.big)

print Box(big: 1e300, size: { big: 1e300 }).square_less()
