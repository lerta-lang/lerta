# Infinities through the other ways values go: map keys and set items, compound assignments, an
# operand that is a call, outside a tree, of a Float32 too, and to_fixed, which needs an Int.
import INFINITY from 'std:math'

counts: Map<Float, Int>
counts[value, default: 0] += 1 for value in [INFINITY, -INFINITY, INFINITY, 1.5]
print "#{counts[INFINITY]!} #{counts[-INFINITY]!} #{counts.length}"
seen := Set([INFINITY, -INFINITY, INFINITY])
print "#{seen.length} #{seen.has(-INFINITY)}"

items := [1.0]
items[0] += INFINITY
print items[0]
var total = INFINITY
try
  total -= INFINITY
catch e: ArithmeticError
  print e.message
print total

big := -> INFINITY.to_float32()
try
  print big() - big()
catch e: ArithmeticError
  print e.message
print big() + big()

try
  print INFINITY.to_fixed(2)
catch e: ArithmeticError
  print e.message
