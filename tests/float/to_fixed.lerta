# to_fixed gives the text of a Float with a fixed count of digits after the point, rounded half away
# from zero.
print [3.14159.to_fixed(2), 2.5.to_fixed(0), 0.125.to_fixed(2), 1.0.to_fixed(3), 7.0.to_fixed(0)]
print [-2.5.to_fixed(0), -0.001.to_fixed(2), -1.25.to_fixed(1), 0.0.to_fixed(1)]
print [0.000123.to_fixed(5), 123456.789.to_fixed(1), 1.5.to_fixed(18), 9.0.to_fixed(18)]

# Values that adding 0.5 would round wrongly: just below one half, and an odd whole number above
# 2 to the 52nd.
print [0.49999999999999994.to_fixed(0), 4503599627370497.0.to_fixed(0), -0.0.to_fixed(1)]

# A value of 2 to the 53rd or more, whole, written exactly: 2 to the 63rd, a negative one, one whose
# digits have a limb of zeros, one whose product would have rounded, and the largest Float.
print [9223372036854775808.0.to_fixed(0), -1e20.to_fixed(0), -1e20.to_fixed(2), 1e27.to_fixed(0)]
print [1e22.to_fixed(3), 9007199254740993.0.to_fixed(1)]
print 1.7976931348623157e308.to_fixed(0)

# A whole part written exactly, however many digits there are, and a fraction that rounds up into
# it, or up for the rounding of its product.
print [10.0.to_fixed(18), 1e5.to_fixed(15), 922337203.6854776.to_fixed(10)]
print [9007199254740991.0.to_fixed(18), 9.9999.to_fixed(2), 0.995.to_fixed(2), 1.005.to_fixed(2)]

# A negative value whose fraction carries, one that rounds to 0, a carry from 0, and 2 to the 53rd
# less 1 with no digits.
print [-9.9999.to_fixed(2), -0.5.to_fixed(0), -1e-20.to_fixed(2), 0.5.to_fixed(0)]
print 9007199254740991.0.to_fixed(0)
