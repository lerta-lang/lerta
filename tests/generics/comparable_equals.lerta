# A type parameter bounded by Comparable compares by `==` too, and satisfies Equatable.
same := <T: Equatable>(a: T, b: T) -> a == b
both := <T: Comparable>(a: T, b: T) -> [a == b, a < b, same(a, b), [a].contains(b)]
print both(1, 1)
print both('a', 'b')
arrays := <T: Equatable>(a: T[], b: T[]) -> a == b
tuples := <T: Comparable>(a: (T, Int), b: (T, Int)) -> a == b
print [arrays([1], [1]), tuples((1, 2), (2, 2))]
equals := <T: Equatable>(a: T[], b: T[]) -> [a.equals(b), [a].contains(b)]
print equals([1], [2])
