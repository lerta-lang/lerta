# `a<b, c>(d)`, without spaces, is a call with type arguments, which the error tells, rather than
# the two comparisons that `a < b, c > d` is; and so are three type arguments, as three
# comparisons, where the count fits only with them, a default left out too.
both := (x: Bool, y: Bool) -> x and y
all := (x: Bool, y: Bool, z = true) -> x and y and z
a := 1
b := 2
c := 3
d := 0
e := 4
print both(a < b, c > d)
print both(a<b, c>(d))
print all(a<b, c, e>(d))
