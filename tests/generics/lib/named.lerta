# Greets by the name that the bound gives.
export interface Named
  name: () -> String
export greet := <T: Named>(x: T) -> "hi #{x.name()}"
export class Box<T: Named>
  args
    x: T
  name := -> "box #{@x.name()}"
export interface Holder<E>
  held: () -> E
export greet_held := <E: Named, H: Holder<E>>(holder: H) -> greet(holder.held())
