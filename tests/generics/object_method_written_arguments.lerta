# The type arguments of a method's own can be written, as a function's are.
class Box
  same = <T>(x: T): T -> x
  none = <T>(): T[] -> []

extend<T> T[]
  mapped = <U>(f: (T) -> U): U[] -> [f(x) for x in @]

const b = Box()
print b.same<Int?>(nil) == nil
print b.same<Int?>(1)!
const names = b.none<String>()
names.push 'a'
print names[0]
print [1, 2].mapped<String>((x) -> "#{x}").join(',')
