# The result's type follows the type argument, written or inferred from any part of a parameter's
# type.
class Box
  value: Int

const id = <T>(x: T) -> x
const first = <T>(xs: T[]): T -> xs[0]
const apply = <A, B>(f: (A) -> B, x: A): B -> f(x)
const or_else = <T>(x: T?, fallback: T): T -> x ? fallback
const pair = <T>(a: T, b: T) -> [a, b]

const square = (n: Int) -> n * n
const length_of = (s: String) -> s.binary.length

print id(1) + 1
print id('a') + 'b'
print id(Box(value: 3)).value
print first(['x', 'y'])
print apply(square, 5)
print apply(length_of, 'four')
const missing: Int? = nil
print or_else(missing, 7)
print or_else(8, 9)
print id<Int?>(nil) ? 10
print pair(1, 2).length
const b: Byte = 200
print id<Byte>(100).wrapping_add(b)
