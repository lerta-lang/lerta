# The result's type follows the type argument, written or inferred from any part of a parameter's
# type.
class Box(value: Int)

id := <T>(x: T) -> x
first := <T>(xs: T[]): T -> xs[0]
apply := <A, B>(f: (A) -> B, x: A): B -> f(x)
or_else := <T>(x: T?, fallback: T): T -> x ? fallback
pair := <T>(a: T, b: T) -> [a, b]

square := (n: Int) -> n * n
length_of := (s: String) -> s.binary.length

print id(1) + 1
print id('a') + 'b'
print id(Box(value: 3)).value
print first(['x', 'y'])
print apply(square, 5)
print apply(length_of, 'four')
missing: Int? = nil
print or_else(missing, 7)
print or_else(8, 9)
print id<Int?>(nil) ? 10
print pair(1, 2).length
b: Byte = 200
print id<Byte>(100).wrapping_add(b)
empty_list := <T>(): T[] -> []
xs := empty_list<String>()
xs.push 'a'
print xs[0]
