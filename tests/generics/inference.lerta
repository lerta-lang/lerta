# Each distinct type argument makes an instance; a generic may call another.
class Point
  x: Int
  y: Int
  to_string = -> "(#{@x}, #{@y})"

const show = <T: Stringable>(label: String, x: T) -> print("#{label}: #{x}")
const twice = <T: Stringable>(x: T) ->
  show 'first', x
  show 'second', x

twice 1
twice 'a'
twice Point(x: 1, y: 2)
twice 1
