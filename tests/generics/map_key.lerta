# A type parameter may stand for a map key; its type argument must be a String or an Int.
const keys_of = <K, V>(m: Map<K, V>): K[] -> m.keys().to_array()
const empty = <K, V>(): Map<K, V> -> Map()

print keys_of({ 'a': 1, 'b': 2 }).join(' ')
print keys_of({ 3: 'c' })[0]
print empty<Int, String>().length
