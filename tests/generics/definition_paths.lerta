# Bodies checked at their definitions reach the members of the bounds through methods, calls of
# other generics, extends of interfaces and conversions to interface values.
import Codable from 'std:codable'
import encode_json from 'std:json'

class Box<T: Comparable>
  args
    v: T
  pick := <U>(a: U, b: U) -> @v < @v then a else b

h := <T: Stringable>(x: T) -> "<#{x}>"
g := <T: Stringable>(x: T) -> h(x)
f := <T: Stringable>(x: T) -> g(x)

interface Shape
  area: () -> Int
struct Square: Shape
  side: Int
  area := -> @side * @side
extend Shape
  big := -> @area() > 10
large := <T: Shape>(x: T) -> x.big()

class Named
  args
    name: String
  to_string := -> @name
show := (s: Stringable) -> s.to_string()
shown := <T: Stringable>(x: T) -> show(x)

encoded := <T: Codable>(x: T) -> [encode_json([x]), encode_json({ a: x })]

print Box(1).pick('a', 'b')
print f(1)
print [large(Square(2)), large(Square(4))]
print shown(Named('n'))
print encoded(3)
