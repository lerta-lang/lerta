import parse from 'std:enums'

enum Color
  RED
  BLUE

draw := (p: { x: Int, y: Int }) -> p.x + p.y

twice := <T: Stringable>(x: T) ->
  var count = 0
  add := -> count += 1
  add()
  add()
  c: Color = BLUE
  "#{x}:#{count}:#{c}:#{draw(x: count, y: 1)}:#{[x for _ in 0..2].length}"

print twice(1)
print twice('a')
print twice(true)

maybe := <T>(x: T): T? -> x

describe := <T: Stringable>(x: T) ->
  kept := maybe(x) ? throw ValueError(message: 'nil')
  "#{kept}:#{parse<Color>('RED') ? BLUE}"

print describe(2)
print describe('b')
