enum Color
  RED
  BLUE

const draw = (p: { x: Int, y: Int }) -> p.x + p.y

const twice = <T: Stringable>(x: T) ->
  var count = 0
  const add = () -> count += 1
  add()
  add()
  const c: Color = BLUE
  "#{x}:#{count}:#{c}:#{draw(x: count, y: 1)}:#{[x for _ in 0...2].length}"

print twice(1)
print twice('a')
print twice(true)

const maybe = <T>(x: T): T? -> x

const describe = <T: Stringable>(x: T) ->
  const kept = maybe(x) ? throw ValueError(message: 'nil')
  "#{kept}:#{Color.parse('RED') ? BLUE}"

print describe(2)
print describe('b')
