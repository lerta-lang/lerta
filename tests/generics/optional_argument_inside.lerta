# A type that holds an optional type argument made optional again, but for a result alone, is an
# error at the call, as a caller could not tell its nils apart.
pick := <T>(xs: T[]): (T?, Int) -> (xs[0], 1)
maybe_ints: Int?[] = [nil]
print pick(maybe_ints)[1]
mapped := <T, U>(xs: T[], f: (T) -> U?): Int -> xs.length
print mapped<Int, Int?>([1], (x) -> nil)
given := <T>(x: T?): Bool -> x != nil
maybe: Int? = nil
print given<Int?>(maybe)
or_default := <V>(x: V?, d: V): V -> x else d
print or_default<Int?>(maybe, 3) else 0
