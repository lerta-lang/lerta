# An instance sees the methods of the caller's extends that satisfy its bounds, and those that
# satisfy the bounds of such a generic method in turn, at each type it applies to.
import Box, greet, greet_held, Named from './lib/named'
import greet_relayed from './lib/named_relay'
import shown from './lib/shown'

class C
  args
    n: Int
extend C
  name := -> "C#{@n}"
  to_literal := -> "L#{@n}"
extend<U: Named> U[]
  name := -> [x.name() for x in @].join(',')
extend Int
  name := -> 'one'

print greet([C(1), C(2)])
print greet([[C(3)], [C(4)]])
# The same type argument with another witness makes another instance.
print [greet(1), greet_relayed()]
# A builtin method of the type argument reaches the caller's extends of its items.
print shown([C(5)])
# The bound of a generic class's own method, and a bound that names another type parameter.
print [greet(Box(C(6))), greet(Box([C(7)]))]
struct Held
  held := -> C(8)
print greet_held(Held())
# A method of an extend of the bound, and a generic extend of a map.
extend Named
  shout := -> "#{@name()}!"
extend<U: Named> Map<String, U>
  name := -> [value.name() for value in @values()].join(',')
loud := <T: Named>(x: T) -> x.shout()
print [loud(C(9)), greet({ 'a': C(10) }), loud({ 'b': C(11) })]
