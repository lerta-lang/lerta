# A method of a class or struct may have type parameters of its own, which its arguments give.
class Box
  args
    n: Int
  apply := <T>(f: (Int) -> T): T -> f(@doubled())
  doubled := -> @n * 2
  repeat := <T>(x: T, times: Int): T[] ->
    return [] if times == 0
    rest := @repeat(x, times - 1)
    rest.push x
    rest
  pair := <T>(x: T): T[] -> @repeat(x, 2)

struct Label
  name: String
  show := <T: Stringable>(x: T): String -> "#{@name}: #{x}"

b := Box(2)
print b.apply((x) -> x * 3)
print b.apply((x) -> "s#{x}")
print b.repeat('a', 3).join()
print b.pair(true).length
print Label('one').show(1)
print Label('two').show([1, 2].length)
