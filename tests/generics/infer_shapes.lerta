# Type arguments are inferred through maps, anonymous structs and function types, and a function
# literal's parameters take theirs from the other arguments.
const value_at = <V>(m: Map<String, V>, k: String): V? -> m[k]
const field = <T>(r: { value: T }): T -> r.value
const apply = <T>(f: (T) -> T, x: T): T -> f(x)
const or_else = <T>(a: T?, b: T): T -> a ? b

print value_at({ 'a': 'x' }, 'a') ? 'none'
print field({ value: true })
print apply((x) -> x + 1, 2)
print or_else(nil, 3)
