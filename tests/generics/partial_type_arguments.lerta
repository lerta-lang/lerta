# The first type arguments may be written alone; the others are inferred from the arguments.
first := <T, U>(items: U[]): T? -> nil
convert := <T, U>(value: U, f: (U) -> T): T -> f(value)

extend<T> T[]
  paired := <U, V>(other: V): (U?, V) -> (nil, other)

print first<String>([1, 2]) == nil
print convert<String>(3, (n) -> "#{n * 2}")
print convert<String, Int>(4, (n) -> "#{n}")
(none, other) := [1].paired<Int>('x')
print none == nil
print other
