# A parameter whose type names no type parameter takes its argument as in any call: a call there
# infers its type arguments from the parameter, as `nil`, a member of an enum alone and a function
# literal take their types from it.
enum Color
  RED
  GREEN

const tagged = <T>(value: T, color: Color?, names: String[]) ->
  "#{value} #{color ? RED} #{names.length}"
const empty = <T>(): T[] -> []
const shown = <T>(value: T, show: (Color) -> String) -> "#{value} #{show(GREEN)}"

extend<T> T[]
  painted = (color: Color, names: String[]) -> "#{@length} #{color} #{names.length}"

print tagged(1, GREEN, empty())
print tagged('a', nil, [])
print shown(2, (color) -> color.to_string())
print [1].painted(RED, empty())

# The argument converts to the parameter's type.
interface Shape
  area: () -> Int

struct Square
  side: Int
  area = -> @side * @side

const measured = <T>(value: T, shape: Shape, extra: Int?) -> "#{value} #{shape.area()} #{extra ? 0}"
const maybe: Int? = nil
print measured(1, Square(side: 3), 5)
print measured('a', Square(side: 2), maybe)
