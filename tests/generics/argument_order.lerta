# Arguments with types of their own bind the type arguments first; X? after X makes it X?; the
# expected type of the call helps too.
pick := <T>(a: T, b: T): T -> b
h := <T>(xs: T[], ys: T[]) -> xs.length + ys.length
empty := <T>(xs: T[]): T[] -> xs
o: Int? = nil
i := 4
e := [1, 2]
print pick(o, 3) else 0
print pick(3, o) else 0
print pick(i, o) else 5
print h([], e)
a: String[] = empty([])
a.push 's'
print a[0]
