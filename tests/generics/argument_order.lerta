# Arguments with types of their own bind the type arguments first; X? after X makes it X?; the
# expected type of the call helps too.
const pick = <T>(a: T, b: T): T -> b
const h = <T>(xs: T[], ys: T[]) -> xs.length + ys.length
const empty = <T>(xs: T[]): T[] -> xs
const o: Int? = nil
const i = 4
const e = [1, 2]
print pick(o, 3) ? 0
print pick(3, o) ? 0
print pick(i, o) ? 5
print h([], e)
const a: String[] = empty([])
a.push('s')
print a[0]
