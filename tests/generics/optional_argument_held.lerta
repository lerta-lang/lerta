# An array or a map cannot hold an optional type argument made optional again, which its item
# would not fit.
held_all := <T>(xs: T[]): Int ->
  held: T?[] = [x for x in xs]
  held.push nil
  [h for h in held when h != nil].length

ints: Int?[] = [nil, 1]
print held_all(ints)
names: String?[] = [nil, 'a']
print held_all(names)
counts := <T>(xs: T[]): Int ->
  m: Map<Int, T?>
  m[0] = xs[0]
  m.length

print counts(ints)
