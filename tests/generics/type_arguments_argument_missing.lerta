# A call with type arguments that could not be two comparisons gets no word of them where the call
# that it is passed to lacks an argument: one of one type argument, of a type argument that is no
# bare name, of a callee that is no name, of more than one argument, or of more type arguments
# than the call takes arguments.
class Box
  pair := <A, B>(x: Int) -> x

id := <T>(x: T) -> x
pair := <A, B>(x: Int) -> x
triple := <A, B, C>(x: Int) -> x
pair_of_two := <A, B>(x: Int, y: Int) -> x + y
add := (x: Int, y: Int) -> x + y
box := Box()
print add(id<Int>(1))
print add(pair<Int?, Int>(1))
print add(pair<Int[], Int>(1))
print add(box.pair<Int, Int>(1))
print add(triple<Int, Int, Int>(1))
print add(pair_of_two<Int, Int>(1, 2))
