# `==` of values that hold a type parameter, as an array or a tuple of it, takes the bound that `==`
# of the type parameter itself does, at the definition (see comparable_equals).
unbounded_arrays := <T>(a: T[], b: T[]) -> a == b
unbounded_tuples := <T>(a: (T, Int), b: (T, Int)) -> a == b
unbounded_records := <T>(a: { x: T }, b: { x: T }) -> a == b
unbounded_equals := <T>(a: T[], b: T[]) -> a.equals(b)
unbounded_contains := <T>(a: T[]) -> [a].contains(a)
