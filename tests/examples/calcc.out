@format = private constant [5 x i8] c"%ld\0A\00"
declare i32 @printf(ptr, ...)
define i32 @main() {
  %r1 = mul i64 3, 4
  %r2 = add i64 2, %r1
  %x = alloca i64
  store i64 %r2, ptr %x
  %r3 = load i64, ptr %x
  call i32 (ptr, ...) @printf(ptr @format, i64 %r3)
  %r4 = load i64, ptr %x
  %r5 = sub i64 %r4, 4
  %r6 = sdiv i64 %r5, 2
  %y = alloca i64
  store i64 %r6, ptr %y
  %r7 = load i64, ptr %x
  %r8 = add i64 %r7, 1
  store i64 %r8, ptr %x
  %r9 = load i64, ptr %x
  %r10 = load i64, ptr %y
  %r11 = mul i64 %r9, %r10
  %r12 = sub i64 %r11, 1
  call i32 (ptr, ...) @printf(ptr @format, i64 %r12)
  ret i32 0
}

