class Log
  lines: Array<String>

  add = (line: String) -> @lines.push line

  add_twice = (line: String) ->
    @add line
    @add line

struct Holder
  log: Log

const log = Log(lines: [])
log.add 'one'
log.add_twice "t#{'wo'}"
const holder = Holder(log)
holder.log.add 'three' if log.lines.length > 0
holder.log.add 'never' if false
print line for line in log.lines

const xs: Array<Int> = []
xs.push -1
xs.push (2)
print x for x in xs
