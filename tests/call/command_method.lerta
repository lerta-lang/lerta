class Log
  lines: String[]

  add = (line: String) -> @lines.push line  # fmt: skip

  add_twice = (line: String) ->
    @add line
    @add line

struct Holder
  log: Log

log := Log([])
log.add 'one'
log.add_twice "t#{'wo'}"
holder := Holder(log)
holder.log.add 'three' unless log.lines.is_empty()
holder.log.add 'never' if false
print line for line in log.lines

xs: Int[]
xs.push -1
xs.push (2)  # fmt: skip
print x for x in xs
