# Locals passed to calls, read from, tested against nil and called on are borrowed where they
# cannot change meanwhile, and taken otherwise: each value is released once, and lives as long as
# something holds it.
import platform from 'std:process'

interface Named
  name: String

class Box
  name: String
  label := -> "box #{@name}"
  label_with := (note: String) -> "box #{kept(@).name} #{note}"

class Holder
  weak! box: Box

class Crate
  name: String
  fail := (reason: String): String -> throw ValueError("#{@name}: #{reason}")

struct Pair
  first: Box
  second: Box

describe := (box: Box) -> box.label()
describe_any := (value: Box | Int) -> value is Box then value.name else "int #{value}"
name_of := (named: Named) -> named.name
or_zero := (n: Int?) -> n ? 0
name_or_gone := (box: Box?) -> box?.name ? 'gone'

passes := ->
  box := Box('a')
  print describe(box)
  print describe_any(box)
  print name_of(box)
  print or_zero(7)
  count := 3
  print or_zero(count)
  pair := Pair(first: box, second: box)
  print pair.first.name
  print box.name.binary.length
  maybe: Box? = box
  print maybe != nil
  print maybe == nil
  print describe(maybe) if maybe != nil
  either: Box | Int = box
  print either.name if either is Box
  xs := [1, 2, 3]
  counts := { 'a': 1 }
  print xs.length + counts.length
  holder := Holder(box)
  print holder.box.name
  weak held := box
  print name_or_gone(held)

# A field that every member of a union has, read from a borrowed local, and bytes that outlive
# the String they are read from.
reads := ->
  either: Box | Crate = Crate('crate')
  print either.name
  text := 'kept'
  bytes := text.binary
  print bytes.length

# A method called on a borrowed object throws, from its arguments or its body; an Iter named by a
# local is taken over by next.
throws := ->
  crate := Crate('c')
  try
    print crate.fail(Box('arg').name)
  catch e: ValueError
    print e.message
  try
    print crate.fail(refuse())
  catch e: ValueError
    print e.message
  print crate.name
  items := (x * 2 for x in [1, 2])
  print items.next()
  print items.has_next()

refuse := (): String -> throw ValueError('before the call')

TOP := Box('top')

# A top-level const, of this module or imported, is borrowed in a function too, and still alive
# when a deinit run by the release of a later one at the end of the program borrows it.
use_top := -> print(show_with(TOP, 'in a function'))
use_imported := -> print(kept_text(platform) == platform)
kept_text := (text: String) -> [text][0]

class Witness
  name: String
  deinit := -> print(show_with(KEPT, 'at the end'))

KEPT := Box('kept')
WITNESS := Witness('witness')

# A var that the call assigns, through the closure, is not borrowed: the old value stays alive for
# the call.
changes_meanwhile := ->
  var current = Box('old')
  replace := ->
    current = Box('new')
    'replaced'
  show := (box: Box, note: String) -> "#{box.name} #{note}"
  print show(current, replace())
  print current.name

# A var that no closure captures is borrowed, unless what is evaluated while it is used assigns
# it: the old value stays alive for the call, the method, the index or the assignment.
vars := (replacing: Bool) ->
  var current = Box('old')
  print describe(current)
  shown := show_with(current, case
    when replacing
      current = Box('new')
      'replaced'
    else 'kept'
  )
  print shown
  shown_later := show_after(current, 'then', case
    when replacing
      current = Box('later')
      'replaced'
    else 'kept'
  )
  print shown_later
  print current.name
  labeled := current.label_with(case
    when replacing
      current = Box('newer')
      'replaced'
    else 'kept'
  )
  print labeled
  print current.name
  var boxes = [Box('first')]
  print boxes[case
    when replacing
      boxes = [Box('second')]
      0
    else 0
  ].name
  boxes[0] =
    case
      when replacing
        boxes = [Box('third')]
        Box 'fourth'
      else Box('fourth')
  print boxes[0].name
  var names = { 'a': Box('a') }
  names['a'] =
    case
      when replacing
        names = { 'b': Box('b') }
        Box 'c'
      else Box('c')
  print names.length
  var notes = { 'a': 'note' }
  notes['a', default: ''] +=
    case
      when replacing
        notes = { 'b': 'other' }
        '!'
      else '!'
  print notes.length
  var spares = { 'a': Box('spare') }
  print spares['z', default: case
    when replacing
      spares = { 'b': Box('b') }
      Box('default')
    else Box('default')
  ].name
  var words = ['word']
  words[0] +=
    case
      when replacing
        words = ['other']
        '!'
      else '!'
  print words[0]
  var pair = Pair(first: Box('one'), second: Box('two'))
  shown_first := show_with(pair.first, case
    when replacing
      pair = { first: Box('three'), second: Box('four') }
      'replaced'
    else 'kept'
  )
  print shown_first
  current = renamed(current)
  print current.name

show_with := (box: Box, note: String) -> "#{kept(box).name} #{note}"
show_after := (box: Box, first: String, second: String) -> "#{kept(box).name} #{first} #{second}"
renamed := (box: Box) -> Box("#{box.name}!")
# Retains the box, which the debug runtime checks to be alive.
kept := (box: Box) -> [box][0]

# A top-level var that the call assigns is not borrowed.
var LATEST = Box('first')
replace_latest := (box: Box) ->
  LATEST = Box('next')
  kept(box).name
use_latest := -> print(replace_latest(LATEST))

# A weak! field of a borrowed object whose box is gone throws, and the object is released once.
gone := ->
  holder := Holder(Box('gone'))
  try
    print holder.box.name
  catch e: WeakError
    print e.message

passes()
reads()
throws()
print describe(TOP)
use_top()
use_imported()
print WITNESS.name
print TOP.label()
changes_meanwhile()
vars true
vars false
print replace_latest(LATEST)
use_latest()
gone()
