# fmt: off
struct Options(count: Int = default 1, label = default '-')
const run = (name: String, args: String..., options: Options) ->
  "#{name} #{args} #{options.count} #{options.label}"
const a = run
  'a'
  'x', 'y'
  count: 2
print a
const n = run
  'b', ['z']...
.to_string()
print n
var s = ''
s = run
  'c'
  label: 'q'
print s
const d = run('d')
  'w'
  label: 'r'
print d
const f = (g: (Int) -> Int, n: Int) -> g(n)
const r = f
  (x) ->
    x * 2
  21
print r
const one = (x: Int) -> x + 1
const o = one
  r > 0 then 10 else 20
print o
const add = (x: Int, y: Int) -> x + y
const nested = add
  add
    1, 2
  0
print nested
const sum = (o: { k: Int }) -> o.k
const named = sum
  k: one
    4
print named
class Counter
  total = default 0
  add = (n: Int, m: Int) -> @total += n + m
const counter = Counter()
counter.add
  1
  2
print counter.total
const twice = (n: Int) ->
  return add
    n, n
print twice(3)
const record =
  value: add
    5, 6
print record.value
const text = add
  7, 8
.to_string()
print text
const label = (o: { a: Int, b: Int }) -> "#{o.a}#{o.b}"
const both = label
  a: 1, b: 2
print both
const shout = (x: String, y: String) -> x + y
const loud = shout
  'h'
  'i'
  .to_upper()
print loud
const fail = (n: Int) ->
  throw ValueError
    message: "#{n}"
try
  fail 1
catch e
  print e.message
const counts = (): Iter<Int> ->
  yield add
    1, 1
print [x for x in counts()]
const total = (xs: Int...) -> xs.length
const listed = -> [1, 2]
const pair_of = (a: Int, b: Int) -> [a, b]
const spread = total
  listed()
  .map((x) -> x)...
  pair_of
    3, 4
  ...
print spread
