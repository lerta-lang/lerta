# fmt: off
struct Options(count: Int = default 1, label = default '-')
run := (name: String, args: String..., options: Options) ->
  "#{name} #{args} #{options.count} #{options.label}"
a := run
  'a'
  'x', 'y'
  count: 2
print a
n := run
  'b', ['z']...
.to_string()
print n
var s = ''
s = run
  'c'
  label: 'q'
print s
d := run('d')
  'w'
  label: 'r'
print d
f := (g: (Int) -> Int, n: Int) -> g(n)
r := f
  (x) ->
    x * 2
  21
print r
one := (x: Int) -> x + 1
o := one
  r > 0 then 10 else 20
print o
add := (x: Int, y: Int) -> x + y
nested := add
  add
    1, 2
  0
print nested
sum := (o: { k: Int }) -> o.k
named := sum
  k: one
    4
print named
class Counter
  total = default 0
  add = (n: Int, m: Int) -> @total += n + m
counter := Counter()
counter.add
  1
  2
print counter.total
twice := (n: Int) ->
  return add
    n, n
print twice(3)
record :=
  value: add
    5, 6
print record.value
text := add
  7, 8
.to_string()
print text
label := (o: { a: Int, b: Int }) -> "#{o.a}#{o.b}"
both := label
  a: 1, b: 2
print both
shout := (x: String, y: String) -> x + y
loud := shout
  'h'
  'i'
  .to_upper()
print loud
fail := (n: Int) ->
  throw ValueError
    message: "#{n}"
try
  fail 1
catch e
  print e.message
counts := (): Iter<Int> ->
  yield add
    1, 1
print [x for x in counts()]
total := (xs: Int...) -> xs.length
listed := -> [1, 2]
pair_of := (a: Int, b: Int) -> [a, b]
spread := total
  listed()
  .map((x) -> x)...
  pair_of
    3, 4
  ...
print spread
