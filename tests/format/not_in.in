f := (x: Int, y: Int, xs: Int[], ys: Int[]) ->
  print not (x in xs)
  print not(y in ys)
  print y not in xs
  print not x in ys
  print x in xs and not (y in ys)
  print not (x not in ys)
  print (not (y in xs)) == (x in ys)
  print x in [1, 2] or y in (xs)

g := (in: Int[], is: Int, as: Int) ->
  print(in)
  print(is)
  print(as)
  print(not (1 in in))
  print(in.length)
