# Fields keep their values, while the locals of a method are rewritten; a change whose span holds a
# comment is not made; and `not` stays where the `if` has an `else` or follows one.
class Box
  items: Int[] = []
  var found: Int? = nil
  counts: Map<String, Int> = Map()
  seen := Set<String>()
  show := ->
    local: Int[] = []
    var maybe: Int? = nil
    print local, maybe, @items, @found, @counts, @seen
x: Int | String = 1
y := ((x as Int?  # c
) ? 1)
z := [true then 1 else  # c
  nil]
f := (b: Bool) ->
  if not b
    print 1
  else
    print 2
  if b
    print 3
  else if not b
    print 4
