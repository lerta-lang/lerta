show := (xs: Int[], ys: Int[]) -> print("#{xs} #{ys}")
run := (xs: Int[], n: Int, ms: Int?[]) ->
  a := [
    for x in xs
      x + n + 1
  ]
  b := [
    for x in xs when x > n + 1
      x
  ]
  c := [x * 2 for x at i in xs when i > 0]
  d := [x + 1 for x in xs]
  e := [
    for x in xs when x > 0
      y := x + 1
      y
  ]
  f := [
    for m in ms
      m else continue
  ]
  g := [x + y + n for x in xs for y in xs]
  show [x + n + 1 for x in xs], a
  show
    [
      for x in xs
        x + n + 1
    ]
    b
  h := (x + n + 1 for x in xs).to_array()
  i := (x for x in xs when x > 0).to_array()
  print [a, b, c, d, e, f, g, h, i]
  return [
    for x in xs
      x + n + 1
  ]
print run([1, 2], 0, [3, nil])
grid := (
  for x in 1..3
    (x * y for y in 1..3)
)
print row.to_array() for row in grid
twice := (a: Int, b: Int) -> a + b
printed := (
  for x in [1, 2]
    twice x, x
)
calls := [
  for x in [1, 2]
    twice x, x
]
print [printed.to_array(), calls]
struct Sizes
  widths: Int[]
  label: String
sizes := Sizes
  widths: [
    for x in [1, 2]
      x * 2 + 1
  ]
  label: 'a label that is long enough to keep the arguments of the call on lines of their own'
print sizes.widths
xs := [1, 2]
kept := [
  for x in xs  # a note
    x + 1
]
noted := [
  # a note
  for x in xs
    x
]
both := [
  for x in xs
    [
      for y in xs
        y + 1 + x
    ]
]
keyed := { 'k': [x * 2 + 1 for x in xs] }
iter := (x + 1 for x in xs)
print "#{kept} #{noted} #{both.length} #{keyed['k']!} #{iter.to_array()}"
record :=
  k: [
    for x in xs
      x + 1 + 2
  ]
  name: 'a name that is long enough to keep the fields of the struct on lines of their own'
noted_after := [
  for x in xs
    x + 1 + 2
]  # a note
signs := [
  for x in xs
    x > 1 then x + x else 0
]
a_long_name_for_the_item_too_long_to_be_on_one_line := 3
wide := [
  for a_long_name_for_the_item in [1, 2]
    a_long_name_for_the_item + a_long_name_for_the_item_too_long_to_be_on_one_line
]
print "#{record.k} #{noted_after} #{signs} #{wide}"
a_value_with_a_long_name_for_the_test := 1
another_value_with_a_long_name_for_it := 2
too_wide := [
  x
  for x in xs
  when x > a_value_with_a_long_name_for_the_test and x < another_value_with_a_long_name_for_it
]
grow := (ys: Int[]) -> [y * 2 + 1 for y in ys]
counted := [x * 2 + 1 for x in xs].length
none: Int[]
branched :=
  if counted > 1
    [
      for x in xs
        x * 2 + 1
    ]
  else
    none
print "#{too_wide} #{grow(xs)} #{counted} #{branched}"
