# A comment at the start.

if count > 0  # on the head
  print count

  # deeper than the line after it
else if count < 0
  print -count
# before else
else

  print 0
f := (x) ->
  for y at i in x
    return y unless i

  nil

# The end.
if count
  # before the first statement
  print 1
if count
  print 2
else  # on else
  if count < 0
    print 3
if x
  y := f(1, 2)

  # after a continued line
z := 1
if a
  b := 1
  c := g(1, 2)
if a
  print 1
else
  (p, q) := pair
  print p
