# Each construction of a struct where the struct is expected is written as a record; the others
# keep the name.
import TimeoutError from 'std:async'
import stdout from 'std:io'

struct Point
  x: Int
  y = default 0

struct Line
  from: Point
  to: Point

struct Pair<A, B>
  first: A
  second: B

struct Check
  name: String
  run: () -> Int

class Box
  n: Int

struct Empty
  n = 0

show := (p: Point) -> "#{p.x},#{p.y}"

single: Point = { x: 1 }
maybe: Point? = { x: 2 }
print show({ x: 3, y: 4 })
origin := (): Point -> { x: 0 }
x := 5
print show({ x })
fallback := maybe ? { x: 9 }
keyed: Map<Point, Int> = { { x: 1 }: 2 }
pick := (flag: Bool): Point -> flag then { x: 1 } else { x: 2 }
nudge := (by: Point = { x: 1 }, times = 1) -> by.x * times

made := (make: (Int) -> Point) -> make(1)
print made((n) -> { x: n }).x
chosen: Point =
  case x
    when 5 then { x: 7 }
    else { x: 8 }
# The first arm gives the type of the others without one written.
unwritten :=
  case x
    when 5 then Point(x: 7)
    else Point(x: 8)

class Holder
  point: Point = { x: 3 }
line: Line = { from: { x: 1 }, to: { x: 2 } }
pair: Pair<Int, String> = { first: 1, second: 'one' }
named: Map<String, Point> = { 'a': { x: 6 } }
named['b'] = { x: 6 }

# The type of an array's items that only they give stays with them, and so does a written type
# that gives it.
points: Point[] = [{ x: 1 }, { x: 2 }]
loose := [Point(x: 1), Point(x: 2)]
print points.length + loose.length

# A construction keeps the name where a class, an interface or a union is expected, as the left
# operand of `==`, whose type the right one takes, and in a generic function's code, which is
# checked only for each instance; and so does one without arguments, as `{}` is an empty map.
box := Box(n: 1)
empty := Empty()
error: Error = TimeoutError(message: 'late')
either: Point | Int = Point(x: 7)
print (Point(x: 1) == single).to_string()
wrapped := <T>(value: T): Pair<T, Int> -> Pair(first: value, second: 0)

# A block of arguments, and a function last, whose body takes the lines below.
long: Line =
  from: { x: 111111111111, y: 222222222222 }
  to: { x: 333333333333, y: 444444444444 }  # A comment after the last.
to: Point = { x: 0 }
# A name alone for a field keeps the braces, as a block would read it as an item of an array.
the_widest_line_of_them_all_here: Line = {
  to
  from: { x: 3333333333333333333, y: 4444444444444444444 }
}
checks: Check[] =
  { name: 'one', run: -> 1 }
  { name: 'two', run: ->
    two := 2
    two
  }

# The import of a struct that only constructions used is left out.
var out = stdout
out = { fd: 2 }
print "#{show(single)} #{show(maybe!)} #{show(origin())} #{show(line.to)} #{pair.second}"
print "#{named.length} #{box.n} #{error.message} #{either is Point} #{wrapped(1).first}"
print "#{empty.n} #{long.to.x} #{the_widest_line_of_them_all_here.from.x} #{checks.length}"
print
  "#{out.fd} #{fallback.x} #{keyed.length} #{pick(true).x} #{nudge()} #{Holder().point.x} #{chosen.x} #{unwritten.x}"
