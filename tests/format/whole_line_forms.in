# A form of one line is taken only where all of it fits on the line: a postfix form, a body on the
# line of `->` or of an arm, and a function last in a call with its body inside the brackets.
label := (text: String, size: String) -> text + size
check := (xs: Int[]) ->
  unless xs.all((x) ->
    y := x + 1
    y > 0
  )
    return false
  true
show := (xs: Int[]) ->
  print(x) for x in xs.map((x) ->
    y := x + 1
    y
  )
run := (n: Int, xs: Int[]) ->
  case n
    when 1 then xs.each((x) ->
      y := x + 1
      print y
    )
    else print(0)
nested := (xss: Int[][]) -> xss.map((xs) -> xs.map((x) ->
  y := x + 1
  y
))
sized := (n: Int) ->
  x := label('a', case n
    when 1 then 'one'
    else 'many'
  )
  x
apply := (n: Int, run: (Int) -> Int) -> run(n)
applied := apply(1, run: (x) ->
  y := x + 1
  y
)
count := (xs: Int[]) ->
  var n = 0
  n += 1 while xs.any((x) ->
    y := x + n
    y < 3
  )
  n
usage := -> '''
  text
'''
named := (n: Int) ->
  case n
    when 1 then '''
      one
    '''
    else 'other'
told := (shown: Bool) ->
  print '''
    shown
  ''' if shown
print check([1]), nested([[1]]), sized(1), applied, count([1]), usage(), named(1)
told true
run 1, [1]
show [1]
