# A test that `find` finds nothing, or something, is a test of `any`, of an array, an Iter or a map;
# not of `find` with another value, nor with nil first, nor a call of another `find`.
class Shelf
  find := (test: (Int) -> Bool) -> test(1) then 1
xs := [1, 2, 3]
counts := { 'a': 1 }
print not xs.any((v) -> v > 2)
print xs.any((v) -> v > 2)
print counts.keys().any((k) -> k == 'a')
print not counts.any((entry) -> entry == ('a', 1))
print xs.find((v) -> v > 2) == 3
print nil == xs.find((v) -> v > 2)
print [xs..., 4].any((v) -> v > 2)
print Shelf().find((v) -> v > 0) == nil
