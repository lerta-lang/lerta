# A union on the lines below `=` keeps its lines, one level deeper, with one space around each `|`
# between the members on a line.
type Shape =
  Int | String
  Float | Bool
export type Value =
  Int
  # a comment
  String
v: Value = 1
s: Shape = 2.0
print v, s
type Commented =
  Int | String  # a comment
  Float

type Spaced =

  Int
  String
type Long =
  NamedTypeOfALongNameOne | NamedTypeOfALongNameTwo | NamedTypeOfALongNameThree | FourFiveSix
c: Commented = 1
type Gaps =  # after =
  # before the first
  Int

  String  # one space
g: Gaps = 1
type Joined = Int | String
j: Joined = 1
type TooLong =
  NamedTypeOfALongNameOne | NamedTypeOfALongNameTwo | NamedTypeOfALongNameThree | FourFiveSixSevenEight
  Int
