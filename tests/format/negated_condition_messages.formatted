f := (a: Bool, b: Bool): Int? ->
  return nil if not (a and b)
  var n = 0
  n += 1 while not (a or b)
  return 1 if a
  if not a
    print 1
  else
    print 2
  return 2 unless b
  return 3 if not (a and b)
  return 4 if a or b
  n += 1 until a
  return 5 unless b
  if not (a and b)
    print 3
  else
    print 4
  return 6 if not (a and b)
  n

print f(true, true)
