# A push of each item of an array is written with `append`, of arrays of the same items, where the
# array pushed to runs no code; not a push of something else, of an index, of other items, nor of
# the items of the array itself, which never ends.
class Bag
  var items: Int[] = []
  fill := (from: Int[]) -> @items.append(from)
xs := [1, 2, 3]
var ys: Int[]
ys.append xs
var listed: Int[]
listed.append [4, 5]
var doubled: Int[]
doubled.push x * 2 for x in xs
var floats: Float[]
floats.push x.to_float() for x in xs
var again = [1]
if false
  again.push x for x in again
var places: Int[]
places.push i for x at i in xs
bag := Bag()
bag.fill xs
print "#{ys} #{listed} #{doubled} #{floats} #{places} #{again} #{bag.items}"
