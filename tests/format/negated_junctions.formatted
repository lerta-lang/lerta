# `not` of an `and` or an `or` goes to each operand, as `!=`, `not in` and `is not` where those
# write it, and on into an `and` or an `or` inside; a comparison of order keeps its `not`.
f := (x: Int?, xs: Int[], a: Bool | Int, b: Bool, c: Bool, d: Bool) ->
  return 1 if x != nil and not xs.is_empty()
  return 2 if 1 not in xs or a is not Bool
  return 3 if not b or (x == 1 and 2 in xs)
  return 4 if x == nil or not x > 3
  if not b and x != 5
    print 'neither'
  else
    print 'either'
  return 5 if not b or (not c and (not d or not b))
  return 6 if not b or not (c then d else b)
  if b
    print 'b'
  else if not c or not d
    print 'not both'
  # A double negation, whose `not` of `x is T` the source wrote.
  return 7 if a is not Int and b
  return 8 if not (b and c)  # fmt: skip
  var n = 0
  n += 1 while not n > 3 or not b
  n += 1 while not n > 6 and not c
  n

print f(1, [1], true, true, false, true)
