# A double negation of a Bool in a value is taken out, as in a condition, with the parentheses that
# held the inner negation where they change nothing; that of another type, a Bool, stays.
xs := [1]
flag := true
value: Int | String = 1
print flag
print flag
print xs.is_empty()
print not (not flag).to_string().is_empty()
print value is Int
print 1 in xs
print [flag, not flag]
print not flag
print flag
print [1 in xs, 1 in xs]
print flag and flag
maybe: Int? = 3
print not not maybe
done := false
print 1 if done
print 2 if done
var n = 0
n += 1 while n < 3
print n if done or flag
print 4 unless done
print 5 if value is Int
print 6 if maybe == nil
var m = 0
m += 1 while m < 2
print m
