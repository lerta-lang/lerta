# A construction where its struct is expected, written without parentheses, is only reported, as is
# one of type arguments; the layout gives one after `=` its parentheses, and it is written as a record
# then, but one at the start of a statement keeps its form.
struct Point
  x: Int
  y: Int

struct Pair<A, B>
  first: A
  second: B

p: Point = { x: 1, y: 2 }
make := (n: Int): Point ->
  print n
  Point x: n, y: n
pair: Pair<Int, String> = Pair<Int, String>(first: 1, second: 'a')
print p.x + make(1).y + pair.first
