# A long two-way value or a chain in an interpolation is reported where it is, but not rewritten,
# as the code of an interpolation is kept as written; a short one is not.
ok := true
n := 1
f := (x: Int) -> x
print "v #{ok then n + n + 1 else 0}"
print "v #{ok then 1 else n > 0 then 2 else 3}"
print "v #{ok then n else 0} and #{[ok then 1 else 0][0]}"
print b"v #{ok then n + n + 1 else 0}".length
print "v #{f(ok then n + n + 1 else 0)}"
print "v #{(ok then n + n + 1 else 0)}"
print "v #{"w #{ok then n + n + 1 else 0}"}"
print "v #{ok then n else n + n + 1}"
print "v #{n + n > 1 then n else 0}"
print "v #{(ok then n + n + 1 else nil) else 0}"
print "v #{ok then n + n + 1 else 0} #{ok then n + n + 1 else 0}"
print "v #{ok then (n + n + 1) else 0}"
x := ok then "#{ok then n + n + 1 else 0}" else ''
s := """
  a #{ok then n + n + 1 else 0}
  b #{ok then 1 else n > 0 then 2 else 3}
  """
print x + s

# fmt: off
print "v #{ok then n + n + 1 else 0}"
