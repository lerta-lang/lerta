# A byte that `==` or `!=` compares with a Byte is written as the literal of one byte; not one
# held by a name, which would be a Binary, nor a literal of more bytes, nor one compared with a
# `Byte?`.
bytes := b'ab'
first := bytes[0] == b'a'
second := b'b' != bytes[1]
held := b'a'[0]
longer := bytes[0] == b'ab'[0]
maybe := bytes.get(0)
optional := maybe == b'a'[0]
print "#{first} #{second} #{held} #{longer} #{optional}"
