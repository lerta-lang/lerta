pair := (a: Int, b: Int, o: { c: Int }) -> a + b + o.c
x := pair(1, 2, c: 3)
y := pair(1, 2, c: 3)
print pair, 1, 2, c: 3
pair_of := (a: Int, b: Int) -> [a, b]
count := (xs: Int...) -> xs.length
z := count(pair_of(1, 2)...)
join := (a: String, b: String, c: String, o: { separator: String }) -> a + o.separator + b + c
fits_below :=
  join('the first part of the text', 'the second part of the text', 'the third', separator: ', ')
joined := join
  'the first part of the text'
  'the second part of the text'
  'the third part of the text'
  separator: ', '
join 'the first part of the text', 'the second part of the text', 'the third part', separator: ', '
make := (): String ->
  return join
    'the first part of the text'
    'the second part of the text'
    'the third part of it'
    separator: ''
parts := [
  join('the first part of the text', 'the second part of the text', 'the third', separator: '')
]
later := ->
  join 'the first part of the text', 'the second part of the text', 'the third', separator: ''
same := <T>(a: T, b: T, c: T, d: T) -> a
first := same<String>(
  'the first part of the text'
  'the second part of the text'
  'the third'
  'the fourth'
)
nested := join
  join('the first part of the text', 'the second', 'the third', separator: ', ')
  'b'
  'c'
  separator: ''
four := (a: String, b: String, c: String, d: String) -> a
make_four := (n: Int) -> four
fours := [four]
called := make_four(1)(
  'the first part of the text'
  'the second part of the text'
  'the third part of the text'
  'x'
)
make_four(1)(
  'the first part of the text'
  'the second part of the text'
  'the third part of the text'
  'x'
)
indexed := fours[0](
  'the first part of the text'
  'the second part of the text'
  'the third part of the text'
  'x'
)
grouped := four
  ('the first part' + ' of the text').to_upper()
  ['the second part', ' of the text'].join('')
  'the third part'
  'x'
var assigned = ''
assigned = four
  'the first part of the text'
  'the second part of the text'
  'the third part of the text'
  'x'
aaaaaaaaaaaaaaa := 'a'
packed := four
  aaaaaaaaaaaaaaa, aaaaaaaaaaaaaaa, aaaaaaaaaaaaaaa, aaaaaaaaaaaaaaa, aaaaaaaaaaaaaaa,
  aaaaaaaaaaaaaaa
length := four(
  'the first part of the text'
  'the second part of the text'
  'the third part of the text'
  'x'
).length
class Holder
  run := (a: String, b: String, c: String, d: String) -> a
  call_own := ->
    @run
      'the first part of the text'
      'the second part of the text'
      'the third part of the text'
      'x'
holder: Holder? = Holder()
maybe := holder?.run(
  'the first part of the text'
  'the second part of the text'
  'the third part'
  'x'
)
option := (o: { first_option: String, second_option: String, third_option: String }) ->
  o.first_option
named := option
  first_option: 'the first option value'
  second_option: 'the second option value'
  third_option: 'x'
nums := (xs: Int[], n: Int, f: (Int) -> Int) -> f(n)
mixed := nums([1], 2, (x) -> x)
array_first := nums
  [100000000, 200000000, 300000000, 400000000, 500000000, 600000000, 700000000]
  -100000000
  (x) -> x * 2
