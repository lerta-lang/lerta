# Two or more tests of one value with literals or members of enums, joined by `or` with `==` or by
# `and` with `!=`, in a chain or alone, are a test of a list; not of an item that runs code, nor of
# other values.
enum Color
  RED
  GREEN
  BLUE
class Paint
  color: Color
pick := (n: Int) -> n
LIMIT := 9
check := (color: Color, c: Char, b: Byte, n: Int, s: String, paint: Paint) ->
  print [
    color == RED or color == BLUE
    color != RED and color != GREEN and color != BLUE
    n > 3 or c == 'a' or c == 'b'
    c == 'a' or c == 'b' or n > 3
    (c == 'a' or c == 'b') or n == 4
    b == b'x' or b == 0x20
    n == 1 or n == pick(2)
    s == 'a' or s == 'b'
    paint.color == RED or paint.color == GREEN
    n == 1 or c == 'b'
    n == 1 or n == LIMIT
    n == -1 or n == LIMIT + 1
    n == 1 or n == -2
    n == -LIMIT or n == 1
    n == (LIMIT + 1) * 2 or n == 3
    n != 1 and n != 2 or n == 3
    n == 1 or n == 2 or c == 'a' or c == 'b'
  ]
  print "#{n == 1 or n == 2}"
check GREEN, 'b', 0x20, 7, 'b', Paint(RED)
check RED, 'z', b'y', 3, 'c', Paint(BLUE)
