var found: String? = nil
var count: Int? = 1
none: Int? = nil
var names: String[]? = nil
var kept: Int?
var callback: ((Int) -> Int)? = nil
var pair: (Int, Int)? = nil
type MaybeInt = Int?
var aliased: MaybeInt = nil
var aliased_omitted: MaybeInt
var noted: Int? = nil  # a comment
var close: Int? = nil # one space
var wide: Int? = nil    # four spaces
weakly := ->
  weak var held: String[]? = nil
  held
print "#{found} #{count} #{none} #{names == nil} #{kept} #{noted} #{close} #{wide} " +
  "#{weakly() == nil} #{callback == nil} #{pair == nil} #{aliased} #{aliased_omitted}"
