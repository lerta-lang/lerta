# A two-way value at the end of a function, of a `return` or below its head is `c then a else b`
# where it fits, with the parentheses that a part needs there; not one that gives void, which the
# types tell, nor the `if` of `else if`, one whose branch leaves, or one that a comment deeper than
# `else` below it belongs to.
below := (flag: Bool) ->
  word :=
    if flag
      'yes'
    else
      'no'
  word

returned := (n: Int) ->
  return
    if n > 0
      'positive'
    else
      'not positive'

ended := (n: Int) ->
  if n > 0
    'positive'
  else
    'not positive'

voided := (n: Int) ->
  if n > 0
    print 'positive'
  else
    print 'not positive'

opened := (flag: Bool, n: Int?) ->
  if flag
    n else 0
  else
    1

chained := (n: Int) ->
  if n > 0
    'positive'
  else if n < 0
    'negative'
  else
    'zero'

thrown := (n: Int) ->
  if n > 0
    n
  else
    throw ValueError('not positive')

commented := (n: Int) ->
  if n > 0
    1
  else
    2
    # The last branch.

print below(true)
print returned(1)
print ended(0)
voided 1
print opened(true, nil)
print chained(0)
print thrown(1)
print commented(1)
