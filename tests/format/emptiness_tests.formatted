# A test of a length against 0, or of a String against '', is written with is_empty() where std
# gives the type is_empty; a length of another type, other tests of a length, an optional String and
# an order of Strings keep theirs.
class Box
  length: Int

class Holder
  items: Int[]
  none := -> @items.is_empty()

xs := [1]
none: Int[]
m: Map<String, Int>
s := 'a'
b := s.binary
box := Box(length: 0)
maybe: String? = nil
holder: Holder? = Holder(items: [])
t := 'b'
shape: String | Int = 'c'
print xs.is_empty()
print none.is_empty()
print not xs.is_empty()
print not m.is_empty()
print Set([1]).is_empty()
print s.is_empty()
print not s.is_empty()
print b.is_empty()
print box.length == 0
print maybe == ''
print xs.length == 1
print s > ''
print xs.length >= 1 and m.is_empty()
print [xs.is_empty(), not none.is_empty()][0]
print (s + t).is_empty()
print s + t == ''
print (s + t).binary.is_empty()
print maybe?.binary.length == 0
print holder?.items.length == 0
generic := <T>(ys: T[]) -> ys.length == 0
print generic([1])
print shape is String then shape.binary.is_empty() else false
print xs.length == 0  # fmt: skip
print not xs.is_empty()
print xs.is_empty()  # the length
print xs.is_empty()
alone := -> s.is_empty()
print alone()
made := -> [1]
print made().is_empty()
print holder!.none()
print [x for x in xs when xs.is_empty()]
print [xs.is_empty() for _ in xs]
print "#{xs.length == 0}"
print not m.is_empty() or not b.is_empty()
print xs.is_empty()
print not box.length == 0
print not s.is_empty()
print s.is_empty()
print not xs.is_empty()
print not none.is_empty()
print not (not xs.is_empty()).to_string().binary.length > 10
