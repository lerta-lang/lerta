# A cast that throws, of a value of the type it casts to already, as narrowing makes it, is left
# out; the casts that narrow are kept, as are those in a generic function.
struct Point
  x: Int

struct Circle
  radius: Int

type Shape = Point | Circle

class Holder
  shape: Shape = Point(1)

size := (shape: Shape) ->
  return shape.x if shape is Point
  shape.radius

forced := (shape: Shape) -> (shape as Point!).x
maybe := (shape: Shape) -> (shape as Point?)?.x ? 0
twice := (shape: Shape) ->
  if shape is Circle
    print 'circle'
    return shape.radius
  0
field := (holder: Holder) -> holder.shape is Point then (holder.shape as Point!).x else 0
generic := <T>(shape: Shape, other: T) -> shape is Point then (shape as Point!).x else 0
listed := (shapes: Shape[]) -> [shape.x for shape in shapes when shape is Point]
chosen := (shape: Shape) -> shape is Point then shape else Point(0)
bound := (shape: Shape) ->
  return 0 if shape is not Point
  point := shape
  later := -> shape.x
  point.x + later()
optional := (shape: Shape) ->
  return nil if shape is not Point
  shape as Point!
take := (point: Point) -> point.x
passed := (shape: Shape) ->
  return 0 if shape is not Point
  print take(shape)
  take shape
reassigned := (shape: Shape) ->
  var current = shape
  if current is Point
    current = Circle(2)
    return (current as Circle!).radius
  0
shown := (shape: Shape) -> shape is Point then "#{(shape as Point!).x}" else ''
negated := (shape: Shape) -> shape is Point then -shape.x else 0
nested := (shape: Shape) -> shape is Point then Point(shape.x + 1).x else 0
print size(Point(2)) + size(Circle(3)) + forced(Point(4)) + maybe(Circle(5))
print twice(Circle(6)) + field(Holder()) + generic(Point(7), 1)
print listed([Point(8)])[0]
print chosen(Point(9)).x + bound(Point(10)) + (optional(Circle(1))?.x ? 11)
print passed(Point(12)) + reassigned(Point(1))
print shown(Point(1)) + negated(Point(2)).to_string() + nested(Point(3)).to_string()
