# The type arguments of a call take no space inside their brackets, one after each comma.
print Map<String, Int>().size
print Set<Int>().size, Array<(Int, String)>().length
print Map<String, Array<Int>>().size
first := <T>(xs: T[]) -> xs[0]
print first<Int>([1]), first<Int | String>([1]), first<(Int) -> Int>([(n) -> n])
print first<Int>([1]).abs()
print
  Map<String, Array<(VeryLongTypeNameNumberOne, VeryLongTypeNameNumberTwo, VeryLongTypeName)>>().size
