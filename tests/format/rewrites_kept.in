# Code that the comments mark to keep as it is written keeps its rewrites too, and a statement that
# a rewrite changes reports its layout once it is rewritten; a `;` puts the statement after it on a
# line of its own, in a statement that the walk does not handle too.
x := "a"  # fmt: skip
y := ("b")
z :=  [ "c" ]
class C
  show := ->
    print x, y;  print z
print x, y, z; print  "d"
