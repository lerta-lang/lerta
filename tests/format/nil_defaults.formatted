# A field of an optional type leaves out `= nil` where it is nil without it: a constructor argument,
# of a struct or in `args`, which may be left out, or a class's `var`; but not a class's const
# outside `args`, nor one whose type an alias or a member of a union makes optional.
type MaybeInt = Int?

class Node
  args
    value: Int
    parent: Node?
    var next: Node?
    weak owner: Node?
    aliased: MaybeInt = nil
    either: (Int | String)?
    member: Int | String? = nil
    numbers: Int[]?
    callback: (() -> Int)?
    counts: Map<String, Int>?  # kept as a comment
    counted: Int? = 1
    wrapped: Int?
  fixed: Int? = nil
  var later: Int?

struct Leaf
  label: String?

struct Box<T>
  item: T?

node := Node(1)
print "#{node.parent == nil} #{node.next == nil} #{node.counted ? 0}"
print "#{Leaf().label ? '-'} #{Box<Int>().item ? 0}"
