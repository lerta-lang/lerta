# An index without a start keeps its end `xs.length`, as `xs[..]` is no range; a cast with a
# fallback whose place binds more tightly than `?` keeps its parentheses; a rewrite in the head of a
# statement holds the layout of its head alone, not that of its block; and a line kept as written
# that holds a `;` is not kept.
xs := [1]
ys := xs[..xs.length]
x: Int | String = 1
z := (x as Int?) else x as Int else 0
if (ys == xs)
  w  :=  1
p := [ 1 ]; q := [ 2 ]  # fmt: skip
