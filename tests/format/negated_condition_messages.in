f := (a: Bool, b: Bool): Int? ->
  return nil unless a and b
  var n = 0
  n += 1 until a or b
  return 1 if not not a
  if not a
    print 1
  else
    print 2
  return 2 if not b
  return 3 if not (a and b)
  return 4 unless not (a or b)
  n += 1 while not a
  return 5 if not not not b
  if not (a and b)
    print 3
  else
    print 4
  return 6 unless not not (a and b)
  n

print f(true, true)
