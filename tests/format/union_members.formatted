# The members of unions that are no named types are written as their types are, in type tests and
# casts too.
u: Int[] | (Int, String) | { x: Int } = [1]
print u is (Int, String)
print u is { x: Int }
print u is not Int[]
print (u as Int[]!).length
print (u as Int[] ? [2]).length
v: Int[][] | String = [[1]]
print v.length if v is Int[][]
f := (): Int | (Int, String) -> 1
print f() is Int
