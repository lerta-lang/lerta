class Box
  args
    items: Int[]
  has_item := (n: Int) -> @items.contains(n)

class Odd
  contains := (n: Int) -> n

names := ['a', 'b']
seen: Set<String>
c: Char = 'a'
print names.contains('a')
print not seen.contains('a')
print 'abc'.contains(c)
print names.contains(names[0])
print Box(items: [1]).items.contains(1)
print [names.contains('b'), seen.contains('x') == false]
print Odd().contains(1)
check := <T: Equatable>(xs: T[], x: T) -> xs.contains(x)
print check([1], 1)
maybe: Int[]? = [1]
print maybe?.contains(1) == true

class Halves
  contains := (n: Int) -> n
  items := [1]
  positive := (n: Int) -> @contains(n) > 0

class Bag
  args
    halves: Halves
  contains := (n: Int) -> n == 1
  own := (n: Int) -> @contains(n)

halves := Halves()
bag := Bag(halves)
print halves.contains(1)
print bag.halves.items.contains(1)
print [n for n in [1, 2] when bag.contains(n)]
print "#{bag.contains(1)}"
print bag.contains(1)
print [n for n in [1, 2] when not bag.contains(n)]
print names.contains('a').to_string()
counts := { 'a': 1 }
print [counts.contains('a'), names.contains('c') and true]
numbers := [1]
print numbers.contains(-1)
print 'abc'.contains('bc')
