# A construction where its struct is expected, written without parentheses, is written as a record
# too, with its arguments on its line or in a block below it; one of type arguments is only
# reported.
struct Point
  x: Int
  y: Int

struct Pair<A, B>
  first: A
  second: B

p: Point = Point
  x: 1
  y: 2
make := (n: Int): Point ->
  print n
  Point x: n, y: n
pair: Pair<Int, String> = Pair<Int, String>(first: 1, second: 'a')
print p.x + make(1).y + pair.first
