# The last item and the slice before it are written with `last` and `all_but_last`, of an array
# that runs no code; not another slice, nor of another array, nor of a value that runs code, nor
# the last of optional items, whose nil `!` would take out, nor a place assigned.
xs := [1, 2, 3]
ys := [4, 5]
last := xs.last()!
init := xs.all_but_last()
shorter := xs[..(xs.length - 2)]
inclusive := xs[..=(xs.length - 1)]
crossed := xs[ys.length - 1]
made := [1, 2][[1, 2].length - 1]
bytes := b'ab'
last_byte := bytes[bytes.length - 1]
optional: Int?[] = [1, nil]
var changed = [1, 2]
changed[changed.length - 1] = 3
changed[changed.length - 1] += 1
var rows = [[1], [2]]
rows.last()!.push(3)
last_optional := optional[optional.length - 1]
print "#{last} #{init} #{shorter} #{inclusive} #{crossed} #{made}"
print "#{last_byte} #{last_optional else 0} #{changed} #{rows}"
