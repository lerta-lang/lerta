# A program that does not check tells no results: a call at the start of a statement takes its
# arguments without parentheses, but one that may be a result, in the last statement of a function
# or of an arm of one, keeps them as written, of a function of no value too, which no type tells.
g := (x: Int) -> x
k := (): Int ->
  bad := 1 + 's'
  print(bad)
  g(2)
m := (flag: Bool): Int ->
  bad := 1 + 's'
  if flag
    g(bad)
  else
    g 3
n := (x: Int): Int ->
  bad := 1 + 's'
  case x
    when 1 then g(1)
    else
      g(bad)
t := (): Int ->
  bad := 1 + 's'
  try
    g(bad)
  catch _
    g(0)
u := ->
  bad := 1 + 's'
  print(bad)
class Box
  args
    x: Int
  get := (): Int ->
    bad := 1 + 's'
    g(bad)
extend Int
  doubled := (): Int ->
    bad := 1 + 's'
    g(bad)
each := (f: (Int) -> Int) -> f(1)
nested := each((x) -> g(x))
w := (): Int ->
  bad := 1 + 's'
  each((x) ->
    print(x)
    g(bad)
  )
print(g(1))
