# An `if` that gives a value goes on the line below what takes it, one level deeper, its blocks
# below it as those of a statement.
flag := true
label := if flag
  'yes'
else
  'no'
var count = 0
count =
  if flag
      1
  else if label == 'no'
    2
  else
    3
m := { 'a': 1 }
text :=
  if v := m['a']
    "#{v}"
  # none
  else
    'none'
print label, count, text
outer := if flag
  inner := if flag
    1
  else
    2
  inner
else
  0
joined := if flag
  1
else
  if label == 'no'
    2
  else
    3
print outer, joined
count += if flag
  1
else
  2
r :=
  a: if flag
    1
  else
    2
tail := if flag
  1
else
  2
  # tail
split := if flag
  1
else
  y := 2
  if flag
    y
  else
    3
print count, r, tail, split
