# A `'''` literal before the last argument ends its line with its closing quotes, after which no
# argument goes: the arguments go in a block, or on lines of their own in the parentheses; a
# literal last stays on the line of the call.
label := (text: String, size: String) -> text + size
labeled := label
  text: '''
    text
  '''
  size: 'a'
print label('''
  text
''', 'a')
print 'a', '''
  text
'''
texts := ['''
  first
''', 'b']
trimmed := label('''
  text
'''.trim(), 'a')
print 'first argument of a long call', 'second argument of a long call', 'third argument of the call', '''
  text
'''
record := { text: '''
  text
''', size: 1 }
print labeled, texts, trimmed, record.size
