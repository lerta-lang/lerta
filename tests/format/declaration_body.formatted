struct Box
  x: Int

extend Box
  check = ->
    _y := @x

f := ->
  _x := 1

g := (y: Int) ->
  case y
    when 1 then print('one')
    else print('other')

h := ->
  try
    print 'a'
  catch _
    print 'b'

below := ->
  var _z = 2

mapped := [1].map((x) ->
  _w := x
)

commented := ->
  # note
  _v := 1

trailing := ->
  _u := 1  # note
