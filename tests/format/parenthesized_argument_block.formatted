# Arguments each on a line in parentheses lose them, on the line of the callee where they fit, and
# in a block below it otherwise.
plot := (p: { x: Int, y: Int }) -> print(p.x + p.y)
plot x: 2, y: 3
plot
  x: 1_000_000_000_000 + 2_000_000_000_000 + 3_000_000_000_000 + 4_000_000_000_000
  y: 5_000_000_000_000 + 6_000_000_000_000 + 7_000_000_000_000 + 8_000_000_000_000
sum := (a: Int, b: Int) -> print(a + b)
if true
  sum
    1_000_000_000_000 + 2_000_000_000_000 + 3_000_000_000_000 + 4_000_000_000_000
    5_000_000_000_000 + 6_000_000_000_000 + 7_000_000_000_000 + 8_000_000_000_000
mixed := (a: Int, p: { x: Int, y: Int }) -> print(a + p.x)
mixed 1, x: 2, y: 3
plot
  x: 1_000_000_000_000 + 2_000_000_000_000 + 3_000_000_000_000 + 4_000_000_000_000
  y: 5_000_000_000_000 + 6_000_000_000_000 + 7_000_000_000_000 + 8_000_000_000_000
sum 1, 2
later := -> plot(x: 2, y: 3)
later()
