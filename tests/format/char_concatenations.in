# A Char added to a String is added itself, not its to_string(); not another type's, nor a Char on
# the left, whose `+` takes an Int.
c: Char = 'b'
n := 3
var text = 'a'
text += c.to_string()
text = text + c.to_string()
text += n.to_string()
cs: Char[] = ['x']
text = text + 'c' + cs[0].to_string()
shown := c.to_string() + text
print "#{text} #{shown}"
