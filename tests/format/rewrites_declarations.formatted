# Nil initial values and Empty initial values: a `var` of a type written optional leaves out
# `= nil`, and a const or a `var` leaves out an empty value that its type gives.
type MaybeInt = Int?
var found: String?
var aliased: MaybeInt = nil
var noted: Int?  # a comment
none: Int? = nil
numbers: Int[]
lengths: Map<String, Int>
names: Set<String>
twice: Set<String>
other: Set<Int> = Set<String>()
var growing: Int[]
maybe: Int[]? = []
print found, aliased, noted, none, numbers, lengths, names, twice, other, growing, maybe
