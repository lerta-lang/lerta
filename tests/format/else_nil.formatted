flag := true
value: Int? = 2
nil_or := (n: Int) -> n
or_zero := (n: Int?) -> n ? 0
plain := flag then 1
nested := flag then (value != nil then 1 else 2)
var count = 0
count = next while next := count < 2 then count + 1
kept := flag then 1 else nil_or(3)
neither := flag then nil else 4
chained := flag then 1 else value != nil then 2
unchanged := 0
parenthesized := flag then 1
passed := or_zero(flag then 2)
coalesced := flag then 2 else nil ? 0
commented := flag then 1  # a comment
print
  "#{plain} #{nested} #{kept} #{neither} #{count} #{parenthesized} #{passed} #{chained} " +
    "#{commented} #{coalesced} #{unchanged}"
