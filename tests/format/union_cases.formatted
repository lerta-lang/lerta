# A case of types that gives `true` in one arm and `false` otherwise, as a statement or as the whole
# value of one, is a test of their union; not one of values, of more arms, of `nil`, or with a
# comment, which would have no place in the test.
class A
  args
    n: Int

class B
  args
    n: Int

class C
  args
    n: Int

class Box
  args
    item: A | B | C
  get := -> @item

enum Color
  Red
  Green

value_of := (v: A | B | C) -> v is A | B

negated := (v: A | B | C) -> v is not C

returned := (v: A | B | C) ->
  print 'returned'
  v is A

declared := (v: A | B | C) ->
  x := v is A | B
  x

boxed := (box: Box) -> box.item is A

called := (box: Box) -> box.get() is B | C

maybe := (v: (A | B)?) -> v is not A

indexed := (vs: (A | B | C)[]) -> vs[0] is C

long := (v: A | B | C) -> v is A | B

built_in := (v: Int | String) -> v is Int

unwrapped := (v: (A | B)?) ->
  case v!
    when A then true
    else false

trailing := (v: A | B | C) ->
  case v
    when A then true  # Only A.
    else false

named := (v: A | B | C, x: Bool) -> v is A then x else false

colored := (c: Color) ->
  case c
    when Red then true
    else false

two_arms := (v: A | B | C) ->
  case v
    when A then true
    when B then false
    else false

same := (v: A | B | C) ->
  case v
    when A then true
    else true

optional := (v: (A | B)?) ->
  case v
    when nil then true
    else false

commented := (v: A | B | C) ->
  case v
    # Only A.
    when A then true
    else false

print value_of(A(1))
print negated(C(1))
print returned(B(1))
print declared(C(1))
print boxed(Box(A(1)))
print called(Box(A(1)))
print maybe(nil)
print indexed([C(1)])
print long(B(1))
print built_in(1)
print unwrapped(A(1))
print trailing(A(1))
print named(A(1), true)
print colored(Green)
print two_arms(A(1))
print same(A(1))
print optional(nil)
print commented(A(1))
