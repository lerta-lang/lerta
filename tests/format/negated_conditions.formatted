struct A
  x: Int

f := (x: Int?, a: A | Int, xs: Int[]) ->
  return 0 unless x
  return 1 if x == 2
  return 2 if x != nil
  return 3 if x > 9
  print 'in' unless x in xs
  print 'is' unless a is A
  print 'and' if not (x > 1 and x < 3)
  return 4 if not (x > 1 or x < 0)
  print 'equal' unless x == 5
  if not x
    print 'else'
  else
    print 'not'
  if x == 6
    pass
  else if not x > 7
    print 'else if'
  print 'unless' if x == 8
  print 'kept' unless x
  var n = 0
  n += 1 until n > 3
  while n < 9
    n += 1
    print n
  n = 1 until n
  n += 1 until n >= 20
  y := not not x
  return 5 if not not x  # fmt: skip
  n
