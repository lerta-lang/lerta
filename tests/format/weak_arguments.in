class Source
  listen = (f: (Int) -> void) -> f(1)
  run = (f: () -> void) -> f()
  pair = (f: () -> void, n: Int) -> f()

class Counter
  source = Source()
  total = 0
  init = ->
    @source.run weak ->
      @total += 1
      @total += 2
    @source.listen weak (n) ->
      @total += n
      @total += 1
    @source.run(weak -> @total += 3)
    @source.listen(weak (n) -> @total += n)
    print(@source.listen(weak (n) -> @total += n))
    const done = @source.run(weak -> @total += 4)
    @source.pair(weak -> @total += 5, 6)
