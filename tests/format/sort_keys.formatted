# A comparison of the same path of fields of both items is written with `sorted_by` and `sort_by`;
# not one of other paths, in the other order, of a method's result, nor that of a value not an
# array.
struct Point
  x: Int
  y: Int
struct Box
  corner: Point
class Shelf
  sorted := (compare: (Point, Point) -> Ordering) -> [1]
points: Point[] = [{ x: 2, y: 1 }, { x: 1, y: 2 }]
by_x := points.sorted_by((a) -> a.x)
typed := points.sorted_by((a) -> a.y)
wrapped := points.sorted_by((a) -> a.x)
mixed := points.sorted((a, b) -> a.x.compare(b.y))
descending := points.sorted((a, b) -> b.x.compare(a.x))
itself := points.sorted((a, b) -> a.x.compare(a.x))
boxes: Box[] = [{ corner: { x: 1, y: 1 } }]
by_corner := boxes.sorted_by((p) -> p.corner.x)
var sorted = points
sorted.sort_by (a) -> a.y
words := ['b', 'a']
by_length := words.sorted((a, b) -> a.count().compare(b.count()))
shelved := Shelf().sorted((a, b) -> a.x.compare(b.x))
print "#{by_x} #{typed} #{wrapped}"
print "#{itself} #{mixed} #{descending} #{by_corner} #{sorted} #{by_length} #{shelved}"
