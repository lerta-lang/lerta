class Counter
  args
    label: String
    private key := 'k'
    # the salt
    private salt := 's'
  private var count = 0

  private step := ->
    @count += 1
    @count += 1
  show := -> print("#{@label} #{@key}#{@salt} #{@count}")
  private
    only := ->
      print 1
      print 2
  x := 1
  private
    a := 1
  private b := 2
