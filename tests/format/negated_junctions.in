# `not` of an `and` or an `or` goes to each operand, as `!=`, `not in` and `is not` where those
# write it, and on into an `and` or an `or` inside; a comparison of order keeps its `not`.
f := (x: Int?, xs: Int[], a: Bool | Int, b: Bool, c: Bool, d: Bool) ->
  return 1 unless x == nil or xs.is_empty()
  return 2 unless 1 in xs and a is Bool
  return 3 if not (b and (x != 1 or 2 not in xs))
  return 4 unless x != nil and x > 3
  if not (b or x == 5)
    print 'neither'
  else
    print 'either'
  return 5 if not (b and (c or (d and b)))
  return 6 if not (b and (c then d else b))
  if b
    print 'b'
  else if not (c and d)
    print 'not both'
  # A double negation, whose `not` of `x is T` the source wrote.
  return 7 if not not (not (a is Int) and b)
  return 8 if not (b and c)  # fmt: skip
  var n = 0
  n += 1 while not (n > 3 and b)
  n += 1 until n > 6 or c
  n

print f(1, [1], true, true, false, true)
