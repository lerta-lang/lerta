# A range is written `a..b` for `a...(b + 1)` where its ends are integers, and an index by one
# leaves out a start 0 and an end that is the length of what it indexes, written the same and
# running no code, but the start of a range with no end; others keep theirs.
n := 3
xs := [1, 2, 3, 4]
ratio := 0.5
print [i for i in 1...(n + 1)]
print xs[0...(n + 1)]
print xs[0...2]
print xs[0..2]
print xs[1...xs.length]
print xs[0...xs.length]
print xs[1..xs.length]
print [[1]][0][1...[1].length]
print ratio in 0.0...(ratio + 1)
print n in 0...(n + 1)
print xs[1...(n + 2)]
