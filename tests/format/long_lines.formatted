# Lines over 100 columns that the formatter keeps, but for their indentation, are reported where
# they pass 100 columns, to be shortened by hand: a comment, a string, a name; not those kept as
# written, one that the formatter breaks, nor one that a rewrite left to be done by hand shortens.
# a comment that runs on and on a comment that runs on and on a comment that runs on and on a comment that runs on and on
text := 'a long string a long string a long string a long string a long string a long string a long string '
a_name_that_goes_on_and_on_a_name_that_goes_on_and_on_a_name_that_goes_on_and_on_a_name_that_goes_on_and_on_end :=
  1
kept := 'kept as it is kept as it is kept as it is kept as it is kept as it is kept as it is kept as it is '  # fmt: skip
broken :=
  1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000,
  1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000
if text.is_empty()
  # a comment that the formatter indents anew, a comment that the formatter indents anew, which is still too long
  print 'empty'
# xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé
# fmt: off
skipped := 'kept as it is kept as it is kept as it is kept as it is kept as it is kept as it is kept as it is '

# fmt: on
if text.is_empty()
  # yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
  print 'one space short'
flag := text.is_empty()
two_way := flag then 'a value that is long enough for this line to run well past the limit, on either line' else 'other'
print
  text.length +
    a_name_that_goes_on_and_on_a_name_that_goes_on_and_on_a_name_that_goes_on_and_on_a_name_that_goes_on_and_on_end +
    kept.length +
    broken.length
