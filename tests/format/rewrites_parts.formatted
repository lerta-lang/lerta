# Rewrites inside the parts that are no places of their own: the element and the guard of a
# comprehension, a callee and the value of an `is` test; rewrites whose brackets span lines that
# the layout joins; cast fallbacks; values kept; and a block that `# fmt: skip` keeps.
ys := [1]
xs := [2]
print [x not in xs for x in ys when x not in ys]
g := (-> 1)()
f := -> 1
a: Int | String = 1
h := (a as Int else f)()
print (a is not Int) is Bool
v := 1 not in xs
u := print(1 + 2)
b := (a as Int?) else 1 == 1
c := a as Int else 1 + 1
var o: (Int | String)? = nil
n: Map<String, Int> = Map<String, Float>()
if not (1 in xs)  # fmt: skip
  print "kept"
