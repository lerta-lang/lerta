# A field of an optional type leaves out `= nil` where it is nil without it: a constructor argument,
# of a struct or in `args`, which may be left out, or a class's `var`; but not a class's const
# outside `args`, nor one whose type an alias or a member of a union makes optional.
type MaybeInt = Int?

class Node
  args
    value: Int
    parent: Node? = nil
    var next: Node? = nil
    weak owner: Node? = nil
    aliased: MaybeInt = nil
    either: (Int | String)? = nil
    member: Int | String? = nil
    numbers: Int[]? = nil
    callback: (() -> Int)? = nil
    counts: Map<String, Int>? = nil  # kept as a comment
    counted: Int? = 1
    wrapped: Int? = (nil)
  fixed: Int? = nil
  var later: Int? = nil

struct Leaf
  label: String? = nil

struct Box<T>
  item: T? = nil

node := Node(value: 1)
print "#{node.parent == nil} #{node.next == nil} #{node.counted else 0}"
print "#{Leaf().label else '-'} #{Box<Int>().item else 0}"
