# A postfix form whose head takes more than its line is reported, left to be done by hand, as a
# block form's head cannot take its lines.
first_big := (xs: Int[], ok: Bool) ->
  return nil if xs.any((x) ->
    y := x + 1
    y > 2
  )
  return nil if ok and xs.all((x) ->
    y := x + 1
    y > 0
  )
  xs[0]
count_down := (n: Int) ->
  var i = n
  i -= 1 while i > 0 and [1, 2].any((x) ->
    y := x + i
    y > 5
  )
  i
total := (a: Int, b: Int) -> a + b
small := (n: Int) ->
  return 0 if total(n, 1) > 9
  n
print small(3)
print first_big([1], true) else 0
print count_down(9)
