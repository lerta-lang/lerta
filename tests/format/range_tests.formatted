# Two comparisons of a value that runs no code with the ends of a range are written as a test of the
# range, after the `and`s before them, where the value is a number or a Char; the comparisons in the
# other order, an end that runs code, a start that excludes, values written otherwise and other
# types keep theirs.
n := 5
m := 7
c: Char = 'q'
s := 'q'
ratio := 0.5
end := -> 9
byte: Byte = b'q'
y := 4
print n in 1..=9
print n in 1..9
print n in 1..=9
print 9 > n and 1 <= n
print m > 0 and n in 1..=9
print c in 'a'..='z'
print ratio in 0.0..1.0
print n >= 1 and n <= end()
print n > 1 and n <= 9
print n >= 1 and m <= 9
print s >= 'a' and s <= 'z'
print n in 0..=5 and y in 1..9
print byte in b'0'..=b'9'
print n in 1..9
print n in end()..=9
print n > 1 and n < 9
