# Each member of an enum that can be written alone, where its enum is expected, is; the others keep
# their enums.
enum Color
  RED
  GREEN
  BLUE
  PURPLE
  '('

struct Pixel
  color: Color = default RED
  kind = Color.GREEN

paint := (color: Color, fallback: Color = BLUE) -> color == RED then fallback else color

next := (color: Color): Color ->
  case color
    when RED then GREEN
    when GREEN then return BLUE
    else RED

pick := (flag: Bool): Color? -> flag then RED else nil

var current: Color = RED
current = GREEN
kept := Color.BLUE
print paint(GREEN).to_string()
print next(RED).to_string()
print Pixel(color: BLUE).color.to_string()
print (Color.RED == current).to_string()
print (current != BLUE).to_string()
print [current, BLUE].length.to_string()
print { first: current }.first.to_string()
print kept.to_string()
print (pick(true) == RED).to_string()
print "#{next(Color.GREEN)}"
colors: Color[] = [RED]
counts := { Color.RED: 1 }
plain := (color: Color = GREEN) -> color
print "#{colors.length} #{counts[RED]!} #{plain()}"
# A comment before the member.
current = BLUE  # A comment after it.

# A name that something else takes keeps its enum.
shadowed := (RED: Int) ->
  GREEN := 'green'
  var color = current
  color = Color.RED
  color = Color.GREEN
  "#{RED} #{GREEN} #{color}"
print shadowed(1)

# The code of a generic function is checked only for each instance. A call of one writes alone
# the arguments of the parameters whose types name no type parameter.
same := <T>(value: T, color: Color) -> color == Color.RED
print same(Color.GREEN, RED).to_string()

extend<T> T[]
  tinted = (color: Color) -> color == Color.GREEN
print [1].tinted(GREEN).to_string()

class Box<T>
  item: T
  color: Color = Color.RED
  tint = (): Color -> Color.GREEN
print Box(1).tint().to_string()

# So does a name taken by a top-level declaration below.
later := (): Color -> Color.PURPLE
print later().to_string()
PURPLE := 3
print PURPLE

# Members of two enums of the same name, each where its enum is expected.
enum Shade
  RED
  DARK

both := (color: Color, shade: Shade) -> color == RED and shade == RED
print both(RED, DARK).to_string()

looked_up := (color: Color?, counts: Map<Color, Int>) ->
  counts[RED] = 1
  shades := [Shade.DARK]
  shades.push RED
  case
    when color == GREEN then Color.BLUE
    else color ? GREEN
print looked_up(nil, Map()).to_string()

places := (colors: Color[], optional: Color?) ->
  names := { Color.RED: 'red' }
  var count = 0
  count += 1 while colors[count] != GREEN
  kinds := [colors.contains(Color.RED) for _ in colors when optional == BLUE]
  print found.to_string() if found := optional == nil then Color.RED
  known: Map<String, Color> = { 'first': BLUE }
  case optional
    when RED then 'red'
    else "#{count} #{kinds.length} #{names.length} #{known.length}"
print places([RED, GREEN], nil)

guarded := (): Color ->
  inner := (color: Color) -> color
  try
    inner GREEN
  catch _: Error
    RED
  finally
    print inner(BLUE).to_string()
print guarded().to_string()

# Neither is an element of a comprehension, whose lazy functions share it.
repeated: Color[] = [Color.RED for _ in 0...2]
print repeated.length.to_string()

order: Ordering = LESS
print order.to_string()
