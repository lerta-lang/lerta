# Each form that a rewrite of the formatter writes otherwise, changing the syntax tree, beside the
# form that it writes: they give the same values.

# Runs a test at once, and prints its name once it has passed.
test := (name: String, body: () -> void) ->
  body()
  print name

test 'a Binary literal gives the bytes of the text of the string', ->
  n := 2
  ratio := 1.5
  assert 'ab'.binary == b'ab'  # fmt: skip
  assert "v#{n}".binary == b"v#{n}"  # fmt: skip
  assert "#{n}".binary == b"#{n}"  # fmt: skip
  assert "#{ratio}".binary == b"#{ratio}"  # fmt: skip
  assert 'é'.binary == b'é'  # fmt: skip
  assert '😀'.binary == b'😀'  # fmt: skip

test 'a range up to an end plus one is the range that includes the end', ->
  n := 2
  assert [i for i in 0..(n - 1 + 1)] == [i for i in 0..=(n - 1)]  # fmt: skip
  assert [i for i in 1..(n + 1)] == [i for i in 1..=n]  # fmt: skip

test 'a then value without else is nil where else nil is', ->
  flag := false
  with_else := flag then 1 else nil  # fmt: skip
  without := flag then 1
  assert with_else == without

test 'a declaration without its empty value starts empty', ->
  empty: Int[] = []  # fmt: skip
  given: Int[]
  names := Set<String>()  # fmt: skip
  counts: Map<String, Int> = Map()  # fmt: skip
  assert empty == given
  assert names.is_empty()
  assert counts.is_empty()

test 'a condition without its double negation holds where it did', ->
  holds := (x: Int?) ->
    if not not (x == nil)  # fmt: skip
      return 'nil'
    unless x != 3  # fmt: skip
      return 'three'
    'other'
  assert holds(nil) == 'nil'
  assert holds(3) == 'three'
  assert holds(1) == 'other'

test 'a value without its cast to the type that it has is the value', ->
  shape: Int | String = 1
  if shape is Int
    assert (shape as Int!) + 1 == shape + 1  # fmt: skip

enum Color
  RED
  GREEN

struct Point
  x: Int

struct Pair
  x: Int
  y: Int

struct Defaulted
  label: String? = default nil  # fmt: skip

struct Plain
  label: String?

class Linked<T>
  value: T
  var next: Linked<T>? = default nil  # fmt: skip
  weak owner: Linked<T>? = default nil  # fmt: skip
  item: T? = default nil  # fmt: skip

class Bare<T>
  value: T
  var next: Bare<T>?
  weak owner: Bare<T>?
  item: T?

test 'a member alone or a record where its type is expected is the member or the construction', ->
  color: Color = Color.RED  # fmt: skip
  point: Point = Point(x: 1)  # fmt: skip
  assert color == RED
  assert point == { x: 1 }

test 'a field without its nil default takes nil where its argument is left out', ->
  assert Defaulted().label == Plain().label
  assert Defaulted(label: 'a').label == Plain(label: 'a').label
  linked := Linked(1)
  bare := Bare(1)
  assert linked.next == nil and bare.next == nil and linked.owner == nil and bare.owner == nil
  assert linked.item == bare.item
  assert Linked(value: 1, item: 2).item == Bare(value: 1, item: 2).item

test 'a named argument written as the name alone is that argument', ->
  x := 1
  y := 2
  assert Pair(x: x, y: y) == Pair(x, y)  # fmt: skip
  assert Pair(x: x, y: 3) == Pair(x, y: 3)  # fmt: skip

test 'an emptiness test with is_empty holds where that of its length or of the empty text did', ->
  xs := [1]
  none: Int[]
  s := ''
  assert (xs.length == 0) == xs.is_empty()  # fmt: skip
  assert (none.length > 0) == (not none.is_empty())  # fmt: skip
  assert (s == '') == s.is_empty()  # fmt: skip
  assert ('' != s) == (not s.is_empty())  # fmt: skip

test 'a membership test with in holds where contains does', ->
  names := ['a']
  assert names.contains('a') == ('a' in names)  # fmt: skip
  assert names.contains('b') == ('b' in names)  # fmt: skip

test 'an is test of a union holds where one of its members does', ->
  values: (Int | String | Bool)[] = [1, 'a', true]
  for v in values
    assert (v is Int or v is String) == (v is Int | String)  # fmt: skip
    assert (v is not Int and v is not String) == (v is not Int | String)  # fmt: skip

test 'a value taken apart itself gives what the const that held it gave', ->
  # fmt: off
  held := 'a=b'.split_once('=')!
  (key, value) := held
  # fmt: on
  (same_key, same_value) := 'a=b'.split_once('=')!
  assert (key, value) == (same_key, same_value)

test 'an index without its bounds, or a range to an end plus one in a test, is the same', ->
  xs := [1, 2, 3]
  n := 1
  assert xs[0..2] == xs[..2]  # fmt: skip
  assert xs[1..xs.length] == xs[1..]  # fmt: skip
  assert (n in 0..(n + 1)) == (n in 0..=n)  # fmt: skip

test 'a declaration without the type that its value has holds the same value', ->
  typed: Int = 1  # fmt: skip
  untyped := 1
  assert typed == untyped

test 'a function without the types that it infers gives the same results', ->
  typed := [1, 2].map((x: Int): Int -> x + 1).to_array()  # fmt: skip
  untyped := [1, 2].map((x) -> x + 1).to_array()
  assert typed == untyped

test 'a Map or a Set with the type arguments of its declaration holds the same type', ->
  var typed: Set<String> = Set()  # fmt: skip
  var untyped: Set<String>
  typed.add 'a'
  untyped.add 'a'
  assert typed.to_array() == untyped.to_array()

struct Held
  value: Int
  label := 'held'

test 'a construction of its one argument by its name constructs what its value alone does', ->
  named := Held(value: 1)  # fmt: skip
  alone := Held(1)
  assert named.value == alone.value and named.label == alone.label

test 'the comparison that sorted takes by default sorts as none does', ->
  given := [3, 1, 2].sorted((a, b) -> a.compare(b))  # fmt: skip
  assert given == [3, 1, 2].sorted()

test 'Set() of an array of an Iterable holds what Set() of the Iterable does', ->
  counts := { 'b': 1, 'a': 2 }
  arrayed := Set(counts.keys().to_array())  # fmt: skip
  assert arrayed.to_array() == Set(counts.keys()).to_array()

test 'a Char added to a String appends what its to_string() does', ->
  c: Char = 'é'
  assert 'a' + c.to_string() == 'a' + c  # fmt: skip

test 'a test that find finds none tells what any does', ->
  xs := [1, 2, 3]
  assert (xs.find((x) -> x > 2) != nil) == xs.any((x) -> x > 2)  # fmt: skip
  assert (xs.find((x) -> x > 5) == nil) == (not xs.any((x) -> x > 5))  # fmt: skip
