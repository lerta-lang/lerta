# An `else` whose block holds one `if` joins it as `else if`, but not where a comment follows the
# `if` in the block, which would go into the block of the last branch.
flag := true
if flag
  print 1
else
  if flag
    print 2
  else
    print 3

  # after the if
if flag
  print 4
else if flag
  print 5
print 6
if flag
  if flag
    print 7
  else
    print 8

  # after the inner if
print 9
if flag
  print 10
else if flag
  print 11

  # inside the branch
if flag
  if flag
    if flag
      print 12

      # three levels deep
    # between levels
print 13
if flag
  print 14
else if flag
  print 15

  # at an odd column
print 16
