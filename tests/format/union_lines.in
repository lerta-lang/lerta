# A union on the lines below `=` keeps its lines, one level deeper, with one space around each `|`
# between the members on a line, and breaks a line that does not fit before the first member that
# does not fit on it, as it breaks a union on the line of `=` that fits on no line.
type Shape =
    Int |  String
    Float|Bool
export type Value =
  Int
  # a comment
  String
v: Value = 1
s: Shape = 2.0
print v, s
type Commented =
  Int | String   # a comment
  Float

type Spaced =

  Int
  String
type Long = NamedTypeOfALongNameOne | NamedTypeOfALongNameTwo | NamedTypeOfALongNameThree | FourFiveSix
c: Commented = 1
type Gaps =  # after =
  # before the first
  Int

  String # one space
g: Gaps = 1
type Joined =
  Int | String
j: Joined = 1
type TooLong =
  NamedTypeOfALongNameOne | NamedTypeOfALongNameTwo | NamedTypeOfALongNameThree | FourFiveSixSevenEight
  Int
type Longer = NamedTypeOfALongNameOne | NamedTypeOfALongNameTwo | NamedTypeOfALongNameThree | NamedTypeOfALongNameFour | NamedTypeOfALongNameFive | Int
t: TooLong = 1
l: Longer = 1
type Exact =
  NamedTypeOfALongNameOne | NamedTypeOfALongNameTwo | NamedTypeOfALongNameThree | FourFiveSixSevenEi
  Int
type Unspaced =
  NamedTypeOfALongNameOne|NamedTypeOfALongNameTwo|NamedTypeOfALongNameThree|FourFiveSixSevenEight
  Int
type Huge =
  Int | NamedTypeOfAVeryVeryVeryVeryVeryVeryVeryVeryVeryVeryVeryVeryVeryVeryVeryVeryVeryVeryVeryLongName | Bool
  Float
nested := ->
  type Inner = NamedTypeOfALongNameOne | NamedTypeOfALongNameTwo | NamedTypeOfALongNameThree | FourFiveSixSevenEight
  i: Inner = 1
  print i
type Ending =
  NamedTypeOfALongNameOne | NamedTypeOfALongNameTwo | NamedTypeOfALongNameThree | FourFive  # a comment
  Int
misindented := ->
    type Deep =
          NamedTypeOfALongNameOne | NamedTypeOfALongNameTwo | NamedTypeOfALongNameThree | FourFiveSix
          Int
    d: Deep = 1
    print d
