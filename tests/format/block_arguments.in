const pair = (a: Int, b: Int, o: { c: Int }) -> a + b + o.c
const x = pair
  1, 2
  c: 3
const y = pair(1)
  2
  c: 3
print pair
  1
  2
  c: 3
const pair_of = (a: Int, b: Int) -> [a, b]
const count = (xs: Int...) -> xs.length
const z = count
  pair_of
    1, 2
  ...
const join = (a: String, b: String, c: String, o: { separator: String }) -> a + o.separator + b + c
const fits_below = join('the first part of the text', 'the second part of the text', 'the third', separator: ', ')
const joined = join('the first part of the text', 'the second part of the text', 'the third part of the text', separator: ', ')
join('the first part of the text', 'the second part of the text', 'the third part', separator: ', ')
const make = (): String ->
  return join('the first part of the text', 'the second part of the text', 'the third part of it', separator: '')
const parts = [join('the first part of the text', 'the second part of the text', 'the third', separator: '')]
const later = -> join('the first part of the text', 'the second part of the text', 'the third', separator: '')
const same = <T>(a: T, b: T, c: T, d: T) -> a
const first = same<String>('the first part of the text', 'the second part of the text', 'the third', 'the fourth')
const nested = join(join('the first part of the text', 'the second', 'the third', separator: ', '), 'b', 'c', separator: '')
const four = (a: String, b: String, c: String, d: String) -> a
const make_four = (n: Int) -> four
const fours = [four]
const called = make_four(1)('the first part of the text', 'the second part of the text', 'the third part of the text', 'x')
make_four(1)('the first part of the text', 'the second part of the text', 'the third part of the text', 'x')
const indexed = fours[0]('the first part of the text', 'the second part of the text', 'the third part of the text', 'x')
const grouped = four(('the first part' + ' of the text').to_upper(), ['the second part', ' of the text'].join(''), 'the third part', 'x')
var assigned = ''
assigned = four('the first part of the text', 'the second part of the text', 'the third part of the text', 'x')
const aaaaaaaaaaaaaaa = 'a'
const packed = four(aaaaaaaaaaaaaaa, aaaaaaaaaaaaaaa, aaaaaaaaaaaaaaa, aaaaaaaaaaaaaaa, aaaaaaaaaaaaaaa, aaaaaaaaaaaaaaa)
const length = four('the first part of the text', 'the second part of the text', 'the third part of the text', 'x').length
class Holder
  run = (a: String, b: String, c: String, d: String) -> a
  call_own = -> @run('the first part of the text', 'the second part of the text', 'the third part of the text', 'x')
const holder: Holder? = Holder()
const maybe = holder?.run('the first part of the text', 'the second part of the text', 'the third part', 'x')
const opts = (o: { first_option: String, second_option: String, third_option: String }) -> o.first_option
const named = opts(first_option: 'the first option value', second_option: 'the second option value', third_option: 'x')
const nums = (xs: Int[], n: Int, f: (Int) -> Int) -> f(n)
const mixed = nums([1], 2, (x) -> x)
const array_first = nums([100000000, 200000000, 300000000, 400000000, 500000000, 600000000, 700000000], -100000000, (x) -> x * 2)
