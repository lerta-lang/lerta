# A fallback in the value of a `then` keeps its parentheses, without which its `else` would end the
# value.
c := true
x: Int? = 1
y: Int? = 2
print c then (x else 0) else 9
print c then -(y else 0) else 0
print (x else 0) + 1
shape: Int | String = 'x'
print c then (shape as Int else 4) else 9
print c then (x else 0) > 1 else false
