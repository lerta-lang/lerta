# Nil initial values and Empty initial values: a `var` of a type written optional leaves out
# `= nil`, and a const leaves out an empty value that its type gives.
type MaybeInt = Int?
var found: String? = nil
var aliased: MaybeInt = nil
var noted: Int? = nil  # a comment
none: Int? = nil
numbers: Int[] = []
lengths: Map<String, Int> = Map()
names := Set<String>()
twice: Set<String> = Set<String>()
other: Set<Int> = Set<String>()
var growing: Int[] = []
maybe: Int[]? = []
print found, aliased, noted, none, numbers, lengths, names, twice, other, growing, maybe
