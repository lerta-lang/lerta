# The rewrites of arms write a program that parses: `then` on a line of its own goes once the
# patterns join it; a call that goes on the line of `then` keeps its parentheses; and a `try` or a
# `case` after `then` goes in the block of the arm, with its own blocks.
f := (n: Int) -> n
kind := (word: String) ->
  case word
    when 'one'
      n := 1
      "number #{n}"
    else 'other'
log: String[]
record := (item: Int) ->
  case item
    when 1 then log.push('one')
    when 2 then log.push('two')
tried := (n: Int) ->
  case n
    when 1
      try
        f 1
      catch _
        2
    else 3
nested := (n: Int) ->
  case n
    when 1
      case n
        when 1 then 'one'
        else 'other'
    else 'none'
own_line := (word: String) ->
  case word
    when 'one'
      try
        f 1
      catch _
        2
    else 3
trailing := (n: Int) ->
  case n
    when 1
      try
        # before the call
        f 1
      catch _
        2

        # trailing in catch
    # before the next arm
    else 3
record 1
print kind('one'), tried(1), nested(1), own_line('one'), trailing(1)
