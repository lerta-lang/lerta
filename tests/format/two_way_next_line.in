# A long two-way value whose `else` or `then` value, its last value's fallback, an operand or a
# function's body is on the next line is reported, as one over several lines is; a short one is
# only joined to its line.
c := true
x := c then 1 + 2 + 3 else
  2
print x
y := c then
  1 + 2 + 3 else 2
print y
f := (): Int? -> nil
z := c then 1 + 2 + 3 else f() else
  4
print z
w := c then 1 else
  2
print w
v := c then 1 + 2 +
  3 else 2
print v
u := c then [1,
  2, 3] else
  [0]
print u
g := (n: Int) -> n
h := c then g else (n: Int) ->
  n * 2 * 3
print h(1)
xs := [1]
t := c then 1 + 2 <= 4 else 4 <=
  5
print t
s := c then 1 + 2 in xs else 3 in
  xs
print s
r := c then c and c and
  c else c
print r

struct Box<T>
  v: T

o: Box<Int> | Int = Box(1)
q := c then 1 + 2 + 3 > 0 else o is Box<Int>
print q
