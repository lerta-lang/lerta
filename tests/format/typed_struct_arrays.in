# A variable or a field without a type whose value is an array of a struct takes the type, and the
# constructions in it are written as records; the items of the same type that are not constructions
# stay as they are.
import 'std:io' as io
import FileStatus as Status from 'std:io'
struct Point
  x: Int
  y := default 0

struct Pair<A, B>
  first: A
  second: B

struct Named
  name: String

origin := -> Point(x: 0)
p := Point(x: 9)

loose := [Point(x: 1), Point(x: 2, y: 3)]
mixed := [origin(), Point(x: 1), p]
var changing = [Point(x: 1)]
changing = [Point(x: 2)]
block :=
  Named(name: 'the first of the names, which is long enough to keep the items in a block')
  Named(name: 'the second')
long := [
  Point(
    x: 111111111111111111
    y: 222222222222222222
  )
  origin()
  Point(x: 333333333333333333, y: 444444444444444444)
]

kind := io.stat('.')!.kind
statuses := [io.FileStatus(kind, size: 1, modified_time: 0.0)]
# The type names the struct as the first construction does.
aliased := [Status(kind, size: 2, modified_time: 0.0), io.FileStatus(kind, size: 3, modified_time: 0.0)]  # A comment.
make := ->
  local := [Point(x: 1), origin()]
  local.length

class Holder
  points := [Point(x: 1), origin()]
  defaults := default [Point(x: 2)]

# Not an array without a construction, nor one of a construction of no argument, or of a value
# alone; nor one of a generic struct, whose type arguments the type would need; nor one whose type
# is written or expected.
again := [origin(), p]
names := [Named('a'), Named('b')]
pairs := [Pair(first: 1, second: 'one')]
written: Point[] = [Point(x: 1)]
nested := [[Point(x: 1)]]
print "#{loose.length} #{mixed.length} #{changing.length} #{block.length} #{long.length}"
print Holder().points.length + Holder().defaults.length + make()
print "#{statuses[0].size} #{aliased.length}"
print "#{again.length} #{names.length} #{pairs.length} #{written.length} #{nested.length}"
