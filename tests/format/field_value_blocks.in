# The value of a field, a map entry or a named argument in a block is written as after `key:`: a
# literal that does not fit on the line goes in a block below it without brackets.
config :=
  name: 'lerta'
  targets:
    'x86_64-unknown-linux-gnu'
    'aarch64-apple-darwin'
    'x86_64-w64-mingw32'
    'i686-w64-mingw32'
    'aarch64-unknown-linux-gnu'
bracketed :=
  name: 'lerta'
  targets: ['x86_64-unknown-linux-gnu', 'aarch64-apple-darwin', 'x86_64-w64-mingw32', 'i686-w64-mingw32']
build := (o: { targets: String[] }) -> o.targets.length
count := build
  targets: ['x86_64-unknown-linux-gnu', 'aarch64-apple-darwin', 'x86_64-w64-mingw32', 'i686-w64-mingw32']
short :=
  name: 'lerta'
  description: 'a language whose record is too long to be written on one line'
  targets: ['linux', 'macos']
nested :=
  outer:
    inner:
      targets: ['x86_64-unknown-linux-gnu', 'aarch64-apple-darwin', 'x86_64-w64-mingw32', 'i686-w64-mingw32']
fits := build(targets: ['linux', 'macos'])
flat := { name: 'lerta', targets: ['x86_64-unknown-linux-gnu', 'aarch64-apple-darwin', 'x86_64-w64-mingw32'] }
other := build(targets: ['bsd'])
by_key := { 'targets': ['x86_64-unknown-linux-gnu', 'aarch64-apple-darwin', 'x86_64-w64-mingw32', 'i686-w64-mingw32'], 'b': ['c'] }
print "#{config.name} #{bracketed.name} #{count} #{short.name} #{nested.outer.inner.targets.length}"
print "#{flat.name} #{fits} #{other} #{by_key.length}"
