# A long two-way value whose `else` or `then` value, its last value's fallback, an operand or a
# function's body is on the next line is reported, as one over several lines is; a short one is
# only joined to its line.
c := true
x :=
  if c
    1 + 2 + 3 + 4 + 5
  else
    2
print x
y :=
  if c
    1 + 2 + 3 + 4 + 5
  else
    2
print y
f := (): Int? -> nil
z :=
  if c
    1 + 2 + 3 + 4 + 5
  else
    f() else 4
print z
w := c then 1 else 2
print w
v :=
  if c
    1 + 2 + 3 + 4 + 5
  else
    2
print v
u :=
  if c
    [1, 2, 3]
  else
    [0, 0, 0]
print u
g := (n: Int) -> n
h :=
  if c
    g
  else
    (n: Int) -> n * 2 * 3
print h(1)
xs := [1]
t :=
  if c
    1 + 2 + 3 <= 4
  else
    4 <= 5
print t
s :=
  if c
    1 + 2 + 3 in xs
  else
    3 in xs
print s
r :=
  if c
    c and c and c and c and c
  else
    c
print r

struct Box<T>
  v: T

o: Box<Int> | Int = Box(1)
q :=
  if c
    1 + 2 + 3 > 0
  else
    o is Box<Int>
print q
