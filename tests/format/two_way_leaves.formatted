# A two-way value of more than six leaves, its condition and its values together, is an `if`, with
# `else nil` for one without `else`, and a chain of them a `case`, where a block can take it: as the
# value of a declaration, an assignment or a `return`, whose branches then return, or as a
# statement, on a line of its own or below the head of a body or an arm. Elsewhere it is only
# reported.
f := (n: Int, ok: Bool, xs: Int[]) ->
  short := ok then n else 0
  in_test := n in xs then n else 0
  long :=
    if ok
      xs.length + n + n + n + 1
    else
      0
  var assigned = 0
  assigned =
    if n > 0 and ok and n < 9
      n
    else
      0
  without_else :=
    if ok
      xs.map((x) -> x + n + n + 1).to_array()
    else
      nil
  chained :=
    case
      when n < 0 then 'negative'
      when n == 0 then 'zero'
      else 'positive'
  print [short, in_test, long, assigned, without_else?.length else 0, chained.count()]
  print
    if ok
      xs.length + n + n + n + 1
    else
      0
  print
    if ok
      xs.length + n + n + n + 1
    else
      0
  print
    case
      when ok then 1
      when n > 0 then 2
      else 3
  if n > 5
    return
      if ok
        xs.length + n + n + n + 1
      else
        0
  if ok
    xs.length + n + n + n + 1
  else
    n * 2
g := (n: Int) ->
  if n > 0
    n.to_string().count() + n + n + n + 1
  else
    n
h := (n: Int) ->
  case n
    when 1
      if n > 0
        g(n + n + 1)
      else
        g(-n)
    else
      case
        when n < 0 then g(n)
        when n == 0 then 0
        else g(-n)
r := (n: Int) ->
  if n != 3
    return
      if n > 0
        g n + n + 1
      else
        g -n
  return
    if n > 0
      g n + n + n + 1
    else
      nil
print [f(1, true, [1]), h(1), r(2) else 0]
k := (n: Int, ok: Bool, s: String, p: Int?, v: Int | String) ->
  interpolated := ok then "#{n} and #{s} and #{n}" else ''
  tested := v is Int then 1 else 0
  cast := ok then v as Int?
  member := ok then p?.to_string().count() else 0
  inner :=
    if ok
      (m: Int) ->
        if m > 0
          m + n + n + n + 1
        else
          0
    else
      nil
  chained :=
    case
      when n < 0 then 'negative'
      when n == 0 then 'zero'
      else nil
  commented :=
    if ok
      n + n + n + n + 1
    else
      0  # a comment after it
  tail :=
    if ok
      0
    else
      s.count() + n + n + n + 1
  wrapped := (ok then n + n + n + n + 1 else 0) + 1
  mapped := [n].map((v) ->
    if ok
      v + v + v + v + 1
    else
      v
  )
  condition_wrapped :=
    if ok
      n + n + n + n + 1
    else
      0
  chained_value :=
    case
      when n < 0 then 'negative'
      when n == 0 then 'zero'
      else nil
  annotated: Int =
    if ok
      n + n + n + n + 1
    else
      0
  var compound = 0
  compound +=
    if ok
      n + n + n + n + 1
    else
      0
  coalesced :=
    if ok
      p
    else
      p else n + n + n + n + 1
  listed := [ok then n + n + n + n + 1 else 0]
  returning := (m: Int) ->
    return
      if ok
        m + n + n + n + 1
      else
        0
  case n
    when 1
      compound =
        if ok
          n + n + n + n + 1
        else
          0
    else pass
  stays :=
    if n > 0
      s.count() + n + n + n + 1
    else
      0
  texts := [interpolated, chained else '', inner then "#{inner(1)}" else '']
  print [
    texts.length
    tested
    cast else 0
    member else 0
    commented +
      stays +
      tail +
      compound +
      (coalesced else 0) +
      listed[0] +
      returning(1) +
      wrapped +
      annotated +
      mapped.to_array()[0] +
      condition_wrapped +
      (chained_value else '').count()
  ]
k 1, true, 'a', 2, 3
fallen := (c: Bool, a: Int, x: Int?) ->
  y :=
    if c
      a + a + a + a + a
    else
      x else 1
  z :=
    if c
      1
    else
      x else a + a + a + a + a
  y + z
print fallen(true, 1, nil)
long_fallen := (c: Bool, x: String?) ->
  text :=
    if c
      'a long text that runs the line past its width, so far'
    else
      x else 'and some more ' + 'text' + ' ' + 'here'
  print text
long_fallen false, nil
risen := (p: Bool?, a: Int, b: Int) ->
  x :=
    if p else false
      a + a + a + a + a
    else
      b
  y :=
    case
      when p else false then a
      when p else true then b
      else a + a + a + a + a
  x + y
print risen(nil, 1, 2)

# Six leaves in all fit, however the parts share them, and seven do not; `nil` after `else`, which
# is left out, counts none.
shared := (n: Int) ->
  six := n + n + n > 0 then n else 0
  seven :=
    if n + n + n > 0
      n + n
    else
      0
  six_and_nil := n + n + n > 0 then n + n
  seven_and_nil :=
    if n + n + n > 0
      n + n + n
    else
      nil
  print [six, seven, six_and_nil else 0, seven_and_nil else 0]
shared 1

# A two-way value that holds another, but in the body of a function, is an `if`, and one that is
# the body of an arm goes in its block, but not one of a function.
nesting := (n: Int, ok: Bool, xs: Bool[]) ->
  nested :=
    if ok
      n > 0 then 1
    else
      2
  joined :=
    if ok
      n > 0 then 1
    else
      2
  in_function := ok then xs.map((x) -> x then 1)
  armed :=
    case n
      when 1
        ok then 2
      else
        ok then 3 else 4
  body := -> ok then 1 else 2
  after_function :=
    if ok
      pair -> 1, ok then 2
    else
      nil
  print [nested, joined, armed, body()], in_function, after_function
nesting 1, true, [true]
pair := (f: () -> Int, n: Int?) -> n
