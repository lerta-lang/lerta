# Member lines after an operation apply to the whole of it, and stay lines, one level deeper:
# joined, they would apply to its last operand; after parentheses, they are joined as any others.
b := 'x'
c := 'y'
size := b + c
  .binary.length
count := b + c
  .byte_count()
print size + count
grouped := (b + c).byte_count()
print grouped
n := -2
negated := -n
  .abs()
print negated
lines := b + c
  .binary
  .length
print lines
text := b + c
  .byte_count().to_string()
print text
