class Node(label: String)

TOP := 'top'
print TOP
export twice := (n: Int) -> n * 2
print twice(1)
widened: Int? = twice(1)
print widened ? 0
names: String[]
print names
{ label } := Node(label: 'a')
print label
(first, second) := (1, 2)
print first
(third, fourth) := (3, 4)
print third + fourth
var (fifth, sixth) = (5, 6)
print fifth + sixth
value := first + second
print value
print found if found := widened
var rest: Int? = 1
rest = nil while n := rest
watch := (held: Node) ->
  weak seen := held
  print seen?.label ? 'gone'
print second
