# A function literal keeps the parentheses that end it before what follows it on its line, as a
# postfix `if`, which its body would take otherwise.
mk := (n: Int): ((Int) -> Int) ->
  return ((m) -> m) if n > 0
  (m) -> n + m
print mk(1)(2)
fs := [((m) -> m), (k) -> k]
print fs.length
m := { 'a': ((k: Int) -> k) }
c := true then ((k: Int) -> k) else (k: Int) -> k + 1
print m.size, c(1)
