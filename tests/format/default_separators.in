# The `''` that `join` takes by default is left out, of strings or chars, in an array or an Iter;
# not another separator.
words := ['a', 'b']
joined := words.join('')
spaced := words.join(' ')
chars := (c for c in 'ab').join('')
letters := ['a', 'b'].join('')
doubled := words.join("")
print "#{joined} #{spaced} #{chars} #{letters} #{doubled}"
