# Each difference, apart from the others by lines that stay as they are, is reported under a rule;
# a comment before it names the rule that it breaks, which some reports do not give yet (see
# Reports by rule in docs/roadmap/programs.md).
x := 1
a := 1
b := 2
n := 1

# Shorthand.
p := { x, y: 2 }
print p.x

# Spacing.
g := (v: Int) -> v + 1
print g(1)

# Spacing.
f := (c: Int, d: Int) -> c + d
called := f(
  1
  # the second
  2 + 3
)
print called

# Long lists, as `case` takes a line of its own.
xs :=
  1
  case n
    when 1 then 2
    else 3
print xs

# Spacing, then Function bodies.
sum := 1 + 2
h := -> print(sum)
h()

# Branches, then Spacing.
if n == 1
  print 1
else if n == 2
  print 2

# Spacing.
c := (a + b) * 3
print c

# Spacing.
show := (label: String, value: Int) -> print(label.count() + value)
if a > 0
  show 'a value long enough that the postfix form of the statement does not fit on the line', a

# Spacing, after a space that Function bodies decides.
k := (v: Int) -> v + 1
print k(1)

# Long lists, as the argument goes on a line of its own.
if a > 0
  print
    'a value long enough that the postfix form of the statement does not fit on the line, ' + 'a'

# Spacing.
valued :=
  case n
    when 1
      e := 1 + 2
      e
    else 3
print valued

# Layout, inside the literal.
text := ->
  written := '''
    a

    b
    '''
  written
print text()

# Emptiness tests, inside a body on the line of `->`.
class Holder
  items: Int[]
  none := -> @items.is_empty()

# Multi-line literals, then Line length.
build := (o: { targets: String[], name: String }) -> o.targets.length
count := build
  name: 'a'
  targets:
    'x86_64-unknown-linux-gnu'
    'aarch64-apple-darwin'
    'x86_64-w64-mingw32'
    'i686-w64-mingw32'
first := 'the first part of a text that is long enough'
moved :=
  name: 'moved'
  text:
    first + ' and then ' + first + ', which is long enough for the line' + ' and the next one too'
print count + moved.text.count()
