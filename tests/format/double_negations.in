# A double negation of a Bool in a value is taken out, as in a condition, with the parentheses that
# held the inner negation where they change nothing; that of another type, a Bool, stays.
xs := [1]
flag := true
value: Int | String = 1
print not not flag
print not (not flag)
print not not (xs.length == 0)
print not (not flag).to_string().is_empty()
print not value is not Int
print not 1 not in xs
print [not not flag, not flag]
print not not not flag
print not not not not flag
print [not not (1 in xs), not (not (1 in xs))]
print not not flag and flag
maybe: Int? = 3
print not not maybe
done := false
print 1 unless not done
unless not done
  print 2
var n = 0
until not (n < 3)
  n += 1
print n unless not (done or flag)
print 4 unless not not done
print 5 unless value is not Int
print 6 unless not (maybe == nil)
var m = 0
m += 1 until not (m < 2)
print m
