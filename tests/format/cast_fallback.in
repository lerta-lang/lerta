struct A(x: Int)
struct B(y: Int)
type AB = A | B

f := (v: AB, w: AB, flag: Bool) ->
  a := (v as A?) ? return
  b := (w as B?) ? B(y: 0)
  print a.x, b.y
  print [v as A ? A(x: 1), (w as A?) ? A(x: 2)]
  print ((v as A ? A(x: 2)).x > 0) or flag
  print ((v as A?) ? A(x: 3)) == A(x: 3)
  print v as A ? return

struct Box<T>(value: T)
type Boxes = Box<Int> | Box<String>

g := (b: Boxes, v: AB, w: AB) ->
  print ((b as Box<Int>?) ? Box(value: 0)).value
  print (v as A?) ? (w as A?) ? A(x: 0)
  print (v as A ? A(x: 1)) ? A(x: 2)
  print v as A ?A(x: 4)
