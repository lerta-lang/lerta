# A case of types that gives `true` in one arm and `false` otherwise, as a statement or as the whole
# value of one, is a test of their union; not one of values, of more arms, of `nil`, or with a
# comment, which would have no place in the test.
class A
  args
    n: Int

class B
  args
    n: Int

class C
  args
    n: Int

class Box
  args
    item: A | B | C
  get := -> @item

enum Color
  Red
  Green

value_of := (v: A | B | C) ->
  case v
    when A, B then true
    else false

negated := (v: A | B | C) ->
  case v
    when C then false
    else true

returned := (v: A | B | C) ->
  print 'returned'
  case v
    when A then return true
    else return false

declared := (v: A | B | C) ->
  x :=
    case v
      when A, B then true
      else false
  x

boxed := (box: Box) ->
  case box.item
    when A then true
    else false

called := (box: Box) ->
  case box.get()
    when B, C then true
    else false

maybe := (v: (A | B)?) ->
  case v
    when A then false
    else true

indexed := (vs: (A | B | C)[]) ->
  case vs[0]
    when C then true
    else false

long := (v: A | B | C) ->
  case v
    when A,
      B then true
    else false

built_in := (v: Int | String) ->
  case v
    when Int then true
    else false

unwrapped := (v: (A | B)?) ->
  case v!
    when A then true
    else false

trailing := (v: A | B | C) ->
  case v
    when A then true  # Only A.
    else false

named := (v: A | B | C, x: Bool) ->
  case v
    when A then x
    else false

colored := (c: Color) ->
  case c
    when Red then true
    else false

two_arms := (v: A | B | C) ->
  case v
    when A then true
    when B then false
    else false

same := (v: A | B | C) ->
  case v
    when A then true
    else true

optional := (v: (A | B)?) ->
  case v
    when nil then true
    else false

commented := (v: A | B | C) ->
  case v
    # Only A.
    when A then true
    else false

print value_of(A(1))
print negated(C(1))
print returned(B(1))
print declared(C(1))
print boxed(Box(A(1)))
print called(Box(A(1)))
print maybe(nil)
print indexed([C(1)])
print long(B(1))
print built_in(1)
print unwrapped(A(1))
print trailing(A(1))
print named(A(1), true)
print colored(Green)
print two_arms(A(1))
print same(A(1))
print optional(nil)
print commented(A(1))
