# Arms next to each other whose bodies are written alike are one arm of their patterns, where the
# subject narrowed to the union of their types checks the same; not those with a comment from the
# line where they start, nor a nil arm, nor those whose body would give another type.
struct Point(name: String, x: Int)

struct Circle(name: String, r: Int)

class Label(name: String)

struct Whole(v: Int)

struct Part(v: Float)

type Shape = Point | Circle | Label | Int

type Number = Point | Int | Float

type Round = Circle | Label

enum Color
  RED
  GREEN
  BLUE

describe := (shape: Shape) ->
  case shape
    when Point, Circle, Label then shape.name
    else 'n'

sized := (shape: Shape) ->
  case shape
    when Point then 1
    # circles too
    when Circle then 1
    when Label, Int then 2

kinds := (n: Int?) ->
  case n
    when 1, 2 then 'one'
    when nil then 'none'
    when 3 then 'none'
    else 'many'

fields := (shape: Shape) ->
  case shape
    when Point then "#{shape.x}"
    when Circle then "#{shape.r}"
    else ''

value := (number: Whole | Part) ->
  case number
    when Whole then "#{number.v}"
    when Part then "#{number.v}"

blocks := (shape: Shape) ->
  case shape
    when Point, Circle
      print 'a point'
      0
    else 1

cast := (shape: Shape) ->
  case shape
    when Point, Circle then (shape as Point!).name
    else 'n'

twice := (shape: Shape) ->
  case shape
    when Point, Circle then 1
    when Label, Int then 2

aliased := (shape: Shape) ->
  case shape
    when Point, Round then shape.name
    else 'n'

commented := (shape: Shape) ->
  case shape
    when Point
      # the name
      shape.name
    when Circle then shape.name
    else 'n'

colors := (color: Color) ->
  case color
    when RED then 'warm'
    when GREEN, BLUE then 'cool'

last := (shape: Shape) ->
  case shape
    when Point then 0
    when Circle, Label then 1
    else 2

made := (): Shape -> Point(name: 'm', x: 0)
called := ->
  case made()
    when Point, Circle then 'p'
    else 'n'

equal := (number: Number) ->
  case number
    when Int then number == 1
    when Float then number == 1
    else false

nested := (shape: Shape, other: Shape) ->
  case shape
    when Point, Circle
      case other
        when Point, Circle then 'p'
        else 'o'
    else 'n'

inner := (number: Number, other: Shape) ->
  case number
    when Int
      print number == 1
      case other
        when Point, Circle then 'p'
        else 'o'
    when Float
      print number == 1
      case other
        when Point, Circle then 'p'
        else 'o'
    else 'n'

declared := (number: Number) ->
  case number
    when Int
      copy := number
      copy == 1
    when Float
      copy := number
      copy == 1
    else false

maybe := (shape: Shape?) ->
  case shape
    when Point, Circle then 'p'
    when nil then 'none'
    else 'o'

three := (number: Number) ->
  case number
    when Point then number == number
    when Int then number == 1
    when Float then number == 1

generic := <T>(number: Number, other: T) ->
  case number
    when Int then number == 1
    when Float then number == 1
    else false

uncalled := <T>(number: Number, other: T) ->
  case number
    when Int then number == 1
    when Float then number == 1
    else false

second := (shape: Shape, number: Number) ->
  case shape
    when Point
      print 'p'
      0
    when Circle
      case number
        when Int then number == 1
        when Float then number == 1
        else false
    else 1

ended := (n: Int) ->
  case n
    when 1 then 'a'  # one
    when 2 then 'a'
    else 'b'

ended_block := (n: Int) ->
  case n
    when 1  # one
      'a'
    when 2 then 'a'
    else 'b'

trailing := (n: Int) ->
  case n
    when 1 then 'a'
    when 2
      'a'
      # trailing
    else 'b'

opened := (n: Int) ->
  case n
    when  # one
      1
    then 'a'
    when 2 then 'a'
    else 'b'

closing := (n: Int) ->
  case n
    when 1 then 'a'
    when 2 then 'a'  # two
    else 'b'

fizz := (i: Int) ->
  case
    when i % 15 == 0 then 'x'
    when i % 3 == 0 then 'x'
    else ''

captured := (shape: Shape) ->
  case shape
    when Point
      get := -> shape
      get().name
    when Circle
      get := -> shape
      get().name
    else ''

written := (shape: Shape) ->
  case shape
    when Point, Circle then shape.name
    else ''

assigned := (shape: Shape) ->
  var name = ''
  case shape
    when Point, Circle then name = shape.name
    else pass
  name

print [describe(Point(name: 'p', x: 1)), fields(Circle(name: 'c', r: 3)), kinds(2), kinds(nil)]
print [sized(Label(name: 'l')), blocks(4)]
print value(Part(v: 0.5))
print [twice(1), last(0)]
print [aliased(Label(name: 'a')), commented(Point(name: 'c', x: 0)), colors(BLUE), called()]
print [equal(1.0), equal(1)]
print [nested(Circle(name: 'c', r: 1), Point(name: 'p', x: 0)), assigned(Point(name: 'a', x: 0))]
print inner(1.0, Circle(name: 'c', r: 0))
print [declared(1.0), three(1.0)]
print [maybe(nil), maybe(Circle(name: 'c', r: 0))]
print generic(1.0, 0)
print "#{second(Circle(name: 'c', r: 0), 1.0)}"
print [ended(1), ended_block(2), fizz(3), written(Circle(name: 'w', r: 0))]
print captured(Point(name: 'p', x: 0))
print [trailing(1), opened(2), closing(3)]
