# The first comment of the file.


import stdout from 'std:io'
# Before a function.
const f = (x: Int) ->
  # Inside the body.
  const y = x + 1  # After a statement.

  # Before the last statement, after a blank line.
  y * 2
  # At the end of the body.
const xs = [
  1  # One.
  # Before two.
  2
]
if f(1) > 2
  stdout.write 'big'
# Before else.
else  # é, 😀 and 日本 before the spaces.   
  stdout.write 'small'
# The last comment of the file.
