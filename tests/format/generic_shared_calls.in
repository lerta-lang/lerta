# A generic function's instances share the calls in its body, which fmt checks again.
struct Scale
  by := default 1
total := (first: Int, rest: Int..., options: Scale) -> (first + rest.sum()) * options.by
struct P
  x: Int
  y: Int
each := <T>(value: T) ->
  x := 1
  y := 2
  print [total(1), total(1, 2, 3, by: 10)]
  p := P(x, y)
  print p.x + p.y
each 1
each 'a'
