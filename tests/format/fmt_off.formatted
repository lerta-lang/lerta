# The statements from `# fmt: off` up to `# fmt: on`, or to the end of the file, keep their gaps as
# written.
before := [1, 2]
# fmt: off
kept := [ 1,2 ]

if kept.length > 0
    print( kept )

# fmt: on
after := [1, 2]
f := (x: Int) ->
  print x
  # fmt: off
  print( x )

  # A comment between.
  print( x )

  # fmt: on
  print x
print after  # fmt: off
print( before )
