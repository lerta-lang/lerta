# `# fmt: off` keeps the statements as they are written up to `# fmt: on`, or to the end of the
# file.
# fmt: on
before := [1, 2]
# fmt: off
# fmt: off
kept := [ 1,2 ]

if kept.length > 0
    print( kept )
# fmt: on
after := [1, 2]

# Only those in a block, past its blank lines and comments, but the whole of a statement that
# holds a line between them on its own lines.
f := (x: Int) ->
  print x
  # fmt: off
  print( x )

  # A comment between.
  print( x )
  # fmt: on
  print x
g := (x: Int) ->
  print x  # fmt: off
  print( x )
print after  # fmt: on
h := (x: Int) ->
  print x
  print x
f 1
g 2
h 3
print [before, after]

# fmt: off
print( kept )
