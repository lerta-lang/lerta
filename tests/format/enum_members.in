# Each member of an enum that can be written alone, where its enum is expected, is; the others keep
# their enums.
enum Color
  RED
  GREEN
  BLUE
  PURPLE
  '('

struct Pixel
  color: Color = default Color.RED
  kind := Color.GREEN

paint := (color: Color, fallback: Color = Color.BLUE) -> color == Color.RED then fallback else color

next := (color: Color): Color ->
  case color
    when Color.RED then Color.GREEN
    when Color.GREEN then return Color.BLUE
    else Color.RED

pick := (flag: Bool): Color? -> flag then Color.RED else nil

var current: Color = Color.RED
current = Color.GREEN
kept := Color.BLUE
print paint(Color.GREEN).to_string()
print next(Color.RED).to_string()
print Pixel(color: Color.BLUE).color.to_string()
print (Color.RED == current).to_string()
print (current != Color.BLUE).to_string()
print [current, Color.BLUE].length.to_string()
print { first: current }.first.to_string()
print kept.to_string()
print (pick(true) == Color.RED).to_string()
print "#{next(Color.GREEN)}"
colors: Color[] = [Color.RED]
counts := { Color.RED: 1 }
plain := (color: Color = Color.GREEN) -> color
print "#{colors.length} #{counts[RED]!} #{plain()}"
# A comment before the member.
current = Color.BLUE  # A comment after it.

# A name that something else takes keeps its enum.
shadowed := (RED: Int) ->
  GREEN := 'green'
  var color = current
  color = Color.RED
  color = Color.GREEN
  "#{RED} #{GREEN} #{color}"
print shadowed(1)

# The code of a generic function is checked only for each instance. A call of one writes alone
# the arguments of the parameters whose types name no type parameter.
same := <T>(value: T, color: Color) -> color == Color.RED
print same(Color.GREEN, Color.RED).to_string()

extend<T> T[]
  tinted := (color: Color) -> color == Color.GREEN
print [1].tinted(Color.GREEN).to_string()

class Box<T>
  item: T
  color: Color = Color.RED
  tint := (): Color -> Color.GREEN
print Box(item: 1).tint().to_string()

# So does a name taken by a top-level declaration below.
later := (): Color -> Color.PURPLE
print later().to_string()
PURPLE := 3
print PURPLE

# Members of two enums of the same name, each where its enum is expected.
enum Shade
  RED
  DARK

both := (color: Color, shade: Shade) -> color == Color.RED and shade == Shade.RED
print both(Color.RED, Shade.DARK).to_string()

looked_up := (color: Color?, counts: Map<Color, Int>) ->
  counts[Color.RED] = 1
  shades := [Shade.DARK]
  shades.push Shade.RED
  case
    when color == Color.GREEN then Color.BLUE
    else color ? Color.GREEN
print looked_up(nil, Map()).to_string()

places := (colors: Color[], optional: Color?) ->
  names := { Color.RED: 'red' }
  var count = 0
  count += 1 while colors[count] != Color.GREEN
  kinds := [colors.contains(Color.RED) for _ in colors when optional == Color.BLUE]
  print found.to_string() if found := optional == nil then Color.RED
  known: Map<String, Color> = { 'first': Color.BLUE }
  case optional
    when Color.RED then 'red'
    else "#{count} #{kinds.length} #{names.length} #{known.length}"
print places([RED, GREEN], nil)

guarded := (): Color ->
  inner := (color: Color) -> color
  try
    inner(Color.GREEN)
  catch _: Error
    Color.RED
  finally
    print inner(Color.BLUE).to_string()
print guarded().to_string()

# Neither is an element of a comprehension, whose lazy functions share it.
repeated: Color[] = [Color.RED for _ in 0..2]
print repeated.length.to_string()

order: Ordering = Ordering.LESS
print order.to_string()
