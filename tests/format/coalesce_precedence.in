const m = { 'a': 1 }
const b = { 'a': true }

const p = (m['a'] ? 0) == 1
const q = m['a'] ? (0 == 1 then 1 else 2)
const r = b['a'] ? (false or true)
const t = m['b'] ? (m['c'] ? 3)
const u = not (b['b'] ? false)
const v = case
  when (m['b'] ? 0) > 1 then 'big'
  else 'small'
print "#{p} #{q} #{r} #{t} #{u} #{v}"

struct A
  x: Int
struct B
  y: Int
type AB = A | B

const w = (n: Int?, v: AB, u: AB) ->
  print (n ? return 1) == 2
  print (v as A ? throw ValueError(message: 'no')).x
  print (v as A ? u as A?) != nil
  print v as A ? (u is B then A(x: 1) else A(x: 2))
  print v as A ? u as A!
