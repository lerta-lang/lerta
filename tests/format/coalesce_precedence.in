m := { 'a': 1 }
b := { 'a': true }

p := (m['a'] ? 0) == 1
q := m['a'] ? (0 == 1 then 1 else 2)
r := b['a'] ? (false or true)
t := m['b'] ? (m['c'] ? 3)
u := not (b['b'] ? false)
v := case
  when (m['b'] ? 0) > 1 then 'big'
  else 'small'
print "#{p} #{q} #{r} #{t} #{u} #{v}"

struct A
  x: Int
struct B
  y: Int
type AB = A | B

w := (n: Int?, v: AB, u: AB) ->
  print (n ? return 1) == 2
  print (v as A ? throw ValueError(message: 'no')).x
  print (v as A ? u as A?) != nil
  print v as A ? (u is B then A(x: 1) else A(x: 2))
  print v as A ? u as A!
