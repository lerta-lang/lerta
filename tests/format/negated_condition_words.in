f := (x: Int?, a: Bool, b: Bool) ->
  print 'a' unless not x
  print 0
  print 'b' unless x != 3
  print 0
  print 'c' unless x == nil
  print 0
  unless a and b
    print 'd'
    print 'e'
  print 0
  var n = 0
  until (not x) or n > 3
    n += 1
    print n
  print 0
  while not not (n < 9)  # fmt: skip
    n += 1
  print 0
  until not x
    print 'f'
    print 'g'
