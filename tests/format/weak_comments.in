# A comment before the `weak` of a declaration stays before it; one before the `weak` of a function
# literal, which the formatter cannot place, is reported, and its statement kept as it is written.
class A
  x := 1
  run := (f: () -> void) -> f()
  each := (fs: (() -> void)[]) -> f() for f in fs
  both := (n: Int, f: () -> void) -> f()

  start := ->
    @run(
      # in a call
      weak -> print @x
    )
    @each [
      # in an array
      weak ->
        print @x
    ]
    @both(1,  # ending the line before
      weak -> print @x)

look := (a: A) ->
  # before a declaration
  weak w := a
  print w?.x ? 0

# Nor is the name `weak` called.
weak := (n: Int) -> n
called := [
  # before a call
  weak(2)
]
a := A()
look a
a.start()
print called
