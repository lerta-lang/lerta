# A call on the line of `->` that does not fit there goes in a block below, without its
# parentheses where its value is no result, of a function of no value, but with them where it is.
show := (text: String) -> text
dropped := ->
  print 'a call on the line of the arrow that does not fit there, so it goes below it, longer'
given := ->
  show(
    'a call on the line of the arrow that does not fit there, so it goes below it as well, longer'
  )
dropped()
print given()
