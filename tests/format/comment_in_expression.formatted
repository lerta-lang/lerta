# A statement with a comment that ends the line of a `(`, a `not` or a `-` is kept as it is written,
# and reported.
a := 1
needed := (  # needed
  a + 2) * 3
unneeded := (  # unneeded
  a + 2)
operator := (  # an operator first
  -a) * 2
negated := not  # negated
  true
minus := -  # minus
  (a + 1) * 2
items := [(  # in brackets
  a + 1) * 2]
product := a * -  # after an operator
  a
outside := a not in  # not in
  [2]
negated_group := not (  # not (
  a == 1)
print (  # a spaced `(`, which is no call's
  a + 1) * 2
# Nor is the `(` of a call.
called := [a].contains(  # a call
  a
)
# A `-` between operands is not one of them.
sum := a -  # between
  1
maybe: Int? = 1
unwrapped := maybe! -  # after `!`
  1
indexed := [a][0] -  # after `]`
  1
print "#{needed} #{unneeded} #{operator} #{negated} #{minus} #{items} #{product}"
struct Count
  n: Int

  sub := (other: Count) -> Count(@n - other.n)
  less := (other: Count) ->
    @ -  # after `@`
      other
print "#{sum} #{unwrapped} #{indexed} #{Count(2).less(Count(1)).n} #{outside} #{called}"
print negated_group
