const show = (label: String, values: Array<Int>) -> print("#{label}: #{values.length}")
show 'short', [1, 2]
show 'a list too long to fit on one line with the call', [100000, 200000, 300000, 400000, 500000]
const wrap = (n: Int) -> show('n', [n])
const pick = (n: Int) ->
  case n
    when 0 then show('zero', [])
    else show('other', [n])
