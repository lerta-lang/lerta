class Box
  items: Int[]
  has_item := (n: Int) -> n in @items

class Odd
  contains := (n: Int) -> n

names := ['a', 'b']
seen: Set<String>
c: Char = 'a'
print 'a' in names
print 'a' not in seen
print c in 'abc'
print names.contains(names[0])
print Box(items: [1]).items.contains(1)
print ['b' in names, ('x' in seen) == false]
print Odd().contains(1)
check := <T: Equatable>(xs: T[], x: T) -> xs.contains(x)
print check([1], 1)
maybe: Int[]? = [1]
print maybe?.contains(1) == true

class Halves
  contains := (n: Int) -> n
  items := [1]
  positive := (n: Int) -> @contains(n) > 0

class Bag
  halves: Halves
  contains := (n: Int) -> n == 1
  own := (n: Int) -> n in @

halves := Halves()
bag := Bag(halves)
print halves.contains(1)
print 1 in bag.halves.items
print [n for n in [1, 2] when bag.contains(n)]
print "#{bag.contains(1)}"
print 1 in bag
print [n for n in [1, 2] when n not in bag]
print ('a' in names).to_string()
counts := { 'a': 1 }
print ['a' in counts, 'c' in names and true]
numbers := [1]
print -1 in numbers
