# Map() and Set() take an Iterable itself, not an array of it: of an array, an Iter, a map or a set;
# not a function that gives a map, nor of a value of another type.
class Bag
  to_array := -> [1]
counts := { 'a': 1 }
xs := [3, 1, 2]
keys := Set(counts.keys().to_array())
items := Set<Int>(xs.to_array())
copied := Map(counts.to_array())
iterated := Set(xs.iter().to_array())
keyed := Map(counts.keys().map((key) -> (key, 0)).to_array())
again := Set(items.to_array())
tally := (words: String[]): Map<String, Int> -> Map([(word, 1) for word in words])
tallied := tally(counts.keys().to_array())
bagged := Set(Bag().to_array())
print "#{keys} #{items} #{copied} #{iterated} #{keyed} #{again} #{tallied} #{bagged}"
