# The one named argument of a construction that it must give is written as its value alone; one
# that is a variable of its name is written as the name alone (see Shorthand), and one where the
# struct is expected as a record (see Expected types).
import 'std:json' as json

class Failure
  message: String
  code = default 1
  cause: String?

struct Point
  x: Int
  y: Int

struct Wrapper
  value: Int

message := 'shorthand'
text := 'named'
print Failure(message: 'failed').message
print Failure(message: text).message
print Failure(message: message).message
print Failure(message: 'with code', code: 2).code
print Failure(message: 'with cause', cause: 'c').cause ? ''
print Point(x: 1, y: 2).x
wrapped: Wrapper = Wrapper(value: 1)
print wrapped.value
generic := <T>(x: T) -> Failure(message: 'kept in a generic function').message
print generic(1)

# Kept: a value that names another argument, which alone would be that one's shorthand; an argument
# that need not be given; and a value alone where the struct is expected, which names no field.
class Tagged
  message: String
  label: String?

struct Counter
  count = default 0

label := 'label'
print Tagged(message: label).message
print Counter(count: 1).count
kept: Wrapper? = Wrapper(2)
print kept?.value ? 0

# A construction through its module is written so too.
print json.JsonError(message: 'qualified').message
