# A postfix form whose body has more than three leaves goes in a block, and a block form whose
# body has three at most takes the postfix form: names and literals count, a path of members and
# `@x` once, operators, the words among them, and keywords none.
class Counter
  var count = 0
  bump := (by: Int) -> @count += by
  log := (a: Int, b: Int, c: Int) -> print(a + b + c)
  run := (xs: Int[], ok: Bool) ->
    return unless ok
    @bump xs.length if ok
    if ok
      @log xs[0], 1, @count
    if ok
      @log xs.length, xs[0], @count
    @bump xs[1] if ok
    if ok
      @log xs[1], xs.length, @count
    total := 0
    print x for x in xs
    for x in xs
      @log x, total, @count
    print @count if ok
    @bump 1 while @count < 3 and ok
Counter().run([1, 2], true)
class Edges
  var count = 0
  log := (a: Int, b: Int, c: Int) -> print(a + b + c)
  bump := (by: Int) -> @count += by
  go := (ok: Bool, p: Edges?, v: Int | String) ->
    @bump @count if ok
    if ok
      @log @count, 1, 2
    @bump p?.count else 0 if ok
    print v is Int if ok
    print "#{@count} and #{@count}" if ok
Edges().go(true, nil, 1)
head_line := (ok: Bool, n: Int) ->
  if ok
    print [n, n, n, n]
arm_line := (n: Int) ->
  if n == 1
    if n > 0
      print [n, n, n, n]
head_line true, 1
arm_line 1
