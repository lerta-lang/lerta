# `pass` stays the body of a class or a struct without members, and is left out after an
# interface, which may leave the body out; a function's block of `pass` goes on the line of `->`,
# as an arm's after `then`.
interface Named
  name: String

class Empty
  pass

struct Nothing
  pass

struct Unit: Named

noop := -> pass
run := (f: () -> void) -> f()
run -> pass
x := 1
case x
  when 1 then pass
  else print('other')
struct Led: Named
  # a comment
  pass
struct Headed: Named  # a comment
  pass
struct Trailed: Named  # a comment
class Keeps: Named
struct Generic<T>: Named
class Bare
  # a comment
  pass  # another
