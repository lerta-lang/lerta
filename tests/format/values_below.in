# A type alias too long for the line of `=` goes on the next, as a value does, and so does the
# value of a key in a block; a value below a comment line keeps its brackets.
export type LongName = NamedTypeOne | UnionTypeNameTwo | FunctionTypeName | RecordTypeName | TupleTypeName
files :=
  'named.lerta': "import Field from './kinds'\n\nname := 'b'\n" + "export named := Field(name, kind: B)\n"
  'b': ''
SPEC :=
  # The usage names the suites.
  {
    pattern: { short: 'k', value: 'text', help: 'only the checks whose names hold the text' }
    list: { help: 'the names of the checks that would run, rather than running them' }
  }
print files, SPEC
type Noted =  # note
  Int
type Led =
  # lead
  String
keyed :=
  a:
    # lead
    1
  b: 2
flag := true
picked := if flag
  pass
else
  2
print keyed, picked
type LongFunction = (VeryLongParameterTypeNumberOne, VeryLongParameterTypeNumberTwoXXXXXX, Another) -> Int
type LongOptional = (VeryLongParameterTypeNumberOne | VeryLongParameterTypeNumberTwoXXXXXX | AnotherOneHe)?
type TooLong = VeryLongParameterTypeNumberOne | VeryLongParameterTypeNumberTwoXXXXXX | AnotherOneHereXXXXX | More
