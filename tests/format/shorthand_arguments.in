# A named argument of a construction that is a variable of its name is written as the name alone
# where only such arguments go before it, and only reported where it would move before others;
# other calls keep it.
import 'std:process' as process
import Exit as Ended from 'std:process'

struct Point
  x: Int
  y: Int

class Box
  label: String
  size: Int

enum Kind
  SMALL
  LARGE

class Crate
  kind: Kind
  size: Int
  owner: Crate?
  pack := (size: Int) -> Crate(owner: @, kind: Kind.SMALL, size: size)
  sized := (size: Int) -> Crate(kind: @kind, size: size, owner: nil)

struct Options
  verbose: Bool

struct Pair<A>
  first: A
  second: A

struct Wide
  alpha: Int
  beta: Int
  gamma: Int

struct Segment
  from: Point
  to: Point

next := -> 1

run := (name: String, options: Options) -> options.verbose then name else ''

shift := (x: Int, y: Int) -> Point(x: x, y: y)
swap := (x: Int, y: Int) -> Point(y: y, x: x)
moved := (x: Int) -> Point(y: 2, x: x)
partly := (x: Int) -> Point(x: x, y: x)
named := (size: Int) -> Box(label: 'box', size: size)
after_call := (label: String) -> Box(size: next(), label: label)
before_call := (label: String) -> Box(label: label, size: next())
alone := (x: Int, y: Int) -> Point(x, y: y)
qualified := (code: Int) -> process.Exit(code: code, signal: nil)
renamed := (signal: Int?) -> Ended(code: 0, signal: signal)
paired := (first: Int) -> Pair(first: first, second: 0)
wide := (alpha: Int, gamma: Int) ->
  Wide
    beta: 2
    # the alpha
    alpha: alpha
    gamma: gamma
expected := (x: Int): Point -> Point(y: 1, x: x)
generic := <T>(x: Int, other: T) -> Point(x: x, y: 0)
nested := (x: Int) -> [Point(x: x, y: x).y, partly(Point(y: 0, x: x).x).x]
narrowed := (x: Int | String) -> x is Int then Point(y: 1, x: x as Int!).x else 0
behind_member := (label: String) -> Box(size: named(1).size, label: label)
behind_operation := (x: Int, y: Int) -> Point(y: -1, x: x).x + Point(y: y + 1, x: x).x
behind_both := (alpha: Int, gamma: Int) -> Wide(alpha: alpha, beta: next(), gamma: gamma)
inside := (x: Int, to: Point) -> Segment(to: to, from: Point(y: 0, x: x))
parenthesized := (x: Int, y: Int) -> Point(x: (x), y: y)
behind_local := (other: Box, label: String) -> Box(size: other.label.binary.length, label: label)
verbose := true
print run('a', verbose: verbose)
print shift(1, 2).y + swap(3, 4).x + moved(5).x + partly(6).y + named(7).size
print after_call('b').label + before_call('c').label
print alone(8, 9).y + qualified(1).code + renamed(nil).code + paired(3).first
print wide(1, 3).gamma + expected(2).x + generic(3, 'a').x + nested(4)[1]
print Crate(kind: Kind.LARGE, size: 1, owner: nil).pack(2).sized(3).size
print narrowed(5) + behind_member('d').size + behind_operation(1, 2) + behind_both(1, 2).gamma
print inside(3, shift(1, 1)).from.x
print behind_local(named(2), 'e').size + parenthesized(1, 2).y
