# A comprehension with its `for` first is laid out as a `for` statement in its brackets: one space
# between the parts of its header, its block one deeper, and its closing bracket at the depth of
# the line of the opening one, inside a `case` too.
xs := [1, 2, 3]
n := 1
spaced := [
  for  x at i in xs   when x > n
      y := x  *  2
      y + n + i
]
lazy := (
    for x in xs when x > n
       x * x + n
)
f := (m: Int?) ->
  case m
    when nil then [0]
    else
      [
          for x in xs
            g(x, m)
      ]
g := (a: Int, b: Int) -> a + b
print "#{spaced} #{lazy.to_array()} #{f(2)}"
picked := [
  for x in xs
    continue if x == n
    # the larger ones twice
    if x > 2
      g x, x
    else
      g x, 0
]
nested := [
  for x in xs
    for  y in xs
      x + y + n
]
h := (ys: Int[]) ->
  return [
      for y in ys
         y * y + n
  ]
print "#{picked} #{nested} #{h(xs)}"
