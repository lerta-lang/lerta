first_quantity_value := 1
second_quantity_value_long_name := 2
third_quantity_value_long_name := 3
fourth_quantity_value := 4
# An operand that is an operation stays on one line, too long for it, to be shortened by hand,
# whether the formatter joins it or it is written so.
total := first_quantity_value +
  second_quantity_value_long_name * third_quantity_value_long_name *
    fourth_quantity_value * 1000000 * 7
joined := first_quantity_value +
  second_quantity_value_long_name * third_quantity_value_long_name * fourth_quantity_value * 1000000 * 7
print total, joined
