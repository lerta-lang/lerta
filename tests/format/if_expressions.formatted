# An `if` that is an expression keeps its block form, which a postfix form cannot write; one of a
# statement takes the postfix form.
show := (n: Int) -> print(n)
ok := true
show
  if ok
    1
  else
    2
operand := 1 + if ok
  2
else
  3
negated := not if ok
  false
else
  true
print negated
items := [
  if ok
    4
  else if operand > 2
    5
  else
    6
]
show(
  if ok
    7
  else
    8
)
print items
print 3 if ok
