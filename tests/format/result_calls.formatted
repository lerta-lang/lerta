# A call whose value is the result of its function keeps its parentheses, as the last statement of
# its body or of an arm of one that is; one whose value is dropped, as in a function of no value,
# takes its arguments without them.
import sleep from 'std:time'

parse := (text: String) -> text.count()
load := (text: String) ->
  print text
  parse(text)
pick := (wanted: Bool, text: String) -> wanted then parse(text) else 0
log := (text: String): void ->
  print 'logging'
  parse text
waits := (text: String) ->
  await sleep(0)
  parse(text)
log load('ab').to_string()
print pick(true, 'abc')
print await waits('abcd')
named := (n: Int) ->
  if n == 0
    parse('zero')
  else
    print 'other'
    parse('other')
keep := (n: Int) -> n
dropped: (Int) -> void = (n) ->
  print n
  keep n
mapped := (xs: Int[]) ->
  xs.map((x) ->
    print x
    x + 1  # one more
  )
print named(1)
dropped 2
print mapped([1]).to_array()
