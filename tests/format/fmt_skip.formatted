# `# fmt: skip` keeps a statement as it is written: the one whose line it ends, or the next one.
import encode_json as encode, JsonKeys from 'std:json'
import JsonKeys as Unused from 'std:json'  # fmt: skip

# Each line of a statement on lines of its own.
identity := [  # fmt: skip
  1, 0,   0
  0, 1,   0
  0, 0,   1
]
scale := [
  2, 0,   0
  0, 2,  0  # fmt: skip
]
# fmt: skip
pair := [ 1,2 ]
other := [1, 2]
export exported := [ 1,2 ]  # fmt: skip
(first, second) := ( 1,2 )  # fmt: skip

# A statement in a block alone, past the blank lines and comments before it, but the whole of one
# that holds the line on its own lines, as an arm on the line of `when`.
f := (x: Int) ->
  for y in [x]

    # fmt: skip
    print( y )
    print y
  z := case x
    when 1 then [ 1 ]  # fmt: skip
    else [2]
  print z
  local: Int = x  # fmt: skip
  other_local := x
  print other_local + local

# Each time a part that holds it is printed, as the arms of an `if` that gives a value.
v :=
  if identity != []
    print( 1 )  # fmt: skip
    [1]
  else
    [2]
print v

# A statement in the block of a function that is an argument.
doubled := [1].map((x) ->
  print( x )  # fmt: skip
  x * 2
).to_array()
print doubled

# The whole of a class whose member it is.
class Point
  x = [ 1,2 ]  # fmt: skip
  y = [ 1,2 ]
print Point().y

# Indented as deep as its block, which the lines after the first keep relative to it.
if identity != []
  print(   # fmt: skip
      identity
  )
  print identity

# No line moves past the first column.
if identity != []
  t := [
1 ]  # fmt: skip
  print t

# Its types and the enums of its members stay, and the imports that it uses.
kept: Int = 1  # fmt: skip
typed := 2
print encode([1], JsonKeys.CAMEL_CASE)  # fmt: skip
print encode([2], CAMEL_CASE)
f kept + typed + first + second
print [identity, scale, pair, other, exported]

# All the lines of a string that spans them.
if identity != []
  # fmt: skip
  print """
    a  b
  """
# fmt: skip
