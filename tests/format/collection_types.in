const seen: Set<String> = Set()
var counts: Map<String, Int> = Map()
# A parameter that takes the name is no builtin, so the annotation stays.
const make = (Map: () -> Map<String, Int>) ->
  const made: Map<String, Int> = Map()
  made.length
const total = make(-> { 'a': 1 })
print "#{seen.length} #{counts.length} #{total}"
