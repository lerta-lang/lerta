var seen: Set<String> = Set()
var counts: Map<String, Int> = Map()
# Written type arguments give the type, so the annotation goes.
var typed: Map<String, Int> = Map<String, Int>()
var typed_set: Set<String> = Set<String>()
# Without type arguments of their own, those in a value or an optional one stay annotated.
nested: Map<String, Int>[] = [Map()]
optional: Map<String, Int>? = Map()
# A parameter that takes the name is no builtin, so the annotation stays.
make := (Map: () -> Map<String, Int>) ->
  var made: Map<String, Int> = Map()
  made.length
total := make(-> { 'a': 1 })
# A field's annotation does not move to the type arguments, so it stays without them.
class Names
  by_name: Map<String, Int> = Map()
  by_key: Map<String, Int> = Map<String, Int>()
print "#{seen.length} #{counts.length} #{total} #{typed.length} #{typed_set.length}"
print "#{nested.length} #{optional == nil} #{Names().by_name.length} #{Names().by_key.length}"
