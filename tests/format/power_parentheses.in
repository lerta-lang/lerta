# `**` groups to the right, and a prefix operator before it needs parentheses, so those around its
# base keep theirs where it is a prefix operation, a negative literal or a `**`, and those around a
# `**` after a prefix operator keep theirs; its exponent may be a prefix operation.
x := 2
values := [1, 2]
print [(-x) ** 2, (-2) ** 2, (~x) ** 2, (2 ** 3) ** 2, -(x ** 2), ~(x ** 2)]
print [2 ** (3 ** 2), 2 ** (-x), (values[0]) ** 2, (x) ** (x), 2 * (x ** 2), (2 * x) ** 2]
print [~(x), -(~x), ~(-x)]
f := -> 2
g := -> [(await f()) ** 2, 2 ** (await f()), await (f() ** 2)]
