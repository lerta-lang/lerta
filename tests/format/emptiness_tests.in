# A test of a length against 0, or of a String against '', is written with is_empty() where std
# gives the type is_empty; a length of another type, other tests of a length, an optional String and
# an order of Strings keep theirs.
class Box
  length: Int

class Holder
  items: Int[]
  none := -> @items.length == 0

xs := [1]
none: Int[]
m: Map<String, Int>
s := 'a'
b := s.binary
box := Box(length: 0)
maybe: String? = nil
holder: Holder? = Holder(items: [])
t := 'b'
shape: String | Int = 'c'
print xs.length == 0
print 0 == none.length
print xs.length > 0
print m.length != 0
print Set([1]).length == 0
print s == ''
print '' != s
print b.length == 0
print box.length == 0
print maybe == ''
print xs.length == 1
print s > ''
print xs.length >= 1 and m.length == 0
print [xs.length == 0, none.length > 0][0]
print (s + t) == ''
print (s + t).binary.length == 0
print maybe?.binary.length == 0
print holder?.items.length == 0
generic := <T>(ys: T[]) -> ys.length == 0
print generic([1])
print shape is String then (shape as String!).binary.length == 0 else false
print xs.length == 0  # fmt: skip
print not (xs.length == 0)
print xs.length == 0  # the length
print not (xs.length != 0)
alone := -> s == ''
print alone()
made := -> [1]
print made().length == 0
print holder!.none()
print [x for x in xs when xs.length == 0]
print "#{xs.length == 0}"
print m.length != 0 or b.length != 0
print not not (xs.length == 0)
print not (box.length == 0)
print s != ''
print '' == s
print 0 != xs.length
