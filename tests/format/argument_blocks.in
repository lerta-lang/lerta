struct Label
  text: String
show := (a: Int, b: Int) -> print "#{a} #{b}"
tag := (a: Int, label: Label) -> print "#{a} #{label.text}"
pick := (c: Bool, a: Int, b: Int) -> c then a + a + a else b
run := (c: Bool, d: Bool, a: Int) ->
  show a, c then a + a + a else 1
  show(a, c then 1 else d then 2 else 3)
  tag a, text: c then 'a' + 'b' + 'c' else 'b'
  x := pick(c, a, c then a + a + a else a)
  show x, x
  show a, (c then a + a + a else 1) + 1
  then_arm := -> show a, c then a + a + a else 1
  then_arm()
  return show(c then a + a + a else 1, d then a + a + a else 2)
run true, false, 1
more := (c: Bool, a: Int, xs: Int[]) ->
  show(a,
    c then a + a + a else 1)
  show a
    c then a + a + a else 1
  case
    when c then show(a, c then a + a + a else 1)
    else pass
  mk := (n: Int) -> (m: Int, k: Int) -> show(n, m + k)
  mk(a)(a, c then a + a + a else 1)
  show a, (c then a + a + a else 1)
  show a, c then a + a + a else 1  # a note
  throw ValueError(c then 'a' + 'b' + 'c' else 'd') if a > 9
  print [xs..., c then a + a + a else 1]
more true, 1, [2]
named := (c: Bool, a: Int) ->
  tag a
    text: c then 'a' + 'b' + 'c' else 'b'
named true, 1
apply := (a: Int, f: (Int) -> Int) -> print "#{f(a)}"
others := (c: Bool, a: Int, xs: Int[]) ->
  apply c then a + a + a else 1, (x) ->
    print x
    x + 1
  var y = 0
  y += pick(c, a, c then a + a + a else 1)
  print y
  print_all xs..., c then a + a + a else 1
  return show(a, c then a + a + a else 1) if a > 5
print_all := (xs: Int...) -> print xs
others true, 1, [2]
