# A const with a comment on its line is only reported, as the rewrite would take the comment out.
pair := (s: String) ->
  parts := s.split_once('=') else return ''  # A comment
  (key, _) := parts
  key

print pair('a=b')

# One after the destructuring goes with the value.
after := (s: String) ->
  (key, _) := s.split_once('=') else return ''  # Kept
  key

# One between them is only reported.
between := (s: String) ->
  parts := s.split_once('=') else return ''

  # Between
  (key, _) := parts
  key

# A const that a function literal reads stays.
read_inside := (s: String) ->
  parts := s.split_once('=') else return ''
  (key, _) := parts
  show := -> "#{key} #{parts}"
  show()

print (after('a=b'), between('c=d'), read_inside('e=f'))
