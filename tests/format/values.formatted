lines :=
  'the first line of the text'
  'the second line of the text'
  'the third line of the text'
.join("\n")
joined := (words: String[]) -> return ['one', 'two'].join(' ')
total := 1000000000 + 2000000000 + 3000000000 + 4000000000 + 5000000000 + 6000000000 + 7
each := (xs: Int[], f: (Int) -> void) -> f(x) for x in xs
each [1, 2, 3], (x) -> print("the item #{x} of the list, printed with a long message to break")
print lines, joined(['a']), total
