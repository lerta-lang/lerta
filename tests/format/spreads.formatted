# A spread stays first: on the line, in the block of a literal too long for it, and in the record
# that a construction where its struct is expected is written as.
struct Point
  x: Int
  y: Int

record := { first_field_with_a_long_name: 1, second_field_with_a_long_name: 2 }
longer :=
  record...
  first_field_with_a_long_name: 100000000000000
  second_field_with_a_long_name: 2
p := Point(x: 1, y: 2)
expected: Point = { p..., y: 3 }
short := { record..., third: 3 }
print [longer.first_field_with_a_long_name, expected.y, short.third]
