# A value after a comment that ends the line of its `=`, `:=`, `return`, `then`, `else` or key goes
# on the next line, deeper.
x :=  # declared
  1
var y = 0
y =  # assigned
  2
type Only =  # aliased
  Int
first := (values: Only[]) -> values[0]
type Short =  # a union
  Int | String
type Long =  # a union longer than a line
  Int | String | Float | Bool | Char | Binary | Int8 | Int16 | Int32 | UInt16 | UInt32 | UInt64
  Float32
shorts: Short[] = [1, 'a']
longs: Long[] = [true]
branched :=  # an if
  if x > 0
    7
  else
    8
point :=
  x:  # field
    3
picked := x > 0 then  # then
  4 else  # else
  5
f := ->
  return  # returned
    6
g := ->
  return  # returned, an if
    if x > 0
      9
    else
      10
print "#{x} #{y} #{first([0])} #{point.x} #{picked} #{f()} #{g()}"
print "#{shorts.length} #{longs.length} #{branched}"
