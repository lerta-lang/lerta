# Tests of one subject next to each other in a chain of `or`s, or of `and`s for `is not`, go into
# one of their union; not those of a subject that runs code, as it would be evaluated once.
class A
  n: Int

class B
  n: Int

class C
  n: Int

class Box
  item: A | B | C
  get := -> @item

v: A | B | C | (Int, String) = C(1)
box := Box(A(2))
flag := true
print v is A | B
print v is A | B | C
print v is not A | B
print flag or v is A | B or flag
print v is A | B | C
print box.item is A | B
print v is A or flag or v is B
print v is A or v is not B
print v is A and v is B
print v is A or box.item is B
print box.get() is A or box.get() is B
print v is A | B
print v is A | B
print v is (Int, String) | B
print v is A | B | C
w: A | B = A(3)
print v is A or w is A or v is B
print v is A | B or flag or v is C | (Int, String)
x := v is A | B
print x
print v is A or v is B and v is A
print v is not A or v is not B
print v is not A | B
print v is A | B
