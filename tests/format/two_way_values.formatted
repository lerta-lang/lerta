# A two-way value that fits on one line is `c then a else b`, and otherwise an `if`, with the
# parentheses that a part needs there.
flag := true
short := flag then 'yes' else 'no'
long := flag then 'a value long enough that the two-way value does not fit on its line' else 'or the next, either'
kept :=
  if flag
    'yes'  # a comment
  else
    'no'
nested :=
  if flag
    'yes'
  else if not flag
    'no'
  else
    'neither'
assigned := ''
assigned = flag then 'yes' else 'no'
called := flag then f(x) else 0
coalesced := flag then (x else 0) else 1
bound :=
  if y := f()
    y
  else
    0
