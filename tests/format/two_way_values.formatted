# A two-way value that fits on one line is `c then a else b`, and otherwise an `if`, which the
# formatter reports but leaves as written.
flag := true
short :=
  if flag
    'yes'
  else
    'no'
long := flag then 'a value long enough that the two-way value does not fit on its line' else 'or the next, either'
kept :=
  if flag
    'yes'  # a comment
  else
    'no'
nested :=
  if flag
    'yes'
  else if not flag
    'no'
  else
    'neither'
assigned := ''
assigned =
  if flag
    'yes'
  else
    'no'
called :=
  if flag
    f 'the first argument of a call without parentheses, one more column.', 1
  else
    2
fitted :=
  if flag
    f 'the first argument of a call without parentheses, one more column', 1
  else
    2
bound :=
  if y := f()
    y
  else
    0
