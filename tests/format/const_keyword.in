class Node(label: String)

const TOP = 'top'
print TOP
export const twice = (n: Int) -> n * 2
print twice(1)
const widened: Int? = twice(1)
print widened ? 0
const names: String[]
print names
const { label } = Node(label: 'a')
print label
const (first, second) = (1, 2)
print first
const (
  third
  fourth
) = (3, 4)
print third + fourth
var (fifth, sixth) = (5, 6)
print fifth + sixth
const value =
  first + second
print value
print found if const found = widened
var rest: Int? = 1
rest = nil while const n = rest
watch := (held: Node) ->
  weak const seen = held
  print seen?.label ? 'gone'
print second
