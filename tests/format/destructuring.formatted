(the_first_value_of_a_long_name, the_second_value_of_a_long_name, the_third_value_of_a_name) :=
  (1, 2, 3)
bump := xs[1, default: (v: Int) -> v + 1]
{ the_first_field_of_a_long_name, the_second_field_of_a_long_name } :=
  the_first_field_of_a_long_name: 1, the_second_field_of_a_long_name: 2
for (p, q) in [(1, 2)]
  (r, s) := (p, q)
  print r, s
pair := ->
