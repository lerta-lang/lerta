# A destructuring takes no space inside the parentheses of a tuple's names, one inside the braces
# of fields', and one around `:=` or `=`; an index takes its default after a comma.
(a, b) := (1, 2)
{ size, count } := { size: 1, count: 2 }
var (c, _) = (3, 4)
var { first } = { first: 1 }
print a, b, c, size, count
if true
  (d, e) := (5, 6)
  print d, e
xs := { 0: 1 }
print xs[5, default: 0]
print xs[5, default: 0]
long :=
  xs[the_first_value_of_a_long_name_for_an_index, default: the_second_value_of_a_long_name + 1]
print long
# a comment before

