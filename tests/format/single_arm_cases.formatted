# A case of one arm and `else` is an `if`: of its condition without a subject, and otherwise of a
# test of the subject, `is` for types, `==` for one value and `in` for more; not one without `else`,
# which handles each member, nor with an arm of `nil`, nor one of a value of an optional.
class A
  args
    n: Int

class B
  args
    n: Int

class C
  args
    n: Int

enum Color
  Red
  Green
  Blue

enum Only
  One

handled := (o: Only) ->
  case o
    when One then print('one')

typed := (v: A | B | C) ->
  if v is A | B
    print 'A or B'
  else
    print 'C'

passed := (v: A | B | C) -> print('A') if v is A

values := (n: Int) ->
  if n in [1, 2]
    print 'small'
  else
    print 'large'

blocks := (c: Color) ->
  if c == Red
    print 'red'
    print 'still red'
  else
    print 'not red'
    print 'still not red'

conditions := (n: Int) ->
  if n > 1
    print 'big'
  else
    print 'not big'

valued := (n: Int) ->
  name := n == 1 then 'one' else 'other'
  name

commented := (n: Int) ->
  case n
    # One.
    when 1 then print('one')
    else pass

kept_comment := (n: Int) ->
  case n
    when 1 then print('one')
    # Any other.
    else print('other')

nested := (n: Int) ->
  if n == 1
    if n > 0
      print 'positive'
    else
      print 'not positive'
  else
    print 'other'

optional := (v: (A | B)?) ->
  case v
    when nil then print('nil')
    else print('some')

optional_value := (n: Int?) ->
  case n
    when 1 then print('one')
    else print('other')

computed := (n: Int) ->
  case n
    when n * 2 - n then print('n')
    else print('other')

two_arms := (n: Int) ->
  case n
    when 1 then print('one')
    when 2 then print('two')
    else print('other')

returned := (n: Int) ->
  return
    case n
      when 1 then 2
      else 3

class Holder
  args
    n: Int
  get := -> @n

called := (h: Holder) ->
  if h.get() in [1, 2]
    print 'small'
  else
    print 'large'

passed_arm := (n: Int) ->
  case n
    when 1 then pass
    else print('other')

bools := (n: Int) ->
  case n
    when 1 then true
    else false

assigned := (n: Int) ->
  var name = ''
  name = n == 1 then 'one' else 'other'
  name

handled One
typed A(1)
typed C(1)
passed A(1)
values 2
blocks Red
blocks Blue
conditions 2
print valued(1)
commented 1
kept_comment 2
nested 1
optional nil
optional_value 1
computed 1
two_arms 2
print returned(1)
called Holder(1)
passed_arm 2
print bools(1)
print assigned(1)
