# A comment on a line of its own starts a paragraph after a blank line, but at the start of a block,
# after another comment, or before a line that continues the statement before it.
import sum from 'std:math'
# Before a declaration.
count := 1
total := 2
# Two lines of one comment
# stay together.
print count + total
if count > 0
  # At the start of a block.
  print count
  # After a statement.
  print total
  # At the end of a block, deeper than the line after it.
# Before else.
else
  print 0
case count
  when 1 then print('one')
  # Before when.
  when 2 then print('two')
  # Before else of a case.
  else pass
try
  print sum([1, 2])
# Before catch.
catch error: Error
  print error
class Point
  args
    x: Int
    # Before a field.
    y: Int

  # Already after a blank line.
  length := -> @x + @y
print Point(x: 1, y: 2).length()
# Before more code.
total2 := 3  # After a comment that ends a line.
# Starts a paragraph still.
print total2
if total2 > 0
  print total2
  # At the end of a block, right before else.
else
  print 0
try
  print 1
# Before finally.
finally
  print 2
case total2
  when 3
    print 'three'
  # Before when, after an arm's block.
  when 4
    print 'four'
items :=
  1
  # Before an item.
  2
print items
point := Point
  x: 1
  # Before an argument.
  y: 2
print point
# fmt: off
print 1
# Kept.
print 2
# fmt: on
# At the end of the file.
