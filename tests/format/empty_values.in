# A const that starts empty is written as its type alone: `[]` for `T[]`, and `Map<K, V>()` or
# `Set<T>()` for a map or a set, laid out as types are.
cells:  String[]
counts:Map< String,Int >
seen: Set<Int>
moved := Map<String,Int>()
f := ->
  items:   (Int | String)[]
  names: Map<String, Set<Int>>
  print items, names
print cells, counts, seen, moved
