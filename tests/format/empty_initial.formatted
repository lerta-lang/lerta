const numbers: Int[]
const lengths: Map<String, Int>
const names: Set<String>
const kept: Int[]
export const exported: Int[]
const twice: Set<String>
const nested: Int[][]
const pairs: (Int, Int)[]
const noted: String[]  # a comment
var growing: Int[] = []
var counts = Map<String, Int>()
const maybe: Int[]? = [1]
const some = [1]
const given = { 'a': 1 }
const optional_set: Set<String>? = Set()
const total = ->
  const local: Int[]
  local.push 1
  local.length
const first = <T>(x: T) ->
  const seen: Set<T> = Set()
  const kept: Set<T>
  seen.add x
  kept.add x
  seen.length + kept.length
numbers.push 1
lengths['a'] = 1
names.add 'a'
growing.push 1
counts['b'] = 2
print "#{numbers} #{lengths.length} #{names.length} #{kept} #{nested} #{pairs.length} #{noted}"
print "#{growing} #{counts.length} #{maybe ? []} #{some} #{given.length}"
print optional_set?.length ? 0
print "#{total()} #{first(1)} #{twice.length} #{exported.length}"
