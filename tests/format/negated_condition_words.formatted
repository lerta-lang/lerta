f := (x: Int?, a: Bool, b: Bool) ->
  print 'a' if x
  print 0
  print 'b' if x == 3
  print 0
  print 'c' if x != nil
  print 0
  if not (a and b)
    print 'd'
    print 'e'
  print 0
  var n = 0
  while not (not x or n > 3)
    n += 1
    print n
  print 0
  while not not (n < 9)  # fmt: skip
    n += 1
  print 0
  while x
    print 'f'
    print 'g'
