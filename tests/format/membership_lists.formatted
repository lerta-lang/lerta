# Two or more tests of one value with literals or members of enums, joined by `or` with `==` or by
# `and` with `!=`, in a chain or alone, are a test of a list; not of an item that runs code, nor of
# other values.
enum Color
  RED
  GREEN
  BLUE
class Paint
  args
    color: Color
pick := (n: Int) -> n
LIMIT := 9
check := (color: Color, c: Char, b: Byte, n: Int, s: String, paint: Paint) ->
  print [
    color in [RED, BLUE]
    color not in [RED, GREEN, BLUE]
    n > 3 or c in ['a', 'b']
    c in ['a', 'b'] or n > 3
    c in ['a', 'b'] or n == 4
    b in [b'x', 0x20]
    n == 1 or n == pick(2)
    s in ['a', 'b']
    paint.color in [RED, GREEN]
    n == 1 or c == 'b'
    n in [1, LIMIT]
    n in [-1, LIMIT + 1]
    n in [1, -2]
    n in [-LIMIT, 1]
    n == (LIMIT + 1) * 2 or n == 3
    n not in [1, 2] or n == 3
    n in [1, 2] or c in ['a', 'b']
  ]
  print "#{n == 1 or n == 2}"
check GREEN, 'b', 0x20, 7, 'b', Paint(RED)
check RED, 'z', b'y', 3, 'c', Paint(BLUE)
