const check = (n: Int) ->
  if n < 0
    return 'negative'
  var i = 0
  while i < n
    i += 1
  for x in [1, 2]
    i += x
  for x in [3, 4]
    return 'found' if x == n
  const label = case n
    when 0
      'zero'
    when 1 then 'one'
    else
      'many'
  if n == 2
    print 'two'
  else
    if n == 3
      print 'three'
  label
