# A comprehension is not spread, as an array or as an Iter, in an array literal or in the arguments
# of a variadic parameter; a spread of a name or a call is not reported.
xs := [1, 2, 3]
doubled := (x: Int) -> x * 2
total := (values: Int...) -> values.sum()
print [0, [doubled(x) for x in xs]...].length
print [0, (doubled(x) for x in xs)...].length
print total([x for x in xs]...)
print [0, [x for x in xs]...].length
print [0, [x * y for x in xs for y in xs]...].length
blocks := [0, [doubled(x) for x in xs]...]
print blocks.length
print [0, [x for x in xs when x > 1]..., [i for _ at i in xs]...].length
twice := -> [0, [doubled(x) for x in xs]...]
print twice().length
by_name := { all: [0, [x for x in xs]...] }
print by_name.all.length
print total((x for x in xs)...)
print [y for y in [0, [x for x in xs]...]].length
print [[x for x in xs]...].length
print [0, [doubled(x) for x in xs]..., 9].length
named := [doubled(x) for x in xs]
print [0, named..., xs.reversed()...].length
print total(named...)
