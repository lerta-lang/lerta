const kind = (word: String) ->
  case word
    when 'a', 'b' then 'short'
    when
      'class'
      'struct'
      # Declarations of types.
      'enum'
      'interface'
    then 'type'
    when 'x'
      'a value long enough that the arm does not fit on the line of its patterns at all, really'
    when
      'const', 'var', 'if', 'else', 'while', 'for', 'break', 'continue', 'return', 'case', 'throw',
      'try'
    then 'keyword'
    else 'name'
print kind('a')
const sign = (n: Int) ->
  case
    when n < 0 and n != -1 and n != -2 and n != -3 and n != -4 and n != -5 and n != -6 and n != -7
      'negative'
    else 'other'
print sign(1)
print case 'a'
  when  # After when.
    'b'
  then
    const n = 2
    n
  else 3
print case 'a'
  when 'a'  # The last pattern.
    1
  when 'b'
    # Before the body.
    2
  else 3
