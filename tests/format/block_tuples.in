# A literal in a block whose items are tuples, which start with `(`, is laid out as any other: the
# `(` of its first item is no parentheses that group it.
limits :=
  ('max_line',  10)
  ('max_fields', 20)
  ('max_body_of_a_request_in_bytes', 1000000)
  ('max_headers_of_a_request', 1000)
for (name, limit) in limits
  print name, limit
names :=
  ('a',  1): 'one'
  ('b', 2): 'two'
print names
f := (pairs: (Int, Int)[]) -> pairs.length
print f
  (1, 2)
  (3, 4)
grouped :=
  ((1, 2))
  (3, 4)
print grouped
z :=
  ( 1+2 )  * 3
  4
y :=
  ( 1+2 )  * 3:  1
  4: 5
print z, y
called :=
  ((1)).to_string()
  'a'
struct Pair
  a: Int
  b: Int
p: Pair =
  a: ( 1+2 )  * 3
  b: 4
print called, p.a
commented :=
  # the first pair

  (1, 2)
  (3, 4)
print commented
