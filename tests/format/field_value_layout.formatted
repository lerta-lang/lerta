# The value of a field, a map entry or a named argument in a block is laid out as any after
# `key:`: an operation that does not fit goes on the next line, or breaks after its operators, and
# a `case` starts a line of its own. Inside brackets, the value stays on the line.
first := 'the first part of a text that is long enough'
second := 'the second part of the same text'
moved :=
  name: 'moved'
  text:
    first + ' and then ' + second + ', which is long enough for the line' + ' and the next one too'
broken :=
  name: 'broken'
  text: first +
    ' and then ' +
    second +
    ', which is long enough for the line' +
    ' and for the next one too'
by_key :=
  'moved':
    first + ' and then ' + second + ', which is long enough for the line' + ' and the next one too'
  'b': 'c'
n := 2
branched :=
  name: 'branched'
  size:
    case n
      when 1 then 'one'
      else 'many'
commented :=
  name: 'commented'
  text:
    # The text, said again.
    first + ' and then ' + second
build := (o: { parts: String[], name: String }) -> o.parts.length
bracketed := [
  { parts: ['x86_64-unknown-linux-gnu', 'aarch64-apple-darwin', 'x86_64-w64-mingw32'], name: 'a' }
]
pick := (o: { name: String, other: String }) -> o.name
called := build
  parts: ['x86_64-unknown-linux-gnu', 'aarch64-apple-darwin']
  name:
    pick(name: 'the name that is picked out of the record', other: 'long enough to break the line')
label := (o: { text: String, size: String }) -> o.text + o.size
argued := label
  text:
    first + ' and then ' + second + ', which is long enough for the line' + ' and the next one too'
  size:
    case n
      when 1 then 'one'
      else 'many'
commented_argument := label
  text:
    # The text, said again.
    first + ' and then ' + second
  size: 'a'
membered :=
  'parts':
    'x86_64-unknown-linux-gnu'
    'aarch64-apple-darwin'
    'x86_64-w64-mingw32'
    'i686-w64-mingw32'
  .length
  'b': 1
print "#{moved.text} #{broken.text} #{by_key.length} #{branched.size} #{commented.text}"
print "#{bracketed.length} #{called} #{argued} #{commented_argument} #{membered.length}"
