# The imports of enums that the members written alone leave unused are left out.
import JsonKeys as Keys from 'std:json'
# Another enum import, next to it.
import JsonKeys as Next from 'std:json'
import decode_json from 'std:json'
import encode_json as encode, JsonKeys, Jsonable from 'std:json'
import
  encode_json as encode_the_value_as_json_text, decode_json as decode_the_json, JsonKeys as TheKeys
from 'std:json'
import 'std:json' as json

shown := <T: Jsonable>(value: T) -> encode(value)
print encode([1], JsonKeys.CAMEL_CASE)
print encode(decode_json<Int[]>('[2]'), Keys.AS_WRITTEN)
print encode_the_value_as_json_text(decode_the_json<Int[]>('[3]'), TheKeys.AS_WRITTEN)
print json.encode_json([4], json.JsonKeys.CAMEL_CASE)
print shown(5)
print encode([7], Next.CAMEL_CASE)

import JsonKeys as Last from 'std:json'
print encode([6], Last.AS_WRITTEN)
