# `is`, and `is not`, take one space on each side, before the type.
class Box
  args
    value: Int

items: (Int | String | Box)[] = [1, 'a', Box(2)]
for item in items
  print item is Int
  print item is not String
  print item is Box and true
  print item.value if item is Box
  print 'box' if item is Box
  print item is not Int
  print (item is not Int) == true
  print item is Int | String
  print item is not Int | String
