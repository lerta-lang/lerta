const a = 1
const b = 2
const c = (a + b) * 2
const d = a * b + 2
const e = (a > 0 and b > 0) or a < 0
const f = (a > 0 and b > 0) or a < 0
const g = not a == b
const h = 0...(b - 1)
const i = a > 0 then (b > 0 then 1 else 2) else 3
print "#{c} #{d} #{e} #{f} #{g} #{h.length()} #{i}"
const later = (n: Int) -> await promised(n) ? 0
