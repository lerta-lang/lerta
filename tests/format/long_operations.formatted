first_operand_of_them := 1
second_operand_of_them := 2
third_operand_of_them := 3
fourth_operand_of_them := 4
max := (values: Int...) -> values[0]
maybe: Int? = nil
vxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx := 1
vxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx := 1

fits := first_operand_of_them + second_operand_of_them
next_line := first_operand_of_them + second_operand_of_them + third_operand_of_them + 10000
on_line :=
  first_operand_of_them + second_operand_of_them + third_operand_of_them + fourth_operand_of_them
the_first_line_of_this_value_is_too_long_for_its_line :=
  'a text that only fits on the next line, ' + 'joined'
joined := first_operand_of_them + second_operand_of_them
levels := first_operand_of_them * second_operand_of_them +
  third_operand_of_them * fourth_operand_of_them * 100
grouped := first_operand_of_them +
  second_operand_of_them +
  third_operand_of_them +
  fourth_operand_of_them * 9
right := first_operand_of_them +
  (second_operand_of_them + third_operand_of_them + fourth_operand_of_them * 99)
tests := first_operand_of_them == second_operand_of_them and
  second_operand_of_them == third_operand_of_them
compared := first_operand_of_them + second_operand_of_them + third_operand_of_them ==
  fourth_operand_of_them + 1
multiplied :=
  (first_operand_of_them + second_operand_of_them + third_operand_of_them + fourth_operand_of_them) * 2
negated := -(first_operand_of_them + second_operand_of_them + third_operand_of_them + fourth_operand_of_them + 10)
last_grouped := first_operand_of_them +
  second_operand_of_them +
  (third_operand_of_them + fourth_operand_of_them * 100)
called :=
  (first_operand_of_them + max(
    second_operand_of_them, third_operand_of_them, fourth_operand_of_them, 1000
  )) * 2
clarified := first_operand_of_them == 1 or
  (second_operand_of_them == 2 and third_operand_of_them == fourth_operand_of_them)
a_name_that_leaves_no_room_for_the_first_operand_and_its_operator_after_it_on_its_line :=
  first_operand_of_them * 1000000 +
    second_operand_of_them +
    third_operand_of_them +
    fourth_operand_of_them
at_100 := vxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx +
  second_operand_of_them
at_101 :=
  vxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx +
    second_operand_of_them
choose := ->
  chosen :=
    first_operand_of_them > 1 and second_operand_of_them > 2 then 1 else third_operand_of_them + 4
  chosen
coalesced :=
  maybe ? first_operand_of_them + second_operand_of_them + third_operand_of_them + 1000000
print
  first_operand_of_them +
    second_operand_of_them +
    third_operand_of_them +
    fourth_operand_of_them +
    100
print [
  first_operand_of_them +
    second_operand_of_them +
    third_operand_of_them +
    fourth_operand_of_them +
    1000
]
if first_operand_of_them == second_operand_of_them and second_operand_of_them == third_operand_of_them + 1
  print 'head'
if first_operand_of_them == second_operand_of_them and second_operand_of_them == 1000000
  print 'postfix'
case first_operand_of_them
  when
    second_operand_of_them + third_operand_of_them + fourth_operand_of_them + first_operand_of_them + 10
  then print('pattern')
print fits, next_line, on_line, the_first_line_of_this_value_is_too_long_for_its_line, joined
print levels, grouped, right, tests, compared, coalesced, multiplied, negated, choose()
print
  last_grouped, called, clarified,
  a_name_that_leaves_no_room_for_the_first_operand_and_its_operator_after_it_on_its_line, at_100,
  at_101
