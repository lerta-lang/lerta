# The names that an import gives and the module never uses are left out; an import that gives none
# that it uses is only reported, as it runs the module and brings its extends. Those that it exports
# are kept, and one with a comment is only reported.
import is_file from 'std:io'
import sqrt as root from 'std:math'
import 'std:json' as json
import time from 'std:time'
import exit from 'std:process'
# The first name left out takes the comma after it.
import remainder from 'std:math'

export floor from 'std:math'
import round from 'std:math'  # kept for now
import
  abs, ceil, exp  # the last name left out
from 'std:math'
import 'std:json' as used_json
import utc_offset from 'std:time'
shared := 1

print "#{is_file('x')} #{root(4.0)} #{remainder(5.0, 2.0)} #{time() > 0} #{abs(-1.0)}"
print "#{shared} #{used_json.encode_json(1)}"
