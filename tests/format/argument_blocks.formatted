struct Label
  text: String
show := (a: Int, b: Int) -> print("#{a} #{b}")
tag := (a: Int, label: Label) -> print("#{a} #{label.text}")
pick := (c: Bool, a: Int, b: Int) ->
  if c
    a + a + a
  else
    b
run := (c: Bool, d: Bool, a: Int) ->
  show
    a
    if c
      a + a + a
    else
      1
  show
    a
    case
      when c then 1
      when d then 2
      else 3
  tag
    a
    text: if c
      'a' + 'b' + 'c'
    else
      'b'
  x := pick
    c
    a
    if c
      a + a + a
    else
      a
  show x, x
  show a, (c then a + a + a else 1) + 1
  then_arm := -> show(a, c then a + a + a else 1)
  then_arm()
  return show
    if c
      a + a + a
    else
      1
    if d
      a + a + a
    else
      2
run true, false, 1
more := (c: Bool, a: Int, xs: Int[]) ->
  show
    a
    if c
      a + a + a
    else
      1
  show a
    if c
      a + a + a
    else
      1
  case
    when c then show(a, c then a + a + a else 1)
    when a > 0 then show(a, a)
    else pass
  mk := (n: Int) -> (m: Int, k: Int) -> show(n, m + k)
  mk(a)(a, c then a + a + a else 1)
  show
    a
    if c
      a + a + a
    else
      1
  show
    a
    if c
      a + a + a
    else
      1  # a note
  if a > 9
    throw ValueError
      if c
        'a' + 'b' + 'c'
      else
        'd'
  print [xs..., c then a + a + a else 1]
more true, 1, [2]
named := (c: Bool, a: Int) ->
  tag a
    text: if c
      'a' + 'b' + 'c'
    else
      'b'
named true, 1
apply := (a: Int, f: (Int) -> Int) -> print("#{f(a)}")
others := (c: Bool, a: Int, xs: Int[]) ->
  apply c then a + a + a else 1, (x) ->
    print x
    x + 1
  var y = 0
  y += pick
    c
    a
    if c
      a + a + a
    else
      1
  print y
  print_all
    xs...
    if c
      a + a + a
    else
      1
  if a > 5
    return show
      a
      if c
        a + a + a
      else
        1
print_all := (xs: Int...) -> print(xs)
others true, 1, [2]
