# The comparison that `sorted` and `sort` take by default is left out, with or without
# parentheses, of parameters typed or not; not another one, nor that of a value not an array.
class Shelf
  sorted := (compare: (Int, Int) -> Ordering) -> [1]
xs := [3, 1, 2]
ascending := xs.sorted((a, b) -> a.compare(b))
typed := xs.sorted((a: Int, b: Int) -> a.compare(b))
descending := xs.sorted((a, b) -> b.compare(a))
var ys = [2, 1]
ys.sort((x, y) -> x.compare(y))
ys.sort (x, y) -> x.compare(y)
ys.sort (x, y) -> x.compare(y)  # kept
ys.sort (x, y) ->
  x.compare(y)
case ys.length
  when 2 then ys.sort (x, y) -> x.compare(y)
  else print 'none'
shelved := Shelf().sorted((a, b) -> a.compare(b))
print "#{ascending} #{typed} #{descending} #{ys} #{shelved}"
