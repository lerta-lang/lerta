f := (x: Int, y: Int, xs: Int[], ys: Int[]) ->
  print x not in xs
  print y not in ys
  print y not in xs
  print x not in ys
  print x in xs and y not in ys
  print not (x not in ys)
  print (y not in xs) == (x in ys)
  print x in [1, 2] or y in xs

g := (in: Int[], is: Int, as: Int) ->
  print(in)
  print(is)
  print(as)
  print 1 not in in
  print(in.length)
