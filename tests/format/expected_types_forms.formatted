# The forms that a member and a construction of an expected type take: a qualifier in parentheses
# goes with them, and one through a module alias too; a construction of a struct through a module
# alias stays; a brace takes a space where the arguments are on its line.
import 'std:json' as json
import 'std:io' as io

enum Color
  RED
  GREEN

struct Point
  x: Int
  y: Int

color: Color = GREEN
keys: json.JsonKeys = AS_WRITTEN
noted: Point = {  # the first point
  x: 1
  y: 2
}
apart: Point = { x: 3, y: 4 }
status: io.FileStatus? = io.FileStatus(kind: io.stat('.')!.kind, size: 2, modified_time: 0.0)
print "#{color} #{keys} #{noted.x} #{apart.y} #{status?.size ? 0}"
