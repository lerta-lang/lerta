# Declarations of types take one space between their words, and their members go in the block
# below, one on each line, laid out as declarations are, the bodies of methods as functions'.
interface Shape
  area: () -> Int
  name: String

struct Point: Shape
  x: Int
  y: Int = 0
  name := 'p'
  area := -> @x * @y
  scaled := (by: Int) -> Point(x: @x * by, y: @y)

class Box<T>
  args
    var value: T
    weak var next: Box<T>?
    count := 0

enum Color
  RED
  GREEN
  'blue'

extend<T> Box<T>
  get := -> @value

export type Number = Int | Float

extern lerta_write as write_raw: (Int, String) -> Int
extern lerta_flush: () -> void
extern lerta_same as lerta_same: () -> void
export struct Pair<A: Shape, B>
  first: A
  weak second: Box<B>!
  # a comment
  third: Int  # fmt: skip
export enum Kind
  ONE  # the first
export interface Holder<T: Shape>
  held: T

  count: Int
export class Tally
  var total = 0

  add := (n: Int) ->
    @total += n
    @total

p := Point(x: 2)
print p.area() + Box(value: 1).get()
