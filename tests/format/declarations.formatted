export struct Point
  x: Int
  y: Int? = default 0
  scaled = (factor: Int) -> Point(x: @x * factor, y: @y * factor)

enum Color
  RED
  'light blue'

type Shape = Point | Circle

class Circle
  radius: Int

extern lerta_int_to_string as int_text: (Int) -> String

extend Point
  sum = -> @x + @y

const (first, _) = (1, 2)
const { x, y } = Point(x: 3, y: 4)
print left for (left, _) in [(5, 6)]
print first + x + y + Point(x: 1).sum()
