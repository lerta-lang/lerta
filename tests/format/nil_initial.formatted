var found: String?
var count: Int? = 1
none: Int? = nil
var names: String[]?
var kept: Int?
var callback: ((Int) -> Int)?
var pair: (Int, Int)?
type MaybeInt = Int?
var aliased: MaybeInt = nil
var aliased_omitted: MaybeInt
var noted: Int?  # a comment
var close: Int?  # one space
var wide: Int?  # four spaces
weakly := ->
  weak var held: String[]?
  held
print
  "#{found} #{count} #{none} #{names == nil} #{kept} #{noted} #{close} #{wide} " +
    "#{weakly() == nil} #{callback == nil} #{pair == nil} #{aliased} #{aliased_omitted}"
