var found: String?
var count: Int? = 1
const none: Int? = nil
var names: String[]?
var kept: Int?
var callback: ((Int) -> Int)?
var pair: (Int, Int)?
type MaybeInt = Int?
var aliased: MaybeInt = nil
var aliased_omitted: MaybeInt
var noted: Int?  # a comment
const weakly = ->
  weak var held: String[]?
  held
print(
  "#{found} #{count} #{none} #{names == nil} #{kept} #{noted} #{weakly() == nil} #{callback == nil} #{pair == nil} #{aliased} #{aliased_omitted}"
)
