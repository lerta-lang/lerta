# A long two-way value over several lines is reported, left to be done by hand.
ok := true
xs := [1, 2]
y := ok then xs.map((x) ->
  z := x + 1
  z * 2
).to_array() else [0]
print y
print ok then xs.map((x) ->
  z := x + 1
  z * 2
).to_array() else [0]
f := (a: Int, b: Int[]) -> b.length + a
print f(1, ok then xs.map((x) ->
  z := x + 1
  z * 2
).to_array() else [0])
w := ok then xs.any((x) ->
  z := x + 1
  z > 1
) else ok and xs.all((x) ->
  z := x + 1
  z > 0
) then xs.length else 0
print w
g := (n: Int) ->
  return n > 0 then xs.map((x) ->
    z := x + n
    z * 2
  ).to_array().length
h := (n: Int) ->
  n > 0 then xs.map((x) ->
    z := x + n
    z * 2
  ).to_array().length else 0
k := (n: Int) ->
  case n
    when 1 then n > 0 then xs.map((x) ->
      z := x + n
      z * 2
    ).to_array().length else 0
    when 2 then 2
    else 0
m := ok then xs.length + 1 + 2 else xs.map((x) ->
  z := x + 1
  z * 2
).to_array().length

# A value over several lines whose parts are short stays.
text := ok then """
  a
  """ else ''
print [g(1) else 0, h(1), k(1), m, text.count()]
