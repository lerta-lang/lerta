# `is`, and `is not`, take one space on each side, before the type.
class Box
  value: Int

items: (Int | String | Box)[] = [1, 'a', Box(value: 2)]
for item in items
  print item   is  Int
  print item is   not   String
  print (item is Box) and true
  if item  is   Box
    print item.value
  unless item is not  Box
    print 'box'
  print not (item is Int)
  print (item is not Int) == true
  print item is Int|String
  print not (item is Int | String)
