flag := true
value: Int? = 2
nil_or := (n: Int) -> n
or_zero := (n: Int?) -> n ? 0
plain := flag then 1 else nil
nested := flag then (value != nil then 1 else 2) else nil
var count = 0
while next := count < 2 then count + 1 else nil
  count = next
kept := flag then 1 else nil_or(3)
neither := flag then nil else 4
chained := flag then 1 else value != nil then 2 else nil
unchanged := 0
parenthesized := flag then 1 else (nil)
passed := or_zero(flag then 2 else nil)
coalesced := flag then 2 else nil ? 0
commented := flag then 1 else nil  # a comment
print "#{plain} #{nested} #{kept} #{neither} #{count} #{parenthesized} #{passed} #{chained} #{commented} #{coalesced} #{unchanged}"
