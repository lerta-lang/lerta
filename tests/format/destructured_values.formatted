# A const that only holds a value to be taken apart on the next line goes: the value is taken
# apart itself. Not where anything else reads the const, nor where it has a type, nor where the
# names are declared with `var`, nor where a comment would go with it.
struct P
  a: Int
  b: Int

pair := (s: String) ->
  (key, value) := s.split_once('=') else return 'none'
  "#{key}:#{value}"

sum := (p: P?) ->
  { a, b } := p else return 0
  a + b

kept := (s: String) ->
  parts := s.split_once('=') else return 0
  (key, _) := parts
  key.count() + "#{parts}".count()

typed := (s: String) ->
  parts: (String, String) = s.split_once('=') else return ''
  (key, _) := parts
  key

variable := (s: String) ->
  parts := s.split_once('=') else return ''
  var (key, _) = parts
  key += '!'
  key

(left, right) := 'a=b'.split_once('=')!
print (pair('a=b'), pair('ab'), sum({ a: 1, b: 2 }), sum(nil))
print (kept('a=b'), typed('k=v'), variable('v=w'), left + right)

nested := (lines: String[]) ->
  total := 0
  for line in lines
    if '=' in line
      (key, _) := line.split_once('=')!
      print key
  total

multi_line := ->
  (key, _) := 'long_key=long_value'.split_once('=')!
  key

read_above := -> held
held := 'x=y'.split_once('=')!
(x, y) := held

struct Span
  start: P
  end: P

of_field := (span: Span) ->
  { start, end } := span
  { a, b } := start
  a + b + end.a
nested ['a=b', 'c']
print (multi_line(), read_above(), x + y, of_field({ start: { a: 1, b: 2 }, end: { a: 3, b: 4 } }))
