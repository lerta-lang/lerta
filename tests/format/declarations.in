export struct Point
  x: Int
  y: Int? = default 0
  scaled = (factor: Int) -> Point(x: @x * factor, y: @y * factor)

enum Color
  RED
  'light blue'

type Shape = Point | Circle

class Circle(radius: Int)

extern lerta_float_to_string as float_text: (Float) -> String

extend Point
  sum = () -> @x + @y

(first, _) := (1, 2)
{ x, y } := Point(x: 3, y: 4)
for (left, _) in [(5, 6)]
  print left
print first + x + y + Point(x: 1).sum()
