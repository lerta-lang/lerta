const check = (n: Int) ->
  return 'negative' if n < 0
  var i = 0
  i += 1 while i < n
  i += x for x in [1, 2]
  for x in [3, 4]
    return 'found' if x == n
  const label =
    case n
      when 0 then 'zero'
      when 1 then 'one'
      else 'many'
  if n == 2
    print 'two'
  else if n == 3
    print 'three'
  label
