numbers: Int[] = []
lengths: Map<String, Int> = Map()
names := Set<String>()
kept: Int[]
export exported: Int[] = []
twice: Set<String> = Set<String>()
nested: Int[][] = []
pairs: (Int, Int)[] = []
noted: String[] = []  # a comment
var growing: Int[] = []
var counts = Map<String, Int>()
maybe: Int[]? = [1]
some := [1]
given := { 'a': 1 }
optional_set: Set<String>? = Set()
total := ->
  local: Int[] = []
  local.push 1
  local.length
first := <T>(x: T) ->
  seen: Set<T> = Set()
  kept := Set<T>()
  seen.add x
  kept.add x
  seen.length + kept.length
numbers.push 1
lengths['a'] = 1
names.add 'a'
growing.push 1
counts['b'] = 2
print "#{numbers} #{lengths.length} #{names.length} #{kept} #{nested} #{pairs.length} #{noted}"
print "#{growing} #{counts.length} #{maybe ? []} #{some} #{given.length}"
print optional_set?.length ? 0
print "#{total()} #{first(1)} #{twice.length} #{exported.length}"
