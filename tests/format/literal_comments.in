# A comment before the `->` of a function literal without parameters, which the formatter cannot
# place, is reported, and its statement kept as it is written.
run := (f: () -> void) -> f()
both := (n: Int, f: () -> void) -> f()

f := ->
  run(
    # before a literal
    -> print 1
  )
  run(
    # before a block
    ->
      print 2
  )
  both(
    3
    # after an argument
    -> print 3
  )
  xs := [
    run(
      # in brackets
      -> print 4
    )
  ]
f()

ys := [
  # in an array
  -> print 5
]
g := (): (() -> void) ->
  return (
    # in parentheses
    -> print 6
  )
run(  # ending the line before
  -> print 7)
