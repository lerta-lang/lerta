# A comment before the `->` of a function literal without parameters, or before the parameters of
# one with them, which the formatter cannot place, is reported, and its statement kept as it is
# written. One before an operand in parentheses is placed.
run := (f: () -> void) -> f()
take := (f: (Int) -> Int) -> f(1)
same := (n: Int) -> n
pair := (f: (Int, Int) -> Int) -> f(1, 2)
constant := (f: () -> Int) -> f()
both := (n: Int, f: () -> void) -> f()

f := ->
  run(
    # before a literal
    -> print 1
  )
  run(
    # before a block
    ->
      print 2
  )
  both(
    3
    # after an argument
    -> print 3
  )
  xs := [
    run(
      # in brackets
      -> print 4
    )
  ]
f()

ys := [
  # in an array
  -> print 5
]
g := (): (() -> void) ->
  return (
    # in parentheses
    -> print 6
  )
run(  # ending the line before
  -> print 7)
h := ->
  take(
    # before the parameters
    (n) -> n
  )
  take(
    # before a return type
    (n: Int): Int -> n
  )
  take(
    # before type parameters
    <T>(n: T) -> n
  )
  constant(
    # before no parameters and a return type
    (): Int -> 1
  )
  take(
    # before a default
    (n = 1) -> n
  )
  take(  # ending the line before parameters
    (n) -> n)
  pair(
    # before parameters on lines of their own
    (a,
      b) -> a + b
  )
  print same(
    # before an operand
    (1 + 2) * 3
  )
h()
items := [
  # before an item in parentheses
  (1 + 2) * 3
]
apply := (
  n: Int
  g: (
    # before a function type
    (Int) -> Int
  )
) -> g(n)
print items
print apply(1, (x) -> x)
