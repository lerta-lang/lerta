struct A
  x: Int

f := (x: Int?, a: A | Int, xs: Int[]) ->
  return 0 if not x
  return 1 if not (x != 2)
  return 2 if not (x == nil)
  return 3 if not not (x > 9)
  if not (x in xs)
    print 'in'
  if not (a is A)
    print 'is'
  if not (x > 1 and x < 3)
    print 'and'
  return 4 unless x > 1 or x < 0
  if not (x == 5)
    print 'equal'
  if not x
    print 'else'
  else
    print 'not'
  if x == 6
    pass
  else if not (x > 7)
    print 'else if'
  unless x != 8
    print 'unless'
  unless x
    print 'kept'
  var n = 0
  n += 1 while not (n > 3)
  while not not (n < 9)
    n += 1
    print n
  while not n
    n = 1
  n += 1 until n >= 20
  y := not not x
  return 5 if not not x  # fmt: skip
  n
