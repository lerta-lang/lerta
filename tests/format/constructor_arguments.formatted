struct Point(x: Int, y = default 0)

class Counter(label: String, count = default 0)

struct Failure(code: Int): Error

struct Shape(sides: Int): Error

struct Mixed
  x: Int
  sum = @x + 1

struct Commented
  # The first field.
  first: Int

struct Wide(first_field_with_a_long_name: String, second_field_with_a_long_name: String, third: Int)

struct IndexError: Error

struct Narrowed
  first_narrowed_field_name: String
  second_narrowed_field_name: String
  third_field: Int

struct Noted
  # The only field.
  only: Int

struct Method
  apply = default (x: Int) ->
    const y = x + 1
    y * 2

export struct Pair<A, B>(first: A, second: B)

struct Tagged(value: Int)  # A note.

struct Annotated(value: Int)  # A note.

class Owner(weak! keeper: Owner, const id: Int)

struct Spaced(left: Int, right: Int)

struct Next(code: Int): Error

struct AlmostFitting: Error
  first_almost_fitting_name: String
  second_almost_fitting_too_long: String

struct Shifted(base: Int, shift = default (x: Int) -> x + 1)

class Opened  # A note.
  first: Int
  # The second.
  second: Int
