# A construction of only the one argument that it must give, of a struct, a class or a generic
# struct, gives its value alone; not of a name of an argument, which would give that argument, nor
# a spread, nor a copy of the field of another value, which is a spread, nor a record, nor a call
# of a function.
struct Box
  value: Int
  label := 'box'
struct Named
  value: Int
  other: Int?
struct Pair
  left: Int
  right: Int
class Counter
  count: Int
struct Wrapped<T>
  item: T
other := 4
make := (value: Int) -> Box(value)
boxed := Box(value: 1 + 2)
named := Named(value: other)
recorded: Box = { value: 5 }
copied := Box(boxed...)
struct Single
  x: Int
single := Single(x: 1)
same := Single(x: single.x)
pair := Pair(left: 1, right: 2)
counter := Counter(count: 7)
wrapped := Wrapped(item: 'w')
alone := Box(8)
error := ValueError(message: 'bad')
print [boxed.value, named.value, recorded.value, copied.value, pair.left, make(6).value]
print "#{counter.count} #{wrapped.item} #{alone.value} #{error.message} #{same.x}"
