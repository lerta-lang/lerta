# The names of an import go on its line with the module if they fit there, separated by commas, and
# otherwise in a block below it, as many on a line as fit, with `from` on the line after the block;
# a name after a comment stays in the block.
import a, b as bb from './import_names'
import c, b as b2 from './import_names'
import './import_names' as names
import 'std:io'
export c from './import_names'
import
  a_name_that_runs_on_and_on_and_on, another_name_that_runs_on_and_on, a as a2, b as b3
from './import_names'
import
  # the first
  a as a3
  b as b4
from './import_names'
print
  a + bb + c + b2 + names.a + a_name_that_runs_on_and_on_and_on + another_name_that_runs_on_and_on
print a2 + b3 + a3 + b4
import a as a5, b as b5 from './import_names'  # joined
export
  a_name_that_runs_on_and_on_and_on as a6, another_name_that_runs_on_and_on as b6
from './import_names'
import
  a as a8, b as b8

  # before from
from './import_names'
import
  a_name_that_runs_on_and_on_and_on as laid_out_a, another_name_that_runs_on_and_on as laid_out_b
from './import_names'
if a5 == b5
  import
    a_name_that_runs_on_and_on_and_on as a7, another_name_that_runs_on_and_on as b7
  from './import_names'
  print a7 + b7
