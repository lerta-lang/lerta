# A comprehension takes no space inside its brackets and one between its parts; one too long for its
# line goes on a line of its own inside them, and one too long for that on a line for each part.
xs := [1, 2, 3]
doubled := [x * 2 for x in xs]
evens := [x for x at i in xs when i % 2 == 0]
lazy := (x + 1 for x in xs)
print doubled, evens, lazy.to_array()
pairs := [(1, 'one'), (2, 'two')]
names := [name for (_, name) in pairs]
print names
print n for (n, _) in pairs
print n, name for (n, name) in pairs
long := [the_first_value_of_a_long_name + 1 for the_first_value_of_a_long_name in xs when true]
longer := [
  the_first_value_of_a_long_name * the_first_value_of_a_long_name + 1
  for the_first_value_of_a_long_name in xs
  when the_first_value_of_a_long_name > 1
]
middle :=
  [the_first_value_of_a_long_name + 1 for the_first_value_of_a_long_name in xs when xs.length > 0]
print long, longer, middle
bump := weak (n: Int) -> n + 1
print bump(1)
