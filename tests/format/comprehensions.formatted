    ]
    print deep
nested := [[y for y in xs when y > x] for x in xs when [z for z in xs].length > 0]
commented := [
  x + 1  # one more
  for x in xs
]
print nested, commented, sum((x for x in xs)), [(x for x in xs)]
same := weak <T>(v: T) -> v
for (a, b) at i in pairs
  print a, b, i
for (a, b) in pairs
  print a if a > 0
