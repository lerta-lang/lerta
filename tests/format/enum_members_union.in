# A member is written alone where a union that holds its enum, and no other enum, is expected; it
# keeps its enum where the union holds two.
enum Color
  RED
  GREEN

enum Size
  SMALL

struct Point
  x: Int

one: Color | Point = Color.RED
maybe: (Color | Point)? = Color.GREEN
two: Color | Size = Color.RED
text: Color | String = Color.GREEN
print [one is Color, maybe is Color, two is Color, text is Color]
