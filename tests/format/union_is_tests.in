# Tests of one subject next to each other in a chain of `or`s, or of `and`s for `is not`, go into
# one of their union; not those of a subject that runs code, as it would be evaluated once.
class A
  args
    n: Int

class B
  args
    n: Int

class C
  args
    n: Int

class Box
  args
    item: A | B | C
  get := -> @item

v: A | B | C | (Int, String) = C(1)
box := Box(A(2))
flag := true
print v is A or v is B
print v is A or v is B or v is C
print v is not A and v is not B
print flag or v is A or v is B or flag
print v is A | B or v is C
print box.item is A or box.item is B
print v is A or flag or v is B
print v is A or v is not B
print v is A and v is B
print v is A or box.item is B
print box.get() is A or box.get() is B
print (v is A) or v is B
print(v is A or v is B)
print v is (Int, String) or v is B
print (v is A or v is B) or v is C
w: A | B = A(3)
print v is A or w is A or v is B
print v is A or v is B or flag or v is C or v is (Int, String)
x := v is A or
  v is B
print x
print v is A or v is B and v is A
print v is not A or v is not B
print not (v is A) and not (v is B)
print v is A or (v is B)
