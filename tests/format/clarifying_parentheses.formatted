# The parentheses that clarify are added where the source has none: around `and` mixed with `or`,
# around an end of a range that is an operation, and around a `then`/`else` in the `then` value of
# another.
a := true
b := false
n := 3
print (a and b) or a
print b or (a and b)
print i for i in 0..(n - 1)
x :=
  if a
    b then 1 else 2
  else
    3
print x
xs := [1, 2, 3]
print xs.all_but_last()
print b or (a and xs[0] > 0)
print xs[(n - 2)..n.abs()]
print (a and b) or a
print b or (a and not b)
print a or (xs.length > -1 and b)
print (a and b) or (a and b)
same := (x: Bool) -> x
print (a and same(b)) or a
print (a and b) or a
print i for i in 0..n by (n - 2)
