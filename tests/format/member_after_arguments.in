# A member line after arguments without parentheses applies to the call's value, so it stays a
# line, one level deeper than the call's, as joined it would apply to the last argument.
items := ['a']
print items
.length
print items
      .length
print items
  .length
  .to_string()
if items.is_empty()
  print items  # the items
  .length
print 'a',
  'b'
.length
