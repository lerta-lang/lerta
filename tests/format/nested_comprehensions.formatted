# Each `for` of nested comprehensions, and its `when`, is a part of the comprehension, which goes
# on a line of its own when the comprehension does not fit on one.
xs := [1, 2, 3]
print [x * y for x in xs for y in xs when y > x]
long_name_values := [1, 2, 3]
print
  [
    long_name_value * other_long_name_value
    for long_name_value in long_name_values
    for other_long_name_value in long_name_values
    when other_long_name_value > long_name_value
  ]
pairs := [(a, b) for a in xs for b in xs]
print pairs
sums := [
  a + b
  for a in xs  # The rows
  for b in xs  # The columns
]
print sums
