# The names that a condition or a parameter takes a value apart into are spaced as those of a
# destructuring declaration.
struct P
  x: Int
  y: Int

pair: (Int, Int)? = (1, 2)
point: P? = { x: 1, y: 2 }
print a, b if (a, b) := pair
print x if { x } := point
print a while (a, _) := pair
while { x, y } := point
  print x
  print y
f := ({ x, y }: P) -> x + y
g := ({ x }: P): Int -> x
h := ((a, b): (Int, Int), c: Int): Int -> a + b + c
print f({ x: 1, y: 2 }), g({ x: 1, y: 2 }), h((1, 2), 3)
