# A tuple with a comment after an item keeps its commas, which alone separate its items, an item on
# each line.
x := (
  1,  # c
  2
)
y := (
  3,  # d
  4
)
print x
print y
three := (
  5,  # e
  6,
  7
)
print three
nested := (
  (
    8,  # f
    9
  ),
  10
)
print nested
sum := (a: Int, b: Int) -> a + b
called := (
  sum(
    1  # g
    2
  ),
  3
)
print called
mixed := (
  1,  # h
  [
    1  # i
    2
  ],
  4
)
print mixed
