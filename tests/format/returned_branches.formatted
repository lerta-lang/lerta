# An `if` or a `case` with `else` whose branches each return a value is the `return` of its value,
# with the `if` or the `case` on the lines below `return`, or the value alone at the end of a
# function; not one without `else`, nor one whose branch does more than return, nor one that holds
# a literal of several lines, whose value moving its lines would change.
sign := (n: Int) ->
  print n
  if n > 0
    'positive'
  else if n == 0
    # Neither.
    'zero'
  else
    'negative'
name := (n: Int) ->
  print n
  case n
    when 1 then 'one'
    when 2 then 'two'
    else 'many'
guarded := (n: Int) ->
  return n if n > 0
  n + 1
busy := (n: Int) ->
  if n > 0
    print n
    return n
  else
    return 0
add := (a: Int, b: Int) -> a + b
wrapped := (n: Int) -> n > 2 then n else add(n, 1)
commented := (n: Int) ->
  if n > 0
    1  # one
  else
    0
looped := (xs: Int[]) ->
  for x in xs
    return x > 0 then x else -x
  0
inner := (n: Int) ->
  print n
  return n > 0 then n else 0
  n
literal := (n: Int) ->
  if n > 0
    return '''
      many
      lines
      '''
  else
    return ''
nested := (n: Int, m: Int) ->
  if m > 0
    print m
    return n > 2 then n else 1
  else
    print n
  0
print nested(3, 1)
deep := (a: Bool, b: Bool) ->
  if a
    b then 1 else 2
  else
    return 3
middle := (n: Int) ->
  return
    case n
      when 1 then 'one'
      else 'other'
  'never'
chained := (n: Int) ->
  return
    if n > 1
      'big'
    else if n == 1
      'one'
    else
      'small'
  'never'
kept := (n: Int?) ->
  return n if n
  case n
    when nil
      print 'nil'
      return 0
    else return 1
tailed := (n: Int) ->
  print n
  return
    if n > 0
      1
    else
      2

      # The last branch.
  0
class Pick
  args
    n: Int
  pick := -> @n > 0 then 'positive' else 'other'
bound := (m: Int?) ->
  if n := m
    n
  else
    0
silent := (n: Int): void ->
  if n > 0
    print n
    return
  else
    return
print [tailed(1), bound(nil)]
print Pick(1).pick()
print [1].map((v) -> v > 0 then v else 0).to_array()
silent 1
print [deep(true, false), middle(1).count(), chained(0).count(), kept(nil)]
print [sign(1), name(2), "#{guarded(3)}", "#{busy(4)}"]
print [wrapped(1), commented(1), looped([2]), inner(3), literal(1).count()]
