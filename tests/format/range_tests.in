# Two comparisons of a value that runs no code with the ends of a range are written as a test of the
# range, after the `and`s before them, where the value is a number or a Char; the comparisons in the
# other order, an end that runs code, a start that excludes, values written otherwise and other
# types keep theirs.
n := 5
m := 7
c: Char = 'q'
s := 'q'
ratio := 0.5
end := -> 9
byte: Byte = b'q'
y := 4
print n >= 1 and n <= 9
print n >= 1 and n < 9
print 1 <= n and n <= 9
print 9 > n and 1 <= n
print m > 0 and n >= 1 and n <= 9
print c >= 'a' and c <= 'z'
print ratio >= 0.0 and ratio < 1.0
print n >= 1 and n <= end()
print n > 1 and n <= 9
print n >= 1 and m <= 9
print s >= 'a' and s <= 'z'
print n >= 0 and n <= 5 and y >= 1 and y < 9
print byte >= b'0' and byte <= b'9'
print n >= 1 and 9 > n
print n >= end() and n <= 9
print n > 1 and n < 9
print "#{n >= 0 and n <= 5}"
print [i for i in 0..9 when i >= 2 and i <= 5]
# So are two comparisons joined by `or` that test it outside, as `not in` the range.
print n < 1 or n > 9
print n < 1 or n >= 9
print 1 > n or 9 < n
print 1 > n or 9 <= n
print m < 0 or n < 1 or n > 9
print n <= 1 or n > 9
print n < 1 or n > end()
print s < 'a' or s > 'z'
print ratio < 0.0 or ratio > 1.0
print c < 'a' or c > 'z'
