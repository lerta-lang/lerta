# A response's body ends by its content-length, by its last chunk, or with the connection; one to
# HEAD, and one of 204 or 304, has none. A response of 1xx goes before the one that fetch gives.
import Client, FetchOptions from 'std:http'
import RawRequest, raw_server, Reply from './lib/raw_server'

MANY_CHUNKS := "1;#{'e'.repeat(1000)}\r\nx\r\n".repeat(70)

replies :=
  '/length': "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello"
  '/chunked': "HTTP/1.1 200 OK\r\nTransfer-Encoding: Chunked\r\n\r\n5;x=y\r\nhello\r\nA\r\n" +
    ", chunked!\r\n0\r\nx-trailer: t\r\n\r\n"
  '/until-close': "HTTP/1.1 200 OK\r\n\r\nuntil the end"
  '/head': "HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r\n"
  '/no-content': "HTTP/1.1 204 No Content\r\ncontent-length: 5\r\n\r\n"
  '/not-modified': "HTTP/1.1 304 Not Modified\r\ncontent-length: 5\r\n\r\n"
  '/continue': "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 103 Early Hints\r\nlink: </a>\r\n\r\n" +
    "HTTP/1.1 201 Created\r\ncontent-length: 4\r\n\r\ndone"
  '/short': "HTTP/1.1 200 OK\r\ncontent-length: 10\r\n\r\nshort"
  '/short-chunk': "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n9\r\nshort"
  '/bad-chunk': "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\nzz\r\n"
  '/space-before-size':
    "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n 3\r\nabc\r\n0\r\n" + "\r\n"
  '/space-after-size': "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n3 \r\nabc\r\n0\r\n\r\n"
  '/cr-after-size': "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n3\r\r\nabc\r\n0\r\n\r\n"
  '/space-before-extension':
    "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n3 \t;x\r\n" + "abc\r\n0\r\n\r\n"
  '/chunk-without-end': "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n2\r\nabc\r\n"
  '/chunked-over-length': "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\ncontent-length: 1\r\n" +
    "\r\n3\r\nabc\r\n0\r\n\r\n"
  '/long-chunk-size': "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n1000000000000000\r\n"
  '/two-lengths': "HTTP/1.1 200 OK\r\ncontent-length: 5\r\ncontent-length: 5\r\n\r\nhello"
  '/not-utf8': "HTTP/1.1 200 OK\r\ncontent-length: 1\r\n\r\n"
  '/empty-body': "HTTP/1.1 200 OK\r\ncontent-length: 0\r\n\r\n"
  '/short-trailer': "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n0\r\nx-trailer: t\r\n"
  '/zeros-before-size': "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n" +
    "00000000000000003\r\nabc\r\n0\r\n\r\n"
  '/switch': "HTTP/1.1 101 Switching Protocols\r\nupgrade: websocket\r\n\r\nframes"
  # The most digits that a size may have past its zeros.
  '/largest-size': "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n000fffffffffffffff\r\nabc"
  '/switch-after-continue': "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 101 Switching Protocols\r\n\r\n"
  '/gzip': "HTTP/1.1 200 OK\r\ntransfer-encoding: gzip, chunked\r\n\r\n"
  # Lines that come to more than 64 KiB, between pieces of data.
  '/long-trailer-line':
    "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n0\r\nx: " + "#{'t'.repeat(65536)}\r\n\r\n"
  '/many-chunks': "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n#{MANY_CHUNKS}0\r\n\r\n"
  '/bad-length': "HTTP/1.1 200 OK\r\ncontent-length: +5\r\n\r\nhello"
  '/bad-status': "HTTP/1.1 2000 OK\r\n\r\n"
  '/low-status': "HTTP/1.1 099 Early\r\n\r\nHTTP/1.1 200 OK\r\n\r\n"
  '/bad-version': "HTTP/2 200 OK\r\n\r\n"
  '/bad-field': "HTTP/1.1 200 OK\r\nno colon\r\n\r\n"
  '/no-head': ''

reply := (request: RawRequest) ->
  path := request.line.split(' ')[1]
  # Each closes its connection, so that a body that ends early or with it ends there.
  text := replies[path]!
  bytes := path == '/not-utf8' then text.binary + NOT_UTF8.to_binary() else text.binary
  Reply text: bytes, close: true

NOT_UTF8: Byte[] = [0xFF]

server := raw_server(reply)
client := Client()

show := (path: String, options: FetchOptions) ->
  try
    response := await client.fetch(server.url(path), options)
    print "#{path}: #{response.status} '#{(await response.text()) ? '(not UTF-8)'}'"
  catch error: IOError
    print "#{path}: #{error.message}"

await show(path, method: path == '/head' then 'HEAD' else 'GET') for path in replies.keys()
server.close()
