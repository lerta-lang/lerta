# serve_files gives the files under a directory, a directory's index.html at a path that ends with
# `/`, and 304 for a copy that is still good; but not the hidden files.
import make_dir, make_temp_dir, remove_tree, write_file from 'std:io'
import connect_tcp from 'std:net'
import fetch, Headers, serve, serve_files from 'std:http'
import absolute from 'std:path'
import platform from 'std:process'

root := make_temp_dir()
await write_file("#{root}/a.txt", 'hello')
await write_file("#{root}/with space.html", '<p>spaced</p>')
make_dir "#{root}/dir"
await write_file("#{root}/dir/index.html", '<p>index</p>')
make_dir "#{root}/empty"
make_dir "#{root}/odd/index.html"
await write_file("#{root}/README", 'no extension')
await write_file("#{root}/b.TXT", 'upper')
await write_file("#{root}/x.min.js", 'js')
await write_file("#{root}/.htaccess", 'dotfile')
await write_file("#{root}/a~b.txt", 'tilde')
await write_file("#{root}/a~1.txt", 'short')
await write_file("#{root}/dir/.hidden", 'dotfile')
make_dir "#{root}/.git"
await write_file("#{root}/.git/config", 'secret')
make_dir "#{root}/.well-known"
await write_file("#{root}/.well-known/a.txt", 'known')
await write_file("#{root}/.well-known/.hidden", 'dotfile')

server := serve(serve_files(root), port: 0)
base := "http://127.0.0.1:#{server.port}"

show := (path: String, method = 'GET', fields: (String, String)[] = []) ->
  headers := Headers()
  headers.set name, value for (name, value) in fields
  response :=
    await fetch("#{base}#{path}", method: method, headers: headers, follow_redirects: false)
  type := response.headers.get('content-type') else '-'
  location := response.headers.get('location') else '-'
  body := (await response.text())!
  print "#{method} #{path}: #{response.status} #{type} #{location} #{body}"

print 'files'
await show('/a.txt')
first := await fetch("#{base}/a.txt")
etag := first.headers.get('etag')!
last_modified := first.headers.get('last-modified')!
await show('/a.txt', 'HEAD')
await show('/with%20space.html')
await show('/a.txt?v=1')
await show('/missing')
await show('/%61.txt')
await show('//a.txt')
await show('/./a.txt')
await show('/README')
await show('/b.TXT')
await show('/x.min.js')
await show('/a.txt', 'POST')
print (await fetch("#{base}/a.txt", method: 'DELETE')).headers.get('allow')!

# Those whose names start with `.`, also escaped, at any depth, but under `/.well-known/`; and
# those whose names hold a `~` and a digit, as a short name does, which Windows gives `.git` as
# `GIT~1`. `/.well-known` itself is not hidden.
print 'hidden files'
await show('/.htaccess')
await show('/.git/config')
await show('/%2Egit/config')
await show('/dir/.hidden')
await show('/.well-known/a.txt')
await show('/.well-known/.hidden')
await show('/a~b.txt')
await show('/a~1.txt')
await show('/GIT~1/config')
await show('/GIT%7E1/config')
await show('/.well-known')

print 'directories'
await show('/dir')
await show('/dir?x=1')

# Not to `//dir/`, which a browser would take for the host `dir`.
await show('//dir')
await show('/dir', 'HEAD')
await show('/dir/')
await show('/empty/')
await show('/odd/')

print 'paths that leave the directory or do not decode'
await show('/%2E%2E/a.txt')
await show('/dir%2Findex.html')
await show('/a%5Cb')
await show('/%zz')
await show('/%ff')
await show('/a.txt%')
await show('/a.txt%4')

print 'paths past the host of a URL, without its fragment'

# The status and body of a request of `target`, as fetch sends no absolute form nor fragment.
raw := (target: String) ->
  socket := await connect_tcp('127.0.0.1', server.port)
  await socket.write("GET #{target} HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
  response := (await socket.reader.read_all()).text()!
  (status, _) := response.split_once("\r\n")!
  (_, body) := response.split_once("\r\n\r\n")!
  print "#{target}: #{status.split(' ')[1]} #{body}"
for target in [
  'http://x/a.txt'
  'http://x?/a.txt'
  'http://x#/a.txt'
  'http://x/a.txt#/dir/'
  'http://x/a.txt?v=1#f'
  'http://x'
  '/a.txt#f'
]
  await raw(target)

print 'validators'
await show('/a.txt', 'GET', [('if-none-match', etag)])
await show('/a.txt', 'HEAD', [('if-none-match', etag)])
await show('/a.txt', 'GET', [('if-none-match', "\"other\", W/#{etag}")])
await show('/a.txt', 'GET', [('if-none-match', '*')])
await show('/a.txt', 'GET', [('if-none-match', '"other"')])
await show('/a.txt', 'GET', [('if-none-match', 'W/"other"')])
await show('/a.txt', 'GET', [('if-none-match', "W/#{etag}")])
await show('/a.txt', 'GET', [('if-modified-since', last_modified)])
await show('/a.txt', 'GET', [('if-modified-since', 'Tue, 29 Feb 2000 00:00:00 GMT')])
await show('/a.txt', 'GET', [('if-modified-since', 'Fri, 01 Jan 2100 00:00:00 GMT')])

# Taken as 3 Mar, as the day is not checked against the month's length.
await show('/a.txt', 'GET', [('if-modified-since', 'Wed, 31 Feb 2100 00:00:00 GMT')])
for date in [
  'Friday, 01-Jan-2100 00:00:00 GMT'
  'Fri, 32 Jan 2100 00:00:00 GMT'
  'Fri, 01 Jan 2100 24:00:00 GMT'
  'Fri, 1 Jan 2100 00:00:00 GMT'
  'Fry, 01 Jan 2100 00:00:00 GMT'
  'Fri, 01 Jan 2100 00:00:00 UTC'
]
  await show('/a.txt', 'GET', [('if-modified-since', date)])
await show('/a.txt', 'GET', [('if-none-match', '"other"'), ('if-modified-since', last_modified)])
print etag.starts_with('"') and etag.ends_with('"')
print last_modified.ends_with(' GMT')

print 'a file of several chunks, sent as it is read'
big := [n.to_string() for n in 0..30000].join("\n")
await write_file("#{root}/big.txt", big)
for method in ['GET', 'HEAD', 'GET']
  response := await fetch("#{base}/big.txt", method: method)
  body := await response.binary()
  same := body == big.binary
  print "#{method}: #{response.headers.get('content-length')!} #{body.length} #{same}"

print 'an empty root'
try
  serve_files ''
catch error: ValueError
  print error.message

# A root that ends with separators, `\` too on Windows, is followed by one alone: on Windows, two
# that start a path, as after the root of the file system, make a network share, the name of a
# server and a share after them. Only the roots of the file system test that, on Windows: the
# first, whose separators end a directory, tells only that they are left out without harm.
print 'a root that ends with separators'
separator := platform == 'windows' then '\' else '/'
(_drive, below_root) := absolute(root).split_once('/')!
roots := [("#{root}#{separator}/", ''), ('/', "/#{below_root}"), ('//', "/#{below_root}")]
for (ending, prefix) in roots
  ended := serve(serve_files(ending), port: 0)
  for path in ["#{prefix}/a.txt", "#{prefix}/dir/"]
    response := await fetch("http://127.0.0.1:#{ended.port}#{path}")
    print "#{response.status} #{(await response.text())!}"
  await ended.close()

# A root that is a file is served at `/`.
print 'a file as the root'
single := serve(serve_files("#{root}/a.txt"), port: 0)
response := await fetch("http://127.0.0.1:#{single.port}/")
print "#{response.status} #{(await response.text())!}"
await single.close()

await server.close()
await remove_tree(root)
