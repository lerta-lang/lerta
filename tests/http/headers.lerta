# Headers tell names apart regardless of case, hold a name more than once, and throw for a name that
# is no token or a value that holds a control character.
import Headers from 'std:http'

headers := Headers()
headers.append 'Accept', 'text/plain'
headers.append 'accept', 'text/html'
print headers.get('ACCEPT') else 'none'
print 'accept' in headers
headers.set 'Accept', 'image/png'
print headers.get('accept') else 'none'
headers.append 'accept', 'text/html'
print headers.remove('ACCEPT')
print headers.remove('accept')
print 'accept' in headers
print headers.get('accept') else 'none'

for (name, value) in [
  ('x', "a\r\nset-cookie: evil")
  ('x', "a\nb")
  ('x', "a\0")
  ('x', "v\x0Bx")
  ('x', "a\x7F")
  ('x', "a\x1F")
  ('a b', 'c')
  ('', 'c')
]
  try
    headers.set name, value
  catch error: ValueError
    print error.message
print headers.fields.length
headers.set 'x', "a\tb c~\u{e9}"
print headers.get('x') else 'none'
