# The Date of a response is that of its own second, though the server makes it once a second: two
# responses a second apart give two dates, each the time of the test.
import fetch, serve from 'std:http'
import sleep from 'std:time'
import masked_date from './lib/date'

server := serve((_) -> { body: 'ok' })
url := "http://127.0.0.1:#{server.port()}/"
date := -> (await fetch(url)).headers.get('date')!
first := await date()
await sleep(1.1)
second := await date()
print masked_date("date: #{first}")
print masked_date("date: #{second}")
print first != second
await server.close()
