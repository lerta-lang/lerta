# Closing a server, once or twice, closes at once the connections that wait for their next request,
# or for their first, however long its idle timeout; a request that is being served gets its
# response first, and its connection ends then.
import connect_tcp, Socket from 'std:net'
import Deferred from 'std:async'
import Request, Response, serve from 'std:http'
import time from 'std:time'

started := Deferred<Bool>()
answered := Deferred<Bool>()
handle := (request: Request) ->
  if request.url.ends_with('/slow')
    started.resolve true
    await answered.promise()
  Response body: "ok\n"

server := serve(handle, idle_timeout: 3600.0)

# The response's lines, up to its end or the connection's.
read_response := (socket: Socket) ->
  var lines: String[] = []
  while line := await socket.reader.read_line()
    lines.push line
    break if line == 'ok'
  lines

idle := await connect_tcp('127.0.0.1', server.port())
await idle.write("GET / HTTP/1.1\r\nHost: a\r\n\r\n")
print (await read_response(idle)).last()!
busy := await connect_tcp('127.0.0.1', server.port())
await busy.write("GET /slow HTTP/1.1\r\nHost: a\r\n\r\n")
await started.promise()
# Accepted, but sending nothing yet.
silent := await connect_tcp('127.0.0.1', server.port())

start := time()
server.close()
server.close()
print await idle.reader.read_line() ? 'end'
# Reset instead if the listener was closed before the server took it.
try
  print await silent.reader.read_line() ? 'end'
catch _: IOError
  print 'end'
answered.resolve true
lines := await read_response(busy)
print "#{lines.contains('connection: close')} #{lines.last()!}"
print await busy.reader.read_line() ? 'end'
print time() - start < 1.0
idle.close()
silent.close()
busy.close()
