/length: 200 'hello'
/chunked: 200 'hello, chunked!'
/until-close: 200 'until the end'
/head: 200 ''
/no-content: 204 ''
/not-modified: 304 ''
/continue: 201 'done'
/short: a response ended early
/short-chunk: a response ended early
/bad-chunk: a malformed response
/chunk-without-end: a malformed response
/chunked-over-length: 200 'abc'
/long-chunk-size: a malformed response
/two-lengths: a malformed response
/not-utf8: a body is not valid UTF-8
/short-trailer: a response ended early
/zeros-before-size: 200 'abc'
/switch: switching protocols not supported
/largest-size: a response ended early
/switch-after-continue: switching protocols not supported
/gzip: a transfer coding not supported: gzip, chunked
/bad-length: a malformed response
/bad-status: a malformed response
/bad-version: a malformed response
/bad-field: a malformed response
/no-head: the connection closed before a response
