# A handler reads a request's body as text, nil if it is not valid UTF-8, '' if it is empty.
import fetch, Request, Response, serve from 'std:http'

NOT_UTF8: Byte[] = [0xFF]

handle := (request: Request) -> Response(body: "'#{(await request.text()) ? '(not UTF-8)'}'")

server := serve(handle)
url := "http://127.0.0.1:#{server.port}/"
for body in [NOT_UTF8.to_binary(), b'', b'hi']
  print (await (await fetch(url, method: 'POST', body: body)).text())!
await server.close()
