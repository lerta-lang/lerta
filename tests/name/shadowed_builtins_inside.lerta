# What the language does through builtin types and interfaces, as for, interpolation and catch
# do, does not go through the module's names that shadow them.
class String(x: Int)

class Iter(x: Int)

class Iterable(x: Int)

class Stringable(x: Int)

struct Oops: Error
  message = 'oops'

print "#{i}#{'ab'.binary.length}" for i in [1, 2]

try
  throw Oops()
catch e: Error
  print e.message
