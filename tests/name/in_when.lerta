# `in` and `when` are names wherever `for` and `case` do not take them.
in := [1, 2, 3]
when := (x: Int) -> x > 1

for x in in
  print x if when(x)

print x * 10 for x in [x for x in in when when(x)]

describe := (x: Int) ->
  case x  # fmt: skip
    when 1 then 'one'
    else 'many'

print describe(in[0])
print describe(in[2])
