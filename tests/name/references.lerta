# What a name refers to: a local that shadows a function or Map, a top-level value that holds a
# function, called from a function and from top-level code, one that top-level code's function
# literal captures, and a top-level var assigned from a function.
twice := (x: Int) -> x * 2
adder := (n: Int) -> (x: Int) -> x + n
add_one := adder(1)
var total = 0

shadowing := ->
  twice := (x: Int) -> x * 3
  Map := (x: Int) -> x - 1
  print twice(2)
  print Map(2)

calls_value := -> add_one(1)

adds := (n: Int) -> total += n

shadowing()
print calls_value()
print add_one(10)
later := -> add_one(total)
adds 5
print later()
print total

# A var that a function literal captures and assigns, and a narrowed local read in one.
counts := (start: Int?) ->
  var n = 0
  step := -> n += 1
  step()
  step()
  read := -> start then start + n else n
  read()
print counts(10)
print counts(nil)

# A caught error that a function literal captures and throws again.
try
  try
    throw ValueError('inner')
  catch e
    again := -> throw e
    again()
catch e
  print e.message

# Top-level values that function literals capture: one narrowed in a function, and a var that a
# literal of top-level code assigns.
narrowed: Int? = 5
captures_narrowed := ->
  if narrowed
    g := -> narrowed + 1
    g()
  else
    0
print captures_narrowed()
var tally = 0
bump := -> tally += 2
bump()
print tally

# Map and Set made in a generic function.
collected := <T>(x: T) ->
  m := Map<String, T>()  # fmt: skip
  m['x'] = x
  s := Set<Int>()  # fmt: skip
  s.add 1
  m.length + s.length
print collected('a')
