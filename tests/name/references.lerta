# What a name refers to: a local that shadows a function or Map, a top-level value that holds a
# function, called from a function and from top-level code, one that top-level code's function
# literal captures, and a top-level var assigned from a function.
const twice = (x: Int) -> x * 2
const adder = (n: Int) -> (x: Int) -> x + n
const add_one = adder(1)
var total = 0

const shadowing = ->
  const twice = (x: Int) -> x * 3
  const Map = (x: Int) -> x - 1
  print twice(2)
  print Map(2)

const calls_value = -> add_one(1)

const adds = (n: Int) -> total += n

shadowing()
print calls_value()
print add_one(10)
const later = -> add_one(total)
adds 5
print later()
print total

# A var that a function literal captures and assigns, and a narrowed local read in one.
const counts = (start: Int?) ->
  var n = 0
  const step = -> n += 1
  step()
  step()
  const read = -> start then start + n else n
  read()
print counts(10)
print counts(nil)

# A caught error that a function literal captures and throws again.
try
  try
    throw ValueError(message: 'inner')
  catch e
    const again = -> throw e
    again()
catch e
  print e.message

# Top-level values that function literals capture: one narrowed in a function, and a var that a
# literal of top-level code assigns.
const narrowed: Int? = 5
const captures_narrowed = ->
  if narrowed
    const g = -> narrowed + 1
    g()
  else
    0
print captures_narrowed()
var tally = 0
const bump = -> tally += 2
bump()
print tally

# Map and Set made in a generic function.
const collected = <T>(x: T) ->
  const m = Map<String, T>()
  m['x'] = x
  const s = Set<Int>()
  s.add 1
  m.length + s.length
print collected('a')
