# Fails when it first runs and passes after that: each run is in a directory of its own, but they
# share the one above, where the first run leaves a mark.
import is_file, write_file from 'std:io'
import exit from 'std:process'

mark := '../flaky-ran'
if is_file(mark)
  print 'ok'
else
  await write_file(mark, ''.binary)
  exit 1
