class Version
  args
    major: Int
  compare := (other: Version) -> @major.compare(other.major)

print (1, 'b') < (1, 'c')
print (2, 'a') < (1, 'z')
print (1, 'a').compare((1, 'a'))
print (2, 'a').compare((1, 'z'))
pairs := [(2, 'b'), (1, 'z'), (2, 'a'), (1, 'a')]
print pairs.sorted()
print pairs.sorted_by(((n, s)) -> (-n, s))
words := ['pear', 'fig', 'apple', 'kiwi']
print words.sorted_by((w) -> (w.count(), w))
print words.max_by((w) -> (w.count(), w))!
print min((1, 2), (1, 1))
nested := [((1, 'b'), 2.5), ((1, 'a'), 3.0)]
print nested.sorted()
(_, first) := [(Version(2), 1), (Version(1), 2)].sorted()[0]
print first
print (1, 'a') >= (1, 'a')
largest := <T: Comparable>(xs: T[]) -> xs.max()!
print largest([(1, 'a'), (3, 'b'), (3, 'a')])
extend Bool
  compare := (other: Bool) -> (@ then 1 else 0).compare(other then 1 else 0)
print (true, 1) < (false, 2)
first_lower := <T: Comparable>(a: T, b: T) -> (a, 1) < (b, 0)
print first_lower('a', 'a')
class Faulty
  compare := (other: Faulty): Ordering -> throw ValueError('cannot order')
try
  print (Faulty(), 1) < (Faulty(), 2)
catch error: ValueError
  print error.message
