# Tuples: made, taken apart by position, compared by their items, and held as references.
type Pair = (Int, String)

const swap = (t: (String, Int)) ->
  const (s, n) = t
  (n, s)

const pair = ('a', 1)
const (n, s) = swap(pair)
print "#{n} #{s}"
var (low, high) = (1, 2)
low += high
print low
const (_, second, _) = (true, 'two', 3)
print second
print (7)  # fmt: skip
const nested = ((1, 2), [3, 4])
const (inner, list) = nested
const (one, two) = inner
print one + two + list.length
const maybe: (String, Int?) = ('b', nil)
const (b, none) = maybe
print "#{b} #{none ? -1}"
const absent: (Int, Int)? = nil
print absent == nil
print pair == ('a', 1)
print pair == ('a', 2)
const seen: Map<(String, Int), Bool>
seen[pair] = true
print seen[('a', 1)] ? false
const first = <T>(t: (T, Int)) ->
  const (item, _) = t
  item
print first(('z', 9))
