# Tuples: made, taken apart by position, compared by their items, and held as references.
type Pair = (Int, String)

swap := (t: (String, Int)) ->
  (s, n) := t
  (n, s)

pair := ('a', 1)
(n, s) := swap(pair)
print "#{n} #{s}"
var (low, high) = (1, 2)
low += high
print low
(_, second, _) := (true, 'two', 3)
print second
print (7)  # fmt: skip
nested := ((1, 2), [3, 4])
(inner, list) := nested
(one, two) := inner
print one + two + list.length
maybe: (String, Int?) = ('b', nil)
(b, none) := maybe
print "#{b} #{none ? -1}"
absent: (Int, Int)? = nil
print absent == nil
print pair == ('a', 1)
print pair == ('a', 2)
seen: Map<(String, Int), Bool>
seen[pair] = true
print seen[('a', 1)] ? false
first := <T>(t: (T, Int)) ->
  (item, _) := t
  item
print first(('z', 9))
