# A loop takes each item, a tuple, apart; its parts, like a loop variable, need not be used.
pairs := [('x', 1), ('y', 2), ('z', 3)]
# fmt: off
for (key, value) in pairs
  print "#{key}=#{value}"
for (key, _) at i in pairs
  print "#{i}: #{key}"
print "#{key}" for (key, value) in pairs when value != 2
# fmt: on
print ["#{value * 10}" for (_, value) in pairs].join(' ')
print [key for (key, value) in pairs when value > 1].join(' ')
lazy := ("#{key}#{value}" for (key, value) in pairs when value != 2)
print each for each in lazy
