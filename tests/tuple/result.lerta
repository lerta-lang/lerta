# As a function literal's return type, before the `->` of its body, two or more types in
# parentheses are a tuple, and a function type is written in parentheses.
# fmt: off
twice := (x: Int): (Int, Int) -> (x, x)
maybe := (x: Int): (Int, String)? ->
  x > 0 then (x, 'positive') else nil

# fmt: on
adder := (): ((Int, Int) -> Int) -> (a, b) -> a + b
plus_one := (n: Int): ((Int) -> Int) -> (x) -> x + n
(a, b) := twice(3)
print a + b
print maybe(-1) == nil
(n, s) := maybe(2)!
print "#{n} #{s}"
print adder()(1, 2)
print plus_one(1)(1)
applier := (): (((Int) -> Int) -> Int) -> (f) -> f(5)
print applier()((x) -> x * 2)
