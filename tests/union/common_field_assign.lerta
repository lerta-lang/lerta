class Owner
  name: String

class Car
  owner: Owner
  miles: Int

class Boat
  miles = 0
  owner: Owner

class Plane
  owner: Owner
  miles = 100

type Vehicle = Car | Boat | Plane

service := (vehicle: Vehicle) ->
  vehicle.miles += 10
  vehicle.owner = Owner(name: "#{vehicle.owner.name}'s heir")

vehicles: Vehicle[] =
  Car(owner: Owner(name: 'ann'), miles: 5)
  Boat(owner: Owner(name: 'bob'))
  Plane(owner: Owner(name: 'cy'))
for vehicle in vehicles
  service vehicle
  print "#{vehicle.owner.name} #{vehicle.miles}"

var pair: Car | Boat = Car(owner: Owner(name: 'dee'), miles: 1)
pair.miles = 2
pair.owner = Owner(name: 'eve')
print "#{pair.owner.name} #{pair.miles}"
pair = Boat(owner: Owner(name: 'fay'))
pair.miles *= 3
pair.owner = pair.owner
print "#{pair.owner.name} #{pair.miles}"
