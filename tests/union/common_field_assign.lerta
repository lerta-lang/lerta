class Owner
  args
    name: String

class Car
  args
    var owner: Owner
    var miles: Int

class Boat
  args
    var owner: Owner
  var miles = 0

class Plane
  args
    var owner: Owner
  var miles = 100

type Vehicle = Car | Boat | Plane

service := (vehicle: Vehicle) ->
  vehicle.miles += 10
  vehicle.owner = Owner("#{vehicle.owner.name}'s heir")

vehicles: Vehicle[] = [Car(owner: Owner('ann'), miles: 5), Boat(Owner('bob')), Plane(Owner('cy'))]
for vehicle in vehicles
  service vehicle
  print "#{vehicle.owner.name} #{vehicle.miles}"

var pair: Car | Boat = Car(owner: Owner('dee'), miles: 1)
pair.miles = 2
pair.owner = Owner('eve')
print "#{pair.owner.name} #{pair.miles}"
pair = Boat(Owner('fay'))
pair.miles *= 3
pair.owner = pair.owner
print "#{pair.owner.name} #{pair.miles}"
