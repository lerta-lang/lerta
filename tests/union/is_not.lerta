struct A
  x: Int
struct B
  y: Int
type AB = A | B

describe := (v: AB) ->
  print v is not A
  return 'not A' if v is not A
  "A #{v.x}"

either := (v: AB?) -> v is not B then 'not B' else "B #{v.y}"

print describe(A(x: 1))
print describe(B(y: 2))
print either(nil)
print either(A(x: 1))
print either(B(y: 3))

both := (v: AB, w: AB) ->
  if v is not A or w is not B
    'not A and B'
  else
    "#{v.x} #{w.y}"

print both(A(x: 4), B(y: 5))
print both(B(y: 4), B(y: 5))
values: AB[] = [A(x: 1), B(y: 2)]
print not (v is not A) for v in values
