struct A
  x: Int
struct B
  y: Int
type AB = A | B

describe := (v: AB) ->
  print v is not A
  return 'not A' if v is not A
  "A #{v.x}"

either := (v: AB?) -> v is not B then 'not B' else "B #{v.y}"

print describe(A(1))
print describe(B(2))
print either(nil)
print either(A(1))
print either(B(3))

both := (v: AB, w: AB) ->
  if v is not A or w is not B
    'not A and B'
  else
    "#{v.x} #{w.y}"

print both(A(4), B(5))
print both(B(4), B(5))
values: AB[] = [A(1), B(2)]
print not (v is not A) for v in values
