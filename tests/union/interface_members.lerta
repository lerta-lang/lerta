# An interface is a member of a union, which holds its value in a box: a value of a type that is no
# member converts to the one interface member that it satisfies, while a value of a member stays
# that member; a test, a cast, a case and a method that every member has see it.
import stdout, Writer from 'std:io'

interface Shape
  area: () -> Int

struct Square
  side: Int
  area = -> @side * @side

class Circle
  r: Int
  area = -> 3 * @r * @r

describe := (value: Byte[] | Shape | String) ->
  return "bytes #{value.length}" if value is Byte[]
  return "shape #{value.area()}" if value is Shape
  "string #{value}"

bytes: Byte[] = [1, 2]
print describe(bytes)
print describe(Square(side: 3))
print describe(Circle(r: 1))
shape: Shape = Square(side: 2)
print describe(shape)
print describe('text')

kept: Shape | Int = Square(side: 4)
print (kept as Shape!).area()
print case kept
  when Shape then 'a shape'
  when Int then 'an int'

own: Square | Shape = Square(side: 5)
print own is Square
print own.area()

sink := (to: Byte[] | Writer) ->
  if to is Writer
    await to.write("to a writer\n")
  else
    print to.length
await sink(stdout)
await sink(bytes)
