# More of the members that are objects: in return types, in any order; nested arrays; an optional
# union; two anonymous structs and two tuples, each of its own type; an array that another module
# made; unions compared and used as map keys; and an array of tuples.
import numbers from './lib/objects'

first := (): Int | (Int, String) -> 1
second := (): (Int, String) | Int -> (2, 'two')
print first() is Int
print second() is (Int, String)

nested: Int[][] | String = [[1], [2, 3]]
print (nested as Int[][]!).length
print nested is Int[][]

maybe: Int[]? | String = nil
print maybe is Int[]

records: { a: Int } | { b: Int } = { b: 1 }
print records is { a: Int }
print records is { b: Int }
tuples: (Int, Int) | (String, Int) = ('s', 1)
print tuples is (Int, Int)

print numbers() is Int[]

left: Int[] | String = [1, 2]
right: Int[] | String = [1, 2]
print left == right
counts: Map<Int[] | String, Int>
counts[left] = 1
print counts[right] ? 0

pairs: (Int, String)[] | Int = [(1, 'one')]
print pairs is (Int, String)[]
