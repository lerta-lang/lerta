class Circle
  name: String
  radius: Int

class Square
  side: Int
  name = "square"

class Triangle
  name: String
  sides = 3

type Shape = Circle | Square | Triangle

const describe = (shape: Shape): String -> shape.name

const shapes: Array<Shape> = [Circle(name: "circle", radius: 1), Square(side: 2), Triangle(name: "triangle")]
for shape in shapes
  print describe(shape)

struct Meters
  amount: Int
  unit = "m"

struct Feet
  unit = "ft"
  amount: Int

const lengths: Array<Meters | Feet> = [Meters(amount: 5), Feet(amount: 7)]
for length in lengths
  print "#{length.amount} #{length.unit}"

class Owner
  name: String

class Car
  owner: Owner

class Boat
  owner: Owner

var vehicle: Car | Boat = Car(owner: Owner(name: "ann"))
print vehicle.owner.name
vehicle = Boat(owner: Owner(name: "bob"))
print vehicle.owner.name
