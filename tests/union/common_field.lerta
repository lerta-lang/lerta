class Circle(name: String, radius: Int)

class Square
  side: Int
  name = 'square'

class Triangle
  name: String
  sides = 3

type Shape = Circle | Square | Triangle

const describe = (shape: Shape) -> shape.name

const shapes: Shape[] =
  Circle(name: 'circle', radius: 1)
  Square(side: 2)
  Triangle(name: 'triangle')
print describe(shape) for shape in shapes

struct Meters
  amount: Int
  unit = 'm'

struct Feet
  unit = 'ft'
  amount: Int

const lengths: (Meters | Feet)[] = [Meters(amount: 5), Feet(amount: 7)]
print "#{length.amount} #{length.unit}" for length in lengths

class Owner(name: String)

class Car(owner: Owner)

class Boat(owner: Owner)

var vehicle: Car | Boat = Car(owner: Owner(name: 'ann'))
print vehicle.owner.name
vehicle = Boat(owner: Owner(name: 'bob'))
print vehicle.owner.name
