class Circle
  name: String
  radius: Int

class Square
  side: Int
  name := 'square'

class Triangle
  name: String
  sides := 3

type Shape = Circle | Square | Triangle

describe := (shape: Shape) -> shape.name

shapes: Shape[] = [Circle(name: 'circle', radius: 1), Square(2), Triangle('triangle')]
print describe(shape) for shape in shapes

struct Meters
  amount: Int
  unit := 'm'

struct Feet
  unit := 'ft'
  amount: Int

lengths: (Meters | Feet)[] = [Meters(5), Feet(7)]
print "#{length.amount} #{length.unit}" for length in lengths

class Owner
  name: String

class Car
  owner: Owner

class Boat
  owner: Owner

var vehicle: Car | Boat = Car(Owner('ann'))
print vehicle.owner.name
vehicle = Boat(Owner('bob'))
print vehicle.owner.name
