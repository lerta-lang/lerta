# A union holds Bools as it holds other values: each true and each false is the same as another,
# however many are made, kept, replaced and dropped, in arrays, maps and fields, and next to values
# of other members, and alike where another module boxes and tests them.
import describe_flag, make_flag from './lib/boxed'
class Holder
  var value: Int | Bool

flags: (Int | Bool)[] = [true, 1, false]
flags.push i % 2 == 0 for i in 0..6
flags[0] = false
flags[1] = true
print [flag for flag in flags when flag == true].length
print [flag for flag in flags when flag == false].length
print [flag for flag in flags when flag is Int].length
last := flags.pop()
print last
by_name: Map<String, Int | Bool> = { 'a': true, 'b': 2 }
by_name['a'] = false
by_name['c'] = true
print [value is Bool then "bool #{value}" else 'int' for value in by_name.values()].join(', ')
holder := Holder(value: true)
holder.value = 3
holder.value = holder.value is Int
print holder.value
var maybe: Int | Bool? = nil
print maybe == nil
maybe = true
print maybe == true
case maybe
  when Bool then print(maybe then 'yes' else 'no')
  when Int then print('int')
  else print('nil')
print make_flag(true) == true
print describe_flag(false)
print [describe_flag(make_flag(i % 2 == 0)) for i in 0..2].join(', ')
