# Makes and tells the boxes of another module's unions (see value_kinds).
export make := (n: Int): Int | String -> n > 0 then "n#{n}" else n

export describe := (value: Int | String) -> value is String then "string #{value}" else 'int'

# A Bool boxed here and one boxed there are told apart and compared alike (see bool_boxes).
export make_flag := (on: Bool): Int | Bool -> on

export describe_flag := (value: Int | Bool) -> value is Bool then "bool #{value}" else 'int'
