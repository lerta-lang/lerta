class Circle(r: Int)

class Square(side: Int)

type Shape = Circle | Square

const radius = (s: Shape?) ->
  const c = s as Circle ? return -1
  c.r

print radius(Circle(r: 3))
print radius(Square(side: 2))
print radius(nil)
const shape: Shape = Square(side: 5)
print (shape as Square!).side
print square.side if const square = shape as Square?
print [each for each in [shape] when (each as Circle?) == nil].length
const show = (circle: Circle?) -> print(circle then circle.r else -1)
show shape as Circle?
