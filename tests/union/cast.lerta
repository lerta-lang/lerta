class Circle
  args
    r: Int

class Square
  args
    side: Int

type Shape = Circle | Square

radius := (s: Shape?) ->
  c := s as Circle else return -1
  c.r

print radius(Circle(3))
print radius(Square(2))
print radius(nil)
shape: Shape = Square(5)
print (shape as Square!).side
print square.side if square := shape as Square?
print [each for each in [shape] when (each as Circle?) == nil].length
show := (circle: Circle?) -> print(circle then circle.r else -1)
show shape as Circle?
