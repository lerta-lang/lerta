# A union holds numbers, Bools, Strings and Binaries as it holds a struct: it tells them apart, by
# `is`, `as` and `case`, compares them and keys a map with them, and nil is one of its values when a
# member is optional.
struct Point
  x: Int

describe := (value: Int | String | Point | Bool) ->
  case value
    when Int then "int #{value + 1}"
    when String then "string #{value}"
    when Point then "point #{value.x}"
    when Bool then value then 'yes' else 'no'

print describe(1)
print describe('a')
print describe(Point(3))
print describe(false)
values: (Int | String)[] = [1, 'b', 2]
print values[1] == 'b'
print values[0] == 1
print values[0] == 'b'
keys := Set<Int | String>([1, 'a', 1, 'a'])
print keys.length
id: Int | String? = nil
print id == nil
number: Int | String = 5
print (number as Int ? 0) + 1
print number as String ? 'none'
print (number as Int!) * 2
print number * 3 if number is Int
bytes: Float | Binary = b'ab'
print bytes.length if bytes is Binary
