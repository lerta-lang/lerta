enum Color
  RED
  GREEN

class Dog
  name: String

class Cat
  lives: Int

extend Dog
  speak = -> "#{@name} says woof"

extend Cat
  speak = -> "#{@lives} lives say meow"

type Pet = Dog | Cat

const describe = (pet: Pet?) -> pet?.speak() ? '-'
print describe(Dog(name: 'Rex'))
print describe(Cat(lives: 9))
print describe(nil)

const marks: (Color | Int)[] = [Color.GREEN, 4]
print mark.to_string() for mark in marks

const values: (Int | Float | String)[] = [1, 2.5, 'text']
for value in values
  print value.to_string() if value is not String

const pet: Pet = Dog(name: 'Rex')
var heard = 0
heard += 1 for i in 0...1000 if pet.speak() == 'Rex says woof'
print heard
