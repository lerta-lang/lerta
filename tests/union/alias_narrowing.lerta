class A(n: Int)

class B(n: Int)

class C(n: Int)

class D(m: Int)

type ABC = A | B | C
type ABCD = ABC | D

const describe = (v: ABCD?) ->
  case v
    when ABC then print(v.n)
    when nil then print('nil')
    else print('d')

const first = (v: ABCD) ->
  case v
    when ABC, D then 'any'

const v: ABCD = C(n: 3)
print v.n if v is ABC
describe v
describe D(m: 1)
describe nil
print first(v)
print (v as ABC!).n
