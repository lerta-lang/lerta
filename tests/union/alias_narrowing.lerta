class A
  args
    n: Int

class B
  args
    n: Int

class C
  args
    n: Int

class D
  args
    m: Int

type ABC = A | B | C
type ABCD = ABC | D

describe := (v: ABCD?) ->
  case v
    when ABC then print(v.n)
    when nil then print('nil')
    else print('d')

first := (v: ABCD) ->
  case v
    when ABC, D then 'any'

v: ABCD = C(3)
print v.n if v is ABC
describe v
describe D(1)
describe nil
print first(v)
print (v as ABC!).n
