struct Circle(r: Int)
class Square
  side: Int
  grow = -> @side += 1
type Shape = Circle | Square

const area = (s: Shape) ->
  case s
    when Circle then 3 * s.r * s.r
    else 0
const describe = (s: Shape) ->
  if s is Square
    s.grow()
    return "square #{s.side}"
  return 'circle' if s is Circle
  'unknown'

const shapes: Shape[] = [Circle(r: 2), Square(side: 3)]
for shape in shapes
  print area(shape)
  print describe(shape)
print shapes[1] is Square
print shapes[0] is Square
print (shapes[0] is Square) == false
