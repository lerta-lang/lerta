# A cast, `as T!` or `as T?`, of a value already narrowed to T by `is` or by a branch of a `case`,
# gives the value, of a type that the union holds boxed or by reference, of an optional union too,
# and so does a cast to the union itself. `lerta fmt` would leave out such casts.
# fmt: off
struct Point
  x: Int

type Value = Int | String | Point

plus_one := (value: Value) -> value is Int then (value as Int!) + 1 else 0
shout := (value: Value) -> value is String then (value as String!) + '!' else ''
across := (value: Value) -> value is Point then (value as Point!).x else 0
maybe := (value: Value) -> value is Int then value as Int? else nil
named := (value: Value) -> value is String then value as String? else nil
some := (value: Value?) -> value is Int then value as Int? else nil
itself := (value: Value) -> value as Value?

describe := (value: Value) ->
  case value
    when Int then "#{(value as Int!) * 2}"
    when String then value as String!
    else '?'

print plus_one(4)
print shout('hi')
print across(Point(x: 7))
print maybe(2)! + 1
print named('yes')!
print maybe('no') == nil
print [some(8)!, some(nil) else 0]
print itself(1) != nil
print [describe(3), describe('s'), describe(Point(x: 0))]
s: Value = ''
if s is String
  print((s as String!) == '')
