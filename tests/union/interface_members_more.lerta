# More conversions to an interface member: in a return, in an array, to an optional union, of an
# array to Iterable, and not of a type that has the member's name with another type; to two
# instances of one interface, in generic functions, between two interface members, to an interface
# of std, and on an assignment.
interface Shape
  area: () -> Int

interface Named
  area: () -> String

struct Square
  side: Int
  area = -> @side * @side

made := (): Shape | Int -> Square(2)
print made() is Shape
shapes: (Shape | Int)[] = [Square(1), 3]
print [item is Shape for item in shapes]
var maybe: Shape | String? = nil
print maybe is Shape
maybe = Square(3)
print maybe is Shape
near: Named | Shape = Square(4)
print near is Shape
items: Iterable<Int> | String = [1, 2]
print items is Iterable<Int>

words: Iterable<Int> | Iterable<String> = ['a']
print words is Iterable<Int>
print words is Iterable<String>
pair := <T>(value: T): Iterable<T> | Int -> [value, value]
print pair(1) is Iterable<Int>
bounded := <T: Shape>(shape: T): Shape | Int -> shape
print bounded(Square(5)) is Shape

interface Sink
  put: (Int) -> Int

struct Doubler
  put = (n: Int) -> 2 * n

use := (value: Shape | Sink) ->
  if value is Shape
    value.area()
  else
    value.put 10
print use(Square(2))
print use(Doubler())
texts: Stringable | Int = 'text'
print texts is Stringable
numbers: Stringable | Int = 4
print numbers is Int
var changed: Shape | Int = 3
changed = Square(1)
print changed is Shape
