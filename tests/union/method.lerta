class Dog
  args
    name: String
  speak := (times: Int) -> 'woof'.repeat(times)
  greet := -> print("dog #{@name}")
  to_string := -> "Dog(#{@name})"

class Cat
  args
    lives: Int
  speak := (times: Int) -> 'meow'.repeat(times)
  greet := -> print("cat #{@lives}")
  to_string := -> "Cat(#{@lives})"

pets: (Dog | Cat)[] = [Dog('Rex'), Cat(9)]
for pet in pets
  print pet.speak(2)
  pet.greet()
  print pet

values: (Int | Float | String)[] = [3, 2.5, 'text']
for value in values
  print value
  print "<#{value}> #{value.to_string() + "!"}"
