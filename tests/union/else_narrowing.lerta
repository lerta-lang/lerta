struct A
  x: Int
struct B
  y: Int
struct C
  z: Int
type ABC = A | B | C
type BC = B | C

sum := (v: BC) -> v is B then v.y else v.z

guarded := (v: ABC) ->
  return 'A' if v is A
  print v is A
  "#{sum(v)}"

of_optional := (v: ABC?) ->
  if v is A
    'A'
  else
    rest: BC? = v  # fmt: skip
    rest then "#{sum(rest)}" else 'nil'

of_case := (v: ABC?) ->
  case v
    when A then 'A'
    when nil then 'nil'
    else "#{sum(v)}"

of_case_one_left := (v: ABC) ->
  case v  # fmt: skip
    when A, B then 'A or B'
    else "#{v.z}"

widened := (v: ABC?, w: ABC?) ->
  return w if v is A
  v

label := (v: ABC?) ->
  w := widened(v, A(0))
  w is A then 'A' else w is B then 'B' else w is C then 'C' else 'nil'  # fmt: skip

cast_after := (v: ABC) ->
  return 'A' if v is A
  v as A? then 'cast' else 'no A'

case_after_guard := (v: ABC) ->
  return 'A' if v is A
  case v
    when A then 'never'
    when B then 'B'
    else "#{v.z}"

negated := (v: ABC) ->
  return "#{sum(v)}" unless v is A
  "A #{v.x}"

widened_optional := (v: ABC) ->
  a := v as A?
  wide: ABC? = a
  wide is A

either := (flag: Bool, v: ABC) -> flag then A(9) else v

values: ABC[] = [A(1), B(2), C(3)]
print "#{guarded(v)} #{of_optional(v)} #{of_case(v)} #{of_case_one_left(v)}" for v in values
print "#{of_optional(nil)} #{of_case(nil)}"
print "#{label(v)} #{cast_after(v)}" for v in values
print label(nil)
for v in values
  print "#{case_after_guard(v)} #{negated(v)} #{widened_optional(v)} #{either(true, v) is A}"
