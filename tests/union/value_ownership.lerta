# Strings in a union's boxes are retained and released as anywhere else, through functions, arrays,
# maps and fields; a narrowing to an optional member takes it out of its box or gives nil.
struct Labeled
  label: Int | String

label_of := (n: Int): Int | String -> n > 0 then "n#{n}" else n

labels := [label_of(1), label_of(-2), label_of(3)]
by_label: Map<Int | String, Int>
by_label[label] = i for label, i in labels
print by_label['n3'] ? -1
print by_label[-2] ? -1
kept := Labeled(label: labels[0])
print kept.label as String ? '-'

maybe: Int | String? = 'text'
print maybe ? 'nil' if maybe is not Int
missing: Int | String? = nil
print missing ? 'nil' if missing is not Int
