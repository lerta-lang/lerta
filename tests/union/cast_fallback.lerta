struct A
  x: Int
struct B
  y: Int
type AB = A | B

x_of := (v: AB) ->
  a := v as A else return -1
  a.x

y_of := (v: AB) -> (v as B else { y: 0 }).y

either := (v: AB, flag: Bool) -> (v as A else { x: 0 }).x > 0 or flag

print "#{x_of(A(x: 3))} #{x_of(B(y: 1))} #{y_of(A(x: 1))} #{y_of(B(y: 2))}"
print "#{either(A(x: 1), false)} #{either(B(y: 1), false)} #{either(B(y: 1), true)}"

struct Box<T>
  value: T
type Boxes = Box<Int> | Box<String>

chained := (v: AB, w: AB) -> v as A else w as A else { x: 0 }
nested := (v: AB, w: A?) -> v as A else w else { x: 7 }
boxed := (b: Boxes) -> (b as Box<Int> else { value: -1 }).value

print "#{chained(B(y: 1), A(x: 4)).x} #{chained(B(y: 1), B(y: 1)).x}"
print "#{boxed(Box(value: 5))} #{boxed(Box(value: 'a'))}"
print "#{nested(B(y: 1), nil).x} #{nested(B(y: 1), A(x: 8)).x}"

# `else` binds tighter than `as` and `is`: the whole of `a else b` is cast or tested.
cast_whole := (a: AB?, b: AB) -> (a else b as A?) != nil
test_whole := (a: AB?, b: AB) -> a else b is A
print
  "#{cast_whole(A(x: 1), B(y: 1))} #{cast_whole(B(y: 1), A(x: 1))} #{test_whole(B(y: 1), A(x: 1))}"
