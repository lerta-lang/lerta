struct A
  x: Int
struct B
  y: Int
type AB = A | B

const x_of = (v: AB) ->
  const a = v as A ? return -1
  a.x

const y_of = (v: AB) -> (v as B ? B(y: 0)).y

const either = (v: AB, flag: Bool) -> (v as A ? A(x: 0)).x > 0 or flag

print "#{x_of(A(x: 3))} #{x_of(B(y: 1))} #{y_of(A(x: 1))} #{y_of(B(y: 2))}"
print "#{either(A(x: 1), false)} #{either(B(y: 1), false)} #{either(B(y: 1), true)}"

struct Box<T>
  value: T
type Boxes = Box<Int> | Box<String>

const chained = (v: AB, w: AB) -> v as A ? w as A ? A(x: 0)
const nested = (v: AB, w: A?) -> v as A ? w ? A(x: 7)
const boxed = (b: Boxes) -> (b as Box<Int> ? Box(value: -1)).value

print "#{chained(B(y: 1), A(x: 4)).x} #{chained(B(y: 1), B(y: 1)).x}"
print "#{boxed(Box(value: 5))} #{boxed(Box(value: 'a'))}"
print "#{nested(B(y: 1), nil).x} #{nested(B(y: 1), A(x: 8)).x}"

# `?` binds tighter than `as` and `is`: the whole of `a ? b` is cast or tested.
const cast_whole = (a: AB?, b: AB) -> (a ? b as A?) != nil
const test_whole = (a: AB?, b: AB) -> a ? b is A
print "#{cast_whole(A(x: 1), B(y: 1))} #{cast_whole(B(y: 1), A(x: 1))} #{test_whole(B(y: 1), A(x: 1))}"
