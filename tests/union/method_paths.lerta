struct Failed(message: String)

class Fails
  run = (): String -> throw Failed(message: 'failed')

class Works
  run = -> 'ran'

const units: (Works | Fails)[] = [Works(), Fails()]
for unit in units
  try
    print unit.run()
  catch e: Failed
    print "caught #{e.message}"

const sizes: (Int | Int32)[] = [300, 7]
print size.to_byte()?.to_string() ? 'too big' for size in sizes

const texts: (String | Float)[] = ['a', 1.5]
var total = ''
total += text.to_string() for text in texts
print total
