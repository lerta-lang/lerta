struct Failed
  message: String

class Fails
  run = (): String -> throw Failed(message: 'failed')

class Works
  run = (): String -> 'ran'

const units: (Works | Fails)[] = [Works(), Fails()]
for unit in units
  try
    print unit.run()
  catch e: Failed
    print "caught #{e.message}"

const sizes: (Int | Int32)[] = [300, 7]
for size in sizes
  print size.to_byte()?.to_string() ? 'too big'

const texts: (String | Float)[] = ['a', 1.5]
var total = ''
for text in texts
  total += text.to_string()
print total
