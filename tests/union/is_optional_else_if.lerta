struct A
  x: Int

optional := (to: Int | String?) ->
  if to is Int
    print to
  else if to is String
    print to
  else
    print 'nil'

value_left := (to: String | Int?) ->
  if to is String
    print to
  else if to is Int
    print to
  else
    print 'nil'

struct_left := (to: Int | A?) ->
  if to is Int
    print to
  else if to is A
    print to.x
  else
    print 'nil'

not_optional := (to: String | Int) ->
  if to is String
    print to
  else if to is Int
    print to

tested_again := (to: Int | String?) ->
  print to is Int if to is not Int  # fmt: skip

optional 1
optional 'text'
optional nil
value_left 2
value_left nil
struct_left A(3)
struct_left nil
not_optional 4
tested_again 'text'

class C
  n: Int

class_left := (to: Int | C?) ->
  return print('int') if to is Int
  print to is C
  print (to as C?)?.n ? -1  # fmt: skip

cast_left := (to: Int | String?) ->
  return print('string') if to is String
  print (to as Int?) != nil  # fmt: skip
  print to as Int ? -1

class_left C(5)
class_left nil
cast_left 6
cast_left nil

other_left := (to: Int | String?) ->
  return print('int') if to is Int
  print (to as Int?) != nil  # fmt: skip
  print to as Int ? -1

other_left 'text'

thrown_left := (to: Int | String?) ->
  return if to is Int
  try
    print to as Int!
  catch e: CastError
    print e.message

thrown_left 'text'

type IS = Int | String

alias_left := (to: Int | String | Float?) ->
  return print('float') if to is Float
  return print('string') if to is String
  print to is IS
  print (to as IS?) != nil  # fmt: skip
  try
    print to as IS!
  catch CastError
    print 'failed'
  try
    print to as Int!
  catch CastError
    print 'failed'

record_left := (to: Int | { a: Int }?) ->
  return print('int') if to is Int
  print to is { a: Int }
  print (to as Int?) != nil  # fmt: skip

alias_left 7
alias_left nil
record_left { a: 1 }
record_left nil
