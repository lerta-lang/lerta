struct A
  x: Int
struct B
  y: Int
type AB = A | B

const of_case = (v: AB) ->
  return 0 if v is A
  case v
    when A then -1
    when B then v.y

const of_optional_case = (v: AB?) ->
  return 0 if v is A
  case v
    when B then v.y
    when nil then -2

const of_test = (v: AB?) ->
  return 0 if v is A
  return v.y if v is B
  -3

const still_optional = (v: AB?) ->
  case v
    when A then 'A'
    else v then 'B' else 'nil'

const assigned = (v: AB) ->
  const a = v as A?
  const wide: AB? = a
  wide != nil

const values: AB?[] = [A(x: 1), B(y: 2), nil]
for v in values
  print "#{of_optional_case(v)} #{of_test(v)} #{still_optional(v)}"
print "#{of_case(A(x: 1))} #{of_case(B(y: 5))}"
print "#{assigned(A(x: 1))} #{assigned(B(y: 1))}"
