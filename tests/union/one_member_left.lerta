struct A
  x: Int
struct B
  y: Int
type AB = A | B

of_case := (v: AB) ->
  return 0 if v is A
  case v
    when A then -1
    when B then v.y

of_optional_case := (v: AB?) ->
  return 0 if v is A
  case v
    when B then v.y
    when nil then -2

of_test := (v: AB?) ->
  return 0 if v is A
  return v.y if v is B
  -3

still_optional := (v: AB?) ->
  case v
    when A then 'A'
    else v then 'B' else 'nil'

assigned := (v: AB) ->
  a := v as A?
  wide: AB? = a
  wide != nil

values: AB?[] = [A(1), B(2), nil]
print "#{of_optional_case(v)} #{of_test(v)} #{still_optional(v)}" for v in values
print "#{of_case(A(x: 1))} #{of_case(B(y: 5))}"
print "#{assigned(A(x: 1))} #{assigned(B(y: 1))}"
