class A
  args
    x: Int
class B
  args
    y: Int
class C
  args
    z: Int

type AB = A | B
type ABC = AB | C

name := (v: ABC) ->
  case v
    when AB then "ab #{v is A}"
    when C then 'c'

print name(A(1))
print name(B(1))
print name(C(1))
v: ABC = B(2)
print v is AB
ab := v as AB ? throw ValueError('no')
print ab is B
c: ABC = C(3)
print (c as AB?) == nil
