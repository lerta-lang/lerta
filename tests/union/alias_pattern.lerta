class A
  x: Int
class B
  y: Int
class C
  z: Int

type AB = A | B
type ABC = AB | C

const name = (v: ABC) ->
  case v
    when AB then "ab #{v is A}"
    when C then 'c'

print name(A(x: 1))
print name(B(y: 1))
print name(C(z: 1))
const v: ABC = B(y: 2)
print v is AB
const ab = v as AB? ? throw ValueError(message: 'no')
print ab is B
const c: ABC = C(z: 3)
print (c as AB?) == nil
