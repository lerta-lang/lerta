# Arrays, maps, tuples and anonymous structs are members of unions, held as they are: a test tells
# them apart, also when another module made them.
import pair, point from './lib/objects'

describe := (value: Int[] | Map<String, Int> | (Int, String) | { x: Int } | String) ->
  return "array of #{value.length}" if value is Int[]
  return "map of #{value.length}" if value is Map<String, Int>
  if value is (Int, String)
    (number, _) := value
    return "tuple #{number}"
  return "record #{value.x}" if value is { x: Int }
  "string #{value}"

print describe([1, 2, 3])
print describe({ 'a': 1 })
print describe((4, 'four'))
print describe({ x: 5 })
print describe('six')
print pair() is (Int, String)
print point() is { x: Int }
