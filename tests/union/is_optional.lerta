struct A
  x: Int
class B
  y: Int
type AB = A | B

describe := (v: AB?) ->
  print v is A
  print v is B
  if v is A
    print "A #{v.x}"
  else
    print 'not A'
  print v is B then "B #{v.y}" else 'not B'
  print case
    when v is A then "case A #{v.x}"
    when v is B then "case B #{v.y}"
    else 'case nil'
  print v is A and v.x > 1
  print not (v is B) or v.y > 1  # fmt: skip

guard := (v: AB?) ->
  return 'guarded' if not (v is B)  # fmt: skip
  "guard B #{v.y}"

values: AB?[] = [A(x: 2), B(y: 1), nil]
for v in values
  describe v
  print guard(v)

var changing: AB?
print changing is A
changing = A(x: 1)
print changing is A
changing = B(y: 1)
print changing is A
