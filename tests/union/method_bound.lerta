interface Shape
  area: () -> Int
  corner: () -> Point

struct Point
  x: Int
  y: Int

class Square
  side: Int
  area := -> @side * @side
  corner := -> Point(x: @side, y: @side)

class Rectangle
  width: Int
  height: Int
  area := -> @width * @height
  corner := -> Point(x: @width, y: @height)

class Triangle
  base: Int
  area := -> @base * 2
  corner := -> Point(x: @base, y: 0)

describe := <T: Shape>(shape: T) ->
  corner := shape.corner()
  "#{shape.area()} at (#{corner.x}, #{corner.y})"

shapes: (Square | Rectangle | Triangle)[] = [Square(2), Rectangle(width: 2, height: 3), Triangle(5)]
print describe(shape) for shape in shapes
