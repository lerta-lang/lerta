const kind = (c: Byte): String ->
  case c
    when '+', '-' then 'additive'
    when '*', '/' then 'multiplicative'
    else 'other'
const ops = '+*x'.binary
print kind(ops[i]) for i in 0...ops.length
const word = (n: Int) ->
  case n
    when 1 then 'one'
    when 2, 3 then 'few'
    else 'many'
print word(1)
print word(3)
print word(9)
const greet = (s: String) ->
  case s
    when 'hi' then 'hello'
    else s.to_string()
print greet('hi')
print greet('yo')
