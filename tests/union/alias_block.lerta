import Circle, Shape, Square, Triangle from './lib/shapes'

type Only =  # fmt: skip
  Square

describe := (shape: Shape) ->
  case shape
    when Circle then "circle #{shape.r}"
    when Square then "square #{shape.side}"
    when Triangle then "triangle #{shape.base}"

print describe(Circle(r: 1))
print describe(Square(side: 2))
print describe(Triangle(base: 3))
only: Only = Square(side: 4)  # fmt: skip
print only.side
