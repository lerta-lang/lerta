# Unions flatten and are released correctly when held in fields and arrays.
struct Leaf(name: String)
struct Pair(first: Tree, second: Tree)
type Tree = Leaf | Pair
type Node = Tree

const count = (t: Node): Int ->
  case t
    when Leaf then 1
    when Pair then count(t.first) + count(t.second)
const tree: Tree = Pair
  first: Leaf(name: 'a'.to_string())
  second: Pair(first: Leaf(name: 'b'), second: Leaf(name: 'c'))
print count(tree)
var guard: Tree = Leaf(name: 'x')
guard = tree
print guard is Pair
