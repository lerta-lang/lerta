# Unions flatten and are released correctly when held in fields and arrays.
struct Leaf
  name: String
struct Pair
  first: Tree
  second: Tree
type Tree = Leaf | Pair
type Node = Tree

count := (t: Node): Int ->
  case t
    when Leaf then 1
    when Pair then count(t.first) + count(t.second)
tree: Tree = Pair(first: Leaf('a'.to_string()), second: Pair(first: Leaf('b'), second: Leaf('c')))
print count(tree)
var guard: Tree = Leaf('x')
guard = tree
print guard is Pair
