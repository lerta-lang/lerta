struct P(x: Int)
struct Q(x: Int)
type PQ = P | Q

const name = (v: PQ) ->
  return 'Q' if not (v is P)  # fmt: skip
  "P #{v.x}"
const maybe = (v: PQ?) ->
  return 0 if not v
  case v
    when P then v.x
    when Q then -v.x
const make = (n: Int): PQ ->
  return P(x: n) if n > 0
  Q x: n
const word = (s: String) ->
  case s
    when 'one', 'uno' then 1
    when 'two' then 2
    else 0

print name(P(x: 1))
print name(Q(x: 1))
print maybe(P(x: 5))
print maybe(Q(x: 5))
print maybe(nil)
print case make(-3)
  when P then 'p'
  when Q then 'q'
print word('uno')
print word('two')
print word('x')
var u: PQ = P(x: 1)
if u is P
  u = Q(x: 2)
  print u is Q
