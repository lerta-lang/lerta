struct P
  x: Int
struct Q
  x: Int
type PQ = P | Q

name := (v: PQ) ->
  return 'Q' if not (v is P)  # fmt: skip
  "P #{v.x}"
maybe := (v: PQ?) ->
  return 0 unless v
  case v
    when P then v.x
    when Q then -v.x
make := (n: Int): PQ ->
  return P(n) if n > 0
  Q n
word := (s: String) ->
  case s
    when 'one', 'uno' then 1
    when 'two' then 2
    else 0

print name(P(1))
print name(Q(1))
print maybe(P(5))
print maybe(Q(5))
print maybe(nil)
print case make(-3)
  when P then 'p'
  when Q then 'q'
print word('uno')
print word('two')
print word('x')
var u: PQ = P(1)
if u is P
  u = Q(2)
  print u is Q
