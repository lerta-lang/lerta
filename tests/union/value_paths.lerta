# A case over an optional union with a nil arm; a narrowed boxed value that a function literal
# captures; a literal default of a union parameter; unions as map values and tuple items; a T?
# where an optional union is expected; a cast to an alias of fewer members; and a Bool member used
# as a condition where it is narrowed.
type Small = Int | String

describe := (value: Int | String?) ->
  case value
    when nil then 'nothing'
    when Int then "int #{value}"
    when String then "string #{value}"

print describe(nil)
print describe(2)
print describe('b')

shout := (value: Int | String) ->
  return 'not a string' if value is not String
  loud := -> value + '!'
  loud()
print shout('hey')
print shout(1)

padded := (value: Int | String = 3) -> value is Int then value + 1 else 0
print padded()

settings: Map<String, Int | String>
settings['name'] = 'lerta'
settings['size'] = 2
print settings['name'] == 'lerta'
pair: (Int | String, Int) = ('first', 1)
(head, count) := pair
print head == 'first' and count == 1

known: Int? = 4
given: Int | String? = known
print given == 4
unknown: Int? = nil
none: Int | String? = unknown
print none == nil

wide: Int | String | Bool = 'w'
print (wide as Small ? 0) == 'w'

flag: Int | Bool = true
print flag is Bool and flag
