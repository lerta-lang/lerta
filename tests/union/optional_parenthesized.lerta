# A union in parentheses with `?` after it may be nil too, as `Int | String?` may, whatever its
# last member is.
describe := (x: (Int | String)?) ->
  case x
    when Int then "int #{x}"
    when String then "string #{x}"
    else 'nil'

print describe(1)
print describe('a')
print describe(nil)
xs: (Int | String)?[] = [1, nil]
print xs.length
ys: (Int | String[])? = nil
print ys == nil
first := (items: String[]): (Int | String)? -> items.first()
print first([]) == nil
print describe(first(['b']))
