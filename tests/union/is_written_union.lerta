class A
  n: Int

class B
  n: Int

class C
  m: Int

describe := (v: A | B | C) ->
  if v is A | B
    print v.n
  else
    print v.m

ab := (v: (A | B | C)?) -> v is A | B

c_only := (v: A | B | C) ->
  return print('a or b') if v is A | B
  print v.m

twice := (v: A | B | C) -> v is A | A | B

describe A(1)
describe B(2)
describe C(3)
print ab(B(4))
print ab(C(5))
print ab(nil)
c_only C(7)
c_only A(8)
print twice(B(9))
c: A | B | C = C(6)
print c is not A | B
print c is A | B and true
