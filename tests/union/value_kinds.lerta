# The sized numbers, Float32, Byte and enums in unions, their literals, equality and hashes; a cast
# that throws releases the box; members that are optional make one optional union; fields and
# temporaries are taken out of their boxes; a narrowing to fewer members keeps the box; and a box of
# another module is told as one of this one.
import describe, make from './lib/boxed'

enum Color
  RED
  GREEN

const small: Int8 | String = 3
print (small as Int8 ? 0) + 1
const single: Float32 | Bool = 1.5
print single as Float32 ? 0.0
const whole: Float32 | String = 3
print whole as Float32 ? 0.0
const byte: Byte | String = 'a'.binary[0]
print byte is Byte

const colors = Set<Color | Int>([Color.RED, 1, Color.RED, Color.GREEN])
print colors.length
const one: Color | Int = Color.GREEN
const other: Color | Int = Color.GREEN
print one == other

const text: Int | String = 'x'
try
  print text as Int!
catch e: CastError
  print 'not an Int'

const either: Int? | String? = nil
print either == nil

struct Labeled(label: Int | String)

const labeled = Labeled(label: 'tag')
print labeled.label + '!' if labeled.label is String

const many: Int | String | Bool = 4
print many is Int if many is not Bool
const maybe: Int | String? = 7
print (maybe ? 0) + 1 if maybe is not String

print make(2) as String!
print make(-1) as String ? '-'
print describe(make(3))
print describe(make(0))
