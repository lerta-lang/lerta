const tags =
  'k':
    1
    2
  'm':
    3
print tags['k']![1]
const o =
  names:
    'a': 'x'
print o.names['a']!

class Holder
  var at = { x: 0 }
const h = Holder()
h.at =
  x: 4
print h.at.x
var m =
  'a':
    x: 0
m['a'] =
  x: 5
print m['a']!.x
var r =
  x: 1
r =
  x: 2
print r.x

const add = (n: Int, o: { a: Int, b: Int }): Int -> n + o.a + o.b
const total = (n: Int, o: { a: Int, b: Int }) -> print add(n, o)
total(1)
  a: 2
  b: 3
