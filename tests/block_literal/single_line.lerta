# fmt: off
name := 'lerta'
message :=
  "hello, #{name}"
print message
size :=
  if name.binary.length > 3
    'long'
  else
    'short'
print size
kind :=
  case
    when name == 'lerta' then 'language'
    else 'other'
print kind
double :=
  (x: Int) ->
    x * 2
print double(4)
pick := (big: Bool) ->
  return
    if big
      'big'
    else
      'small'
print pick(true)
config :=
  title:
    "#{name}!"
print config.title
one: Int[] =
  [1]
print one.length
pair := (): Int[] ->
  return
    1
    2
print pair().length
mixed :=
  'a'
  if one.length > 0
    'b'
  else
    'c'
  'd', 'e'
print mixed.length
grid :=
  1, 2, 3
  4
print grid.length
point :=
  x: 1, y: 2
print point.y
show_point := (p: { x: Int, y: Int }) -> print p.x + p.y
show_point
  x: 1, y: 2
steps :=
  (x: Int) -> x + 1, (x: Int) -> x * 2
print steps.length
