const name = 'lerta'
const message =
  "hello, #{name}"
print message
const size =
  if name.binary.length > 3
    'long'
  else
    'short'
print size
const kind =
  case
    when name == 'lerta' then 'language'
    else 'other'
print kind
const double =
  (x: Int) ->
    x * 2
print double(4)
const pick = (big: Bool) ->
  return
    if big
      'big'
    else
      'small'
print pick(true)
const config =
  title:
    "#{name}!"
print config.title
const one: Int[] =
  [1]
print one.length
const pair = (): Int[] ->
  return
    1
    2
print pair().length
const mixed =
  'a'
  if one.length > 0
    'b'
  else
    'c'
  'd', 'e'
print mixed.length
const grid =
  1, 2, 3
  4
print grid.length
const point =
  x: 1, y: 2
print point.y
const show_point = (p: { x: Int, y: Int }) -> print p.x + p.y
show_point
  x: 1, y: 2
const steps =
  (x: Int) -> x + 1, (x: Int) -> x * 2
print steps.length
