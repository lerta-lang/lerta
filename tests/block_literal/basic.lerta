# fmt: off
const config =
  name: 'lerta'
  targets:
    'linux'
    'macos'
  limits:
    depth: 64
    width: 100
print config.name
print target for target in config.targets
print config.limits.depth + config.limits.width

var counts =
  'a': 1
  'b': 2
print counts['b']!
counts =
  'c': 3
print counts['c']!

const draw = (label: String, at: { x: Int, y: Int }) ->
  print "#{label} #{at.x},#{at.y}"
draw 'p'
  x: 1
  y: 2
const report = (o: { a: Int, b: Int }) -> print o.a + o.b
report
  a: 10
  b: 20

class Box
  items =
    1
    2
    3
print Box().items.length
