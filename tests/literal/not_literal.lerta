# An optional is not Stringable, which the message tells what to write instead where what it holds
# is; nor is a class, or a struct with a part that is not Literal. An optional's to_literal is not
# called as written.
class Counter
  count := 0

struct Callback
  run: (Int) -> Int

struct Shown
  to_string: () -> String

maybe: Int? = 3
print maybe
print "#{maybe}"
counter: Counter? = nil
print counter
print Counter()
print Callback(run: (x) -> x)
print [Counter()]
print [Shown(to_string: -> 'shown')]
text := maybe.to_literal()
