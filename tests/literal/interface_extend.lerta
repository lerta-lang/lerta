# A call of to_literal or to_string on a struct calls the method that an extend of an interface it
# satisfies gives it, rather than the one by its fields, which the struct then does not get.
interface Named
  name: String

extend Named
  to_literal := (): String -> "named(#{@name.to_literal()})"

interface Labeled
  label: String

extend Labeled
  to_string := (): String -> "label #{@label}"

struct Person
  name: String

struct Tag
  label: String

print Person('a').to_literal()
print Tag('b').to_string()
print Tag('c').to_literal()
