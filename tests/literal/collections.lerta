# Tuples, anonymous structs, maps and sets of Literal parts have a to_literal, and a to_string
# giving the same, as a program writes them; an empty map is `{}`, as a map literal cannot write
# one. An optional is Literal, as `nil` or what it holds, but not Stringable.
struct Point
  x: Int

print (1, 'a')

# An anonymous struct's fields go in the order of their names, which its type has.
print { x: 1, name: 'b' }
print {}
print { 'a': 1, 'b': 2 }
empty: Map<String, Int>
print empty
print Set([1, 2])
none: Set<Int>
print none
print { 'points': [Point(1)] }
print { pair: (Point(2), 'c') }
optionals: Int?[] = [1, nil]
print optionals
maybe: Int? = nil
print [(1, maybe)].to_literal()
