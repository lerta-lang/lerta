# A struct whose fields are all Literal has a to_literal, and a to_string giving the same, of its
# name and every field, computed ones too, in order.
struct Point
  x: Int
  y: Int
  sum := @x + @y

struct Box<T>
  item: T

struct Node
  name: String
  children: Node[]

struct Link
  value: Int
  next: Link?

struct Either
  value: Int | String

struct Unit
  count := 0

point := Point(x: 1, y: 2)
print point
print "at #{point}"
print [point, Point(x: 3, y: 4)]
print point.to_literal()
# A generic struct's literal does not write its type arguments.
print Box(item: 'a')
print Box(item: Box(item: [1.5]))
# A struct that holds itself, through an array or an optional.
print Node(name: 'root', children: [{ name: 'leaf', children: [] }])
print Link(value: 1, next: { value: 2, next: nil })
print [Either(value: 1), Either(value: 'one')]
print Unit()
# Through a bound or an interface value, in generic functions of different bounds.
literal := <T: Literal>(x: T) -> x.to_literal()
text := <T: Stringable>(x: T) -> "#{x}"
boxed := <T: Literal>(x: T) -> text(Box(item: x))
print literal(Box(item: 2))
print text(Box(item: 3))
print boxed(4)
texts: Stringable[] = [point, Box(item: 'b')]
print each for each in texts
literals: Literal[] = [Unit()]
print each.to_literal() for each in literals
