var name: String?
print name == nil
name = 'lerta'
print name != nil
print name!
print name else 'none'
missing: String? = nil
print missing else 'none'
var count: Int? = 3
print count! + 1
count = nil
print count else -1
print count == nil
flag: Bool? = false
print 'flag false' if flag == false
words: String?[] = ['a', nil]
print words[1] == nil
pick := (b: Bool) ->
  return nil if b
  7
print pick(false) else 0
print pick(true) else 0
greet := (who: String?) -> "hi #{who else 'you'}"
print greet(nil)
print greet('bob')
