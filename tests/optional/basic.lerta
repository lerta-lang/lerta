var name: String?
print name == nil
name = 'lerta'
print name != nil
print name!
print name ? 'none'
missing: String? = nil
print missing ? 'none'
var count: Int? = 3
print count! + 1
count = nil
print count ? -1
print count == nil
flag: Bool? = false
print 'flag false' if not flag
words: String?[] = ['a', nil]
print words[1] == nil
pick := (b: Bool) ->
  return nil if b
  7
print pick(false) ? 0
print pick(true) ? 0
greet := (who: String?) -> "hi #{who ? 'you'}"
print greet(nil)
print greet('bob')
