# A function literal in a loop may assign a var narrowed in an earlier loop that does not enclose
# it, and a var narrowed by a guard may be read in the value assigned to it.
f := (start: Int?) ->
  var x = start
  for _ in 0...1
    print x + 1 if x
  for _ in 0...1
    reset := -> x = nil
    reset()
  print x ? 0
  var y = start
  return if y == nil
  y = y + 1
  print y ? 0

f 1
