enum Kind
  A
  B

const show = (n: Int?, s: String?, k: Kind?) ->
  print n + 1 if n == 1
  print s + '!' if 'x' == s
  if n != 2
    print 'not 2'
  else
    print n * 10
  print k.to_string() if k == A and n == 1
  print "no k #{k.to_string()} #{n + 1}" if not (k != B or n == nil)
  return if s != 'y'
  print s + '?'

show 1, 'x', A
show 2, 'y', nil
show nil, nil, B
show 3, nil, B
