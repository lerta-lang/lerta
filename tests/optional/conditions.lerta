flag: Bool? = true
print 'flag true' if flag
no: Bool? = nil
print 'never' if no
print flag and true
items: String?[] = ['a', nil, 'c', nil]
for item in items
  continue if item == nil
  print item + '!'
for item in items
  break if not item
  print item
find := (xs: String?[]) ->
  for x in xs
    if s := x
      return s if s == 'c'
  'none'
print find(items)
var k = 0
while _s := items[k]
  k += 1
  break if k > 5
print k
