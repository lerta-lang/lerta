const flag: Bool? = true
print 'flag true' if flag
const no: Bool? = nil
print 'never' if no
print flag and true
const items: String?[] = ['a', nil, 'c', nil]
for item in items
  continue if item == nil
  print item + '!'
for item in items
  break if not item
  print item
const find = (xs: String?[]): String ->
  for x in xs
    if const s = x
      return s if s == 'c'
  'none'
print find(items)
var k = 0
while const _s = items[k]
  k += 1
  break if k > 5
print k
