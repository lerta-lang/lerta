# A literal where a `T?` is expected is a T, as where a T is: an integer one is a Float where a
# `Float?` is expected, and a Byte where a `Byte?` is, as is a string literal of one byte.
e: Float? = 1
print e ? 0.5

zero: Float? = -0
print zero ? 1.0

sum: Float? = 1 + 2
print sum ? 0.0

scale := (s: Float? = 2) -> s ? 0.0
print scale()
print scale(3)

pick := (): Float? -> -1
print pick() ? 0.0

x: Float? = 2.0
print x == 2

var y: Float?
y = 3
print y ? 0.0

chosen: Float? = e != nil then 1 else 2
print chosen ? 0.0

b: Byte? = b'a'
print b ? 0

c: Byte? = 200 + 55
print c ? 0

# The fallback of `?` is a Float where a `Float?` is expected, and a literal where an `Int?` is
# expected stays an Int.
z: Float? = nil
fallback: Float? = z ? 1
print fallback ? 0.0

n: Int? = 4
print n ? 0
