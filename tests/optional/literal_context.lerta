# A literal where a `T?` is expected is a T, as where a T is: an integer one is a Float where a
# `Float?` is expected, and a Byte where a `Byte?` is, as is a string literal of one byte.
e: Float? = 1
print e else 0.5

zero: Float? = -0
print zero else 1.0

sum: Float? = 1 + 2
print sum else 0.0

scale := (s: Float? = 2) -> s else 0.0
print scale()
print scale(3)

pick := (): Float? -> -1
print pick() else 0.0

x: Float? = 2.0
print x == 2

var y: Float?
y = 3
print y else 0.0

chosen: Float? = e != nil then 1 else 2
print chosen else 0.0

b: Byte? = b'a'
print b else 0

c: Byte? = 200 + 55
print c else 0

# The fallback of `?` is a Float where a `Float?` is expected, and a literal where an `Int?` is
# expected stays an Int.
z: Float? = nil
fallback: Float? = z else 1
print fallback else 0.0

n: Int? = 4
print n else 0
