# A var of a function is narrowed as a const is, until it is assigned, which may assign nil where it
# is narrowed; a loop narrows it by its own tests.
const describe = (start: Int?) ->
  var x = start
  if x
    print x + 1
  else
    print 'none'
  x = 3
  print x ? 0
  var name: String? = 'a'
  return if name == nil
  print name.binary.length
  name = nil
  print name ? 'gone'
  var steps: Int?
  for i in 0...2
    steps = i
    print steps * 10 if steps

describe 1
describe nil
