ages := { 'a': 20 }
flags := { 'on': true }

print ages['a'] else 0 > 18
print ages['b'] else 0 > 18
print flags['off'] else false or true
print not flags['off'] else false
print ages['b'] else ages['c'] else 5
label := ages['b'] else 0 == 0 then 'zero' else 'other'  # fmt: skip
print label
kind := case  # fmt: skip
  when ages['b'] else 0 > 1 then 'adult'
  else 'unknown'
print kind
