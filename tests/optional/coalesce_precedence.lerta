ages := { 'a': 20 }
flags := { 'on': true }

print ages['a'] ? 0 > 18
print ages['b'] ? 0 > 18
print flags['off'] ? false or true
print not flags['off'] ? false
print ages['b'] ? ages['c'] ? 5
label := ages['b'] ? 0 == 0 then 'zero' else 'other'  # fmt: skip
print label
kind := case  # fmt: skip
  when ages['b'] ? 0 > 1 then 'adult'
  else 'unknown'
print kind
