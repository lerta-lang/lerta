# `else` gives the fallback of a nil, binding as `?` does: tighter than comparisons, as a guard, and
# after a cast; after the value of a `then`, it is that `then`'s, so the value holds a fallback only
# in parentheses, and the value of an `else` takes one.
ages := { 'a': 20 }
print [ages['a'] else 0 > 18, ages['b'] else 0 > 18]
first := (xs: Int[]) ->
  x := xs.first() else return -1
  x * 10
print [first([3]), first([])]
v: Int? = nil
c := true
print (c then v else 5) == nil
print [c then (v else 7) else 9, not c then 1 else v else 8]
shape: Int | String = 'x'
print shape as Int else 4
print v else ages['b'] else 3
n := 1
picked :=
  case n
    when 1 then v else 3
    else 0
print picked
print [c then [v else 1] else [0], [c then -(v else 2) else 0]]
print c then (shape as Int else 6) else 7  # fmt: skip
blocky := c then (a: Int?) ->
  y := a else 5
  y + 1
else (a: Int?) -> 0
print blocky(nil)
print c then "#{v else 3}" else 'n'
print c then not c then 1 else 2 else v else 4  # fmt: skip
