# A top-level var that no function, method or other module assigns is narrowed in the top-level
# code, as a local is.
var count: Int? = 1
print count + 1 if count != nil
count = nil
print count == nil
var name: String? = 'a'
if name
  print name + 'b'
  name = nil
  print name == nil
var left: Int? = 2
for i in 0..2
  print left + i if left != nil
while left != nil
  print left
  left = left > 0 then left - 1
