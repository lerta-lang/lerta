struct A
  a: Int

struct B
  b: String

type AB = A | B

const describe = (name: String?, item: AB?) ->
  if name != nil and name.binary.length > 3
    print "long name #{name}"
  if name == nil or name.binary.length == 0
    print 'no name'
  else
    print "name #{name}"
  if item != nil and item is A and item.a > 0
    print "positive #{item.a}"
  if not (item == nil or not (item is B))
    print "b #{item.b}"
  print case
    when name and item then "both #{name}"
    else 'not both'
  print name != nil and item != nil then "#{name.binary.length}" else '-'
  return if name == nil or item == nil
  print "after guard #{name} #{item is A}"

describe 'abcd', A(a: 1)
describe nil, B(b: 'x')
describe '', nil

const names: Array<String?> = ['x', nil, 'yy']
print name.binary.length for name in names when name != nil and name.binary.length > 1
const lengths = (name.binary.length for name in names when name != nil and name.binary.length > 0)
print length for length in lengths

const negated = (x: Int?, y: Int?) ->
  print not (x != nil and y != nil) then 'missing' else "#{x + y}"
  if not (x == nil or y == nil)
    print x * y
  else
    print 'missing'
negated 2, 3
negated nil, 3
