struct A
  a: Int

struct B
  b: String

type AB = A | B

describe := (name: String?, item: AB?) ->
  print "long name #{name}" if name != nil and name.binary.length > 3
  if name == nil or name.binary.is_empty()
    print 'no name'
  else
    print "name #{name}"
  print "positive #{item.a}" if item != nil and item is A and item.a > 0
  print "b #{item.b}" if not (item == nil or not (item is B))  # fmt: skip
  print case
    when name and item then "both #{name}"
    else 'not both'
  print name != nil and item != nil then "#{name.binary.length}" else '-'  # fmt: skip
  return if name == nil or item == nil
  print "after guard #{name} #{item is A}"

describe 'abcd', A(1)
describe nil, B('x')
describe '', nil

names: String?[] = ['x', nil, 'yy']
print name.binary.length for name in names when name != nil and name.binary.length > 1  # fmt: skip
lengths := (
  for name in names when name != nil and not name.binary.is_empty()
    name.binary.length
)
print length for length in lengths

negated := (x: Int?, y: Int?) ->
  print not (x != nil and y != nil) then 'missing' else "#{x + y}"  # fmt: skip
  if x != nil and y != nil
    print x * y
  else
    print 'missing'
negated 2, 3
negated nil, 3
