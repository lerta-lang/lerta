const show = (n: Int?) ->
  if n
    print n + 1
  else
    print 'no number'
show(1)
show(nil)
const describe = (s: String?): String ->
  return 'nothing' if s == nil
  s + '!'
print describe(nil)
print describe('yes')
const length_of = (s: String?): Int ->
  if not s
    return 0
  s.binary.length
print length_of('abc')
print length_of(nil)
for text in ['x', 'yy']
  const maybe: String? = text
  if maybe != nil
    print maybe + maybe
