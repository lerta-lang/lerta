show := (n: Int?) ->
  if n
    print n + 1
  else
    print 'no number'
show 1
show nil
describe := (s: String?) ->
  return 'nothing' if s == nil
  s + '!'
print describe(nil)
print describe('yes')
length_of := (s: String?) ->
  return 0 if not s
  s.binary.length
print length_of('abc')
print length_of(nil)
for text in ['x', 'yy']
  maybe: String? = text
  print maybe + maybe if maybe != nil
