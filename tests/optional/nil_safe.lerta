class Node
  args
    name: String
    next: Node?
  size := -> @name.binary.length

show := (node: Node?) ->
  print node?.name else '-'
  print node?.next?.name else '-'
  print node?.size() else -1
  print node?.name.binary.length else -1

show Node(name: 'a', next: Node(name: 'bb', next: nil))
show nil
m := { 'k': 'value' }
print m['k']?.binary.length else 0
print m['x']?.binary.length else 0

class Counter
  var count = 0
  ok := true
  bump := -> @count += 1

counter: Counter? = Counter()
counter?.bump()
absent: Counter? = nil
absent?.bump()
xs: Int[]? = [1, 2]
xs?.pop()
print counter?.count else -1
print xs?.length else -1
print 'ok' if counter?.ok == true
read := -> counter?.count
print read() else -1
