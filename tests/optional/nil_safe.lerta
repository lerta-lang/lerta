class Node
  name: String
  next: Node?
  size = -> @name.binary.length

show := (node: Node?) ->
  print node?.name ? '-'
  print node?.next?.name ? '-'
  print node?.size() ? -1
  print node?.name.binary.length ? -1

show Node(name: 'a', next: Node(name: 'bb', next: nil))
show nil
m := { 'k': 'value' }
print m['k']?.binary.length ? 0
print m['x']?.binary.length ? 0

class Counter
  var count = 0
  ok = true
  bump = -> @count += 1

counter: Counter? = Counter()
counter?.bump()
absent: Counter? = nil
absent?.bump()
xs: Int[]? = [1, 2]
xs?.pop()
print counter?.count ? -1
print xs?.length ? -1
print 'ok' if counter?.ok == true
read := -> counter?.count
print read() ? -1
