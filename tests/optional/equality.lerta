enum Color
  RED
  GREEN

const compare_ints = (a: Int?, b: Int?) ->
  print "#{a ? -1} #{b ? -1} #{a == b} #{a != b}"
const name = (c: Color?) -> c then c.to_string() else '-'
const compare_colors = (a: Color?, b: Color?) ->
  print "#{name(a)} #{name(b)} #{a == b} #{a != b}"

compare_ints nil, nil
compare_ints nil, 1
compare_ints 1, nil
compare_ints 1, 1
compare_ints 1, 2
const strings: String?[] = [nil, 'a', 'b']
for a in strings
  print "#{a ? '-'} #{b ? '-'} #{a == b} #{a != b}" for b in strings
compare_colors nil, nil
compare_colors nil, RED
compare_colors RED, nil
compare_colors RED, RED
compare_colors RED, GREEN

# A T against a T?, on either side.
const one: Int? = 1
const absent: String? = nil
print "#{one == 1} #{1 == one} #{one != 2} #{absent == 'a'} #{'a' != absent}"
const text = 'a'
print "#{absent == text} #{text == absent} #{strings[1] == "#{text}"}"
const x: Byte = 'x'
const byte: Byte? = x
print "#{byte == 'x'} #{'y' == byte}"
const flag: Bool? = false
print "#{flag == false} #{flag == true} #{flag == nil}"
