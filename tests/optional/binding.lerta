const numbers = ['1', 'two', '30']
var sum = 0
for text in numbers
  if const n = text.parse_int()
    sum += n
print sum
const stack = ['a', 'b', 'c']
const pop_or_nil = (xs: String[]): String? ->
  return nil if xs.length == 0
  xs.pop()
while const top = pop_or_nil(stack)
  print top
print '-5'.parse_int()!
print '9223372036854775807'.parse_int()!
print '-9223372036854775808'.parse_int()!
print '9223372036854775808'.parse_int() == nil
print ''.parse_int() == nil
print '-'.parse_int() == nil
print '1a'.parse_int() == nil
print 'é'.binary.text()!
print 'é'.binary.text(0, 1) == nil
