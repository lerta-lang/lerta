# A `var` declared in the function, or in the top-level code that awaits, stays narrowed after an
# `await`: nothing else may assign it meanwhile. A test after the `await` narrows an outer one.
import sleep from 'std:time'
var top: Int? = 1
if top != nil
  await sleep(0.01)
  print top + 1
fixed: Int? = 4
f := ->
  # Nothing may assign a const.
  if fixed != nil
    await sleep(0.01)
    print fixed + 1
  var own: Int? = 2
  if own != nil
    await sleep(0.01)
    print own + 1
  await sleep(0.01)
  if top != nil
    # The literal's own `await` is not one of f's.
    k := -> await sleep(0.01)
    print top + 2
    await k()
await f()
