ages := { 'ann': 31 }

age_of := (name: String) ->
  age := ages[name] ? return -1
  age + 1

first_negative := (xs: Int[]) ->
  for x in xs
    found := x < 0 then x else continue
    return found
  nil

count_until_stop := (words: String[]) ->
  var n = 0
  for word in words
    case word
      when 'stop' then break
      else n += 1
  n

label := (k: Int) ->
  case 'k' + k.to_string()
    when 'k1' then return 'one'
    when 'k2'  # fmt: skip
      return 'two'
    else 'many'

# fmt: skip
sign := (n: Int): String ->
  n < 0 then return 'negative' else 'not negative'

print age_of('ann')
print age_of('bob')
print first_negative([3, -2, -5]) ? 0
print first_negative([1]) ? 0
print count_until_stop(['a', 'b', 'stop', 'c'])
print label(1)
print label(2)
print label(3)
print sign(-1)
print sign(1)

class Reader
  args
    source: String?
  var length = 0
  init := ->
    text := @source ? return
    @length = text.binary.length
  first := -> @source ? return '-'

skip_words := (words: String[]) ->
  var kept = 0
  for word in words
    case 'word ' + word
      when 'word skip' then continue
      else kept += 1
  kept

guarded := (x: Int?) ->
  x ? return -1
  x!

# fmt: skip
nested := (a: Int, b: Int): String ->
  a > 0 then (b > 0 then return 'both' else 'a') else 'neither'

loop_in_arm := (k: Int) ->
  case k
    when 1
      var total = 0
      for i in 0..5
        total += i
        break if i == 2
      total
    else 0

reassigned := (xs: Int[]) ->
  var last = 0
  for x in xs
    last = x > 0 then x else continue
  last

print_present := (x: Int?) ->
  value := x ? return
  print value

plus_one := (n: Int) -> return n + 1

print Reader(source: 'abc').length
print Reader(source: nil).length
print Reader(source: nil).first()
print skip_words(['a', 'skip', 'b'])
print guarded(nil)
print guarded(4)
print nested(1, 1)
print nested(1, 0)
print loop_in_arm(1)
print reassigned([1, -2, 3, -4])
print_present nil
print_present 7
print plus_one(1)
