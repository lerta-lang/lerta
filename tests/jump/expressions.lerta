const ages = { 'ann': 31 }

const age_of = (name: String): Int ->
  const age = ages[name] ? return -1
  age + 1

const first_negative = (xs: Array<Int>): Int? ->
  for x in xs
    const found = x < 0 then x else continue
    return found
  nil

const count_until_stop = (words: Array<String>): Int ->
  var n = 0
  for word in words
    case word
      when 'stop' then break
      else
        n += 1
  n

const label = (k: Int): String ->
  case 'k' + k.to_string()
    when 'k1' then return 'one'
    when 'k2'
      return 'two'
    else 'many'

const sign = (n: Int): String ->
  n < 0 then return 'negative' else 'not negative'

print age_of('ann')
print age_of('bob')
print first_negative([3, -2, -5]) ? 0
print first_negative([1]) ? 0
print count_until_stop(['a', 'b', 'stop', 'c'])
print label(1)
print label(2)
print label(3)
print sign(-1)
print sign(1)

class Reader
  source: String?
  length = 0
  init = ->
    const text = @source ? return
    @length = text.binary.length
  first = (): String -> @source ? return '-'

const skip_words = (words: Array<String>): Int ->
  var kept = 0
  for word in words
    case 'word ' + word
      when 'word skip' then continue
      else
        kept += 1
  kept

const guarded = (x: Int?): Int ->
  x ? return -1
  x!

const nested = (a: Int, b: Int): String ->
  a > 0 then (b > 0 then return 'both' else 'a') else 'neither'

const loop_in_arm = (k: Int): Int ->
  case k
    when 1
      var total = 0
      for i in 0...5
        total += i
        break if i == 2
      total
    else 0

const reassigned = (xs: Array<Int>): Int ->
  var last = 0
  for x in xs
    last = x > 0 then x else continue
  last

const print_present = (x: Int?) ->
  const value = x ? return
  print value

const plus_one = (n: Int): Int -> return n + 1

print Reader(source: 'abc').length
print Reader(source: nil).length
print Reader(source: nil).first()
print skip_words(['a', 'skip', 'b'])
print guarded(nil)
print guarded(4)
print nested(1, 1)
print nested(1, 0)
print loop_in_arm(1)
print reassigned([1, -2, 3, -4])
print_present(nil)
print_present(7)
print plus_one(1)
