# `pass` alone in a block, or as a function literal's body on its line, does nothing, which is
# `void`; alone in the body of a class or a struct, it declares one without members.
class Empty
  pass

struct Nothing
  pass

noop := -> pass
ignore := (_: Int) -> pass
handlers := [-> pass, noop]
try
  throw ValueError('ignored')
catch _: ValueError
  pass
if handlers.length > 1
  pass
for _ in handlers
  pass
while false
  pass
noop()
ignore 1
handler() for handler in handlers
print [Empty(), Empty()].length
print Nothing() == Nothing()
# In brackets, and before `else`.
calls := (f: () -> void) ->
  f()
  1
print calls(-> pass)
callbacks := { done: -> pass }
callbacks.done()
chosen := handlers.is_empty() then -> pass else -> pass
chosen()
print 'ran'
