names := { 'a': 'x' }

with_fallback := (key: String) ->
  var acc = 'start' + '!'
  acc += names[key] ? return acc
  acc

with_then_else := (key: String) ->
  var acc = 'then' + '!'
  acc += names[key] then 'found' else return acc
  acc

with_case := (n: Int) ->
  var acc = 'n' + '='
  acc +=
    case n
      when 1 then 'one'
      else return acc
  acc

in_loop := ->
  var acc = ''
  for i in [1, 2, 3, 4]
    var s = 'i' + "#{i}"
    s += i == 2 then (continue) else '.'  # fmt: skip
    s += names['missing'] ? break if i == 4
    s += names['a'] ? break
    acc += s
  print acc

captured := (key: String) ->
  var acc = 'captured' + '!'
  get := -> acc
  acc += names[key] ? return get()
  get()

var total = 'total' + ':'
for i in [1, 2, 3]  # fmt: skip
  total += i == 2 then (continue) else "#{i}"

struct Failed(message: String)

fail := (): String -> throw Failed(message: 'failed')

with_throw := ->
  var acc = 'throw' + '!'
  try
    acc += fail()
  catch e: Failed
    print e.message
  print acc

out_of_function := ->
  var acc = 'out' + '!'
  acc += fail()
  acc

in_loop_return := (key: String) ->
  var acc = 'loop' + '!'
  for _ in [1]  # fmt: skip
    acc += names[key] ? return acc
  acc

print with_fallback('a')
print with_fallback('b')
print with_then_else('a')
print with_then_else('b')
print with_case(1)
print with_case(2)
in_loop()
with_throw()
print captured('a')
print captured('b')
print total
try
  print out_of_function()
catch e: Failed
  print "caught #{e.message}"
print in_loop_return('a')
print in_loop_return('b')
