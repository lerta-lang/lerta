const sign = (n: Int) ->
  if n < 0
    'negative'
  else if n == 0
    'zero'
  else
    'positive'

print sign(-2)
print sign(0)
print sign(5)

const m = { 'a': 1 }
const describe = (key: String) ->
  const text = if const v = m[key]
    "found #{v}"
  else
    'missing'
  text

print describe('a')
print describe('b')

var width = 0
width = if m.has('a')
  10
else
  20
print width

const first = (xs: Array<String>): String? ->
  if xs.length > 0
    xs[0]
  else
    nil
print first(['x']) ? '-'
print first([]) ? '-'

const loop = () ->
  for i in 0...3
    const label = if i == 1
      continue
    else
      "#{i}"
    print label
loop()

# A branch that gives no value makes the if a statement, whose values are released.
const names = ['a', 'b']
if names.length > 5
  names.pop()
else
  print 'kept'

class Box
  size: Int = if names.length > 1
    2
  else
    1

const show = (p: { label: String }) -> print p.label
show
  label: if names.length > 1
    'many'
  else
    'one'
print Box().size
