# Values of `if` on the same line as what takes them, which the grammar allows though the style
# puts them on the next.
sign := (n: Int) ->
  if n < 0
    'negative'
  else if n == 0
    'zero'
  else
    'positive'

print sign(-2)
print sign(0)
print sign(5)

m := { 'a': 1 }
describe := (key: String) ->
  text := if v := m[key]  # fmt: skip
    "found #{v}"
  else
    'missing'
  text

print describe('a')
print describe('b')

var width = 0
width = if m.contains('a')  # fmt: skip
  10
else
  20
print width

first := (xs: String[]) ->
  if not xs.is_empty()  # fmt: skip
    xs[0]
  else
    nil
print first(['x']) else '-'
print first([]) else '-'

loop := ->
  for i in 0..3
    label := if i == 1  # fmt: skip
      continue
    else
      "#{i}"
    print label
loop()

# A branch that gives no value makes the if a statement, whose values are released.
names := ['a', 'b']
if names.length > 5
  names.pop()
else
  print 'kept'

class Box
  size: Int = if names.length > 1  # fmt: skip
    2
  else
    1

show := (p: { label: String }) -> print(p.label)
show
  label: if names.length > 1
    'many'
  else
    'one'
print Box().size
