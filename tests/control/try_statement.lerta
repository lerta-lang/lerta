# A try that is not the last statement runs, its blocks ending with calls, awaits or statements, a
# try in a catch among them, and a catch that uses the exception it takes.
import sleep from 'std:time'

halve := (x: Int) -> x / 2

f := (x: Int) ->
  try
    halve x
  catch _: ArithmeticError
    try
      await sleep(0)
    catch _: ValueError
      print 'unreachable'
  print 'after'
  try
    print 10 / x
  catch error: ArithmeticError
    print error.message
await f(4)
await f(0)
