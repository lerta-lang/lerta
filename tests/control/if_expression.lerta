# An `if` is an expression wherever one may start, as a `case` is: an argument in a block or in
# parentheses, an item of an array, an operand of a prefix or a binary operator, a trailing argument
# on the line, and a branch of another `if`.
add := (a: Int, b: Int) -> a + b
pick := (n: Int) ->
  sum := add
    if n > 0
      n
    else if n == 0
      100
    else
      -n
    1
  inside := add(
    if n > 1
      10
    else
      20
    2
  )
  items := [
    if n > 2
      'big'
    else
      'small'
  ]
  operand := 1 + if n > 3
    1000
  else
    0
  negated := not if n > 0
    false
  else
    true
  minus := -if n > 4
    n
  else
    0
  nested :=
    if n > 0
      if n > 4
        'many'
      else
        'few'
    else
      'none'
  var trailing = 0
  set := (a: Int, b: Int) -> trailing = a + b
  set n, if n > 1
    n
  else
    1
  print "#{[sum, inside, operand, minus, trailing]} #{items} #{negated} #{nested}"
pick 1
pick 5
pick 0
