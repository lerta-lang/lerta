# A try that ends a function whose every path returns, a try in its catch among them, gives the
# function its return type, as an if would.
const f = (x: Int?): Int ->
  try
    return 1 if x == nil
    return 2
  catch _: ValueError
    try
      return 3
    catch _: ArithmeticError
      return 4

print f(nil)
print f(5)
