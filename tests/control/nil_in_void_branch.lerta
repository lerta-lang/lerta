# nil that ends a branch of an if or a try that gives no value, as the last statement of a
# function, is discarded, as any value there is: in either branch, the try block or a catch.
const sign = (x: Int) ->
  if x > 0
    print 'positive'
  else
    nil

const negative = (x: Int) ->
  if x < 0
    nil
  else
    print 'not negative'

const inverse = (x: Int) ->
  try
    print 10 / x
  catch _: ArithmeticError
    nil

const checked = (x: Int) ->
  try
    nil
  catch _: ArithmeticError
    print 'unreachable'

const nested = (x: Int) ->
  if x > 0  # fmt: skip
    print 'nested positive'
  else
    if x < 0
      print 'nested negative'
    else
      nil

const caught = (x: Int) ->
  try
    print 10 / x
  catch _: ArithmeticError
    if x > 0
      print 'unreachable'
    else
      nil

for x in [1, 0]
  sign x
  negative x
  inverse x
  checked x
  nested x
  caught x
