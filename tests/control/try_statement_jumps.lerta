# A try whose block ends with an if whose branches all jump, and whose catch jumps, is a statement
# that lets nothing after it run, and one whose finally throws, after a block that gives a value.
const returning = (x: Int?) ->
  try
    if x == nil
      return
    else
      return
  catch _: ArithmeticError
    return
  print 'unreachable'

const name = -> 'name'

const throwing = (x: Int) ->
  try
    name()
  finally
    throw ValueError(message: "thrown for #{x}")
  print 'unreachable'

returning 3
try
  throwing 1
catch error: ValueError
  print error.message
