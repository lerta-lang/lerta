# A try whose block and catches all jump ends the branch, which narrows what follows, as an if
# whose branches all jump does; so does one whose finally throws.
const f = (x: Int?) ->
  if x == nil
    try
      return
    catch _: ArithmeticError
      return
  print x + 1

const g = (x: Int?) ->
  if x == nil
    try
      print 'no value'
    finally
      throw ValueError(message: 'nil')
  print x + 1

f 1
f nil
g 2
try
  g nil
catch error: ValueError
  print error.message
