import exit from 'std:process'

stop := (x: Int) ->
  exit x
  print 'after exit'
  x

first := (x: Int) ->
  return x
  print 'after return'
  x

either := (x: Int) ->
  if x > 0
    return
  else
    throw ValueError('negative')
  print 'after if'

maybe := (x: Int) ->
  return if x > 0
  print 'reachable after if'

caught := ->
  try
    return
  catch _: ValueError
    print 'caught'
  print 'reachable after try'

arm := (x: Int) ->
  y :=
    case x
      when 1
        throw ValueError('one')
        2
      else 3
  for i in [1, 2]
    continue
    print i
  while true
    break
    print 'after break'
  print y

every_arm := (x: Int) ->
  case x
    when 1 then throw ValueError('one')
    else return
  print 'after case'

thrown_in_finally := ->
  try
    print 'body'
  finally
    throw ValueError('finally')
  print 'after finally'

twice := <T>(x: T) ->
  return x
  print 'after return in a generic'
  x

print first(1)
either 1
maybe 0
caught()
arm 2
every_arm 2
try
  thrown_in_finally()
catch _: ValueError
  print 'caught from finally'
print twice(1)
print twice('a')
print stop(0) if false
code := Map<String, Int>()['missing'] ? exit(0)
exit code
print 'after top-level exit'
