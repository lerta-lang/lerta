# The body of a `while` is narrowed where its condition holds, as the then branch of an `if` is,
# until the body assigns the var.
class Node
  v: Int
  next: Node?

list := Node(v: 1, next: Node(v: 2, next: Node(v: 3, next: nil)))

walk := (start: Node?) ->
  var m = start
  while m != nil
    print m.v
    m = m.next

walk_by_test := (start: Node?) ->
  var n = start
  while n
    print n.v
    n = n.next
    print n != nil

shorten := ->
  var value: Int | String = 'abc'
  while value is String
    print value.to_upper()
    value = 3

count_up := ->
  var count: Int? = 0
  count = count + 1 while count != nil and count < 3
  print count ? -1

struct Box
  item: Int | String

# A field path and a parameter, which nothing assigns, stay narrowed after a `continue`.
drain := (box: Box, limit: Int?) ->
  var rounds = 0
  while box.item is Int and limit != nil
    rounds += 1
    continue if rounds < 2
    print box.item + limit
    break

# A parameter stays narrowed in a nested loop, and `not` over `or` narrows both operands.
nested := (x: Int?, y: Int?) ->
  var i = 0
  while not (x == nil or y == nil) and i < 1
    while i < 2
      print x + y + i
      i += 1

walk list
walk_by_test list
shorten()
count_up()
drain { item: 1 }, 10
nested 1, 2
