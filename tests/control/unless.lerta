struct A
  x: Int
struct B
  y: Int

describe := (n: Int?) ->
  return 'none' unless n
  "got #{n + 1}"

# Narrowed where the condition does not hold, after the block too, as the block returns.
size := (v: A | B) ->
  return v.y unless v is A
  v.x

print describe(nil)
print describe(2)
print size(A(x: 3))
print size(B(y: 4))
print 'block' unless 1 > 2
print 'skipped' unless 1 < 2
var n = 0
n += 3 until n >= 10
print n
until n == 0
  print n
  n -= 4
  n = 0 if n < 0
