# Weak locals and fields wherever locals and fields go: in a function that yields and in one that
# awaits, captured by a literal inside another, and read through a union. A field's initializer
# may make the object, which nothing else then holds; a weak var may be given the object it holds.
import sleep from 'std:time'

class Item
  name: String
  deinit = -> print("drop #{@name}")

class Holder
  weak item: Item? = Item(name: 'made')
  weak other: Item? = default nil

struct Other
  weak_free = 1

names := (item: Item) ->
  weak held := item
  yield held?.name ? 'gone'
  yield held?.name ? 'gone'

later := (item: Item) ->
  weak held := item
  await sleep(0)
  print held?.name ? 'gone'

nested := (item: Item) ->
  weak held := item
  outer := ->
    inner := -> held?.name ? 'gone'
    inner()
  outer()

read := (holder: Holder | Other) ->
  case holder
    when Holder then holder.other?.name ? 'none'
    else 'other'

run := ->
  item := Item(name: 'item')
  print names(item).to_array().join(' ')
  await later(item)
  print nested(item)
  print read(Holder(other: item))
  print Holder().item?.name ? 'gone'
  weak var same = item
  same = item
  print same?.name ? 'gone'

await run()

# `weak` stays usable as a name.
class Named
  weak: Int
weak := Named(weak: 1).weak
print weak
