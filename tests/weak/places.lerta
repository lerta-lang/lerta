# Weak locals and fields wherever locals and fields go: in a function that yields and in one that
# awaits, captured by a literal inside another, and read through a union. A field's initializer
# may make the object, which nothing else then holds; a weak var may be given the object it holds.
import sleep from 'std:time'

class Item
  args
    name: String
  deinit := -> print("drop #{@name}")

class Holder
  args
    weak other: Item?
  weak item: Item? = Item('made')

struct Other
  weak_free := 1

names := (item: Item) ->
  weak held := item
  yield held?.name else 'gone'
  yield held?.name else 'gone'

later := (item: Item) ->
  weak held := item
  await sleep(0)
  print held?.name else 'gone'

nested := (item: Item) ->
  weak held := item
  outer := ->
    inner := -> held?.name else 'gone'
    inner()
  outer()

read := (holder: Holder | Other) ->
  case holder
    when Holder then holder.other?.name else 'none'
    else 'other'

run := ->
  item := Item('item')
  print names(item).to_array().join(' ')
  await later(item)
  print nested(item)
  print read(Holder(other: item))
  print Holder().item?.name else 'gone'
  weak var same = item
  same = item
  print same?.name else 'gone'

await run()

# `weak` stays usable as a name.
class Named
  args
    weak: Int
weak := Named(1).weak
print weak
