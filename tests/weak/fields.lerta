# A weak field of a class may hold nil, reads as nil once its object is freed, and can be assigned,
# given to the constructor or left to its default.
class Node
  name: String
  weak parent: Node? = default nil
  weak sibling: Node? = nil
  deinit = -> print("drop #{@name}")

const family = ->
  const root = Node(name: 'root')
  const child = Node(name: 'child', parent: root)
  print child.parent?.name ? 'none'
  print child.sibling?.name ? 'none'
  child.sibling = child
  print child.sibling?.name ? 'none'
  child.parent = nil
  print child.parent?.name ? 'none'
family()

const orphan = ->
  const child = Node(name: 'orphan')
  const adopt = ->
    const parent = Node(name: 'parent')
    child.parent = parent
    print child.parent?.name ? 'none'
  adopt()
  print child.parent?.name ? 'parent gone'
orphan()
