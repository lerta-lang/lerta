# A weak field of a class may hold nil, reads as nil once its object is freed, and can be assigned,
# given to the constructor or left to its default.
class Node
  args
    name: String
    weak var parent: Node?
  weak var sibling: Node?
  deinit := -> print("drop #{@name}")

family := ->
  root := Node('root')
  child := Node(name: 'child', parent: root)
  print child.parent?.name else 'none'
  print child.sibling?.name else 'none'
  child.sibling = child
  print child.sibling?.name else 'none'
  child.parent = nil
  print child.parent?.name else 'none'
family()

orphan := ->
  child := Node('orphan')
  adopt := ->
    parent := Node('parent')
    child.parent = parent
    print child.parent?.name else 'none'
  adopt()
  print child.parent?.name else 'parent gone'
orphan()
