class Parent
  args
    name: String
  var child: Child?
  deinit := ->
    child := @child else return
    child.parent = heir

class Child
  args
    weak var parent: Parent!

# A parent that goes hands its child to the heir from its deinit.
heir := Parent('heir')
child := Child(heir)
pass := ->
  old := Parent('old')
  child.parent = old
  old.child = child
pass()
print child.parent.name
