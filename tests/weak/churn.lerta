# Weak locals made and dropped in a loop, given a temporary that is freed at once, and left by an
# exception, while one is assigned too: each releases its box.
class Item
  name: String
  weak other: Item? = default nil
  deinit = -> print("drop #{@name}")

struct Failed
  message: String

fail := (): Item -> throw Failed('failed')

run := ->
  for name in ['a', 'b']
    item := Item(name)
    weak seen := item
    print seen?.name ? 'gone'
  weak var temporary = Item('temporary')
  print temporary?.name ? 'gone'
  holder := Item('holder')
  try
    weak before := holder
    print before?.name ? 'gone'
    holder.other = fail()
  catch e: Failed
    print e.message
  print holder.other?.name ? 'none'
run()
