# Where a weak field or local stands for nothing: left out of the constructor, set to its own
# object, which its deinit then finds gone, or given nil; and the cycle of an object that holds a
# literal, two levels deep, that captures it weakly, which is freed.
class Node
  name: String
  weak peer: Node?
  init = -> @peer = @ if @name == 'self'
  deinit = -> print("drop #{@name}: #{@peer?.name ? 'no peer'}")

class Box<T>
  weak item: Node? = default nil
  value: T
  set = (node: Node) -> @item = node

class Clicker
  on_click: (() -> String)? = nil
  init = ->
    weak me := @
    @on_click = ->
      describe := -> me != nil then 'alive' else 'gone'
      describe()
  deinit = -> print('drop clicker')

run := (missing: Node?) ->
  alone := Node('alone')
  print alone.peer?.name ? 'no peer'
  own := Node('self')
  print own.peer?.name ? 'no peer'
  box := Box(1)
  box.set alone
  print box.item?.name ? 'none'
  weak nothing := missing
  print nothing?.name ? 'nil'
  clicker := Clicker()
  print clicker.on_click!()
run nil

# The literal outlives the object it captures weakly.
outlive := ->
  click := Clicker().on_click!
  print click()
outlive()

# A weak local in a block of the top-level code is a local.
if true
  kept := Node('kept')
  weak seen := kept
  print seen?.name ? 'gone'
