class Parent
  args
    name: String
  deinit := -> print("parent #{@name} gone")

class Child
  args
    weak var parent: Parent!

# A `weak var` field of type `T!` takes another object, and throws once that one is gone.
p := Parent('p')
child := Child(p)
print child.parent.name
replace := ->
  q := Parent('q')
  child.parent = q
  print child.parent.name
replace()
child.parent = p
print child.parent.name
lose := -> child.parent = Parent('r')
lose()
print child.parent.name
