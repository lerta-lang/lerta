# dbg writes where the call is, its code and the value's literal to stderr, and gives the value,
# evaluated once and typed where it is expected.
struct Point
  x: Int

xs := [1, 2]
n := dbg(xs.length) + 1
print n
small: Int8 = dbg(3)
print small
m := { 'a': 1 }
dbg m['b']
dbg m['a']
# A value whose type has no literal is shown by its type, as is an array of such items.
dbg Point(x: 1)
dbg [Point(x: 1)]
dbg [[Point(x: 1)]]
points: Point[]? = [{ x: 1 }]
dbg points
dbg { 'a': Point(x: 1) }
dbg [[1, 2]]
optionals: Int?[] = [1, nil]
dbg optionals
set := Set<Point>([{ x: 1 }])
dbg set
var calls = 0
counted := ->
  calls += 1
  calls
print dbg(counted())
# A name of the program's own does not hide what dbg writes with.
print_error := (text: String) -> print("hidden #{text}")
dbg 'text'
# Arguments in parentheses are quoted through their `)`, over lines.
total := dbg(
  xs.length + 1
) * 2  # fmt: skip
print total
# Each instance of a generic function shows its own value.
shown := <T: Literal>(x: T) -> dbg(x)
shown 1
shown 'one'
# An operand that is not evaluated writes nothing.
print false and dbg(true)
# A run test's stderr is checked where the run fails, so this one ends with an uncaught error.
throw ValueError('end')
