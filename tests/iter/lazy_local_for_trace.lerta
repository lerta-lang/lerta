# An exception out of the function given to filter, whose call a local holds, through a for over the
# local, goes on without the site of filter's own closure, as where the call is written in place of
# the local (see docs/internals/iteration.md#fused-loops).
check := (x: Int) ->
  throw ValueError('check') if x == 2
  x > 0

f := (xs: Int[]) ->
  kept := xs.filter((x) -> check(x))
  print x for x in kept
f [1, 2, 3]
