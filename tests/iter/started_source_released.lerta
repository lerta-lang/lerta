# A comprehension over an Iter whose traversal has started throws, and releases what it holds by
# then, the source and any closure made for it, so that an object they capture goes as its scope
# ends, and nothing leaks.
class Scale
  factor: Int
  deinit = -> print("scale #{@factor} gone")

scaled := (source: Iter<Int>, factor: Int) ->
  scale := Scale(factor)
  (x * scale.factor for x in source when x > 0)

numbers := (x for x in 0...3)
print numbers.has_next()
try
  _again := scaled(numbers, 2)
catch error: IterError
  print error.message
print [x for x in scaled((x for x in 0...3), 3)]
print 'done'
