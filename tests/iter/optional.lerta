# Items may be optional, nil included: the end of an Iter is not a nil.
const maybe = (x: Int): Int? -> x % 2 == 0 then x else nil
const items: Iter<Int?> = (maybe(x) for x in 0...4)
print item ? -1 for item in items
const names: String?[] = [nil, 'ann', nil]
const greeted = names.map((name) -> name then "hi #{name}" else nil)
print greeted.has_next()
print greeted.next() ? 'nobody'
print greeted.next() ? 'nobody'
const kept = (name + '?' for name in names when name)
print kept.to_array().join(',')
const flags: Iter<Bool?> = (x == 1 then nil else x == 0 for x in 0...3)
print flag ? false for flag in flags
