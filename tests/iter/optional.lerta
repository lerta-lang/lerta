# Items may be optional, nil included: the end of an Iter is not a nil.
maybe := (x: Int) -> x % 2 == 0 then x  # fmt: skip
items: Iter<Int?> = (maybe(x) for x in 0..4)
print item else -1 for item in items
names: String?[] = [nil, 'ann', nil]
greeted := names.map((name) -> name then "hi #{name}")
print greeted.has_next()
print greeted.next() else 'nobody'
print greeted.next() else 'nobody'
kept := (name + '?' for name in names when name)
print kept.to_array().join(',')
flags: Iter<Bool?> = (x == 1 then nil else x == 0 for x in 0..3)
print flag else false for flag in flags
