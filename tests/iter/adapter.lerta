# A value with has_next and next converts to an Iter where one is expected, as the result of a
# function that keeps its state in a var that the two functions capture, or as a class.
const countdown = (n: Int): Iter<Int> ->
  var i = n
  const has_next = -> i > 0
  const next = ->
    i -= 1
    i + 1
  { has_next, next }

class Lines
  var left = ['a', 'b']
  has_next = -> @left.length > 0
  next = ->
    const first = @left[0]
    @left = [@left[i] for i in 1...@left.length]
    first

print x for x in countdown(3)
const lines: Iter<String> = Lines()
print [line for line in lines].length
print countdown(4).map((x) -> x * 2).to_array().length
