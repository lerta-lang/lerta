# A method of an Iterable that goes through its items in one loop, called on an array, a field of
# a field that holds one, the Binary of a String, or a lazy comprehension, map or filter over such
# an array, gives what it gives through the array: of a local, of @ in a method, given only
# functions, and given an argument that assigns the field, which the method then reads after it,
# so that it is called; with a function that assigns the field or changes the array as the loop
# goes; through `?.`; of a Binary and of an empty String; and with a field of a var, a field that
# holds an Iter and an argument that is a field, which call the method.
class Box
  args
    var items: Int[]
    inner: Box?
  name := 'box'

  total := -> @items.fold(0, (sum, x) -> sum + x)
  odd := -> (x for x in @items when x % 2 == 1).count()  # fmt: skip

class Holder
  args
    box: Box
    numbers: Iter<Int> = (x for x in [1, 2])
  start := 10
  name := 'holder'

f := (holder: Holder) ->
  numbers := [1, 2, 3, 4]
  print numbers.any((x) -> x > 3)
  print numbers.find((x) -> x > 1) else 0
  print holder.box.items.all((x) -> x > 0)
  print holder.box.items.map((x) -> x * 10).sum()
  print (x for x in holder.box.items when x > 1).count()
  print holder.box.total()
  print holder.box.odd()
  replace := ->
    holder.box.items = [100]
    0
  print holder.box.items.fold(replace(), (sum, x) -> sum + x)
  print holder.box.items.sum()
  print holder.box.items.fold(0, (sum, x) ->
    holder.box.items = [7, 8]
    sum + x
  )
  print holder.box.items.any((x) ->
    holder.box.items.pop()
    x > 7
  )
  print holder.box.inner?.items.sum() else -1
  print Box(items: [], inner: Box([4, 5])).inner?.items.sum() else -1
  var other = holder
  print other.box.items.count()
  print holder.numbers.sum()
  print (x for x in holder.box.items).fold(holder.start, (sum, x) -> sum + x)
  text := "a'b"
  print text.binary.all((byte) -> byte != 0x27)
  print holder.name.binary.count()
  bytes := b'xyz'
  print bytes.fold(0, (sum, byte) -> sum + byte.to_int())
  print holder.box.inner?.name.binary.count() else -1
  print b''.any((byte) -> byte == 0x61)
  var named = holder
  print named.name.binary.count()

f Holder(Box([1, 2, 3]))
