# A const Iter traversed again, by a loop, a comprehension or a method after another traversal,
# warns there, where it would throw; has_next and next go on with one traversal.
twice := (n: Int) ->
  squares := (x * x for x in 0..n)
  print squares.to_array()
  print [x for x in squares]
  print squares.sum()
looped := (n: Int) ->
  items := (x for x in 0..n)
  print x for x in items
  print items.map((x) -> x + 1).to_array()
stepped_then_read := ->
  it := (x for x in 0..3)
  print it.next()
  print it.to_array()
run := false
if run
  twice 1
  looped 1
  stepped_then_read()
stepped := (x for x in 0..3)
print stepped.next()
print stepped.next() while stepped.has_next()
once := (x for x in 0..2)
print once.to_array()

# Reads in branches, a loop or a function literal do not count, as they may not both run.
branches := (flag: Bool) ->
  it := (x for x in 0..3)
  if flag
    print it.to_array()
  else
    print it.sum()
branches true
later := (x for x in 0..2)
read := -> later.to_array()
print read()
passed := (x for x in 0..2)
print [passed].length
