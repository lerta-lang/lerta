# min and max give the least and the greatest item of an Iterable whose items are Comparable, and
# min_by and max_by those of any items by a key; each gives the first of equal ones, or nil for none.
print [[3, 1, 2].min() ? 0, [3, 1, 2].max() ? 0, Set([5, 9, 4]).max() ? 0]
print ['pear', 'fig'].min() ? ''
print (x * x for x in [-3, 2]).max() ? 0
const none: Int[]
print [none.min() == nil, none.max_by((x) -> -x) == nil]

struct Item(name: String, price: Int)
const items =
  Item(name: 'tea', price: 3)
  Item(name: 'cake', price: 5)
  Item(name: 'jam', price: 3)
print [items.min_by((item) -> item.price)!.name, items.max_by((item) -> item.price)!.name]
# Of equal keys, the first item.
print [items.max_by((item) -> -item.price)!.name, ['b', 'a', 'c'].min_by((s) -> 0) ? '']
const counts = { 'x': 2, 'y': 7, 'z': 7 }
const by_count = (entry: (String, Int)) ->
  const (_, count) = entry
  count
const (word, count) = counts.entries().max_by(by_count)!
print "#{word} #{count}"

# One item; ties of plain min; the code points of a String.
print [[7].min() ? 0, [7].max() ? 0]
print "#{'cab'.max()!} #{'cab'.min()!}"
const versions =
  Version(number: 2, tag: 'a')
  Version(number: 1, tag: 'b')
  Version(number: 1, tag: 'c')
print versions.min()!.tag

struct Version
  number: Int
  tag: String
  compare = (other: Version) -> @number.compare(other.number)
const tied =
  Version(number: 1, tag: 'd')
  Version(number: 3, tag: 'e')
  Version(number: 3, tag: 'f')
print tied.max()!.tag

# A class of its own that is Iterable has them too.
class Countdown(from: Int)

extend Countdown
  iter = (): Iter<Int> -> (n for n in 0...@from)
print [Countdown(from: 4).max() ? 0, Countdown(from: 4).min_by((n) -> -n) ? 0]
