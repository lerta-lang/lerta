# Nothing runs until the Iter is consumed; then the guard and the element run item by item.
traced := (label: String, x: Int) ->
  print "#{label} #{x}"
  x
squares := (
  for x in [1, 2, 3, 4] when traced('guard', x) != 2
    traced('element', x) * x
)
print 'created'
print square for square in squares
doubled := [1, 2, 3].map((x) -> traced('map', x) * 2)
print 'mapped'
print doubled.next()
print 'one taken'
print doubled.next()
