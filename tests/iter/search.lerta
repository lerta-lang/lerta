xs := [3, 8, 5, 10]
var tested = 0
big := (x: Int) ->
  tested += 1
  x > 4
print xs.any(big)
print tested
print xs.all(big)
print tested
print xs.find(big) ? 0
print tested
print xs.find((x) -> x > 99) ? 0
print xs.all((x) -> x > 0)
print xs.any((x) -> x > 99)
empty: String[]
print empty.any((s) -> true)
print empty.all((s) -> false)
print empty.find((s) -> true) ? 'none'
print (x * x for x in 0...10).find((x) -> x > 20) ? -1
print (b for b in 'ab'.binary).any((b) -> b == 'b')
names := ['ann', 'bob']
print names.find((name) -> name.binary[0] == 'b') ? 'nobody'
rest := (x for x in 0...5)
print rest.any((x) -> x == 2)
