# An exception out of the function given to filter, over a field that holds an array, in a call of
# sum generated in place, goes on from the method's loop, without the site of filter's own closure
# (see docs/internals.md#fused-loops).
struct Holder
  items: Int[]

check := (x: Int) ->
  throw ValueError('check') if x == 2
  x > 0

f := (holder: Holder) -> print(holder.items.filter((x) -> check(x)).sum())
f Holder([1, 2, 3])
