# for and comprehensions go through a value whose type satisfies Iterable by its iter(), and so do
# they through an Iterable value, and an Iter and a Binary are Iterable.
class Bag
  items: Int[]
  iter := (): Iter<Int> -> (x * 10 for x in @items)

bag := Bag([1, 2])
print x for x in bag
print [x + 1 for x in bag].length
all: Iterable<Int> = bag
print x for x in all
print x for x in b'ab'.iter()
total := <T, X: Iterable<T>>(xs: X, f: (T) -> Int) ->
  var sum = 0
  sum += f(x) for x in xs
  sum
print total(bag, (x) -> x)
print total(b'abc', (b) -> b.to_int())
print total((x for x in [1, 2, 3]), (x) -> x)

# Instances of one generic function go through arrays and Iterables each their own way.
class Pair
  iter := (): Iter<Int> -> (x * 10 for x in 0..2)
count := <T, X: Iterable<T>>(xs: X) ->
  var n = 0
  n += 1 for x in xs
  n
print count(Pair())
print count([1, 2, 3])
