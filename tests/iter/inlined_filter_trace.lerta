# An exception out of the function given to filter, in a call of sum generated in place, goes on
# from the method's loop, without the site of filter's own closure, which only calls the function
# (see docs/internals/iteration.md#fused-loops).
numbers := (n: Int) -> yield i for i in 0..n

check := (x: Int) ->
  throw ValueError('check') if x == 2
  x > 0

f := (n: Int) -> print(numbers(n).filter((x) -> check(x)).sum())
f 5
