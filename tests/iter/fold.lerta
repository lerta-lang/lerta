# A value combined with each item in turn, of an array, an Iter, which it consumes, and a set, of
# the items' type or another.
print [3, 1, 2].fold(0, (sum, x) -> sum * 10 + x)
print ['a', 'b'].fold('', (text, s) -> text + s)
print (x * 2 for x in [1, 2, 3]).fold(0, (sum, x) -> sum + x)
print Set([1, 2]).fold(10, (sum, x) -> sum + x)
none: Int[]
print none.fold(7, (sum, x) -> sum + x)
print [1, 2, 3].fold('', (text, x) -> text + x.to_string())
it := [1, 2].iter()
print it.fold(0, (sum, x) -> sum + x)
print it.has_next()
