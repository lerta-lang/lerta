# An exception out of the function given to filter, whose call a local holds, through a local that
# holds a comprehension over another such local, goes on without the site of filter's own closure,
# as where the call is written in place of the local (see docs/internals.md#fused-loops).
check := (x: Int) ->
  throw ValueError('check') if x == 2
  x > 0

f := (xs: Int[]) ->
  kept := xs.filter((x) -> check(x))
  doubled := (x * 2 for x in kept)
  print doubled.sum()
f [1, 2, 3]
