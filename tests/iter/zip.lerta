# zip pairs the items of two Iterables, as many as the shorter has.
const names = ['a', 'b', 'c']
const counts = [1, 2]
print "#{name}#{count}" for (name, count) in names.zip(counts)
print "#{byte}:#{letter}" for (byte, letter) in 'xy'.binary.zip('pqr')
const doubled = (n * 2 for n in counts)
print [name for (name, _) in names.zip(doubled)].join(' ')
const empty: Array<Int> = []
print names.zip(empty).to_array().length
print [n for (_, n) in names.zip(names.zip(counts))].length
