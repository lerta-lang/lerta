# zip pairs the items of two Iterables of the same length, and throws once one has more.
const names = ['a', 'b', 'c']
const counts = [1, 2, 3]
print "#{name}#{count}" for (name, count) in names.zip(counts)
print "#{byte}:#{letter}" for (byte, letter) in 'xy'.binary.zip('pq')
const doubled = (n * 2 for n in counts)
print [name for (name, _) in names.zip(doubled)].join(' ')
const empty: Int[] = []
print empty.zip(empty).to_array().length
print [n for (_, n) in names.zip(names.zip(counts))].length
print [count for (_, count) in names.zip([4, 5, 6, 7].take(3))].length
try
  print name for (name, _) in names.zip([1, 2])
catch e: ValueError
  print e.message
try
  print name for (name, _) in ['z'].zip([1, 2])
catch e: ValueError
  print e.message
