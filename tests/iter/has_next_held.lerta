# has_next holds the item it reads until next gives it, so asking twice reads one item, and
# asking past the end gives false again. A nil item is no end.
names: String?[] = [nil, 'ann']
kept := names.filter((name) -> name != 'bob')
print kept.has_next()
print kept.has_next()
print kept.next() else 'nobody'
print kept.next() else 'nobody'
print kept.has_next()
print kept.has_next()
counted := (
  for x in 0..2
    print "made #{x}"
    x
)
print counted.has_next()
print counted.next()
print counted.has_next()
print counted.has_next()
print counted.next()
print counted.has_next()
positive := (x: Int) -> x > 0 then x  # fmt: skip
numbers: Iter<Int?> = (positive(x) for x in 0..2)
print numbers.has_next()
print numbers.next() else -1
print numbers.next() else -1
print numbers.has_next()
