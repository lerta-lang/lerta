# An exception out of the function given to filter, over the Binary of a String, in a call of count
# generated in place, goes on from the method's loop, without the site of filter's own closure
# (see docs/internals/iteration.md#fused-loops).
check := (byte: Byte) ->
  throw ValueError('check') if byte == 0x62
  byte.to_int()

f := (text: String) -> print(text.binary.filter((byte) -> check(byte) > 0).count())
f 'abc'
