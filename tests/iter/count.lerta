# The number of items, as `for` goes through them: the Chars of a String, code points rather than
# what a reader takes for one character, the items of an array, a set, an Iter, which it consumes,
# and a type of its own that is Iterable.
print ['héllo'.count(), ''.count(), '😀a'.count(), b'ab'.count(), "e\u{301}".count()]
print [[1, 2].count(), Set([1, 1]).count()]
it := (x for x in [1, 2, 3] when x > 1)
print it.count()
print it.has_next()
none: Int[]
print none.iter().count()

class Countdown
  from: Int
  iter := (): Iter<Int> -> (@from - i for i in 0...@from)

print Countdown(3).count()
