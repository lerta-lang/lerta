# Comprehensions over ranges, arrays and other Iters, with and without guards.
const show = (xs: Array<Int>): String -> [x.to_string() for x in xs].join(',')
print show((x * x for x in 0...5).to_array())
print show((x for x in 3...1).to_array())
const evens: Iter<Int> = (x for x in 0...10 when x % 2 == 0)
const halves = (x / 2 for x in evens when x > 2)
print show(halves.to_array())
const words = ['a', 'bb', 'ccc']
print (w + '!' for w in words when w != 'bb').to_array().join(' ')
const empty: Array<String> = []
print (w for w in empty).has_next()
print show([n + 1 for n in (x * 10 for x in 1...4)])
print x for x in (y for y in 5...8) when x != 6
const grid = ((x * y for y in 1...3) for x in 1...3)
for row in grid
  print show(row.to_array())
