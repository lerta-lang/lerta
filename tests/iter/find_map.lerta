# find_map gives the first result that is not nil, and stops reading there.
numbers := ->
  for text in ['a', '12', '3']
    print "read #{text}"
    yield text

print numbers().find_map((text) -> text.parse_int()) ? -1
print ['a', 'b'].find_map((text) -> text.parse_int()) ? -1
empty: String[]
print empty.find_map((text) -> text.parse_int()) ? -1
print [1, 2].find_map((x) -> x > 1 then "#{x}") ? 'none'
