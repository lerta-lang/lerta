# sum adds up the items of an Iterable, from 0 for numbers, or from the zero it is given for other
# types whose `+` gives their own type.
print [[1, 2, 3].sum(), Set([4, 5]).sum(), (x * x for x in 0...4).sum()]
print [[0.5, 1.25].sum(), [1.5].sum(10.0)]
none: Int[]
small: Int8[] = [100, 20]
print [none.sum(), small.sum().to_int()]
print ['a', 'b', 'c'].sum('>')

struct Money(cents: Int)

extend Money
  add = (other: Money) -> Money(cents: @cents + other.cents)
print [Money(cents: 150), Money(cents: 275)].sum(Money(cents: 0)).cents

# An Iter is consumed by its sum.
squares := (x * x for x in 1...4)
print squares.sum()
