# The methods of Iterable reach every type that satisfies it, and take stops reading its source
# after the items it gives.
class Bag
  items: Int[]
  iter = (): Iter<Int> -> (x for x in @items)

const bag = Bag(items: [1, 2, 3])
print bag.map((x) -> x * 2).to_array().length
print bag.any((x) -> x > 2)
print bag.find((x) -> x > 1) ? 0
print bag.take(2).to_array().length
print 'ab'.binary.map((b) -> b.to_int()).to_array()[1]

# An endless source, which take reads only as far as its items.
var read = 0
const naturals = (): Iter<Int> ->
  const has_next = -> true
  const next = ->
    read += 1
    read
  { has_next, next }
print naturals().take(3).to_array().length
print read
print bag.filter((x) -> x != 2).to_array().length
print bag.all((x) -> x > 0)
print x for x in bag.take(2)
