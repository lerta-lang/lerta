# take_while gives the items before the first that fails the test, which it reads but no more.
numbers := (count: Int) ->
  for i in 0..count
    print "read #{i}"
    yield i

print numbers(5).take_while((x) -> x < 2).to_array()
print [1, 2].take_while((x) -> x < 5).to_array()
print [5, 1].take_while((x) -> x < 5).to_array()
empty: Int[]
print empty.take_while((x) -> x < 5).to_array()
print 'ab c'.take_while((c) -> c != ' ').to_array()
