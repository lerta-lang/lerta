# Iters returned from functions, and the values their functions capture: a const's value when the
# Iter is made, and a var itself, as any function literal captures them.
multiples := (factor: Int, count: Int): Iter<Int> -> (i * factor for i in 0...count)
show := (xs: Iter<Int>) -> [x.to_string() for x in xs].join(',')
print show(multiples(3, 4))
prefixed := (prefix: String, words: String[]): Iter<String> -> words.map((word) -> prefix + word)
print prefixed('re', ['do', 'make']).to_array().join(' ')
var offset = 0
shifted := (x + offset for x in [1, 2, 3])
offset = 100
print shifted.next()
offset = 200
print shifted.next()
var seen = 0
is_kept := (x: Int) ->
  seen += 1
  x != 6
counted := [5, 6, 7].filter(is_kept)
print seen
print show(counted)
print seen
class Box
  items: String[]
  shouted = -> (item + '!' for item in @items)
box := Box(items: ['a', 'b'])
print box.shouted().to_array().join('')
iters := [(x for x in 0...2), (x * 10 for x in 0...2)]
print show(it) for it in iters
