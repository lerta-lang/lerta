# Iters and closures made anew on each round of a loop, each with its own source and captures, as
# an optimized build may take what one was made with for what a later one holds: each round gives
# its own results.
numbers := (count: Int) -> yield i for i in 0...count

for k in 1...4
  scaled := [x * k for x in 0...5].iter().filter((x) -> x % 2 == 0).map((x) -> x + k).sum()
  generated := numbers(k + 2).map((x) -> x * 10 + k).to_array()
  adders := [(x: Int) -> x + k + j for j in 0...3]
  print "#{scaled} #{generated} #{[add(100) for add in adders]}"

for name in ['a', 'bb', 'ccc']
  counts: Map<String, Int>
  counts[name] = name.binary.length
  counts["#{name}!"] = 0
  keys := counts.keys().to_array()
  entries := [v for (_, v) in counts.entries()]
  print "#{keys} #{entries}"

# A var that the closures of a round capture is a cell of that round, which they read as written.
for k in 1...3
  var count = k
  bump := -> count += 10
  read := -> count
  bump()
  print "#{read()} #{count}"

# A closure that is only called in its function, made on each round, is on the stack, at one place
# for the function, and still holds what each round captured.
rounds := (n: Int) ->
  var out: Int[] = []
  for k in 0...n
    shift := 100 * k
    g := (x: Int) -> x + k + shift
    out.push g(1)
    out.push g(2)
  out

print rounds(3)
