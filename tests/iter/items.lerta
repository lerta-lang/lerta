# Items that are references of every kind: anonymous structs, structs, class objects and closures,
# including one a filter holds when the Iter is dropped.
struct Point
  x: Int
class Counter
  count: Int
const pairs = [{ n: 'a' }, { n: 'b' }].filter((p) -> p.n != 'a')
print pairs.next().n
const held = [{ n: 'a' }].filter((p) -> true)
print held.has_next()
const points = (Point(x: i) for i in 0...3 when i != 1)
print [p.x for p in points].length
const counters = [Counter(count: 1), Counter(count: 2)].map((c) -> c)
print counters.next().count
const kept_counter = [Counter(count: 3)].filter((c) -> c.count > 0)
print kept_counter.has_next()
print [(x: Int): Int -> x].filter((q) -> true).next()(1)
const adders = ((y: Int): Int -> x + y for x in 0...3)
print adders.take(2).to_array()[1](10)
class Holder
  items: Iter<String>
const holder = Holder(items: ['a', 'b'].map((s) -> s + '!'))
print holder.items.next()
const _dropped = Holder(items: ['c'].filter((s) -> true))
