# Items that are references of every kind: anonymous structs, structs, class objects and closures,
# including one a filter holds when the Iter is dropped.
struct Point
  x: Int
class Counter
  args
    count: Int
pairs := [{ n: 'a' }, { n: 'b' }].filter((p) -> p.n != 'a')
print pairs.next().n
held := [{ n: 'a' }].filter((p) -> true)
print held.has_next()
points := (Point(i) for i in 0..3 when i != 1)
print [p.x for p in points].length
counters := [Counter(1), Counter(2)].map((c) -> c)
print counters.next().count
kept_counter := [Counter(3)].filter((c) -> c.count > 0)
print kept_counter.has_next()
print [(x: Int) -> x].filter((q) -> true).next()(1)
adders := ((y: Int) -> x + y for x in 0..3)
print adders.take(2).to_array()[1](10)
class Holder
  args
    items: Iter<String>
holder := Holder(['a', 'b'].map((s) -> s + '!'))
print holder.items.next()
_dropped := Holder(['c'].filter((s) -> true))
