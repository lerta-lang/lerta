# An exception out of a function that yields, through the method of an Iterable that goes through
# it, has the trace that it has through its Iter, as has one out of the method's function.
numbers := (n: Int) ->
  for i in 0...n
    throw ValueError('numbers') if i == 3
    yield i

check := (x: Int) ->
  throw ValueError('check') if x == 2
  x

f := (n: Int) ->
  try
    print numbers(n).fold(0, (total, x) -> total + check(x))
  catch e: ValueError
    print e.message
  print numbers(n).map((x) -> x * 2).sum()
f 5
