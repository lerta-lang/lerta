# map, filter and take of arrays and Iters, and the protocol methods.
show := (xs: Int[]) -> [x.to_string() for x in xs].join(',')
xs := [1, 2, 3, 4, 5]
print show(xs.map((x) -> x * 10).to_array())
print show(xs.filter((x) -> x % 2 == 1).to_array())
print show(xs.take(2).to_array())
print show(xs.take(0).to_array())
print show(xs.take(-1).to_array())
print show(xs.take(9).to_array())
negate := (x: Int) -> -x
print show(xs.map(negate).filter((x) -> x < -2).map((x) -> x + 1).take(2).to_array())
lengths: Iter<Int> = ['a', 'bc'].map((s) -> s.binary.length)
print show(lengths.to_array())
labels := xs.map((x) -> "<#{x}>")
print labels.take(3).to_array().join('')
it := (x for x in 0..3)
print it.next() while it.has_next()
print it.has_next()
flags := [true, false].map((b) -> not b)
print flags.next()
bytes := b'hi'
print show((b.to_int() for b in bytes).to_array())
