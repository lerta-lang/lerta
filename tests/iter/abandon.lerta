# An Iter left before its end, by break, return or never being consumed, is released with what it
# holds: its source, its closures and an item a filter holds.
const names = ['ann', 'bob', 'cy', 'dee']
for name in (n + '!' for n in names when n != 'bob')
  break if name == 'cy!'
  print name
const first_long = (words: String[]) ->
  return word for word in words.filter((w) -> w.binary.length > 2)
  nil
print first_long(names) ? 'none'
const held = names.filter((n) -> n != 'ann')
print held.has_next()
const _unused = names.map((n) -> n + names[0])
const tail = (n for n in names).take(1)
print tail.next()
const nested = ((n + '-' + m for m in names) for n in names)
print nested.next().next() + ' ' + nested.next().next()
