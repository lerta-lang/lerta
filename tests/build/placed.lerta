import placed, Place from '../../tools/build/samples'

places: Place[] = [{ file: 'README.md', line: 7 }, { file: 'docs/tour/basics.md', line: 60 }]
reports :=
  'build/samples/sample-1.lerta:1:5: a rule (Rule)'
  'build/samples/sample-2.lerta:4:13: put two spaces before the comment (Comments)'
  'build/samples/sample-2.lerta: its rewrites would not parse'
  'build/samples/sample-2.lerta: its layout would change the program: a: b'
  'build/samples/sample-1.lerta:x:1: of the block'
  'other.lerta:1:1: kept'
  'build/samples/sample-x.lerta:1:1: kept'
  'build/samples/sample-3.lerta:1:1: kept'
for report in reports
  print placed(report, places)
