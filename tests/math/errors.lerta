# The functions of std:math throw where the result would not be a finite Float.
import pow, remainder, sqrt from 'std:math'

const tries =
  -> sqrt(-1.0)
  -> pow(10.0, 400.0)
  -> pow(0.0, -1.0)
  -> pow(-8.0, 0.5)
  -> remainder(1.0, 0.0)
for attempt in tries
  try
    print attempt()
  catch e: ArithmeticError
    print e.message
print sqrt(0.0)
print pow(0.0, 0.0)
