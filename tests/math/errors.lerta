# The functions of std:math throw where the result would be NaN, which no Float is; a result too
# large is an infinity.
import acos, asin, cos, INFINITY, log, log10, log2, remainder, sin, sqrt, tan from 'std:math'

tries :=
  -> sqrt(-1.0)
  -> 10.0 ** 400.0
  -> 0.0 ** -1.0
  -> (-8.0) ** 0.5
  -> remainder(1.0, 0.0)
  -> remainder(INFINITY, 2.0)
  -> remainder(-INFINITY, 2.0)
  -> remainder(2.0, INFINITY)
  -> sin(INFINITY)
  -> cos(-INFINITY)
  -> tan(INFINITY)
  -> asin(1.5)
  -> asin(1.0000000000000002)
  -> sin(-INFINITY)
  -> acos(-1.5)
  -> log(-1.0)
  -> log2(-0.5)
  -> log10(-INFINITY)
for attempt in tries
  try
    print attempt()
  catch e: ArithmeticError
    print e.message
print sqrt(0.0)
print 0.0 ** 0.0
