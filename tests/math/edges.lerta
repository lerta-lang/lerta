# Signed zeros, a negative number to a huge even power, an underflow to zero, remainders by a
# negative, a tiny or a negative zero divisor, a floor beyond 2^53, and a power overflowing below
# zero, to the negative infinity, as -0.0 to a negative power is; and the infinities, which C's pow
# takes, a negative one to a fractional power too, and to which a negative number goes.
import abs, ceil, floor, INFINITY, pow, remainder, round, sqrt from 'std:math'

print ceil(-0.5)
print round(-0.4)
print abs(-0.0)
print pow(-1.0, 1e300)
print pow(2.0, -1076.0)
print remainder(7.5, -2.0)
print remainder(1.0, 1e-300) < 1e-300
print pow(-0.0, -1.0)
print sqrt(-0.0)
print remainder(-0.0, 3.0)
print floor(1e300) == 1e300
print pow(-10.0, 401.0)
try
  print remainder(1.0, -0.0)
catch e: ArithmeticError
  print e.message
print "#{pow(-INFINITY, 0.5)} #{pow(-INFINITY, 3.0)} #{pow(-8.0, INFINITY)} #{pow(-0.5, INFINITY)}"
