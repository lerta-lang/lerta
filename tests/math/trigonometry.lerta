# The trigonometric functions, of angles in radians, their inverses, the exponential, the logarithms
# and hypot; shown to 6 places, as libm's last digit may differ by system.
import
  acos, asin, atan, atan2, cos, E, exp, hypot, INFINITY, log, log10, log2, PI, sin, tan
from 'std:math'

shown := (x: Float) -> x.to_fixed(6)
print [shown(sin(PI / 6.0)), shown(cos(PI / 3.0)), shown(tan(PI / 4.0))]
print [shown(asin(1.0)), shown(acos(-1.0)), shown(atan(1.0))]
print [shown(atan2(1.0, -1.0)), shown(atan2(-0.0, -1.0)), shown(atan2(0.0, 0.0))]
print [shown(atan2(0.0, -0.0)), shown(atan2(-0.0, -0.0))]
print [shown(exp(1.0)), shown(exp(0.0))]
print [shown(log(E)), shown(log2(8.0)), shown(log10(1000.0))]
print shown(hypot(3.0, 4.0))

# Beyond the Floats, an infinity or zero; hypot overflows only where its result does.
print [exp(-1000.0), exp(1000.0), log(0.0)]

# At the ends of their ranges, and negative.
print [acos(1.0), log(-0.0), log2(0.0), log10(0.0)]
print [exp(INFINITY), exp(-INFINITY), hypot(INFINITY, 1.0)]
print [shown(atan(INFINITY)), shown(atan(-INFINITY)), shown(asin(-1.0))]
print [shown(sin(-PI / 6.0)), shown(cos(-PI / 3.0)), shown(tan(-PI / 4.0))]
print [hypot(1e300, 1e300) < INFINITY, hypot(1.5e308, 1.5e308) == INFINITY]
