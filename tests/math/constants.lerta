# The constants of std:math, and the infinities, which compare beyond every other Float.
import E, INFINITY, PI from 'std:math'

print "#{PI} #{E} #{INFINITY} #{-INFINITY}"
print [INFINITY > 1.797_693_134_862_315_7e308, -INFINITY < -1.797_693_134_862_315_7e308]
print "#{INFINITY == INFINITY} #{INFINITY.compare(-INFINITY)} #{INFINITY.to_literal()}"
