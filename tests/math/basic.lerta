# The functions of std:math, of Floats.
import abs, ceil, floor, pow, remainder, round, sqrt from 'std:math'

print abs(-2.5)
print floor(2.7)
print floor(-2.5)
print ceil(2.1)
print round(2.5)
print round(-2.5)
print round(2.4)
print sqrt(16.0)
print pow(2.0, 10.0)
print pow(-2.0, 3.0)
print pow(4.0, 0.5)
print remainder(7.5, 2.0)
print remainder(-7.5, 2.0)
