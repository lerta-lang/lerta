# Builds the compiler, and checks and tests it, as the Makefile asks: `build <goal> [--target
# <target>]`, where the goals are those that the Makefile names in GOALS. The Makefile builds this
# program with minilerta, from the seed, so that only make and clang are needed (see
# docs/internals/architecture.md#bootstrap). `build test-targets [<target>...]` runs the tests of
# other targets, each where test-targets.llit says, and `build test-target <target>` those of one
# here (see build/targets). `build embed <output> <path>...` writes the module that embeds the
# files, as the build writes build/embedded.lerta, for the tests of it.
import parse_args, parse_command from 'std:args'
import all as all_of from 'std:async'
import is_dir, remove_tree, stat from 'std:io'
import argv, cpu_count, exit from 'std:process'
import
  bootstrap_for, HARNESS_PROGRAM, HOST_COMPILER, make_compiler, make_harness, make_host_compiler,
  make_seed, make_stage2, test_bootstrap
from './build/stages'
import write_embedded from './build/embed'
import BuildError, call, captured, shared_batches, step from './build/steps'
import test_target, test_targets from './build/targets'

# The goals, as the Makefile names them, and the commands of the other targets' tests and of the
# embedded module.
enum Command
  all
  'bin/lerta'
  'bin/test'
  test
  test_bootstrap
  seed
  check
  bench
  bench_http
  site
  site_serve
  test_targets
  test_target
  embed

COMMAND_SPEC :=
  all: { help: 'build the compiler, for the target if given' }
  test: { help: 'run all the tests' }
  test_bootstrap: { help: 'check that the compiler builds itself' }
  seed: { help: 'write the seed anew' }
  check: { help: 'check the style' }
  bench: { help: 'run the benchmarks' }
  bench_http: { help: 'run the benchmarks of std:http' }
  site: { help: 'write the website' }
  site_serve: { help: 'write the website and serve it' }
  test_targets: { help: 'run the tests of the targets that test-targets.llit names' }
  test_target: { help: 'run the tests of the target here' }
  embed: { help: 'write the module that embeds the files' }

struct Goal
  target: String?
  built: Bool

# The harness runs test-bootstrap --built beside checks that run stage2 and bin/lerta, which it
# must not build again meanwhile.
GOAL_SPEC :=
  target: { help: 'the target, for all and test-bootstrap; the others but test and seed ignore it' }
  built: { help: 'for test-bootstrap: build no stage before stage3, and fail if stage2 is stale' }

struct Targets
  targets: String[] = []

TARGETS_SPEC := { targets: { positional: true, value: 'target' } }

struct Target
  target: String

struct Embed
  output: String
  paths: String[] = []

EMBED_SPEC := { output: { positional: true }, paths: { positional: true, value: 'path' } }

# stage2 is built first, as the leak checks and the bootstrap, a suite of the harness, run it. Under
# nice, as check does, so that the machine stays usable.
test := ->
  await make_host_compiler()
  await make_harness()
  await make_stage2(bootstrap_for(nil))
  exit await call('nice', HARNESS_PROGRAM)

# The .lerta files that git lists, those not added yet included, but those deleted and not yet
# from git, are in the style, tests/ too, where `# fmt: skip` and `# fmt: off` keep the code that
# breaks it on purpose. They go to runs of lerta fmt at once, a share for each core, as each run
# uses one (see shared_batches).
check := ->
  await make_host_compiler()
  git_args := ['ls-files', '-z', '--cached', '--others', '--exclude-standard', '--', '*.lerta']
  listed := (await captured('git', git_args, b'')).text()!.split("\0")
  files := [file for file in listed when not file.is_empty() and stat(file) != nil]
  runs := [
    call('nice', HOST_COMPILER, 'fmt', batch...)
    for batch in shared_batches(files, cpu_count, COMMAND_LINE_LIMIT)
  ]
  codes := await all_of(runs)
  exit codes.all((code) -> code == 0) then 0 else 1

# What a command line of Windows, the shortest, holds, with room for the command.
COMMAND_LINE_LIMIT := 30000

# The website, written afresh each time, as it is quick to write (see site/site.lerta).
site := ->
  await make_host_compiler()
  await remove_tree('build/site') if is_dir('build/site')
  await step(HOST_COMPILER, 'run', 'site/site.lerta', '--', 'build/site')

# Runs the program with the host's compiler, and ends with its exit code. Not under nice, as test
# and check are, which would slow the programs that bench times.
run_program := (source: String, args: String...) ->
  await make_host_compiler()
  exit await call(HOST_COMPILER, 'run', source, args...)

# The goals that take no target: the tests and the seed run for the host only, the seed so that a
# target given by mistake cannot change it.
HOST_ONLY := ['test', 'seed']

# The goal's arguments, each only where the goal takes it.
goal_of := (args: String[], name: String) ->
  goal := parse_args<Goal>(args, GOAL_SPEC, name)
  if goal.target != nil and name in HOST_ONLY
    hint := name == 'seed' then '' else ': run bin/test --target <target>'
    throw BuildError(message: "make #{name} does not take TARGET#{hint}", code: 2)
  if goal.built and name != 'test-bootstrap'
    throw BuildError(message: "#{name} does not take --built", code: 2)
  goal

try
  (command, args) := parse_command<Command>(argv, COMMAND_SPEC)

  # As parse_command names the command.
  name := command.to_string().replace('_', '-')

  # A goal reads its arguments before it does anything, though most ignore the target.
  is_goal := command not in [Command.embed, Command.test_targets, Command.test_target]
  goal := is_goal then goal_of(args, name)

  # Of the target that the goal gives, of the host if none.
  bootstrap := goal then bootstrap_for(goal.target)

  # A member is qualified where a function of its name, which runs it, takes the name.
  case command
    when all then await make_compiler(bootstrap!)
    when 'bin/lerta' then await make_host_compiler()
    when 'bin/test' then await make_harness()
    when Command.test_bootstrap then await test_bootstrap(bootstrap!, goal!.built)
    when seed then await make_seed()
    when Command.test then await test()
    when Command.check then await check()
    when bench then await run_program('bench/run.lerta')
    when bench_http then await run_program('bench/http/run.lerta')
    when Command.site then await site()
    when site_serve
      await site()
      await run_program('site/serve.lerta', '--', 'build/site')
    when embed
      { output, paths } := parse_args<Embed>(args, EMBED_SPEC, name)
      await write_embedded(output, paths)
    when Command.test_targets
      { targets } := parse_args<Targets>(args, TARGETS_SPEC, name)
      exit await test_targets(targets)
    when Command.test_target
      { target } := parse_args<Target>(args, { target: { positional: true } }, name)
      exit await test_target(target)
catch error: BuildError
  print_error error.message
  exit error.code
# A file that cannot be read or written, or a command that cannot be started, ends it as a failed
# step does.
catch error: IOError
  print_error error.message
  exit 1
