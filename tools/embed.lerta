# Writes a module that holds the contents of files (see docs/internals.md#bootstrap):
# `embed <output> <path>...`, or `embed --seed <output>` for the seed's, which finds the files of
# std as it runs.
import read_file, write_file from 'std:io'
import argv from 'std:process'

# The path as a '...' literal, which has no escapes.
path_literal := (path: String) ->
  is_plain := path.split("'").length == 1 and path.split('\').length == 1
  is_plain then "'#{path}'" else throw ValueError(message: "#{path}: a path cannot hold ' or \\")

# The contents as a "..." literal on one line.
contents_literal := (path: String) ->
  bytes: Byte[] = ['"']
  for byte in await read_file(path)
    escape :=
      case byte
        when "\n" then '\n'
        when "\t" then '\t'
        when "\r" then '\r'
        when "\0" then '\0'
        when '\' then '\\'
        when '"' then '\"'
        when '#' then '\#'
        else nil
    if escape
      bytes.push each for each in escape.binary
    else
      problem := 'a control character that a literal has no escape for'
      throw ValueError(message: "#{path}: #{problem}") if byte < 0x20
      bytes.push byte
  bytes.push '"'
  bytes.to_binary().text() ? throw ValueError(message: "'#{path}' is not valid UTF-8")

# The module of either mode, which the compiler uses alike: EMBEDDED_PATHS, the paths, and
# embedded_source, the contents of one of them, or nil for another path.
seed_mode := argv.length > 0 and argv[0] == '--seed'
throw ValueError(message: 'usage: embed --seed <output>') if seed_mode and argv.length != 2
first := seed_mode then 1 else 0
output := argv[first]
paths := [argv[i] for i in (first + 1)...argv.length]
header := "# Generated by tools/embed.lerta; do not edit.\n"
import_line := seed_mode then "import is_dir, list_dir, read_file from 'std:io'\n\n" else ''
# The seed, which only prints IR, needs only std, whose files it finds as it starts rather than
# holding their paths, so that no file of std or of the runtime added, removed or renamed needs a
# refresh of it. Every file is read up front, as the module runs, since read_file awaits, so that
# embedded_source is the same function in both modes.
SEED_PART := '''
  # The files of std under the directory, as paths from the repository's root.
  const std_files = (dir: String): String[] ->
    const files: String[] = []
    for name in list_dir(dir)
      const path = "#{dir}/#{name}"
      if is_dir(path)
        files.append std_files(path)
      else if path.ends_with('.lerta')
        files.push path
    files

  export const EMBEDDED_PATHS = std_files('std')

  const CONTENTS = Map<String, String>()
  for path in EMBEDDED_PATHS
    const bytes = await read_file(path)
    CONTENTS[path] = bytes.text() ? throw ValueError(message: "'#{path}' is not valid UTF-8")

  export const embedded_source = (path: String) -> CONTENTS[path]
  '''
normal_part := ->
  path_list := ["  #{path_literal(path)}\n" for path in paths].join('')
  contents := ["  #{path_literal(path)}: #{await contents_literal(path)}\n" for path in paths]
  return """
    export const EMBEDDED_PATHS = [
    #{path_list}]

    const CONTENTS: Map<String, String> = {
    #{contents.join('')}}

    export const embedded_source = (path: String) -> CONTENTS[path]
    """
mode_part := seed_mode then SEED_PART else await normal_part()
await write_file(output, [header, import_line, mode_part].join('').binary)
