# Writes a module that holds the contents of files, so that the compiler carries std/ and runtime/
# in it (see the Makefile): `embed <output> <path>...` exports EMBEDDED_FILES, the contents of
# each file by its path as given.
import { read_file, write_file } from 'std:io'
import { argv } from 'std:process'

# The path as a '...' literal, which has no escapes.
const path_literal = (path: String) ->
  const is_plain = path.split("'").length == 1 and path.split('\').length == 1
  is_plain then "'#{path}'" else throw "#{path}: a path cannot hold ' or \\"

# The contents as a "..." literal on one line.
const contents_literal = (path: String) ->
  const bytes: Array<Byte> = ['"']
  for byte in read_file(path)
    const escape: String? = case byte
      when "\n" then '\n'
      when "\t" then '\t'
      when "\r" then '\r'
      when "\0" then '\0'
      when '\' then '\\'
      when '"' then '\"'
      when '#' then '\#'
      else nil
    if escape
      bytes.push each for each in escape.binary
    else
      throw "#{path}: a control character that a literal has no escape for" if byte < 0x20
      bytes.push byte
  bytes.push '"'
  bytes.to_binary().decode_utf8() ? throw "#{path} is not valid UTF-8"

const output = argv[0]
const entries = ["  #{path_literal(argv[i])}: #{contents_literal(argv[i])}\n" for i in 1...argv.length]
const header = [
  "# Generated by tools/embed.lerta; do not edit.\n"
  "export const EMBEDDED_FILES: Map<String, String> = {\n"
]
write_file output, [header.join(''), entries.join(''), "}\n"].join('').binary
