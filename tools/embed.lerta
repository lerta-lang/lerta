# Writes a module that holds the contents of files (see docs/internals.md#bootstrap):
# `embed <output> <path>...`, or `embed --seed <output>` for the seed's, which finds the files of
# std as it runs.
import read_file, write_file from 'std:io'
import argv from 'std:process'

# The path as a '...' literal, which has no escapes.
const path_literal = (path: String) ->
  const is_plain = path.split("'").length == 1 and path.split('\').length == 1
  is_plain then "'#{path}'" else throw ValueError(message: "#{path}: a path cannot hold ' or \\")

# The contents as a "..." literal on one line.
const contents_literal = (path: String) ->
  const bytes: Byte[] = ['"']
  for byte in await read_file(path)
    const escape =
      case byte
        when "\n" then '\n'
        when "\t" then '\t'
        when "\r" then '\r'
        when "\0" then '\0'
        when '\' then '\\'
        when '"' then '\"'
        when '#' then '\#'
        else nil
    if escape
      bytes.push each for each in escape.binary
    else
      const problem = 'a control character that a literal has no escape for'
      throw ValueError(message: "#{path}: #{problem}") if byte < 0x20
      bytes.push byte
  bytes.push '"'
  bytes.to_binary().text() ? throw ValueError(message: "'#{path}' is not valid UTF-8")

# The module of either mode, which the compiler uses alike: EMBEDDED_PATHS, the paths, and
# embedded_source, the contents of one of them, or nil for another path.
const seed_mode = argv.length > 0 and argv[0] == '--seed'
throw ValueError(message: 'usage: embed --seed <output>') if seed_mode and argv.length != 2
const first = seed_mode then 1 else 0
const output = argv[first]
const paths = [argv[i] for i in (first + 1)...argv.length]
const header = "# Generated by tools/embed.lerta; do not edit.\n"
const import_line = seed_mode then "import is_dir, list_dir, read_file from 'std:io'\n\n" else ''
# The seed, which only prints IR, needs only std, whose files it finds as it starts rather than
# holding their paths, so that no file of std or of the runtime added, removed or renamed needs a
# refresh of it. Every file is read up front, as the module runs, since read_file awaits, so that
# embedded_source is the same function in both modes.
const seed_part = ->
  return
    "# The files of std under the directory, as paths from the repository's root.\n"
    "const std_files = (dir: String): String[] ->\n"
    "  const files: String[] = []\n"
    "  for name in list_dir(dir)\n"
    "    const path = \"\#{dir}/\#{name}\"\n"
    "    if is_dir(path)\n"
    "      files.append std_files(path)\n"
    "    else if path.ends_with('.lerta')\n"
    "      files.push path\n"
    "  files\n"
    "\n"
    "export const EMBEDDED_PATHS = std_files('std')\n"
    "\n"
    "const CONTENTS = Map<String, String>()\n"
    "for path in EMBEDDED_PATHS\n"
    "  const bytes = await read_file(path)\n"
    "  CONTENTS[path] = bytes.text() ? throw ValueError(message: \"'\#{path}' is not valid UTF-8\")\n"
    "\n"
    "export const embedded_source = (path: String) -> CONTENTS[path]\n"
  .join('')
const normal_part = ->
  const path_list = ["  #{path_literal(path)}\n" for path in paths].join('')
  const contents = ["  #{path_literal(path)}: #{await contents_literal(path)}\n" for path in paths]
  return
    "export const EMBEDDED_PATHS = [\n#{path_list}]\n\n"
    "const CONTENTS: Map<String, String> = {\n#{contents.join('')}}\n\n"
    "export const embedded_source = (path: String) -> CONTENTS[path]\n"
  .join('')
const mode_part = seed_mode then seed_part() else await normal_part()
await write_file(output, [header, import_line, mode_part].join('').binary)
