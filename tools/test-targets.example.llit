# The targets that make test-targets runs, each where it runs (see
# CONTRIBUTING.md#testing-other-targets): copied to test-targets.llit at the root of the repository,
# which git ignores, and edited.
targets:
  # In a container of an image of tools/docker/: linux, or wine for Windows programs.
  'linux-i386': { docker: 'linux' }
  # Over SSH, in bash, whose PATH there has make and clang.
  'windows-amd64': { ssh: 'user@windows' }
  'windows-i386': { ssh: 'user@windows' }
  # Here.
  'macos-arm64': { local: true }
