# What the build reads, as the host's system takes it.
import list_dir, read_text from 'std:io'
import platform from 'std:process'
import CompileError from '../../compiler/errors'
import
  described_build, description_path, PlatformBuild, runtime_c_names, SYSTEMS
from '../../compiler/platform_description'
import files_under, sorted_once from './files'
import BuildError from './steps'

# What a program built for the host ends with.
export HOST_EXE := platform == 'windows' then '.exe' else ''

export EMBEDDED_MODULE := 'build/embedded.lerta'

# The files that the build reads, found in the repository, which it runs from:
export struct Inputs
  # what the host builds the runtime with (see compiler/platform_description.lerta);
  host_build: PlatformBuild
  # the runtime's files, the descriptions among them, and the C files that the host compiles of
  # them;
  runtime: String[]
  runtime_c: String[]
  # the files that the compiler carries in build/embedded.lerta: std's at any depth, as the seed
  # finds them (see tools/build/embed.lerta), the runtime's, and libuv's: its headers, and the
  # sources that a description lists;
  embedded: String[]
  # the compiler's;
  sources: String[]
  # the Lerta test harnesses', which minilerta builds, so that a change to the compiler cannot
  # break the harness that tests it (see docs/roadmap/programs.md#tools).
  harness: String[]

# The inputs, read when a goal first needs them, as the build may run elsewhere (see `embed` in
# tools/build.lerta).
export inputs := ->
  read_inputs = find_inputs() if read_inputs == nil
  await read_inputs!

var read_inputs: Promise<Inputs>?

find_inputs := ->
  builds: PlatformBuild[]
  builds.push await read_build(system) for system in SYSTEMS
  host_build := builds.find((build) -> build.system == platform)!
  runtime := files_in('runtime', ['.c', '.h', '.mk'])
  runtime_names := [path.without_prefix('runtime/')! for path in runtime]
  runtime_c := ["runtime/#{name}" for name in runtime_c_names(runtime_names, host_build)]
  libuv_sources: String[]
  for build in builds
    libuv_sources.append ["third_party/libuv/#{source}" for source in build.libuv_sources]
  libuv := [
    files_under('third_party/libuv/include', ['.h'])...
    files_under('third_party/libuv/src', ['.h'])...
    libuv_sources...
  ]
  Inputs
    host_build
    runtime
    runtime_c
    embedded: sorted_once([files_under('std', ['.lerta'])..., runtime..., libuv...])
    sources: [files_under('compiler', ['.lerta'])..., EMBEDDED_MODULE]
    harness: files_under('test', ['.lerta'])

# What the system's description gives it, which ends the build if it is not well formed.
read_build := (system: String) ->
  path := description_path(system)
  description := await read_text(path) ? throw BuildError(message: "#{path} is not UTF-8")
  try
    described_build description, system
  catch error: CompileError
    throw BuildError(message: error.message)

files_in := (dir: String, suffixes: String[]) ->
  sorted_once ["#{dir}/#{name}" for name in list_dir(dir) when suffixes.any(name.ends_with)]
