# Writes the module that gives the contents of files, which the compiler carries (see
# docs/internals/architecture.md#bootstrap): of the files given, which it embeds, or the seed's,
# which reads the files of std as it runs.
import write_file from 'std:io'
import dir_name, relative from 'std:path'

HEADER := "# Generated by tools/build/embed.lerta; do not edit.\n"

# The files that are embedded as Binary values, as std's tables are; the others are text.
BINARY_EXTENSION := '.bin'

is_binary := (path: String) -> path.ends_with(BINARY_EXTENSION)

# The module of either kind, which the compiler uses alike: EMBEDDED_PATHS, the paths, and
# embedded_source and embedded_bytes, the contents of one of them, of a text file and of a binary
# one, or nil for another path. This one, at `output`, embeds each file by an import (see
# docs/reference/modules.md#embedded-files).
export embedded_module := (output: String, paths: String[]) ->
  imports := [
    for path at i in paths
      import_line(output, path, i)
  ]
  path_list := ["  #{path.to_literal()}\n" for path in paths].join()
  entry := (path: String, i: Int) -> "  #{path.to_literal()}: FILE_#{i}\n"
  texts := [
    for path at i in paths when not is_binary(path)
      entry(path, i)
  ]
  binaries := [
    for path at i in paths when is_binary(path)
      entry(path, i)
  ]
  module := """
    #{paths_declaration(path_list)}

    #{map_declaration('CONTENTS', 'String', texts)}

    #{map_declaration('BYTES', 'Binary', binaries)}

    export embedded_source := (path: String) -> CONTENTS[path]
    export embedded_bytes := (path: String) -> BYTES[path]
    """
  "#{HEADER}#{imports.join()}\n#{module}"

# The import of the file, as the type its contents are.
import_line := (output: String, path: String, i: Int) ->
  type := is_binary(path) then 'Binary' else 'String'
  "import #{import_path(output, path).to_literal()} as FILE_#{i}: #{type}\n"

# The path of the file from the module at `output`, as an import names it.
import_path := (output: String, path: String) ->
  from_module := relative(dir_name(output), path)
  from_module.starts_with('../') then from_module else "./#{from_module}"

export write_embedded := (output: String, paths: String[]) ->
  await write_file(output, embedded_module(output, paths))

# The declarations of the paths and of the contents, each item on a line of its own. A literal in a
# block holds an item at least, so the declarations of none have none.
paths_declaration := (path_list: String) ->
  if path_list.is_empty()
    'export EMBEDDED_PATHS: String[] = []'
  else
    "export EMBEDDED_PATHS := [\n#{path_list}]"

map_declaration := (name: String, type: String, entries: String[]) ->
  declared := "#{name}: Map<String, #{type}>"
  entries.is_empty() then declared else "#{declared} = {\n#{entries.join()}}"

# The seed, which only prints IR, needs only std, whose files it finds as it starts rather than
# holding their paths, so that no file of std or of the runtime added, removed or renamed needs a
# refresh of it. Every file is read up front, as the module runs, since read_file awaits, so that
# embedded_source and embedded_bytes are the same functions in both kinds.
SEED_MODULE := '''
  # The files of std under the directory, its sources and its tables, as paths from the
  # repository's root.
  std_files := (dir: String): String[] ->
    files: String[]
    for name in list_dir(dir)
      path := "#{dir}/#{name}"
      if is_dir(path)
        files.append std_files(path)
      else if path.ends_with('.lerta') or path.ends_with('.bin')
        files.push path
    files

  export EMBEDDED_PATHS := std_files('std')

  CONTENTS: Map<String, String>
  BYTES: Map<String, Binary>
  for path in EMBEDDED_PATHS
    bytes := await read_file(path)
    if path.ends_with('.bin')
      BYTES[path] = bytes
    else
      CONTENTS[path] = bytes.text() else throw ValueError(message: "'#{path}' is not valid UTF-8")

  export embedded_source := (path: String) -> CONTENTS[path]
  export embedded_bytes := (path: String) -> BYTES[path]
  '''

export write_seed_embedded := (output: String) ->
  imports := "import is_dir, list_dir, read_file from 'std:io'\n\n"
  await write_file(output, "#{HEADER}#{imports}#{SEED_MODULE}")
