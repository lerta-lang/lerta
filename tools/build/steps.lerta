# Runs the commands of the build: a step prints its command first, as make prints a recipe, and
# ends the build if it fails.
import all from 'std:async'
import Buffer, open, Pipe, remove_tree, rename, write_file, Writer from 'std:io'
import Exit, run from 'std:process'

# What ends the build: a step that failed, with code 1, or a usage error, with code 2, as make's.
export struct BuildError: Error
  code := default 1

# The arguments in batches whose bytes, each with one for the space before it, add up to no more
# than `limit`, but for an argument longer than that alone, which has a batch of its own.
export command_line_batches := (args: String[], limit: Int) ->
  batches: String[][]
  var batch: String[] = []
  var length = 0
  for arg in args
    if length + arg.binary.length + 1 > limit and not batch.is_empty()
      batches.push batch
      batch = []
      length = 0
    batch.push arg
    length += arg.binary.length + 1
  batches.push batch unless batch.is_empty()
  batches

# The arguments split into at most `shares` shares, which is positive, of as many arguments each
# but the last, each in batches as command_line_batches makes them. The shares keep the arguments'
# order, so that files that import one another tend to share a run, which checks their program once.
export shared_batches := (args: String[], shares: Int, limit: Int) ->
  share := (args.length + shares - 1) / shares
  batches: String[][]
  var start = 0
  while start < args.length
    end := min(start + share, args.length)
    batches.push batch for batch in command_line_batches(args[start..end], limit)
    start = end
  batches

# The line that a step prints for the command.
command_line := (command: String, args: String[]) -> [command, args...].join(' ')

# Runs the command, its output and errors going where the build's go, and gives its exit code.
export call := (command: String, args: String...) -> (await run(command, args...)).code

# Runs the command, printed first, and ends the build if it fails.
export step := (command: String, args: String...) ->
  print command_line(command, args)
  code := await call(command, args...)
  throw BuildError(message: "#{command} exited with #{code}") if code != 0

# Runs the command, printed first, and writes what it prints to `output`, only once it succeeds,
# so that a step that fails leaves no output that a later build would take as up to date.
export step_to_file := (output: String, command: String, args: String...) ->
  print "#{command_line(command, args)} > #{output}"
  await write_file(output, await captured(command, args, b''))

# Prints the pipeline, then runs the producer with its output piped into the filter, and writes
# what the filter prints to `output` as it comes, as the producer's output may be too large to hold.
# The output is made only once both succeed, for the reason that step_to_file gives. As with
# pipefail, a producer that the filter leaves unread fails the step too.
export step_piped_to_file := (output: String, producer: String[], filter: String[]) ->
  producer_line := command_line(producer[0], producer[1..])
  print "#{producer_line} | #{command_line(filter[0], filter[1..])} > #{output}"
  await piped_to_file(output, producer, filter)

# What step_piped_to_file runs, without its line.
export piped_to_file := (output: String, producer: String[], filter: String[]) ->
  unfinished := "#{output}.unfinished"
  filtered := open(unfinished, WRITE).writer
  try
    await run_piped(filtered, producer, filter)
  catch error
    await abandon(filtered, unfinished)
    throw error
  rename unfinished, output

# Removes the file that a failed step wrote, if it can: it is ended first, as a filter that could
# not start has not ended it, and Windows cannot remove an open file, which a filter still running
# may hold. An end that fails has closed the file all the same. A file left is emptied by the next
# run.
abandon := (writer: Writer, path: String) ->
  await quietly(writer.end())
  await quietly(remove_tree(path))

# The step's error tells why it failed, rather than what its cleanup met after.
quietly := (cleanup: Promise) ->
  try
    await cleanup
  catch _
    return

# The filter's failure is told first: a producer that writes on once the filter has failed fails
# too, killed by SIGPIPE, which would hide why.
run_piped := (filtered: Writer, producer: String[], filter: String[]) ->
  pipe := Pipe()
  filtering := run(filter[0], filter[1..]..., stdin: pipe, stdout: filtered)
  producing := run(producer[0], producer[1..]..., stdout: pipe)
  exits := await all([filtering, producing])
  check_exit filter[0], exits[0]
  check_exit producer[0], exits[1]

check_exit := (command: String, exit: Exit) ->
  throw BuildError(message: "#{command} exited with #{exit.code}") if exit.code != 0

# What the command prints, given `input`; the build ends if it fails.
export captured := (command: String, args: String[], input: Binary) ->
  output := Buffer()
  ran := await run(command, args..., stdin: input, stdout: output)
  throw BuildError(message: "#{command} exited with #{ran.code}") if ran.code != 0
  output.binary
