# Writes the tables of Unicode's classes, case mappings and normal forms that std:builtins embeds
# (see docs/internals/representation.md#unicode) from the files of the Unicode Character Database
# in third_party/ucd.
# Run it from the repository's root, after those files change: `bin/lerta run tools/unicode.lerta`.
import make_dir, read_text, write_file from 'std:io'

UCD_DIR := 'third_party/ucd'
TABLES_DIR := 'std/internal/unicode'

# The most characters that a full case mapping gives one, in SpecialCasing.txt.
MAX_MAPPED := 3

# A character of UnicodeData.txt, or a range of them, as its first and last lines name it.
struct Character
  first: Int
  last: Int
  category: String
  upper: Int?
  lower: Int?
  combining_class: Int
  decomposition: Decomposition?

# A decomposition mapping of UnicodeData.txt, canonical, or of compatibility, which its field marks
# with a tag, as `<compat>`.
struct Decomposition
  compatibility: Bool
  codes: Int[]

# The code point that the hexadecimal text stands for.
code_of := (hex: String) ->
  var code = 0
  for byte in hex.trim().binary
    code = code * 16 + byte.hex_value()!
  code

characters := (text: String) ->
  found: Character[]
  var first: Int?
  for line in text.lines()
    fields := line.split(';')
    code := code_of(fields[0])
    if fields[1].ends_with(', First>')
      first = code
      continue
    mapped := (field: String) -> field.is_empty() then nil else code_of(field)
    found.push {
      first: first else code
      last: code
      category: fields[2]
      upper: mapped(fields[12])
      lower: mapped(fields[13])
      combining_class: fields[3].parse_int()!
      decomposition: decomposition_of(fields[5])
    }
    first = nil
  found

decomposition_of := (field: String) ->
  return nil if field.is_empty()
  parts := field.split(' ')
  compatibility := parts[0].starts_with('<')
  codes := compatibility then parts[1..] else parts
  Decomposition(compatibility, codes: [code_of(code) for code in codes])

# The text of a line of the database before its comment.
data_of := (line: String) ->
  (data, _) := line.split_once('#') else return line
  data

# The ranges, each its first and last code points, of the characters whose category starts with
# the letter, merged where they meet.
category_ranges := (all: Character[], letter: String) ->
  merged([[c.first, c.last] for c in all when c.category.starts_with(letter)])

# The ranges that a file of derived properties gives the property, of one of the values if any are
# given, merged where they meet.
property_ranges := (text: String, property: String, values: String[] = []) ->
  ranges: Int[][]
  for line in text.lines()
    fields := [field.trim() for field in data_of(line).split(';')]
    continue if fields.length < 2 or fields[1] != property
    value := fields.get(2) else ''
    continue if not values.is_empty() and value not in values
    (first, last) := fields[0].split_once('..') else (fields[0], fields[0])
    ranges.push [code_of(first), code_of(last)]
  merged(ranges.sorted_by((range) -> range[0]))

# The code points in the ranges.
codes_in := (ranges: Int[][]) ->
  codes: Set<Int>
  for range in ranges
    codes.add code for code in range[0]..=range[1]
  codes

merged := (ranges: Int[][]) ->
  result: Int[][]
  for range in ranges
    previous := result.last()
    if previous and previous[1] + 1 == range[0]
      previous[1] = range[1]
    else
      result.push [range[0], range[1]]
  result

# The simple mappings that the field gives, as pairs of a character and its mapping.
simple_mappings := (all: Character[], mapping: (Character) -> Int?) ->
  [
    for c in all when mapping(c) != nil
      [c.first, mapping(c)!]
  ]

# The full mappings of SpecialCasing.txt that hold whatever the context and the language, of the
# field: 1 for lower case, 3 for upper case. Each is the character, and the characters it maps to,
# with zeros after them.
special_mappings := (text: String, field: Int) ->
  found: Int[][]
  for line in text.lines()
    fields := data_of(line).split(';')
    continue if fields.length != 5
    mapped := [code_of(code) for code in fields[field].split_whitespace()]
    continue if mapped.length == 1 and mapped[0] == code_of(fields[0])
    padding := Array(MAX_MAPPED - mapped.length, 0)
    found.push [code_of(fields[0]), mapped..., padding...]
  found.sorted_by((entry) -> entry[0])

# The combining classes that are not 0, of a character each.
combining_classes := (all: Character[]) ->
  [[c.first, c.combining_class] for c in all when c.combining_class != 0]

# The decompositions of the characters, by their code points.
decompositions := (all: Character[]) ->
  found: Map<Int, Decomposition>
  for c in all
    found[c.first] = decomposition if decomposition := c.decomposition
  found

# The full decomposition of the code point: each of its mapping's decomposed in turn, and of
# compatibility too where `compatibility` is set; the code point itself where it has none.
expanded := (code: Int, all: Map<Int, Decomposition>, compatibility: Bool): Int[] ->
  decomposition := all[code] else return [code]
  return [code] if decomposition.compatibility and not compatibility
  result: Int[]
  for each in decomposition.codes
    result.append expanded(each, all, compatibility)
  result

# The code points of the full decompositions, one after another, and an index of each kind: a
# character, the place of its decomposition among them, and their number. A decomposition that
# both kinds give is written once.
struct DecompositionTables
  values: Int[][]
  canonical: Int[][]
  compatibility: Int[][]

decomposition_tables := (all: Map<Int, Decomposition>) ->
  values: Int[]
  places: Map<String, Int>
  index := (compatibility: Bool) ->
    rows: Int[][]
    for code in all.keys().to_array().sorted()
      continue if all[code]!.compatibility and not compatibility
      codes := expanded(code, all, compatibility)
      key := codes.to_string()
      if places[key] == nil
        places[key] = values.length
        values.append codes
      rows.push [code, places[key]!, codes.length]
    rows
  canonical := index(false)
  compatibility := index(true)
  DecompositionTables(canonical, compatibility, values: [[value] for value in values])

# The primary composites: each canonical mapping of two characters, but of those excluded from
# composition, as a pair and the character it composes to, sorted by the pair.
compositions := (all: Map<Int, Decomposition>, excluded: Set<Int>) ->
  rows: Int[][]
  for (code, decomposition) in all
    continue if decomposition.compatibility or decomposition.codes.length != 2 or code in excluded
    rows.push [decomposition.codes[0], decomposition.codes[1], code]
  rows.sorted_by((row) -> row[0] * 0x110000 + row[1])

# The table of the entries, each a row of UInt32 values in little-endian order, as
# Binary.uint32_at reads them.
table := (rows: Int[][]) ->
  bytes: Byte[]
  for row in rows
    for value in row
      for shift in [0, 8, 16, 24]
        bytes.push (value >> shift & 0xFF).to_byte()!
  bytes.to_binary()

unicode_data := characters((await read_text("#{UCD_DIR}/UnicodeData.txt"))!)
properties := (await read_text("#{UCD_DIR}/DerivedCoreProperties.txt"))!
special_casing := (await read_text("#{UCD_DIR}/SpecialCasing.txt"))!
normalization := (await read_text("#{UCD_DIR}/DerivedNormalizationProps.txt"))!
decomposed := decompositions(unicode_data)
excluded := codes_in(property_ranges(normalization, 'Full_Composition_Exclusion'))
decomposition := decomposition_tables(decomposed)

tables :=
  'letters': category_ranges(unicode_data, 'L')
  'numbers': category_ranges(unicode_data, 'N')
  'lowercase': property_ranges(properties, 'Lowercase')
  'uppercase': property_ranges(properties, 'Uppercase')
  'cased': property_ranges(properties, 'Cased')
  'case_ignorable': property_ranges(properties, 'Case_Ignorable')
  'upper': simple_mappings(unicode_data, (c) -> c.upper)
  'lower': simple_mappings(unicode_data, (c) -> c.lower)
  'special_upper': special_mappings(special_casing, 3)
  'special_lower': special_mappings(special_casing, 1)
  'combining_classes': combining_classes(unicode_data)
  'decompositions': decomposition.values
  'canonical_index': decomposition.canonical
  'compatibility_index': decomposition.compatibility
  'compositions': compositions(decomposed, excluded)
  'nfd_check': property_ranges(normalization, 'NFD_QC', ['N'])
  'nfkd_check': property_ranges(normalization, 'NFKD_QC', ['N'])
  'nfc_check': property_ranges(normalization, 'NFC_QC', ['N', 'M'])
  'nfkc_check': property_ranges(normalization, 'NFKC_QC', ['N', 'M'])

make_dir TABLES_DIR
for (name, rows) in tables
  await write_file("#{TABLES_DIR}/#{name}.bin", table(rows))
  print "#{TABLES_DIR}/#{name}.bin: #{rows.length} entries"
