# Writes the website into a directory, from the repository's root: `lerta run site/site.lerta --
# <output>`. Its pages (see pages.lerta) are written each at its path in docs/, as HTML, so that
# their links stay as GitHub reads them; a link to what is not on the site, as the roadmap, goes to
# GitHub.
import copy_file, make_dir, read_text, write_file from 'std:io'
import argv, exit from 'std:process'
import lay_out from './layout'
import directory_of, html_path, link_target from './links'
import MarkdownError, Page, render_markdown from './markdown'
import SITE_DIR, Source, sources from './pages'

struct Rendered
  source: Source
  page: Page

render := (source: Source, paths: Set<String>): Promise<Rendered?> ->
  markdown := await read_text(source.file) else throw ValueError("not UTF-8: #{source.file}")
  try
    page := render_markdown(markdown, (target) -> link_target(source.path, target, paths))
    print_error "#{source.file}: warning: #{warning}" for warning in page.warnings
    { source, page }
  catch error: MarkdownError
    print_error "#{source.file}: #{error.message}"
    nil

main := ->
  output := argv.first() else throw ValueError('usage: site <output directory>')
  all_sources := sources()
  paths := Set([source.path for source in all_sources])
  rendered := [
    for source in all_sources
      await render(source, paths)
  ]
  exit 1 if rendered.any((each) -> each == nil)
  pages := Map([(each!.source.path, each!.page) for each in rendered])
  template := (await read_text("#{SITE_DIR}/template.html"))!
  for each in rendered
    source := each!.source
    html := lay_out(template, source.path, pages)
    file := "#{output}/#{html_path(source.path)}"
    make_dir directory_of(file)
    await write_file(file, html)
  await copy_file("#{SITE_DIR}/style.css", "#{output}/style.css")

await main()
