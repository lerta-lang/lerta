# Serves the website that site.lerta wrote, to look at it before it is published: `lerta run
# site/serve.lerta -- <directory> [<port>]`.
import argv from 'std:process'
import serve, serve_files from 'std:http'

usage := 'usage: serve <directory> [<port>]'
root := argv.first() else throw ValueError(usage)
port :=
  if argv.length > 1
    argv[1].parse_int() else throw ValueError(usage)
  else
    8000

server := serve(serve_files(root), port: port)
print "serving #{root} at http://127.0.0.1:#{server.port}/"
