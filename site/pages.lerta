# The pages of the site: index.md, here, and those of docs/ but roadmap/ and issues.md.
import list_dir from 'std:io'
import SECTIONS from './layout'
import DOCS_DIR from './links'

export SITE_DIR := 'site'

# A page to write: its path as from docs/, and the file it is written from, from the repository's
# root.
export struct Source
  path: String
  file: String

export sources := ->
  all: Source[] =
    { path: 'index.md', file: "#{SITE_DIR}/index.md" }
    { path: 'philosophy.md', file: "#{DOCS_DIR}/philosophy.md" }
  for section in SECTIONS
    for name in list_dir("#{DOCS_DIR}/#{section}")
      path := "#{section}/#{name}"
      if name.ends_with('.md')
        all.push { path, file: "#{DOCS_DIR}/#{path}" }
  all
