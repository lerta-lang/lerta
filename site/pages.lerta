# The pages of the site: index.md, here, and those of docs/ but roadmap/ and issues.md.
import list_dir, read_text from 'std:io'
import SECTIONS from './layout'
import DOCS_DIR from './links'
import render_markdown from './markdown'

export SITE_DIR := 'site'

# A page to write: its path as from docs/, and the file it is written from, from the repository's
# root.
export struct Source
  path: String
  file: String

export sources := ->
  all: Source[] =
    { path: 'index.md', file: "#{SITE_DIR}/index.md" }
    { path: 'philosophy.md', file: "#{DOCS_DIR}/philosophy.md" }
  for section in SECTIONS
    for name in list_dir("#{DOCS_DIR}/#{section}")
      path := "#{section}/#{name}"
      if name.ends_with('.md')
        all.push { path, file: "#{DOCS_DIR}/#{path}" }
  all

# The files whose samples (see markdown.lerta) the tests run and the style checks: README.md and
# the site's pages, from the repository's root.
export sample_files := -> ['README.md'] + [source.file for source in sources()]

# The samples of a file, from the repository's root. Throws a MarkdownError for a file that does not
# render, and a ValueError for one that is not UTF-8.
export read_samples := (file: String) ->
  markdown := await read_text(file) else throw ValueError("not UTF-8: #{file}")
  render_markdown(markdown, (target) -> target).samples
